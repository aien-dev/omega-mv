note SPDX-License-Identifier: AGPL-3.0-only
note Exhaustive finite-packet and budget boundaries, no model/transport authority claimed.
fn main to int
constants
if ne pack 1000 15
ret 1
end
for i ulong 64
put modelkey i get tokpin i
end
put vstate 0 1
for shape ulong 4
which = add shape 1
put vcount 0 1
put vslots 0 shape
if eq which 3
put vcount 0 2
put vslots 0 0
put vslots 1 1
end
if eq which 4
put vcount 0 2
put vslots 0 1
put vslots 1 0
end
want = packcost which
if ne pack want 0
ret 2
end
if ne get pcount 0 want
ret 3
end
if ne get pdropped 0 0
ret 4
end
if not pkhash which
ret 5
end
if le which 2
if ne pack sub want 1 13
ret 6
end
if ne get olen 0 0
ret 7
end
else
if ne pack sub want 1 0
ret 8
end
if ne get pdropped 0 1
ret 9
end
if ne get pcount 0 packcost add get vslots 0 1
ret 10
end
end
end
put modelkey 0 120
if ne pack 1000 14
ret 11
end
if ne get olen 0 0
ret 12
end
put modelkey 0 get tokpin 0
put vstate 0 2
if ne pack 1000 1
ret 13
end
if ne get olen 0 0
ret 14
end
put vstate 0 1
put vcount 0 2
put vslots 0 0
put vslots 1 1
if ne pack 255 0
ret 15
end
put out 0 120
if pkhash 1
ret 16
end
if ne pack 254 13
ret 17
end
if ne get olen 0 0
ret 18
end
ret 0
end
