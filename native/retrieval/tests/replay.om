note SPDX-License-Identifier: AGPL-3.0-only
note Offline integration replay. Not a network/credential provider or agent entry point.
note Real Xerj response is verified before packing under the frozen selected-model pin.
global chunk uchar 4096
text nomatch "{\"status\":\"no_match\"}\n"
fn main to int
size = ulong 0
more = true
while more
n = read 0 chunk 0 len chunk
if eq n neg long 4
else
if lt n 0
ret 74
end
if eq n 0
more = false
else
if gt add size ulong n len jin
ret 9
end
for i ulong ulong n
put jin add size i get chunk i
end
size = add size ulong n
end
end
end
code = verify size 1
if eq code 1
for i ulong len nomatch
obyte get nomatch i
end
if not owrite
ret 74
end
ret 0
end
if ne code 0
ret int code
end
for i ulong len tokpin
put modelkey i get tokpin i
end
code = pack 512
if ne code 0
ret int code
end
if not owrite
ret 74
end
ret 0
end
