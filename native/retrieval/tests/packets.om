note SPDX-License-Identifier: AGPL-3.0-only
note Offline tokenizer-oracle fixture emitter. Input is one ASCII byte 1..4.
global select uchar 2
fn main to int
size = ulong 0
while lt size 2
n = read 0 select size sub 2 size
if eq n neg long 4
else
if lt n 0
ret 74
end
if eq n 0
if ne size 1
ret 2
end
c = ulong get select 0
if or lt c 49 gt c 52
ret 2
end
if not pincheck
ret 12
end
r = packet sub c 48
if ne r 0
ret int r
end
if not owrite
ret 74
end
ret 0
end
size = add size ulong n
end
end
ret 2
end
