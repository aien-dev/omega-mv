fn hashok pin ulong to bool
for i ulong 32
b = ulong get Hash i
if ne get hexdig shr b 4 pbyte pin mul i 2
ret false
end
if ne get hexdig and b 15 pbyte pin add mul i 2 1
ret false
end
end
ret true
end
fn pincheck to bool
constants
for slot ulong 2
hinit
for i ulong srclen slot
hbyte srcbyte slot i
end
finish
if not hashok add slot 4
ret false
end
hashid slot
if not hashok add slot 6
ret false
end
end
ret true
