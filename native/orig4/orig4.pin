# native/orig4/orig4.pin: every input of the ORIG-4 shadow advisor unit, by hash.
# tests/orig4/run.sh refuses to build unless each line below matches what it materializes.
# omc <sha256>: this repository's seeded compiler, seed/out/omc (seed/out/omc.sha256).
# unit <order> <repo> <commit> <path> <sha256>: a pinned .om source taken with
#   git -C <repo dir> show <commit>:<path>; repo "omega" is this repository, "aien-train"
#   and "omega-bridge" are the sibling clones ../aien-train and ../omega-bridge (the gate
#   step materializes them under build/pins and points the glue there). The unit is the
#   concatenation in <order>, then native/orig4/shadow.om and the caller.
# image <file> <sha256>: an immutable candidate checkpoint under native/orig4/candidates
#   (byte-identical to aien-train evidence/SI19-ORIG2/candidates at the pinned commit).
omc 734f0a39319fbfa930bcc62cb30dbf06d47d78e126372b74f5baf478e6126b61
