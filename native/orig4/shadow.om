note SPDX-License-Identifier: Apache-2.0
note omega-mv#731 ORIG-4: default-off shadow advice for the matvec arm chooser
note (spec/shadow-advice-v0.md). Unit after the pinned units add32 mul32 metadata affine
note fixture world omexp omexpfix select (native/orig4/orig4.pin); the program is this unit
note plus shadowmain.om (fn main), the tests this unit plus tests/orig4/shadow-test.om.
note Modes (first stdin byte, dispatched by shadowmain.om): S shadow, G fixture.
note S: config 64 bytes (8 LE words: 0 enable, 1 scoring budget in records (<= 2048),
note 2 image length in the stream (1..32768; select.om's slload decides admissibility),
note 3..7 reserved 0), the allow-list block (4096 bytes), the checkpoint image, then
note omexp-v1 records to end of input (<= 524288 bytes).
note Admission in order: enable word (anything but 1 prints SHADOW disabled, exit 0) ->
note allow-list status of the records' FNV-1a 64 (oxallow) -> record admission (oxload) ->
note checkpoint admission (sladmit: every slload check except the training-dataset binding;
note slbound is printed as bound_matches=yes|no and is information, not a fallback reason:
note the advisor by design scores records the model never trained on) -> per record: past the
note budget, out-of-distribution state (core class 2 or pressure above 1), fewer than two
note admissible arms, any non-finite score -> FALLBACK; otherwise ADVICE with the argmin
note score among the admissible arms (lowest index on a tie) under the best-on-DEV params.
note The advisor writes only to fd 1, never reads past the end of input, and never widens
note the candidate set: hvscore ranks only arms for which oxcand holds.
note Exit: 0 (also for a refused image), 64 bad mode, 66 records refused, 67 unauthorized
note or revoked, 68 config invalid, 74 I/O.
note G: 16 bytes (seed, count <= 2048); the SYNTHETIC records of sxgen go to fd 1 raw.
note H: the record bytes to end of input; their FNV-1a 64 in decimal on fd 1 (the glue
note authorizes a mutated fixture through it for the record-refusal runs).
note HV: 0 score bits of the last hvscore, 1 scored, 2 per-record fallbacks, 3 advised
note cost, 4 oracle cost, 5 incumbent cost (ps per call, scored records only), 6 budget.
global HM uchar 1
global HK uchar 64
global HV ulong 8
text HNL "\n"
text HSDIS "SHADOW disabled"
text HSREC "SHADOW records="
text HSDF " data_fnv="
text HSAL " allow="
text HSIMG "SHADOW image_fnv="
text HSKI " kind="
text HSNP " nparams="
text HSDB " data_bound="
text HSBM " bound_matches="
text HSYES "yes"
text HSNO "no"
text HFREC "FALLBACK all reason=records-"
text HFALW "FALLBACK all reason=allow-"
text HFIMG "FALLBACK all reason=image-"
text HFSEQ "FALLBACK seq="
text HREAS " reason="
text HROOD "ood"
text HRSIN "single"
text HRNON "nonfinite"
text HRBUD "budget"
text HASEQ "ADVICE seq="
text HAARM " arm="
text HAINC " incumbent="
text HAORA " oracle="
text HASCO " score="
text HCREC "COST records="
text HCSCO " scored="
text HCFB " fallback="
text HCADV " adv_cost="
text HCORA " oracle_cost="
text HCINC " incumbent_cost="

fn hvnl to void
w = write 1 HNL 0 1
end

fn hkw i ulong to ulong
note Config word i (little-endian) from HK.
v = ulong 0
for k ulong 8
v = or v shl ulong get HK add mul i 8 k mul k 8
end
ret v
end

fn hvrdk n ulong to ulong
note Up to n bytes into HK[0..n); returns the count read.
o = ulong 0
while lt o n bound 64
r = read 0 HK o sub n o
if lt r 0
exit 74
end
if eq r 0
ret o
end
o = add o ulong r
end
ret o
end

fn hvrdlb to ulong
note The allow-list block: 4096 bytes, zero padded; returns the used length.
o = ulong 0
while lt o 4096 bound 4096
r = read 0 LB o sub 4096 o
if lt r 0
exit 74
end
if eq r 0
ret o
end
o = add o ulong r
end
n = ulong 0
for i ulong 4096
if ne get LB i 0
n = add i 1
end
end
ret n
end

fn hvrdimg n ulong to ulong
note Up to n image bytes into SI[0..n); never reads past them.
o = ulong 0
while lt o n bound 32768
r = read 0 SI o sub n o
if lt r 0
exit 74
end
if eq r 0
ret o
end
o = add o ulong r
end
ret o
end

fn hvrdrb to ulong
note Records to end of input into RB; 524289 means more than the capacity arrived.
o = ulong 0
while lt o 524288 bound 999999
r = read 0 RB o sub 524288 o
if lt r 0
exit 74
end
if eq r 0
ret o
end
o = add o ulong r
end
r = read 0 HM 0 1
if ne r 0
ret 524289
end
ret o
end

fn hvwrb n ulong to void
o = ulong 0
while lt o n bound 999999
w = write 1 RB o sub n o
if le w 0
exit 74
end
o = add o ulong w
end
end

fn hvood r ulong to bool
note Never in training: core class 2 or a pressure bucket above 1.
ret or eq oxcore r 2 gt oxpress r 1
end

fn hvnarms r ulong to ulong
note Admissible arms of record r (oxcand: eligible, measured, verified).
c = ulong 0
for a ulong 8
if oxcand r a
c = add c 1
end
end
ret c
end

fn hvbudget r ulong to bool
note Record index r is past the declared scoring budget HV[6].
ret ge r get HV 6
end

fn hvscore r ulong to long
note The advice: argmin score over the admissible arms under the current params (lowest
note index on a tie); HV[0] keeps the winning score bits. Negative: -1 out of distribution,
note -2 fewer than two admissible arms, -3 a non-finite score among the admissible arms.
if hvood r
ret -1
end
if lt hvnarms r 2
ret -2
end
best = ulong 0
bs = slfwd r 0
ok = affinite bs
for k ulong 7
a = add k 1
if oxcand r a
s = slfwd r a
if not affinite s
ok = false
end
if sllt s bs
bs = s
best = a
end
end
end
put HV 0 bs
if not ok
ret -3
end
ret long best
end

fn hvimage n ulong to int
note Checkpoint admission through select.om's sladmit: every image check except the
note training-dataset binding (0 admitted, state installed; negative refused, nothing
note installed). The binding is information (slbound, printed as bound_matches), never a
note refusal: the advisor by design scores records the model never trained on.
ret sladmit 0 n
end

fn hvcfgok to bool
note budget <= 2048, image length 1..32768 (the SI capacity), reserved words zero.
if gt hkw 1 2048
ret false
end
if or eq hkw 2 0 gt hkw 2 32768
ret false
end
for i ulong 5
if ne hkw add 3 i 0
ret false
end
end
ret true
end

fn hvadmit n ulong lbn ulong to int
note Allow-list status (67) then record admission (66); 0 when admitted, with the line
note SHADOW records=N data_fnv=H allow=S.
if gt n 524288
w = write 1 HFREC 0 len HFREC
wnum 1
hvnl
ret 66
end
st = oxallow lbn oxfnv n
if lt st 0
w = write 1 HFALW 0 len HFALW
wnum ulong neg long st
hvnl
ret 67
end
ld = oxload n
if ne ld 0
w = write 1 HFREC 0 len HFREC
wnum ulong neg long ld
hvnl
ret 66
end
w = write 1 HSREC 0 len HSREC
wnum get RC 0
w = write 1 HSDF 0 len HSDF
wnum get RC 2
w = write 1 HSAL 0 len HSAL
wnum ulong st
hvnl
ret 0
end

fn hvimg n ulong to int
note Checkpoint admission with its SHADOW line; 1 when refused (FALLBACK all printed).
st = hvimage n
if lt st 0
w = write 1 HFIMG 0 len HFIMG
wnum ulong neg long st
hvnl
ret 1
end
w = write 1 HSIMG 0 len HSIMG
wnum siget sub n 8
w = write 1 HSKI 0 len HSKI
wnum get SS 0
w = write 1 HSNP 0 len HSNP
wnum get SS 15
w = write 1 HSDB 0 len HSDB
wnum get SS 11
w = write 1 HSBM 0 len HSBM
if slbound 0
w = write 1 HSYES 0 len HSYES
else
w = write 1 HSNO 0 len HSNO
end
hvnl
ret 0
end

fn hvfb r ulong code long to void
note FALLBACK seq=S reason=... for one record; counts it.
w = write 1 HFSEQ 0 len HFSEQ
wnum oxseq r
w = write 1 HREAS 0 len HREAS
if eq code -1
w = write 1 HROOD 0 len HROOD
end
if eq code -2
w = write 1 HRSIN 0 len HRSIN
end
if eq code -3
w = write 1 HRNON 0 len HRNON
end
if eq code -4
w = write 1 HRBUD 0 len HRBUD
end
hvnl
put HV 2 add get HV 2 1
end

fn hvadv r ulong a ulong to void
note ADVICE seq=S arm=A incumbent=R oracle=O score=BITS; cost sums over scored records.
w = write 1 HASEQ 0 len HASEQ
wnum oxseq r
w = write 1 HAARM 0 len HAARM
wnum a
w = write 1 HAINC 0 len HAINC
wnum oxrule r
w = write 1 HAORA 0 len HAORA
wnum oxbest r
w = write 1 HASCO 0 len HASCO
wnum get HV 0
hvnl
put HV 1 add get HV 1 1
put HV 3 add get HV 3 oxcost r a
put HV 4 add get HV 4 oxcost r oxbest r
put HV 5 add get HV 5 oxcost r oxrule r
end

fn hvrec r ulong to void
if hvbudget r
hvfb r -4
ret
end
c = hvscore r
if lt c 0
hvfb r c
ret
end
hvadv r ulong c
end

fn hvcost to void
w = write 1 HCREC 0 len HCREC
wnum get RC 0
w = write 1 HCSCO 0 len HCSCO
wnum get HV 1
w = write 1 HCFB 0 len HCFB
wnum get HV 2
w = write 1 HCADV 0 len HCADV
wnum get HV 3
w = write 1 HCORA 0 len HCORA
wnum get HV 4
w = write 1 HCINC 0 len HCINC
wnum get HV 5
hvnl
end

fn hvrun to int
note S: read the stream in admission order, then advise record by record.
if ne hvrdk 64 64
ret 68
end
if ne hkw 0 1
w = write 1 HSDIS 0 len HSDIS
hvnl
ret 0
end
if not hvcfgok
ret 68
end
for i ulong 8
put HV i 0
end
put HV 6 hkw 1
lbn = hvrdlb
img = hkw 2
if ne hvrdimg img img
w = write 1 HFIMG 0 len HFIMG
wnum 1
hvnl
ret 0
end
n = hvrdrb
st = hvadmit n lbn
if ne st 0
ret st
end
if ne hvimg img 0
ret 0
end
slbest
for r ulong get RC 0
hvrec r
end
hvcost
ret 0
end

fn hvgen to int
if ne hvrdk 16 16
ret 68
end
if or eq hkw 1 0 gt hkw 1 2048
ret 68
end
hvwrb sxgen hkw 0 hkw 1
ret 0
end

fn hvhash to int
note H: the FNV-1a 64 of the record bytes on stdin (the allow-list identity), decimal.
n = hvrdrb
if gt n 524288
ret 66
end
wnum oxfnv n
hvnl
ret 0
end
