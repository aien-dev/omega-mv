{"choices":[{"finish_reason":"stop","index":0,"message":{"content":"It didn’t just rise; it surged with a bruised, milky fury that swallowed the riverbanks in hours. By midnight, the water had lapped at the lowest arches, sending plumes of foam through the stone gaps like breathing. The village elder, gazing from his porch through the rain-slicked dark, watched as the current grew too heavy for the ancient masonry to ignore. A low groan, louder than the thunder rolling overhead, shuddered through the deck. Then, a single granite block shifted, the sound as sickeningly final as a bone breaking.","role":"assistant"}}],"created":1792461344,"id":"chatcmpl-18e01a18ab32829f0077","model":"qwen3.8-27b-fp8","object":"chat.completion","usage":{"aien_sampling":{"greedy_tokens":0,"kept":[248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320,248320],"kept_max":248320,"kept_mean":248320.0,"kept_median":248320,"kept_min":248320,"kept_single":0,"mode":"sampled","p_repeat":1.2656767570831106e-61,"reply_logprob":-140.22208370767476,"sampled_tokens":122,"seed":3003,"temperature":1.0,"top_k":0,"top_k_applied":false,"top_p":1.0,"top_prob_mean":0.7021974990562648,"top_prob_min":0.16646502142656197},"aien_token