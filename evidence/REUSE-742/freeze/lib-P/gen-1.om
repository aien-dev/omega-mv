acc = r1fold f acc mtl11 get R1X i
end
put R1R 0 acc
put R1R 1 n
end
fn mtl12 x ulong to ulong
v = x
v = xor v get R1P 6
ret v
end
fn mtr12 to void
f = get R1P 3
n = get R1N 0
acc = r1ident f
for i ulong n
acc = r1fold f acc mtl12 get R1X i
