fn mtr15 to void
q = get R1P 4
n = get R1N 0
sum = ulong 0
for i ulong n
q = get R1T add mul q 16 get R1X i
sum = add sum get R1P add 6 q
end
put R1R 0 q
put R1R 1 sum
end
fn mtcount to ulong
ret 16
end
fn mtshape t ulong to ulong
if eq t 0
