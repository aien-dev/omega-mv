index 3cf114a3..d8f02a5b 100644
--- a/seed/omc/omc.om
+++ b/seed/omc/omc.om
@@ -3729,6 +3729,741 @@ put fr q 5
 put fr add q 1 ulong get nm_reg sub e 1
 put fr add q 2 e
 end
+note ---- R6 IR. A leading line `ir` writes OSC IR version 1. The AArch64 path is not taken.
+note Worksheet ir_match.py matched omega_emit on the 10 dev programs; this is that algorithm.
+
+global ir_rty uchar 64
+global ir_nreg ulong 1
+global ir_nm ulong 32
+global ir_nrr uchar 32
+global ir_nn ulong 1
+global ir_cty uchar 32
+global ir_cm ulong 32
+global ir_cr uchar 32
+global ir_nc ulong 1
+global ir_bord ulong 32
+global ir_nord ulong 1
+global ir_cur ulong 1
+global ir_dead ulong 1
+global ir_nb ulong 1
+global ir_ok uchar 256
+global ir_oa ulong 256
+global ir_ob ulong 256
+global ir_oc ulong 256
+global ir_od ulong 256
+global ir_obl ulong 256
+global ir_no ulong 1
+global ir_bf ulong 32
+global ir_bc ulong 32
+global ir_fk uchar 8
+global ir_fa ulong 8
+global ir_fb ulong 8
+global ir_fc ulong 8
+global ir_fd ulong 8
+global ir_nf ulong 1
+global ir_ret ulong 1
+global ir_npar ulong 1
+global ir_rr ulong 1
+global ir_vt ulong 1
+global ir_bare ulong 1
+global ir_isb ulong 1
+global ir_ns ulong 1
+global ir_nl ulong 1
+global ir_have ulong 1
+
+fn ir_lead to ulong
+p = ulong 0
+while and lt p get inlen 0 le get inp p 32
+if eq get inp p 10
+ret 0
+end
+p = add p 1
+end
+if ge add p 3 get inlen 0
+ret 0
+end
+if ne get inp p 105
+ret 0
+end
+if ne get inp add p 1 114
+ret 0
+end
+if gt get inp add p 2 32
+ret 0
+end
+q = add p 2
+while and lt q get inlen 0 ne get inp q 10
+q = add q 1
+end
+if lt q get inlen 0
+q = add q 1
+end
+put cur 0 q
+put line 0 2
+ret 1
+end
+
+fn ir_w16 v ulong to void
+emitb uchar and v 255
+emitb uchar and shr v 8 255
+end
+
+fn ir_w32 v ulong to void
+ir_w16 v
+ir_w16 shr v 16
+end
+
+fn ir_w64 v ulong to void
+ir_w32 v
+ir_w32 shr v 32
+end
+
+fn ir_newreg ty ulong to ulong
+r = get ir_nreg 0
+if ge r 64
+fail 14
+end
+put ir_rty r uchar ty
+put ir_nreg 0 add r 1
+ret r
+end
+
+fn ir_block to ulong
+b = get ir_nb 0
+if ge b 32
+fail 14
+end
+put ir_bord b 65535
+put ir_nb 0 add b 1
+ret b
+end
+
+fn ir_start b ulong to void
+put ir_bord b get ir_nord 0
+put ir_nord 0 add get ir_nord 0 1
+put ir_cur 0 b
+put ir_dead 0 0
+end
+
+fn ir_op k ulong a ulong b ulong c ulong d ulong to void
+if ne get ir_dead 0 0
+fail 17
+end
+n = get ir_no 0
+if ge n 256
+fail 14
+end
+put ir_ok n uchar k
+put ir_oa n a
+put ir_ob n b
+put ir_oc n c
+put ir_od n d
+put ir_obl n get ir_cur 0
+put ir_no 0 add n 1
+end
+
+fn ir_lit mag ulong ty ulong to ulong
+i = ulong 0
+n = get ir_nc 0
+while lt i n
+if and eq ulong get ir_cty i ty eq get ir_cm i mag
+ret ulong get ir_cr i
+end
+i = add i 1
+end
+if ge n 32
+fail 14
+end
+r = ir_newreg ty
+put ir_cty n uchar ty
+put ir_cm n mag
+put ir_cr n uchar r
+put ir_nc 0 add n 1
+ret r
+end
+
+fn ir_find w ulong to ulong
+i = ulong 0
+while lt i get ir_nn 0
+if eq get ir_nm i w
+ret add i 1
+end
+i = add i 1
+end
+ret 0
+end
+
+fn ir_bind w ulong r ulong to void
+n = get ir_nn 0
+put ir_nm n w
+put ir_nrr n uchar r
+put ir_nn 0 add n 1
+end
+
+fn ir_push k ulong a ulong b ulong c ulong d ulong to void
+n = get ir_nf 0
+put ir_fk n uchar k
+put ir_fa n a
+put ir_fb n b
+put ir_fc n c
+put ir_fd n d
+put ir_nf 0 add n 1
+end
+
+fn ir_set dst ulong r ulong ty ulong to void
+put ir_isb 0 0
+if eq dst 65534
+put ir_rr 0 r
+put ir_vt 0 ty
+ret
+end
+d = dst
+if eq dst 65535
+d = ir_newreg ty
+end
+ir_op 2 d r 0 0
+put ir_rr 0 d
+put ir_vt 0 ty
+end
+
+fn ir_ord id ulong to ulong
+ret get ir_bord id
+end
+
+fn ir_count k ulong to ulong
+n = ulong 0
+if eq k 0
+n = get ir_nc 0
+end
+i = ulong 0
+while lt i get ir_no 0
+if eq ir_ord get ir_obl i k
+n = add n 1
+end
+i = add i 1
+end
+ret n
+end
+
+fn ir_layout to void
+k = ulong 0
+at = ulong 0
+while lt k get ir_nord 0
+put ir_bf k at
+c = ir_count k
+put ir_bc k c
+at = add at c
+k = add k 1
+end
+put ir_no 0 get ir_no 0
+end
+
+fn ir_wconst to void
+i = ulong 0
+while lt i get ir_nc 0
+emitb 1
+ir_w16 ulong get ir_cr i
+ir_w64 get ir_cm i
+i = add i 1
+end
+end
+
+fn ir_wins k ulong to void
+if eq k 0
+ir_wconst
+end
+i = ulong 0
+while lt i get ir_no 0
+if eq ir_ord get ir_obl i k
+op = ulong get ir_ok i
+emitb uchar op
+if eq op 1
+ir_w16 get ir_oa i
+ir_w64 get ir_ob i
+end
+if eq op 2
+ir_w16 get ir_oa i
+ir_w16 get ir_ob i
+end
+if eq op 3
+emitb uchar get ir_oa i
+ir_w16 get ir_ob i
+ir_w16 get ir_oc i
+ir_w16 get ir_od i
+end
+if eq op 4
+emitb uchar get ir_oa i
+ir_w16 get ir_ob i
+ir_w16 get ir_oc i
+end
+if eq op 5
+emitb uchar get ir_oa i
+ir_w16 get ir_ob i
+ir_w16 get ir_oc i
+ir_w16 get ir_od i
+end
+if eq op 6
+ir_w16 get ir_oa i
+ir_w16 get ir_ob i
+end
+if eq op 12
+emitb uchar get ir_oa i
+end
+if eq op 13
+ir_w16 ir_ord get ir_oa i
+end
+if eq op 14
+ir_w16 get ir_oa i
+ir_w16 ir_ord get ir_ob i
+ir_w16 ir_ord get ir_oc i
+end
+if eq op 15
+ir_w16 get ir_oa i
+end
+end
+i = add i 1
+end
+end
+
+fn ir_encode to void
+put oc 0 0
+emitb 79
+emitb 83
+emitb 67
+emitb 49
+emitb 73
+emitb 82
+emitb 0
+emitb 1
+ir_w16 1
+emitb uchar get ir_nl 0
+p = get ir_ns 0
+e = add p get ir_nl 0
+while lt p e
+emitb get inp p
+p = add p 1
+end
+emitb uchar get ir_npar 0
+emitb uchar get ir_ret 0
+ir_w16 get ir_nreg 0
+i = ulong 0
+while lt i get ir_nreg 0
+emitb get ir_rty i
+i = add i 1
+end
+ir_layout
+ir_w16 get ir_nord 0
+k = ulong 0
+while lt k get ir_nord 0
+ir_w32 get ir_bf k
+ir_w32 get ir_bc k
+k = add k 1
+end
+tot = ulong 0
+k = ulong 0
+while lt k get ir_nord 0
+tot = add tot get ir_bc k
+k = add k 1
+end
+ir_w32 tot
+k = ulong 0
+while lt k get ir_nord 0
+ir_wins k
+k = add k 1
+end
+ir_w16 0
+ir_w16 0
+end
+
+fn ir_name to void
+e = ir_find get tw 0
+if eq e 0
+fail 3
+end
+r = ulong get ir_nrr sub e 1
+ir_set 65534 r ulong get ir_rty r
+end
+
+fn ir_un c ulong dst ulong to void
+ir_val 65534 0
+ty = get ir_vt 0
+d = dst
+if or eq dst 65534 eq dst 65535
+d = ir_newreg ty
+end
+su = ulong 1
+if eq c 50
+su = ulong 3
+if ne ty 1
+su = ulong 2
+end
+end
+ir_op 4 su d get ir_rr 0 0
+put ir_rr 0 d
+put ir_vt 0 ty
+put ir_isb 0 0
+end
+
+fn ir_bin_r left ulong lty ulong c ulong dst ulong to void
+exp2 = lty
+if or eq c 41 eq c 42
+exp2 = ulong 0
+end
+ir_val 65534 exp2
+right = get ir_rr 0
+if ne get ir_isb 0 0
+right = ir_lit get ir_bare 0 lty
+end
+if ge c 43
+d = ir_newreg 1
+ir_op 5 sub c 42 d left right
+put ir_rr 0 d
+put ir_vt 0 1
+ret
+end
+d = dst
+if or eq dst 65534 eq dst 65535
+d = ir_newreg lty
+end
+ir_op 3 sub c 32 d left right
+put ir_rr 0 d
+put ir_vt 0 lty
+put ir_isb 0 0
+end
+
+fn ir_bin c ulong dst ulong to void
+ir_val 65534 0
+if ne get ir_isb 0 0
+mag = get ir_bare 0
+ir_val 65534 0
+ty = get ir_vt 0
+left = ir_lit mag ty
+ir_bin_r left ty c dst
+ret
+end
+left = get ir_rr 0
+lty = get ir_vt 0
+ir_bin_r left lty c dst
+end
+
+fn ir_cast c ulong dst ulong to void
+ir_val 65534 c
+if ne get ir_isb 0 0
+r = ir_lit get ir_bare 0 c
+ir_set dst r c
+ret
+end
+src = get ir_rr 0
+sty = get ir_vt 0
+if and eq sty c eq dst 65534
+put ir_rr 0 src
+put ir_vt 0 c
+put ir_isb 0 0
+ret
+end
+d = dst
+if or eq dst 65534 eq dst 65535
+d = ir_newreg c
+end
+if eq sty c
+ir_op 2 d src 0 0
+else
+ir_op 6 d src 0 0
+end
+put ir_rr 0 d
+put ir_vt 0 c
+put ir_isb 0 0
+end
+
+fn ir_val dst ulong exp ulong to void
+put ir_isb 0 0
+tok
+if eq get tk 0 2
+if eq exp 0
+put ir_bare 0 get tw 0
+put ir_isb 0 1
+ret
+end
+r = ir_lit get tw 0 exp
+ir_set dst r exp
+ret
+end
+c = kw get tw 0
+if and ge c 1 le c 9
+ir_cast c dst
+ret
+end
+if and ge c 33 le c 48
+ir_bin c dst
+ret
+end
+if or eq c 49 eq c 50
+ir_un c dst
+ret
+end
+if eq c 55
+r = ir_lit 1 1
+ir_set dst r 1
+ret
+end
+if eq c 56
+r = ir_lit 0 1
+ir_set dst r 1
+ret
+end
+ir_name
+if ne dst 65534
+ir_set dst get ir_rr 0 get ir_vt 0
+end
+end
+
+fn ir_end to void
+n = sub get ir_nf 0 1
+put ir_nf 0 n
+k = ulong get ir_fk n
+if eq k 1
+if eq get ir_fc n 0
+if eq get ir_dead 0 0
+ir_op 13 get ir_fb n 0 0 0
+put ir_dead 0 1
+end
+ir_start get ir_fb n
+else
+if eq get ir_dead 0 0
+if eq get ir_fd n 65535
+j = ir_block
+put ir_fd n j
+end
+ir_op 13 get ir_fd n 0 0 0
+put ir_dead 0 1
+end
+if ne get ir_fd n 65535
+ir_start get ir_fd n
+end
+end
+end
+if eq k 2
+if eq get ir_dead 0 0
+ir_op 13 get ir_fa n 0 0 0
+put ir_dead 0 1
+end
+ir_start get ir_fb n
+end
+if eq k 3
+if eq get ir_dead 0 0
+one = ir_lit 1 ulong get ir_rty get ir_fc n
+ir_op 3 1 get ir_fc n get ir_fc n one
+ir_op 13 get ir_fa n 0 0 0
+put ir_dead 0 1
+end
+ir_start get ir_fb n
+end
+if eq k 4
+put ir_have 0 1
+end
+end
+
+fn ir_if to void
+ir_val 65534 1
+th = ir_block
+el = ir_block
+ir_op 14 get ir_rr 0 th el 0
+ir_push 1 th el 0 65535
+ir_start th
+end
+
+fn ir_else to void
+n = sub get ir_nf 0 1
+if eq get ir_dead 0 0
+j = ir_block
+ir_op 13 j 0 0 0
+put ir_dead 0 1
+put ir_fd n j
+else
+put ir_fd n 65535
+end
+put ir_fc n 1
+ir_start get ir_fb n
+end
+
+fn ir_while to void
+z = ir_lit 0 5
+one = ir_lit 1 5
+cnt = ir_newreg 5
+ir_op 2 cnt z 0 0
+h = ir_block
+g = ir_block
+tb = ir_block
+body = ir_block
+ex = ir_block
+ir_op 13 h 0 0 0
+put ir_dead 0 1
+ir_start h
+ir_val 65534 1
+bnd = ulong 1000000
+tok
+if and eq get tk 0 1 eq kw get tw 0 70
+tok
+bnd = get tw 0
+end
+lim = ir_lit bnd 5
+ir_op 14 get ir_rr 0 g ex 0
+ir_start g
+ger = ir_newreg 1
+ir_op 5 6 ger cnt lim
+ir_op 14 ger tb body 0
+ir_start tb
+ir_op 12 4 0 0 0
+ir_op 13 ex 0 0 0
+put ir_dead 0 1
+ir_start body
+ir_op 3 1 cnt cnt one
+ir_push 2 h ex cnt 0
+end
+
+fn ir_for to void
+tok
+w = get tw 0
+tok
+ty = kw get tw 0
+tok
+k = get tw 0
+z = ir_lit 0 ty
+kk = ir_lit k ty
+uu = ir_lit 1 ty
+ctr = ir_newreg ty
+ir_bind w ctr
+ir_op 2 ctr z 0 0
+h = ir_block
+body = ir_block
+ex = ir_block
+ir_op 13 h 0 0 0
+put ir_dead 0 1
+ir_start h
+c = ir_newreg 1
+ir_op 5 3 c ctr ir_lit k ty
+ir_op 14 c body ex 0
+ir_push 3 h ex ctr 0
+ir_start body
+end
+
+fn ir_doret to void
+tok
+if or eq get tk 0 0 eq get tk 0 3
+ir_op 15 65535 0 0 0
+else
+put cur 0 get ts 0
+ir_val 65534 get ir_ret 0
+ir_op 15 get ir_rr 0 0 0 0
+end
+put ir_dead 0 1
+end
+
+fn ir_assign w ulong to void
+tok
+if ne kw get tw 0 73
+put cur 0 get ts 0
+end
+e = ir_find w
+if eq e 0
+ir_val 65535 0
+ir_bind w get ir_rr 0
+else
+r = ulong get ir_nrr sub e 1
+ir_val r ulong get ir_rty r
+end
+end
+
+fn ir_stmt to ulong
+tok
+if or eq get tk 0 0 eq get tk 0 3
+ret 0
+end
+c = kw get tw 0
+if eq c 66
+ir_end
+ret 0
+end
+if eq c 68
+ir_else
+ret 0
+end
+if eq c 67
+ir_if
+ret 0
+end
+if eq c 69
+ir_while
+ret 0
+end
+if eq c 71
+ir_for
+ret 0
+end
+if eq c 72
+ir_doret
+ret 0
+end
+if eq c 64
+fail 15
+end
+ir_assign get tw 0
+ret 0
+end
+
+fn ir_fn to void
+tok
+put ir_ns 0 get ts 0
+put ir_nl 0 get tl 0
+put ir_nreg 0 0
+put ir_nn 0 0
+put ir_nc 0 0
+put ir_nb 0 0
+put ir_nord 0 0
+put ir_no 0 0
+put ir_nf 0 0
+put ir_dead 0 0
+go = true
+while go
+tok
+if eq kw get tw 0 65
+go = false
+else
+w = get tw 0
+tok
+r = ir_newreg kw get tw 0
+ir_bind w r
+end
+end
+tok
+put ir_ret 0 kw get tw 0
+put ir_npar 0 get ir_nreg 0
+b = ir_block
+ir_start b
+ir_push 4 0 0 0 0
+put ir_have 0 0
+while eq get ir_have 0 0
+ignored = ir_stmt
+end
+end
+
+fn ir_run to void
+go = true
+while go
+tok
+if eq get tk 0 3
+go = false
+else
+if eq kw get tw 0 64
+ir_fn
+end
+end
+end
+ir_encode
+n = write 1 out 0 get oc 0
+exit 0
+end
+
 note main: read all of stdin
 note (8 MiB at most, error 14; a read error is 1), find the mode, then one
 note statement per line from output byte 180 (om4 START .. STMT)
@@ -3754,6 +4489,9 @@ m = add m 1
 end
 end
 put inlen 0 off
+if ne ir_lead 0
+ir_run
+end
 prescan
 namescan
 put oc 0 180
