fn days_between(y1: u16, m1: u8, d1: u8, y2: u16, m2: u8, d2: u8) -> i32 {
    let mut date1_days: i32 = 0;
    let mut date2_days: i32 = 0;
    let mut y: u16 = y1;
    let mut m: u8 = m1;
    let mut d: u8 = d1;
    let mut total_days: i32 = 0;

    // Helper function to check if a year is a leap year
    let is_leap = |y: u16| -> bool {
        if y % 4 != 0 {
            false
        } else if y % 100 != 0 {
            true
        } else if y % 400 != 0 {
            false
        } else {
            true
        }
    };

    // Helper function to get the number of days in a month
    let days_in_month = |y: u16, m: u8| -> u8 {
        match m {
            1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
            4 | 6 | 9 | 11 => 30,
            2 => {
                if is_leap(y) {
                    29
                } else {
                    28
                }
            },
            _ => 0,
        }
    };

    // Helper function to convert date to days since year 0
    let convert_to_days = |y: u16, m: u8, d: u8| -> i32 {
        let mut days: i32 = 0;
        let mut current_year: u16 = y;
        let mut current_month: u8 = m;
        let mut current_day: u8 = d;

        // Add days for all years before y
        for year in 0..current_year {
            if is_leap(year) {
                days += 366;
            } else {
                days += 365;
            }
        }

        // Add days for months before m
        for month in 1..current_month {
            days += days_in_month(current_year, month) as i32;
        }

        // Add days for the current month
        days += current_day as i32;

        days
    };

    // Convert both dates to days since year 0
    date1_days = convert_to_days(y1, m1, d1);
    date2_days = convert_to_days(y2, m2, d2);

    // Check if either date is invalid
    if y1 < 1 || y1 > 9999 || m1 < 1 || m1 > 12 || d1 < 1 || d1 > days_in_month(y1, m1) {
        return -2147483648;
    }
    if y2 < 1 || y2 > 9999 || m2 < 1 || m2 > 12 || d2 < 1 || d2 > days_in_month(y2, m2) {
        return -2147483648;
    }

    // Calculate the difference
    total_days = date2_days - date1_days;

    return total_days;
}
