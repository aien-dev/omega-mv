fn days_between(y1: u16, m1: u8, d1: u8, y2: u16, m2: u8, d2: u8) -> i32 {
    let mut total_days: i32 = 0;
    let mut date1 = (y1, m1, d1);
    let mut date2 = (y2, m2, d2);
    let mut current_date = date1;
    let mut target_date = date2;

    // Check if both dates are valid
    if !is_valid_date(date1) || !is_valid_date(date2) {
        return -2147483648;
    }

    // Determine which date is earlier
    if date1 > date2 {
        current_date = date2;
        target_date = date1;
    }

    // Calculate days between the two dates
    while current_date != target_date {
        current_date = next_day(current_date);
        total_days += 1;
    }

    // If date1 was earlier than date2, total_days is positive; else, it's negative
    if date1 < date2 {
        total_days
    } else {
        -total_days
    }
}

fn is_valid_date(date: (u16, u8, u8)) -> bool {
    let (y, m, d) = date;
    if y < 1 || y > 9999 {
        return false;
    }
    if m < 1 || m > 12 {
        return false;
    }
    let days_in_month = days_in_month(y, m);
    if d < 1 || d > days_in_month {
        return false;
    }
    true
}

fn days_in_month(y: u16, m: u8) -> u8 {
    match m {
        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
        4 | 6 | 9 | 11 => 30,
        2 => {
            if is_leap_year(y) {
                29
            } else {
                28
            }
        }
        _ => 0,
    }
}

fn is_leap_year(y: u16) -> bool {
    if y % 4 != 0 {
        return false;
    }
    if y % 100 != 0 {
        return true;
    }
    y % 400 == 0
}

fn next_day(date: (u16, u8, u8)) -> (u16, u8, u8) {
    let (y, m, d) = date;
    let days_in_month = days_in_month(y, m);
    if d < days_in_month {
        (y, m, d + 1)
    } else {
        if m < 12 {
            (y, m + 1, 1)
        } else {
            (y + 1, 1, 1)
        }
    }
}
