```osc
fn count_primes_below(n: u16) -> u16 {
    if n <= 2 {
        return 0;
    }
    let mut count = 0;
    let mut i = 2;
    while i < n {
        if is_prime(i) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn is_prime(x: u16) -> bool {
    if x == 1 {
        return false;
    }
    if x == 2 {
        return true;
    }
    if x % 2 == 0 {
        return false;
    }
    let mut i = 3;
    while i * i <= x {
        if x % i == 0 {
            return false;
        }
        i = i + 2;
    }
    return true;
}
```