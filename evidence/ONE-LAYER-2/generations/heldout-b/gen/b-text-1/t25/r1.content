```osc
fn collatz16(n: u16) -> u16 {
    let mut steps: u16 = 0;
    let mut current = n;
    while current != 1 {
        if current % 2 == 0 {
            current = current / 2;
        } else {
            current = 3 * current + 1;
        }
        steps = steps + 1;
    }
    return steps;
}
```