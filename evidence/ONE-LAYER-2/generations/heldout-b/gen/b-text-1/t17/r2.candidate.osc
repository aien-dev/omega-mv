fn mod_inv(a: u32, m: u32) -> u32 {
    if m < 2 {
        return 0;
    }
    let mut x = 0;
    let mut y = 1;
    let mut m1 = m;
    let mut a1 = a;
    let mut m2 = 1;
    let mut a2 = a % m;
    while a2 != 0 {
        let q = a1 / a2;
        let r = a1 % a2;
        a1 = a2;
        a2 = r;
        let t = x;
        x = m1 - q * x;
        m1 = t;
    }
    if m1 < 0 {
        m1 += m;
    }
    return m1;
}
