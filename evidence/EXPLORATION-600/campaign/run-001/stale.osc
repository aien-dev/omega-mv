// Pure bounded experiment state. No effects, runtime authority or promotion.
// Layout is documented in README.md. All arithmetic uses bounded u64 values.
fn count(mask: u64) -> u64 {
    let mut n: u64 = 0;
    for i in 0 .. 15 { if (mask & (1 << i)) != 0 { n = n + 1; } }
    return n;
}
fn initialize(s: &mut [u64; 64], arm: u64, seed: u64, budget: u64, capacity: u64) -> u64 {
    for i in 0 .. 64 { s[i] = 0; }
    s[0] = 6001; s[1] = arm; s[2] = seed; s[3] = budget;
    s[7] = 100; s[8] = 6; s[9] = 1; s[13] = 2; s[17] = capacity; s[19] = 100;
    if arm > 3 || seed == 0 || seed > 65535 || budget > 1024 || capacity == 0 || capacity > 8 {
        s[10] = 3;
    }
    if capacity == 1 { s[8] = 2; s[12] = 1; s[13] = 1; }
    if s[10] == 0 && budget < 7 + count(s[8]) { s[10] = 2; }
    return s[10];
}
