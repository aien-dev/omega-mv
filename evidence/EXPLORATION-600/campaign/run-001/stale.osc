    if s[8] == 0 { s[10] = 1; return 1; }
    let rent: u64 = count(s[8]);
    let charge: u64 = 7 + rent;
    if charge > s[3] - s[4] { s[10] = 2; return 2; }
    s[4] = s[4] + charge; s[20] = s[20] + rent;
    s[21] = s[21] + 3; s[22] = s[22] + 2; s[23] = s[23] + 2;
    s[27] = 1; s[28] = s[28] + 1;
    s[14] = s[14] + 840; s[15] = s[15] + 1;
