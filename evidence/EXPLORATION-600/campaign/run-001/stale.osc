}
fn abandon(s: &mut [u64; 64], cost: &[u64; 16]) -> u64 {
    if s[27] != 1 || s[10] != 0 || cost[0] != 100 { s[10] = 3; return 3; }
    s[27] = 0; s[26] = s[26] + 1;
