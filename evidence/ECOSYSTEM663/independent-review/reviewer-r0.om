note Independent reviewer probes for metadata source3a995ba8.
note Small 3D oracle enumerates elements. It does not use maximum extents.
global RC ulong 1
global SaveD ulong 24
global SaveS ulong 8
global Dig uchar 20
text Pass "TENSOR_REVIEW_PASS checks="
text NL "\n"

fn ck b bool to void
put RC 0 add get RC 0 1
if not b
exit 1
end
end

fn base to void
for d ulong 24
put ED d 0
end
for d ulong 8
put ES d 0
end
put ED 0 1
put ED 1 1
put ED 3 1
put ED 5 9
put ED 6 23
put ES 0 1
put ES 2 9
put ES 3 23
put ES 4 1
put ES 5 1
end

fn snap to void
for d ulong 24
put SaveD d get ED d
end
for d ulong 8
put SaveS d get ES d
end
end

fn same to void
for d ulong 24
ck eq get SaveD d get ED d
end
for d ulong 8
ck eq get SaveS d get ES d
end
end

fn boundsoracle to int
for i ulong get ED 8
for j ulong get ED 9
for k ulong get ED 10
x = add get ED 4 mul i get ED 16
x = add x mul j get ED 17
x = add x mul k get ED 18
if ge x get ES 5
ret -6
end
end
end
end
ret 0
end

fn three to void
base
put ED 2 3
for a ulong 2
put ED 8 add a 1
for b ulong 2
put ED 9 add b 1
for c ulong 2
put ED 10 add c 1
put ED 3 mul add a 1 mul add b 1 add c 1
for s ulong 5
put ED 16 s
for t ulong 5
put ED 17 t
for u ulong 5
put ED 18 u
for off ulong 4
put ED 4 off
for cap ulong 12
put ES 5 add cap 1
want = boundsoracle
got = emcheck
ck eq got want
end
end
end
end
end
end
end
end
end

