note M20 metadata-v1. Integer metadata only; no allocator or numeric execution.
note ED: schema,dtype,rank,elements,offset,slot,generation,reserved,shape8,stride8.
note ES: live,retired,slot,generation,dtype,elements,reserved,reserved.
note ES is the caller-owned allocator snapshot. It is not untrusted wire input.
global ED ulong 24
global ES ulong 8

fn emshape to int
rank = get ED 2
if gt rank 8
ret -2
end
n = ulong 1
for d ulong rank
size = get ED add 8 d
if eq size 0
ret -3
end
if gt size div 1073741824 n
ret -8
end
n = mul n size
end
if ne get ED 3 n
ret -3
end
ret 0
end

fn emlive slot ulong gen ulong to int
if gt slot 4294967295
ret -5
end
if or ne get ES 0 1 ne get ES 1 0
ret -5
end
if or eq gen 0 ne slot get ES 2
ret -5
end
if ne gen get ES 3
ret -5
end
ret 0
end

fn embounds to int
size = get ES 5
offset = get ED 4
if or eq size 0 gt size 1073741824
ret -8
end
if ge offset size
ret -6
end
note Compare against remaining extent before multiplication, never overflow.
room = sub sub size 1 offset
for d ulong get ED 2
count = sub get ED add 8 d 1
stride = get ED add 16 d
if ne stride 0
if gt count div room stride
ret -6
end
room = sub room mul count stride
end
end
ret 0
end

fn emcheck to int
if or ne get ED 0 1 ne get ED 7 0
ret -1
end
if or ne get ES 6 0 ne get ES 7 0
ret -1
end
dtype = get ED 1
if or lt dtype 1 gt dtype 3
ret -4
end
status = emshape
if ne status 0
ret status
end
status = emlive get ED 5 get ED 6
if ne status 0
ret status
end
if ne dtype get ES 4
ret -4
end
ret embounds
end

fn emrelease slot ulong gen ulong to int
status = emlive slot gen
if ne status 0
ret status
end
note A maximal generation is retired, never wrapped into a valid old handle.
if eq gen 18446744073709551615
put ES 1 0
else
put ES 3 add gen 1
end
put ES 0 0
ret 0
end
note Native checks plus independent element-by-element view bounds oracle.
global EC ulong 1
global Digits uchar 20
text Pass "M20_METADATA_V1_PASS checks="
text Fail "M20_METADATA_V1_FAIL check="
text NL "\n"

fn number n ulong to void
if eq n 0
put Digits 0 48
w = write 1 Digits 0 1
if ne w 1
exit 90
end
ret
end
pos = ulong 20
while gt n 0 bound 20
pos = sub pos 1
put Digits pos uchar add 48 rem n 10
n = div n 10
end
w = write 1 Digits pos sub 20 pos
if ne w long sub 20 pos
exit 90
end
end

fn check got int want int to void
put EC 0 add get EC 0 1
if ne got want
w = write 1 Fail 0 len Fail
number get EC 0
w = write 1 NL 0 1
if ne w 1
exit 90
end
exit 1
end
end

fn fixture to void
for i ulong 24
put ED i 0
end
for i ulong 8
put ES i 0
end
put ED 0 1
put ED 1 1
put ED 2 2
put ED 3 6
put ED 5 4
put ED 6 17
put ED 8 2
put ED 9 3
put ED 16 3
put ED 17 1
put ES 0 1
put ES 2 4
put ES 3 17
put ES 4 1
put ES 5 6
end

fn direct to void
fixture
check emcheck 0
put ED 0 2
check emcheck -1
fixture
put ED 7 1
check emcheck -1
fixture
put ES 6 1
check emcheck -1
fixture
put ES 7 1
check emcheck -1
fixture
put ED 1 0
check emcheck -4
put ED 1 4
check emcheck -4
fixture
put ES 4 2
check emcheck -4
put ED 1 2
check emcheck 0
put ED 1 3
put ES 4 3
check emcheck 0
fixture
put ED 2 9
check emcheck -2
fixture
put ED 8 0
check emcheck -3
fixture
put ED 3 7
check emcheck -3
fixture
put ED 8 1073741824
check emcheck -8
fixture
put ED 8 18446744073709551615
check emcheck -8
fixture
put ES 5 0
check emcheck -8
put ES 5 1073741825
check emcheck -8
fixture
put ED 4 6
check emcheck -6
fixture
put ED 4 18446744073709551615
check emcheck -6
fixture
put ED 16 18446744073709551615
check emcheck -6
fixture
put ED 8 1
put ED 3 3
put ED 16 18446744073709551615
check emcheck 0
fixture
put ED 16 0
check emcheck 0
fixture
put ED 16 1
put ED 17 2
check emcheck 0
put ES 5 5
check emcheck -6
fixture
put ED 2 0
put ED 3 1
put ED 4 5
check emcheck 0
put ED 4 6
check emcheck -6
fixture
put ED 2 8
put ED 3 1
for i ulong 8
put ED add 8 i 1
put ED add 16 i 18446744073709551615
end
check emcheck 0
fixture
put ED 2 1
put ED 8 1073741824
put ED 3 1073741824
put ED 16 0
put ES 5 1
check emcheck 0
put ED 16 1
put ES 5 1073741824
check emcheck 0
put ED 4 1
check emcheck -6
end

fn lifetime to void
fixture
check emlive 4 17 0
put ED 5 0
put ES 2 0
check emcheck 0
put ED 5 4294967295
put ES 2 4294967295
check emcheck 0
put ED 5 4294967296
put ES 2 4294967296
check emcheck -5
fixture
check emlive 5 17 -5
check emlive 4 0 -5
check emlive 4 16 -5
check emrelease 4 16 -5
check emlive 4 17 0
check emrelease 4 17 0
check int get ES 0 0
check int get ES 3 18
check emcheck -5
check emrelease 4 17 -5
put ES 0 1
check emcheck -5
put ED 6 18
check emcheck 0
check emlive 4 17 -5
fixture
put ES 1 1
check emcheck -5
fixture
put ES 0 2
check emcheck -5
fixture
put ES 1 2
check emcheck -5
fixture
put ES 3 18446744073709551615
put ED 6 18446744073709551615
check emcheck 0
check emrelease 4 18446744073709551615 0
check int get ES 0 0
check int get ES 1 1
check emlive 4 18446744073709551615 -5
put ES 0 1
check emcheck -5
if ne get ES 3 18446744073709551615
check 1 0
end
fixture
check emcheck 0
end

note Independent oracle visits every element; it never uses maximal extent.
fn oracle a ulong b ulong s ulong t ulong off ulong cap ulong to int
for i ulong a
for j ulong b
index = add off add mul i s mul j t
if ge index cap
ret -6
end
end
end
ret 0
end

fn enumerate to void
fixture
for ai ulong 3
a = add ai 1
put ED 8 a
for bi ulong 3
b = add bi 1
put ED 9 b
put ED 3 mul a b
for s ulong 5
put ED 16 s
for t ulong 5
put ED 17 t
for off ulong 4
put ED 4 off
for ci ulong 16
cap = add ci 1
put ES 5 cap
want = oracle a b s t off cap
check emcheck want
end
end
end
end
end
end
end

fn main to int
direct
lifetime
enumerate
w = write 1 Pass 0 len Pass
number get EC 0
w = write 1 NL 0 1
if ne w 1
ret 90
end
ret 0
end
