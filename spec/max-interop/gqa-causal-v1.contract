omega-op-contract/1
op=gqa-causal-attention
abi=1
dtype_q=f32
dtype_k=f32
dtype_v=f32
dtype_out=f32
layout_q=token-head-dim
layout_k=token-head-dim
layout_v=token-head-dim
layout_out=token-head-dim
head_dim=128
q_heads_min=1
q_heads_max=64
kv_heads_min=1
kv_heads_max=64
head_map=h_q/(q_heads/kv_heads)
scale=1/sqrt(128)
mask=causal-inclusive
softmax=fp32-max-subtracted
kv_stride=token-major
zero_length=zero-output
alias=forbid
nan=forbid
inf=forbid
tolerance_normal=rel<=2e-4,abs<=2e-5
tolerance_large_scores=rel<=1e-3,abs<=1e-4
reference=fp64-softmax-fp64-weighted-sum
