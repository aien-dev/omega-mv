omega-op-contract/1
op=matmul
abi=1
dtype_a=bf16
dtype_b=bf16
dtype_c=f32
layout_a=row-major
layout_b=row-major
layout_c=row-major
stride_a=contiguous
stride_b=contiguous
stride_c=contiguous
accumulation=fp32
rounding=input-rne-bf16,accumulate-fp32
alpha=1
beta=0
alias=forbid
nan=forbid
inf=forbid
m_min=1
m_max=8192
k_min=1
k_max=16384
n_min=1
n_max=8192
tail=zero-pad-to-multiple-of-16
tolerance=abs<=1e-5*max(1,abs(ref))
reference=fp64-sum-of-exact-bf16-products
