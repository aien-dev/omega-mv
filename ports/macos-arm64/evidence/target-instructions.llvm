	.text
	adr	x1, #-84                        // encoding: [0x61,0xfd,0xff,0x10]
	mov	x16, #1                         // encoding: [0x30,0x00,0x80,0xd2]
                                        // =0x1
	mov	x16, #4                         // encoding: [0x90,0x00,0x80,0xd2]
                                        // =0x4
