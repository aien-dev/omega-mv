note lower: one OSC instruction; 0 or -1 (failed)
fn gpu_lower1 i int to int
s = gpu_ix i
o = get iop s
if eq o 1
bw_movi gpu_r get idst s uint and get iimm s 4294967295 0
ret 0
end
if eq o 2
t = gpu_ty get idst s
if and and ne t 4 ne t 13 ne t 1
gpu_fb 66
gpu_ps t
gpu_fe
ret -1
end
bw_mov gpu_r get idst s gpu_r get ia s 0
ret 0
end
if eq o ogpu
r = gpu_lgpu i
ret r
end
if eq o oshar
ret 0
end
if eq o osync
bw_bar
ret 0
end
if eq o 12
x = get iimm s
if or eq x 0 ge x 16
gpu_fb 68
gpu_pu x
gpu_pt 69
gpu_fe
ret -1
end
bw_trap int x 0 -1
ret 0
end
if eq o oshfl
r = gpu_lshfl i
ret r
end
if eq o omad
bw_i0 33
bw_f gpu_r get idst s gpu_r get ia s gpu_r get ib s gpu_r get ic s
bw_e 0 0
ret 0
end
if or eq o ogld eq o ogst
r = gpu_lglob i
ret r
end
if or eq o 9 eq o 10
r = gpu_lshr i
ret r
end
if eq o 6
r = gpu_lcast i
ret r
end
if eq o 4
r = gpu_lun i
ret r
end
if eq o 5
r = gpu_lcmp i
ret r
end
if eq o 3
r = gpu_lbin i
ret r
end
r = gpu_f2 83 long o 84
ret -1
end

note ---- layout
fn gpu_inreg r int u int to bool
if lt u 0
ret false
end
x = gpu_bhas add 513 r u
ret x
end

fn gpu_etgt u int v int to int
nr = get gnr 0
inner = int -1
for r int nr
if eq get grj r v
if gpu_inreg r u
if lt inner 0
inner = r
else
c = gpu_bcnt add 513 r
e = gpu_bcnt add 513 inner
if lt c e
inner = r
end
end
end
end
end
na = get gna v
arm = na
for k int na
x = gpu_inreg get gam add mul v 16 k u
if not x
arm = k
break
end
end
if ge inner 0
if and ne arm 0 gt na 0
gpu_fb 44
gpu_pi long u
gpu_pt 45
gpu_pi long v
gpu_pt 46
gpu_fe
ret 0
end
ret get gry inner
end
if lt arm na
ret add get gaa v arm
end
ret get gba v
end

fn gpu_ejoin b int i int nj int to void
r = get gjs i
put gry r bw_here
op = int 55
if eq get gmut 0 2
op = 0
end
bw_i0 op
put gci 7 get grb r
bw_e 9 0
p = get grp r
par = int -1
if ge p 0
if eq get grj p b
par = p
end
end
nx = false
if lt add i 1 nj
if eq get gjs add i 1 par
nx = true
end
end
if and ge par 0 not nx
q = bw_branch 0
gpu_addfix q 1 par 0
else
if and lt par 0 lt add i 1 nj
q = bw_branch 0
gpu_addfix q 2 b 0
end
end
end

fn gpu_eterm b int to void
s = gpu_ix gpu_term b
o = get iop s
if eq o 13
q = bw_branch 0
gpu_addfix q 0 b get ibt s
ret
end
if eq o 14
bw_ge gpu_r get ia s get grg 3
q = bw_branch 1
gpu_addfix q 0 b get ibt s
q = bw_branch 0
gpu_addfix q 0 b get ibf s
ret
end
bw_i0 45
bw_e 6 0
end

fn gpu_eblk b int to void
put gbf b bw_here
nr = get gnr 0
nj = int 0
for r int nr
if eq get grj r b
put gjs nj r
nj = add nj 1
end
end
i = int 1
while lt i nj bound 99
k = i
while gt k 0 bound 99
x = gpu_bcnt add 513 get gjs k
y = gpu_bcnt add 513 get gjs sub k 1
if ge x y
break
end
t = get gjs k
put gjs k get gjs sub k 1
put gjs sub k 1 t
k = sub k 1
end
i = add i 1
end
for j int nj
gpu_ejoin b j nj
end
put gaa b bw_here
na = get gna b
for j int na
r = get gam add mul b 16 j
put grs r bw_here
bw_i0 54
put gci 7 get grb r
bw_im 2
bw_e 8 0
end
put gba b bw_here
x = gpu_bf b
e = gpu_term b
while lt x e bound 999999
r = gpu_lower1 x
if lt r 0
ret
end
x = add x 1
end
gpu_eterm b
put gbl b sub bw_here 1
end

note ---- finish
fn gpu_fix1 k int to void
p = get gfa k
kd = get gfk k
a = get gfx k
tg = int 0
if eq kd 0
tg = gpu_etgt a get gfy k
end
if eq kd 1
tg = get gry a
end
if eq kd 2
tg = get gaa a
end
if lt tg 0
r = gpu_f1 59
ret
end
put gxim p gpu_u32 sub tg p
if eq tg p
r = gpu_f1 60
end
end

fn gpu_stretch to void
f = get gfn 0
nv = int get fnvr f
nb = get gnb 0
for v int nv
bv = get gmap v
if lt bv 0
continue
end
lo = get gvfd bv
hi = get gvlu bv
for b int nb
if gpu_vhas b v
x = get gbf b
if or lt lo 0 lt x lo
lo = x
end
if gt x hi
hi = x
end
end
if gpu_vhas add 512 b v
x = get gbl b
if or lt lo 0 lt x lo
lo = x
end
if gt x hi
hi = x
end
end
end
put gvfd bv lo
put gvlu bv hi
end
end

fn gpu_finish to int
n = get gnf 0
for k int n
if ne get gfail 0 0
break
end
gpu_fix1 k
end
nr = get gnr 0
for r int nr
if ne get gfail 0 0
break
end
bs = get grs r
bz = get gry r
if or or lt bs 0 lt bz 0 lt bz bs
q = gpu_f2 61 long get grh r 62
ret -1
end
put gxim bs gpu_u32 sub add bz 1 bs
end
if ne get gfail 0 0
ret -1
end
last = sub get gcnt 0 1
if ne get gmut 0 4
gpu_stretch
end
put gvlu get grg 1 last
put gvlu get grg 3 last
put gvlu get grg 4 last
put gvlu get grg 5 last
put gulu get grg 0 last
ret 0
end

note ---- osc_gpu_lower of function gfn: 0 ok, -1 refused (message in gerr)
fn gpu_reset to void
put gcnt 0 0
put gnv 0 0
put gnu 0 0
put gee 0 0
put gpen 0 0
put gld 0 0
put gfail 0 0
put gern 0 0
put gsel 0 0
put gnf 0 0
put gnr 0 0
for k ulong 16
put gkm k 0
end
for k ulong 32
put gpk k 0
put gpe k 0
put gpo k 0
end
for b ulong 512
put gbf b 0
put gbl b 0
put gaa b 0
put gba b 0
put gna b 0
end
end

fn gpu_lower to int
gpu_reset
f = get gfn 0
th = get fthr f
put gkm 0 th
if ne get fkind f 1
r = gpu_f1 27
ret -1
end
if or or lt th 32 gt th 1024 ne rem th 32 0
r = gpu_f2 28 long th -1
ret -1
end
r = gpu_cfg
if lt r 0
ret -1
end
r = gpu_params
if lt r 0
ret -1
end
gpu_unif
gpu_live
r = gpu_regions
if lt r 0
ret -1
end
gpu_prolog
nb = get gnb 0
for b int nb
if ne get gfail 0 0
break
end
gpu_eblk b
end
if and eq get gfail 0 0 ne get gee 0 0
r = gpu_f1 63
end
if ne get gfail 0 0
ret -1
end
bw_tail
if ne get gee 0 0
r = gpu_f1 64
ret -1
end
r = gpu_finish
ret r
end
