bw_ge x t0
bw_trap 3 1 -1
bw_movi t1 get gsho a 0
bw_imadi t1 x 4 t1
if eq get iop s 9
d = gpu_r get idst s
bw_i0 49
bw_f d t1 -1 -1
bw_e 2 -1
bw_movi d 0 1
ret 0
end
bw_ge get grg 5 get grg 3
bw_i0 50
bw_f -1 t1 gpu_r get ic s -1
pr = int -1
if eq get gmut 0 1
pr = 0
