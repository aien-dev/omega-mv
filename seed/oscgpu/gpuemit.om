bw_i0 11
bw_f d get grg 2 -1 -1
put gci 5 get grg 0
pr = int -1
if eq get gmut 0 7
pr = 0
end
bw_e 2 pr
bw_movi d 0 1
ret 0
end
bw_ge get grg 5 get grg 3
bw_i0 12
bw_f -1 get grg 2 gpu_r get ic s -1
put gci 5 get grg 0
pr = int -1
if eq get gmut 0 1
pr = 0
end
bw_e 4 pr
ret 0
end

fn gpu_lshr i int to int
s = gpu_ix i
a = get ia s
if ne get vtref gpu_vx a 4
