note seed/oscgpu/gpuemit.om: lower (one OSC instruction), the division by a number, edge_target,
note emit_block, finish and osc_gpu_lower of src/omega_osc_gpu.c.

global gjs int 64

note ---- division by a number (Granlund and Montgomery, as udiv_const)
fn gpu_cl2 d uint to uint
l = uint 0
while lt l 32 bound 40
if ge shl 1 ulong l ulong d
break
end
l = add l 1
end
ret l
end

fn gpu_udiv q int n int dv uint to void
if eq and dv sub dv 1 0
bw_shr q n gpu_cl2 dv
ret
end
l = gpu_cl2 dv
x = sub shl 1 ulong l ulong dv
p = add div mul 4294967296 x ulong dv 1
m = uint and p 4294967295
if eq get gmut 0 8
m = add m 1
end
t4 = gpu_t 4
t5 = gpu_t 5
bw_movi t4 m 0
bw_imadhi t5 n t4
bw_imadi t4 t5 4294967295 n
bw_shr t4 t4 1
bw_iadd t4 t4 t5
bw_shr q t4 sub l 1
end

note ---- one instruction, by kind
fn gpu_lgpu i int to int
s = gpu_ix i
d = gpu_r get idst s
sb = get isub s
if eq sb 1
bw_s2r d 33
ret 0
end
if eq sb 2
bw_s2r d 37
put gkm 7 1
ret 0
end
if eq sb 4
bw_s2r d 38
put gkm 8 1
ret 0
end
if eq sb 3
bw_ldc32 d add 896 get gkm 4
ret 0
end
if eq sb 5
bw_ldc32 d add 896 get gkm 5
ret 0
end
r = gpu_f2 67 long sb -1
ret -1
end

fn gpu_lshfl i int to int
s = gpu_ix i
sb = get isub s
c = gpu_sconst get ib s
if or or ne sb 1 lt c 1 gt c 31
r = gpu_f1 70
ret -1
end
bw_shfl gpu_r get idst s gpu_r get ia s uint c
ret 0
end

fn gpu_lglob i int to int
s = gpu_ix i
a = get ia s
p = gpu_r a
