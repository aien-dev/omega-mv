ret r
end
end
ret 0
end

note instruction i reads only vregs set in ocur; then its def is set
fn oscir_vfu f ulong i ulong to int
s = add mul f 4096 i
n = oscir_uses s
for q ulong n
u = ulong get ous q
w = get ocur div u 64
if eq and shr w rem u 64 1 0
ret oscir_vf 147 long f long i long u 0
end
end
oscir_dbit oscir_def s
ret 0
end

fn oscir_vfunc f ulong to int
r = oscir_vfh f
if ne r 0
ret r
end
r = oscir_vfp f
if ne r 0
ret r
end
r = oscir_vfb f
if ne r 0
ret r
end
ni = ulong get fnin f
for i ulong ni
r = oscir_vins f i
if ne r 0
ret r
end
end
nv = get fnvr f
for i ulong ni
d = oscir_def add mul f 4096 i
if ge d 0
if lt uint d nv
if ne get osl ulong d 0
ret oscir_vf 124 long f long i 0 0
end
end
end
end
r = oscir_vfk f
if ne r 0
ret r
end
r = oscir_vfa f
if ne r 0
ret r
end
r = oscir_vfo f
if ne r 0
ret r
end
ret oscir_vfd f
end

note ---- validate_structs / osc_ir_validate ---------------------------------------
fn oscir_sneq a ulong b ulong to bool
n = get osnl a
if ne n get osnl b
ret false
end
for c ulong ulong n
if ne get osnm add mul a 64 c get osnm add mul b 64 c
ret false
end
end
ret true
end

fn oscir_fneq a ulong b ulong to bool
n = get osfnl a
if ne n get osfnl b
ret false
end
pa = mul a 64
pb = mul b 64
for c ulong ulong n
ca = get osfnm add pa c
if ne ca get osfnm add pb c
ret false
end
end
ret true
end

fn oscir_vst to int
ns = ulong get unst 0
if gt ns 16
ret oscir_vf 149 0 0 0 0
end
for k ulong ns
kl = long k
if eq get osnl k 0
ret oscir_vf 150 kl 0 0 0
end
for j ulong k
if oscir_sneq j k
ret oscir_vf 151 kl 0 0 0
end
end
nf = ulong get osnf k
if or lt nf 1 gt nf 16
ret oscir_vf 152 kl 0 0 0
end
off = uint 0
for g ulong nf
x = add mul k 16 g
if eq get osfnl x 0
ret oscir_vf 153 kl long g 0 0
end
for h ulong g
if oscir_fneq add mul k 16 h x
ret oscir_vf 154 kl long g 0 0
end
end
if or not oscir_isval get osfs x gt get osfal x 64
ret oscir_vf 155 kl long g 0 0
end
if ne get osfof x off
ret oscir_vf 156 kl long g long get osfof x long off
end
al = get osfal x
if eq al 0
al = 1
end
off = add off al
end
if or or ne off get osnc k lt off 1 gt off 64
ret oscir_vf 157 kl 0 0 0
end
end
ret 0
end

fn oscir_validate to int
put oerrn 0 0
if gt get unfn 0 32
ret oscir_vf 159 0 0 0 0
end
r = oscir_vst
if ne r 0
ret r
end
nf = ulong get unfn 0
for f ulong nf
r = oscir_vfunc f
if ne r 0
ret r
end
end
put oerrn 0 0
ret 0
end
