if oscir_vr v nv
put ox 1 add bs ulong v
m = or m 2
end
v = get ib s
if oscir_vr v nv
put ox 2 add bs ulong v
m = or m 4
end
v = get ic s
if oscir_vr v nv
put ox 3 add bs ulong v
m = or m 8
end
ret m
end

note all operands in mask k are VR
fn oscir_vm m ulong k ulong to bool
ret eq and m k k
end

note slot k is a scalar of an integer type
