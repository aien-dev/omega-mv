note seed/oscgpu/oscir.om: strict OSC binary IR decoder and validator in seeded Omega.
note Port of osc_ir_decode + osc_ir_validate (src/compiler/osc_ir.c); the C stays as the
note differential oracle (tests/osc_gpu/oscir_diff.sh). No imports: concatenate this file
note in front of its users with cat. The decoded unit lives in the contract globals below
note (read-only for users). Private globals start with o, functions with oscir_.
note Entry points:
note   oscir_read_file ai ulong to int    read the file named by argv[ai] into irbuf/irlen
note                                      (0 ok, -1 unreadable); irlen is the true length
note   oscir_decode to int                0 ok, else the negative OscIrRefusal of osc_ir.c
note   oscir_validate to int              0 ok, -1 refused, message in oerr / oerrn
note A refused decode leaves every contract global zero, as osc_ir_decode memsets its unit.
note oerr is meaningful only after a direct oscir_validate call.

global irbuf uchar 4194304
global irlen ulong 1
global unfn uint 1
global unst uint 1
global fkind uchar 32
global fthr uint 32
global fnpar uint 32
global fnvr uint 32
global fnin uint 32
global fnbl uint 32
global fname uchar 2048
global fnlen uint 32
global frs uchar 32
global frref uchar 32
global frel uchar 32
global frlen uint 32
global frsid uchar 32
global vts uchar 15360
global vtref uchar 15360
global vtel uchar 15360
global vtlen uint 15360
global vtsid uchar 15360
global iop uchar 131072
global isub uchar 131072
global idst int 131072
global ia int 131072
global ib int 131072
global ic int 131072
global ibt int 131072
global ibf int 131072
global icall int 131072
global inarg uchar 131072
global iimm ulong 131072
global iline uint 131072
global iarg int 786432
global bfst uint 16384
global bcnt uint 16384

note private state
global opos ulong 1
global orc int 1
global onoval uchar 1
global oerr uchar 256
global oerrn ulong 1
global osnm uchar 1024
global osnl uint 16
global osnf uint 16
global osnc uint 16
global osfnm uchar 16384
global osfnl uint 256
global osfs uchar 256
global osfal uint 256
global osfof uint 256
global oreq uchar 8192
global oreql uint 32
global oens uchar 8192
global oensl uint 32
global ot uchar 4
global otl uint 1
global oma long 4
global omai ulong 1
global osl uchar 480
global ocov uchar 4096
global ondef uint 480
global ohk uchar 480
global opk uchar 480
global obin ulong 4096
global obout ulong 4096
global ocur ulong 8
global ous int 12
global ox ulong 4
global osb ulong 1
global owp ulong 1
global owd uchar 1
global oxs uchar 65536
global opath uchar 4096

note kernel wire numbers, as osc_ir.h defines them since 451cbcb6c: kernel units are
note encoding version 8 (OSC_IR_VERSION_KERNEL), ops OSC_I_GPU..OSC_I_MAD = 40..46.
note Versions 6 and 7 and ops 30..39 are refused.
const okver ulong 8
const ogpu uchar 40
const oshar uchar 41
const ogld uchar 42
const ogst uchar 43
const osync uchar 44
const oshfl uchar 45
const omad uchar 46

text omagic "OSC1IR"
text ostr "void\nbool\nu8\nu16\nu32\nu64\ni8\ni16\ni32\ni64\nref\nbytes\ncells\nf32\ngview\ngedit\n?\nSLOAD\nSSTORE\nFLOAD\nFSTORE\nGLOAD\nGSTORE\n"
note message templates, id = line number from 0; a leading @ stands for template 0
text omt "func %d insn %u: \n@CONST bad dst vreg %d\n@CONST dst not scalar\n@CONST imm not canonical for %s\n@MOV bad vreg\n@MOV ref kind/type mismatch\n@MOV type mismatch\n@BIN bad vreg\n@BIN bad sub-op %u\n@BIN dst/a type mismatch\n@BIN operand type mismatch\n@f32 BIN sub-op %u not allowed\n@MIN/MAX need u32 or f32\n@shift of non-integer\n@shift amount not integer\n@arith BIN needs identical integer types\n@UN bad vreg\n@UN type mismatch\n@LNOT needs bool\n@NEG needs a number\n@BNOT needs integer\n@EXP/INV/RSQ/SQRT need f32\n@UN bad sub-op %u\n@CMP bad vreg\n@CMP bad cc %u\n@CMP dst not bool\n@CMP operand type mismatch\n@CAST bad vreg\n@f32 CAST needs u32 <-> f32\n@CAST needs integer types\n@ALLOC bad vreg\n@ALLOC dst not an owner\n@ALLOC struct init not u64\n@ALLOC init type != elem type\n@RELEASE bad vreg\n@RELEASE of a non-owner\n@AOPEN bad vreg\n@AOPEN handle not u64\n@AOPEN capacity out of range\n@AALLOC bad vreg\n@AALLOC dst not an owner\n@AALLOC struct init not u64\n@AALLOC init type != elem type\n@AALLOC handle not u64\n@ADESTROY handle not u64\n@POPEN pool not u64\n@POPEN slot count out of range\n@POPEN element type not scalar\n@PCLOSE pool not u64\n@handle op bad operand\n@handle op bad dst\n@handle slot/gen not u64\n@HSTORE needs one value\n@handle slot not u64\n@handle gen not u64\n@LOAD bad vreg\n@LOAD base not an array ref\n@LOAD index not integer\n@LOAD dst type != elem\n@STORE bad vreg\n@STORE through a shared borrow or non-ref\n@STORE index not integer\n@STORE value type != elem\n@%s bad vreg\n@%s base not a slice pointer\n@%s index not integer\n@%s value not u64\n@SSTORE into a bytes slice\n@%s base not a struct ref\n@%s field %llu out of range\n@field index not integer\n@scalar field with an index\n@field value type != field type\n@FSTORE through a shared borrow\n@CALL to function %d not defined earlier\n@CALL arity %u != %u\n@CALL bad arg vreg\n@CALL arg %d slice mismatch\n@CALL arg %d ref mismatch\n@CALL arg %d type mismatch\n@CALL of void function with dst\n@CALL dst type != callee return\n@GPU dst not u32\n@GPU bad value %u\n@SHARED dst not a block array\n@%s base not a global buffer\n@%s index not u32\n@%s value type != elem\n@GSTORE into a view buffer\n@SHFL bad sub-op %u\n@SHFL bad vreg\n@SHFL value not u32/f32\n@SHFL distance not u32\n@MAD bad vreg\n@MAD needs f32\n@TRAP bad code\n@BR bad target\n@CBR condition not bool\n@CBR bad target\n@RET value from void function\n@RET type mismatch\n@unknown op %u\nfunc %d: name not terminated\nfunc %d: contract text not terminated\nfunc %d: bad kind %u\nfunc %d: bad thread count %u\nfunc %d: %u params > %d\nfunc %d: bad nvregs\nfunc %d: return type must be void or scalar\nfunc %d: vreg %d has invalid type\nfunc %d: vreg %d: type %s not allowed in a kernel\nfunc %d: vreg %d: kernel type in a host function\nfunc %d: f32 return from a host function\nfunc %d: a kernel returns nothing and has no contract\nfunc %d: slice vreg %d is not a parameter pair with a u64 length\nfunc %d: buffer vreg %d is not a parameter pair with a u32 length\nfunc %d: block array %d as a parameter\nfunc %d: bad ninsns\nfunc %d: bad nblocks\nfunc %d block %d: bad range\nfunc %d: insn %u in two blocks\nfunc %d block %d: missing terminator\nfunc %d block %d: terminator before block end\nfunc %d: insn %u in no block\n@slice register redefined\n@kernel instruction in a host function\n@call to a kernel\n@op %u not allowed in a kernel\n@SHARED outside the entry block\n@block array defined more than once\n@block arrays over %u bytes\n@kernel div/rem needs a nonzero constant divisor\n@shuffle distance is not one constant 1..31\n@AOPEN handle vreg reused\n@arena handle vreg redefined\n@AALLOC handle misuse\n@ADESTROY of a non-handle\n@arena handle used as a value\n@POPEN pool vreg reused\n@pool vreg redefined\n@PCLOSE of a non-pool\n@HALLOC pool misuse\n@HALLOC init type != pool element type\n@handle pool misuse\n@HLOAD type != pool element type\n@HSTORE value type != pool element type\n@pool used as a value\n@vreg %d may be used before it is defined\nout of memory\ntoo many structs\nstruct %d: bad name\nstruct %d: duplicate name\nstruct %d: bad field count\nstruct %d field %d: bad name\nstruct %d field %d: duplicate\nstruct %d field %d: bad type\nstruct %d field %d: offset %u != %u\nstruct %d: bad size\nnull unit\ntoo many functions\n"

note ---- file loader ----------------------------------------------------
fn oscir_read_file ai ulong to int
n = argread ai opath 0 4095
if lt n 0
ret -1
end
fd = fopen opath 0 ulong n 0 0
if lt fd 0
ret -1
end
h = int fd
t = ulong 0
w = false
while lt t 4194304 bound 999999
x = read h irbuf t sub ulong 4194304 t
if lt x 0
w = true
break
end
if eq x 0
break
end
t = add t ulong x
end
if eq t 4194304
while true bound 999999
x = read h oxs 0 65536
if lt x 0
w = true
break
end
if eq x 0
break
end
t = add t ulong x
end
end
c = fclose h
put irlen 0 t
if w
ret -1
end
ret 0
end

note ---- reader (R of osc_ir.c) ------------------------------------------
fn oscir_fail rc int to void
if eq get orc 0 0
put orc 0 rc
end
end

fn oscir_need k ulong to bool
if ne get orc 0 0
ret false
end
if gt k sub get irlen 0 get opos 0
put orc 0 -4
ret false
end
ret true
end

fn oscir_rle k ulong to ulong
if not oscir_need k
ret 0
end
p = get opos 0
v = ulong 0
for i ulong k
v = or v shl ulong get irbuf add p i mul i 8
end
put opos 0 add p k
ret v
end

fn oscir_rcount k ulong mx ulong to ulong
v = oscir_rle k
if eq get orc 0 0
if gt v mx
oscir_fail -5
end
end
if ne get orc 0 0
ret 0
end
ret v
end

fn oscir_rvr to int
v = oscir_rle 2
if ne get orc 0 0
ret -1
end
if eq v 65535
ret -1
end
if gt v 32767
oscir_fail -7
ret -1
end
ret int v
end

fn oscir_rsc to uchar
v = oscir_rle 1
if eq get orc 0 0
if gt v 15
oscir_fail -7
end
end
if ne get orc 0 0
ret 0
end
ret uchar v
end

note text into destination dst (0 fname, 1 osnm, 2 osfnm, 3 oreq, 4 oens) at base; returns its length
fn oscir_rtext lb ulong mx ulong dst ulong base ulong to ulong
k = oscir_rcount lb mx
if not oscir_need k
ret 0
end
p = get opos 0
for i ulong k
if eq get irbuf add p i 0
oscir_fail -8
ret 0
end
end
for i ulong k
c = get irbuf add p i
j = add base i
if eq dst 0
put fname j c
end
if eq dst 1
put osnm j c
end
if eq dst 2
put osfnm j c
end
if eq dst 3
put oreq j c
end
if eq dst 4
put oens j c
end
end
put opos 0 add p k
ret k
end

note one type into the scratch ot (s ref elem sid) / otl (len)
fn oscir_rtype to void
put ot 0 0
put ot 1 0
put ot 2 0
put ot 3 0
put otl 0 0
s = oscir_rsc
put ot 0 s
if ne get orc 0 0
ret
end
if or eq s 14 eq s 15
put ot 2 oscir_rsc
ret
end
if ne s 10
ret
end
r = oscir_rle 1
if eq get orc 0 0
if gt r 4
oscir_fail -7
ret
end
end
put ot 1 uchar r
put ot 2 oscir_rsc
put otl 0 uint oscir_rle 2
if eq get orc 0 0
if eq get ot 2 0
put ot 3 uchar oscir_rle 1
end
end
end

fn oscir_tovr x ulong to void
put vts x get ot 0
put vtref x get ot 1
put vtel x get ot 2
put vtlen x get otl 0
put vtsid x get ot 3
end

fn oscir_toret f ulong to void
put frs f get ot 0
put frref f get ot 1
put frel f get ot 2
put frlen f get otl 0
put frsid f get ot 3
end

note ---- decode_insn ------------------------------------------------------
fn oscir_dsub s ulong to void
put isub s uchar oscir_rle 1
end

fn oscir_dins s ulong to void
put idst s -1
put ia s -1
put ib s -1
put ic s -1
put ibt s -1
put ibf s -1
put icall s -1
put isub s 0
put inarg s 0
put iimm s 0
put iline s 0
for k ulong 6
put iarg add mul s 6 k 0
end
o = uchar oscir_rle 1
put iop s o
if ne get orc 0 0
ret
end
if eq o 1
put idst s oscir_rvr
put iimm s oscir_rle 8
ret
end
if or or eq o 2 eq o 6 eq o 7
put idst s oscir_rvr
put ia s oscir_rvr
ret
end
if or eq o 3 eq o 5
oscir_dsub s
put idst s oscir_rvr
put ia s oscir_rvr
put ib s oscir_rvr
ret
end
if eq o 4
oscir_dsub s
put idst s oscir_rvr
put ia s oscir_rvr
ret
end
if or or eq o 8 eq o 20 eq o 22
put ia s oscir_rvr
ret
end
if eq o 18
put idst s oscir_rvr
put iimm s oscir_rle 1
ret
end
if or or or or eq o 19 eq o 23 eq o 24 eq o 9 eq o 28
put idst s oscir_rvr
put ia s oscir_rvr
put ib s oscir_rvr
ret
end
if eq o 21
put idst s oscir_rvr
oscir_dsub s
put inarg s uchar oscir_rle 1
put iimm s oscir_rle 8
ret
end
if or or eq o 25 eq o 10 eq o 29
put ia s oscir_rvr
put ib s oscir_rvr
put ic s oscir_rvr
ret
end
if eq o 26
put idst s oscir_rvr
put ia s oscir_rvr
put ib s oscir_rvr
put ic s oscir_rvr
ret
end
if eq o 27
put ia s oscir_rvr
put ib s oscir_rvr
put ic s oscir_rvr
put iarg mul s 6 oscir_rvr
put inarg s 1
ret
end
if eq o 16
put idst s oscir_rvr
put ia s oscir_rvr
put ib s oscir_rvr
put iimm s oscir_rle 1
ret
end
if eq o 17
put ia s oscir_rvr
put ib s oscir_rvr
put ic s oscir_rvr
put iimm s oscir_rle 1
ret
end
if eq o 11
put idst s oscir_rvr
put icall s oscir_rvr
n = oscir_rcount 1 6
put inarg s uchar n
for k ulong n
if ne get orc 0 0
break
end
put iarg add mul s 6 k oscir_rvr
end
ret
end
if eq o 12
put iimm s oscir_rle 1
ret
end
if eq o 13
put ibt s oscir_rvr
ret
end
if eq o 14
put ia s oscir_rvr
put ibt s oscir_rvr
put ibf s oscir_rvr
ret
end
if eq o 15
put ia s oscir_rvr
ret
end
if eq o ogpu
oscir_dsub s
put idst s oscir_rvr
ret
end
if eq o oshar
put idst s oscir_rvr
ret
end
if eq o ogld
put idst s oscir_rvr
put ia s oscir_rvr
put ib s oscir_rvr
ret
end
if eq o ogst
put ia s oscir_rvr
put ib s oscir_rvr
put ic s oscir_rvr
ret
end
if eq o osync
ret
end
if eq o oshfl
oscir_dsub s
put idst s oscir_rvr
put ia s oscir_rvr
put ib s oscir_rvr
ret
end
if eq o omad
put idst s oscir_rvr
put ia s oscir_rvr
put ib s oscir_rvr
put ic s oscir_rvr
ret
end
oscir_fail -7
end

note ---- decode_func / decode_unit -----------------------------------------
fn oscir_dfunc f ulong ver ulong to void
n = oscir_rtext 1 63 0 mul f 64
put fnlen f uint n
if ge ver okver
k = oscir_rle 1
put fkind f uchar k
if eq k 1
put fthr f uint oscir_rle 2
end
end
put fnpar f uint oscir_rle 1
oscir_rtype
oscir_toret f
nv = oscir_rcount 2 480
put fnvr f uint nv
for v ulong nv
if ne get orc 0 0
break
end
oscir_rtype
oscir_tovr add mul f 480 v
end
nb = oscir_rcount 2 512
put fnbl f uint nb
for b ulong nb
if ne get orc 0 0
break
end
x = add mul f 512 b
put bfst x uint oscir_rle 4
put bcnt x uint oscir_rle 4
end
ni = oscir_rcount 4 4096
put fnin f uint ni
for i ulong ni
if ne get orc 0 0
break
end
oscir_dins add mul f 4096 i
end
n = oscir_rtext 2 255 3 mul f 256
put oreql f uint n
n = oscir_rtext 2 255 4 mul f 256
put oensl f uint n
end

fn oscir_dstruct k ulong to void
n = oscir_rtext 1 63 1 mul k 64
put osnl k uint n
nf = oscir_rcount 1 16
put osnf k uint nf
put osnc k uint oscir_rle 2
for j ulong nf
if ne get orc 0 0
break
end
x = add mul k 16 j
n = oscir_rtext 1 63 2 mul x 64
put osfnl x uint n
put osfs x oscir_rsc
put osfal x uint oscir_rle 2
put osfof x uint oscir_rle 2
end
end

note OSC_IR_ENCODED_MAX, evaluated with the C formula
fn oscir_encmax to ulong
fl = ulong 1
fl = add fl 63
fl = add fl 1
fl = add fl 2
fl = add fl 2
st = ulong 1
st = add st 63
st = add st 1
st = add st 2
st = add st mul 16 fl
fu = ulong 1
fu = add fu 63
fu = add fu 1
fu = add fu 1
fu = add fu 2
fu = add fu 6
fu = add fu 2
fu = add fu mul ulong 480 6
fu = add fu 2
fu = add fu mul ulong 512 8
fu = add fu 4
fu = add fu mul ulong 4096 18
fu = add fu mul ulong 2 add ulong 2 sub ulong 256 1
t = ulong 8
t = add t 1
t = add t mul ulong 16 st
t = add t 2
t = add t mul ulong 32 fu
ret t
end

fn oscir_magb i ulong to uchar
if lt i 6
ret get omagic i
end
ret 0
end

fn oscir_verok v ulong to bool
if and ge v 1 le v 5
ret true
end
ret eq v okver
end

fn oscir_dunit to int
n = get irlen 0
if gt n oscir_encmax
ret -5
end
put opos 0 0
put orc 0 0
if lt n 7
for i ulong n
if ne get irbuf i oscir_magb i
ret -2
end
end
ret -4
end
for i ulong 7
if ne get irbuf i oscir_magb i
ret -2
end
end
put opos 0 7
ver = oscir_rle 1
if ne get orc 0 0
ret get orc 0
end
if not oscir_verok ver
ret -3
end
if ge ver 2
ns = oscir_rcount 1 16
put unst 0 uint ns
for k ulong ns
if ne get orc 0 0
break
end
oscir_dstruct k
end
end
nf = oscir_rcount 2 32
put unfn 0 uint nf
for f ulong nf
if ne get orc 0 0
break
end
oscir_dfunc f ver
end
if ne get orc 0 0
ret get orc 0
end
if ne get opos 0 n
ret -6
end
if eq get onoval 0 0
v = oscir_validate
if ne v 0
ret -9
end
end
if ne oscir_uver ver
ret -10
end
put owp 0 0
put owd 0 0
oscir_enc
if ne get owd 0 0
ret -11
end
if ne get owp 0 n
ret -11
end
ret 0
end

fn oscir_clrf f ulong to void
nv = ulong get fnvr f
for v ulong nv
x = add mul f 480 v
put vts x 0
put vtref x 0
put vtel x 0
put vtlen x 0
put vtsid x 0
end
nb = ulong get fnbl f
for b ulong nb
x = add mul f 512 b
put bfst x 0
put bcnt x 0
end
ni = ulong get fnin f
for i ulong ni
x = add mul f 4096 i
put iop x 0
put isub x 0
put idst x 0
put ia x 0
put ib x 0
put ic x 0
put ibt x 0
put ibf x 0
put icall x 0
put inarg x 0
put iimm x 0
put iline x 0
for k ulong 6
put iarg add mul x 6 k 0
end
end
for j ulong 64
put fname add mul f 64 j 0
end
for j ulong 256
put oreq add mul f 256 j 0
put oens add mul f 256 j 0
end
put fkind f 0
put fthr f 0
put fnpar f 0
put fnvr f 0
put fnin f 0
put fnbl f 0
put fnlen f 0
put frs f 0
put frref f 0
put frel f 0
put frlen f 0
put frsid f 0
put oreql f 0
put oensl f 0
end

fn oscir_clear to void
for f ulong 32
oscir_clrf f
end
for k ulong 16
for j ulong 16
x = add mul k 16 j
for c ulong 64
put osfnm add mul x 64 c 0
end
put osfnl x 0
put osfs x 0
put osfal x 0
put osfof x 0
end
for c ulong 64
put osnm add mul k 64 c 0
end
put osnl k 0
put osnf k 0
put osnc k 0
end
put unfn 0 0
put unst 0 0
put opos 0 0
put orc 0 0
end

fn oscir_decode to int
oscir_clear
rc = oscir_dunit
if ne rc 0
oscir_clear
end
ret rc
end

note ---- canonical encoder used as a comparator against irbuf ---------------
fn oscir_wb v ulong to void
p = get owp 0
if eq get owd 0 0
if ge p get irlen 0
put owd 0 1
else
if ne ulong get irbuf p and v 255
put owd 0 1
end
end
end
put owp 0 add p 1
end

fn oscir_wn v ulong k ulong to void
for i ulong k
oscir_wb shr v mul i 8
end
end

fn oscir_wvr x int to void
y = long x
if lt y 0
y = add y 65536
end
oscir_wn ulong y 2
end

fn oscir_wtype s uchar r uchar e uchar l uint d uchar to void
oscir_wb ulong s
if or eq s 14 eq s 15
oscir_wb ulong e
end
if eq s 10
oscir_wb ulong r
oscir_wb ulong e
oscir_wn ulong l 2
if ne d 0
oscir_wb ulong d
end
end
end

note bytes of source src (0 fname, 1 osnm, 2 osfnm, 3 oreq, 4 oens) at base
fn oscir_wbytes src ulong base ulong k ulong to void
for i ulong k
j = add base i
c = uchar 0
if eq src 0
c = get fname j
end
if eq src 1
c = get osnm j
end
if eq src 2
c = get osfnm j
end
if eq src 3
c = get oreq j
end
if eq src 4
c = get oens j
end
oscir_wb ulong c
end
end

fn oscir_eins s ulong to void
o = get iop s
oscir_wb ulong o
if eq o 1
oscir_wvr get idst s
oscir_wn get iimm s 8
ret
end
if or or eq o 2 eq o 6 eq o 7
oscir_wvr get idst s
oscir_wvr get ia s
ret
end
if or eq o 3 eq o 5
oscir_wb ulong get isub s
oscir_wvr get idst s
oscir_wvr get ia s
oscir_wvr get ib s
ret
end
if eq o 4
oscir_wb ulong get isub s
oscir_wvr get idst s
oscir_wvr get ia s
ret
end
if or or eq o 8 eq o 20 eq o 22
oscir_wvr get ia s
