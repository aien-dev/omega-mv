note operand slots: ox[0..3] = vreg slot of dst a b c; returned mask bit k set when that operand is VR
fn oscir_ld f ulong i ulong to ulong
s = add mul f 4096 i
nv = get fnvr f
bs = mul f 480
m = ulong 0
v = get idst s
if oscir_vr v nv
put ox 0 add bs ulong v
m = or m 1
