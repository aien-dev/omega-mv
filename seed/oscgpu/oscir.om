fn oscir_wtx x ulong to void
oscir_wtype get vts x get vtref x get vtel x get vtlen x get vtsid x
end

fn oscir_efunc f ulong ver ulong to void
oscir_wb ulong get fnlen f
oscir_wbytes 0 mul f 64 ulong get fnlen f
if ge ver okver
oscir_wb ulong get fkind f
if eq get fkind f 1
oscir_wn ulong get fthr f 2
end
end
oscir_wb ulong get fnpar f
oscir_wtype get frs f get frref f get frel f get frlen f get frsid f
nv = ulong get fnvr f
oscir_wn nv 2
for v ulong nv
x = add mul f 480 v
oscir_wtx x
end
nb = ulong get fnbl f
oscir_wn nb 2
for b ulong nb
x = add mul f 512 b
oscir_wn ulong get bfst x 4
oscir_wn ulong get bcnt x 4
end
ni = ulong get fnin f
oscir_wn ni 4
for i ulong ni
oscir_eins add mul f 4096 i
end
oscir_wn ulong get oreql f 2
oscir_wbytes 3 mul f 256 ulong get oreql f
oscir_wn ulong get oensl f 2
oscir_wbytes 4 mul f 256 ulong get oensl f
end

fn oscir_enc to void
ver = oscir_uver
for i ulong 7
oscir_wb ulong oscir_magb i
end
oscir_wb ver
if ge ver 2
ns = ulong get unst 0
oscir_wb ns
for k ulong ns
oscir_wb ulong get osnl k
oscir_wbytes 1 mul k 64 ulong get osnl k
nf = ulong get osnf k
oscir_wb nf
oscir_wn ulong get osnc k 2
for j ulong nf
x = add mul k 16 j
oscir_wb ulong get osfnl x
oscir_wbytes 2 mul x 64 ulong get osfnl x
oscir_wb ulong get osfs x
oscir_wn ulong get osfal x 2
oscir_wn ulong get osfof x 2
end
end
end
nf = ulong get unfn 0
oscir_wn nf 2
for f ulong nf
oscir_efunc f ver
end
end

note ---- unit_version --------------------------------------------------------
fn oscir_uver to ulong
nf = ulong get unfn 0
for f ulong nf
if ne get fkind f 0
ret okver
end
end
for f ulong nf
nv = ulong get fnvr f
for v ulong nv
if oscir_xsl add mul f 480 v
ret 5
end
end
end
for f ulong nf
ni = ulong get fnin f
for i ulong ni
o = get iop add mul f 4096 i
if and ge o 21 le o 27
ret 4
end
end
end
for f ulong nf
ni = ulong get fnin f
for i ulong ni
o = get iop add mul f 4096 i
if and ge o 18 le o 20
ret 3
end
end
end
if ne get unst 0 0
ret 2
end
ret 1
end

note ---- type predicates (osc_ir.c) ------------------------------------------
fn oscir_isval s uchar to bool
ret and ge s 1 le s 9
end

fn oscir_isint s uchar to bool
ret and ge s 2 le s 9
end

fn oscir_gel e uchar to bool
ret or eq e 4 eq e 13
end

fn oscir_tsc s uchar r uchar e uchar l uint d uchar to bool
if not or oscir_isval s eq s 13
ret false
end
ret and and and eq r 0 eq e 0 eq l 0 eq d 0
end

fn oscir_tref s uchar r uchar e uchar l uint d uchar to bool
if ne s 10
ret false
end
if or lt r 1 gt r 3
ret false
end
if eq d 0
ret and oscir_isval e and ge l 1 le l 64
end
if gt uint d get unst 0
ret false
end
if ne e 0
ret false
end
ret eq l get osnc sub ulong d 1
end

fn oscir_tsl s uchar r uchar e uchar l uint d uchar to bool
if not or eq s 11 eq s 12
ret false
end
ret and and and eq r 0 eq e 0 eq l 0 eq d 0
end

fn oscir_tgb s uchar r uchar e uchar l uint d uchar to bool
if not or eq s 14 eq s 15
ret false
end
ret and and and eq r 0 oscir_gel e eq l 0 eq d 0
end

fn oscir_tbl s uchar r uchar e uchar l uint d uchar to bool
if ne s 10
ret false
end
if ne r 4
ret false
end
ret and and and oscir_gel e ge l 1 le l 12288 eq d 0
end

fn oscir_xsc x ulong to bool
ret oscir_tsc get vts x get vtref x get vtel x get vtlen x get vtsid x
end

fn oscir_xref x ulong to bool
ret oscir_tref get vts x get vtref x get vtel x get vtlen x get vtsid x
end

fn oscir_xsl x ulong to bool
ret oscir_tsl get vts x get vtref x get vtel x get vtlen x get vtsid x
end

fn oscir_xgb x ulong to bool
ret oscir_tgb get vts x get vtref x get vtel x get vtlen x get vtsid x
end

fn oscir_xbl x ulong to bool
ret oscir_tbl get vts x get vtref x get vtel x get vtlen x get vtsid x
end

fn oscir_xis x ulong s uchar to bool
if not oscir_xsc x
ret false
end
ret eq get vts x s
end

note array ref: a ref with sid 0
fn oscir_xarr x ulong to bool
if not oscir_xref x
ret false
end
ret eq get vtsid x 0
end

note struct ref: a ref with sid != 0
fn oscir_xstr x ulong to bool
if not oscir_xref x
ret false
end
ret ne get vtsid x 0
end

fn oscir_xeq a ulong b ulong to bool
if ne get vts a get vts b
ret false
end
if ne get vtref a get vtref b
ret false
end
if ne get vtel a get vtel b
ret false
end
if ne get vtlen a get vtlen b
ret false
end
ret eq get vtsid a get vtsid b
end

note type_eq of vreg slot a and the return type of function g
fn oscir_xeqr a ulong g ulong to bool
if ne get vts a get frs g
ret false
end
if ne get vtref a get frref g
ret false
end
if ne get vtel a get frel g
ret false
end
if ne get vtlen a get frlen g
ret false
end
ret eq get vtsid a get frsid g
end

fn oscir_xbind d ulong s ulong to bool
if not and oscir_xref d oscir_xref s
ret false
end
if ne get vtel d get vtel s
ret false
end
if ne get vtlen d get vtlen s
ret false
end
if ne get vtsid d get vtsid s
ret false
end
rd = get vtref d
rs = get vtref s
if eq rd 1
ret eq rs 1
end
if eq rd 3
ret or eq rs 1 eq rs 3
end
ret eq rd 2
end

fn oscir_width s uchar to ulong
if or eq s 2 eq s 6
ret 8
end
if or eq s 3 eq s 7
ret 16
end
if eq s 1
ret 1
end
if or eq s 4 eq s 8
ret 32
end
if or eq s 5 eq s 9
ret 64
end
ret 0
end

fn oscir_canon s uchar v ulong to bool
if eq s 1
ret le v 1
end
if eq s 13
ret le v 4294967295
end
w = oscir_width s
if eq w 64
ret true
end
if and ge s 6 le s 9
hi = sub shl ulong 1 sub w 1 1
lo = sub ulong 0 shl ulong 1 sub w 1
ret or le v hi ge v lo
end
ret lt v shl ulong 1 w
end

fn oscir_vr x int nv uint to bool
if lt x 0
ret false
end
ret lt uint x nv
end

fn oscir_sname s uchar to long
if le s 15
ret long s
end
ret 16
end

note ---- message formatting (vsnprintf into a 256-byte buffer) --------------
fn oscir_putc c uchar to void
n = get oerrn 0
if lt n 255
put oerr n c
put oerrn 0 add n 1
end
end

fn oscir_putd v long to void
dg = new uchar 24 0
x = v
if lt x 0
oscir_putc 45
end
u = ulong 0
if lt x 0
u = ulong sub 0 add x 1
u = add u 1
else
u = ulong x
end
n = ulong 0
while true bound 30
put dg n uchar add 48 rem u 10
n = add n 1
u = div u 10
if eq u 0
break
end
end
while gt n 0 bound 30
n = sub n 1
oscir_putc get dg n
end
end

fn oscir_puts id ulong to void
k = ulong 0
for i ulong len ostr
c = get ostr i
if eq c 10
if eq k id
ret
end
k = add k 1
else
if eq k id
oscir_putc c
end
end
end
end

fn oscir_narg to long
i = get omai 0
put omai 0 add i 1
ret get oma i
end

fn oscir_fmt id ulong to void
k = ulong 0
p = ulong 0
for i ulong len omt
if eq k id
p = i
break
end
if eq get omt i 10
k = add k 1
end
end
i = p
while lt i len omt bound 999
c = get omt i
if eq c 10
break
end
if eq c 64
if eq i p
oscir_fmt 0
i = add i 1
continue
end
end
if eq c 37
d = get omt add i 1
if eq d 115
oscir_puts ulong oscir_narg
i = add i 2
continue
end
if eq d 108
oscir_putd oscir_narg
i = add i 4
continue
end
oscir_putd oscir_narg
i = add i 2
continue
end
oscir_putc c
i = add i 1
end
end

fn oscir_vf id ulong a long b long c long d long to int
put oma 0 a
put oma 1 b
put oma 2 c
put oma 3 d
put omai 0 0
put oerrn 0 0
oscir_fmt id
ret -1
end

