for i ulong 512
if eq get sy i 1
m = add m 1
end
end
binst 32 0 0 4
binst 21 1 0 3221225655
binst 6 0 0 2147483648
binst 32 0 0 0
t = ulong 0
for i ulong 512
if eq get sy i 1
binst 21 sub m t 0 i
t = add t 1
end
end
binst 6 0 0 2147483648
binst 6 0 0 2147418112
end

fn ptable to void
for r ulong get nw 0
pw get wn r
ob1 32
pw get cn get wc r
ob1 32
a = get ws1 r
if lt a 512
od a
else
say 22
end
ob1 32
b = get ws2 r
if lt b 512
od b
else
say 22
end
onl
end
end

