note seed/net/examples/sse_client.om -- incremental server-sent events client embedding http.om.
note Compose: { printf 'om2\n'; cat seed/net/http.om seed/net/examples/sse_client.om; } | omc > sse_client
note Run: ./sse_client PORT PATH   connects to 127.0.0.1:PORT, sends GET PATH with
note Accept: text/event-stream, reads the body (Content-Length, chunked or close-delimited) in
note 13-byte steps to exercise the incremental reader, and prints one line per event:
note   event=TYPE id=ID data=DATA      (DATA with each LF written as the two bytes \n)
note Exit 0 at the end of the stream; 2 bad arguments, 3 connect, 4 status not 200, 5 read
note error, 6 event reader error, 7 stdout. Idle wait 10 s per read; no overall deadline (a
note stream may run for long). Never point it at a production port in tests.
text caccept "Accept"
text cevst "text/event-stream"
text chost "Host"
text cloop "127.0.0.1"
text cget "GET"
text cpev "event="
text cpid " id="
text cpdat " data="
fn wout b view uchar * to long
p = ulong 0
for it ulong 65536
if ge p len b
ret 0
end
w = write 1 b p sub len b p
if le w 0
ret -5
end
p = add p ulong w
end
ret -5
end
fn appc o edit uchar 16640 p ulong t view uchar * to ulong
for i ulong len t
put o add p i get t i
end
ret add p len t
end
note pevent: format the ready event of ss/lb into o and write it
fn pevent ss edit ulong 16 lb edit uchar 8192 o edit uchar 16640 to long
p = appc o 0 cpev
p = appc o p view part lb 0 get ss HSELEN
p = appc o p cpid
p = appc o p view part lb 64 get ss HSILEN
p = appc o p cpdat
for i ulong get ss HSDLEN
c = get lb add 128 i
if eq c 10
put o p 92
put o add p 1 110
p = add p 2
else
put o p c
p = add p 1
end
end
put o p 10
ret wout view part o 0 add p 1
end
fn feed ss edit ulong 16 lb edit uchar 8192 o edit uchar 16640 src view uchar 13 n ulong to long
off = ulong 0
for j ulong 64
if ge off n
ret 0
end
c = hssefeed ss lb view part src off sub n off
if lt c 0
ret -6
end
off = add off ulong c
if ne get ss HSRDY 0
r = pevent ss lb o
if lt r 0
ret -7
end
hssenext ss
end
end
ret -6
end
fn request cs edit ulong 320 io edit uchar 65536 pa view uchar 1024 pl ulong to long
r = hreqst cs io cget
r = hfe r hreqtg cs io view part pa 0 pl
r = hfe r hhname cs io chost
r = hfe r hhval cs io cloop
r = hfe r hhname cs io caccept
r = hfe r hhval cs io cevst
r = hfe r hhend cs io 0 0
r = hfe r hwfin cs io
if lt r 0
ret r
end
ret hrsprd cs io
end
fn stream cs edit ulong 320 io edit uchar 65536 ss edit ulong 16 lb edit uchar 8192 o edit uchar 16640 to int
src = new uchar 13 0
for it ulong 16777216
n = hbodyrd cs io src
if lt n 0
ret 5
end
if eq n 0
ret 0
end
r = feed ss lb o src ulong n
if eq r -6
ret 6
end
if lt r 0
ret 7
end
end
ret 5
end
fn main to int
cs = new ulong 320 0
io = new uchar 65536 0
ss = new ulong 16 0
lb = new uchar 8192 0
o = new uchar 16640 0
pa = new uchar 1024 0
a = new uchar 16 0
if ne argcnt 3
ret 2
end
pn = argread 1 pa 0 1024
if le pn 0
ret 2
end
if not hdigits view part pa 0 ulong pn
ret 2
end
port = hdecv view part pa 0 ulong pn
if or eq port 0 gt port 65535
ret 2
end
pl = argread 2 pa 0 1024
if le pl 0
ret 2
end
r = haddr4 a 2130706433 port
fd = hdial a 5000000000
if lt fd 0
ret 3
end
r = hinit cs io int fd 0
hsettmo cs 10000000000 10000000000
r = hsseinit ss
st = request cs io pa ulong pl
if ne st 200
r = hclose cs
ret 4
end
e = stream cs io ss lb o
r = hclose cs
ret e
end
