if or eq k 189 eq k 161
ret 6
end
if eq k 38
ret 5
end
if eq k 94
ret 4
end
if eq k 124
ret 3
end
ret 0
end

note Pratt reader; call arguments are a linked list of nodes (kind 260).
note At most one call per expression: no reliance on C's unspecified operand evaluation order.
fn expr minimum ulong to ulong
put depth 0 add get depth 0 1
if gt get depth 0 128
refuse 2
end
k = get tok 0
lhs = ulong 0
