next
ret n
end
fn ename id ulong to void
if eq get nk id 1
if eq add id 1 get mainid 0
say 2
ret
end
say 3
else
say 4
end
decimal id
end
fn node k ulong a ulong b ulong effect ulong to ulong
n = get nodes 0
if ge n 65536
refuse 2
