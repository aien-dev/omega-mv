if ne k 43
lhs = node add k 512 lhs 0 get ae lhs
end
else
if or isname or eq k 306 eq k 307
id = ulong 0
if or eq k 306 eq k 307
id = add k 1000
else
found = lookup
if eq found 0
refuse 12
end
id = sub found 1
end
next
if eq get tok 0 40
if lt id 1000
if ne get nk id 1
refuse 12
end
end
next
head = ulong 0
tail = ulong 0
argc = ulong 0
while ne get tok 0 41
a = expr 1
if ne get ae a 0
refuse 14
end
link = node 260 a 0 0
if eq head 0
head = link
else
put ar tail link
end
tail = link
argc = add argc 1
if eq get tok 0 44
next
if eq get tok 0 41
refuse 1
end
else
if ne get tok 0 41
refuse 1
end
end
end
expect 41
want = ulong 0
if eq id 1307
want = 1
else
if lt id 1000
want = get na id
end
end
if ne argc want
refuse 20
end
lhs = node 259 id head 1
else
if ge id 1000
refuse 12
end
if ne get nk id 2
refuse 12
end
lhs = node 258 id 0 0
end
else
if or eq k 42 eq k 38
refuse 5
end
if eq k 300
refuse 10
end
refuse 1
end
end
end
end
go = true
while go
k = get tok 0
prec = precedence k
if or eq prec 0 lt prec minimum
go = false
else
next
rhs = expr add prec 1
effects = add get ae lhs get ae rhs
if gt effects 1
refuse 14
end
lhs = node k lhs rhs effects
end
end
put depth 0 sub get depth 0 1
ret lhs
end

