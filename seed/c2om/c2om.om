fn expect k ulong to void
if ne get tok 0 k
refuse 1
end
next
end
fn isname to bool
ret or eq get tok 0 256 eq get tok 0 308
end
fn equalname id ulong to bool
if ne get nl id get width 0
ret false
end
i = ulong 0
while lt i get width 0
if ne get src add get ns id i get src add get start 0 i
ret false
end
i = add i 1
end
ret true
end
fn lookup to ulong
n = get names 0
while gt n 0
n = sub n 1
if equalname n
ret add n 1
end
end
ret 0
end
fn addname kind ulong to ulong
if not isname
if eq get tok 0 42
