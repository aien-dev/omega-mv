end
if eq b 42
advance
advance
closed = false
while and lt add get pos 0 1 get size 0 not closed
if and eq get src get pos 0 42 eq get src add get pos 0 1 47
advance
advance
closed = true
else
advance
end
end
if not closed
refuse 1
end
skip = true
end
end
end
