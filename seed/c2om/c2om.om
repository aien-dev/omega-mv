text keys "int void return if else while getchar putchar main union struct malloc calloc realloc free goto switch for do break continue sizeof typedef unsigned long short char float double volatile restrict enum extern static const"
note Keyword token = 300 plus position in keys. Names = 256, decimal = 257.
fn keyword to ulong
p = ulong 0
k = ulong 300
while lt p len keys
q = p
while and lt q len keys ne get keys q 32
q = add q 1
end
if eq sub q p get width 0
i = ulong 0
same = true
while lt i get width 0
if ne get src add get start 0 i get keys add p i
same = false
end
i = add i 1
end
if same
ret k
end
end
p = add q 1
k = add k 1
end
ret 256
end

fn letter b uchar to bool
ret or or and ge b 65 le b 90 and ge b 97 le b 122 eq b 95
end
fn digit b uchar to bool
ret and ge b 48 le b 57
end
fn advance to void
if eq get src get pos 0 10
put line 0 add get line 0 1
end
put pos 0 add get pos 0 1
end

note next scans comments and whitespace, never delegates preprocessing to a C compiler.
fn next to void
skip = true
while skip
skip = false
while and lt get pos 0 get size 0 le get src get pos 0 32
if eq get src get pos 0 0
refuse 1
end
advance
end
p = get pos 0
if and lt add p 1 get size 0 eq get src p 47
b = get src add p 1
if eq b 47
while and lt get pos 0 get size 0 ne get src get pos 0 10
advance
