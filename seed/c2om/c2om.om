fn emit b uchar to void
n = get used 0
if ge n 4194304
exit 65
end
put output n b
put used 0 add n 1
end

fn decimal v ulong to void
a = new uchar 20 0
n = ulong 0
x = v
put a n uchar add rem x 10 48
n = add n 1
x = div x 10
while gt x 0
put a n uchar add rem x 10 48
n = add n 1
x = div x 10
end
while gt n 0
n = sub n 1
emit get a n
end
end
