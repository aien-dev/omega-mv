text prelude "note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.\nglobal cio uchar 1\nfn cg to int\nn = read 0 cio 0 1\nif eq n 1\nret int get cio 0\nend\nret -1\nend\nfn cp x int to int\nb = uchar and x 255\nput cio 0 b\nn = write 1 cio 0 1\nif eq n 1\nret int b\nend\nret -1\nend\n"
fn main to int
put line 0 1
put nodes 0 1
more = true
while more
n = get size 0
if ge n 1048575
refuse 2
end
r = read 0 src n sub 1048575 n
if lt r 0
refuse 18
end
if eq r 0
more = false
else
put size 0 add n ulong r
end
end
i = ulong 0
while lt i len prelude
emit get prelude i
i = add i 1
end
next
while ne get tok 0 0
function
end
if eq get mainid 0 0
refuse 19
end
n = get used 0
off = ulong 0
while lt off n
r = write 1 output off sub n off
if le r 0
exit 74
end
off = add off ulong r
end
ret 0
end
