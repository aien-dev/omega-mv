note cpufence / cpurelax (#939): store the payload, publish it with a fence, then set the flag. A bounded
note poll spins with cpurelax. Values live in registers across both words must survive them. Exit 42.
global data ulong 4
global flag ulong 1
fn publish v ulong to ulong
put data 2 v
cpufence
put flag 0 v
ret get flag 0
end
fn main to int
a = ulong 11
b = ulong 22
put data 0 a
put data 1 b
cpufence
put flag 0 1
n = ulong 0
while lt n 3
cpurelax
n = add n 1
end
cpufence
if ne get flag 0 1
ret 1
end
if ne add get data 0 get data 1 33
ret 2
end
if ne publish 7 7
ret 3
end
if ne get data 2 7
ret 4
end
if ne add a b 33
ret 5
end
if ne n 3
ret 6
end
ret 42
end
