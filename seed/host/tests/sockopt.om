note Verify socket option effect with an independent bind outcome on an ephemeral loopback UDP port.
global addr uchar 16
text enabled "abcd"
fn setreuse fd int option view uchar 8 to long
ret add long 9 sockopt fd 1 2 option 2 4
end
fn main to int
option = new uchar 8 0
put option 2 1
put addr 0 2
put addr 4 127
put addr 7 1
a = socknew 2 2 0
if lt a 0
ret 1
end
b = socknew 2 2 0
if lt b 0
ret 2
end
if ne setreuse int a option 9
ret 3
end
if ne bind int a addr 0 len addr 0
ret 4
end
if ne sockname int a addr 0 len addr 16
ret 5
end
if and eq get addr 2 0 eq get addr 3 0
ret 6
end
if ne bind int b addr 0 len addr neg long 98
ret 7
end
if ne sockopt int b 1 2 enabled 0 len enabled 0
ret 8
end
if ne bind int b addr 0 len addr 0
ret 9
end
if ne sockopt neg int 1 1 2 enabled 0 4 neg long 9
ret 10
end
if ne sockopt int b 1 2 enabled 0 0 neg long 22
ret 11
end
if ne sockopt int b 1 2147483647 enabled 0 4 neg long 92
ret 12
end
if ne fclose int a 0
ret 13
end
if ne fclose int b 0
ret 14
end
ret 0
end
