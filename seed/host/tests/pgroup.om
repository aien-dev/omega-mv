note process groups: getpgid/setpgid always; setsid succeeds or reports EPERM when already a leader.
fn main to int
p = getpgid 0
if le p long 0
ret 1
end
r = setpgid 0 int p
if and ne r 0 ne r long -1
ret 2
end
s = setsid
if and lt s 0 ne s long -1
ret 3
end
q = getpgid 0
if le q long 0
ret 4
end
ret 0
end
