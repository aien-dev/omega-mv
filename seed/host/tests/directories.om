text dir "adir"
text old "before"
text fresh "after"
global bytes uchar 4096
global packet uchar 64
fn main to int
r = makedir dir 0 len dir 448
if ne r 0
ret 1
end
note Linux ARM64 overrides O_DIRECTORY to 040000 octal in asm/fcntl.h.
fd = fopen dir 0 len dir 16384 0
if lt fd 0
ret 2
end
r = getdnts int fd bytes 0 len bytes
if le r 0
ret 3
end
r = fclose int fd
r = rmdir dir 0 len dir
if ne r 0
ret 4
end
fd = fopen old 0 len old 194 384
if lt fd 0
ret 5
end
r = write int fd fresh 0 len fresh
if ne r long len fresh
ret 6
end
r = fstat int fd bytes 0 128
if ne r 0
ret 7
end
if ne get bytes 48 uchar len fresh
ret 8
end
r = fclose int fd
put packet 0 2
put packet 2 uchar len old
for i ulong len old
put packet add i 4 get old i
end
n = add len old 4
put packet n uchar len fresh
n = add n 2
for i ulong len fresh
put packet add n i get fresh i
end
n = add n len fresh
r = renames packet 0 n 1
if ne r 0
ret 9
end
fd = fopen old 0 len old 194 384
if lt fd 0
ret 10
end
r = fclose int fd
r = renames packet 0 n 1
if ne r neg long 17
ret 11
end
r = unlink old 0 len old
r = unlink fresh 0 len fresh
ret int r
end
