note truncate: path form of ftrunc; st_size at byte 48 becomes 4, a missing path returns negative.
text p "tr.tmp"
text body "abcdefgh"
text miss "no.such.file"
fn main to int
fd = int fopen p 0 len p 578 420
if lt fd 0
ret 1
end
w = write fd body 0 len body
r = fclose fd
r = truncate p 0 len p 4
if ne r 0
ret 2
end
st = new uchar 128 0
r = stat p 0 len p st 0 128
if ne r 0
ret 3
end
if ne get st 48 4
ret 4
end
r = truncate miss 0 len miss 4
if ge r 0
ret 5
end
r = unlink p 0 len p
if ne r 0
ret 6
end
ret 0
end
