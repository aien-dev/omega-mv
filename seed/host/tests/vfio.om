ck eq mapget w 0 4 3735928559
ck eq mapset w 4 4 305419896 0
ck eq pread fd data 0 4 4 4
ck eq word32 0 305419896
ck eq mapdrop w 0
setinfo 7 4096 1
ck eq vfiomapw fd info 0 32 neg long 22
setinfo 5 4096 1
ck eq vfiomap fd info 0 32 neg long 22
setinfo 5 4096 0
