if eq k 2
put data 0 uchar 8
put data 1 uchar 0
put data 2 uchar 0
put data 3 uchar 0
r = vfioctl neg int 1 uint 15206 data 0 4
end
if eq k 3
r = vfioctl neg int 1 uint 15210 dev 0 0
