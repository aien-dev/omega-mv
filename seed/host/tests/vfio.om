note Host only: every allowed VFIO request uses an invalid fd, never /dev/vfio. vfiomap and vfiomapw map
note a memfd. MAP_DMA takes a mapping handle in its vaddr field; the compiler substitutes the mapping.
global data uchar 64
global info uchar 32
global status uchar 4
text dev "0000:00:01.0"
text name "vfio-region"
text msg "PASS bounded native VFIO requests, DMA map spans and region maps\n"
fn ck yes bool to void
if not yes
exit int 80
end
end
fn fill v uchar to void
for i ulong 64
put data i v
end
end
fn word32 a ulong to ulong
v = ulong get data add a 3
v = or shl v 8 ulong get data add a 2
v = or shl v 8 ulong get data add a 1
ret or shl v 8 ulong get data a
end
fn word64 a ulong to ulong
ret or shl word32 add a 4 32 word32 a
end
fn put64 a ulong v ulong to void
for i ulong 8
put data add a i uchar and shr v mul i 8 255
end
end
fn dmaspan flags ulong h ulong iova ulong to void
fill uchar 0
put data 4 uchar flags
put64 8 h
put64 16 iova
put64 24 12345
end
fn setinfo flags ulong size ulong offset ulong to void
for i ulong 32
put info i uchar 0
end
put info 0 uchar 32
put info 4 uchar and flags 255
for i ulong 8
put info add 16 i uchar and shr size mul i 8 255
put info add 24 i uchar and shr offset mul i 8 255
end
end
fn bad k int fd int to void
r = long 0
if eq k 0
r = vfioctl neg int 1 uint 15207 data 0 9
end
if eq k 1
r = vfioctl neg int 1 uint 15212 data 0 31
