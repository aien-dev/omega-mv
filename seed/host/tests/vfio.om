if eq k 4
fill uchar 0
put data 0 uchar 48
r = vfioctl neg int 1 uint 15210 data 0 4
end
if eq k 5
r = vfioctl neg int 1 uint 15204 data 0 4
end
if eq k 6
r = vfioctl neg int 1 uint 15211 data 48 24
end
if eq k 7
setinfo 5 4096 0
r = vfiomap fd info 0 31
end
if eq k 8
setinfo 3 4096 0
r = vfiomap fd info 0 32
end
if eq k 9
setinfo 5 4096 0
h9 = vfiomap fd info 0 32
ck gt h9 0
r = mapset h9 0 4 0
end
if eq k 10
setinfo 5 4096 0
h10 = vfiomap fd info 0 32
ck gt h10 0
q = mapget h10 4096 4
end
if eq k 11
setinfo 5 0 0
r = vfiomap fd info 0 32
end
if eq k 12
h12 = mapnew neg int 1 0 4096 3 34
dmaspan 3 ulong h12 1048576
r = vfioctl neg int 1 uint 15217 data 0 31
end
if eq k 13
h13 = mapnew neg int 1 0 4096 3 34
dmaspan 1 ulong h13 1048576
r = vfioctl neg int 1 uint 15217 data 0 32
end
if eq k 14
dmaspan 3 1048577 1048576
r = vfioctl neg int 1 uint 15217 data 0 32
end
if eq k 15
setinfo 5 4096 0
h15 = vfiomap fd info 0 32
ck gt h15 0
dmaspan 3 ulong h15 1048576
r = vfioctl neg int 1 uint 15217 data 0 32
end
if eq k 16
h16 = mapnew neg int 1 0 4096 1 34
dmaspan 3 ulong h16 1048576
r = vfioctl neg int 1 uint 15217 data 0 32
end
if eq k 17
h17 = mapnew neg int 1 0 4096 3 34
ck eq mapdrop h17 0
dmaspan 3 ulong h17 1048576
r = vfioctl neg int 1 uint 15217 data 0 32
end
if eq k 18
dmaspan 0 0 1048576
r = vfioctl neg int 1 uint 15218 data 0 32
end
if eq k 19
dmaspan 2 0 1048576
r = vfioctl neg int 1 uint 15218 data 0 24
end
if eq k 20
setinfo 5 4096 0
r = vfiomapw fd info 0 32
end
if eq k 21
setinfo 7 4096 0
r = vfiomapw fd info 0 31
end
exit int 81
end
fn main to int
fd = int memfd name 0 len name 0
ck ge fd 0
ck eq ftrunc fd 4096 0
put data 0 uchar 239
put data 1 uchar 190
put data 2 uchar 173
put data 3 uchar 222
ck eq pwrite fd data 0 4 0 4
ck eq vfioctl neg int 1 uint 15204 data 0 0 neg long 9
put data 0 uchar 3
put data 1 uchar 0
put data 2 uchar 0
put data 3 uchar 0
ck eq vfioctl neg int 1 uint 15205 data 0 4 neg long 9
ck eq vfioctl neg int 1 uint 15206 data 0 4 neg long 9
