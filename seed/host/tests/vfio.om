ck eq mapget h 4092 4 0
ck eq mapdrop h 0
h = mapnew neg int 1 0 8192 3 34
ck gt h 0
dmaspan 3 ulong h 1048576
ck eq vfioctl neg int 1 uint 15217 data 0 32 neg long 9
ck eq word32 0 32
ck eq word32 4 3
ck eq word64 8 mapaddr h
ck eq word64 16 1048576
ck eq word64 24 8192
ck eq mapdrop h 0
note UNMAP_DMA layout: iova at 8, size at 16 (vfio_iommu_type1_dma_unmap).
dmaspan 0 1048576 4096
ck eq vfioctl neg int 1 uint 15218 data 0 24 neg long 9
ck eq word32 0 24
ck eq word64 8 1048576
ck eq word64 16 4096
setinfo 7 4096 0
w = vfiomapw fd info 0 32
