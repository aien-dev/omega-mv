global buf uchar 256
fn main to int
if ne fclose neg int 1 neg long 9
ret 1
end
if ne fsync neg int 1 neg long 9
ret 2
end
if ne fchmod neg int 1 384 neg long 9
ret 3
end
if ne fseek neg int 1 0 0 neg long 9
ret 4
end
if ne getdnts neg int 1 buf 0 256 neg long 9
ret 5
end
if ne fstat neg int 1 buf 0 128 neg long 9
ret 6
end
if ne bind neg int 1 buf 0 16 neg long 9
ret 7
end
if ne connect neg int 1 buf 0 16 neg long 9
ret 8
end
if ne listen neg int 1 1 neg long 9
ret 9
end
if ne accept neg int 1 0 neg long 9
ret 10
end
if ne send neg int 1 buf 0 1 0 neg long 9
ret 11
end
if ne recv neg int 1 buf 0 1 0 neg long 9
ret 12
end
if ne sockname neg int 1 buf 0 16 neg long 9
ret 13
end
if ne waitpid neg int 1 buf 0 4 1 neg long 10
ret 14
end
if ne pipefds buf 0 8 neg int 1 neg long 22
ret 15
end
if ne killpid int getpid 0 0
ret 16
end
ret 0
end
