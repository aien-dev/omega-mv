note chdir: create a directory, enter it, create a relative file there, return, and refuse a missing path.
text dsub "sub"
text dfile "inside"
text dup ".."
text dno "nope"
fn main to int
r = makedir dsub 0 len dsub 493
if ne r 0
ret 1
end
r = chdir dsub 0 len dsub
if ne r 0
ret 2
end
fd = int fopen dfile 0 len dfile 577 420
if lt fd 0
ret 3
end
r = fclose fd
if ne r 0
ret 4
end
r = chdir dup 0 len dup
if ne r 0
ret 5
end
r = chdir dno 0 len dno
if ge r 0
ret 6
end
ret 0
end
