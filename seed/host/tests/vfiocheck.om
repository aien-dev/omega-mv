fn main to int
expect eq argcnt 2
size = argread 1 packet 4 4092
expect and gt size 0 le size 4092
put packet 0 1
put packet 2 uchar and size 255
put packet 3 uchar shr size 8
for num int 16
input = fopen infile 0 len infile 524482 384
output = fopen outfile 0 len outfile 524482 384
errors = fopen errfile 0 len errfile 524482 384
expect ge input 0
expect ge output 0
expect ge errors 0
want = source num int input
expect eq fseek int input 0 0 0
pid = fork
