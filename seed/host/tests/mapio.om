note Exact word access through managed mappings. No GPU or device opens.
global bytes uchar 16
global status uchar 4
text msg "PASS managed addresses and ordered mapped words\n"
fn ck yes bool to void
if not yes
exit int 80
end
end
fn bad k int to void
h = mapnew neg int 1 0 4096 3 34
ck gt h 0
if eq k 0
ck eq mapdrop h 0
r = mapaddr h
ret
end
if eq k 1
ck eq mapdrop h 0
r = mapget h 0 4
ret
end
if eq k 2
r = mapget h 4096 4
ret
end
if eq k 3
r = mapset h 4092 8 0
ret
end
if eq k 4
r = mapget h 1 4
ret
end
if eq k 5
r = mapset h 4 8 0
ret
end
if eq k 6
ro = mapnew neg int 1 0 4096 1 34
r = mapset ro 0 4 0
ret
end
if eq k 7
r = mapset h 0 4 4294967296
ret
end
r = mapget h 18446744073709551615 8
end
fn held h long a ulong b ulong c ulong d ulong e ulong to void
ck gt mapaddr h 4096
ck eq mapset h 0 8 18446744073709551615 0
ck eq mapget h 0 8 18446744073709551615
ck eq a 101
ck eq b 202
ck eq c 303
ck eq d 404
ck eq e 505
end
fn main to int
h = mapnew neg int 1 0 4096 3 33
ck gt h 0
ck eq and mapaddr h 4095 0
held h 101 202 303 404 505
ck eq mapset h 8 4 4294967295 0
ck eq mapget h 8 4 4294967295
ck eq mapset h 12 4 305419896 0
ck eq mapread h 0 bytes 0 16 16
for i ulong 12
ck eq get bytes i 255
end
ck eq get bytes 12 120
ck eq get bytes 13 86
ck eq get bytes 14 52
ck eq get bytes 15 18
ck eq mapset h 4088 8 81985529216486895 0
ck eq mapget h 4088 8 81985529216486895
p = fork
ck ge p 0
if eq p 0
ck eq mapset h 0 8 42 0
exit int 0
end
ck eq waitpid int p status 0 4 0 p
ck and eq get status 0 0 eq get status 1 0
ck eq mapget h 0 8 42
ck eq mapdrop h 0
for k int 9
p = fork
ck ge p 0
if eq p 0
bad k
exit int 80
end
ck eq waitpid int p status 0 4 0 p
ck and eq get status 0 0 eq get status 1 103
end
ck eq write 1 msg 0 len msg long len msg
ret 0
end
