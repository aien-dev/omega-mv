fn main to int
expect eq argcnt 2
size = argread 1 packet 4 4092
expect and gt size 0 le size 4092
put packet 0 1
put packet 2 uchar and size 255
put packet 3 uchar shr size 8
for num int 16
input = fopen infile 0 len infile 524482 384
output = fopen outfile 0 len outfile 524482 384
errors = fopen errfile 0 len errfile 524482 384
expect ge input 0
expect ge output 0
expect ge errors 0
want = source num int input
expect eq fseek int input 0 0 0
pid = fork
expect ge pid 0
if eq pid 0
expect eq dupfd int input 0 0 0
expect eq dupfd int output 1 0 1
expect eq dupfd int errors 2 0 2
r = execprog packet 0 add ulong size 4
exit int 81
end
expect eq waitpid int pid status 0 4 0 pid
if ne get status 0 0
ret add num 1
end
if ne get status 1 uchar want
ret add num 1
end
expect eq fseek int output 0 0 0
expect eq read int output tmp 0 1 0
expect eq fseek int errors 0 0 0
expect eq read int errors tmp 0 1 1
expect eq fclose int input 0
expect eq fclose int output 0
expect eq fclose int errors 0
expect eq unlink infile 0 len infile 0
