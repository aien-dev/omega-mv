if and eq ta tb eq va vb
if ne ta 0
put cnt 2 add get cnt 2 1
end
ret
end
put cnt 1 add get cnt 1 1
if eq get cnt 3 0
put cnt 3 1
for j ulong get cnt 8
put fpv j get pv j
end
put fres 0 va
put fres 1 ta
put fres 2 vb
put fres 3 tb
end
end
fn exhaust fa ulong fb ulong to ulong
d = dbits
if gt d 24
stop 5
end
n = shl ulong 1 d
for hi ulong 256
base = mul hi 65536
if ge base n
break
end
for lo ulong 65536
k = add base lo
if ge k n
break
end
decode k
pair fa fb
end
end
ret n
end
fn sample fa ulong fb ulong n ulong to void
for hi ulong 1024
base = mul hi 65536
if ge base n
break
end
for lo ulong 65536
if ge add base lo n
break
end
for j ulong get cnt 8
t = get pty j
put pv j canon and rnd mask t t
end
pair fa fb
end
end
end
fn ofail fa ulong fb ulong to void
okv 23 get cnt 1
ob 32
oword 26
oin true
rt = get returns fa
ob 32
oword 27
ores get fres 0 get fres 1 rt
ob 32
oword 28
ores get fres 2 get fres 3 rt
end
fn argnum ix ulong to ulong
n = getarg ix
if eq n 0
stop 2
end
m = ulong 0
for i ulong n
c = get arg i
if or lt c 48 gt c 57
stop 2
end
d = ulong sub c 48
if gt m 1844674407370955161
stop 2
end
m = mul m 10
if gt d sub 18446744073709551615 m
stop 2
end
m = add m d
end
ret m
end
fn numval p ulong n ulong t ulong to ulong
if eq t 1
if isword 10 p sub n p
ret 1
end
if isword 11 p sub n p
ret 0
end
stop 2
end
minus = false
if and lt p n eq get arg p 45
minus = true
p = add p 1
end
if ge p n
stop 2
end
m = ulong 0
for i ulong sub n p
c = get arg add p i
if or lt c 48 gt c 57
stop 2
end
d = ulong sub c 48
if gt m 1844674407370955161
stop 2
end
m = mul m 10
if gt d sub 18446744073709551615 m
stop 2
end
m = add m d
end
if minus
if or lt t 6 gt m shl ulong 1 sub width t 1
stop 2
end
ret sub 0 m
end
hi = mask t
if ge t 6
hi = smax t
end
if gt m hi
stop 2
end
ret m
end
fn argval j ulong ix ulong to void
n = getarg ix
q = ulong 0
while lt q n bound 256
if eq get arg q 58
break
end
q = add q 1
end
if eq q n
stop 2
end
t = get pty j
if not isword t 0 q
stop 2
end
put pv j numval add q 1 n t
end
fn readir to void
n = ulong 0
for attempt ulong 2620252
if eq n len input
refuse 23
end
k = read 0 input n sub len input n
if lt k 0
refuse 28
end
if eq k 0
break
end
n = add n ulong k
end
if eq n len input
refuse 23
end
put state 1 n
magic = new uchar 7 0
put magic 0 79
put magic 1 83
put magic 2 67
put magic 3 49
put magic 4 73
put magic 5 82
for j ulong 7
v = rd 1
if ne v ulong get magic j
refuse 20
end
end
if ne rd 1 1
refuse 21
end
nf = cap rd 2 32
put state 7 nf
for f ulong nf
put starts f get state 0
loadfn f
defined
commit f
end
if ne get state 0 n
refuse 27
end
end
fn doeval na ulong to int
f = resolve 2
sigset f f
if ne na add 3 get cnt 8
stop 2
end
for j ulong get cnt 8
argval j add 3 j
end
setregs
v = evalfn f
t = get ev 0
if eq t 99
inconc f
end
if eq t 0
oword 29
onum v
else
oword 30
onum t
end
ob 10
flush
ret 0
end
fn dodump to int
f = resolve 2
sigset f f
d = dbits
if gt d 24
stop 5
end
n = shl ulong 1 d
for hi ulong 256
base = mul hi 65536
if ge base n
break
end
for lo ulong 65536
k = add base lo
if ge k n
break
end
decode k
setregs
v = evalfn f
if eq get ev 0 99
inconc f
end
if ne get ev 0 0
flush
stop 7
end
for b ulong 8
ob and shr v mul b 8 255
end
end
end
flush
ret 0
end
fn docheck mode ulong t0 long to int
fa = resolve 2
fb = resolve 3
sigset fa fb
n = ulong 0
s = ulong 0
if eq mode 38
n = exhaust fa fb
else
n = argnum 4
if or eq n 0 gt n 67108864
stop 2
end
s = argnum 5
put cnt 7 xor s 11400714819323198485
if eq get cnt 7 0
put cnt 7 1
end
sample fa fb n
end
ns = ulong sub monons t0
k = ulong 13
if ne get cnt 1 0
k = 14
else
if eq mode 39
k = 15
end
end
ohead k fa fb
if eq mode 38
okv 21 n
okv 22 get cnt 0
else
okv 33 dbits
okv 31 n
okv 32 s
end
if ne get cnt 1 0
ofail fa fb
else
okv 23 0
okv 24 get cnt 2
end
okv 25 ns
if and eq mode 39 eq get cnt 1 0
ob 32
oword 16
end
ob 10
flush
if ne get cnt 1 0
ret 1
end
if eq mode 39
ret 10
end
ret 0
end
note Usage: irequiv check A B | sample A B N SEED | eval F TYPE:VALUE... | dump F
note (unit on stdin). Exit 0 PASS or done, 1 difference, 2 usage, 3 unknown function,
note 4 signature, 5 domain over 24 bits, 6 fuel, 7 dump trap, 10 sampled agreement,
note 20-28 IR refusals named by the shared reader.
fn main to int
t0 = monons
na = ulong argcnt
if lt na 3
stop 2
end
m = getarg 1
mode = ulong 0
for w ulong 4
if isword add 38 w 0 m
mode = add 38 w
end
end
if eq mode 0
stop 2
end
if and eq mode 38 ne na 4
stop 2
end
if and eq mode 39 ne na 6
stop 2
end
if and eq mode 41 ne na 3
stop 2
end
readir
if eq mode 40
ret doeval na
end
if eq mode 41
ret dodump
end
ret docheck mode t0
end
