note SPDX-License-Identifier: AGPL-3.0-only
note Module-contract tests, compiled with core only. No CLI or reference runtime.
global fails ulong 1
text tbad "eval 1/0"
text tgood "eval 2+3"
fn check ok bool id ulong to void
put reslen 0 0
unum id
emit 32
if ok
emit 48
else
emit 49
put fails 0 add get fails 0 1
end
emit 10
w = write 1 res 0 get reslen 0
end
fn main to int
reset
check eq get domain 0 1 1
check eq get variable 0 120 2
check eq get assume 0 0 3
r = rdiv rint 6 rint 8
check reqrat r rdiv rint 3 rint 4 4
check reqrat rneg rneg r r 5
check eq rsub r r 16 6
p = pconst r
q = pconst rdiv rint 9 rint 12
check eq p q 7
check eq psub 2 2 0 8
check eq pdiff pinteg 2 2 9
reset
put fuel 0 0
r = rint 1
check eq get err 0 6 10
reset
put np 0 512
p = pnew
check eq get err 0 5 11
reset
put nr 0 4096
r = rint 1
check eq get err 0 5 12
reset
for i ulong 32
bs 0 i 9999
end
bset 1 1
badd 2 0 1
check eq get err 0 4 13
reset
r = rdiv 17 16
check eq get err 0 2 14
reset
bset 0 9999
bset 1 13
bdiv 2 3 0 1
check eq bg 2 0 769 15
check eq bg 3 0 2 16
bgcd 0 1
check eq bg 25 0 1 17
for i ulong len tbad
put req i get tbad i
end
s = mathrun len tbad
v = get reslen 0
check eq s 2 18
check eq v 0 19
for i ulong len tgood
put req i get tgood i
end
s = mathrun len tgood
v = ulong get res 3
check eq s 0 20
check eq v 53 21
s = mathrun 18446744073709551615
check eq s 4 22
reset
check eq get err 0 0 23
ret int get fails 0
end
