; edges.s2 -- every line of rv32im.tbl once, with registers and numbers at the edges of their fields.
; edges.expect holds, written by hand before any disassembler was run on it, what GNU objdump
; (-M no-aliases,numeric) must print for each word. Branch and jump targets are absolute (pc + offset),
; pc = 4 x line number counting from 0.
  lui 31 0xfffff
  auipc 1 0x80000
  jal 0 0 1023 1 255
  jal 30 -1 1023 1 255
  jalr 5 6 -2048
  jalr 0 1 2047
  beq 1 2 0 63 15 1
  bne 31 30 -1 63 15 1
  blt 3 4 0 0 4 0
  bge 5 6 -1 63 0 1
  bltu 7 8 0 1 0 0
  bgeu 9 10 0 0 0 1
  lb 11 12 -1
  lh 13 14 2047
  lw 15 16 -2048
  lbu 17 18 1
  lhu 19 20 0
  sb 21 22 -64 31
  sh 23 24 63 31
  sw 25 26 -1 31
  addi 27 28 -2048
  slti 29 30 2047
  sltiu 31 0 -1
  xori 1 2 -1
  ori 3 4 1365
  andi 5 6 255
  slli 7 8 31
  srli 9 10 1
  srai 11 12 31
  add 31 30 29
  sub 1 2 3
  sll 4 5 6
  slt 7 8 9
  sltu 10 11 12
  xor 13 14 15
  srl 16 17 18
  sra 19 20 21
  or 22 23 24
  and 25 26 27
  fence 15 15
  fence 2 1
  ecall
  ebreak
  mul 28 29 30
  mulh 31 1 2
  mulhsu 3 4 5
  mulhu 6 7 8
  div 9 10 11
  divu 12 13 14
  rem 15 16 17
  remu 18 19 20
