text t0 "/* Omega bridge. A C compiler builds this file. Arrays are address then length. */\n#include <stdint.h>\n#include <unistd.h>\nstatic void o_trap(int c){_exit(100+c);}\n"
text t1 "static uint64_t o_add_u(uint64_t a,uint64_t b){return a+b;}\nstatic uint64_t o_sub_u(uint64_t a,uint64_t b){return a-b;}\nstatic uint64_t o_mul_u(uint64_t a,uint64_t b){return a*b;}\nstatic uint64_t o_div_u(uint64_t a,uint64_t b){if(b==0)o_trap(2);return a/b;}\nstatic uint64_t o_rem_u(uint64_t a,uint64_t b){if(b==0)o_trap(2);return a%b;}\n"
text t2 "static int64_t o_div_s(int64_t a,int64_t b){if(b==0)o_trap(2);if(a==(-9223372036854775807LL-1)&&b==-1)o_trap(1);return a/b;}\nstatic int64_t o_rem_s(int64_t a,int64_t b){if(b==0)o_trap(2);if(a==(-9223372036854775807LL-1)&&b==-1)return 0;return a%b;}\n"
text t3 "static uint64_t o_get_u8(uint8_t *p,uint64_t n,uint64_t i){if(i>=n)o_trap(3);return p[i];}\nstatic void o_put_u8(uint8_t *p,uint64_t n,uint64_t i,uint64_t v){if(i>=n)o_trap(3);if(v>255)o_trap(5);p[i]=(uint8_t)v;}\nstatic uint64_t o_get_u64(uint64_t *p,uint64_t n,uint64_t i){if(i>=n)o_trap(3);return p[i];}\nstatic void o_put_u64(uint64_t *p,uint64_t n,uint64_t i,uint64_t v){if(i>=n)o_trap(3);p[i]=v;}\n"
text t4 "static void o_fill_u8(uint8_t *p,uint64_t n,uint64_t v){uint64_t i;if(v>255)o_trap(5);for(i=0;i<n;i++)p[i]=(uint8_t)v;}\nstatic void o_fill_u64(uint64_t *p,uint64_t n,uint64_t v){uint64_t i;for(i=0;i<n;i++)p[i]=v;}\n"
text t5 "static int64_t o_read(int64_t fd,uint8_t *p,uint64_t n,uint64_t off,uint64_t len){if(off>n||len>n-off)o_trap(3);return (int64_t)read((int)fd,p+off,(size_t)len);}\nstatic int64_t o_write(int64_t fd,uint8_t *p,uint64_t n,uint64_t off,uint64_t len){if(off>n||len>n-off)o_trap(3);return (int64_t)write((int)fd,p+off,(size_t)len);}\nstatic uint64_t o_to_u64(int64_t v){if(v<0)o_trap(5);return (uint64_t)v;}\n"

