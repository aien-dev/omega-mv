need lt v get state 4
ret v
end
fn width t ulong to ulong
if eq t 1
ret 1
end
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or eq t 4 eq t 8
ret 32
end
ret 64
end
fn mask t ulong to ulong
