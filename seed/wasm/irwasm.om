note SPDX-License-Identifier: Apache-2.0
note OSC IR v1 scalar and v7 memory profile to WebAssembly; no host or foreign generator.
note Wire authority spec/one-layer-format.md sections 3 and 10; referee src/compiler/osc_interp.c.
note Wasm opcodes https://webassembly.github.io/spec/core/binary/instructions.html
note Buffered output: every parse/type/capacity refusal occurs before stdout writes.
note Input holds a v7 unit of 8388608 bytes plus one sentinel byte; v1 keeps 2620251.
global input uchar 8388609
global output uchar 8388608
note state slots: 0 input cursor, 1 input size, 2 output size, 3 nparams,
note 4 nvregs, 5 nblocks, 6 ninsns, 7 nfuncs, 8 version, 9 nregions,
note 10 memory pages, 11 v7 feature seen. Current function arrays are reused.
note Wasm params retain ABI types. Internal vregs are canonical i64 bit patterns;
note f32 is its zero-extended bits and f64 its bits.
note Locals after params: nvregs i64, dispatcher i32, arithmetic scratch i64.
global state ulong 16
global starts ulong 32
global names ulong 32
global namelen ulong 32
global params ulong 32
global returns ulong 32
global sigs ulong 192
global types ulong 480
global first ulong 512
global counts ulong 512
global ops ulong 4096
global subs ulong 4096
global dest ulong 4096
global arg0 ulong 4096
global arg1 ulong 4096
global immed ulong 4096
global nargs ulong 4096
global args ulong 24576
global cover uchar 4096
global dins ulong 4096
global douts ulong 4096
global work ulong 8
note v7 region table: name offset/length in input, tag, class, owner, count,
note initial data offset in input, assigned linear-memory byte offset.
global rname ulong 1024
global rnlen ulong 1024
global rtag ulong 1024
global rclass ulong 1024
global rowner ulong 1024
global rcount ulong 1024
global rdata ulong 1024
global rbase ulong 1024
note Local-region initialization bits: 16 words of 64 regions per block.
global rin ulong 8192
global rout ulong 8192
global rwork ulong 16
global reach uchar 512
text magic6 "OSC1IR"
text memname "memory"
text regpfx "region."
text abiname "osc.v7.abi"
text emagic "irwasm: MAGIC\n"
text ever "irwasm: VERSION\n"
text etrunc "irwasm: TRUNCATED\n"
text ecap "irwasm: CAPACITY\n"
text eop "irwasm: UNSUPPORTED_OP\n"
text etype "irwasm: UNSUPPORTED_TAG\n"
text einval "irwasm: INVALID\n"
text etrail "irwasm: TRAILING\n"
text eio "irwasm: IO\n"
fn refuse code int to void
k = long 0
if eq code 20
k = write 2 emagic 0 len emagic
end
if eq code 21
k = write 2 ever 0 len ever
end
if eq code 22
k = write 2 etrunc 0 len etrunc
end
if eq code 23
k = write 2 ecap 0 len ecap
end
if eq code 24
k = write 2 eop 0 len eop
end
if eq code 25
k = write 2 etype 0 len etype
end
if eq code 26
k = write 2 einval 0 len einval
end
if eq code 27
k = write 2 etrail 0 len etrail
end
if eq code 28
k = write 2 eio 0 len eio
end
exit code
end
fn need ok bool to void
if not ok
refuse 26
end
end
fn rd n ulong to ulong
p = get state 0
if gt n sub get state 1 p
refuse 22
end
v = ulong 0
for j ulong n
v = or v shl ulong get input add p j mul j 8
end
put state 0 add p n
ret v
end
fn cap n ulong maxv ulong to ulong
if gt n maxv
refuse 23
end
ret n
end
fn isflt t ulong to bool
ret or eq t 13 eq t 14
end
fn sgn t ulong to bool
ret and ge t 6 le t 9
end
fn isint t ulong to bool
ret and ge t 2 le t 9
end
fn feat to void
put state 11 1
end
fn typ to ulong
t = rd 1
if and eq get state 8 7 isflt t
feat
ret t
end
if gt t 9
refuse 25
end
ret t
end
fn vr to ulong
v = rd 2
need lt v get state 4
ret v
end
fn rg to ulong
v = rd 2
need lt v get state 9
ret v
end
fn width t ulong to ulong
if eq t 1
ret 1
end
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or or eq t 4 eq t 8 eq t 13
ret 32
end
ret 64
end
note log2 of the element byte width: wasm alignment hint and index shift.
fn lg t ulong to ulong
w = width t
if eq w 8
ret 0
end
if eq w 16
ret 1
end
if eq w 32
ret 2
end
ret 3
end
fn mask t ulong to ulong
w = width t
if eq w 64
ret 18446744073709551615
end
ret sub shl ulong 1 w 1
end
fn canon v ulong t ulong to ulong
w = width t
if eq w 64
ret v
end
v = and v mask t
if sgn t
m = shl ulong 1 sub w 1
v = sub xor v m m
end
ret v
end
fn txt n ulong to void
for j ulong n
v = rd 1
need ne v 0
end
end
fn nametxt n ulong to void
for j ulong n
v = rd 1
need and ne v 0 lt v 128
end
end
fn same a ulong b ulong to bool
if ne get namelen a get namelen b
ret false
end
for j ulong get namelen a
x = get input add get names a j
y = get input add get names b j
if ne x y
ret false
end
end
ret true
end
note Region names: 1..63 ASCII bytes, no NUL and no dot (spec 10.1).
fn rsame a ulong b ulong to bool
if ne get rnlen a get rnlen b
ret false
end
for j ulong get rnlen a
x = get input add get rname a j
y = get input add get rname b j
if ne x y
ret false
end
end
ret true
end
fn skip n ulong to void
p = get state 0
if gt n sub get state 1 p
refuse 22
end
put state 0 add p n
end
note Every field is checked in byte order as it is read (spec 10.1 reader classes).
fn region r ulong to void
n = rd 1
need and ge n 1 le n 63
put rnlen r n
put rname r get state 0
for j ulong n
v = rd 1
need and and ne v 0 lt v 128 ne v 46
end
t = rd 1
need or isint t isflt t
put rtag r t
c = rd 1
if eq c 3
refuse 24
end
need le c 2
put rclass r c
put rowner r rd 2
k = rd 4
put rcount r k
need le k 16777216
if ne c 2
need ne k 0
end
n = rd 4
if eq c 2
need and eq t 2 eq n k
else
need eq n 0
end
put rdata r get state 0
skip n
end
fn regions to void
nr = rd 2
need le nr 1024
put state 9 nr
if ne nr 0
feat
end
for r ulong nr
region r
end
end
fn insn i ulong fi ulong to void
o = rd 1
put ops i o
put dest i 65535
put arg0 i 65535
put arg1 i 65535
put nargs i 0
if eq o 1
d = vr
put dest i d
v = rd 8
need eq v canon v get types d
put immed i v
ret
end
if or eq o 2 eq o 6
put dest i vr
put arg0 i vr
ret
end
if or or eq o 3 eq o 4 eq o 5
put subs i rd 1
put dest i vr
put arg0 i vr
if ne o 4
put arg1 i vr
end
ret
end
if eq o 11
d = rd 2
if ne d 65535
need lt d get state 4
end
put dest i d
c = rd 2
need lt c fi
put immed i c
n = cap rd 1 6
put nargs i n
need eq n get params c
for j ulong n
put args add mul i 6 j vr
end
ret
end
if eq o 12
t = rd 1
need and ge t 1 le t 14
put immed i t
ret
end
if eq o 13
v = rd 2
need lt v get state 5
put immed i v
ret
end
if eq o 14
put arg0 i vr
v = rd 2
need lt v get state 5
put immed i v
v = rd 2
need lt v get state 5
put arg1 i v
ret
end
if eq o 15
v = rd 2
if ne v 65535
need lt v get state 4
end
put arg0 i v
ret
end
if and eq get state 8 7 and ge o 30 le o 33
insn7 i o
ret
end
refuse 24
end
note v7: 30 RLOAD dst region index, 31 RSTORE region index src,
note 32 BITCAST dst src, 33 RINIT region init. Region id lives in immed.
fn insn7 i ulong o ulong to void
feat
if eq o 30
put dest i vr
put immed i rg
put arg0 i vr
ret
end
if eq o 31
put immed i rg
put arg0 i vr
put arg1 i vr
ret
end
if eq o 32
put dest i vr
put arg0 i vr
ret
end
put immed i rg
put arg0 i vr
end
fn callchk i ulong to void
c = get immed i
d = get dest i
if eq get returns c 0
need eq d 65535
else
need ne d 65535
need eq get types d get returns c
end
for j ulong get nargs i
v = get args add mul i 6 j
t = get types v
u = get sigs add mul c 6 j
need eq t u
end
end
fn check i ulong fi ulong to void
o = get ops i
d = get dest i
a = get arg0 i
b = get arg1 i
s = get subs i
t = ulong 0
u = ulong 0
if ne a 65535
t = get types a
end
if ne d 65535
u = get types d
end
if eq o 2
need eq t u
end
if eq o 3
need and ge s 1 le s 10
need eq t u
if ge s 9
need and ge t 2 ge get types b 2
else
need eq t get types b
if le s 5
need ge t 2
end
end
end
if eq o 4
need and ge s 1 le s 3
need eq t u
if eq s 3
need eq t 1
else
need ge t 2
end
end
if eq o 5
need and ge s 1 le s 6
need eq u 1
need eq t get types b
end
if eq o 6
need and ge t 2 ge u 2
end
if eq o 11
callchk i
end
if eq o 14
need eq t 1
end
if eq o 15
if eq get returns fi 0
need eq a 65535
else
need eq t get returns fi
end
