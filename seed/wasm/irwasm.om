need and ge s 1 le s 10
need eq t u
if ge s 9
need and ge t 2 ge get types b 2
else
need eq t get types b
if le s 5
need ge t 2
end
end
end
if eq o 4
need and ge s 1 le s 3
need eq t u
if eq s 3
need eq t 1
else
need ge t 2
end
end
if eq o 5
need and ge s 1 le s 6
need eq u 1
need eq t get types b
end
if eq o 6
need and ge t 2 ge u 2
end
if eq o 11
