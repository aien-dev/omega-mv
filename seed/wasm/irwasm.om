end
end
end
fn merge b ulong pred ulong to void
i = add get first pred sub get counts pred 1
o = get ops i
target = false
if or eq o 13 eq o 14
target = eq get immed i b
if eq o 14
target = or target eq get arg1 i b
end
end
if target
for k ulong 8
ix = add mul b 8 k
v = get douts add mul pred 8 k
