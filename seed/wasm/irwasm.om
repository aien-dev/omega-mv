for k ulong n
ix = add f k
need eq get cover ix 0
put cover ix 1
o = get ops ix
term = ge o 13
need eq term eq k sub n 1
end
end
for j ulong ni
need eq get cover j 1
end
end
fn loadfn fi ulong to void
put state 0 get starts fi
n = cap rd 1 63
put namelen fi n
put names fi get state 0
nametxt n
for j ulong fi
need not same fi j
end
np = cap rd 1 6
put params fi np
put returns fi typ
nv = cap rd 2 480
need ge nv np
put state 3 np
put state 4 nv
for j ulong nv
t = typ
need ne t 0
put types j t
if lt j np
put sigs add mul fi 6 j t
end
end
nb = cap rd 2 512
need ne nb 0
put state 5 nb
for j ulong nb
put first j rd 4
put counts j rd 4
end
ni = cap rd 4 4096
need ne ni 0
put state 6 ni
for j ulong ni
insn j fi
check j fi
put cover j 0
end
blocks
n = cap rd 2 255
txt n
n = cap rd 2 255
txt n
end
fn bitset v ulong to void
k = div v 64
put work k or get work k shl ulong 1 rem v 64
end
fn use v ulong to void
if eq v 65535
ret
end
need ne and get work div v 64 shl ulong 1 rem v 64 0
end
fn calluse i ulong to void
for k ulong get nargs i
v = get args add mul i 6 k
use v
end
end
fn transfer b ulong verify bool to void
for k ulong 8
put work k get dins add mul b 8 k
end
for j ulong get counts b
i = add get first b j
o = get ops i
if verify
if and ge o 2 le o 6
use get arg0 i
end
if or eq o 3 eq o 5
use get arg1 i
end
if or eq o 14 eq o 15
use get arg0 i
end
if eq o 11
calluse i
end
end
d = get dest i
