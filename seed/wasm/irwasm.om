end
fn callchk i ulong to void
c = get immed i
d = get dest i
if eq get returns c 0
need eq d 65535
else
need ne d 65535
need eq get types d get returns c
end
for j ulong get nargs i
v = get args add mul i 6 j
t = get types v
u = get sigs add mul c 6 j
need eq t u
end
end
fn check i ulong fi ulong to void
o = get ops i
d = get dest i
a = get arg0 i
b = get arg1 i
s = get subs i
t = ulong 0
u = ulong 0
if ne a 65535
t = get types a
end
if ne d 65535
u = get types d
