if eq w 64
ret v
end
v = and v mask t
if ge t 6
m = shl ulong 1 sub w 1
v = sub xor v m m
end
ret v
end
fn txt n ulong to void
for j ulong n
v = rd 1
need ne v 0
end
end
fn nametxt n ulong to void
for j ulong n
v = rd 1
need and ne v 0 lt v 128
end
end
fn same a ulong b ulong to bool
if ne get namelen a get namelen b
ret false
end
for j ulong get namelen a
x = get input add get names a j
y = get input add get names b j
if ne x y
ret false
end
end
ret true
end
fn insn i ulong fi ulong to void
