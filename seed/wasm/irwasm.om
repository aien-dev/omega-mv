if eq get state 8 7
check7 i fi
end
end
note BITCAST width sets {u8,i8} {u16,i16} {u32,i32,f32} {u64,i64,f64}; 0 = none.
fn bclass t ulong to ulong
if or eq t 2 eq t 6
ret 1
end
if or eq t 3 eq t 7
ret 2
end
if or or eq t 4 eq t 8 eq t 13
ret 3
end
if or or eq t 5 eq t 9 eq t 14
ret 4
end
ret 0
end
note A function-local region is accessible only by its owning function.
fn regok r ulong fi ulong to void
if eq get rclass r 1
need eq get rowner r fi
end
end
fn check7 i ulong fi ulong to void
o = get ops i
s = get subs i
a = get arg0 i
t = ulong 0
if ne a 65535
t = get types a
end
if and eq o 3 isflt t
need le s 4
end
if and eq o 3 ge s 9
need not isflt get types get arg1 i
end
if and eq o 4 isflt t
need eq s 1
end
r = get immed i
if eq o 30
need isint t
need eq get types get dest i get rtag r
regok r fi
end
if eq o 31
need isint t
need eq get types get arg1 i get rtag r
need ne get rclass r 2
regok r fi
end
if eq o 32
b = bclass t
need and ne b 0 eq b bclass get types get dest i
end
if eq o 33
need eq get rclass r 1
regok r fi
need eq t get rtag r
end
end
fn blocks to void
ni = get state 6
for j ulong get state 5
f = get first j
n = get counts j
need and ne n 0 le f ni
need le n sub ni f
for k ulong n
ix = add f k
need eq get cover ix 0
put cover ix 1
o = get ops ix
term = and ge o 13 le o 15
need eq term eq k sub n 1
end
end
for j ulong ni
need eq get cover j 1
end
end
fn loadfn fi ulong to void
put state 0 get starts fi
n = cap rd 1 63
put namelen fi n
put names fi get state 0
nametxt n
for j ulong fi
need not same fi j
end
np = cap rd 1 6
put params fi np
put returns fi typ
nv = cap rd 2 480
need ge nv np
put state 3 np
put state 4 nv
for j ulong nv
t = typ
need ne t 0
put types j t
if lt j np
put sigs add mul fi 6 j t
end
end
nb = cap rd 2 512
need ne nb 0
put state 5 nb
for j ulong nb
put first j rd 4
put counts j rd 4
end
ni = cap rd 4 4096
need ne ni 0
put state 6 ni
for j ulong ni
insn j fi
check j fi
put cover j 0
end
blocks
n = cap rd 2 255
txt n
n = cap rd 2 255
txt n
end
fn bitset v ulong to void
k = div v 64
put work k or get work k shl ulong 1 rem v 64
end
fn use v ulong to void
if eq v 65535
ret
end
need ne and get work div v 64 shl ulong 1 rem v 64 0
end
fn calluse i ulong to void
for k ulong get nargs i
v = get args add mul i 6 k
use v
end
end
fn transfer b ulong verify bool to void
for k ulong 8
put work k get dins add mul b 8 k
end
for j ulong get counts b
i = add get first b j
o = get ops i
if verify
if and ge o 2 le o 6
use get arg0 i
end
if or eq o 3 eq o 5
use get arg1 i
end
if or eq o 14 eq o 15
use get arg0 i
end
if eq o 11
calluse i
end
if and ge o 30 le o 33
use get arg0 i
end
if eq o 31
use get arg1 i
end
end
d = get dest i
