fn ecx i ulong n ulong to ulong
if lt i 9
ret ecx0 i n
end
ret ecx1 i n
end
note erfcx: erfcx_eval2(y), y >= 0.5 -> c | cl << 32. The interval search compares bits (y positive).
fn erfcx y ulong to ulong
i = ulong 0
j = ulong 1
for z ulong 16
if ge y ecx j 0
i = j
end
j = add j 1
end
t = sfsub y ecx i 1
p = ecx i 13
n = ulong 12
for z ulong 9
p = sffma p t ecx i n
n = sub n 1
end
a0 = ecx i 3
c = sffma p t a0
cl = sfadd sffma p t sfsub a0 c ecx i 2
ret or c shl cl 32
end
