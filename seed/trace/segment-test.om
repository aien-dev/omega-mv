note SPDX-License-Identifier: AGPL-3.0-only
note Trace checks: create, append, count, short-tail quarantine, fresh segment and bad header.
global checks ulong 1
global fails ulong 1
global report uchar 64
text title "trace checks="
text dir "build/trace-store"
fn check got ulong want ulong to void
put checks 0 add get checks 0 1
if ne got want
put fails 0 add get fails 0 1
end
end
fn summary to int
for i ulong len title
put report i get title i
end
n = get checks 0
at = len title
put report at uchar add 48 div n 100
put report add at 1 uchar add 48 rem div n 10 10
put report add at 2 uchar add 48 rem n 10
put report add at 3 32
put report add at 4 uchar add 48 div get fails 0 100
put report add at 5 uchar add 48 rem div get fails 0 10 10
put report add at 6 uchar add 48 rem get fails 0 10
put report add at 7 10
w = write 1 report 0 add at 8
if ne w long add at 8
ret 2
end
if ne get fails 0 0
ret 1
end
ret 0
end
fn main to int
if ne makedir dir 0 len dir 448 0
put pay 0 0
end
check segcreate 0
for i ulong 100
put pay 0 uchar and i 255
put pay 1 uchar and shr i 8 255
put pay 2 uchar and shr i 16 255
put pay 3 uchar shr i 24
check segappend 1 4 i 0
end
check segcount 0
check get scount 0 100
check get stail 0 0
setseg
fd = fopen tpath 0 get tlen 0 1089 384
if lt fd 0
check 0 1
else
for i ulong 10
put trec i 0
end
n = write int fd trec 0 10
if ne fclose int fd 0
check 0 1
end
end
check segcount 0
check get scount 0 100
check get stail 0 1
check segrecover 1
check segcount 0
check get scount 0 0
check get stail 0 0
setbad
fd = fopen tpath 0 get tlen 0 0 0
if ge fd 0
check 1 1
if ne fclose int fd 0
check 0 1
end
else
check 0 1
end
put pay 0 7
check segappend 1 1 200 0
check segcount 0
check get scount 0 1
setseg
fd = fopen tpath 0 get tlen 0 577 384
if lt fd 0
check 0 1
else
for i ulong 16
put thdr i 0
end
n = write int fd thdr 0 16
if ne fclose int fd 0
check 0 1
end
end
check segcount 11
check segcreate 0
ret summary
end
