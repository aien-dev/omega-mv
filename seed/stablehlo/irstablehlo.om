note SPDX-License-Identifier: Apache-2.0
note OSC IR scalar unit to StableHLO MLIR text. One named function is lifted
note elementwise: every scalar value becomes a tensor of N elements of its type.
note Usage: irstablehlo N FUNCTION < unit.ir > module.mlir
note Wire authority spec/one-layer-format.md: version 1 (sections 3-7) as omc ir
note writes it, and version 7 (section 10) for f32/f64 scalar functions only.
note StableHLO authority https://github.com/openxla/stablehlo/blob/main/docs/spec.md
note ops add subtract multiply divide and or xor constant (read 2026-10-26).
note Handwritten Omega; no host or foreign generator dependency.
note NOT preserved: Omega signed add/sub/mul trap 1 on overflow. The StableHLO
note spec section Errors leaves integer overflow implementation-defined, so a
note lifted signed op neither traps nor has a specified result on overflow.
note Unsigned wrap is Omega's rule and the tested oracles' behaviour, not a
note StableHLO spec guarantee. Float ops are IEEE-754 in both.
note Refused: div rem shl shr on integers (trap 2 and trap 7 have no StableHLO
note form), UN CMP CAST CALL TRAP BR CBR, more than one block, contracts, bool,
note float constants, mixed element types, structs, regions, refs.
note Buffered output: every refusal happens before any stdout write.
global input uchar 2620252
global output uchar 4194304
note state slots: 0 input cursor, 1 input size, 2 output size, 3 nparams,
note 4 nvregs, 5 wire version, 6 N, 7 element tag, 8 name matches,
note 9 wanted name length, 10 ninsns, 11 nblocks, 12 block 0 first,
note 13 block 0 count, 14 return tag, 15 contract bytes
global state ulong 16
global types ulong 480
note cur: SSA value of each vreg; 0 undefined, 1+p parameter p, 100000+k insn k.
global cur ulong 480
global ops ulong 4096
global subs ulong 4096
global dest ulong 4096
global arg0 ulong 4096
global arg1 ulong 4096
global immed ulong 4096
global want uchar 64
global abuf uchar 16
global digits uchar 24
text emagic "irstablehlo: MAGIC\n"
text ever "irstablehlo: VERSION\n"
text etrunc "irstablehlo: TRUNCATED\n"
text ecap "irstablehlo: CAPACITY\n"
text eop "irstablehlo: UNSUPPORTED_OP\n"
text etype "irstablehlo: UNSUPPORTED_TAG\n"
text einval "irstablehlo: INVALID\n"
text etrail "irstablehlo: TRAILING\n"
text eio "irstablehlo: IO\n"
text eusage "irstablehlo: USAGE\n"
text enofn "irstablehlo: NO_FUNCTION\n"
text thead "module {\n  func.func public @main("
text tparam ": tensor<"
text tcomma ", "
text tarrow ") -> tensor<"
text tbody "> {\n"
text tinsn "    %i"
text tassign " = stablehlo."
text tof " : tensor<"
text teol ">\n"
text tret "    func.return "
text tclose "  }\n}\n"
text tconst "constant dense<"
text tdense "> : tensor<"
text tadd "add"
text tsub "subtract"
text tmul "multiply"
text tdiv "divide"
text tand "and"
text tor "or"
text txor "xor"
fn refuse code int to void
k = long 0
if eq code 20
k = write 2 emagic 0 len emagic
end
if eq code 21
k = write 2 ever 0 len ever
end
if eq code 22
k = write 2 etrunc 0 len etrunc
end
if eq code 23
k = write 2 ecap 0 len ecap
end
if eq code 24
k = write 2 eop 0 len eop
end
if eq code 25
k = write 2 etype 0 len etype
end
if eq code 26
k = write 2 einval 0 len einval
end
if eq code 27
k = write 2 etrail 0 len etrail
end
if eq code 28
k = write 2 eio 0 len eio
end
if eq code 29
k = write 2 eusage 0 len eusage
end
if eq code 30
k = write 2 enofn 0 len enofn
end
exit code
end
fn need ok bool to void
if not ok
refuse 26
end
end
fn rd n ulong to ulong
p = get state 0
if gt n sub get state 1 p
refuse 22
end
v = ulong 0
for j ulong n
v = or v shl ulong get input add p j mul j 8
end
put state 0 add p n
ret v
end
fn cap n ulong maxv ulong to ulong
if gt n maxv
refuse 23
end
ret n
end
note Tags 2..9 integers, 13 f32 and 14 f64 (version 7 only); 0 void, 1 bool.
note Refs, bytes and cells (10..12) need more bytes and are refused here.
fn typ to ulong
t = rd 1
if eq get state 5 7
if or ge t 15 and ge t 10 le t 12
refuse 25
end
ret t
end
if gt t 9
refuse 25
end
ret t
end
fn vr to ulong
v = rd 2
need lt v get state 4
ret v
end
fn width t ulong to ulong
if eq t 1
ret 1
end
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or or eq t 4 eq t 8 eq t 13
ret 32
end
ret 64
end
fn mask t ulong to ulong
w = width t
if eq w 64
ret 18446744073709551615
end
ret sub shl ulong 1 w 1
end
note Canonical CONST: unsigned zero-extended, signed sign-extended to 64 bits.
fn canon v ulong t ulong to ulong
w = width t
if eq w 64
ret v
end
v = and v mask t
if ge t 6
m = shl ulong 1 sub w 1
v = sub xor v m m
end
ret v
end
fn txt n ulong to void
for j ulong n
v = rd 1
need ne v 0
end
end
fn nametxt n ulong to void
for j ulong n
v = rd 1
need and ne v 0 lt v 128
end
end
fn insn i ulong to void
o = rd 1
put ops i o
put subs i 0
put dest i 65535
put arg0 i 65535
put arg1 i 65535
put immed i 0
if eq o 1
put dest i vr
put immed i rd 8
ret
end
if or eq o 2 eq o 6
put dest i vr
put arg0 i vr
ret
end
if or or eq o 3 eq o 4 eq o 5
put subs i rd 1
put dest i vr
put arg0 i vr
if ne o 4
put arg1 i vr
end
ret
end
if eq o 11
d = rd 2
if ne d 65535
need lt d get state 4
end
put dest i d
put immed i rd 2
n = cap rd 1 6
for j ulong n
a = vr
end
ret
end
if eq o 12
put immed i rd 1
ret
end
if eq o 13
put immed i rd 2
ret
end
if eq o 14
put arg0 i vr
put immed i rd 2
put arg1 i rd 2
ret
end
if eq o 15
v = rd 2
if ne v 65535
need lt v get state 4
end
put arg0 i v
ret
end
refuse 24
end
fn emit v ulong to void
p = get state 2
if ge p len output
refuse 23
end
put output p uchar v
put state 2 add p 1
end
fn dec v ulong to void
n = ulong 0
x = v
for j ulong 20
put digits n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
break
end
end
for j ulong n
emit ulong get digits sub sub n j 1
end
end
fn sdec v ulong to void
t = get state 7
if and ge t 6 ge v 9223372036854775808
emit 45
dec sub 0 v
ret
end
dec v
end
fn emtxt id ulong to void
if eq id 1
for j ulong len thead
emit ulong get thead j
end
ret
end
if eq id 2
for j ulong len tparam
emit ulong get tparam j
end
ret
end
if eq id 4
for j ulong len tcomma
emit ulong get tcomma j
end
ret
end
if eq id 5
for j ulong len tarrow
emit ulong get tarrow j
end
ret
end
if eq id 6
for j ulong len tbody
emit ulong get tbody j
end
ret
end
if eq id 7
for j ulong len tinsn
emit ulong get tinsn j
end
ret
end
if eq id 8
for j ulong len tassign
emit ulong get tassign j
end
ret
end
if eq id 9
for j ulong len tof
emit ulong get tof j
end
ret
end
if eq id 10
for j ulong len teol
emit ulong get teol j
end
ret
end
if eq id 11
for j ulong len tret
emit ulong get tret j
end
ret
end
if eq id 12
for j ulong len tclose
emit ulong get tclose j
end
ret
end
if eq id 13
for j ulong len tconst
emit ulong get tconst j
end
ret
end
if eq id 14
for j ulong len tdense
emit ulong get tdense j
end
ret
end
if eq id 15
for j ulong len tadd
emit ulong get tadd j
end
ret
end
if eq id 16
for j ulong len tsub
emit ulong get tsub j
end
ret
end
if eq id 17
for j ulong len tmul
emit ulong get tmul j
end
ret
end
if eq id 18
for j ulong len tdiv
emit ulong get tdiv j
end
ret
end
if eq id 19
for j ulong len tand
emit ulong get tand j
end
ret
end
if eq id 20
for j ulong len tor
emit ulong get tor j
end
ret
end
if eq id 21
for j ulong len txor
emit ulong get txor j
end
ret
end
refuse 26
end
note Element type: ui8..ui64 for tags 2..5, i8..i64 (signed in StableHLO) for
note 6..9, f32 and f64 for 13 and 14.
fn elem to void
t = get state 7
if ge t 13
emit 102
else
if le t 5
emit 117
end
emit 105
end
dec width t
end
fn ttype to void
dec get state 6
emit 120
elem
end
fn valc c ulong to void
emit 37
if lt c 100000
emit 112
dec sub c 1
else
emit 105
dec sub c 100000
end
end
fn defd r ulong to ulong
c = get cur r
need ne c 0
ret c
end
fn binname s ulong to ulong
fl = ge get state 7 13
if eq s 1
ret 15
end
if eq s 2
ret 16
end
if eq s 3
ret 17
end
if eq s 4
if fl
ret 18
end
refuse 24
end
need and not fl and ge s 5 le s 10
if eq s 6
ret 19
end
if eq s 7
ret 20
end
if eq s 8
ret 21
end
refuse 24
ret 0
end
fn header to void
emtxt 1
for j ulong get state 3
if ne j 0
emtxt 4
end
emit 37
emit 112
dec j
emtxt 2
ttype
emit 62
end
emtxt 5
ttype
emtxt 6
end
fn step k ulong to void
o = get ops k
last = eq k sub get state 10 1
if eq o 15
need last
a = get arg0 k
need ne a 65535
c = defd a
emtxt 11
valc c
emtxt 9
ttype
emtxt 10
ret
end
need not last
d = get dest k
if eq o 2
put cur d defd get arg0 k
ret
end
if eq o 1
if ge get state 7 13
refuse 24
end
v = get immed k
need eq v canon v get state 7
emtxt 7
dec k
emtxt 8
emtxt 13
sdec v
emtxt 14
ttype
emtxt 10
put cur d add k 100000
ret
end
if eq o 3
nm = binname get subs k
x = defd get arg0 k
y = defd get arg1 k
emtxt 7
dec k
emtxt 8
emtxt nm
emit 32
valc x
emtxt 4
valc y
emtxt 9
ttype
emtxt 10
put cur d add k 100000
ret
end
refuse 24
end
fn lift to void
t = get state 14
if or le t 1 and ge t 10 le t 12
refuse 25
end
put state 7 t
if ne get state 15 0
refuse 24
end
if ne get state 11 1
refuse 24
end
for j ulong get state 4
if ne get types j t
refuse 25
end
put cur j 0
end
ni = get state 10
need eq get state 12 0
need eq get state 13 ni
for j ulong get state 3
put cur j add j 1
end
header
for k ulong ni
step k
end
emtxt 12
end
fn loadfn to void
start = get state 0
n = cap rd 1 63
need ne n 0
nametxt n
hit = false
if eq n get state 9
hit = true
for j ulong n
if ne get input add start add j 1 get want j
hit = false
end
end
end
np = cap rd 1 6
put state 14 typ
nv = cap rd 2 480
need ge nv np
put state 3 np
put state 4 nv
for j ulong nv
t = typ
need ne t 0
put types j t
end
nb = cap rd 2 512
need ne nb 0
put state 11 nb
for j ulong nb
f = rd 4
c = rd 4
if eq j 0
put state 12 f
put state 13 c
end
end
ni = cap rd 4 4096
need ne ni 0
put state 10 ni
for j ulong ni
insn j
end
rq = cap rd 2 255
txt rq
en = cap rd 2 255
txt en
put state 15 add rq en
if hit
need eq get state 8 0
put state 8 1
lift
end
end
fn main to int
if ne argcnt 3
refuse 29
end
k = argread 1 abuf 0 len abuf
if or lt k 1 gt k 8
refuse 29
end
nv = ulong 0
for j ulong ulong k
c = get abuf j
if or lt c 48 gt c 57
refuse 29
end
nv = add mul nv 10 ulong sub c 48
end
if or eq get abuf 0 48 gt nv 16777216
refuse 29
end
put state 6 nv
k = argread 2 want 0 len want
if or lt k 1 gt k 63
refuse 29
end
put state 9 ulong k
n = ulong 0
for attempt ulong 2620252
if eq n len input
refuse 23
end
k = read 0 input n sub len input n
if lt k 0
refuse 28
end
if eq k 0
break
end
n = add n ulong k
end
if eq n len input
refuse 23
end
put state 1 n
magic = new uchar 7 0
put magic 0 79
put magic 1 83
put magic 2 67
put magic 3 49
put magic 4 73
put magic 5 82
for j ulong 7
v = rd 1
if ne v ulong get magic j
refuse 20
end
end
v = rd 1
if and ne v 1 ne v 7
refuse 21
end
put state 5 v
if eq v 7
if ne rd 1 0
refuse 24
end
if ne rd 2 0
refuse 24
end
end
nf = cap rd 2 32
need ne nf 0
for f ulong nf
loadfn
end
if ne get state 0 n
refuse 27
end
if eq get state 8 0
refuse 30
end
p = ulong 0
for attempt ulong 4194304
if eq p get state 2
break
end
k = write 1 output p sub get state 2 p
if le k 0
refuse 28
end
p = add p ulong k
end
ret 0
end
