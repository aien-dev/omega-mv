; sm121.tbl -- the GB10 (sm_121, Blackwell) instruction table for asm2 (rung 6), readable text.
; Same format as rung2/table.s2:   = name  0xBASE  field...
; asm2 writes one 32-bit word per line. A GPU instruction is 128 bits = four 32-bit words, stored
; in the order word 0, 1, 2, 3 (each little-endian), exactly as src/omega_blackwell_codegen.c
; omega_bw_encode_program lays them out. So every instruction is four lines in a listing, one per word;
; where several instructions share a word (for example "word 1 = one register") they share one line:
;   .0  opcode, predicate (bits 12..15), destination register (bits 16..23), first source (24..31)
;   .1  second source register or a 32-bit number
;   .2  modifier bits (fixed per instruction) and the third source register
;   .3  the scheduling ("control") word; name.3 holds the C codegen's default, `ctl N` writes any other.
; Fields: iP.W = unsigned number at bit P, W bits wide; sP.W = signed. Registers are written as numbers
; (R5 = 5, RZ = 255); predicates as numbers (7 = always, 0 = @P0, 8 = @!P0).
; Units: every number is written as the bits hold it (constant-bank offsets in 4- or 8-byte units,
; branch distances in instructions, split the way the word splits them). See seed/sm121/README.md.
; Source of every base word and field: our own encoder, src/omega_blackwell_codegen.c (blob b09fa1e5),
; encode_single_insn, line named per entry; three after-encoding patches in codegen_tc.c (blob 1b7f55df)
; and codegen_qmma.c (blob 7616015e). The C encoder is the referee; this table was written from reading it.
;
= ctl          0x00000000 i0.32          ; word 3 written out: any scheduling word
; ---- NOP (codegen.c:276; also the padding of every program, codegen.c:1016) ----
= nop.0        0x00007918
= nop.1        0x00000000
= nop.2        0x00000000
= nop.3        0x000fc000
; ---- MOV Rd, RZ (codegen.c:283) ----
= mov.rz.0     0x00007202 i16.8
= mov.rz.1     0x000000ff
= mov.rz.2     0x00000f00
= mov.rz.3     0x000fe200
; ---- MOV Rd, imm32 (codegen.c:291) ----
= mov.i.0      0x00007802 i16.8
= mov.i.1      0x00000000 i0.32
= mov.i.2      0x00000f00
= mov.i.3      0x000fe200
; ---- S2R Rd, SR (codegen.c:299): special-register number at word-2 bit 8 ----
= s2r.0        0x00007919 i16.8
= s2r.1        0x00000000
= s2r.2        0x00000000 i8.8
= s2r.3        0x000e2200
; ---- LDC Rd, c[0x0][off] (codegen.c:307): offset/4 at word-1 bits 8..23 ----
= ldc.0        0xff007b82 i16.8
= ldc.1        0x00000000 i8.16
= ldc.2        0x00000800
= ldc.3        0x000fe200
; ---- LDC.64 (codegen.c:315) ----
= ldc.64.0     0xff007b82 i16.8
= ldc.64.1     0x00000000 i8.16
= ldc.64.2     0x00000a00
= ldc.64.3     0x000e2200
; ---- LDCU URd, c[0x0][off] (codegen.c:323): offset/8 at word-1 bits 8..23 (the C code shifts by 5) ----
= ldcu.0       0xff0077ac i16.8
= ldcu.1       0x00000000 i8.16
= ldcu.2       0x08000800
= ldcu.3       0x000e2200
; ---- LDCU.64 (codegen.c:331) ----
= ldcu.64.0    0xff0077ac i16.8
= ldcu.64.1    0x00000000 i8.16
= ldcu.64.2    0x08000a00
= ldcu.64.3    0x000e6e00
; ---- IMAD Rd, Ra, Rb, Rc (codegen.c:341, register form) ----
= imad.0       0x00007224 i16.8 i24.8
= imad.1       0x00000000 i0.8
= imad.2       0x078e0200 i0.8
= imad.3       0x001fca00
