= bra.0        0x00000947 i12.4 i18.6
= bra.1        0x00000000 s2.30
= bra.fwd.2    0x03800000
= bra.back.2   0x0383ffff
= bra.self.3   0x000fc000                ; the unpredicated branch-to-itself after EXIT
