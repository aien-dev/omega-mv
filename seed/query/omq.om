note ---------------------------------------------------------------- obligations

fn regs to ulong
note how many more ulong names fit at the hole before the register pool is exhausted
lo = ulong 0
hi = ulong 17
while lt add lo 1 hi
mid = div add lo hi 2
cbc
for j ulong mid
cb1 95
cb1 113
cbn j
cbt teqsp
cbz 5
cb1 10
end
put g GCB sub get g GCB 1
if trys false
lo = mid
else
hi = mid
end
end
ret lo
end

fn ansobl to void
obkey jobl
obopen 123
obkey jfunc
f = get g GFL
a = lnw f 0
obsep
obstr a sub get lea f a
obkey jopen
obopen 91
d = get g GD0
while gt d 0
d = sub d 1
obsep
obopen 34
k = get bk d
if eq k 1
obt tfn
end
if eq k 2
obt tif
end
if eq k 3
obt telse
end
if eq k 4
obt tfor
end
if eq k 5
obt twhile
end
obclose 34
end
obclose 93
obkey jregs
obnum regs
anscon
anseff
obclose 125
end

fn anscon to void
note contract clauses in force: the function prefix and the invariants of open loops
obkey jcon
obopen 91
i = add get g GFL 1
while lt i get g GHL
if or lwis i 0 treq lwis i 0 tens
obcl i
end
if lwis i 0 tinv
if invopen i
obcl i
end
end
i = add i 1
end
obclose 93
end

fn obcl i ulong to void
a = lnw i 0
obsep
obstr a sub get lea i a
end

fn invopen i ulong to bool
note is the loop that owns invariant line i still open at the hole
o = i
while gt o 0
o = sub o 1
if not or lwis o 0 tinv lwis o 0 tnote
break
end
end
for k ulong get g GD0
if eq get bln k o
ret true
end
end
ret false
end

fn anseff to void
note host operations used by the enclosing function, with their effect class
obkey jeff
obopen 91
i = get g GFL
while lt i get g GEND
p = skb get lsa i
while lt p get lea i
q = wde p
effw p sub q p
p = skb q
end
i = add i 1
end
obclose 93
end

fn effw a ulong n ulong to void
p = ulong 0
m = len hostw
while lt p m
q = p
while ne get hostw q 58
q = add q 1
end
if hweq a n p sub q p
e = q
while ne get hostw e 32
e = add e 1
end
obsep
ob1 34
obs a n
ob1 58
r = add q 1
while lt r e
ob1 get hostw r
r = add r 1
end
obclose 34
ret
end
while ne get hostw q 32
q = add q 1
end
p = add q 1
end
end

fn hweq a ulong n ulong p ulong m ulong to bool
if ne n m
ret false
end
for i ulong n
if ne get src add a i get hostw add p i
ret false
end
end
ret true
end

note ---------------------------------------------------------------- check and repair

fn wdiag to ulong
note the program (hole removed) with an om2 diag line; return the byte shift it adds
put g GWN 0
i = ulong 0
while and lt i get g GNL or eq skb get lsa i get lea i lwis i 0 tnote
i = add i 1
end
if lwis i 0 tom2
if lwis i 1 tdiag
wbody
ret 0
end
if lwis i 1 tfmt
wbody
ret 0
end
wlns 0 i
cbc
cbt tom2
cb1 32
cbt tdiag
a = lnw i 1
if lt a get lea i
cb1 32
cbs a sub get lea i a
end
wcb
w1 10
wbodyf add i 1
ret 0
end
cbc
cbt tom2
cb1 32
cbt tdiag
wcb
w1 10
wbody
ret 9
end

fn wbody to void
wbodyf 0
end

fn wbodyf i ulong to void
note lines from i, with the hole closed off as in the base witness
if eq get g GHK 0
wlns i get g GNL
ret
end
wlns i get g GHL
wcl get g GD0 false
wrest
end

fn dfield k view uchar * to ulong
note offset in eb of the value of field k= on the omc-diag line, or 8192 when absent
n = get g GEN
p = ulong 0
while lt add p len tdiagr n
if ebeq p tdiagr
break
end
p = add p 1
end
while lt add p len k n
if ebeq p k
if eq get eb add p len k 61
ret add add p len k 1
end
end
p = add p 1
end
ret 8192
end

fn ebeq p ulong t view uchar * to bool
for i ulong len t
if ne get eb add p i get t i
ret false
end
end
ret true
end

fn ebnum p ulong to ulong
v = ulong 0
q = p
while lt q get g GEN
c = get eb q
if or lt c 48 gt c 57
ret v
end
v = add mul v 10 ulong sub c 48
q = add q 1
end
ret v
end


fn ebword k view uchar * to void
p = dfield k
if ge p 8192
obtstr tvoid
ret
end
ob1 34
while lt p get g GEN
c = get eb p
if or eq c 32 eq c 10
break
end
ob1 c
p = add p 1
end
ob1 34
put g GSEP 1
end

fn hexv c uchar to ulong
if ge c 97
ret ulong sub c 87
end
ret ulong sub c 48
end

fn ebfound to void
note found= is hex; decode it to text, keeping the found bytes in scratch
cbc
p = dfield kfound
if lt p 8192
while lt add p 1 get g GEN
c = get eb p
if or eq c 32 or eq c 10 eq c 45
break
end
cb1 uchar or shl hexv c 4 hexv get eb add p 1
p = add p 2
end
end
ob1 34
obcb
ob1 34
put g GSEP 1
end

fn anscheck to void
obkey jcheck
obopen 123
put g GWN 0
wbody
rc = run
put g GRC rc
put g GOK 0
if eq rc 0
put g GOK 1
end
obkey kcode
obnum rc
if ne rc 0
put g GDL ebline
okn kline get g GDL
sh = wdiag
rd = run
if eq rd rc
diagrec sh
end
end
ostat rc
obclose 125
end

fn ostat rc ulong to void
note the outcome. No hole: VALID-UNPROVEN when omc accepts (nothing here proves behaviour), else
note INVALID. A hole: INCOMPLETE when the base witness compiles (a valid completion exists),
note INVALID when the error sits before the hole (no text at the hole can reach back), else
note UNKNOWN (the error may depend on what the hole holds). Never a plain VALID.
obkey kstat
if eq rc 0
if eq get g GHK 0
obtstr svalun
else
obtstr sincom
end
ret
end
if or eq get g GHK 0 le get g GDL get g GHL
obtstr sinval
ret
end
obtstr sunk
end

fn okn t view uchar * v ulong to void
obkey t
obnum v
end

fn ebline to ulong
note line N of the human record omc: line N: error E
p = ulong 0
n = get g GEN
while lt p n
c = get eb p
if and ge c 48 le c 57
ret ebnum p
end
p = add p 1
end
ret 0
end

fn diagrec sh ulong to void
obkey ksev
ebword ksev
obkey kcol
obnum ebnum dfield kcol
obkey kexpect
ebword kexpect
obkey kfound
ebfound
obkey kobl
ebword kobl
p = dfield kspan
a = ebnum p
put g GDA sub a sh
obkey kspan
obopen 91
obnum sub a sh
while and lt p get g GEN ne get eb p 45
p = add p 1
end
obsep
obnum sub ebnum add p 1 sh
obclose 93
repair
end

note ---------------------------------------------------------------- repairs


fn rtext e ulong to void
if eq e 3
obtstr r3
end
if eq e 4
obtstr r4
end
if eq e 5
obtstr r5
end
if eq e 6
obtstr r6
end
if eq e 7
obtstr r7
end
if eq e 8
obtstr r8
end
if eq e 9
obtstr r9
end
rtext2 e
end

fn rtext2 e ulong to void
if eq e 10
obtstr r10
end
if eq e 11
obtstr r11
end
if eq e 12
obtstr r12
end
if eq e 13
obtstr r13
end
if eq e 14
obtstr r14
end
if eq e 15
obtstr r15
end
if eq e 16
obtstr r16
end
rtext3 e
end

fn rtext3 e ulong to void
if eq e 17
obtstr r17
end
if eq e 18
obtstr r18
end
if eq e 19
obtstr r19
end
if eq e 20
obtstr r20
end
if eq e 21
obtstr r21
end
if eq e 22
obtstr r22
end
if eq e 27
obtstr r27
end
if eq e 30
obtstr r30
end
if or lt e 3 or eq e 23 or gt e 30 and gt e 23 lt e 27
obtstr tvoid
end
end

fn repair to void
e = get g GRC
obkey kwhy
rtext e
if eq e 13
rlong
end
if eq e 3
rmove
end
if eq e 15
rend
end
end

fn rlong to void
note rename the long name (in scratch) to an unused 8-character name, everywhere; recompile
n = get g GCB
if or le n 8 gt n 64
ret
end
put g GDC ulong get cb 7
for d ulong 10
put cb 7 uchar add ulong 48 d
if not inuse
rdorename n
ret
end
end
end

fn inuse to bool
note is the first 8 bytes of scratch already a word in the source
for i ulong get g GNL
p = skb get lsa i
while lt p get lea i
q = wde p
if eq sub q p 8
if cbeqsrc p 8
ret true
end
end
p = skb q
end
end
ret false
end

fn cbeqsrc p ulong n ulong to bool
for i ulong n
if ne get cb i get src add p i
ret false
end
end
ret true
end

fn rdorename n ulong to void
note n is the long name's length; cb holds the long name with byte 7 replaced
put g GWN 0
p = ulong 0
m = get g GSL
while lt p m
if wordat p n
for j ulong 8
w1 get cb j
end
p = add p n
else
w1 get src p
p = add p 1
end
end
rafter
end

fn wordat p ulong n ulong to bool
note whole-word match of the original long name (scratch, byte 7 differs) at p
if gt add p n get g GSL
ret false
end
if gt p 0
if not wsep get src sub p 1
ret false
end
end
if lt add p n get g GSL
if not wsep get src add p n
ret false
end
end
for i ulong n
if ne i 7
if ne get cb i get src add p i
ret false
end
end
end
ret eq ulong get src add p 7 get g GDC
end

fn wsep c uchar to bool
ret or isb c or eq c 10 or eq c 40 eq c 41
end

fn rafter to void
obkey kfixr
ob1 34
for j ulong 8
obe get cb j
end
ob1 34
put g GSEP 1
r = run
obkey kafter
obnum r
end

fn rmove to void
note an unknown global/const/text defined later at top level: move that line above the first fn
n = get g GCB
k = get g GNL
for i ulong k
if or lwis i 0 tglobal or lwis i 0 tconst lwis i 0 ttext
a = lnw i 1
if eq sub wde a a n
if cbeqsrc a n
if gt i firstfn
rdomove i
ret
end
end
end
end
end
end

fn firstfn to ulong
for i ulong get g GNL
if or lwis i 0 tfn lwis i 0 texport
ret i
end
end
ret get g GNL
end

fn rdomove m ulong to void
f = firstfn
put g GWN 0
wlns 0 f
wln m
wlns f m
wlns add m 1 get g GNL
obkey kfixm
obstr get lsa m sub get lea m get lsa m
r = run
obkey kafter
obnum r
end

fn rend to void
note append the missing end lines and recompile
put g GWN 0
wlns 0 get g GNL
for k ulong 8
wt tend
r = run
if ne r 15
obkey kfixe
obnum add k 1
obkey kafter
obnum r
ret
end
end
end

note ---------------------------------------------------------------- main

fn setup to bool
if lt argcnt 2
r = write 2 tusage 0 len tusage
ret false
end
n = argread 1 pk 4 4000
if le n 0
ret false
end
put pk 0 1
put pk 1 0
put pk 2 uchar and ulong n 255
put pk 3 uchar shr ulong n 8
put g GPN add ulong n 4
fi = memfd tmfd 0 len tmfd 1
fe = memfd tmfd 0 len tmfd 1
dn = fopen tdevnull 0 len tdevnull 524289 0
if or lt fi 0 or lt fe 0 lt dn 0
ret false
end
put g GMI ulong fi
put g GME ulong fe
put g GDN ulong dn
ret true
end

fn selftest to bool
note the given OMC must accept a minimal unit and reject a truncated one with error 15
put g GWN 0
wt tgood
if ne run 0
ret false
end
put g GWN 0
wt tbadp
if ne run 15
ret false
end
ret and ge get g GEN len tomcl ebeq 0 tomcl
end

note ---------------------------------------------------------------- prefix mode
note omq OMC prefix: the prefix-viability server first written by OmegaMind as omviable.om
note (handoffs/OmegaMind/omviable, 2026-10-26), absorbed here so one implementation exists.
note request on fd 0: 4-byte little-endian length L, then L bytes of program prefix.
note the prefix is compiled as "om2 diag" LF prefix. reply on fd 1: one line "V CODE" where
note V 0 = a whole unit omc accepts, 1 = a prefix omc can still complete (first diag
note sev=incomplete, or sev=unknown whose span ends at the prefix end on a word byte),
note 2 = dead (any other refusal), 3 = the compiler did not run; CODE = omc exit status.

fn pmode to bool
if lt argcnt 3
ret false
end
k = argread 2 cb 0 64
if ne k long len tprefix
ret false
end
for i ulong len tprefix
if ne get cb i get tprefix i
ret false
end
end
ret true
end

fn rdlen to long
got = ulong 0
while lt got 4
r = read 0 lb got sub 4 got
if le r 0
ret neg long 1
end
got = add got ulong r
end
v = ulong 0
for i ulong 4
v = or v shl ulong get lb i mul i 8
end
ret long v
end

fn rdn n ulong to bool
got = ulong 0
while lt got n
r = read 0 src got sub n got
if le r 0
ret false
end
got = add got ulong r
end
ret true
end

fn wordch c uchar to bool
a = or and ge c 97 le c 122 and ge c 65 le c 90
ret or a or and ge c 48 le c 57 eq c 95
end

fn pspan to ulong
p = dfield kspan
while and lt p get g GEN ne get eb p 45
p = add p 1
end
ret ebnum add p 1
end

fn pverd rc ulong n ulong to ulong
if eq rc 0
ret 0
end
if ge rc 250
ret 3
end
s = dfield ksev
if ge s get g GEN
ret 2
end
c = get eb s
if eq c 105
ret 1
end
if ne c 117
ret 2
end
if eq n 0
ret 2
end
if and eq pspan get g GWN wordch get src sub n 1
ret 1
end
ret 2
end

fn pserve to int
while true
m = rdlen
if lt m 0
ret 0
end
n = ulong m
if gt n 1048000
ret 92
end
if not rdn n
ret 93
end
put g GWN 0
wt thdr
wsr 0 n
rc = run
v = pverd rc n
cbc
cb1 uchar add v 48
cb1 32
