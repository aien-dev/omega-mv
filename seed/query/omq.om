om2
note omq: exact hole oracle over the pinned omc. Usage: omq OMC < program > answer.json
note The program holds at most one hole, the word ??. A line that is only ?? is a statement hole;
note ?? inside a line is a value hole. Every scope entry, expected type and next form in the answer
note is a witness program the real compiler accepted: omq builds the witness, runs OMC on it and
note reports what passed. It does not reimplement any Omega rule. See seed/query/README.md.

const GON ulong 0
const GWN ulong 1
const GSL ulong 2
const GNL ulong 3
const GHL ulong 4
const GHA ulong 5
const GHK ulong 6
const GFL ulong 7
const GD0 ulong 8
const GD1 ulong 9
const GEND ulong 10
const GMI ulong 11
const GME ulong 12
const GDN ulong 13
const GPN ulong 14
const GRUN ulong 15
const GEN ulong 16
const GNC ulong 17
const GLOOP ulong 18
const GIF ulong 19
const GOK ulong 20
const GSEP ulong 21
const GCB ulong 22
const GNB ulong 23
const GEXP ulong 24
const GNH ulong 25
const GOM2 ulong 26
const GRC ulong 27
const GDL ulong 28
const GDC ulong 29
const GDA ulong 30
const GDB ulong 31
const GSK ulong 32
const GSA ulong 33
const GNT ulong 34

global src uchar 1048576
global lsa ulong 65536
global lea ulong 65536
global wit uchar 2097152
global ob uchar 1048576
global eb uchar 8192
global pk uchar 4200
global cb uchar 4096
global g ulong 64
global ca ulong 512
global cl ulong 512
global ct ulong 512
global bk ulong 1024
global bln ulong 1024

text tys "bool uchar ushort uint ulong byte short int long f32 f64 "
text bops "add sub mul div rem and or xor shl shr "
text cops "eq ne lt le gt ge "
text hostw "read:io write:io exit:io fopen:fs fclose:fs fsync:fs fdsync:fs memfd:fs fchmod:fs chmod:fs chown:fs faccess:fs fchdir:fs syncfs:fs flock:fs umask:fs fseek:fs ftrunc:fs truncate:fs unlink:fs makedir:fs rmdir:fs cwd:fs chdir:fs readlnk:fs getdnts:fs fstat:fs stat:fs lstat:fs renames:fs link:fs symlnk:fs pread:fs pwrite:fs socknew:net bind:net connect:net listen:net accept:net sockname:net sockopt:net recv:net send:net shutdown:net peercred:net sendmsg:net waitio:proc pollfds:proc fork:proc getpid:proc getppid:proc killpid:proc waitpid:proc pipefds:proc dupfd:proc execprog:proc setsid:proc getpgid:proc setpgid:proc getsid:proc getuid:proc geteuid:proc getgid:proc getegid:proc argcnt:env argread:env envcnt:env envread:env monons:clock realns:clock sleepns:clock random:random devctl:device mapnew:device mapdrop:device mapread:device mapwrite:device devcall:device uvmctl:device mapaddr:device mapget:device mapset:device maphold:device mapbind:device "
text tnl "\n"
text ttrap "trap 1\n"
text tend "end\n"
text tq "_q = "
text tdevnull "/dev/null"
text tmfd "omq"
text tusage "usage: omq OMC < program > answer.json\n"
text tbad "omq: cannot run the compiler\n"
text tfn "fn"
text texport "export"
text tif "if"
text twhile "while"
text tfor "for"
text telse "else"
text tkend "end"
text tglobal "global"
text tconst "const"
text ttext "text"
text teq "="
text tto "to"
text tvoid "void"
text treq "requires"
text tens "ensures"
text tinv "invariant"
text tnote "note"
text tom2 "om2"
text tdiag "diag"
text tfmt "fmt"
text tview "view"
text tedit "edit"
text tout "out"
text tfresh "fresh"
text tinline "inline"
text ttrue "true"
text tlen "len "
text tget "get "
text tput "put "
text tdiagr "omc-diag 1 "
text r3 "unknown name: define it before this line (globals, consts and texts above their first use; locals in an enclosing block that is still open)"
text r4 "the line ends too early: an operation or call is missing an operand"
text r5 "extra words: an operation or call got more operands than it takes"
text r6 "malformed number"
text r7 "type mismatch: convert with TYPE value (checked), or use a name of the expected type; a name keeps its first type"
text r8 "number out of range for the type"
text r9 "word not allowed here (e.g. break outside a loop, more than six parameter slots, an inline cycle)"
text r10 "duplicate name: pick a new name"
text r11 "ambiguous bare number: write a typed number, e.g. uint 5"
text r12 "register pool exhausted: split the function into helpers, or end blocks so names die"
text r13 "name longer than 8 characters: shorten it"
text r14 "capacity exceeded"
text r15 "missing end: close every fn/if/while/for with end"
text r16 "syntax: unknown word or wrong form"
text r17 "line after ret/break/continue/trap/exit in the same block: delete it or move it above"
text r18 "missing ret: the function's end is reachable; add ret VALUE or trap N before end"
text r19 "a global passed as an argument, or one array twice in a call: name the global inside the callee"
text r20 "write to a view or text: make the parameter edit"
text r21 "constant index out of range"
text r22 "bad text literal"
text r27 "uninitialised fresh element read"
text r30 "contract syntax or a forbidden predicate operation"
text kwhy "why"
text kafter "rc_after_fix"
text kfixr "fix_rename"
text kfixm "fix_move_up"
text kfixe "fix_append_end"
text kcode "code"
text kstat "status"
text sinval "INVALID"
text sincom "INCOMPLETE"
text svalun "VALID-UNPROVEN"
text sunk "UNKNOWN"
text kline "line"
text kcol "col"
text kspan "span"
text kexpect "expect"
text kfound "found"
text kobl "obligation"
text ksev "sev"
text teqsp " = "
text tifb "if true"
text twhb "while false"
text tforb "for _q ulong 1"
text tbrk "break"
text tcont "continue"
text tifo "if <bool>"
text twho "while <bool>"
text tforo "for NAME T COUNT"
text ttrapo "trap <1..255>"
text texito "exit <int>"
text texit0 "exit 0"
text tretw "ret"
text texitw "exit"
text treqt "requires true"
text tenst "ensures true"
text tinvt "invariant true"
text treqo "requires <bool>"
text tenso "ensures <bool>"
text tinvo "invariant <bool>"
text jhole "hole"
text jline "line"
text jkind "kind"
text jstmt "statement"
text jvalue "value"
text jfnl "fn_line"
text jdepth "depth"
text jscope "scope"
text jname "name"
text jtype "type"
text jwr "writable"
text jfns "fns"
text jexp "expect"
text jobl "obligations"
text jfunc "function"
text jopen "open"
text jregs "regs_free"
text jcon "contracts"
text jeff "effects"
text jcheck "check"
text jnext "next"
text jruns "compiles"
text jerr "error"
text jmany "more than one ?? hole"
text jout "the hole is not inside a function"
text jwhile "while"
text tgood "fn main to int\nret 0\nend\n"
text tbadp "fn main to int\nret 0\n"
text tomcl "omc: line "
text tprefix "prefix"
text thdr "om2 diag\n"
global lb uchar 4

note ---------------------------------------------------------------- output buffer (JSON)

fn ob1 b uchar to void
n = get g GON
if lt n 1048000
put ob n b
put g GON add n 1
end
end

fn obt t view uchar * to void
for i ulong len t
ob1 get t i
end
end

fn obe b uchar to void
if or eq b 34 eq b 92
ob1 92
ob1 b
ret
end
if eq b 9
ob1 92
ob1 116
ret
end
if lt b 32
ob1 32
ret
end
ob1 b
end

fn obs a ulong n ulong to void
for i ulong n
obe get src add a i
end
end

fn obcb to void
for i ulong get g GCB
obe get cb i
end
end

fn obn v ulong to void
d = new uchar 24 0
k = ulong 0
x = v
while true
put d k uchar add ulong 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
while gt k 0
k = sub k 1
ob1 get d k
end
end

fn obsep to void
if ne get g GSEP 0
ob1 44
end
put g GSEP 1
end

fn obkey t view uchar * to void
obsep
ob1 34
obt t
ob1 34
ob1 58
put g GSEP 0
end

fn obstr a ulong n ulong to void
ob1 34
obs a n
ob1 34
put g GSEP 1
end

fn obtstr t view uchar * to void
ob1 34
obt t
ob1 34
put g GSEP 1
end

fn obnum v ulong to void
obn v
put g GSEP 1
end

fn obopen b uchar to void
ob1 b
put g GSEP 0
end

fn obclose b uchar to void
ob1 b
put g GSEP 1
end

note ---------------------------------------------------------------- source words and lines

fn isb c uchar to bool
ret or eq c 32 eq c 9
end

fn skb p ulong to ulong
q = p
while and lt q get g GSL isb get src q
q = add q 1
end
ret q
end

fn wde p ulong to ulong
q = p
n = get g GSL
while lt q n
c = get src q
if or isb c eq c 10
ret q
end
q = add q 1
end
ret q
end

fn sweq a ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n
if ne get src add a i get t i
ret false
end
end
ret true
end

fn lnw i ulong k ulong to ulong
note start offset of word k (0-based) of line i, or the line end when it has fewer words
p = skb get lsa i
e = get lea i
for j ulong k
if ge p e
ret e
end
p = skb wde p
end
if gt p e
ret e
end
ret p
end

fn lwis i ulong k ulong t view uchar * to bool
a = lnw i k
if ge a get lea i
ret false
end
ret sweq a sub wde a a t
end

fn opener i ulong to bool
if or lwis i 0 tif or lwis i 0 twhile lwis i 0 tfor
ret true
end
ret or lwis i 0 tfn lwis i 0 texport
end

note ---------------------------------------------------------------- witness buffer

fn w1 b uchar to void
n = get g GWN
if lt n 2097000
put wit n b
put g GWN add n 1
end
end

fn wt t view uchar * to void
for i ulong len t
w1 get t i
end
end

fn wsr a ulong n ulong to void
for i ulong n
w1 get src add a i
end
end

fn wln i ulong to void
a = get lsa i
wsr a sub get lea i a
w1 10
end

fn wlns i ulong j ulong to void
k = i
while lt k j
wln k
k = add k 1
end
end

fn wcb to void
for i ulong get g GCB
w1 get cb i
end
end

fn wcl d ulong ended bool to void
note close d open blocks, a trap before each end; with GNT set only the innermost gets one, for
note a hole whose outer block already terminates (an else after a then branch that returns)
for k ulong d
if not and eq k 0 ended
if or eq k 0 eq get g GNT 0
wt ttrap
end
end
wt tend
end
end

fn clmode to void
note choose the closers: when the base witness says line after ret (17), drop the outer traps
put g GNT 0
put g GWN 0
wbody
if eq run 17
put g GNT 1
end
end

fn wrest to void
wlns add get g GEND 1 get g GNL
end

fn wholev to void
note the hole line with ?? replaced by the scratch text
i = get g GHL
a = get lsa i
h = get g GHA
wsr a sub h a
wcb
e = add h 2
wsr e sub get lea i e
w1 10
end

note ---------------------------------------------------------------- scratch text

fn cbc to void
put g GCB 0
end

fn cb1 b uchar to void
n = get g GCB
if lt n 4000
put cb n b
put g GCB add n 1
end
end

fn cbt t view uchar * to void
for i ulong len t
cb1 get t i
end
end

fn cbs a ulong n ulong to void
for i ulong n
cb1 get src add a i
end
end

fn cbn v ulong to void
if ge v 10
cbn div v 10
end
cb1 uchar add ulong 48 rem v 10
end

fn cbtw t view uchar * a ulong to ulong
note copy the word of t that starts at a; return the offset after its blank
p = a
while and lt p len t ne get t p 32
cb1 get t p
p = add p 1
end
ret add p 1
end

fn tyat k ulong to ulong
note start offset in tys of type k (1-based)
p = ulong 0
j = ulong 1
while lt j k
while ne get tys p 32
p = add p 1
end
p = add p 1
j = add j 1
end
ret p
end

fn cbty k ulong to void
r = cbtw tys tyat k
end

fn cbz k ulong to void
note a literal of type k: true for bool, else TYPE 1 (1.0 for floats)
if eq k 1
cbt ttrue
ret
end
cbty k
cb1 32
cb1 49
if ge k 10
cb1 46
cb1 48
end
end

fn cbname c ulong to void
cbs get ca c get cl c
end

fn obty k ulong to void
p = tyat k
while ne get tys p 32
ob1 get tys p
p = add p 1
end
end

note ---------------------------------------------------------------- running the compiler

fn wflush fd int to bool
p = ulong 0
n = get g GWN
while lt p n
w = pwrite fd wit p sub n p long p
if le w 0
ret false
end
p = add p ulong w
end
ret true
end

fn run to ulong
note compile the witness buffer; return the exit code (256 + signal when killed)
fi = int get g GMI
fe = int get g GME
r = ftrunc fi 0
if not wflush fi
ret 255
end
r = fseek fi 0 0
r = ftrunc fe 0
r = fseek fe 0 0
put g GRUN add get g GRUN 1
pid = fork
if eq pid 0
r = dupfd fi 0 0
r = dupfd int get g GDN 1 0
r = dupfd fe 2 0
r = execprog pk 0 get g GPN
exit 127
end
ret reap pid
end

fn reap pid long to ulong
ws = new uchar 4 0
if lt pid 0
ret 255
end
r = waitpid int pid ws 0 4 0
k = pread int get g GME eb 0 8000 0
if lt k 0
k = 0
end
put g GEN ulong k
if ne and get ws 0 127 0
ret add ulong 256 ulong and get ws 0 127
end
ret ulong get ws 1
end

note ---------------------------------------------------------------- witnesses at the hole

fn trys ended bool to bool
note statement witness: prefix, scratch lines, closers, rest
put g GWN 0
wlns 0 get g GHL
wcb
w1 10
wcl get g GD0 ended
wrest
ret eq run 0
end

fn tryv to bool
note value witness: the hole line with ?? replaced by the scratch text; a hole line that is a ret or
note exit already ends its block, so the innermost closer gets no trap (else omc error 17)
put g GWN 0
wlns 0 get g GHL
wholev
h = get g GHL
wcl get g GD1 or lwis h 0 tretw lwis h 0 texitw
wrest
ret eq run 0
end

fn tryblk ended bool to bool
note a block opener in scratch: the witness closes it with its own end
put g GWN 0
wlns 0 get g GHL
wcb
w1 10
if not ended
wt ttrap
end
wt tend
wcl get g GD0 false
wrest
ret eq run 0
end

fn tryend to bool
put g GWN 0
wlns 0 get g GHL
wt tend
d = get g GD0
if gt d 1
wcl sub d 1 false
end
wrest
ret eq run 0
end

fn tryelse to bool
put g GWN 0
wlns 0 get g GHL
cbc
cbt telse
wcb
w1 10
wcl get g GD0 false
wrest
ret eq run 0
end

note ---------------------------------------------------------------- input and the hole

fn rdin to void
n = ulong 0
while lt n 1048000
k = read 0 src n sub ulong 1048000 n
if le k 0
put g GSL n
ret
end
n = add n ulong k
end
put g GSL n
end

fn mklines to void
n = get g GSL
k = ulong 0
s = ulong 0
for p ulong n
if and eq get src p 10 lt k 65535
put lsa k s
put lea k p
k = add k 1
s = add p 1
end
end
if and lt s n lt k 65535
put lsa k s
put lea k n
k = add k 1
end
put g GNL k
end

fn isqq p ulong q ulong to bool
if ne sub q p 2
ret false
end
ret and eq get src p 63 eq get src add p 1 63
end

fn fhole to ulong
note find ?? words; return their count; the first is the hole
c = ulong 0
for i ulong get g GNL
p = skb get lsa i
e = get lea i
while lt p e
q = wde p
if isqq p q
if eq c 0
put g GHL i
put g GHA p
put g GHK 2
if eq skb q e
if eq p skb get lsa i
put g GHK 1
end
end
end
c = add c 1
end
p = skb q
end
end
ret c
end

fn ctx to bool
note enclosing function, open blocks before the hole, the line that closes the function
h = get g GHL
f = h
while true
if lwis f 0 tfn
break
end
if lwis f 0 texport
break
end
if eq f 0
ret false
end
f = sub f 1
end
put g GFL f
put bk 0 1
put bln 0 f
d = ulong 1
i = add f 1
while lt i h
d = ctxl i d
i = add i 1
end
put g GD0 d
put g GD1 d
if and eq get g GHK 2 opener h
put g GD1 add d 1
end
ctxflag d
ret ctxend
end

fn ctxl i ulong d ulong to ulong
note one line of the block scan; return the new depth
if lwis i 0 tkend
if gt d 0
ret sub d 1
end
ret 0
end
if lwis i 0 telse
if gt d 0
put bk sub d 1 3
end
ret d
end
if and opener i lt d 1000
k = ulong 4
if lwis i 0 tif
k = 2
end
if lwis i 0 twhile
k = 5
end
put bk d k
put bln d i
ret add d 1
end
ret d
end

fn ctxflag d ulong to void
put g GLOOP 0
put g GIF 0
for k ulong d
if ge get bk k 4
put g GLOOP 1
end
end
if eq get bk sub d 1 2
put g GIF 1
end
end

fn ctxend to bool
d = get g GD1
i = add get g GHL 1
n = get g GNL
while lt i n
if lwis i 0 tkend
d = sub d 1
if eq d 0
put g GEND i
ret true
end
else
if and opener i ne d 0
d = add d 1
end
end
i = add i 1
end
put g GEND n
ret true
end

note ---------------------------------------------------------------- candidate names

fn addc a ulong n ulong to void
if or eq n 0 gt n 8
ret
end
c = get src a
if not or eq c 95 or and ge c 97 le c 122 and ge c 65 le c 90
ret
end
k = get g GNC
for j ulong k
if eq get cl j n
if seqs get ca j a n
ret
end
end
end
if lt k 500
put ca k a
put cl k n
put ct k 0
put g GNC add k 1
end
end

fn seqs a ulong b ulong n ulong to bool
for i ulong n
if ne get src add a i get src add b i
ret false
end
end
ret true
end

fn gtop to void
note top-level global, const and text names
d = ulong 0
for i ulong get g GNL
if eq d 0
if or lwis i 0 tglobal or lwis i 0 tconst lwis i 0 ttext
a = lnw i 1
addc a sub wde a a
end
end
d = dstep i d
end
end

fn dstep i ulong d ulong to ulong
note block depth after line i, without touching the block stack
if lwis i 0 tkend
if gt d 0
ret sub d 1
end
ret 0
end
if opener i
ret add d 1
end
ret d
end

fn gfn to void
note parameter names of the enclosing fn line (words before `to`)
f = get g GFL
k = ulong 2
if lwis f 0 texport
k = 3
end
while true
a = lnw f k
if ge a get lea f
ret
end
if lwis f k tto
ret
end
addc a sub wde a a
k = add k 1
end
end

fn gloc to void
note names bound before the hole in the enclosing function
i = add get g GFL 1
while lt i get g GHL
if or lwis i 1 teq nmtyped i
a = lnw i 0
addc a sub wde a a
end
if lwis i 0 tfor
a = lnw i 1
addc a sub wde a a
end
i = add i 1
end
end

fn nmtyped i ulong to bool
note NAME TYPE VALUE: the binding without = that omc accepts at the pin; the probes decide
if le get lea i lnw i 2
ret false
end
t = tyof lnw i 1
ret and gt t 0 lt t 12
end

note ---------------------------------------------------------------- probes

fn pscal c ulong to void
note ct: bit 6 visible, low 4 bits the scalar type, bit 4 array, bit 5 writable array
cbc
cbt tq
cbname c
if trys false
for k ulong 11
cbc
cbt tq
cb1 101
cb1 113
cb1 32
cbname c
cb1 32
cbz add k 1
if trys false
put ct c or ulong 64 add k 1
ret
end
end
put ct c 64
ret
end
parr c
end

fn parr c ulong to void
cbc
cbt tq
cbt tlen
cbname c
if not trys false
ret
end
for k ulong 11
cbc
cbt tq
cb1 101
cb1 113
cb1 32
cbt tget
cbname c
cb1 32
cb1 48
cb1 32
cbz add k 1
if trys false
put ct c or ulong 80 add k 1
pwrit c
ret
end
end
put ct c 80
end

fn pwrit c ulong to void
cbc
cbt tput
cbname c
cb1 32
cb1 48
cb1 32
cbt tget
cbname c
cb1 32
cb1 48
if trys false
put ct c or get ct c 32
end
end

note ---------------------------------------------------------------- answer sections

fn ansctx to void
obkey jhole
obopen 123
okv jline get g GHL
obkey jkind
if eq get g GHK 1
obtstr jstmt
else
obtstr jvalue
end
okv jfnl get g GFL
obkey jdepth
obnum get g GD0
obclose 125
end

fn okv t view uchar * v ulong to void
obkey t
obnum add v 1
end

fn ansscope to void
obkey jscope
obopen 91
for c ulong get g GNC
v = get ct c
if ne and v 64 0
obsep
obopen 123
obkey jname
obstr get ca c get cl c
obkey jtype
ob1 34
if ne and v 15 0
obty and v 15
end
if ne and v 16 0
ob1 91
ob1 93
end
ob1 34
put g GSEP 1
if ne and v 32 0
obkey jwr
obt ttrue
put g GSEP 1
end
obclose 125
end
end
obclose 93
end

fn ansfns to void
obkey jfns
obopen 91
for i ulong get g GNL
if or lwis i 0 tfn lwis i 0 texport
a = lnw i 0
obsep
obstr a sub get lea i a
end
end
obclose 93
end

fn emitf to void
note output the scratch text as one checked next form
obsep
obopen 34
obcb
obclose 34
end

fn nstmt to void
note statement hole: every form below is listed only if its witness compiled
cbc
cb1 114
cb1 101
cb1 116
if trys true
cbc
cbt tnote
cbc
cb1 114
cb1 101
cb1 116
emitf
end
for k ulong 11
cbc
cb1 114
cb1 101
cb1 116
cb1 32
cbz add k 1
if trys true
cbc
cbt tglobal
cbc
cbt tnote
cbc
cb1 114
cb1 101
cb1 116
cb1 32
cb1 60
cbty add k 1
cb1 62
emitf
end
end
nassign
nblocks
nputs
ncalls
end

fn nassign to void
for c ulong get g GNC
v = get ct c
if and ne and v 64 0 eq and v 16 0
if ne and v 15 0
cbc
cbname c
cb1 32
cb1 61
cb1 32
cbname c
if trys false
cbc
cbname c
cb1 32
cb1 61
cb1 32
cb1 60
cbty and v 15
cb1 62
emitf
end
end
end
