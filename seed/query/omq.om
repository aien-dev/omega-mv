note ---------------------------------------------------------------- calls

fn fnret i ulong to ulong
note type index of the return of fn line i: 0 unknown or non-scalar, 12 void
k = ulong 1
while true
a = lnw i k
if ge a get lea i
ret 0
end
if lwis i k tto
ret tyof lnw i add k 1
end
k = add k 1
end
ret 0
end

fn tyof a ulong to ulong
e = wde a
if sweq a sub e a tvoid
ret 12
end
for k ulong 11
p = tyat add k 1
q = p
while ne get tys q 32
q = add q 1
end
if tyeq a sub e a p sub q p
ret add k 1
end
end
ret 0
end

fn tyeq a ulong n ulong p ulong m ulong to bool
if ne n m
ret false
end
for i ulong n
if ne get src add a i get tys add p i
ret false
end
end
ret true
end

fn cbcall i ulong to bool
note scratch: the call of fn line i, a typed literal per scalar parameter and the first visible
note array of the element type per array parameter; false when no argument fits a parameter
k = ulong 2
if lwis i 0 texport
k = 3
end
a = lnw i sub k 1
cbc
cbs a sub wde a a
while true
a = lnw i add k 1
if ge a get lea i
ret false
end
if lwis i k tto
ret true
end
m = cbarg i k
if eq m 0
ret false
end
k = add k m
end
ret false
end

fn ismode i ulong k ulong to bool
ret or or lwis i k tview lwis i k tout or lwis i k tedit lwis i k tfresh
end

fn cbarg i ulong k ulong to ulong
note append the argument for the parameter at word k of fn line i; return the words the
note parameter spans (name TYPE, name TYPE LEN, name MODE TYPE LEN), 0 when nothing fits
m = ulong 0
if ismode i add k 1
m = 1
end
t = tyof lnw i add add k 1 m
if or eq t 0 eq t 12
ret 0
end
n = lnw i add add k 2 m
arr = ne m 0
if and lt n get lea i not lwis i add add k 2 m tto
if isarrw n
arr = true
end
end
cb1 32
if not arr
cbz t
ret 2
end
if not cbarr t
ret 0
end
ret add 3 m
end

fn isarrw n ulong to bool
note the word after a parameter's type is a length (digits) or *
c = get src n
ret or eq c 42 and ge c 48 le c 57
end

fn cbarr t ulong to bool
note the GSK-th visible array of element type t (each array parameter takes the same rank)
put g GSA 1
s = get g GSK
for c ulong get g GNC
v = get ct c
if and eq and v 80 80 eq and v 15 t
if eq s 0
cbname c
ret true
end
s = sub s 1
end
end
ret false
end

fn callrk to bool
note step to the next array rank; false when the call has no array parameter or ranks are spent
if eq get g GSA 0
ret false
end
put g GSA 0
put g GSK add get g GSK 1
ret lt get g GSK 4
end

fn ncalls to void
for i ulong get g GNL
if or lwis i 0 tfn lwis i 0 texport
if eq fnret i 12
put g GSK 0
put g GSA 0
while true
if cbcall i
if trys false
emitf
break
end
end
if not callrk
break
end
end
end
end
end
end

