note Exact-source qualification transform. Mode0 exposes the real disp19 through a new main.
note Mode1 weakens the forward limit;mode2 makes close_range unavailable;mode3 admits21-digit numbers.
note No transformed artifact is a production compiler.
global src uchar 262144
global used ulong 1
global mode uchar 8
global needle uchar 64
global repl uchar 64
text entry "fn main to int"
text renamed "fn prev to int"
text limit "gt diff 1048572"
text weak "gt diff 1048580"
text seal "hsys 436"
text noseal "hsys 999"
text digits "if gt ndig 20"
text longer "if gt ndig 21"
text filter "hsys 277"
text fence "hsys 446"
text bypass "hsys 172"
text probe "\nfn main to int\nn = read 0 msg 0 1\nif ne n 1\nret 90\nend\nm = get msg 0\na = ulong 0\nt = ulong 0\ne = ulong 0\nif eq m 0\nt = ulong 1048572\ne = ulong 262143\nend\nif eq m 1\na = ulong 1048576\ne = ulong 262144\nend\nif eq m 2\na = ulong 1024\ne = ulong 524032\nend\nif eq m 3\na = ulong 1028\ne = ulong 524031\nend\nif eq m 4\nt = ulong 1048576\nend\nif eq m 5\na = ulong 1048580\nend\nif eq m 6\nt = ulong 2\nend\nif eq m 7\na = ulong 2\nend\nv = disp19 a t\nif ge m 4\nret 81\nend\nif ne v e\nret 82\nend\nret 0\nend\n"
fn matches i ulong to bool
for j ulong get used 0
if ne get src add i j get needle j
ret false
end
end
ret true
end
fn replace i ulong to void
for j ulong get used 0
put src add i j get repl j
end
end
fn main to int
if ne argcnt 2
ret 90
end
r = argread 1 mode 0 len mode
if ne r 1
ret 90
end
m = get mode 0
if or lt m 48 gt m 53
ret 90
end
if eq m 48
put used 0 len entry
for i ulong len entry
put needle i get entry i
put repl i get renamed i
end
end
if eq m 49
put used 0 len limit
for i ulong len limit
put needle i get limit i
put repl i get weak i
end
end
if eq m 50
put used 0 len seal
for i ulong len seal
put needle i get seal i
put repl i get noseal i
end
end
if eq m 51
put used 0 len digits
for i ulong len digits
put needle i get digits i
put repl i get longer i
end
end
if eq m 52
put used 0 len filter
for i ulong len filter
put needle i get filter i
put repl i get bypass i
end
end
if eq m 53
put used 0 len fence
for i ulong len fence
put needle i get fence i
put repl i get bypass i
end
end
n = ulong 0
go = true
while go
if eq n len src
ret 91
end
r = read 0 src n sub len src n
if lt r 0
ret 92
end
if eq r 0
go = false
else
n = add n ulong r
end
end
found = ulong 0
for i ulong n
if le get used 0 sub n i
if matches i
found = add found 1
replace i
end
end
end
if ne found 1
ret 93
end
p = ulong 0
while lt p n
r = write 1 src p sub n p
if le r 0
ret 94
end
p = add p ulong r
end
if eq m 48
p = ulong 0
while lt p len probe
r = write 1 probe p sub len probe p
if le r 0
ret 94
end
p = add p ulong r
end
end
ret 0
end
