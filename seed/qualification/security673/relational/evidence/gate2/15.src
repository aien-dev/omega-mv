note SPDX-License-Identifier: Apache-2.0
fn early a view uchar 32 b view uchar 32 to ulong
for i ulong 32
if ne get a i get b i
ret 0
end
end
ret 1
end
note SPDX-License-Identifier: Apache-2.0
fn main to int
a = new uchar 32 0
b = new uchar 32 0
put b 0 uchar sub ulong argcnt 1
ret int early a b
end
