note SPDX-License-Identifier: Apache-2.0
note seed/qualification/om2/leak/leakscan.om: static leakage scan of one omc FUNCTION-MODE artifact
note (raw little-endian AArch64 words, entry word 0), contract spec/omegese-om2.md section 8, evidence (a)
note (#748, ledger L836). Handwritten seeded Omega, OM-1, program mode, built by the pinned omc 734f0a39.
note README.txt in this directory states the decode subset, the taint rules, the call rule and what is
note MANUAL. The scan is a may-analysis: "data" means "may depend on data", never "proved to leak".
note
note Usage: leakscan [xN | pub:SLOT:OFF:LEN ...] < artifact. xN marks DATA (N 0..5).
note pub declares public memory relative to entry xSLOT, fully contained in the half-open byte range.
note Output, in this order: one LEAKSCAN line; per word, in word order, UNKNOWN, UNHANDLED, BRANCH and MEM
note lines; one SUMMARY line; MANUAL-ITEMS when needed; one VERDICT line.
note Exit status: 0 PASS, 1 FAIL (data address), 2 NOT_RUN (MANUAL), 90 usage, 91 invalid artifact.
note
note Taint state per word (the state on entry to the word): rm bit b is 1 when the value may be DATA;
note bits 0..30 x0..x30, bit 31 the NZCV flags, bits 32..63 v0..v31. sm bit j is 1 when the 8 bytes
note at [SP + 8j] (current SP) may hold DATA. dep is the bytes the SP is below the function's entry SP,
note plus 1 (0: never reached). fid is the function's entry word.
global inb uchar 8388612
global wd uint 2097152
global rm ulong 2097152
global sm ulong 2097152
global dep ulong 2097152
global fid ulong 2097152
global ex ulong 2097152
global exs uchar 2097152
global blt ulong 2097152
global trp uchar 2097152
global uh uchar 2097152
global inq uchar 2097152
global wl ulong 2097152
global dc ulong 24
global cu ulong 4
global gv ulong 32
global ob uchar 1048576
global obn ulong 1
global dig uchar 32
global tbo ulong 128
global tbl ulong 128
global ab uchar 16
global pab uchar 128
note Exact provenance and E12 known-zero bits, allocated for reached words.
note Tokens: tag:8 | signed-offset:56; tag 1 constant, tags 2..7 entry x0..x5 + offset, 0 unknown.
note ps/pe point into pp (128 cells: 31 regs, AND-proof mask, 64 spill slots, 32 known-zero masks).
note At most 131072 records; exhaustion is UNHANDLED provenance-cap and forces NOT_RUN.
global pp ulong 16777216
global ps ulong 2097152
global pe ulong 2097152
global pc ulong 128
global pdecl ulong 96
note E13 whole-artifact revocation: rv[word] lists the public-range bits revoked by that store.
global rv ulong 2097152
text revmsg "PUBLIC-MEM-REVOKED @"
text pmsg "PUBLIC-DECL \nPUBLIC-MEM @\n public-mem \n+\n:\nprovenance-cap\nusage: leakscan [x0..x5 | pub:SLOT:OFF:LEN ...] < function-mode artifact\n"
text e12 "data MANUAL\nVERDICT TRACE-EQUIV-STATIC NOT_RUN\n"
note decoded fields, indices into dc
const dkind ulong 0
const dtgt ulong 1
const ddst ulong 2
const ds1 ulong 3
const ds2 ulong 4
const ds3 ulong 5
const dfl ulong 6
const dmk ulong 7
const dmb ulong 8
const dmi ulong 9
const dmo ulong 10
const dms ulong 11
const dmt ulong 12
const dmt2 ulong 13
const dwb ulong 14
const dmn ulong 15
const dcc ulong 16
const dspo ulong 17
const dspa ulong 18
const dmf ulong 19
note gv: 0 words, 1 worklist size, 2 entry word, 3 DATA parameter bits, 4 len branches, 5 trap checks,
note 6 data branches, 7 unreached branches, 8 const, 9 public-index, 10 data-index, 11 unreached memory,
note 12 unknown, 13 unhandled, 14 branches, 15 memory accesses, 16 word 0 is the entry branch
text tb "b\nbl\ncbz\ncbnz\ntbz\ntbnz\nret\nbr\nblr\nsvc\nldrb\nldrsb\nldrh\nldrsh\nldr\nldrsw\nstrb\nstrh\nstr\nldp\nstp\nldpsw\n?\nnop\ndsb\nb.eq\nb.ne\nb.cs\nb.cc\nb.mi\nb.pl\nb.vs\nb.vc\nb.hi\nb.ls\nb.ge\nb.lt\nb.gt\nb.le\nb.al\nb.nv\nLEAKSCAN 1 words=\n entry=@\n data=\nnone\nUNKNOWN @\nUNHANDLED @\nBRANCH @\nMEM @\n ->@\nlen\ndata never-taken-trap-check\ndata DATA-BRANCH\nunreached\nconst\npublic-index\ndata-index\n trap=\n base=\n index=\nsp\n-\n trap-tail\nSUMMARY branches=\n len=\n trap-check=\n data-branch=\n branch-unreached=\n mem=\n const=\n public-index=\n data-index=\n mem-unreached=\n unknown=\n unhandled=\nVERDICT TRACE-EQUIV-STATIC PASS\nVERDICT TRACE-EQUIV-STATIC FAIL\nVERDICT TRACE-EQUIV-STATIC MANUAL\n 0x\nusage: leakscan [x0..x5 ...] < function-mode artifact\nleakscan: input is not a function-mode artifact: empty, not whole words, ELF, or over 8 MiB\nimm\nreg\nunscaled\npost\npre\npair\nliteral\nunpriv\n?\nsp-write\nsp-writeback\nstack-escape\ndepth-mismatch\nshared-code\nret-depth\nret-x30-data\nbr-indirect\nblr-indirect\nsvc-syscall\nflow-out\nsp-underflow\nx7-write\nbelow-sp\n \nMANUAL-ITEMS \n listed above as UNKNOWN and UNHANDLED lines\n always\nx\n,\n"

note ---- output ----------------------------------------------------------------------------------
fn inittb to void
k = ulong 0
s = ulong 0
for i ulong len tb
if eq get tb i 10
put tbo k s
put tbl k sub i s
k = add k 1
s = add i 1
end
end
end
fn obf to void
n = get obn 0
o = ulong 0
while lt o n
r = write 1 ob o sub n o
if le r 0
exit 93
end
o = add o ulong r
end
put obn 0 0
end
fn ob1 b uchar to void
n = get obn 0
if ge n 1048000
obf
n = ulong 0
end
put ob n b
put obn 0 add n 1
end
fn say id ulong to void
o = get tbo id
for i ulong get tbl id
ob1 get tb add o i
end
end
fn onl to void
ob1 10
end
fn od v ulong to void
x = v
n = ulong 0
while ge x 10
put dig n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
put dig n uchar add 48 x
n = add n 1
for i ulong n
ob1 get dig sub sub n i 1
end
end
fn hexd v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end
fn oh v ulong to void
for i ulong 8
ob1 hexd and shr v mul sub 7 i 4 15
end
end
note a register field: 255 "-", 31 "sp" (a base), else xN
fn oreg r ulong to void
if eq r 255
say 61
ret
end
if eq r 31
say 60
ret
end
say 108
od r
end
fn inc k ulong to void
put gv k add get gv k 1
end

note ---- bit helpers -----------------------------------------------------------------------------
fn fld x ulong lo ulong n ulong to ulong
ret and shr x lo sub shl ulong 1 n 1
end
note a general register field where 31 is the zero register (public, no state bit)
fn gz r ulong to ulong
if eq r 31
ret 255
end
ret r
end
note sign extension of an n-bit field to 64 bits (two's complement in a ulong)
fn sx v ulong n ulong to ulong
if eq and shr v sub n 1 1 0
ret v
end
ret or v not sub shl ulong 1 n 1
end
fn tnt r ulong b ulong to ulong
if ge b 64
ret 0
end
ret and shr r b 1
end
fn sbit r ulong b ulong v ulong to ulong
if ge b 64
ret r
end
m = shl ulong 1 b
if eq v 0
ret and r not m
end
ret or r m
end

note ---- decoder: the classes omc emits (README.txt lists them with their omc.om sources) ---------
fn dclr to void
for i ulong 24
put dc i 255
end
put dc dkind 0
put dc dfl 0
put dc dmk 0
put dc dwb 0
put dc dmn 22
put dc dspo 0
put dc dspa 0
put dc dmf 0
put dc dtgt 0
put dc dmo 0
put dc dms 0
end
note kinds: 0 straight-line, 1 B, 2 BL, 3 B.cond, 4 CBZ/CBNZ, 5 TBZ/TBNZ, 6 RET, 7 BR, 8 BLR, 9 SVC,
note 10 unknown, 11 no effect (NOP, DSB)
fn dbr x ulong w ulong to bool
m = and x 4227858432
if eq m 335544320
put dc dkind 1
put dc dtgt add w sx and x 67108863 26
put dc dmn 0
ret true
end
if eq m 2483027968
put dc dkind 2
put dc dtgt add w sx and x 67108863 26
put dc dmn 1
ret true
end
if eq and x 4278190096 1409286144
put dc dkind 3
put dc dtgt add w sx fld x 5 19 19
put dc dcc and x 15
put dc dmn add 25 and x 15
ret true
end
m = and x 2113929216
if eq m 872415232
put dc dkind 4
put dc dtgt add w sx fld x 5 19 19
put dc ds1 gz and x 31
put dc dmn add 2 fld x 24 1
ret true
end
if eq m 905969664
put dc dkind 5
put dc dtgt add w sx fld x 5 14 14
put dc ds1 gz and x 31
put dc dcc or shl fld x 31 1 5 fld x 19 5
put dc dmn add 4 fld x 24 1
ret true
end
m = and x 4294966303
if eq m 3592355840
put dc dkind 7
put dc ds1 fld x 5 5
put dc dmn 7
ret true
end
if eq m 3594452992
put dc dkind 8
put dc ds1 fld x 5 5
put dc dmn 8
ret true
end
if eq m 3596550144
put dc dkind 6
put dc ds1 fld x 5 5
put dc dmn 6
ret true
end
if eq and x 4292870175 3556769793
put dc dkind 9
put dc dmn 9
ret true
end
if eq x 3573751839
put dc dkind 11
put dc dmn 23
ret true
end
if eq and x 4294963455 3573756063
put dc dkind 11
put dc dmn 24
ret true
end
ret false
end

note ADD/SUB (immediate): Rn 31 is SP; Rd 31 is SP unless flags are set (then the zero register)
fn daddi x ulong to void
rd = and x 31
rn = fld x 5 5
if eq fld x 29 1 1
put dc ddst gz rd
put dc ds1 gz rn
put dc dfl 2
ret
end
if eq rd 31
if eq rn 31
put dc dspo add 1 fld x 30 1
put dc dspa shl fld x 10 12 mul fld x 22 1 12
ret
end
put dc dspo 3
ret
end
put dc ddst rd
put dc ds1 gz rn
end
fn dlogi x ulong to void
rd = and x 31
if eq fld x 29 2 3
put dc dfl 2
put dc ddst gz rd
else
if eq rd 31
put dc dspo 3
ret
end
put dc ddst rd
end
put dc ds1 gz fld x 5 5
end
fn dmovw x ulong to bool
opc = fld x 29 2
if eq opc 1
ret false
end
put dc ddst gz and x 31
if eq opc 3
put dc dfl 4
end
ret true
end
fn dbfm x ulong to bool
opc = fld x 29 2
if eq opc 3
ret false
end
put dc ddst gz and x 31
put dc ds1 gz fld x 5 5
if eq opc 1
put dc dfl 4
end
ret true
end
note three-register forms: Rd, Rn, Rm (31 the zero register); fl as given
fn d3r x ulong fl ulong to void
put dc ddst gz and x 31
put dc ds1 gz fld x 5 5
put dc ds2 gz fld x 16 5
put dc dfl fl
end
note ADD/SUB (extended register): Rn 31 is SP (public); Rd 31 is SP unless flags are set
fn daddx x ulong to void
rd = and x 31
s = fld x 29 1
if eq s 1
put dc ddst gz rd
put dc dfl 2
else
if eq rd 31
put dc dspo 3
ret
end
put dc ddst rd
end
put dc ds1 gz fld x 5 5
put dc ds2 gz fld x 16 5
end
fn dalu x ulong to bool
m = and x 528482304
if eq m 285212672
daddi x
ret true
end
if eq m 301989888
dlogi x
ret true
end
if eq m 310378496
ret dmovw x
end
if eq m 318767104
ret dbfm x
end
if eq m 327155712
if or ne fld x 29 2 0 ne fld x 21 1 0
ret false
end
d3r x 0
ret true
end
if eq and x 520093696 268435456
put dc ddst gz and x 31
ret true
end
if eq and x 520093696 167772160
if eq fld x 29 2 3
d3r x 2
else
d3r x 0
end
ret true
end
m = and x 522190848
if eq m 184549376
d3r x shl fld x 29 1 1
ret true
end
if eq m 186646528
daddx x
ret true
end
m = and x 534773760
if eq m 436207616
if ne fld x 10 6 0
ret false
end
d3r x or 1 shl fld x 29 1 1
ret true
end
if eq m 440401920
if eq fld x 29 1 0
ret false
end
put dc ds1 gz fld x 5 5
if eq fld x 11 1 0
put dc ds2 gz fld x 16 5
end
put dc dfl 3
ret true
end
if eq m 444596224
if or ne fld x 29 1 0 ne fld x 11 1 0
ret false
end
d3r x 1
ret true
end
m = and x 1608515584
if eq m 448790528
d3r x 0
ret true
end
if eq m 1522532352
put dc ddst gz and x 31
put dc ds1 gz fld x 5 5
ret true
end
if eq and x 520093696 452984832
d3r x 0
put dc ds3 gz fld x 10 5
ret true
end
ret false
end
note allocation checks (Arm ARM C4.1): an encoding of a decoded class that is unallocated, reserved
note or outside the subset is UNKNOWN. bmok: the logical-immediate bitmask (DecodeBitMasks) is valid.
fn bmok x ulong to bool
n = fld x 22 1
s = fld x 10 6
if and eq fld x 31 1 0 eq n 1
ret false
end
v = or shl n 6 and not s 63
if eq v 0
ret false
end
l = ulong 6
while eq and shr v l 1 0 bound 8
l = sub l 1
end
if eq l 0
ret false
end
lv = sub shl ulong 1 l 1
ret ne and s lv lv
end
fn dp3ok x ulong sf ulong to bool
if ne fld x 29 2 0
ret false
end
o = fld x 21 3
if eq o 0
ret true
end
if eq sf 0
ret false
end
if or eq o 1 eq o 5
ret true
end
if or eq o 2 eq o 6
ret eq fld x 15 1 0
end
ret false
end
fn aluok x ulong to bool
sf = fld x 31 1
m = and x 528482304
if eq m 301989888
ret bmok x
end
if eq m 310378496
ret or eq sf 1 eq fld x 22 1 0
end
if or eq m 318767104 eq m 327155712
if ne fld x 22 1 sf
ret false
end
if and eq sf 0 eq m 318767104
ret and eq fld x 21 1 0 eq fld x 15 1 0
end
ret or eq sf 1 eq fld x 15 1 0
end
if eq and x 520093696 167772160
ret or eq sf 1 eq fld x 15 1 0
end
m = and x 522190848
if eq m 184549376
if eq fld x 22 2 3
ret false
end
ret or eq sf 1 eq fld x 15 1 0
end
if eq m 186646528
if ne fld x 22 2 0
ret false
end
ret le fld x 10 3 4
end
if eq and x 534773760 440401920
ret and eq fld x 10 1 0 eq fld x 4 1 0
end
m = and x 1608515584
if eq m 448790528
if ne fld x 29 1 0
ret false
end
o = fld x 10 6
ret or or eq o 2 eq o 3 and ge o 8 le o 11
end
if eq m 1522532352
o = fld x 10 6
if or gt o 5 ne fld x 16 5 0
ret false
end
ret or eq sf 1 ne o 3
end
if eq and x 520093696 452984832
ret dp3ok x sf
end
ret true
end
fn fpok x ulong to bool
ty = fld x 22 2
if gt ty 1
ret false
end
if eq and x 1595997184 505413632
op = fld x 16 3
if le op 1
ret true
end
if ne fld x 19 2 0
ret false
end
if le op 5
ret true
end
ret eq fld x 31 1 ty
end
if eq and x 1595964416 505430016
op = fld x 15 6
if le op 3
ret true
end
if or eq op 4 eq op 5
ret ne sub op 4 ty
end
ret false
end
if eq and x 1595948032 505421824
ret and eq fld x 14 2 0 eq and x 7 0
end
ret le fld x 12 4 8
end
note constrained-unpredictable load/store forms omc never emits: writeback with Rt or Rt2 = Rn, and a
note load pair with Rt = Rt2
fn lsok to bool
b = get dc dmb
if and ne get dc dwb 0 ne b 31
if or eq get dc dmt b eq get dc dmt2 b
ret false
end
end
if and eq get dc dmk 1 ne get dc dmt2 255
ret ne get dc dmt get dc dmt2
end
ret true
end
note scalar floating point: FMOV/convert (general <-> FP), 1-source, compare, 2-source
fn dfp x ulong to bool
if ne fld x 29 2 0
ret false
end
rd = and x 31
rn = fld x 5 5
if eq and x 1595997184 505413632
op = fld x 16 3
if or or eq op 2 eq op 3 eq op 7
put dc ddst add 32 rd
put dc ds1 gz rn
else
put dc ddst gz rd
put dc ds1 add 32 rn
end
ret true
end
if ne fld x 31 1 0
ret false
end
if eq and x 1595964416 505430016
put dc ddst add 32 rd
put dc ds1 add 32 rn
ret true
end
if eq and x 1595948032 505421824
put dc ds1 add 32 rn
if eq fld x 3 1 0
put dc ds2 add 32 fld x 16 5
end
put dc dfl 2
ret true
end
if eq and x 1595935744 505415680
put dc ddst add 32 rd
put dc ds1 add 32 rn
put dc ds2 add 32 fld x 16 5
ret true
end
ret false
end

note load/store kind, size and mnemonic from size, V and opc; false for PRFM and unallocated forms
fn lsk sz ulong v ulong opc ulong rt ulong to bool
if eq v 1
b = shl ulong 1 sz
if ne and opc 2 0
if ne sz 0
ret false
end
b = ulong 16
end
put dc dms b
put dc dmt add 32 rt
if eq and opc 1 1
put dc dmk 1
put dc dmn 14
else
put dc dmk 2
put dc dmn 18
end
ret true
end
put dc dms shl ulong 1 sz
put dc dmt gz rt
k = sz
if gt k 2
k = ulong 2
end
if eq opc 0
put dc dmk 2
put dc dmn add 16 k
ret true
end
put dc dmk 1
if eq opc 1
put dc dmn add 10 mul k 2
ret true
end
if eq opc 2
if eq sz 3
ret false
end
put dc dmn add 11 mul k 2
ret true
end
if ge sz 2
ret false
end
put dc dmn add 11 mul k 2
ret true
end
fn dpair x ulong to bool
v = fld x 26 1
opc = fld x 30 2
l = fld x 22 1
es = ulong 0
if eq v 0
if eq opc 0
es = ulong 4
end
if eq opc 2
es = ulong 8
end
if and and eq opc 1 eq l 1 ne fld x 23 2 0
es = ulong 4
end
put dc dmt gz and x 31
put dc dmt2 gz fld x 10 5
else
if lt opc 3
es = shl ulong 4 opc
end
put dc dmt add 32 and x 31
put dc dmt2 add 32 fld x 10 5
end
if eq es 0
ret false
end
put dc dms es
put dc dmf 6
if eq l 1
put dc dmk 1
put dc dmn 19
if and eq v 0 eq opc 1
put dc dmn 21
end
else
put dc dmk 2
put dc dmn 20
end
put dc dmb fld x 5 5
ty = fld x 23 2
off = mul sx fld x 15 7 7 es
if ne ty 1
put dc dmo off
end
if or eq ty 1 eq ty 3
put dc dwb 1
put dc dspa off
end
ret true
end
note the immediate (unscaled / pre / post / unprivileged) forms by bits 11..10: 3 unscaled, 4 post,
note 8 unprivileged, 5 pre
fn uform ty ulong to ulong
if eq ty 0
ret 3
end
if eq ty 1
ret 4
end
if eq ty 2
ret 8
end
ret 5
end
fn dls x ulong to bool
sz = fld x 30 2
v = fld x 26 1
opc = fld x 22 2
rt = and x 31
if eq and x 989855744 956301312
if not lsk sz v opc rt
ret false
end
sc = sz
if and eq v 1 ne and opc 2 0
sc = ulong 4
end
put dc dmf 1
put dc dmb fld x 5 5
put dc dmo shl fld x 10 12 sc
ret true
end
if eq and x 991955968 941623296
if eq fld x 14 1 0
ret false
end
if not lsk sz v opc rt
ret false
end
put dc dmf 2
put dc dmb fld x 5 5
put dc dmi gz fld x 16 5
ret true
end
if eq and x 991952896 939524096
if not lsk sz v opc rt
ret false
end
ty = fld x 10 2
im = sx fld x 12 9 9
put dc dmb fld x 5 5
if and eq v 1 eq ty 2
ret false
end
put dc dmf uform ty
if ne ty 1
put dc dmo im
end
if or eq ty 1 eq ty 3
put dc dwb 1
put dc dspa im
end
ret true
end
if eq and x 973078528 671088640
ret dpair x
end
if eq and x 989855744 402653184
o2 = fld x 30 2
if eq o2 3
ret false
end
put dc dmk 3
put dc dmf 7
put dc dmn 14
if eq v 1
put dc dmt add 32 rt
else
put dc dmt gz rt
if eq o2 2
put dc dmn 15
end
end
ret true
end
ret false
end
fn dec x ulong w ulong to void
dclr
if dbr x w
ret
end
if dls x
if lsok
ret
end
end
dclr
if dalu x
if aluok x
ret
end
end
dclr
if dfp x
if fpok x
ret
end
end
dclr
put dc dkind 10
put dc dmn 22
end

note ---- dataflow ----------------------------------------------------------------------------------
fn unh w ulong k ulong to void
if eq get uh w 0
put uh w uchar k
end
end
fn push u ulong to void
if eq get inq u 0
put inq u 1
n = get gv 1
put wl n u
put gv 1 add n 1
end
end
note join the current state cu into word u
fn join u ulong to void
dd = add get cu 2 1
if eq get dep u 0
put rm u get cu 0
put sm u get cu 1
put dep u dd
put fid u get cu 3
push u
pjoin u true
ret
end
if ne get dep u dd
unh u 4
ret
end
if ne get fid u get cu 3
unh u 5
ret
end
a = or get rm u get cu 0
b = or get sm u get cu 1
if or ne a get rm u ne b get sm u
put rm u a
put sm u b
push u
end
pjoin u false
end
note an edge from w to u: outside the artifact is unhandled; into the trap stubs it ends the path
fn flow w ulong u ulong to void
if ge u get gv 0
unh w 11
ret
end
if ne get trp u 0
ret
end
join u
end
fn talu to void
r = get cu 0
t = or or tnt r get dc ds1 tnt r get dc ds2 tnt r get dc ds3
fl = get dc dfl
if ne and fl 1 0
t = or t tnt r 31
end
if ne and fl 4 0
t = or t tnt r get dc ddst
end
if ne and fl 2 0
r = sbit r 31 t
end
put cu 0 sbit r get dc ddst t
end
note SP arithmetic: k = bytes / 8 slots shift; the slots that come into view are unknown (DATA)
fn tsp w ulong to void
k = get dc dspo
if eq k 3
unh w 1
ret
end
a = get dc dspa
d = get cu 2
s = get cu 1
q = div a 8
all = not ulong 0
if ne rem a 8 0
q = ulong 64
end
if eq k 1
if gt a d
unh w 12
