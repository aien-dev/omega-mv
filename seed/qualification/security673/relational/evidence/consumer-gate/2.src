fn dseqhash s view uchar 65536 p ulong h view uchar 32 to ulong
for k ulong 32
if ne get h k get s add p k
ret 0
end
end
ret 1
end
note SPDX-License-Identifier: Apache-2.0
note Audit-only driver for byte-exact dseqhash excerpt, never linked into omnet.
fn main to int
s = new uchar 65536 0
h = new uchar 32 0
put h 0 uchar sub ulong argcnt 1
ret int dseqhash s 0 h
end
