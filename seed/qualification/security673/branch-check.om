note Consume independently decoded GNU objdump output, not machine words from the compiler.
note Exit61 target mismatch;62 invalid input. Only the first b.ne and unique mov marker are selected.
global linebuf uchar 512
global chunk uchar 4096
global cursor ulong 1
global branch ulong 1
global marker ulong 1
global bcount ulong 1
global mcount ulong 1
text mn "b.ne"
text label "mov\tx1, #0x3039"
fn hexval b uchar to ulong
if and ge b 48 le b 57
ret sub ulong b 48
end
if and ge b 97 le b 102
ret add sub ulong b 97 10
end
ret 16
end
fn number start ulong n ulong to ulong
p = start
value = ulong 0
while lt p n
v = hexval get linebuf p
if eq v 16
if eq p start
exit 62
end
put cursor 0 p
ret value
end
if ge sub p start 16
exit 62
end
value = or shl value 4 v
p = add p 1
end
if eq p start
exit 62
end
put cursor 0 p
ret value
end
fn hasmn i ulong n ulong to bool
if or eq i 0 ge add i len mn n
ret false
end
if and ne get linebuf sub i 1 9 ne get linebuf sub i 1 32
ret false
end
for j ulong len mn
if ne get linebuf add i j get mn j
ret false
end
end
v = get linebuf add i len mn
ret or eq v 9 eq v 32
end
fn hasmark i ulong n ulong to bool
if or eq i 0 gt add i len label n
ret false
end
if and ne get linebuf sub i 1 9 ne get linebuf sub i 1 32
ret false
end
for j ulong len label
if ne get linebuf add i j get label j
ret false
end
end
if lt add i len label n
v = get linebuf add i len label
if and ne v 32 ne v 9
ret false
end
end
ret true
end
fn target i ulong n ulong to ulong
p = add i len mn
while lt p n
v = get linebuf p
if and ne v 32 ne v 9
if gt add p 2 n
exit 62
end
if or ne v 48 ne get linebuf add p 1 120
exit 62
end
value = number add p 2 n
q = get cursor 0
if lt q n
v = get linebuf q
if and ne v 32 ne v 9
exit 62
end
end
ret value
end
p = add p 1
end
exit 62
end
fn inspect n ulong to void
p = ulong 0
while lt p n
if ne get linebuf p 32
if eq hexval get linebuf p 16
ret
end
addr = number p n
q = get cursor 0
if ge q n
ret
end
if or ne get linebuf q 58 lt addr 176
ret
end
for i ulong n
if eq get bcount 0 0
if hasmn i n
put branch 0 target i n
put bcount 0 1
end
end
if hasmark i n
put marker 0 addr
put mcount 0 add get mcount 0 1
end
end
ret
end
p = add p 1
end
end
fn main to int
n = ulong 0
go = true
while go
r = read 0 chunk 0 len chunk
if lt r 0
ret 62
end
if eq r 0
go = false
else
for k ulong ulong r
if eq get chunk k 10
inspect n
n = ulong 0
else
if ge n len linebuf
ret 62
end
put linebuf n get chunk k
n = add n 1
end
end
end
end
if ne n 0
inspect n
end
if or ne get bcount 0 1 ne get mcount 0 1
ret 62
end
if ne get branch 0 get marker 0
ret 61
end
ret 0
end
