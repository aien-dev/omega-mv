note Consume independently decoded GNU objdump output, not machine words from the compiler.
note Exit61 target mismatch;62 invalid input;90 usage. Only the first branch mnemonic and unique mov marker
note are selected: with no argument the first b.ne and mov x1, 12345 (forward corpus modes 0..3); with
note argument 1 the first b.al and mov x4, 12345 (mode4, the backward continue to the loop head).
global linebuf uchar 512
global chunk uchar 4096
global cursor ulong 1
global branch ulong 1
global marker ulong 1
global bcount ulong 1
global mcount ulong 1
global form uchar 8
global mn uchar 8
global mnl ulong 1
global label uchar 32
global labl ulong 1
text mnf "b.ne"
text labf "mov\tx1, #0x3039"
text mnb "b.al"
text labb "mov\tx4, #0x3039"
fn hexval b uchar to ulong
if and ge b 48 le b 57
ret sub ulong b 48
end
if and ge b 97 le b 102
ret add sub ulong b 97 10
end
ret 16
end
fn number start ulong n ulong to ulong
p = start
value = ulong 0
while lt p n
v = hexval get linebuf p
if eq v 16
if eq p start
exit 62
end
put cursor 0 p
ret value
end
if ge sub p start 16
exit 62
end
value = or shl value 4 v
p = add p 1
end
if eq p start
exit 62
end
put cursor 0 p
ret value
end
fn hasmn i ulong n ulong to bool
if or eq i 0 ge add i get mnl 0 n
ret false
end
if and ne get linebuf sub i 1 9 ne get linebuf sub i 1 32
ret false
end
for j ulong get mnl 0
if ne get linebuf add i j get mn j
ret false
end
end
v = get linebuf add i get mnl 0
ret or eq v 9 eq v 32
end
fn hasmark i ulong n ulong to bool
if or eq i 0 gt add i get labl 0 n
ret false
end
if and ne get linebuf sub i 1 9 ne get linebuf sub i 1 32
ret false
end
for j ulong get labl 0
if ne get linebuf add i j get label j
ret false
end
end
if lt add i get labl 0 n
v = get linebuf add i get labl 0
if and ne v 32 ne v 9
ret false
end
end
ret true
end
fn target i ulong n ulong to ulong
p = add i get mnl 0
while lt p n
v = get linebuf p
if and ne v 32 ne v 9
if gt add p 2 n
exit 62
end
if or ne v 48 ne get linebuf add p 1 120
exit 62
end
value = number add p 2 n
q = get cursor 0
if lt q n
v = get linebuf q
if and ne v 32 ne v 9
exit 62
end
end
ret value
end
p = add p 1
end
exit 62
end
fn inspect n ulong to void
p = ulong 0
while lt p n
if ne get linebuf p 32
if eq hexval get linebuf p 16
ret
end
addr = number p n
q = get cursor 0
if ge q n
ret
end
if or ne get linebuf q 58 lt addr 176
ret
end
for i ulong n
if eq get bcount 0 0
if hasmn i n
put branch 0 target i n
put bcount 0 1
end
end
if hasmark i n
put marker 0 addr
put mcount 0 add get mcount 0 1
end
end
ret
end
p = add p 1
end
end
fn main to int
back = false
if eq argcnt 2
r = argread 1 form 0 len form
if or ne r 1 ne get form 0 49
ret 90
end
back = true
else
if ne argcnt 1
ret 90
end
end
if back
put mnl 0 len mnb
for j ulong len mnb
put mn j get mnb j
end
put labl 0 len labb
for j ulong len labb
put label j get labb j
end
else
put mnl 0 len mnf
for j ulong len mnf
put mn j get mnf j
end
put labl 0 len labf
for j ulong len labf
put label j get labf j
end
end
n = ulong 0
go = true
while go
r = read 0 chunk 0 len chunk
if lt r 0
ret 62
end
if eq r 0
go = false
else
for k ulong ulong r
if eq get chunk k 10
inspect n
n = ulong 0
else
if ge n len linebuf
ret 62
end
put linebuf n get chunk k
n = add n 1
end
end
end
end
if ne n 0
inspect n
end
if or ne get bcount 0 1 ne get mcount 0 1
ret 62
end
if ne get branch 0 get marker 0
ret 61
end
ret 0
end
