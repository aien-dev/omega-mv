note SC1-G-v3 frozen fixture IDs, compiled into the checker and used by witnesses.
note 0 initial,1 losing,2 early,3 stale,4 uncertain,5 eager,6 serialized,7 final,8 BAD.
fn fixture id uint to uint
if eq id 0
ret 0
end
if eq id 1
ret 15
end
if eq id 2
ret 16
end
if eq id 3
ret 331
end
if eq id 4
ret 11
end
if eq id 5
ret 20
end
if eq id 6
ret 32
end
if eq id 7
ret 266
end
if eq id 8
ret 2592
end
exit 90
end
