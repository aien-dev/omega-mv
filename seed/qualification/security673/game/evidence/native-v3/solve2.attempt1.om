best = uint 18
price = uint 99
for u uint 18
if ne and m shl uint 1 u 0
p = uint 2
if lt u 2
p = 1
else
k = rem sub u 2 8
if eq k 7
p = 0
end
if eq k 1
p = 4
end
end
if lt p price
price = p
best = u
end
end
end
ret best
end
fn selections to void
for s uint 2593
put chosen s select s 1
end
end
fn output to void
sendword 1396912455
sendword 3
sendword 2593
sendword get mut 0
for s uint 2593
