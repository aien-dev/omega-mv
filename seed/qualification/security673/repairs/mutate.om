note SPDX-License-Identifier: Apache-2.0
note SC1 qualification-only exact-source mutations for corrected authority gates.
note Modes 0 read-before-lock, 1 trailing record accepted, 2 unlink error hidden, 3 close omitted.
note Refuse unexpected source multiplicity before emitting any artifact. Never a production compiler.
global src uchar 262144
global arg uchar 8
global nd uchar 512
global rp uchar 512
global lens ulong 3
text n0 "err = lacq get dpid 0 1000\nif ne err 0\nret 80\nend\nerr = readrec r\nif ne err 0\nlk = lrel\nret 70\nend\n"
text r0 "err = readrec r\nif ne err 0\nret 70\nend\nerr = lacq get dpid 0 1000\nif ne err 0\nret 80\nend\n"
text n1 "if or ne n 256 ne extra 0\n"
text r1 "if ne n 256\n"
text n2 "fn lrm to ulong\nr = unlink lpath 0 len lpath\nif lt r 0\nret 41\n"
text r2 "fn lrm to ulong\nr = unlink lpath 0 len lpath\nif lt r 0\nret 0\n"
text n3 "cleanup = cfclose int fd\n"
fn setup m uchar to void
put lens 2 1
if eq m 48
put lens 0 len n0
put lens 1 len r0
for i ulong len n0
put nd i get n0 i
end
for i ulong len r0
put rp i get r0 i
end
end
if eq m 49
put lens 0 len n1
put lens 1 len r1
for i ulong len n1
put nd i get n1 i
end
for i ulong len r1
put rp i get r1 i
end
end
if eq m 50
put lens 0 len n2
put lens 1 len r2
for i ulong len n2
put nd i get n2 i
end
for i ulong len r2
put rp i get r2 i
end
end
if eq m 51
put lens 0 len n3
put lens 1 0
put lens 2 4
for i ulong len n3
put nd i get n3 i
end
end
end
fn matches pos ulong to bool
for j ulong get lens 0
if ne get src add pos j get nd j
ret false
end
end
ret true
end
fn emit pos ulong size ulong replflag bool to void
p = ulong 0
while lt p size
n = long 0
if replflag
n = write 1 rp p sub size p
else
n = write 1 src add pos p sub size p
end
if le n 0
exit 94
end
p = add p ulong n
end
end
fn main to int
if ne argcnt 2
ret 90
end
if ne argread 1 arg 0 len arg 1
ret 90
end
m = get arg 0
if or lt m 48 gt m 51
ret 90
end
setup m
used = ulong 0
go = true
while go
if eq used len src
ret 91
end
n = read 0 src used sub len src used
if lt n 0
ret 92
end
if eq n 0
go = false
else
used = add used ulong n
end
end
count = ulong 0
for i ulong used
if le get lens 0 sub used i
if matches i
count = add count 1
end
end
end
if ne count get lens 2
ret 93
end
pos = ulong 0
start = ulong 0
while lt pos used
hit = false
if le get lens 0 sub used pos
hit = matches pos
end
if hit
emit start sub pos start false
emit 0 get lens 1 true
pos = add pos get lens 0
start = pos
else
pos = add pos 1
end
end
emit start sub used start false
ret 0
end
