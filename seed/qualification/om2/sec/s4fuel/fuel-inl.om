note SPDX-License-Identifier: Apache-2.0
note E14 fuel, inline variant: each inline expansion and each unrolled copy costs 1 in main's fuel.
om2
fn f4 to void inline
end
fn f3 to void inline
for i ulong 64 unroll
f4
end
end
fn f2 to void inline
for i ulong 64 unroll
f3
end
end
fn f1 to void inline
for i ulong 64 unroll
f2
end
end
fn main to int
f1
ret 0
end
