# ---- §4 l.114-116 source mapping: om2 diag writes omc-site 1 line=N iter=k after the artifact; stdout
# unchanged (same). Function mode; the only trap sites are unsigned divs by a run-time divisor.
diag-site emit seed/qualification/om2/sec/s3s4/diag-site.om any file:seed/qualification/om2/sec/s3s4/exp/diag-site.err 0
diag-site-same same seed/qualification/om2/sec/s3s4/diag-site.om seed/qualification/om2/sec/s3s4/diag-site-plain.om
diag-site-rolled emit seed/qualification/om2/sec/s3s4/diag-site-rolled.om any file:seed/qualification/om2/sec/s3s4/exp/diag-site-rolled.err 0
diag-site-rolled-same same seed/qualification/om2/sec/s3s4/diag-site-rolled.om seed/qualification/om2/sec/s3s4/diag-site-rolled-plain.om
diag-site-unroll emit seed/qualification/om2/sec/s3s4/diag-site-unroll.om any file:seed/qualification/om2/sec/s3s4/exp/diag-site-unroll.err 0
diag-site-unroll-same same seed/qualification/om2/sec/s3s4/diag-site-unroll.om seed/qualification/om2/sec/s3s4/diag-site-unroll-plain.om
# E7: iter = 0-based counters of the enclosing unrolled loops, outer to inner, joined by ".", emission order
diag-site-nest emit seed/qualification/om2/sec/s3s4/diag-site-nest.om any file:seed/qualification/om2/sec/s3s4/exp/diag-site-nest.err 0
diag-site-nest-same same seed/qualification/om2/sec/s3s4/diag-site-nest.om seed/qualification/om2/sec/s3s4/diag-site-nest-plain.om
unroll-sum-diag-same same seed/qualification/om2/sec/s3s4/unroll-sum-diag.om+seed/qualification/om2/sec/s3s4/lib-pu.om seed/qualification/om2/sec/s3s4/unroll-sum.om+seed/qualification/om2/sec/s3s4/lib-pu.om
fold-trap-diag-same same seed/qualification/om2/sec/s3s4/fold-trap-diag.om+seed/qualification/om2/sec/s3s4/lib-pu.om seed/qualification/om2/sec/s3s4/fold-trap.om+seed/qualification/om2/sec/s3s4/lib-pu.om
program-site-table notrun exact site tables of program-mode units depend on which OM-1 trap stubs and checks exist (stack, write slices); not fixed by the contract or E7
