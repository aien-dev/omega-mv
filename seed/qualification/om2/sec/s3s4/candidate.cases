# ---- §4 parameter slots (l.99-101, function mode): unsized view/edit 2 slots, sized/out/scalar 1 slot,
# more than 6 slots is error 9 (at the signature); E1: out is one pointer; E2: internal unsized params
slots-3v emit seed/qualification/om2/sec/s3s4/slots-3v.om any - 0
slots-3v1s emit seed/qualification/om2/sec/s3s4/slots-3v1s.om - err:5:9 9
