rot-trap-om1-N run seed/qualification/om2/sec/s3s4/rot-trap-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om rep:78:1 file:seed/qualification/om2/oracle/s3s4/exp/rot-trap-N.out - 107
rot-trap-om1-O run seed/qualification/om2/sec/s3s4/rot-trap-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om rep:79:1 file:seed/qualification/om2/oracle/s3s4/exp/rot-trap-O.out - 107
rot-trap-om1-P run seed/qualification/om2/sec/s3s4/rot-trap-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om rep:80:1 file:seed/qualification/om2/oracle/s3s4/exp/rot-trap-P.out - 0
# §3 l.78: signed x is error 7 (the refusal is at the rotate line)
rot-signed-byte emit seed/qualification/om2/sec/s3s4/rot-signed-byte.om - err:6:7 7
rot-signed-short emit seed/qualification/om2/sec/s3s4/rot-signed-short.om - err:6:7 7
rot-signed-int emit seed/qualification/om2/sec/s3s4/rot-signed-int.om - err:6:7 7
rot-signed-long emit seed/qualification/om2/sec/s3s4/rot-signed-long.om - err:6:7 7
# §3 l.76-77 and erratum E7: n of the same type as x; mixed types are error 7 (OM-1 shifts accept a mixed
# amount type; E7: the stricter rule is for OM-2 rotr/rotl only)
rot-mixed-uint-ulong emit seed/qualification/om2/sec/s3s4/rot-mixed-uint-ulong.om - err:7:7 7
rot-mixed-ulong-uchar emit seed/qualification/om2/sec/s3s4/rot-mixed-ulong-uchar.om - err:7:7 7
# §3 l.77: the result has x's type (OMEGESE 9.3 decision 20: error 7 at the assignment); OM-1 shift twin (C1)
rot-result-type emit seed/qualification/om2/sec/s3s4/rot-result-type.om - err:8:7 7
rot-result-type-om1 emit seed/qualification/om2/sec/s3s4/rot-result-type-om1.om - err:8:7 7
# rotr/rotl as names in OM-1 units (§0 l.15-16): covered by another lane

# ---- §4 unroll (l.87-92): K = 1, 4, 64; both forms run against one oracle (l.91-92)
unroll-sum run seed/qualification/om2/sec/s3s4/unroll-sum.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-sum.out - 0
unroll-sum-rolled run seed/qualification/om2/sec/s3s4/unroll-sum-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-sum.out - 0
unroll-sum-om1 run seed/qualification/om2/sec/s3s4/unroll-sum-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-sum.out - 0
# nested unroll 8 x 8 = 64 copies, folded constant indices in range (l.87-88, l.105-106)
unroll-nest run seed/qualification/om2/sec/s3s4/unroll-nest.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-nest.out - 0
unroll-nest-rolled run seed/qualification/om2/sec/s3s4/unroll-nest-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-nest.out - 0
unroll-nest-om1 run seed/qualification/om2/sec/s3s4/unroll-nest-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-nest.out - 0
# l.89: a write to i in the unrolled body is error 7, also inside a rolled loop nested in it
unroll-write-i emit seed/qualification/om2/sec/s3s4/unroll-write-i.om - err:7:7 7
unroll-write-i-nested emit seed/qualification/om2/sec/s3s4/unroll-write-i-nested.om - err:10:7 7
# control: a rolled for may write its counter (OM-1 meaning kept, §0 l.5-6, l.17), prints 1 3
unroll-write-i-rolled run seed/qualification/om2/sec/s3s4/unroll-write-i-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-write-i-rolled.out - 0
unroll-write-i-rolled-om1 run seed/qualification/om2/sec/s3s4/unroll-write-i-rolled-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-write-i-rolled.out - 0
# l.90: break / continue in an unrolled body is error 9; controls without unroll run (exit 2, 3)
unroll-break emit seed/qualification/om2/sec/s3s4/unroll-break.om - err:9:9 9
unroll-continue emit seed/qualification/om2/sec/s3s4/unroll-continue.om - err:9:9 9
unroll-break-rolled run seed/qualification/om2/sec/s3s4/unroll-break-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-break-rolled.out - 2
unroll-break-om1 run seed/qualification/om2/sec/s3s4/unroll-break-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-break-rolled.out - 2
unroll-continue-rolled run seed/qualification/om2/sec/s3s4/unroll-continue-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-continue-rolled.out - 3
unroll-continue-om1 run seed/qualification/om2/sec/s3s4/unroll-continue-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-continue-rolled.out - 3
# E7: break/continue whose innermost loop is a ROLLED loop nested in the unrolled body is allowed (exit 4, 8)
unroll-break-nested run seed/qualification/om2/sec/s3s4/unroll-break-nested.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-break-nested.out - 4
unroll-break-nested-rolled run seed/qualification/om2/sec/s3s4/unroll-break-nested-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-break-nested.out - 4
unroll-break-nested-om1 run seed/qualification/om2/sec/s3s4/unroll-break-nested-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-break-nested.out - 4
unroll-continue-nested run seed/qualification/om2/sec/s3s4/unroll-continue-nested.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-continue-nested.out - 8
unroll-continue-nested-rolled run seed/qualification/om2/sec/s3s4/unroll-continue-nested-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-continue-nested.out - 8
unroll-continue-nested-om1 run seed/qualification/om2/sec/s3s4/unroll-continue-nested-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-continue-nested.out - 8
# l.87 K a number 1..64; erratum E7: K = 0 or K > 64 is error 8, a non-number K is error 16 (at the for line);
# om2 diag record fully fixed by §1 l.38-46, E4 (col/span/found of the token 65), E6 Q2 (expect=number)
unroll-k65 emit seed/qualification/om2/sec/s3s4/unroll-k65.om - err:8:8 8
unroll-k65-diag emit seed/qualification/om2/sec/s3s4/unroll-k65-diag.om - file:seed/qualification/om2/sec/s3s4/exp/unroll-k65-diag.err 8
unroll-k0 emit seed/qualification/om2/sec/s3s4/unroll-k0.om - err:8:8 8
unroll-kvar emit seed/qualification/om2/sec/s3s4/unroll-kvar.om - err:9:16 16
# E7: the 64-copy limit is per unrolled loop; 64 x 2 nested (128 copies) is accepted and runs
unroll-nest-64x2 run seed/qualification/om2/sec/s3s4/unroll-nest-64x2.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-nest-64x2.out - 0
unroll-nest-64x2-rolled run seed/qualification/om2/sec/s3s4/unroll-nest-64x2-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-nest-64x2.out - 0
unroll-nest-64x2-om1 run seed/qualification/om2/sec/s3s4/unroll-nest-64x2-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-nest-64x2.out - 0
# l.109-111: emitted words after unrolling at most 65536 else error 14 obligation=growth: 64 x 64 copies of a
# 30-word body (measured 30 words per copy under OM-1, README); the rolled control is valid and runs
unroll-growth refuse seed/qualification/om2/sec/s3s4/unroll-growth.om 14
unroll-growth-diag emit seed/qualification/om2/sec/s3s4/unroll-growth-diag.om - tok:seed/qualification/om2/sec/s3s4/exp/growth.tok 14
unroll-growth-rolled run seed/qualification/om2/sec/s3s4/unroll-growth-rolled.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-growth-rolled.out - 149
unroll-growth-om1 run seed/qualification/om2/sec/s3s4/unroll-growth-om1.om+seed/qualification/om2/sec/s3s4/lib-pu.om - file:seed/qualification/om2/oracle/s3s4/exp/unroll-growth-rolled.out - 149

# ---- §4 inline (l.93-98): argument order, trap order and codes, removing inline changes nothing
inline-order-A run seed/qualification/om2/sec/s3s4/inline-order.om+seed/qualification/om2/sec/s3s4/lib-pu.om rep:65:1 file:seed/qualification/om2/oracle/s3s4/exp/inline-order-A.out - 0
