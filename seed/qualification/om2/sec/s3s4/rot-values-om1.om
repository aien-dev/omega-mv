d = ulong 9305357566071262703
pu tr64 d 0
pu tr64 d 1
pu tr64 d 29
pu tr64 d 63
pu tl64 d 0
pu tl64 d 1
pu tl64 d 29
pu tl64 d 63
pu rr64 d 0
pu rr64 d 1
pu rr64 d 29
pu rr64 d 63
pu rl64 d 0
pu rl64 d 1
pu rl64 d 29
pu rl64 d 63
for n ulong 64
pu rr64 d n
pu rl64 d n
end
ret 0
end
fn tr8 x uchar n uchar to uchar
if eq n 0
ret x
end
ret or shr x n shl x sub 8 n
end
fn tl8 x uchar n uchar to uchar
if eq n 0
ret x
end
ret or shl x n shr x sub 8 n
end
fn tr16 x ushort n ushort to ushort
if eq n 0
ret x
end
ret or shr x n shl x sub 16 n
end
fn tl16 x ushort n ushort to ushort
if eq n 0
ret x
end
ret or shl x n shr x sub 16 n
end
fn tr32 x uint n uint to uint
if eq n 0
ret x
end
ret or shr x n shl x sub 32 n
end
fn tl32 x uint n uint to uint
if eq n 0
ret x
end
ret or shl x n shr x sub 32 n
