note
om2
fn f1 a ulong to ulong inline
ret add f2 mul a 3 1
end
fn f2 a ulong to ulong inline
ret add f3 mul a 5 2
end
fn f3 a ulong to ulong inline
ret add f4 mul a 7 3
end
fn f4 a ulong to ulong inline
ret add f5 mul a 11 4
end
fn f5 a ulong to ulong inline
ret add mul a 13 5
end
fn id v ulong to ulong
ret v
end
fn main to int
pu f1 2
pu f1 id 1000
ret 0
end
