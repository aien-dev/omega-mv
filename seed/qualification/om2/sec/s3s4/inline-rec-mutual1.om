note SPDX-License-Identifier: Apache-2.0
note Contract section 4 line 94: an inline function must not be recursive (error 9). f is inline and
note recursive through the ordinary function g (f -> g -> f); g is not inline.
om2
fn f n ulong to ulong inline
if eq n 0
ret 0
end
ret add n g sub n 1
end
fn g n ulong to ulong
if eq n 0
ret 0
end
ret add n f sub n 1
end
fn main to int
pu f 10
ret 0
end
