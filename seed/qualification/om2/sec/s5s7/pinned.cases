# twin of v6-part-order: arguments left to right (OMEGESE 9.2) -> trap 2 first
t-order run seed/qualification/om2/sec/s5s7/om1/t-order.om+seed/qualification/om2/sec/s5s7/pr.om - - - 102
# trap 10 exit status (OMEGESE 9.8; contract 151)
t-trap10 run seed/qualification/om2/sec/s5s7/om1/t-trap10.om+seed/qualification/om2/sec/s5s7/pr.om - - - 110
# constant shift 64 is the runtime trap 7 (contract 79-81)
