# twin of v6-part-wrap: OM-1 write slice check, o = 2^64-2, n = 4 -> trap 3 (OMEGESE 9.5)
t-slw run seed/qualification/om2/sec/s5s7/om1/t-slw.om+seed/qualification/om2/sec/s5s7/pr.om - - - 103
# twin of v6-part-tail: off 8, n 4 on len 10 -> trap 3
t-slt run seed/qualification/om2/sec/s5s7/om1/t-slt.om+seed/qualification/om2/sec/s5s7/pr.om - - - 103
# twin of v6-part-o: off 11, n 0 on len 10 -> trap 3
