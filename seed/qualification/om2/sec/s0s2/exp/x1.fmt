note SPDX-License-Identifier: Apache-2.0
note   omegese-om2.md 2 lines 63-72: formatter input (the rest after 'om2 fmt'); spacing    kept in notes.
note	note lines are preserved exactly, tabs  and  double  spaces included.
om2
text msg "a  b\t \"q  q\"  \\ "
text t2 "   "

fn twice a ulong to ulong
  ret mul a 2
end
fn main to int
    x = ulong 0x15
	y = twice x

  	 r = write 1 msg 0 len msg
  ret int y
end
