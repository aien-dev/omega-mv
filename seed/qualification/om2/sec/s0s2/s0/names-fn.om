note SPDX-License-Identifier: Apache-2.0
note omegese-om2.md 0 lines 14-16: OM-1 keeps every name it has, including user functions named
note like the OM-2 words (rotr as in om/blake3/blake3.om:68). Each function below computes something
note other than its OM-2 meaning, so a compiler that applied OM-2 meaning in an OM-1 unit prints
note different numbers. Expected stdout: oracle/s0s2/oracle.py (names_fn). Used with lib/putu.om.
fn rotr x uint n uint to uint
ret xor x n
end
fn rotl x uint n uint to uint
ret sub x n
end
fn fresh a ulong to ulong
ret mul a 3
end
fn at a ulong b ulong to ulong
ret add a b
end
fn unroll n ulong to ulong
s = ulong 0
for i ulong n
s = add s i
end
ret s
end
fn inline a ulong to ulong
ret add a 100
end
fn seal a ulong to ulong
ret xor a 255
end
fn open a ulong to ulong
ret shr a 1
end
fn part a ulong b ulong to ulong
ret rem a b
end
fn export a ulong to ulong
ret sub a 1
end
fn abstract a ulong to ulong
ret mul a a
end
fn holds a ulong to ulong
ret and a 15
end
fn layout a ulong to ulong
ret or a 256
end
fn field a ulong to ulong
ret shl a 4
end
fn dup32mk x uint to ulong
ret ulong x
end
fn main to int
putu ulong rotr 5 3
putu ulong rotl 4000000000 7
putu fresh 14
putu at 20 22
putu unroll 10
putu inline 1
putu seal 15
putu open 1001
putu part 100 7
putu export 0
putu abstract 4294967296
putu holds 1234
putu layout 1
putu field 3
putu dup32mk 7
ret 0
end
