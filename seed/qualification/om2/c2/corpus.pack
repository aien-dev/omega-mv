if eq op 34
fx = ulong 3405774848
end
if ne imm 0
fx = ulong 2432696320
if eq op 34
fx = ulong 3506438144
end
end
if eq ty 4
bo_w3 xor fx 2147483648 rd ra rb imm
ret
end
if eq ty 9
bo_w3 or fx 536870912 rd ra rb imm
trapc 6 1
ret
end
bo_w3 fx rd ra rb imm
bo_fix rd ty
end

note mul: i64 SMULH t, MUL, CMP t, rd, ASR #63, B.NE trap 1 (om4 BO_MUL)
