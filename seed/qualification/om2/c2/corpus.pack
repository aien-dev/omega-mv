note 4; ADD Xc, Xc, #1 (C6.2.5). om4 SW_NOB .. SW_G and the same in S_FOR.
fn lpcnt c ulong n ulong to void
if le n 4095
emit or or 4043309087 shl n 10 shl c 5
else
m = alloc
matconst m n
emit or or 3942645791 shl c 5 shl m 16
end
trapc 2 4
emit or or 2432697344 c shl c 5
end

note s_while: while cond [bound N]: hidden counter = 0; head: cond false -> exit; counter >= N -> trap 4;
note counter = counter + 1; body; B head. N is 1 .. 999999 (error 8), 1000000 with no bound. om4 S_WHILE.
fn s_while to void
sn = get nn 0
sh = get held 0
c = alloc
put held 0 get nslot 0
emit or 3531603968 c
hd = get oc 0
br = cond
n = ulong 1000000
tok
k = get tk 0
if and ne k 0 ne k 3
if ne k 1
fail 5
end
if gt get tl 0 8
fail 5
end
if ne kw get tw 0 70
fail 5
end
v = lenval 4
if ge sub v 1 999999
fail 8
end
n = v
eol
end
lpcnt c n
pushb br 3 hd c 0
pushnh sn sh
end

note sf_br: B.HS (unsigned) or B.GE (signed) to the loop exit, C6.2.34 (distance filled at end); returns
note its place. om4 SF_BR.
fn sf_br t ulong to ulong
at = get oc 0
if lt t 6
emit 1409286146
else
emit 1409286154
end
ret at
end

note sf_num: for i T K with K a number: i = 0 (MOVZ, C6.2.285); head: CMP Xi, #K or Xk; B.HS/B.GE exit.
note om4 SF_NUM .. SF_PUSH.
fn sf_num w ulong t ulong kk ulong sn ulong sh ulong to void
eol
i = alloc
put held 0 get nslot 0
addname w i t 0 0 0
emit or 3531603968 i
hd = get oc 0
if le kk 4095
emit or or 4043309087 shl kk 10 shl i 5
else
k = alloc
matconst k kk
emit or or 3942645791 shl i 5 shl k 16
end
br = sf_br t
pushb br 4 hd i t
pushnh sn sh
end

note sf_val: for i T K with K a value of type T in register kr: i = 0; the hidden counter c = 0; head: CMP
note Xi, Xk; B.HS/B.GE exit; the counter guard of a while with no bound. om4 SF_VAL.
fn sf_val w ulong t ulong kr ulong sn ulong sh ulong to void
eol
i = alloc
put held 0 get nslot 0
addname w i t 0 0 0
emit or 3531603968 i
c = alloc
put held 0 get nslot 0
emit or 3531603968 c
hd = get oc 0
emit or or 3942645791 shl kr 16 shl i 5
br = sf_br t
m = alloc
matconst m 1000000
emit or or 3942645791 shl c 5 shl m 16
trapc 2 4
emit or or 2432697344 c shl c 5
pushb br 4 hd i t
pushnh sn sh
end

note s_for: for i T K: i = 0; head: not i < K -> exit; body; latch i = add i 1; B head. K a number, or a
note value of type T: a name is read at every pass, another value once before the loop. om4 S_FOR.
fn s_for to void
sn = get nn 0
sh = get held 0
tok
if eq get tk 0 0
fail 4
end
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
w = get tw 0
if ne kw w 0
fail 16
end
newname w get tl 0 get ts 0
t = typeword
if or eq t 1 ge t 10
fail 7
end
tok
if eq get tk 0 0
fail 4
end
if eq get tk 0 2
range get tw 0 t get tbig 0
sf_num w t get tw 0 sn sh
ret
end
rdval 1 t 255 0
if ne get rt 0 t
fail 7
end
if eq get rk 0 3
sf_num w t get rv 0 sn sh
ret
end
kr = matreg get rk 0 get rv 0 get rt 0
sf_val w t kr sn sh
end

note finish: end of a function: a function that needs a value must not reach its end (error 18), a void
note one returns; then the trap stubs: shared tail, function mode MOV X0, X7; LDR X16, [X7, #16]; BR X16
note (C6.2.282, C6.2.216, C6.2.46: OscRt.trap); program mode ADD X0, X1, #100; MOVZ X8, #93; SVC #0 (exit
note 100 + code). Per trap code used: MOVZ X1, #code (C6.2.285); B tail. om4 FINISH.
fn finish to void
eol
if eq get dead 0 0
if ne get curret 0 10
fail 18
end
epi
end
nt0 = get nt 0
if ne nt0 0
tail = get oc 0
if eq get progmode 0 0
emit 2852586464
emit 4181723376
emit 3592356352
else
emit 2432798752
emit 3531606952
emit 3556769793
end
code = ulong 1
while le code 14
st = ulong 0
j = ulong 0
while lt j nt0
if eq get tcode j code
if eq st 0
st = get oc 0
emit or 3531603969 shl code 5
back tail
end
patch19 get tsite j st
end
j = add j 1
end
code = add code 1
end
end
put curret 0 0
put nn 0 get nglob 0
put curfn 0 0
put nbrk 0 0
put ncont 0 0
end

note s_end: close the innermost block (if: patch its branch; else: patch its jump; while: B head; for: i =
note add i 1, B head), or the function. om4 S_END.
fn s_end to void
n = get nb 0
if eq n 0
finish
ret
end
i = sub n 1
put nb 0 i
k = get bkind i
if eq k 2
put dead 0 and get dead 0 get bdead i
else
put dead 0 0
end
if eq k 4
lat = get oc 0
j = ulong 0
while lt j get ncont 0
if eq get cblk j i
patch19 get cpos j lat
put cblk j 65535
end
j = add j 1
end
put fr 0 1
put fr 1 get breg i
put fr 2 get btyp i
put fr 3 3
put fr 4 1
put fr 5 get btyp i
binop 33 get breg i 0
end
if eq k 3
j = ulong 0
while lt j get ncont 0
if eq get cblk j i
patch19 get cpos j get bhead i
put cblk j 65535
end
j = add j 1
end
end
if ge k 3
back get bhead i
ex = get oc 0
j = ulong 0
while lt j get nbrk 0
if eq get brkblk j i
patch19 get brkpos j ex
put brkblk j 65535
end
j = add j 1
end
end
if eq k 2
patch26 get bbr i get oc 0
else
patch19 get bbr i get oc 0
end
put nn 0 get bnames i
put held 0 get bheld i
eol
end

note ======== the end of the input: the output ========
note writeout: the output from byte st to the end, to stdout (error 2), then exit 0. om4 WRITEOUT.
fn writeout st ulong to void
p = st
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p get oc 0
go = false
else
n = write 1 out p sub get oc 0 p
if le n 0
fail 2
end
p = add p ulong n
end
m = add m 1
end
end
exit int 0
end

note elfhdr: the 176-byte file header (om4 ELFHDR, 44 words): ELF64 little-endian, executable, AArch64,
note entry 0x4000b0 (the word after the header), 2 program headers: code read+execute from 0x400000, and
note the read/write pools from 0x10000000. Only the words that are not 0 (the output starts at 0).
fn elfhdr to void
wrword 0 1179403647
wrword 4 65794
wrword 16 11993090
wrword 20 1
wrword 24 4194480
wrword 32 64
wrword 52 3670080
wrword 56 2
wrword 64 1
wrword 68 5
wrword 80 4194304
wrword 88 4194304
wrword 112 4096
wrword 120 1
wrword 124 6
wrword 136 268435456
wrword 144 268435456
wrword 168 4096
end

note eof_prog: program mode: start code = MOVZ X28, #0x1000, LSL 16 (stack pool floor); MOVZ X16, #0x1080,
note LSL 16; MOV SP, X16 (ADD immediate, C6.2.5); BL main (C6.2.43); [MOVZ X0, #0 for a void main]; MOVZ X8,
note #93; SVC #0. The entry word after the header is a B to it; the header gets the file and pool sizes.
note om4 EOF_PROG.
fn eof_prog to void
f = findfn 1852399981 4 0
if eq f 0
fail 16
end
if ne get fn_np sub f 1 0
fail 9
end
wrword 176 or 335544320 and shr sub get oc 0 176 2 67108863
if ne get hostargs 0 0
note Preserve Linux's initial argument stack privately before installing Omega's bounded stack.
emit 2432697339
end
emit 3533832220
emit 3533836304
emit 2432696863
emit or 2483027968 and shr sub get fn_addr sub f 1 get oc 0 2 67108863
if eq get fn_ret sub f 1 10
emit 3531603968
end
emit 3531606952
emit 3556769793
elfhdr
wrword 96 get oc 0
wrword 104 get oc 0
wrword 160 add get poolb 0 8388608
writeout 0
end

note s_eof: end of input: no open function (error 15), some function (16); function mode: no globals or
note texts (9); one function: its bare words; more: the entry word, a B to the last function. om4 S_EOF.
note Resolve every call after all addresses are known. In function mode remove leaves of the call
note graph; any functions left after nf rounds form or reach a cycle (error 9).
fn resolve to void
n = get ncalls 0
i = ulong 0
while lt i n
s = get callsite i
f = sub get callto i 1
wrword s or 2483027968 and shr sub get fn_addr f s 2 67108863
i = add i 1
end
if eq get progmode 0 0
pass = ulong 0
while lt pass get nf 0
f = ulong 0
while lt f get nf 0
if eq get settled f 0
ok = true
i = ulong 0
while and ok lt i n
if eq get callfrom i add f 1
if eq get settled sub get callto i 1 0
ok = false
end
end
i = add i 1
end
if ok
put settled f 1
end
end
f = add f 1
end
pass = add pass 1
end
f = ulong 0
while lt f get nf 0
if eq get settled f 0
fail 9
end
f = add f 1
end
end
end

fn s_eof to void

if ne get curret 0 0
fail 15
end
if eq get nf 0 0
fail 16
end
resolve
if ne get progmode 0 0
eof_prog
end
if ne get nglob 0 0
fail 9
end
if eq get nf 0 1
writeout 180
end
a = get fn_addr sub get lastfn 0 1
wrword 176 or 335544320 and shr sub a 176 2 67108863
writeout 176
end

note stmt: one line. Returns 1 at the end of the input. om4 STMT.
fn stmt to ulong
put nslot 0 get held 0
tok
k = get tk 0
if eq k 0
ret 0
end
if eq k 3
s_eof
ret 1
end
if ne k 1
fail 16
end
if gt get tl 0 8
s_long
ret 0
end
w = get tw 0
c = kw w
if eq c 83
skipnl
ret 0
end
if eq c 64
s_fn
ret 0
end
if eq get curret 0 0
if eq c 78
s_global
ret 0
end
if eq c 79
s_text
ret 0
end
if eq c 152
s_const
ret 0
end
if eq c 85
skipnl
ret 0
end
fail 16
end
if eq c 66
s_end
ret 0
end
if eq c 68
s_else
ret 0
end
if ne get dead 0 0
fail 17
end
if eq c 0
s_name w
ret 0
end
if eq c 67
s_if
ret 0
end
if eq c 69
s_while
ret 0
end
if eq c 71
s_for
ret 0
end
if eq c 72
s_ret
ret 0
end
if eq c 80
s_put
ret 0
end
if eq c 82
s_exit
ret 0
end
if eq c 86
s_break
ret 0
end
if eq c 87
s_trap
ret 0
end
if eq c 97
s_cont
ret 0
end
if or or or eq c 77 eq c 78 eq c 79 eq c 81
fail 9
end
if eq c 85
fail 9
end
fail 16
ret 0
end

note ======== program mode: some line is `fn main` (blanks, fn, blanks, main, then a blank or the end) ========
note skipbl: the first place at or after q that is not a space or tab (or the end)
fn skipbl q ulong to ulong
e = get inlen 0
p = q
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = get inp p
if or eq b 32 eq b 9
p = add p 1
else
go = false
end
end
m = add m 1
end
end
ret p
end

note skipln: the place after the next newline at or after q (or the end)
fn skipln q ulong to ulong
e = get inlen 0
p = q
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = get inp p
p = add p 1
if eq b 10
go = false
end
end
m = add m 1
end
end
ret p
end

note ps_at: the line's first byte that is not blank is at p: 1 when the line is `fn main`, 2 when the input
note ends while deciding, else 0. om4 PS_LINE .. PS_YES.
fn ps_at p ulong to ulong
e = get inlen 0
if ne get inp p 102
ret 0
end
q = add p 1
if ge q e
ret 2
end
if ne get inp q 110
ret 0
end
r = add q 1
q = skipbl r
if ge q e
ret 2
end
if eq q r
ret 0
end
if gt add q 4 e
ret 0
end
if ne get inp q 109
ret 0
end
if ne get inp add q 1 97
ret 0
end
if ne get inp add q 2 105
ret 0
end
if ne get inp add q 3 110
ret 0
end
if ge add q 4 e
ret 1
end
if gt get inp add q 4 32
ret 0
end
ret 1
end

fn prescan to void
e = get inlen 0
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
p = skipbl p
if ge p e
go = false
else
r = ps_at p
if eq r 1
put progmode 0 1
go = false
end
if eq r 2
go = false
end
if go
p = skipln p
if ge p e
go = false
end
end
end
m = add m 1
end
end
end

note First collect signatures. Only fn headers are parsed here; other lines are read in the body pass.
fn namescan to void
put scanning 0 1
put line 0 1
go = true
while go
n = ulong 0
while and go lt n 999999
tok
if eq get tk 0 3
go = false
else
if ne get tk 0 0
if and eq get tk 0 1 eq get tw 0 28262
s_fn
else
if and eq get tk 0 1 eq get tw 0 127970521019507
s_struct
else
if and eq get tk 0 1 eq get tw 0 500152823651
s_const
else
skipnl
end
end
end
end
end
n = add n 1
end
end
put scanning 0 0
put cur 0 0
put line 0 1
put nn 0 0
put nglob 0 0
put curfn 0 0
put curret 0 0
put npar 0 0
put nslot 0 0
put held 0 0
end

note ======== R6 structs (omc only; om4 stays the parent that rebuilds this file) ========
note A struct is 8-byte cells, declaration order, no padding (OSC-2). new is a stack slot, given
note back at ret, like a local array. There is no free (decision 24). Field scale: cell << (3 - tlog)
note so a typed store lands on cell * 8. Pack of struct is 127970521019507 (Wolfram, little-endian).

note findstruct: packed name -> index + 1, or 0
fn findstruct w ulong to ulong
i = ulong 0
n = get nst 0
while lt i n
if eq get st_name i w
ret add i 1
end
i = add i 1
end
ret 0
end

note findfield: struct index, packed field name -> field-table index + 1, or 0
fn findfield si ulong w ulong to ulong
fo = ulong get st_foff si
nfd = ulong get st_nf si
i = ulong 0
while lt i nfd
j = add fo i
if eq get sf_name j w
ret add j 1
end
i = add i 1
end
ret 0
end

note field_dup: 1 if w is already a field of the struct being read (fields fo .. nsf)
fn field_dup fo ulong w ulong to ulong
i = fo
e = get nsf 0
while lt i e
if eq get sf_name i w
ret 1
end
i = add i 1
end
ret 0
end

note s_field: the current word is a field name of struct w. Returns the cell count after this field.
fn s_field w ulong fo ulong cells ulong to ulong
if ne kw get tw 0 0
fail 16
end
if gt get tl 0 8
fail 13
end
fw = get tw 0
if eq fw w
fail 10
end
if ne findstruct fw 0
fail 10
end
if ne field_dup fo fw 0
fail 10
end
t = typeword
ln = ulong 0
p = get cur 0
ln0 = get line 0
tok
k = get tk 0
if eq k 2
ln = get tw 0
if ne get tbig 0 0
fail 14
end
if or eq ln 0 gt ln 64
fail 14
end
else
if eq k 1
e = findname get tw 0
if ne e 0
if eq get nm_kind sub e 1 9
ct = ulong get nm_type sub e 1
if ge ct 10
fail 14
end
ln = get nm_addr sub e 1
if or eq ln 0 gt ln 64
fail 14
end
else
put cur 0 p
put line 0 ln0
end
else
put cur 0 p
put line 0 ln0
end
else
put cur 0 p
put line 0 ln0
end
end
addc = ulong 1
if ne ln 0
addc = ln
end
if gt add cells addc 64
fail 14
end
put sf_name get nsf 0 fw
put sf_type get nsf 0 uchar t
put sf_len get nsf 0 uchar ln
put sf_off get nsf 0 uchar cells
put nsf 0 add get nsf 0 1
ret add cells addc
end

note s_struct: struct Name (field type [len])* end. Before any fn (namescan). 1..16 fields, <= 64 cells.
fn s_struct to void
if ne get nf 0 0
fail 9
end
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
if ne kw get tw 0 0
fail 16
end
w = get tw 0
if ne findstruct w 0
fail 10
end
if ne findfn w get tl 0 get ts 0 0
fail 10
end
if ge get nst 0 16
fail 14
end
sid = get nst 0
fo = get nsf 0
cells = ulong 0
nfld = ulong 0
go = true
while go
tok
if eq get tk 0 0
fail 4
end
if ne get tk 0 1
fail 16
end
if eq kw get tw 0 66
go = false
else
if ge nfld 16
fail 14
end
cells = s_field w fo cells
nfld = add nfld 1
end
end
if eq nfld 0
fail 16
end
put st_name sid w
put st_nf sid uchar nfld
put st_cells sid uchar cells
put st_foff sid uchar fo
put nst 0 add sid 1
eol
end

note peek_struct: if the next word is a struct name, consume it and return index + 1; else rewind
fn peek_struct to ulong
p = get cur 0
ln = get line 0
tok
if ne get tk 0 1
put cur 0 p
put line 0 ln
ret 0
end
sid = findstruct get tw 0
if eq sid 0
put cur 0 p
put line 0 ln
ret 0
end
ret sid
end

note fn_p_st: parameter pw is view (k 2, name kind 8) or edit (k 3, name kind 7). fn_pk is 6 or 7.
fn fn_p_st f ulong np ulong pw ulong sid ulong k ulong to void
si = sub sid 1
t = add si 16
ln = ulong get st_cells si
sk = add k 4
if eq k 2
addname pw poolc np t ln 8 0
else
addname pw poolc np t ln 7 0
end
p = add mul f 6 np
put fn_pt p uchar t
put fn_pl p ln
put fn_pk p uchar sk
end

note sa_new: name = new <type or struct>. Rewind unless the next word is a struct name.
fn sa_new w ulong to void
p = get cur 0
ln = get line 0
tok
sid = ulong 0
if eq get tk 0 1
sid = findstruct get tw 0
end
if ne sid 0
sa_st w sid
ret
end
put cur 0 p
put line 0 ln
sa_arr w
end

note st_read: one value per field, saved in svk/svv/svt. An array field takes one value.
fn st_read si ulong to void
fo = ulong get st_foff si
nfd = ulong get st_nf si
i = ulong 0
while lt i nfd
ft = ulong get sf_type add fo i
rdval 0 ft 255 0
if ne get rt 0 ft
fail 7
end
put svk i get rk 0
put svv i get rv 0
put svt i get rt 0
i = add i 1
end
end

note st_store: STR of v at cell, scaled so the typed store lands on cell * 8. ADD is not used; the
note index register holds cell << (3 - tlog). STR register-offset is the STOP table (om4).
fn st_store base ulong idx ulong cell ulong t ulong v ulong to void
matconst idx shl cell sub 3 tlog t
put ea_b 0 base
put ea_i 0 idx
stel t v
end

note st_ixreg: runtime element index iv, field length fl, cell offset off. CMP + B.HS trap 3
note (elemaddr, C6.2.96 / C6.2.34), then ADD Xidx, Xiv, #off (C6.2.5, base word 2432696320) and
note LSL by 3 - tlog (bo_lsl) so the STOP store lands on (off + i) * 8.
fn st_ixreg idx ulong iv ulong off ulong fl ulong t ulong to void
emit or or 4043309087 shl fl 10 shl iv 5
trapc 2 3
emit or or or 2432696320 idx shl iv 5 shl off 10
sh = sub 3 tlog t
if ne sh 0
bo_lsl idx sh idx
end
end

note st_ld: LDR of type t from base + idx into dst (or a new register). LDOP table, as vt_get.
fn st_ld base ulong idx ulong t ulong dst ulong to void
rd = destreg dst
w = or ldop t rd
emit or or w shl base 5 shl idx 16
put rk 0 1
put rv 0 rd
put rt 0 t
end

note st_write1: store field j (value saved at sv* i) into the struct at base.
fn st_write1 base ulong tmp ulong idx ulong j ulong i ulong to void
ft = ulong get sf_type j
fl = ulong get sf_len j
off = ulong get sf_off j
force get svk i get svv i get svt i tmp
if eq fl 0
st_store base idx off ft tmp
else
k = ulong 0
while lt k fl
st_store base idx add off k ft tmp
k = add k 1
end
end
end

note st_write: store each field value. An array field is filled with its one value.
fn st_write base ulong tmp ulong idx ulong si ulong to void
fo = ulong get st_foff si
nfd = ulong get st_nf si
i = ulong 0
while lt i nfd
st_write1 base tmp idx add fo i i
i = add i 1
end
end

note sa_st: p = new S v1 .. vn. Stack slot of the cell count, 16-byte aligned, outermost block only.
fn sa_st w ulong sid ulong to void
if ne get nb 0 0
fail 9
end
si = sub sid 1
cells = ulong get st_cells si
by = shl shr add shl cells 3 15 4 4
s = add get stkbytes 0 by
if gt s 4194304
fail 23
end
put stkbytes 0 s
r = alloc
put held 0 get nslot 0
st_read si
spsub by
stkchk
emit or 2432697312 r
tmp = alloc
idx = alloc
st_write r tmp idx si
addname w r add si 16 cells 6 0
end

note vt_fget_go: field j of struct name e. Scalar, or an index then the element.
fn vt_fget_go e ulong dst ulong j ulong to void
fl = ulong get sf_len j
ft = ulong get sf_type j
off = ulong get sf_off j
base = ulong get nm_reg sub e 1
idx = alloc
if eq fl 0
st_store_ld base idx off ft dst
else
rdval 0 5 255 0
if eq get rt 0 1
fail 7
end
if eq get rk 0 3
if ge get rv 0 fl
fail 21
end
st_store_ld base idx add off get rv 0 ft dst
else
if ne get rk 0 1
fail 7
end
st_ixreg idx get rv 0 off fl ft
st_ld base idx ft dst
end
end
end

note vt_fget: get p f, or get p f i for an array field. Kind 6 own, 7 edit, 8 view; all may be read.
fn vt_fget e ulong dst ulong to void
i = sub e 1
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
si = sub ulong get nm_type i 16
fid = findfield si get tw 0
if eq fid 0
fail 3
end
vt_fget_go e dst sub fid 1
end

note st_store_ld: constant cell, then load. Split out so vt_fget stays under 16 registers.
fn st_store_ld base ulong idx ulong cell ulong t ulong dst ulong to void
matconst idx shl cell sub 3 tlog t
st_ld base idx t dst
end

note s_putf_go: field j of struct name e. Read the value (and the index, if an array field) and store.
fn s_putf_go e ulong j ulong to void
fl = ulong get sf_len j
ft = ulong get sf_type j
off = ulong get sf_off j
base = ulong get nm_reg sub e 1
if ne fl 0
rdval 0 5 255 0
if eq get rt 0 1
fail 7
end
put svk 0 get rk 0
put svv 0 get rv 0
put svt 0 get rt 0
end
rdval 0 ft 255 0
if ne get rt 0 ft
fail 7
end
v = matreg get rk 0 get rv 0 get rt 0
idx = alloc
if eq fl 0
st_store base idx off ft v
else
s_putf_ix base idx v off fl ft
end
eol
end

note s_putf: put p f v, or put p f i v. A view struct is error 20.
fn s_putf e ulong to void
i = sub e 1
if eq ulong get nm_kind i 8
fail 20
end
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
si = sub ulong get nm_type i 16
fid = findfield si get tw 0
if eq fid 0
fail 3
end
s_putf_go e sub fid 1
end

note s_putf_ix: the index was saved in svk/svv/svt before the value was read
fn s_putf_ix base ulong idx ulong v ulong off ulong fl ulong ft ulong to void
ik = get svk 0
iv = get svv 0
if eq get svt 0 1
fail 7
end
if eq ik 3
if ge iv fl
fail 21
end
st_store base idx add off iv ft v
else
if ne ik 1
fail 7
end
st_ixreg idx iv off fl ft
put ea_b 0 base
put ea_i 0 idx
stel ft v
end
end

note ca_st_ok: read one struct argument of parameter i of function f. Returns the name entry.
fn ca_st_ok f ulong i ulong to ulong
md = ulong 0
aa_word
w = get tw 0
c = kw w
if ne c 0
if or lt c 57 gt c 58
fail 16
end
md = c
aa_word
w = get tw 0
end
e = findname w
if eq e 0
fail 3
end
ni = sub e 1
k = ulong get nm_kind ni
if lt k 6
fail 7
end
p = add mul sub f 1 6 i
pk = ulong get fn_pk p
if eq pk 7
if eq md 57
fail 20
end
if eq k 8
fail 20
end
else
if eq md 58
fail 7
end
end
if ne ulong get nm_type ni ulong get fn_pt p
fail 7
end
ret e
end

note ca_dist: the same struct name passed twice in one call is error 19.
fn ca_dist cb ulong i ulong e ulong to void
j = ulong 0
while lt j i
if eq get fr add add cb mul j 3 2 e
fail 19
end
j = add j 1
end
end

note ca_st: a struct argument. edit (fn_pk 7) needs own or edit; view takes any. Same struct.
fn ca_st f ulong i ulong cb ulong to void
e = ca_st_ok f i
ca_dist cb i e
q = add cb mul i 3
put fr q 5
put fr add q 1 ulong get nm_reg sub e 1
put fr add q 2 e
end
note ---- R6 IR. A leading line `ir` writes OSC IR version 1. The AArch64 path is not taken.
note Worksheet ir_match.py matched omega_emit on the 10 dev programs; this is that algorithm.

global ir_rty uchar 64
global ir_nreg ulong 1
