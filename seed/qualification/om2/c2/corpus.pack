note oracle/s3s4/exp/fold-trap-*.out (python3, oracle/s3s4/oracle.py).
note OM-1 unit: this line replaces the om2 line
fn cv a ulong to uchar
ret uchar a
end
fn dv a ulong b ulong to ulong
ret div a b
end
fn ps v int to void
if lt v 0
pu 7777
else
pu ulong v
end
end
fn main to int
s = new uchar 1 0
r = read 0 s 0 1
k = get s 0
if eq k 65
pu 999
for i ulong 4
pu div 100 i
end
end
if eq k 66
for i int 4
ps add 2147483646 i
end
end
if eq k 67
for i ulong 4
pu ulong uchar add 254 i
end
end
if eq k 68
for i ulong 4
pu shl 1 add 62 i
end
end
if eq k 69
for i int 4
ps mul 1073741824 add i 1
end
end
if eq k 70
for i int 4
ps add 5 div -2147483648 sub i 1
end
end
if eq k 71
pu 999
for i ulong 4
pu rem 7 i
end
end
if eq k 72
pu ulong cv 255
pu ulong cv 256
end
if eq k 73
pu dv 100 4
pu dv 100 0
end
ret 0
end

