for i ulong 6
if eq i 3
continue
end
s = add s i
end
ret s
end

#### c2-00079 sha256=9cd732ba8a9460b301b349580caab8817e1b949b654b0f98f0068ec37e1c2c79 len=210
note continue leaves only the inner iteration: 2 successes per outer pass, 3 x 12 = 36
fn main to ulong
n = ulong 0
