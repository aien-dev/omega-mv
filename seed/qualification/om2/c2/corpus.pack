spsub 16
stkchk
matconst 0 1
if eq c 130
matconst 0 0
end
emit 2432697313
hsys 113
emit 4043309087
bad = get oc 0
emit 1409286155
emit 4181722081
emit 4181723106
note Reject overflow before seconds are multiplied; clock result is a signed nanosecond count.
matconst 3 9223372036
e3 3942645760 31 1 3
trapc 8 1
matconst 3 1000000000
e3 2600500224 1 1 3
e3 2868903936 0 1 2
trapc 6 1
patch19 bad get oc 0
spadd 16
hreturn dst x
