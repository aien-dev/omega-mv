text pre "/* Generated by omega-bridge src/native.om: native call ABI v1 (docs/NATIVE-ABI.md).\n * The Omega machine code below is embedded byte for byte as the seeded compiler wrote it.\n * This file only adapts the C calling convention to it. Regenerate it; do not edit it. */\n#include <pthread.h>\n#include <signal.h>\n#include <stdint.h>\n#include <sys/mman.h>\n#define OMEGA_OK 0u\n#define OMEGA_BAD_ARG 32u\n#define OMEGA_REENTRY 33u\n#define OMEGA_BAD_RT 34u\n#define OMEGA_NO_STACK 35u\n#define OMBR_STACK (8u << 20)\n#define OMBR_GUARD (8u << 20)\n/* entry[2] is the trap entry (OSC-1 section 7). */\ntypedef struct ombr_rt { const void *entry[32]; } ombr_rt;\ntypedef struct ombr_span { uintptr_t lo, hi; int w; } ombr_span;\nstatic _Thread_local volatile sig_atomic_t ombr_active;\nstatic _Thread_local unsigned char *ombr_stk;\nstatic pthread_key_t ombr_key;\nstatic int ombr_keyok;\nstatic pthread_once_t ombr_once = PTHREAD_ONCE_INIT;\nuint32_t ombr_enter(const void *code, const uint64_t *args, const ombr_rt *rt, uint64_t *out, void *top)\n    __attribute__((visibility(\"hidden\")));\nextern const unsigned char ombr_trap[] __attribute__((visibility(\"hidden\")));\nextern const unsigned char ombr_no_entry[] __attribute__((visibility(\"hidden\")));\n/* ombr_enter saves the callee-saved registers on the caller's stack, keeps that stack pointer in x19 and\n * runs the code on the binding's own stack. A normal return stores x0 through out and\n * returns 0. A runtime entry restores the stack pointer from x19 and returns a status; out is not\n * written. The seeded compiler never writes x19..x28. Runtime entries are reached by blr/br, so they\n * start with bti jc. */\n__asm__(\".text\\n.balign 4\\n.globl ombr_enter\\n.hidden ombr_enter\\n.type ombr_enter,%function\\nombr_enter:\\n\"\n        \"hint #34\\nstp x29,x30,[sp,#-176]!\\nmov x29,sp\\nstp x19,x20,[sp,#16]\\nstp x21,x22,[sp,#32]\\n\"\n        \"stp x23,x24,[sp,#48]\\nstp x25,x26,[sp,#64]\\nstp x27,x28,[sp,#80]\\nstp d8,d9,[sp,#96]\\n\"\n        \"stp d10,d11,[sp,#112]\\nstp d12,d13,[sp,#128]\\nstp d14,d15,[sp,#144]\\nstr x3,[sp,#160]\\n\"\n        \"mov x19,sp\\nmov x16,x0\\nmov x17,x1\\nmov x7,x2\\nmov sp,x4\\n\"\n        \"ldp x0,x1,[x17]\\nldp x2,x3,[x17,#16]\\nldp x4,x5,[x17,#32]\\nblr x16\\n\"\n        \"mov sp,x19\\nldr x9,[sp,#160]\\nstr x0,[x9]\\nmov w0,#0\\n\"\n        \"ombr_leave:\\nldp d14,d15,[sp,#144]\\nldp d12,d13,[sp,#128]\\nldp d10,d11,[sp,#112]\\n\"\n        \"ldp d8,d9,[sp,#96]\\nldp x27,x28,[sp,#80]\\nldp x25,x26,[sp,#64]\\nldp x23,x24,[sp,#48]\\n\"\n        \"ldp x21,x22,[sp,#32]\\nldp x19,x20,[sp,#16]\\nldp x29,x30,[sp],#176\\nret\\n.size ombr_enter,.-ombr_enter\\n\"\n        \".globl ombr_trap\\n.hidden ombr_trap\\n.type ombr_trap,%function\\nombr_trap:\\nhint #38\\n\"\n        \"mov sp,x19\\nsub x2,x1,#1\\nmov w3,#34\\ncmp x2,#13\\ncsel w0,w1,w3,ls\\nb ombr_leave\\n\"\n        \".size ombr_trap,.-ombr_trap\\n\"\n        \".globl ombr_no_entry\\n.hidden ombr_no_entry\\n.type ombr_no_entry,%function\\nombr_no_entry:\\nhint #38\\n\"\n        \"mov sp,x19\\nmov w0,#34\\nb ombr_leave\\n.size ombr_no_entry,.-ombr_no_entry\\n\");\nstatic void ombr_free(void *p)\n{\n    munmap(p, OMBR_STACK + OMBR_GUARD);\n}\nstatic void ombr_init(void)\n{\n    ombr_keyok = pthread_key_create(&ombr_key, ombr_free) == 0;\n}\n/* The thread's Omega stack: OMBR_STACK usable bytes above an OMBR_GUARD no-access region. A function-mode\n * unit has no call cycles and at most 4 MiB of local arrays per function (OMEGESE, local arrays), so a frame that\n * would pass the bottom starts inside the guard and faults there; nothing below the guard is touched. */\nstatic unsigned char *ombr_stack(void)\n{\n    if (ombr_stk)\n        return ombr_stk;\n    pthread_once(&ombr_once, ombr_init);\n    if (!ombr_keyok)\n        return 0;\n    unsigned char *p = mmap(0, OMBR_STACK + OMBR_GUARD, PROT_READ | PROT_WRITE,\n                            MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);\n    if (p == MAP_FAILED)\n        return 0;\n    if (mprotect(p, OMBR_GUARD, PROT_NONE) != 0 || pthread_setspecific(ombr_key, p) != 0) {\n        munmap(p, OMBR_STACK + OMBR_GUARD);\n        return 0;\n    }\n    ombr_stk = p + OMBR_GUARD + OMBR_STACK;\n    return ombr_stk;\n}\nstatic int ombr_span_add(ombr_span *sp, unsigned *ns, const void *p, uint64_t n, uint64_t want, uint64_t es, int w)\n{\n    uintptr_t lo = (uintptr_t)p;\n    if (!p || n != want || lo % es != 0u || n > (UINTPTR_MAX - lo) / es)\n        return 1;\n    sp[*ns].lo = lo;\n    sp[*ns].hi = lo + n * es;\n    sp[*ns].w = w;\n    (*ns)++;\n    return 0;\n}\nstatic int ombr_overlap(const ombr_span *sp, unsigned ns)\n{\n    for (unsigned i = 0; i < ns; i++)\n        for (unsigned j = i + 1; j < ns; j++)\n            if ((sp[i].w || sp[j].w) && sp[i].lo < sp[j].hi && sp[j].lo < sp[i].hi)\n                return 1;\n    return 0;\n}\n/* One read-only runtime table for every call and thread: the code only reads it (a write would fault). */\nstatic const ombr_rt ombr_rt_table = {{ [0 ... 1] = ombr_no_entry, [2] = ombr_trap, [3 ... 31] = ombr_no_entry }};\nstatic uint32_t ombr_run(const void *code, const uint64_t *args, uint64_t *result, int has_value)\n{\n    if (ombr_active)\n        return OMEGA_REENTRY;\n    ombr_active = 1;\n    unsigned char *top = ombr_stack();\n    if (!top) {\n        ombr_active = 0;\n        return OMEGA_NO_STACK;\n    }\n    uint64_t v = 0;\n    uint32_t s = ombr_enter(code, args, &ombr_rt_table, &v, top);\n    ombr_active = 0;\n    if (s == OMEGA_OK)\n        *result = has_value ? v : 0u;\n    return s;\n}\n"
note ob: append one byte to the output pool (trap 6 when it is full).
fn ob b uchar to void
n = get st 1
if ge n len outb
trap 6
end
put outb n b
put st 1 add n 1
end
note orng: copy input bytes s .. e-1 to the output.
fn orng s ulong e ulong to void
i = s
while lt i e
ob get inb i
i = add i 1
end
end
note odec: v in decimal.
fn odec v ulong to void
x = v
n = ulong 0
put dg n uchar add rem x 10 48
n = add n 1
x = div x 10
while ne x 0
put dg n uchar add rem x 10 48
n = add n 1
x = div x 10
end
while gt n 0
n = sub n 1
ob get dg n
end
end
note ohex: one byte as 0xNN.
fn ohex b uchar to void
ob uchar 48
ob uchar 120
ob get hx shr b 4
ob get hx and b 15
end
note opre: the fixed runtime part of the C file.
fn opre to void
for i ulong len pre
ob get pre i
end
end
note ofr: fragment k of fr (fragments are separated by ~, byte 126).
fn ofr k ulong to void
c = ulong 0
for i ulong len fr
b = get fr i
if eq b 126
c = add c 1
else
if eq c k
ob b
end
end
end
end
note tkis: 1 when token k is the keyword kw[o .. o+n-1], else 0.
fn tkis k ulong o ulong n ulong to ulong
s = get tks k
e = get tke k
if ne sub e s n
ret 0
end
for j ulong n
if ne get inb add s j get kw add o j
ret 0
end
end
ret 1
end
note tknum: token k as a decimal number of 1 .. 8 digits.
fn tknum k ulong to ulong
s = get tks k
e = get tke k
if or eq s e gt sub e s 8
trap 10
end
v = ulong 0
for j ulong sub e s
c = get inb add s j
if or lt c 48 gt c 57
trap 10
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note tokln: split the line that starts at p (ending at a newline or at q) into tokens at spaces.
fn tokln p ulong q ulong to ulong
e = p
while and lt e q ne get inb e 10
e = add e 1
end
n = ulong 0
s = p
i = p
while lt i e
if eq get inb i 32
if gt i s
put tks n s
put tke n i
n = add n 1
end
s = add i 1
end
i = add i 1
end
if gt e s
put tks n s
put tke n e
n = add n 1
end
ret n
end
note oname: the name of token k.
fn oname k ulong to void
orng get tks k get tke k
end
note opn: the name of parameter j.
fn opn j ulong to void
orng get ps j get pe j
end
note sepat: where the 0 byte after the source starting at p is.
fn sepat p ulong to ulong
t = get st 0
q = p
while and lt q t ne get inb q 0
q = add q 1
end
if ge q t
trap 10
end
ret q
end
note isfn: 1 when the bytes at i are "fn ".
fn isfn i ulong to ulong
if ne get inb i 102
ret 0
end
if ne get inb add i 1 110
ret 0
end
if ne get inb add i 2 32
ret 0
end
ret 1
end
note sigln: the start of the last line in p .. q-1 that begins with "fn " (the compiler's entry).
fn sigln p ulong q ulong to ulong
fl = ulong 0
nf = ulong 0
ls = p
i = p
while lt i q
if eq i ls
if eq isfn i 1
fl = i
nf = add nf 1
end
end
if eq get inb i 10
ls = add i 1
end
i = add i 1
end
if eq nf 0
trap 10
end
ret fl
end
note pkind: the kind of the parameter whose type starts at token ty: 1 ulong, 2 long, 3 edit ulong,
note 4 view ulong, 5 edit uchar, 6 view uchar; 0 when refused.
fn pkind ty ulong nt ulong to ulong
if eq tkis ty 10 5 1
ret 1
end
if eq tkis ty 15 4 1
ret 2
end
w = ulong 0
if eq tkis ty 6 4 1
w = 1
else
if ne tkis ty 2 4 1
ret 0
end
end
if ge add ty 2 nt
ret 0
end
el = add ty 1
if eq tkis el 10 5 1
ret add 3 w
end
if eq tkis el 19 5 1
ret add 5 w
end
ret 0
end
note cidr: 1 when bytes s .. e-1 form a C identifier ([A-Za-z_][A-Za-z0-9_]*), else 0.
fn cidr s ulong e ulong to ulong
if ge s e
ret 0
end
for j ulong sub e s
c = get inb add s j
ok = ulong 0
if eq c 95
ok = 1
end
if and ge c 97 le c 122
ok = 1
end
if and ge c 65 le c 90
ok = 1
end
if and gt j 0 and ge c 48 le c 57
ok = 1
end
if eq ok 0
ret 0
end
end
ret 1
end
note lensuf: 1 when bytes s .. e-1 end in "_len" (the binding names an array length o_<name>_len).
fn lensuf s ulong e ulong to ulong
if lt sub e s 4
ret 0
end
b = sub e 4
if ne get inb b 95
ret 0
end
if ne get inb add b 1 108
ret 0
end
if ne get inb add b 2 101
ret 0
end
if ne get inb add b 3 110
ret 0
end
ret 1
end
note pname: refuse a parameter name that is not a C identifier or ends in "_len".
fn pname s ulong e ulong to void
if eq cidr s e 0
trap 10
end
if eq lensuf s e 1
trap 10
end
end
note samenm: 1 when bytes a .. b-1 equal bytes c .. d-1.
fn samenm a ulong b ulong c ulong d ulong to ulong
if ne sub b a sub d c
ret 0
end
for j ulong sub b a
if ne get inb add a j get inb add c j
ret 0
end
end
ret 1
end
note uname: refuse a unit name (token 1) that is not a C identifier or repeats an earlier unit name.
fn uname to void
s = get tks 1
e = get tke 1
if eq cidr s e 0
trap 10
end
n = get st 4
if ge n 256
trap 10
end
for j ulong n
if eq samenm s e get us j get ue j 1
trap 10
end
end
put us n s
put ue n e
put st 4 add n 1
end
note pparam: record the parameter at token k in slot st 2; return the token after it.
fn pparam k ulong nt ulong to ulong
np = get st 2
if ge np 6
trap 10
end
put ps np get tks k
put pe np get tke k
ki = pkind add k 1 nt
if eq ki 0
trap 10
end
put pk np ki
pname get tks k get tke k
put st 2 add np 1
if le ki 2
ret add k 2
end
ln = tknum add k 3
if or eq ln 0 gt ln 16777216
trap 10
end
put pl np ln
ret add k 4
end
note parse: read the signature line at fl; parameters into ps pe pk pl, their count into st 2,
note 1 or 0 into st 3 for a function with or without a value.
fn parse fl ulong q ulong to void
nt = tokln fl q
if lt nt 4
trap 10
end
if eq tkis 1 28 4 1
trap 10
end
uname
put st 2 0
k = ulong 2
while eq tkis k 0 2 0
if ge add k 1 nt
trap 10
end
k = pparam k nt
if ge k nt
trap 10
end
end
if ne add k 2 nt
trap 10
end
r = add k 1
hv = ulong 2
if or eq tkis r 10 5 1 eq tkis r 15 4 1
hv = 1
end
if eq tkis r 24 4 1
hv = 0
end
if eq hv 2
trap 10
end
put st 3 hv
end
note codelen: the 8-digit code length after the 0 byte at q, checked against the input.
fn codelen q ulong to ulong
t = get st 0
c0 = add q 9
if gt c0 t
trap 10
end
cl = ulong 0
for j ulong 8
d = get inb add add q 1 j
if or lt d 48 gt d 57
trap 10
end
cl = add mul cl 10 ulong sub d 48
end
if or eq cl 0 ne rem cl 4 0
trap 10
end
if gt cl sub t c0
trap 10
end
ret cl
end
note ecode: the embedded machine code, unchanged.
fn ecode c0 ulong cl ulong to void
ofr 0
oname 1
ofr 1
oname 1
ofr 2
oname 1
ofr 3
for j ulong cl
if gt j 0
ob uchar 44
end
ohex get inb add c0 j
end
ofr 24
oname 1
ofr 25
oname 1
ofr 26
oname 1
ofr 27
oname 1
ofr 4
oname 1
ofr 5
oname 1
end
note esig: the exported C parameter list.
fn esig to void
ofr 6
for j ulong get st 2
x = get pk j
if le x 2
ofr 7
opn j
else
if or eq x 3 eq x 5
ofr 8
else
ofr 9
end
opn j
ofr 7
opn j
ofr 10
end
end
end
note earr: the checks and argument word for array parameter j of kind x.
fn earr j ulong x ulong to void
ofr 12
opn j
ofr 13
opn j
ofr 14
odec get pl j
ofr 15
if le x 4
odec 8
else
odec 1
end
ofr 15
if or eq x 3 eq x 5
odec 1
else
odec 0
end
ofr 16
odec j
ofr 17
opn j
ofr 18
end
note ebody: argument words, overlap check and the call.
fn ebody to void
ofr 11
for j ulong get st 2
x = get pk j
if le x 2
ofr 19
odec j
ofr 20
opn j
ofr 18
else
earr j x
end
end
ofr 21
oname 1
ofr 22
odec get st 3
ofr 23
end
note unit: accept the unit at p, emit its C, return where the next unit starts.
fn unit p ulong to ulong
q = sepat p
fl = sigln p q
parse fl q
cl = codelen q
c0 = add q 9
ecode c0 cl
esig
ebody
ret add c0 cl
end
note slurp: all of stdin into inb; refuse input that fills the pool.
fn slurp to ulong
t = ulong 0
k = read 0 inb 0 len inb
while gt k 0
t = add t ulong k
k = long 0
if lt t len inb
k = read 0 inb t sub len inb t
end
end
if lt k 0
trap 11
end
if ge t len inb
trap 6
end
ret t
end
fn main to int
t = slurp
put st 0 t
put st 1 0
put st 4 0
opre
p = ulong 0
nu = ulong 0
while lt p t
p = unit p
nu = add nu 1
end
if eq nu 0
trap 10
end
o = ulong 0
m = get st 1
while lt o m
w = write 1 outb o sub m o
if le w 0
ret 1
end
o = add o ulong w
end
ret 0
end

