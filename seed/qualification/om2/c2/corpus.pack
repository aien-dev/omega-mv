put x c 1 3.5
if ne bitcast ulong get x a 4609434218613702656
ret 1
end
if ne bitcast uint get x b 1075838976
ret 2
end
if ne bitcast uint get x c 1 1080033280
ret 3
end
r = total x
if ne int mul r 2.0 8
ret 4
end
ret 0
end

