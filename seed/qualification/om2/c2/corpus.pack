put lno 0 ln
e = lineend p
if tokenize p e
if gt get ntk 0 0
if ne get lst get tko 0 35
docase
end
end
else
put ntk 0 1
put tkl 0 0
put gst 0 20
invalid
end
p = add e 1
end
if ne get sb 0 0
say 1
wordat 7
r = write 1 words get wpos 0 get wpos 1
say 4
say 51
newline
put cnt 2 add get cnt 2 1
end
end
fn summary to int
