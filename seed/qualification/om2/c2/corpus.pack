fail 17
end
n = get ir_no 0
if ge n 256
fail 14
end
put ir_ok n 11
put ir_oa n dst
put ir_ob n callee
put ir_oc n nargs
put ir_od n 0
put ir_obl n get ir_cur 0
j = ulong 0
while lt j nargs
put ir_oarg add mul n 6 j get ir_args j
j = add j 1
end
put ir_no 0 add n 1
end

fn ir_name to void
e = ir_find get tw 0
if eq e 0
e = findname get tw 0
if ne e 0
if eq get nm_kind sub e 1 9
t = ulong get nm_type sub e 1
if ge t 10
fail 9
end
r = ir_lit get nm_addr sub e 1 t
ir_set 65534 r t
ret
end
end
