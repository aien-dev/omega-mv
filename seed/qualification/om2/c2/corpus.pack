fd = popen 524288
if lt fd 0
ret false
end
n = ulong 0
while lt n len lst
x = read fd lst n sub len lst n
if le x 0
fclo fd
put lsn 0 n
ret eq x 0
end
n = add n ulong x
end
x = read fd buf 0 1
fclo fd
put lsn 0 n
ret eq x 0
end
