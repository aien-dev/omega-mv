if eq get dead 0 0
if ne get curret 0 10
fail 18
end
epi
end
nt0 = get nt 0
if ne nt0 0
tail = get oc 0
if eq get progmode 0 0
emit 2852586464
emit 4181723376
emit 3592356352
else
emit 2432798752
emit 3531606952
emit 3556769793
