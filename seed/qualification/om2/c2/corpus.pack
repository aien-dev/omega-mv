fail 17
end
n = get ir_no 0
if ge n 256
fail 14
end
put ir_ok n uchar k
put ir_oa n a
put ir_ob n b
put ir_oc n c
put ir_od n d
put ir_obl n get ir_cur 0
put ir_no 0 add n 1
end

fn ir_lit mag ulong ty ulong to ulong
i = ulong 0
n = get ir_nc 0
while lt i n
if and eq ulong get ir_cty i ty eq get ir_cm i mag
ret ulong get ir_cr i
end
i = add i 1
end
if ge n 32
fail 14
end
r = ir_newreg ty
put ir_cty n uchar ty
put ir_cm n mag
put ir_cr n uchar r
put ir_nc 0 add n 1
ret r
end

fn ir_find w ulong to ulong
