fal = get cnt 1
inv = get cnt 2
nr = get cnt 3
tot = add add add pas fal inv nr
rc = int 0
s = ulong 25
if gt nr 0
rc = 2
s = ulong 28
end
if gt fal 0
rc = 1
s = ulong 26
end
if or or gt inv 0 eq tot 0 eq get idok 0 0
rc = 3
s = ulong 27
end
say s
say 29
num tot
say 30
num pas
say 31
num fal
say 32
num inv
say 33
num nr
if eq tot 0
say 52
end
newline
ret rc
end
