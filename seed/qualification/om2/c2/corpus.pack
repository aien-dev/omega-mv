fn parsenum n ulong want ulong to bool
m = ulong not uint 0
k = ulong 0
v = ulong 0
nd = ulong 0
for i ulong n
c = get buf i
if and ge c 48 le c 57
if ge nd 10
ret false
end
v = add mul v 10 ulong sub c 48
nd = add nd 1
else
if or ne c 10 eq nd 0
ret false
end
if ge k want
ret false
end
if gt v m
ret false
end
put nums k v
k = add k 1
v = ulong 0
nd = ulong 0
end
end
ret and eq nd 0 eq k want
end
