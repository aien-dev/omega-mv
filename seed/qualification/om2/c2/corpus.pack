put ir_rr 0 r
put ir_vt 0 ty
ret
end
d = dst
if eq dst 65535
d = ir_newreg ty
end
ir_op 2 d r 0 0
put ir_rr 0 d
put ir_vt 0 ty
end

fn ir_ord id ulong to ulong
ret get ir_bord id
end

fn ir_count k ulong to ulong
n = ulong 0
if eq k 0
n = get ir_nc 0
end
i = ulong 0
while lt i get ir_no 0
if eq ir_ord get ir_obl i k
n = add n 1
end
i = add i 1
