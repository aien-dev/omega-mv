#### c2-00077 sha256=dd19f2b1be45c381db256571a5d48d13c926c06e864bd256b10eeb83e4579693 len=182
note continue in a while jumps to the head: 1 + 2 + 4 + 5 + 6 = 18
fn main to ulong
i = ulong 0
s = ulong 0
while lt i 6
i = add i 1
if eq i 3
continue
end
s = add s i
end
ret s
end

#### c2-00078 sha256=b4f64b0fce985d9a5f51d78d031212db57db667edcea9f4f8af911de4e201215 len=182
note continue in a for jumps to the increment, so the loop still advances: 0+1+2+4+5 = 12
fn main to ulong
