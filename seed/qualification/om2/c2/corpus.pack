fn lineend p ulong to ulong
n = get lsn 0
for i ulong sub n p
if eq get lst add p i 10
ret add p i
end
end
ret n
end
fn tokenize p ulong e ulong to bool
put ntk 0 0
s = p
inw = false
for i ulong sub e p
c = get lst add p i
if eq c 32
if inw
k = get ntk 0
put tkl k sub add p i s
put ntk 0 add k 1
inw = false
end
else
if not inw
if ge get ntk 0 len tko
ret false
end
put tko get ntk 0 add p i
s = add p i
inw = true
end
end
end
if inw
k = get ntk 0
put tkl k sub e s
put ntk 0 add k 1
end
ret true
end
fn runlist to void
