b = new uchar 21 10
p = ulong 20
x = v
go = true
while go
p = sub p 1
put b p add uchar rem x 10 48
x = div x 10
if eq x 0
go = false
end
end
w = write 1 b p sub 21 p
end
fn puth v ulong to void
b = new uchar 17 10
for i ulong 16
s = mul sub 15 i 4
put b i get prhex and shr v s 15
end
w = write 1 b 0 17
end

