fn mputb b uchar to void
m = get mc 0
put msg m b
put mc 0 add m 1
end

fn mputn v ulong to void
d = new uchar 20 0
i = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0
put d i uchar add rem x 10 48
x = div x 10
i = add i 1
end
j = i
while gt j 0
j = sub j 1
mputb get d j
end
end

