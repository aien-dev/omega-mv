end
end
note ---- fixed words and tokens ---------------------------------------------------------------
fn wordat id ulong to void
k = ulong 1
s = ulong 0
for i ulong len words
if eq get words i 10
if eq k id
put wpos 0 s
put wpos 1 sub i s
ret
end
k = add k 1
s = add i 1
end
end
exit 99
end
fn tokpre t ulong id ulong to bool
wordat id
n = get wpos 1
if lt get tkl t n
ret false
end
o = get tko t
s = get wpos 0
for i ulong n
if ne get lst add o i get words add s i
ret false
end
end
ret true
end
fn tokword t ulong id ulong to bool
wordat id
if ne get tkl t get wpos 1
ret false
end
ret tokpre t id
end
note decimal digits lst[o .. o+n); malformed or overflowing text marks the case malformed
fn decat o ulong n ulong to ulong
if or eq n 0 gt n 20
setbad 20
ret 0
end
m = not ulong 0
v = ulong 0
for i ulong n
c = get lst add o i
if or lt c 48 gt c 57
setbad 20
ret 0
end
d = ulong sub c 48
if gt v div sub m d 10
setbad 20
ret 0
end
v = add mul v 10 d
end
ret v
end
note field k (0-based) of the ':'-separated fields after the first skip bytes of token t
fn fieldat t ulong skip ulong k ulong to ulong
o = add get tko t skip
e = add get tko t get tkl t
f = ulong 0
s = o
for i ulong sub e o
if eq get lst add o i 58
if eq f k
ret decat s sub add o i s
end
f = add f 1
s = add add o i 1
end
end
if eq f k
ret decat s sub e s
end
setbad 20
ret 0
end
fn fields t ulong skip ulong to ulong
f = ulong 1
o = add get tko t skip
for i ulong sub get tkl t skip
if eq get lst add o i 58
f = add f 1
end
end
ret f
end
note ---- paths and child argument lists --------------------------------------------------------
fn pclear to void
put pn 0 0
end
fn pbyte b uchar to void
n = get pn 0
if ge n 4095
setbad 22
ret
end
put pb n b
put pn 0 add n 1
end
fn pword id ulong to void
wordat id
s = get wpos 0
for i ulong get wpos 1
pbyte get words add s i
end
end
fn plst o ulong n ulong to void
for i ulong n
pbyte get lst add o i
end
end
fn pnum v ulong to void
n = decimal v
for i ulong n
pbyte get dig sub sub n i 1
end
end
fn pomc to void
pclear
for i ulong get omn 0
pbyte get omc i
end
end
fn pccp to void
pclear
for i ulong get ccn 0
pbyte get ccp i
end
end
note SCRATCH/<line>.<word id>, with ".b" appended while sx[0] is set (the second source of `same`)
fn pfile id ulong to void
pclear
for i ulong get scn 0
pbyte get scr i
end
pnum get lno 0
pword id
if ne get sx 0 0
pword 32
end
end
fn popen fl int to int
if ne get gst 0 0
ret -1
end
r = fopen pb 0 get pn 0 fl 384
if lt r 0
ret -1
end
ret int r
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
fn aclear to void
put ap 0 2
put ap 1 0
end
fn ahead n ulong to bool
p = get ap 0
if or gt add add p n 2 len av ge get ap 1 64
setbad 22
ret false
end
put av p uchar and n 255
put av add p 1 uchar shr n 8
put ap 0 add p 2
put ap 1 add get ap 1 1
ret true
end
fn apb to void
n = get pn 0
if ahead n
p = get ap 0
for i ulong n
put av add p i get pb i
end
put ap 0 add p n
end
end
fn atok t ulong to void
n = get tkl t
o = get tko t
if ahead n
p = get ap 0
for i ulong n
put av add p i get lst add o i
end
put ap 0 add p n
end
end
note ---- children ------------------------------------------------------------------------------
fn redir s int d int to void
if ne s d
if ne dupfd s d 0 long d
exit 127
end
end
end
fn reap pid int to ulong
t0 = monons
while true
r = waitpid pid stb 0 len stb 1
if eq r long pid
if ne get stb 0 0
put wlow 0 ulong get stb 0
setbad 18
ret 0
end
x = ulong get stb 1
if eq x 127
setbad 23
end
ret x
end
if lt r 0
setbad 22
ret 0
end
now = monons
if or lt now t0 gt sub now t0 get dl 0
r = killpid pid 9
r = waitpid pid stb 0 len stb 0
put wlow 0 ulong get stb 0
setbad 19
ret 0
end
if ne sleepns 1000000 0
setbad 22
ret 0
end
end
exit 99
end
fn spawn fi int fo int fe int to ulong
newline
if ne get gst 0 0
fclo fi
fclo fo
fclo fe
ret 0
end
put av 0 uchar and get ap 1 255
put av 1 uchar shr get ap 1 8
pid = fork
if lt pid 0
fclo fi
fclo fo
fclo fe
setbad 22
ret 0
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog av 0 get ap 0
exit 127
end
fclo fi
fclo fo
fclo fe
ret reap int pid
end
note compile SCRATCH/<line>.src with the pinned omc (pinned true) or the current compiler
fn compile pinned bool to ulong
aclear
say 39
if pinned
pomc
else
pccp
end
showpb
apb
say 40
pfile 16
showpb
fi = popen 524288
say 41
pfile 17
showpb
fo = popen 524481
say 42
pfile 19
showpb
fe = popen 524481
ret spawn fi fo fe
end
fn stdinpath t ulong to void
pclear
if tokword t 9
pword 28
ret
end
if tokpre t 10
plst add get tko t 5 sub get tkl t 5
ret
end
pfile 20
end
fn runprog to ulong
aclear
say 39
pfile 17
showpb
apb
for j ulong sub get ntk 0 7
space
showtok add j 7
atok add j 7
end
say 40
stdinpath 3
showpb
fi = popen 524288
say 41
pfile 23
showpb
fo = popen 524481
say 42
pfile 24
showpb
fe = popen 524481
ret spawn fi fo fe
end
note ---- file helpers --------------------------------------------------------------------------
fn rfulla fd int to long
n = ulong 0
while lt n len buf
r = read fd buf n sub len buf n
if lt r 0
ret r
end
if eq r 0
ret long n
end
n = add n ulong r
end
ret long n
end
fn rfullb fd int to long
n = ulong 0
while lt n len oth
r = read fd oth n sub len oth n
if lt r 0
ret r
end
if eq r 0
ret long n
end
n = add n ulong r
end
ret long n
end
fn firstdif m ulong to ulong
for i ulong m
if ne get buf i get oth i
ret i
end
end
ret m
end
note first differing byte of two scratch files, or not 0 when they are equal; file b carries the
note ".b" suffix when sx[1] is set
fn diffat a ulong b ulong to ulong
pfile a
fa = popen 524288
put sx 0 get sx 1
pfile b
put sx 0 0
fb = popen 524288
if or lt fa 0 lt fb 0
fclo fa
fclo fb
setbad 22
ret 0
end
off = ulong 0
while true
ra = rfulla fa
rb = rfullb fb
if or lt ra 0 lt rb 0
fclo fa
fclo fb
setbad 22
ret 0
end
m = ulong ra
if lt rb ra
m = ulong rb
end
d = firstdif m
if lt d m
fclo fa
fclo fb
ret add off d
end
if or ne ra rb eq ra 0
fclo fa
fclo fb
if eq ra rb
ret not ulong 0
end
ret add off m
end
off = add off m
end
exit 99
end
fn copyfd s int d int to void
while true
r = rfulla s
if lt r 0
setbad 21
ret
end
if eq r 0
ret
end
if ne write d buf 0 ulong r r
setbad 22
ret
end
end
end
note compiler output: ELF magic, then made executable (0700); false when it is not an ELF file
fn elfok to bool
pfile 17
fd = popen 524288
if lt fd 0
setbad 22
ret false
end
r = read fd buf 0 4
ok = eq r 4
if ok
m1 = and eq get buf 0 127 eq get buf 1 69
m2 = and eq get buf 2 76 eq get buf 3 70
ok = and m1 m2
end
if ok
if ne fchmod fd 448 0
setbad 22
end
end
fclo fd
ret ok
end
fn isempty id ulong to bool
pfile id
fd = popen 524288
if lt fd 0
setbad 22
ret false
end
r = read fd buf 0 1
fclo fd
ret eq r 0
end
note does SCRATCH/<line>.cerr contain "error CODE" not followed by another digit
fn names code ulong to bool
pfile 19
fd = popen 524288
if lt fd 0
setbad 22
ret false
end
r = rfulla fd
fclo fd
if lt r 0
setbad 22
ret false
end
wordat 25
s = get wpos 0
k = get wpos 1
for i ulong k
put oth i get words add s i
end
n = decimal code
for i ulong n
put oth add k i get dig sub sub n i 1
end
k = add k n
hay = ulong r
for i ulong hay
if le add i k hay
if hasat i k
if eq add i k hay
ret true
end
c = get buf add i k
if or lt c 48 gt c 57
ret true
end
end
end
end
ret false
end
fn hasat i ulong k ulong to bool
for j ulong k
if ne get buf add i j get oth j
ret false
end
end
ret true
end
note ---- inputs and expectations ---------------------------------------------------------------
fn splitmix to ulong
s = add get rz 0 11400714819323198485
put rz 0 s
z = mul xor s shr s 30 13787848793156543929
z = mul xor z shr z 27 10723151780598845931
ret xor z shr z 31
end
fn genone kind ulong a ulong i ulong to uchar
if eq kind 12
ret uchar a
end
if eq kind 13
ret uchar rem i 251
end
j = rem i 8
if eq j 0
put rz 1 splitmix
end
ret uchar and shr get rz 1 mul j 8 255
end
fn genbytes fd int kind ulong a ulong n ulong to void
put rz 0 a
done = ulong 0
while lt done n
c = sub n done
if gt c len buf
c = len buf
end
for i ulong c
put buf i genone kind a add done i
end
if ne write fd buf 0 c long c
setbad 22
ret
end
done = add done c
end
end
fn geninput t ulong to void
if tokword t 9
ret
end
if tokpre t 10
stdinpath t
fd = popen 524288
if lt fd 0
setbad 21
end
fclo fd
ret
end
kind = ulong 0
a = ulong 0
n = ulong 0
if tokpre t 12
if ne fields t 4 2
setbad 20
end
kind = ulong 12
a = fieldat t 4 0
n = fieldat t 4 1
if gt a 255
setbad 20
end
end
if tokpre t 13
if ne fields t 4 1
setbad 20
end
kind = ulong 13
n = fieldat t 4 0
end
if tokpre t 14
if ne fields t 4 2
setbad 20
end
kind = ulong 14
a = fieldat t 4 0
n = fieldat t 4 1
end
if or eq kind 0 gt n 1073741824
setbad 20
end
pfile 20
fd = popen 524481
if ge fd 0
genbytes fd kind a n
end
fclo fd
end
note SCRATCH/<line>.<id> from an expectation word: -, file:PATH, has:PATH (a copy, compared line by
note line), line:TEXT or err:LINE:CODE (the human diagnostic "omc: line LINE: error CODE")
fn mkexp t ulong id ulong to void
pfile id
fo = popen 524481
if lt fo 0
setbad 22
ret
end
if tokword t 9
fclo fo
ret
end
if or or tokpre t 10 tokpre t 36 tokpre t 37
k = ulong 5
if or tokpre t 36 tokpre t 37
k = ulong 4
end
pclear
plst add get tko t k sub get tkl t k
fi = popen 524288
if lt fi 0
setbad 21
else
copyfd fi fo
end
fclo fi
fclo fo
ret
end
if tokpre t 11
n = sub get tkl t 5
o = add get tko t 5
for i ulong n
put buf i get lst add o i
end
put buf n 10
if ne write fo buf 0 add n 1 long add n 1
setbad 22
end
fclo fo
ret
end
if tokpre t 33
if ne fields t 4 2
setbad 20
fclo fo
ret
end
n = bufword 0 34
n = bufnum n fieldat t 4 0
n = bufword n 35
n = bufnum n fieldat t 4 1
put buf n 10
if eq get gst 0 0
if ne write fo buf 0 add n 1 long add n 1
setbad 22
end
end
fclo fo
ret
end
setbad 20
fclo fo
end
fn bufword n ulong id ulong to ulong
wordat id
s = get wpos 0
k = get wpos 1
for i ulong k
put buf add n i get words add s i
end
ret add n k
end
fn bufnum n ulong v ulong to ulong
k = decimal v
for i ulong k
put buf add n i get dig sub sub k i 1
end
ret add n k
end
note has: every LF-terminated line of SCRATCH/<line>.eexp is a whole line of SCRATCH/<line>.cerr;
note tok (tm): every such line has all its space-separated words, as whole words, in one stderr
note line. Not 0 when so, else the 1-based number of the first expected line not found
fn hasall tm bool to ulong
pfile 19
fa = popen 524288
pfile 22
fb = popen 524288
if or lt fa 0 lt fb 0
fclo fa
fclo fb
setbad 22
ret 0
end
ra = rfulla fa
rb = rfullb fb
fclo fa
fclo fb
if or or lt ra 0 lt rb 0 or ge ra long len buf ge rb long len oth
setbad 21
ret 0
end
na = ulong ra
nb = ulong rb
s = ulong 0
ln = ulong 0
for i ulong nb
if eq get oth i 10
ln = add ln 1
found = false
if tm
found = tokline na s sub i s
else
found = hasline na s sub i s
end
if not found
ret ln
end
s = add i 1
end
end
if ne s nb
setbad 20
ret 0
end
ret not ulong 0
end
fn eqat p ulong s ulong k ulong to bool
for j ulong k
if ne get buf add p j get oth add s j
ret false
end
end
ret true
end
note does buf[p-1] equal c, or is p the lower bound b
fn startat p ulong b ulong c uchar to bool
if eq p b
ret true
end
ret eq get buf sub p 1 c
end
fn hasline na ulong s ulong k ulong to bool
if gt k na
ret false
end
for p ulong add sub na k 1
if startat p 0 10
if or eq add p k na eq get buf add p k 10
if eqat p s k
ret true
end
end
end
end
ret false
end
fn tokline na ulong s ulong k ulong to bool
ls = ulong 0
for i ulong add na 1
if or eq i na eq get buf i 10
if alltoks ls i s k
ret true
end
ls = add i 1
end
end
ret false
end
fn alltoks lb ulong lz ulong s ulong k ulong to bool
ts = s
for i ulong add k 1
if or eq i k eq get oth add s i 32
te = add s i
if gt te ts
if not hastok lb lz ts sub te ts
ret false
end
end
ts = add te 1
end
end
ret true
end
fn hastok lb ulong lz ulong ts ulong tl ulong to bool
if gt tl sub lz lb
ret false
end
for q ulong add sub sub lz lb tl 1
if startat add lb q lb 32
if endat add add lb q tl lz 32
if eqat add lb q ts tl
ret true
end
end
end
end
ret false
end
note is e the upper bound z, or does buf[e] equal c
fn endat e ulong z ulong c uchar to bool
if eq e z
ret true
end
ret eq get buf e c
end
note ---- case sources --------------------------------------------------------------------------
note one +-separated SRC segment lst[o .. o+n): a path, pack:PATH:OFF:LEN (LEN bytes of PATH from byte
note OFF) or cyc:PATH:N (N bytes repeating the contents of PATH, 1..65535 bytes); appended to big
fn addpart o ulong n ulong to void
if segpre o n 39
addpack add o 5 sub n 5
ret
end
if segpre o n 38
addcyc add o 4 sub n 4
ret
end
addfile o n
end
fn segpre o ulong n ulong id ulong to bool
wordat id
k = get wpos 1
if lt n k
ret false
end
s = get wpos 0
for i ulong k
if ne get lst add o i get words add s i
ret false
end
end
ret true
end
note offset of the last ':' in lst[o .. o+n), or n when there is none
fn lastcol o ulong n ulong to ulong
i = n
while gt i 0
i = sub i 1
if eq get lst add o i 58
ret i
end
end
ret n
end
fn addpack o ulong n ulong to void
q = lastcol o n
if ge q n
setbad 20
ret
end
p = lastcol o q
if ge p q
setbad 20
ret
end
k = decat add add o q 1 sub sub n q 1
off = decat add add o p 1 sub sub q p 1
if ne get gst 0 0
ret
end
if gt k sub len big get bgn 0
setbad 21
ret
end
pclear
plst o p
fd = popen 524288
if lt fd 0
setbad 21
ret
end
ok = preadall fd off k
fclo fd
if not ok
setbad 21
ret
end
put bgn 0 add get bgn 0 k
end
note k bytes of fd from position off to big at bgn
fn preadall fd int off ulong k ulong to bool
b = get bgn 0
done = ulong 0
while lt done k
c = sub k done
if gt c 1048576
c = ulong 1048576
end
r = pread fd big add b done c long add off done
if le r 0
ret false
end
done = add done ulong r
end
ret true
end
fn addcyc o ulong n ulong to void
q = lastcol o n
if ge q n
setbad 20
ret
end
k = decat add add o q 1 sub sub n q 1
if ne get gst 0 0
ret
end
if gt k sub len big get bgn 0
setbad 21
ret
end
pclear
plst o q
fd = popen 524288
if lt fd 0
setbad 21
ret
end
r = rfullb fd
fclo fd
if or le r 0 ge r long len oth
setbad 21
ret
end
cycfill ulong r k
end
note big[bgn .. bgn+k) = oth[i mod m], in 65536-byte rows (a loop with a value count traps 4 after
note 1000000 passes)
fn cycfill m ulong k ulong to void
b = get bgn 0
for r ulong add div k 65536 1
s = mul r 65536
c = sub k s
if gt c 65536
c = ulong 65536
end
cycrow b s c m
end
put bgn 0 add b k
end
fn cycrow b ulong s ulong c ulong m ulong to void
for i ulong c
put big add add b s i get oth rem add s i m
end
end
fn addfile o ulong n ulong to void
pclear
plst o n
fd = popen 524288
if lt fd 0
setbad 21
ret
end
while true
b = get bgn 0
c = sub len big b
if gt c len buf
c = len buf
end
if eq c 0
r = read fd buf 0 1
if ne r 0
setbad 21
end
fclo fd
ret
end
r = read fd big b c
if lt r 0
setbad 21
fclo fd
ret
end
if eq r 0
fclo fd
ret
end
put bgn 0 add b ulong r
end
end
fn matchat p ulong to bool
for j ulong get sb 1
if ne get big add p j get sfr j
ret false
end
end
ret true
end
note matches of sfr in big[base .. base+c): count in res 6, last position in res 7
fn scanchnk base ulong c ulong to void
for i ulong c
if eq get big add base i get sfr 0
if matchat add base i
put res 6 add get res 6 1
put res 7 add base i
end
end
end
end
note exact-once position of sfr in big; otherwise the match count goes to wlow with gst 47
fn findonce to ulong
fl = get sb 1
n = get bgn 0
put res 6 0
put res 7 0
if ge n fl
last = sub n fl
base = ulong 0
while le base last
c = add sub last base 1
if gt c 65536
c = ulong 65536
end
scanchnk base c
base = add base c
end
end
if ne get res 6 1
put wlow 0 get res 6
setbad 47
end
ret get res 7
end
fn wbig fd int o ulong n ulong to void
if ne write fd big o n long n
setbad 22
end
end
fn mksrc t ulong to void
put bgn 0 0
o = get tko t
e = add o get tkl t
s = o
for i ulong get tkl t
if eq get lst add o i 43
addpart s sub add o i s
s = add add o i 1
end
end
addpart s sub e s
pfile 16
fd = popen 524481
if lt fd 0
setbad 22
put sb 0 0
ret
end
if ne get sb 0 0
put sb 0 0
p = findonce
if eq get gst 0 0
say 48
num p
newline
wbig fd 0 p
if ne write fd sto 0 get sb 2 long get sb 2
setbad 22
end
q = add p get sb 1
wbig fd q sub get bgn 0 q
end
else
wbig fd 0 get bgn 0
end
fclo fd
end
note ---- SHA-256 (FIPS 180-4) for compiler identity only ---------------------------------------
fn rotr x uint n uint to uint
ret or shr x n shl x sub 32 n
end
fn shasched to void
for i ulong 16
b = mul i 4
v = shl uint get blk b 24
v = or v shl uint get blk add b 1 16
v = or v shl uint get blk add b 2 8
v = or v uint get blk add b 3
put ws i v
end
for j ulong 48
q = add j 16
x = get ws sub q 15
y = get ws sub q 2
s0 = xor xor rotr x 7 rotr x 18 shr x 3
s1 = xor xor rotr y 17 rotr y 19 shr y 10
put ws q add add add get ws sub q 16 s0 get ws sub q 7 s1
end
end
fn shat1 i ulong to uint
e = get st 4
s1 = xor xor rotr e 6 rotr e 11 rotr e 25
ch = xor and e get st 5 and not e get st 6
ret add add add add get st 7 s1 ch get kk i get ws i
end
fn shat2 to uint
a = get st 0
b = get st 1
c = get st 2
s0 = xor xor rotr a 2 rotr a 13 rotr a 22
mj = xor xor and a b and a c and b c
ret add s0 mj
end
fn shacomp to void
shasched
for i ulong 8
put st i get hv i
end
for i ulong 64
t1 = shat1 i
t2 = shat2
put st 7 get st 6
put st 6 get st 5
put st 5 get st 4
put st 4 add get st 3 t1
put st 3 get st 2
put st 2 get st 1
put st 1 get st 0
put st 0 add t1 t2
end
for i ulong 8
put hv i add get hv i get st i
end
end
fn shabyte b uchar to void
n = get bk 0
put blk n b
n = add n 1
if eq n 64
shacomp
n = ulong 0
end
put bk 0 n
put bk 1 add get bk 1 1
end
fn hexch v uint to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end
fn shafinal to void
bits = mul get bk 1 8
shabyte 128
while ne get bk 0 56 bound 64
shabyte 0
end
for i ulong 8
shabyte uchar and shr bits mul sub 7 i 8 255
end
for i ulong 8
v = get hv i
for j ulong 8
put hexd add mul i 8 j hexch and shr v mul sub 7 j 4 15
end
end
end
note hash the file named by pb into hexd; false when it cannot be read
fn hashfile to bool
fd = popen 524288
if lt fd 0
ret false
end
for i ulong 8
put hv i get ivs i
end
put bk 0 0
put bk 1 0
while true
r = read fd buf 0 len buf
if lt r 0
fclo fd
ret false
end
if eq r 0
fclo fd
shafinal
ret true
end
