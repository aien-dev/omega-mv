for i ulong np
hload x i i
end
if eq c 106
hload x 1 3
matconst 1 0
matconst 2 0
end
if eq c 107
matconst 0 17
for i ulong 5
matconst add i 1 0
end
end
hsys hsysno c
hreturn dst x
end
fn hclock c ulong dst ulong x ulong to void
