badcc = compile cc src 0
sample = fixture gen 0 262144
elf = compile badcc sample 0
decode checker elf 61
refused = compile cc sample 24
end
fn oracle cc ulong checker ulong to void
gen = compile cc 16 0
for i ulong 7
p = params uchar i 0 1
command gen
sample = run p 0
command checker
wanted = ulong 62
if eq i 0
wanted = ulong 0
end
if eq i 5
wanted = ulong 61
end
result = run sample wanted
end
end
