ra = matreg get rk 0 get rv 0 ty
rd = destreg dst
if eq c 50
if eq ty 1
e3 3527409664 rd ra 0
else
if eq ty 4
e3 706741216 rd 0 ra
else
e3 2854224864 rd 0 ra
if lt ty 6
canon rd ty
end
end
end
else
if eq ty 1
fail 7
end
if eq ty 9
e3 3942646752 rd 0 ra
trapc 6 1
else
if eq ty 4
e3 1258292192 rd 0 ra
else
e3 3405775840 rd 0 ra
if lt ty 6
canon rd ty
else
chkext rd ty 1
end
end
end
end
put rk 0 1
put rv 0 rd
put rt 0 ty
