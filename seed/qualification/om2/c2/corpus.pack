put out 0 uchar x
w = write 1 out 0 1
ret x
end
fn pick a ulong b ulong to ulong
ret sub b a
end
fn main to int
a = new ulong 100 0
put a mark 65 mark 66
ret int get a 65
end

#### c2-00294 sha256=67f4c582862c7151fd1f0c507b5e9f50d71c835dec866b16dd05d86304160104 len=236
global out uchar 1
fn mark x ulong to ulong
put out 0 uchar x
w = write 1 out 0 1
ret x
end
fn pick a ulong b ulong to ulong
ret sub b a
end
fn boom to ulong
x = ulong 0
ret div x x
end
fn main to int
x = add boom mark 65
ret int x
end

#### c2-00295 sha256=e12324d00566ed3c56c4043ed108a4bf6d2cb433982c11ca2dc83003aeefec74 len=101
fn main to int
s = ulong 0
for i ulong 3
s = add s i
end
for j ulong 4
s = add s j
end
ret int s
end

#### c2-00296 sha256=efe5b555293ac23f0f3a6ece186f26a1cf1e85e0e007051dc7bff6d4ff9efa25 len=132
fn big n ulong to ulong
x = new ulong 500000 0
put x 499999 n
put x 0 add n 1
if eq n 0
trap 3
end
ret add get x 0 get x 499999
end

#### c2-00297 sha256=ab8ac8a7cd6129c802a46e93d9d74ff3998b5673e61929b2be23f945ec80cb87 len=194
note writes 11 and 22 into buf, traps 3 when k is 1, else writes 33 and returns 3
fn fill buf edit ulong 4 k ulong to ulong
put buf 0 11
put buf 1 22
if eq k 1
trap 3
end
put buf 2 33
ret 3
end

#### c2-00298 sha256=38a27f10bed8c3efcbb1b5cf7f5b8aadcef92d3bc4b472655cffe513f5254886 len=402
note hsum: a unit with private helpers. The compiler enters a function-mode unit at its last function
note (word 0 branches there), so only that function is bound; sq and cap are internal calls.
fn sq x ulong to ulong
ret mul x x
end

fn cap x ulong to ulong
if gt x 1000000
trap 9
end
ret x
end

fn hsum a view uchar 4 b ulong to ulong
s = b
for i ulong 4
s = add s sq ulong get a i
end
ret cap s
end

#### c2-00299 sha256=bdf0f55318ab9b9e85a93c1a4d0722912542233b40fdb930cbd2848d5be92a51 len=136
note (a * b + c) modulo 2^64: ulong mul and add wrap by definition
fn madd a ulong b ulong c ulong to ulong
p = mul a b
ret add p c
end

#### c2-00300 sha256=f0f644177343e1a62312ce5c1fdb4ad5cfb2f76cd97650306661ffc7a68f6702 len=158
fn mix a ulong b long c view uchar 3 d edit uchar 2 e view ulong 2 f ulong to void
put d 0 get c 2
put d 1 uchar add a add get e 1 f
if lt b 0
trap 9
end
end

#### c2-00301 sha256=eb0aad938117ea324c5a90362261d08b5d325822ff71ad2274ff9ee9bb523038 len=123
note signed (a * b + c): traps 1 when a step leaves long
fn smadd a long b long c long to long
p = mul a b
ret add p c
end

#### c2-00302 sha256=472eddef7d2520b8b12f67468ca98e0ab01f0dc9468a8f9d767b54980da12f27 len=159
note sum of 0 .. n-1 (n at most 1000000): a loop long enough for the reentry test
fn spin n ulong to ulong
s = ulong 0
for i ulong n
s = add s i
end
ret s
end

