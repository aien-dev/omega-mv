note ---- dataflow ----------------------------------------------------------------------------------
fn unh w ulong k ulong to void
if eq get uh w 0
put uh w uchar k
end
end
fn push u ulong to void
if eq get inq u 0
put inq u 1
n = get gv 1
put wl n u
put gv 1 add n 1
end
end
note join the current state cu into word u
fn join u ulong to void
dd = add get cu 2 1
if eq get dep u 0
put rm u get cu 0
put sm u get cu 1
put dep u dd
put fid u get cu 3
push u
ret
end
if ne get dep u dd
unh u 4
ret
end
if ne get fid u get cu 3
unh u 5
ret
end
a = or get rm u get cu 0
b = or get sm u get cu 1
if or ne a get rm u ne b get sm u
put rm u a
put sm u b
push u
end
end
note an edge from w to u: outside the artifact is unhandled; into the trap stubs it ends the path
fn flow w ulong u ulong to void
if ge u get gv 0
unh w 11
ret
end
if ne get trp u 0
ret
end
join u
end
fn talu to void
r = get cu 0
t = or or tnt r get dc ds1 tnt r get dc ds2 tnt r get dc ds3
fl = get dc dfl
if ne and fl 1 0
t = or t tnt r 31
end
if ne and fl 4 0
t = or t tnt r get dc ddst
end
if ne and fl 2 0
r = sbit r 31 t
end
put cu 0 sbit r get dc ddst t
end
note SP arithmetic: k = bytes / 8 slots shift; the slots that come into view are unknown (DATA)
fn tsp w ulong to void
k = get dc dspo
if eq k 3
unh w 1
ret
end
a = get dc dspa
d = get cu 2
s = get cu 1
q = div a 8
all = not ulong 0
if ne rem a 8 0
q = ulong 64
end
if eq k 1
if gt a d
unh w 12
put cu 2 0
put cu 1 all
ret
end
put cu 2 sub d a
if ge q 64
put cu 1 all
ret
end
if ne q 0
put cu 1 or shr s q not shr all q
end
ret
end
put cu 2 add d a
if ge q 64
put cu 1 all
ret
end
if ne q 0
put cu 1 or shl s q sub shl ulong 1 q 1
end
end
note SP-relative slot range check: below SP or above the function's entry SP is unhandled
fn slotok w ulong off ulong es ulong to bool
if ne shr off 63 0
unh w 14
ret false
end
if gt add off es get cu 2
unh w 3
ret false
end
ret true
end
fn slotld w ulong off ulong es ulong to ulong
if not slotok w off es
ret 1
end
s = get cu 1
t = ulong 0
j = div off 8
e = div add off sub es 1 8
while le j e bound 8
if ge j 64
t = ulong 1
else
t = or t and shr s j 1
end
j = add j 1
end
ret t
end
fn slotst w ulong off ulong es ulong v ulong to void
if not slotok w off es
ret
end
s = get cu 1
j = div off 8
if and and eq rem off 8 0 eq es 8 lt j 64
put cu 1 sbit s j v
ret
end
e = div add off sub es 1 8
while le j e bound 8
if lt j 64
s = sbit s j or v and shr s j 1
end
j = add j 1
end
put cu 1 s
end
fn tslot w ulong to void
off = get dc dmo
es = get dc dms
r = get cu 0
if eq get dc dmk 1
t = slotld w off es
r = sbit r get dc dmt t
if ne get dc dmt2 255
r = sbit r get dc dmt2 slotld w add off es es
end
put cu 0 r
ret
end
slotst w off es tnt r get dc dmt
if ne get dc dmt2 255
slotst w add off es es tnt r get dc dmt2
end
end
fn tmem w ulong to void
mk = get dc dmk
r = get cu 0
if eq mk 3
put cu 0 sbit r get dc dmt 0
ret
end
b = get dc dmb
if eq b 31
