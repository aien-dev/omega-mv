if ne get hostargs 0 0
note Preserve Linux's initial argument stack privately before installing Omega's bounded stack.
emit 2432697339
end
emit 3533832220
emit 3533836304
emit 2432696863
emit or 2483027968 and shr sub get fn_addr sub f 1 get oc 0 2 67108863
if eq get fn_ret sub f 1 10
emit 3531603968
end
emit 3531606952
emit 3556769793
elfhdr
wrword 96 get oc 0
wrword 104 get oc 0
wrword 160 add get poolb 0 8388608
writeout 0
end

note s_eof: end of input: no open function (error 15), some function (16); function mode: no globals or
note texts (9); one function: its bare words; more: the entry word, a B to the last function. om4 S_EOF.
note Resolve every call after all addresses are known. In function mode remove leaves of the call
note graph; any functions left after nf rounds form or reach a cycle (error 9).
fn resolve to void
n = get ncalls 0
i = ulong 0
while lt i n
s = get callsite i
f = sub get callto i 1
wrword s or 2483027968 and shr sub get fn_addr f s 2 67108863
i = add i 1
end
if eq get progmode 0 0
pass = ulong 0
while lt pass get nf 0
f = ulong 0
while lt f get nf 0
if eq get settled f 0
ok = true
i = ulong 0
while and ok lt i n
if eq get callfrom i add f 1
if eq get settled sub get callto i 1 0
ok = false
end
end
i = add i 1
end
if ok
put settled f 1
end
end
f = add f 1
end
pass = add pass 1
end
f = ulong 0
while lt f get nf 0
if eq get settled f 0
fail 9
end
f = add f 1
end
end
end

fn s_eof to void

if ne get curret 0 0
fail 15
end
if eq get nf 0 0
fail 16
end
resolve
if ne get progmode 0 0
eof_prog
end
if ne get nglob 0 0
fail 9
end
if eq get nf 0 1
writeout 180
end
a = get fn_addr sub get lastfn 0 1
wrword 176 or 335544320 and shr sub a 176 2 67108863
writeout 176
end

note stmt: one line. Returns 1 at the end of the input. om4 STMT.
fn stmt to ulong
put nslot 0 get held 0
tok
k = get tk 0
if eq k 0
ret 0
end
if eq k 3
s_eof
ret 1
end
if ne k 1
fail 16
end
if gt get tl 0 8
s_long
ret 0
end
w = get tw 0
c = kw w
if eq c 83
skipnl
ret 0
end
if eq c 64
s_fn
ret 0
end
if eq get curret 0 0
if eq c 78
s_global
ret 0
end
if eq c 79
s_text
ret 0
end
fail 16
end
if eq c 66
s_end
ret 0
end
if eq c 68
s_else
ret 0
end
if ne get dead 0 0
fail 17
end
if eq c 0
s_name w
ret 0
end
if eq c 67
s_if
ret 0
end
if eq c 69
s_while
ret 0
end
if eq c 71
s_for
ret 0
end
if eq c 72
s_ret
ret 0
end
if eq c 80
s_put
ret 0
end
if eq c 82
s_exit
ret 0
end
if or or or eq c 77 eq c 78 eq c 79 eq c 81
fail 9
end
fail 16
ret 0
end

note ======== program mode: some line is `fn main` (blanks, fn, blanks, main, then a blank or the end) ========
note skipbl: the first place at or after q that is not a space or tab (or the end)
fn skipbl q ulong to ulong
e = get inlen 0
p = q
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = get inp p
if or eq b 32 eq b 9
p = add p 1
else
go = false
end
end
m = add m 1
end
end
ret p
end

note skipln: the place after the next newline at or after q (or the end)
fn skipln q ulong to ulong
e = get inlen 0
p = q
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = get inp p
p = add p 1
if eq b 10
go = false
end
end
m = add m 1
end
end
ret p
end

note ps_at: the line's first byte that is not blank is at p: 1 when the line is `fn main`, 2 when the input
note ends while deciding, else 0. om4 PS_LINE .. PS_YES.
fn ps_at p ulong to ulong
e = get inlen 0
if ne get inp p 102
ret 0
end
q = add p 1
if ge q e
ret 2
end
if ne get inp q 110
ret 0
end
r = add q 1
q = skipbl r
if ge q e
ret 2
end
if eq q r
ret 0
end
if gt add q 4 e
ret 0
end
if ne get inp q 109
ret 0
end
if ne get inp add q 1 97
ret 0
end
if ne get inp add q 2 105
ret 0
end
if ne get inp add q 3 110
ret 0
end
if ge add q 4 e
ret 1
end
if gt get inp add q 4 32
ret 0
end
ret 1
end

fn prescan to void
e = get inlen 0
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
p = skipbl p
if ge p e
go = false
else
r = ps_at p
if eq r 1
put progmode 0 1
go = false
end
if eq r 2
go = false
end
if go
p = skipln p
if ge p e
go = false
end
end
end
m = add m 1
end
end
end

note First collect signatures. Only fn headers are parsed here; other lines are read in the body pass.
fn namescan to void
put scanning 0 1
put line 0 1
go = true
while go
n = ulong 0
while and go lt n 999999
tok
if eq get tk 0 3
go = false
else
if ne get tk 0 0
if and eq get tk 0 1 eq get tw 0 28262
s_fn
else
skipnl
end
end
end
n = add n 1
end
end
put scanning 0 0
put cur 0 0
put line 0 1
put nn 0 0
put curfn 0 0
put curret 0 0
put npar 0 0
put nslot 0 0
put held 0 0
end

note main: read all of stdin
note (8 MiB at most, error 14; a read error is 1), find the mode, then one
note statement per line from output byte 180 (om4 START .. STMT)
fn main to int
off = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge off len inp
fail 14
end
n = read 0 inp off sub len inp off
if eq n 0
go = false
else
if lt n 0
fail 1
end
off = add off ulong n
end
m = add m 1
end
end
put inlen 0 off
prescan
namescan
put oc 0 180
put line 0 1
done = false
while not done
m = ulong 0
while and not done lt m 999999
if ne stmt 0
done = true
end
m = add m 1
end
end
ret 0
end

