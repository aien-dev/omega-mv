#### c2-00292 sha256=8efba010d072771b02a4ee7661457f0a4915761826d1cc4224922f0762843d87 len=219
global out uchar 1
fn mark x ulong to ulong
put out 0 uchar x
w = write 1 out 0 1
ret x
end
fn pick a ulong b ulong to ulong
ret sub b a
end
fn main to int
x = pick mark 65 mark 66
y = add mark 67 mark 68
ret int x
end

#### c2-00293 sha256=db19e581cb440739cf3070ca9bbe4a9cd6ac66d6c99edebc97232d4e8e9d33c9 len=219
