ret n
end

fn ir_layout to void
k = ulong 0
at = ulong 0
while lt k get ir_nord 0
put ir_bf k at
c = ir_count k
put ir_bc k c
at = add at c
k = add k 1
end
put ir_no 0 get ir_no 0
end

fn ir_wconst to void
i = ulong 0
while lt i get ir_nc 0
emitb 1
ir_w16 ulong get ir_cr i
ir_w64 get ir_cm i
i = add i 1
end
end

fn ir_wins k ulong to void
if eq k 0
ir_wconst
end
i = ulong 0
while lt i get ir_no 0
if eq ir_ord get ir_obl i k
op = ulong get ir_ok i
emitb uchar op
if eq op 1
ir_w16 get ir_oa i
ir_w64 get ir_ob i
end
if eq op 2
ir_w16 get ir_oa i
ir_w16 get ir_ob i
end
if eq op 3
emitb uchar get ir_oa i
ir_w16 get ir_ob i
ir_w16 get ir_oc i
ir_w16 get ir_od i
end
if eq op 4
emitb uchar get ir_oa i
ir_w16 get ir_ob i
ir_w16 get ir_oc i
end
if eq op 5
emitb uchar get ir_oa i
ir_w16 get ir_ob i
ir_w16 get ir_oc i
ir_w16 get ir_od i
end
if eq op 6
ir_w16 get ir_oa i
ir_w16 get ir_ob i
end
if eq op 11
ir_w16 get ir_oa i
ir_w16 get ir_ob i
emitb uchar get ir_oc i
j = ulong 0
while lt j get ir_oc i
ir_w16 get ir_oarg add mul i 6 j
j = add j 1
end
end
if eq op 12
emitb uchar get ir_oa i
end
if eq op 13
ir_w16 ir_ord get ir_oa i
end
if eq op 14
ir_w16 get ir_oa i
ir_w16 ir_ord get ir_ob i
ir_w16 ir_ord get ir_oc i
end
if eq op 15
ir_w16 get ir_oa i
end
end
i = add i 1
end
end

fn ir_record to void
emitb uchar get ir_nl 0
p = get ir_ns 0
e = add p get ir_nl 0
while lt p e
emitb get inp p
p = add p 1
end
emitb uchar get ir_npar 0
if eq get ir_ret 0 76
emitb 0
else
emitb uchar get ir_ret 0
end
ir_w16 get ir_nreg 0
i = ulong 0
while lt i get ir_nreg 0
emitb get ir_rty i
i = add i 1
end
ir_layout
ir_w16 get ir_nord 0
k = ulong 0
while lt k get ir_nord 0
ir_w32 get ir_bf k
ir_w32 get ir_bc k
k = add k 1
end
tot = ulong 0
k = ulong 0
while lt k get ir_nord 0
tot = add tot get ir_bc k
k = add k 1
end
ir_w32 tot
k = ulong 0
while lt k get ir_nord 0
ir_wins k
k = add k 1
end
ir_w16 0
ir_w16 0
end

note ir_emit_record: encode the current function into irrec and count it. The per-function IR state is
note reset by ir_fn, so this must run before the next fn line.
fn ir_emit_record to void
if ge get irnf 0 32
fail 14
end
put oc 0 0
ir_record
n = get oc 0
base = get irrlen 0
i = ulong 0
while lt i n
put irrec add base i get out i
i = add i 1
end
put irrlen 0 add base n
put irnf 0 add get irnf 0 1
end

note ir_encode: header (magic, version 1, nfuncs) followed by every collected function record.
fn ir_encode to void
put oc 0 0
emitb 79
emitb 83
emitb 67
emitb 49
emitb 73
emitb 82
emitb 0
emitb 1
ir_w16 get irnf 0
i = ulong 0
while lt i get irrlen 0
emitb get irrec i
i = add i 1
end
end

fn ir_byteeq o ulong s ulong k ulong to ulong
if eq get inp add o k get inp add s k
ret 1
end
ret 0
end

note ir_nameeq: table entry j's name equals the current source name token (length and bytes past 8).
fn ir_nameeq j ulong to ulong
fl = get irf_nl j
if ne fl get ir_cl 0
ret 0
end
k = ulong 8
same = ulong 1
while and eq same 1 lt k get ir_cl 0
if eq ir_byteeq get irf_ns j get ir_cs 0 k 0
same = 0
end
k = add k 1
end
ret same
end

note ir_findfn: packed name -> earlier function index + 1, or 0. The current function is the newest
note table entry and is never returned, so self and forward calls fail.
fn ir_findfn w ulong to ulong
