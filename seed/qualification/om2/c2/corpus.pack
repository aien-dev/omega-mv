#### c2-05722 sha256=b94b40592539b6e3909e75bdbdaec5f8f78e17734ca9719a5cb5803775c120ec len=36971
note SPDX-License-Identifier: Apache-2.0
note OM-2 qualification driver for the CURRENT consumer om/sha256/sha256.om (baseline acb3f15).
note The gate concatenates this file with om/sha256/sha256.om into one program-mode unit. It is
note test scaffolding, not a SHA implementation: every hash operation is the consumer's omsha.
note   stdin   the message, read to end of file
note   arg 1   optional piece size 1..4096 (default 4096): each read asks for at most that many bytes
note           and every byte read is absorbed with op 1, so the split points are exercised
note   stdout  the digest as 64 lowercase hex digits and a newline; exit 0
note Exit 90: bad argument; 91: read error; 92: short stdout write.
note digest byte j: the consumer packs the 32 digest bytes little endian into w[0..4)
fn dbyte w view ulong 64 j ulong to ulong
v = get w div j 8
ret and shr v mul rem j 8 8 255
end
text hexdig "0123456789abcdef"
fn piece to ulong
if eq argcnt 1
ret 4096
end
a = new uchar 8 0
r = argread 1 a 0 8
if or lt r 1 gt r 4
exit 90
end
v = ulong 0
for i ulong ulong r
d = get a i
if or lt d 48 gt d 57
exit 90
end
v = add mul v 10 ulong sub d 48
end
if or eq v 0 gt v 4096
exit 90
end
ret v
end
fn main to int
c = new uchar 104 0
b = new uchar 4096 0
w = new ulong 64 0
b8 = new ulong 512 0
o = new uchar 65 10
k = piece
omsha c b 0 0 w b8
go = true
while go
r = read 0 b 0 k
if lt r 0
ret 91
end
if eq r 0
go = false
else
omsha c b ulong r 1 w b8
end
end
omsha c b 0 2 w b8
for j ulong 32
x = dbyte w j
p = mul j 2
put o p get hexdig shr x 4
put o add p 1 get hexdig and x 15
end
r = write 1 o 0 65
if ne r 65
ret 92
end
ret 0
end
note SPDX-License-Identifier: Apache-2.0
note sha256.om: FIPS 180-4 SHA-256 as one function-mode unit, bound through the omega-bridge native
note call ABI (docs/NATIVE-ABI.md) and exported as omega_omsha. It replaces the algorithm of
note src/sha256.c: the C file keeps only the sha256_* entry points that cut caller data into
note pieces of at most 4096 bytes.
note
note The whole hash state lives in the caller's sha256_ctx (104 bytes, src/sha256.h):
note   bytes 0..31   state[8], uint32 little endian
note   bytes 32..39  count, uint64 little endian (bytes absorbed so far)
note   bytes 40..103 buffer, the pending partial block
note omsha c b n op w b8:
note   op 0  init: count 0, FIPS initial hash value
note   op 1  absorb b[0..n), n <= 4096, with src/sha256.c's buffering rules
note   op 2  final: pad, absorb the bit length, the 32-byte digest packed into w[0..4)
note   op 3  one shot: the digest of the n < 4096 bytes of b8 packed into w[0..4); c is not used
note w is the caller's scratch for the message schedule (64 words, contents ignored and overwritten):
note Omega writes every word before reading it, so the caller need not clear it.
note n > 4096 traps 3; any other op traps 9.

note little-endian word of nb bytes at byte offset p of the context
fn getle c edit uchar 104 p ulong nb ulong to ulong
v = ulong 0
i = nb
while gt i 0 bound 8
i = sub i 1
v = or shl v 8 ulong get c add p i
end
ret v
end

fn putle c edit uchar 104 p ulong nb ulong v ulong to void
x = v
for i ulong nb
put c add p i uchar and x 255
x = shr x 8
end
end

note the hash words of the context into h, and back
fn loadh c edit uchar 104 h edit uint 8 to void
for i ulong 8
put h i uint getle c mul i 4 4
end
end

fn storeh c edit uchar 104 h edit uint 8 to void
for i ulong 8
putle c mul i 4 4 ulong get h i
end
end

note big-endian words of the block at byte o of b into w[0..16), then the schedule
fn schedb b view uchar 4096 o ulong w edit ulong 64 to void
for i ulong 16
q = add o mul i 4
v = ulong get b q
v = or shl v 8 ulong get b add q 1
v = or shl v 8 ulong get b add q 2
v = or shl v 8 ulong get b add q 3
put w i or v shl v 32
end
expand w
end

note big-endian words of the block at byte 40 of b into w[0..16), then the schedule
fn schedc b edit uchar 104 w edit ulong 64 to void
for i ulong 16
q = add 40 mul i 4
v = ulong get b q
v = or shl v 8 ulong get b add q 1
v = or shl v 8 ulong get b add q 2
v = or shl v 8 ulong get b add q 3
put w i or v shl v 32
end
expand w
end

