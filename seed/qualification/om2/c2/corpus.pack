note ---- parsing ----
fn eqkey off ulong ln2 ulong id ulong to bool
if ne ln2 get kl id
ret false
end
for i ulong ln2
if ne get src add off i get keys add get ko id i
ret false
end
end
ret true
end

fn eqval off ulong ln2 ulong id ulong to bool
if ne ln2 get vl id
ret false
end
for i ulong ln2
if ne get src add off i get vals add get vo id i
ret false
end
end
ret true
end

fn lineis id ulong to bool
ret eqval get lstart 0 get llen 0 id
end

fn keyis id ulong to bool
ret eqkey get koff 0 get klen 0 id
end

fn valis id ulong to bool
ret eqval get voff 0 get vlen 0 id
end

fn kv i ulong to void
ln = get lstart i
ll = get llen i
j = ln
stop = add ln ll
while and lt j stop ne get src j 61
j = add j 1
end
put koff 0 ln
put klen 0 sub j ln
if eq j stop
put voff 0 stop
put vlen 0 0
else
put voff 0 add j 1
put vlen 0 sub stop add j 1
end
end

fn vline i ulong kid ulong vid ulong to bool
kv i
if not keyis kid
ret false
end
if not valis vid
ret false
end
ret true
end

fn split to void
n = ulong 0
p = ulong 0
total = get slen 0
while lt p total
q = p
while and lt q total ne get src q 10
q = add q 1
end
put lstart n p
put llen n sub q p
n = add n 1
p = add q 1
end
put nlines 0 n
end

fn hex64 off ulong ln2 ulong to bool
if ne ln2 64
ret false
end
for i ulong 64
c = get src add off i
if or lt c 48 gt c 102
ret false
end
if and gt c 57 lt c 97
ret false
end
end
ret true
end

fn pnum to ulong
v = ulong 0
n = ulong 0
going = true
while and going lt get pp 0 get vlen 0
c = get src add get voff 0 get pp 0
if or lt c 48 gt c 57
going = false
else
v = add mul v 10 ulong sub c 48
n = add n 1
put pp 0 add get pp 0 1
end
end
if eq n 0
put bad 0 1
end
if lt get pp 0 get vlen 0
c = get src add get voff 0 get pp 0
if eq c 46
put pp 0 add get pp 0 1
else
put bad 0 1
end
end
ret v
end

fn drvok to bool
put pp 0 0
put bad 0 0
a = pnum
b = pnum
c = pnum
if ne get pp 0 get vlen 0
put bad 0 1
end
if ne get bad 0 0
ret false
end
if gt a 580
ret true
end
if lt a 580
ret false
end
if gt b 173
ret true
end
if lt b 173
ret false
end
ret ge c 2
end

fn hashreq to bool
hreset
for i ulong get slen 0
if not hpush get src i
ret false
end
end
ret hfinal
end

fn readin to int
put slen 0 0
more = true
while more
room = sub 32768 get slen 0
if eq room 0
ret 65
end
n = read 0 src get slen 0 room
if eq n 0
more = false
else
if lt n 0
ret 74
end
put slen 0 add get slen 0 ulong n
end
end
ret 0
end

note ---- output ----
fn putstr id ulong to void
put wr 0 ulong write 1 vals add get vo id 0 get vl id
end

fn putc id ulong to void
put wr 0 ulong write 1 codes add get co id 0 get cl id
end

fn emit acc ulong to void
put wr 0 ulong write 1 vals 0 26
put wr 0 ulong write 1 lf 0 1
put wr 0 ulong write 1 lver 0 len lver
if eq acc 1
put wr 0 ulong write 1 lacc 0 len lacc
else
put wr 0 ulong write 1 lref 0 len lref
end
put wr 0 ulong write 1 lf 0 1
if eq acc 1
put wr 0 ulong write 1 lada 0 len lada
putstr get adap 0
put wr 0 ulong write 1 lf 0 1
put wr 0 ulong write 1 lcon 0 len lcon
putstr get cons 0
put wr 0 ulong write 1 lf 0 1
put wr 0 ulong write 1 lisa 0 len lisa
if eq get adap 0 3
putstr 10
else
putstr 9
end
put wr 0 ulong write 1 lf 0 1
put wr 0 ulong write 1 lcid 0 len lcid
put wr 0 ulong write 1 src get coff 0 64
put wr 0 ulong write 1 lf 0 1
else
put wr 0 ulong write 1 lcode 0 len lcode
putc get code 0
put wr 0 ulong write 1 lf 0 1
end
put wr 0 ulong write 1 lsha 0 len lsha
put wr 0 ulong write 1 hd 0 64
put wr 0 ulong write 1 lf 0 1
end

fn fail c ulong to int
put code 0 c
ok = hashreq
if not ok
put code 0 21
end
emit 0
ret 3
end

note ---- policy ----
fn common to int
if vline 3 2 5
put cons 0 5
else
if vline 3 2 6
put cons 0 6
else
ret fail 9
end
end
if not vline 7 6 11
ret fail 7
end
if not vline 8 7 12
ret fail 8
end
if not vline 9 8 13
ret fail 9
end
if not vline 10 9 14
ret fail 10
end
if not vline 11 10 15
ret fail 11
end
if not vline 12 11 16
ret fail 12
end
kv 13
if not keyis 12
ret fail 1
end
if not hex64 get voff 0 get vlen 0
ret fail 13
end
put coff 0 get voff 0
ret 0
end

fn main to int
init
rc = readin
if ne rc 0
ret fail 21
end
split
if lt get nlines 0 1
ret fail 1
end
if not lineis 0
ret fail 1
end
kv 1
if not keyis 0
ret fail 1
end
if valis 1
put mode 0 1
else
if valis 2
put mode 0 2
else
ret fail 2
end
end
if eq get mode 0 1
if ne get nlines 0 14
ret fail 1
end
kv 2
if not keyis 1
ret fail 1
end
if valis 3
put adap 0 3
if not vline 4 3 8
ret fail 4
end
if not vline 5 4 10
ret fail 5
end
kv 6
if not keyis 5
ret fail 1
end
else
if valis 4
put adap 0 4
if not vline 4 3 7
ret fail 4
end
if not vline 5 4 9
ret fail 5
end
kv 6
if not keyis 5
ret fail 1
end
if not drvok
ret fail 6
end
else
ret fail 3
end
end
else
if ne get nlines 0 20
ret fail 1
end
kv 2
if not keyis 1
ret fail 1
end
if not valis 4
ret fail 3
end
put adap 0 4
if not vline 4 3 7
ret fail 4
end
if not vline 5 4 9
ret fail 5
end
kv 6
if not keyis 5
ret fail 1
end
if not drvok
ret fail 6
end
end
c = common
if ne c 0
ret c
end
if eq get mode 0 2
kv 14
if not keyis 13
ret fail 1
end
if not hex64 get voff 0 get vlen 0
ret fail 14
end
if not vline 15 14 18
ret fail 15
end
if not vline 16 15 19
ret fail 16
end
kv 17
if not keyis 16
ret fail 1
end
if not valis 20
ret fail 17
end
if not vline 18 17 23
ret fail 18
end
if not vline 19 18 25
ret fail 19
end
end
ok = hashreq
if not ok
ret fail 21
end
emit 1
ret 0
end

