if or lt argcnt 1 gt argcnt 2
ret 90
end
if ne makedir scratch 0 len scratch 448 0
ret 91
end
cc1 = compile 14 1 0
cc2 = compile cc1 1 0
equal cc1 cc2
if eq argcnt 2
control cc2
ret 99
end
gen = compile cc2 2 0
mut = compile cc2 3 0
checker = compile cc2 4 0
boundaries cc2 mut
array = compile cc2 15 0
command array
result = run 13 0
oracle cc2 checker
positive cc2 gen checker 16
positive cc2 gen checker 262142
negative cc2 gen 0 262143
negative cc2 gen 0 524287
negative cc2 gen 1 300000
negative cc2 gen 2 300000
negative cc2 gen 3 300000
mutant cc2 gen mut checker
command checker
result = run 13 62
r = write 1 passed 0 len passed
if ne r long len passed
ret 99
end
ret 0
end

#### c2-00129 sha256=41118388d232dd6897bebf9b239f4174a2e5054cdd07a4753c4ce60bf7c022fa len=1163
note Deliberately synthetic decoder outputs. These test parser refusal, not compiler correctness.
global mode uchar 1
global textbuf uchar 256
text good "b0: b.ne 0xb4\nb4: mov\tx1, #0x3039\n"
text token "b0: b.ne 0xb4garbage\nb4: bogus #12345oops\n"
text reg "b0: b.ne 0xb4\nb4: mov\tx8, #0x3039\n"
text dupl "b0: b.ne 0xb4\nb4: mov\tx1, #0x3039\nb8: mov\tx1, #0x3039\n"
text missing "b0: b.ne 0xb4\n"
text wrong "b0: b.ne 0xb8\nb4: mov\tx1, #0x3039\n"
text prefix "b0: b.ne 0xb4\nb4: notmov\tx1, #0x3039\n"
fn main to int
if ne read 0 mode 0 1 1
ret 90
end
m = get mode 0
if gt m 6
ret 90
end
n = ulong 0
if eq m 0
n = len good
for i ulong n
put textbuf i get good i
end
end
if eq m 1
n = len token
for i ulong n
put textbuf i get token i
end
end
if eq m 2
n = len reg
for i ulong n
put textbuf i get reg i
end
end
if eq m 3
n = len dupl
for i ulong n
put textbuf i get dupl i
end
end
if eq m 4
n = len missing
for i ulong n
put textbuf i get missing i
end
end
if eq m 5
n = len wrong
for i ulong n
put textbuf i get wrong i
end
end
if eq m 6
n = len prefix
for i ulong n
put textbuf i get prefix i
end
end
if ne write 1 textbuf 0 n long n
ret 91
end
ret 0
end

#### c2-00130 sha256=d5bd24b9fa592ee626786770d1d29140175dcb7f0dd2b3a7f6b4982e91a9a1e1 len=412
note byte copy: read up to 65536 bytes, copy them byte by byte into a second pool reversed, write it
global src uchar 65536
global dst uchar 65536
fn fill to ulong
t = ulong 0
k = read 0 src 0 len src
while gt k 0
t = add t ulong k
k = long 0
if lt t len src
k = read 0 src t sub len src t
end
end
ret t
end
fn main to int
n = fill
for i ulong n
put dst sub sub n i 1 get src i
end
w = write 1 dst 0 n
ret 0
end

#### c2-00131 sha256=0867238aa1d3964dae6ab963cb06590ea69d554aeec587867a74a665f0138ed7 len=257
note echo: copy stdin to stdout through a 4096-byte pool, until read gives 0
global buf uchar 4096
fn main to int
n = read 0 buf 0 len buf
while gt n 0
w = write 1 buf 0 ulong n
if ne w n
ret 1
end
n = read 0 buf 0 len buf
end
if lt n 0
ret 2
end
ret 0
end

