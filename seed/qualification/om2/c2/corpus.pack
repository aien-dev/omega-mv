ir_op 13 sub ex 1 0 0 0
put ir_dead 0 1
end

note ir_trap: OMEGESE section 4. A trap ends the path but the IR still
note needs an unreachable ret terminator (zero of the return type, or void).
note trap is packed little endian 1885434484; independently checked in Wolfram.
fn ir_trap to void
code = lenval 4
if or lt code 1 gt code 14
fail 8
end
tok
if not or eq get tk 0 0 eq get tk 0 3
fail 4
end
ir_op 12 code 0 0 0
z = ulong 65535
if ne get ir_ret 0 76
z = ir_lit 0 get ir_ret 0
end
ir_op 15 z 0 0 0
put ir_dead 0 1
end

fn ir_stmt to ulong
tok
if or eq get tk 0 0 eq get tk 0 3
ret 0
end
c = kw get tw 0
if and ne c 66 ne c 68
if ne get ir_dead 0 0
fail 17
end
end
if eq c 83
skipnl
ret 0
end
if eq c 77
fail 9
end
if eq c 87
ir_trap
ret 0
end
if eq c 86
ir_break
ret 0
end
if eq c 66
ir_end
ret 0
end
if eq c 68
ir_else
ret 0
end
if eq c 67
ir_if
ret 0
end
if eq c 69
ir_while
ret 0
end
if eq c 71
ir_for
ret 0
end
if eq c 72
ir_doret
ret 0
end
if eq c 64
fail 15
end
ir_assign get tw 0
ret 0
end

fn ir_fn to void
tok
fcur = get irf_n 0
if ge fcur 32
fail 14
end
put irf_nm fcur get tw 0
put irf_ns fcur get ts 0
put irf_nl fcur get tl 0
put irf_np fcur 0
put ir_ns 0 get ts 0
put ir_nl 0 get tl 0
put ir_nreg 0 0
put ir_nn 0 0
put ir_nc 0 0
put ir_nb 0 0
put ir_nord 0 0
put ir_no 0 0
put ir_nf 0 0
put ir_dead 0 0
go = true
while go
tok
if eq kw get tw 0 65
go = false
else
w = get tw 0
tok
ty = kw get tw 0
np = get irf_np fcur
if ge np 6
fail 9
end
put irf_pt add mul fcur 6 np uchar ty
put irf_np fcur add np 1
r = ir_newreg ty
ir_bind w r
end
end
tok
put ir_ret 0 kw get tw 0
put irf_ret fcur uchar get ir_ret 0
put irf_n 0 add fcur 1
put ir_npar 0 get ir_nreg 0
b = ir_block
ir_start b
ir_push 4 0 0 0 0
put ir_have 0 0
while eq get ir_have 0 0
ignored = ir_stmt
end
end

fn ir_run to void
go = true
while go
tok
k = get tk 0
if eq k 3
go = false
else
if eq k 0
else
if ne k 1
fail 16
end
c = kw get tw 0
if eq c 64
ir_fn
ir_emit_record
else
if eq c 83
skipnl
else
if eq c 152
s_const
else
if or or eq c 85 eq c 78 eq c 79
fail 9
end
fail 16
end
end
end
end
end
end
ir_encode
n = write 1 out 0 get oc 0
exit 0
end

note main: read all of stdin
note (8 MiB at most, error 14; a read error is 1), find the mode, then one
note statement per line from output byte 180 (om4 START .. STMT)
fn prev to int
off = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge off len inp
fail 14
end
n = read 0 inp off sub len inp off
if eq n 0
go = false
else
if lt n 0
fail 1
end
off = add off ulong n
end
m = add m 1
end
end
put inlen 0 off
if ne ir_lead 0
put irmode 0 1
ir_run
end
prescan
namescan
put oc 0 180
put line 0 1
done = false
while not done
m = ulong 0
while and not done lt m 999999
if ne stmt 0
done = true
end
m = add m 1
end
end
ret 0
end

fn main to int
n = read 0 msg 0 1
if ne n 1
ret 90
end
m = get msg 0
a = ulong 0
t = ulong 0
e = ulong 0
if eq m 0
t = ulong 1048572
e = ulong 262143
end
if eq m 1
a = ulong 1048576
e = ulong 262144
end
if eq m 2
a = ulong 1024
e = ulong 524032
end
if eq m 3
a = ulong 1028
e = ulong 524031
end
if eq m 4
t = ulong 1048576
end
if eq m 5
a = ulong 1048580
end
if eq m 6
t = ulong 2
end
if eq m 7
a = ulong 2
end
v = disp19 a t
if ge m 4
ret 81
end
if ne v e
ret 82
end
ret 0
end

