ret 8
end
if ne sizeof f64 8
ret 9
end
if ne sizeof S 40
ret 10
end
if ne offsetof S a 0
ret 11
end
if ne offsetof S b 8
ret 12
end
if ne offsetof S c 16
ret 13
end
if ne add sizeof S offsetof S b 48
ret 14
end
ret 0
end

