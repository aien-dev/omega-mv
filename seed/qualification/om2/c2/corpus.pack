note SPDX-License-Identifier: Apache-2.0
note b3unit.om: BLAKE3 (default unkeyed hash, 32-byte output) as one function-mode unit, bound
note through the omega-bridge native call ABI and exported as omega_omb3. It replaces the algorithm of
note src/omega_blake3.c, which keeps only omega_blake3_hash: that cuts the input into 1024-byte chunks.
note The tree logic follows om/blake3/blake3.om (the program form, kept for files and stdin).
note
note omb3 st b n fin o:
note   st  caller state, zeroed before the first call: rows 0..53 of 8 words are the chaining-value
note       stack, word 440 its depth, word 441 the number of chunks absorbed
note   fin 0  b holds a whole chunk that is not the last one (n must be 1024): its chaining value is
note          merged into the stack
note   fin 1  b[0..n) is the last chunk (n 0..1024): the tree is finished and the root hash goes to o
note A wrong n traps 3.
note
note Working words w (one array because globals are program-mode only):
note   0..15 state s, 16..31 message m, 32..47 permute scratch, 48..55 input chaining value,
note   56..71 compression output, 72 block length, 73 counter, 74 flags, 75..82 node chaining value,
note   83..90 IV, 91..106 message permutation

fn initw w edit ulong 128 to void
put w 83 1779033703
put w 84 3144134277
put w 85 1013904242
put w 86 2773480762
put w 87 1359893119
put w 88 2600822924
put w 89 528734635
put w 90 1541459225
put w 91 2
put w 92 6
put w 93 3
put w 94 10
put w 95 7
put w 96 0
put w 97 4
put w 98 13
put w 99 1
put w 100 11
put w 101 12
put w 102 5
put w 103 9
put w 104 14
put w 105 15
put w 106 8
end

note the G mixing function on state words a b c d with message words 2j and 2j+1
fn g w edit ulong 128 a ulong b ulong c ulong d ulong j ulong to void
x = get w add 16 mul j 2
t = add get w a get w b
put w a and add t x 4294967295
t = xor get w d get w a
put w d and or shr t 16 shl t 16 4294967295
put w c and add get w c get w d 4294967295
t = xor get w b get w c
put w b and or shr t 12 shl t 20 4294967295
x = get w add 17 mul j 2
t = add get w a get w b
put w a and add t x 4294967295
t = xor get w d get w a
put w d and or shr t 8 shl t 24 4294967295
put w c and add get w c get w d 4294967295
t = xor get w b get w c
put w b and or shr t 7 shl t 25 4294967295
end

fn round w edit ulong 128 to void
g w 0 4 8 12 0
g w 1 5 9 13 1
g w 2 6 10 14 2
g w 3 7 11 15 3
g w 0 5 10 15 4
g w 1 6 11 12 5
g w 2 7 8 13 6
g w 3 4 9 14 7
end

fn permute w edit ulong 128 to void
for i ulong 16
put w add 32 i get w add 16 get w add 91 i
end
for i ulong 16
put w add 16 i get w add 32 i
end
end

note the 16 little-endian words of blk into m
fn loadm w edit ulong 128 blk edit uchar 64 to void
for i ulong 16
o = mul i 4
v = ulong get blk add o 3
v = or shl v 8 ulong get blk add o 2
v = or shl v 8 ulong get blk add o 1
v = or shl v 8 ulong get blk o
put w add 16 i v
end
end

note compress (input chaining value, blk, block length, counter, flags) into the output words
fn compress w edit ulong 128 blk edit uchar 64 to void
loadm w blk
for i ulong 8
put w i get w add 48 i
put w add i 8 get w add 83 i
end
put w 12 and get w 73 4294967295
put w 13 and shr get w 73 32 4294967295
put w 14 get w 72
put w 15 get w 74
for r ulong 7
round w
permute w
end
for i ulong 8
put w add 56 i xor get w i get w add i 8
put w add 64 i xor get w add i 8 get w add 48 i
end
end

note compress, then the node chaining value is the first 8 output words
fn nodecv w edit ulong 128 blk edit uchar 64 to void
compress w blk
for i ulong 8
put w add 75 i get w add 56 i
end
end

note copy cnt bytes of b from offset o into blk, zero the rest
fn loadblk blk edit uchar 64 b view uchar 1024 o ulong cnt ulong to void
for i ulong 64
if lt i cnt
put blk i get b add o i
else
put blk i 0
end
end
end

fn setnb w edit ulong 128 bl ulong ctr ulong fl ulong to void
put w 72 bl
put w 73 ctr
put w 74 fl
end

note chunk ctr holding b[0..cnt): every block but the last compressed, the last left set up
fn chunk w edit ulong 128 blk edit uchar 64 b view uchar 1024 cnt ulong ctr ulong to void
for i ulong 8
put w add 48 i get w add 83 i
end
nblk = ulong 1
if gt cnt 0
nblk = div add cnt 63 64
end
k = ulong 0
while lt add k 1 nblk bound 16
loadblk blk b mul k 64 64
fl = ulong 0
if eq k 0
fl = 1
end
setnb w 64 ctr fl
compress w blk
for i ulong 8
put w add 48 i get w add 56 i
end
k = add k 1
end
bo = mul sub nblk 1 64
loadblk blk b bo sub cnt bo
fl = ulong 2
if eq nblk 1
fl = 3
end
setnb w sub cnt bo ctr fl
end

note parent node of stack row r (left) and the node chaining value (right), set up to compress
fn parentn w edit ulong 128 blk edit uchar 64 st edit ulong 448 r ulong to void
for i ulong 8
put w add 48 i get w add 83 i
end
for i ulong 8
l = get st add mul r 8 i
v = get w add 75 i
for k ulong 4
sh = mul k 8
q = add mul i 4 k
put blk q uchar and shr l sh 255
put blk add 32 q uchar and shr v sh 255
end
end
setnb w 64 0 4
end

fn push w edit ulong 128 st edit ulong 448 to void
p = get st 440
for i ulong 8
put st add mul p 8 i get w add 75 i
end
put st 440 add p 1
end

note a whole chunk that is not the last: merge completed subtrees, then push its chaining value
fn midchk w edit ulong 128 blk edit uchar 64 st edit ulong 448 b view uchar 1024 to void
ctr = get st 441
chunk w blk b 1024 ctr
nodecv w blk
tot = add ctr 1
while eq and tot 1 0 bound 64
d = sub get st 440 1
put st 440 d
parentn w blk st d
nodecv w blk
tot = shr tot 1
end
push w st
put st 441 add ctr 1
end

note the last chunk: fold the stack into the root and write its 32 little-endian bytes into o
fn lastchk w edit ulong 128 blk edit uchar 64 st edit ulong 448 b view uchar 1024 n ulong o edit uchar 32 to void
chunk w blk b n get st 441
while gt get st 440 0 bound 64
nodecv w blk
d = sub get st 440 1
put st 440 d
parentn w blk st d
end
put w 74 or get w 74 8
compress w blk
outle w o
end

note the first 8 output words, little endian, into o
fn outle w edit ulong 128 o edit uchar 32 to void
for i ulong 8
v = get w add 56 i
for k ulong 4
q = add mul i 4 k
put o q uchar and shr v mul k 8 255
end
end
end

fn omb3 st edit ulong 448 b view uchar 1024 n ulong fin ulong o edit uchar 32 to void
w = new ulong 128 0
blk = new uchar 64 0
initw w
if gt n 1024
trap 3
end
if eq fin 0
if ne n 1024
trap 3
end
midchk w blk st b
ret
end
lastchk w blk st b n o
end

#### c2-00002 sha256=79857ee82002d11d3df4c0c2a99523aa3419d18c5fc188a41efc778887b4baa3 len=5933
note SPDX-License-Identifier: Apache-2.0
note blake3: BLAKE3 default (unkeyed, 32-byte) hash of one file (or stdin when no argument),
note 64 hex digits + newline on stdout. Seeded native Omega port of src/omega_blake3.c.
note 32-bit words live in ulong cells and are masked after every add.
note 1024-byte chunks of 64-byte blocks, a binary tree of parents (stack depth <= 54 for 16 MiB),
note the ROOT flag on the last compression only.
note Capacity: 16 MiB of input (exit 66 beyond). Exit 65 when the file cannot be read.
note usage: blake3 [FILE]

text tbad "blake3: cannot read input\n"
text tbig "blake3: input over 16 MiB\n"
text tnl "\n"

global inp uchar 16777216
global n ulong 1
global iv ulong 8
global perm ulong 16
global m ulong 16
global mt ulong 16
global s ulong 16
global co ulong 16
global ncv ulong 8
global blk uchar 64
global nb ulong 3
global cvr ulong 8
global stk ulong 512
global sp ulong 1
global name uchar 4096
global hex uchar 64
global tiny uchar 1

const mask ulong 4294967295
const cstart ulong 1
const cend ulong 2
const parent ulong 4
const root ulong 8

fn initiv to void
put iv 0 1779033703
put iv 1 3144134277
put iv 2 1013904242
put iv 3 2773480762
put iv 4 1359893119
put iv 5 2600822924
put iv 6 528734635
put iv 7 1541459225
end

fn initperm to void
put perm 0 2
put perm 1 6
put perm 2 3
put perm 3 10
put perm 4 7
put perm 5 0
put perm 6 4
put perm 7 13
put perm 8 1
put perm 9 11
put perm 10 12
put perm 11 5
put perm 12 9
put perm 13 14
put perm 14 15
put perm 15 8
end

fn rotr x ulong r ulong to ulong
ret and or shr x r shl x sub 32 r mask
end

note the G mixing function on state words a b c d with message words mx my
fn g a ulong b ulong c ulong d ulong mx ulong my ulong to void
t = add get s a get s b
put s a and add t mx mask
put s d rotr xor get s d get s a 16
put s c and add get s c get s d mask
put s b rotr xor get s b get s c 12
t = add get s a get s b
put s a and add t my mask
put s d rotr xor get s d get s a 8
put s c and add get s c get s d mask
put s b rotr xor get s b get s c 7
end

fn round to void
g 0 4 8 12 get m 0 get m 1
g 1 5 9 13 get m 2 get m 3
g 2 6 10 14 get m 4 get m 5
g 3 7 11 15 get m 6 get m 7
g 0 5 10 15 get m 8 get m 9
g 1 6 11 12 get m 10 get m 11
g 2 7 8 13 get m 12 get m 13
g 3 4 9 14 get m 14 get m 15
end

fn permute to void
for i ulong 16
put mt i get m get perm i
end
for i ulong 16
put m i get mt i
end
end

note load the 16 little-endian words of blk into m
fn loadm to void
for i ulong 16
o = mul i 4
v = ulong get blk add o 3
v = or shl v 8 ulong get blk add o 2
v = or shl v 8 ulong get blk add o 1
v = or shl v 8 ulong get blk o
put m i v
end
end

note compress the node (ncv, blk, nb = block_len counter flags) into co (16 words);
note co 0..7 is the chaining value
fn compress to void
loadm
for i ulong 8
put s i get ncv i
put s add i 8 get iv i
end
put s 12 and get nb 1 mask
put s 13 and shr get nb 1 32 mask
put s 14 get nb 0
put s 15 get nb 2
for r ulong 7
round
permute
end
for i ulong 8
put co i xor get s i get s add i 8
put co add i 8 xor get s add i 8 get ncv i
end
end

note chaining value of the node into cvr
fn nodecv to void
compress
for i ulong 8
put cvr i get co i
end
end

note copy cnt bytes of inp from offset o into blk, zero the rest
fn loadblk o ulong cnt ulong to void
for i ulong 64
if lt i cnt
put blk i get inp add o i
else
put blk i 0
end
end
end

note the unfinished last compression of chunk number ctr holding inp[o .. o + cnt)
fn chunk o ulong cnt ulong ctr ulong to void
for i ulong 8
put ncv i get iv i
end
nblk = ulong 1
if gt cnt 0
nblk = div add cnt 63 64
end
b = ulong 0
while lt add b 1 nblk bound 16
loadblk add o mul b 64 64
put nb 0 64
put nb 1 ctr
put nb 2 0
if eq b 0
put nb 2 cstart
end
compress
for i ulong 8
put ncv i get co i
end
b = add b 1
end
bo = mul sub nblk 1 64
rest = sub cnt bo
loadblk add o bo rest
put nb 0 rest
put nb 1 ctr
put nb 2 cend
if eq nblk 1
put nb 2 or cend cstart
end
end

note parent node of stk row r (left) and cvr (right)
fn parentn r ulong to void
for i ulong 8
put ncv i get iv i
end
for i ulong 8
l = get stk add mul r 8 i
v = get cvr i
for k ulong 4
sh = mul k 8
put blk add mul i 4 k uchar and shr l sh 255
put blk add 32 add mul i 4 k uchar and shr v sh 255
end
end
put nb 0 64
put nb 1 0
put nb 2 parent
end

fn push to void
p = get sp 0
for i ulong 8
put stk add mul p 8 i get cvr i
end
put sp 0 add p 1
end

fn hexd v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

note little-endian bytes of co 0..7 as 64 hex digits
fn emit to void
for i ulong 8
v = get co i
for k ulong 4
bt = and shr v mul k 8 255
p = add mul i 8 mul k 2
put hex p hexd shr bt 4
put hex add p 1 hexd and bt 15
end
end
r = write 1 hex 0 64
r = write 1 tnl 0 1
end

note read the whole descriptor into inp; 0 ok, 65 read error, 66 over capacity
fn slurp fd int to int
t = ulong 0
while true bound 999999
room = sub len inp t
if eq room 0
r = read fd tiny 0 1
if lt r 0
ret 65
end
if gt r 0
ret 66
end
break
end
r = read fd inp t room
if lt r 0
ret 65
end
if eq r 0
break
end
t = add t ulong r
end
put n 0 t
ret 0
end

fn hashall to void
sz = get n 0
nch = ulong 1
if gt sz 0
nch = div add sz 1023 1024
end
c = ulong 0
while lt add c 1 nch bound 16385
chunk mul c 1024 1024 c
nodecv
tot = add c 1
while eq and tot 1 0 bound 64
put sp 0 sub get sp 0 1
parentn get sp 0
nodecv
tot = shr tot 1
end
push
c = add c 1
end
lst = mul sub nch 1 1024
chunk lst sub sz lst sub nch 1
while gt get sp 0 0 bound 64
nodecv
put sp 0 sub get sp 0 1
parentn get sp 0
end
put nb 2 or get nb 2 root
compress
end

fn main to int
initiv
initperm
fd = int 0
if ge argcnt 2
l = argread 1 name 0 4095
if lt l 1
r = write 2 tbad 0 len tbad
ret 65
end
fd = int fopen name 0 ulong l 0 0
if lt fd 0
r = write 2 tbad 0 len tbad
ret 65
end
end
e = slurp fd
if eq e 65
r = write 2 tbad 0 len tbad
ret 65
end
if eq e 66
r = write 2 tbig 0 len tbig
ret 66
end
hashall
emit
ret 0
end

#### c2-00003 sha256=7f034814303a8a40b4bc56383ddd55ab2ae8460291f80793340bc3b0ac024e21 len=35333
note SPDX-License-Identifier: Apache-2.0
note sha256.om: FIPS 180-4 SHA-256 as one function-mode unit, bound through the omega-bridge native
note call ABI (docs/NATIVE-ABI.md) and exported as omega_omsha. It replaces the algorithm of
note src/sha256.c: the C file keeps only the sha256_* entry points that cut caller data into
note pieces of at most 4096 bytes.
note
note The whole hash state lives in the caller's sha256_ctx (104 bytes, src/sha256.h):
note   bytes 0..31   state[8], uint32 little endian
note   bytes 32..39  count, uint64 little endian (bytes absorbed so far)
note   bytes 40..103 buffer, the pending partial block
note omsha c b n op w b8:
note   op 0  init: count 0, FIPS initial hash value
note   op 1  absorb b[0..n), n <= 4096, with src/sha256.c's buffering rules
note   op 2  final: pad, absorb the bit length, the 32-byte digest packed into w[0..4)
note   op 3  one shot: the digest of the n < 4096 bytes of b8 packed into w[0..4); c is not used
note w is the caller's scratch for the message schedule (64 words, contents ignored and overwritten):
note Omega writes every word before reading it, so the caller need not clear it.
note n > 4096 traps 3; any other op traps 9.

note little-endian word of nb bytes at byte offset p of the context
fn getle c edit uchar 104 p ulong nb ulong to ulong
v = ulong 0
i = nb
while gt i 0 bound 8
i = sub i 1
v = or shl v 8 ulong get c add p i
end
ret v
end

fn putle c edit uchar 104 p ulong nb ulong v ulong to void
x = v
for i ulong nb
put c add p i uchar and x 255
x = shr x 8
end
end

note the hash words of the context into h, and back
fn loadh c edit uchar 104 h edit uint 8 to void
for i ulong 8
put h i uint getle c mul i 4 4
end
end

fn storeh c edit uchar 104 h edit uint 8 to void
for i ulong 8
putle c mul i 4 4 ulong get h i
end
end

note big-endian words of the block at byte o of b into w[0..16), then the schedule
fn schedb b view uchar 4096 o ulong w edit ulong 64 to void
for i ulong 16
q = add o mul i 4
v = ulong get b q
v = or shl v 8 ulong get b add q 1
v = or shl v 8 ulong get b add q 2
v = or shl v 8 ulong get b add q 3
put w i or v shl v 32
end
expand w
end

note big-endian words of the block at byte 40 of b into w[0..16), then the schedule
fn schedc b edit uchar 104 w edit ulong 64 to void
for i ulong 16
q = add 40 mul i 4
v = ulong get b q
v = or shl v 8 ulong get b add q 1
v = or shl v 8 ulong get b add q 2
v = or shl v 8 ulong get b add q 3
put w i or v shl v 32
end
expand w
end

