note S4: pwrite only reads its array, so a text and a view are allowed (error 20 is for pread).
note Writes ABC at file position 0 and a newline at 3 of stdout (exit 0).
om2
text t "ABC"
fn g v view uchar * to long
ret pwrite 1 v 0 len v 0
end
fn main to int
r = g t
if ne r 3
ret 1
end
nl = new uchar 1 10
r = pwrite 1 nl 0 1 3
if ne r 1
ret 2
end
ret 0
end
