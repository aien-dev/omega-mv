om2
note hex literals take the place's type under the decimal range rule
fn main to int
a = ulong 0xffffffffffffffff
if ne a 18446744073709551615
ret 1
end
b = uint 0xffffffff
if ne b 4294967295
ret 2
end
c = long 0x7fffffffffffffff
if ne c 9223372036854775807
ret 3
end
d = uchar 0x0
if ne d 0
ret 4
end
e = ushort 0x00ff
if ne e 255
ret 5
end
f = ulong 0xdeadbeef
if ne f 3735928559
ret 6
end
ret 0
end
