fn h_long x long h ulong to ulong
g = h
g = xor mul g 31 d_long_1 x
g = xor mul g 31 d_long_2 x
g = xor mul g 31 d_long_3 x
g = xor mul g 31 d_long_7 x
g = xor mul g 31 d_long_12 x
g = xor mul g 31 d_long_31 x
g = xor mul g 31 d_long_32 x
g = xor mul g 31 d_long_33 x
g = xor mul g 31 d_long_62 x
ret g
end
