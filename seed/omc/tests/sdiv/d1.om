fn main to int
hl = ulong 0
hi = ulong 0
hs = ulong 0
hc = ulong 0
u = ulong 88172645463325252
for i ulong 4096
u = xor u shl u 13
u = xor u shr u 7
u = xor u shl u 17
hl = h_long long sub long and u 9223372036854775807 long 4611686018427387904 hl
hi = h_int int sub long and u 4294967295 long 2147483648 hi
hs = h_short short sub long and u 65535 long 32768 hs
hc = h_byte byte sub long and u 255 long 128 hc
end
hl = h_long sub long 0 long 9223372036854775807 hl
hl = h_long sub sub long 0 long 9223372036854775807 long 1 hl
hl = h_long long 9223372036854775807 hl
hi = h_int int sub long 0 long 2147483648 hi
hi = h_int int 2147483647 hi
hs = h_short short sub long 0 long 32768 hs
hs = h_short short 32767 hs
hc = h_byte byte sub long 0 long 128 hc
hc = h_byte byte 127 hc
for j ulong 129
v = sub long j long 64
hl = h_long v hl
hi = h_int int v hi
hs = h_short short v hs
hc = h_byte byte v hc
end
putnum hl
putnum hi
putnum hs
putnum hc
ret 0
end
