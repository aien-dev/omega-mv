p = recname p 4 1852399981
header p 10 132 0
p = add p 56
header p 7 110 0
p = add p 56
header p 15 102 0
p = add p 56
header p 80 195 0
p = add p 56
header p 81 195 0
p = add p 56
header p 80 194 0
p = add p 56
chk eq p get total 0
number get checks 0
emit 32
number get bad 0
emit 10
n = write 1 msg 0 get mc 0
if ne n long get mc 0
ret 99
end
if ne get bad 0 0
ret 1
end
ret 0
end

