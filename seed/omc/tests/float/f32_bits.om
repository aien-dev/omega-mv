note f32 literals are rounded once, to binary32: expected bits computed outside this compiler.
fn main to int
a = bitcast uint f32 1.5
if ne a 1069547520
ret 1
end
b = bitcast uint f32 0.1
if ne b 1036831949
ret 2
end
c = bitcast uint f32 3.14159265
if ne c 1078530011
ret 3
end
d = bitcast uint f32 1e-3
if ne d 981668463
ret 4
end
e = bitcast uint f32 3.4028235e38
if ne e 2139095039
ret 5
end
f = bitcast uint f32 1e-45
if ne f 1
ret 6
end
g = bitcast uint f32 1e-46
if ne g 0
ret 7
end
h = bitcast uint f32 6.02214076e23
if ne h 1727990830
ret 8
end
i = bitcast uint f32 1.17549435e-38
if ne i 8388608
ret 9
end
ret 0
end
