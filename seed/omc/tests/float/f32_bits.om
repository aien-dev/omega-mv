note f32 literals are rounded once, to binary32: expected bits computed outside this compiler.
fn main to int
a = bits uint f32 1.5
if ne a 1069547520
ret 1
end
b = bits uint f32 0.1
if ne b 1036831949
ret 2
end
c = bits uint f32 3.14159265
if ne c 1078530011
ret 3
end
d = bits uint f32 1e-3
if ne d 981668463
ret 4
end
ret 0
end
