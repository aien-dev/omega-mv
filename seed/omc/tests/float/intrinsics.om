note fsqrt, fabs, fmin, fmax: one scalar FP instruction each; fmin/fmax are the IEEE minNum/maxNum rule.
fn main to int
a = fsqrt 4.0f64
if ne int a 2
ret 1
end
b = fabs -2.5f64
if ne bitcast ulong b 4612811918334230528
ret 2
end
n = div 0.0f64 0.0f64
c = fmin n 1.5f64
if ne bitcast ulong c 4609434218613702656
ret 3
end
d = fmax -0.0f64 0.0f64
if ne bitcast ulong d 0
ret 4
end
e = fsqrt f32 4.0f32
if ne int e 2
ret 5
end
f = f32 0.5
g = fabs f
if ne bitcast uint g 1056964608
ret 6
end
h = fmax f32 -0.0f32 f32 0.0f32
if ne bitcast uint h 0
ret 7
end
ret 0
end
