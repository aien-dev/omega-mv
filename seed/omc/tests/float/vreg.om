note float locals live in v registers (the twin of their pool register): loop-carried sums, values kept
note across calls whose callee uses the same twins, float arguments, register pressure, f32, -0.0, NaN,
note FMOV immediate edge constants and conversions. Expected bit patterns computed outside this compiler.
fn clob a f64 b f64 to f64
p = mul a 2.0
q = add p b
r = sub q 0.5
s = mul r r
ret add s a
end

fn clob32 a f32 to f32
p = mul a f32 4.0
q = sub p a
ret q
end

fn sum3 a f64 b f64 c f64 to f64
ret add add a b c
end

fn t_loop to int
s = f64 0.0
for i ulong 10
s = add s div f64 i 2.0
end
if ne bitcast ulong s bitcast ulong 22.5f64
ret 1
end
v = f64 0.0
while lt v 3.0
v = add v 1.0
end
if ne bitcast ulong v bitcast ulong 3.0f64
ret 2
end
ret 0
end

fn t_call to int
