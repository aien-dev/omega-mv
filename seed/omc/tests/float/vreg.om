w = sum3 x y z
if ne bitcast ulong w bitcast ulong 10.8125f64
ret 6
end
x = y
x = x
if ne bitcast ulong x bitcast ulong 0.25f64
ret 7
end
x = clob y y
if ne bitcast ulong x bitcast ulong 0.3125f64
ret 8
end
ret 0
end

