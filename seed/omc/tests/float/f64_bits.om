note literals convert exactly: every constant here was computed outside this compiler (IEEE-754 bits).
fn main to int
a = bits ulong f64 1.5
if ne a 4609434218613702656
ret 1
end
b = bits ulong f64 0.1
if ne b 4591870180066957722
ret 2
end
c = bits ulong f64 3.141592653589793
if ne c 4614256656552045848
ret 3
end
d = bits ulong f64 1e-3
if ne d 4562254508917369340
ret 4
end
e = bits ulong f64 -0.0
if ne e 9223372036854775808
ret 5
end
ret 0
end
