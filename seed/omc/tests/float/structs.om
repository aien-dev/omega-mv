note a struct field may be f64 or f32 (an f32 field still uses an 8-byte cell); a view receives it.
struct S a f64 b f32 c f32 2 end
fn total s view S to f64
ret add get s a f64 get s b
end
fn main to int
x = new S 1.5 2.5 0.5
put x c 1 3.5
if ne bits ulong get x a 4609434218613702656
ret 1
end
if ne bits uint get x b 1075838976
ret 2
end
if ne bits uint get x c 1 1080033280
ret 3
end
r = total x
if ne int mul r 2.0 8
ret 4
end
ret 0
end
