note add, sub, mul, div and neg on f64 and f32; truncating conversions make the results observable.
fn main to int
if ne int add 1.5f64 2.25f64 3
ret 1
end
if ne int mul 1.5f64 2.25f64 3
ret 2
end
if ne int sub 5.5f64 2.25f64 3
ret 3
end
if ne int div 10.0f64 4.0f64 2
ret 4
end
if ne int neg 2.5f64 -2
ret 5
end
if ne int mul f32 1.5f32 f32 4.0f32 6
ret 6
end
ret 0
end
