if or eq get tk 0 0 eq get tk 0 3
ret 0
end
c = kw get tw 0
if and ne c 66 ne c 68
if ne get ir_dead 0 0
fail 17
end
end
if eq c 77
if eq get tw 0 1885434484
ir_trap
ret 0
end
fail 9
end
if eq c 66
ir_end
ret 0
end
if eq c 68
ir_else
ret 0
