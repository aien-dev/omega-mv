fn s_global to void
w = topname
t = typeword
elemtype t
n = lenval 16
arrlen n
by = shl shr add shl n tlog t 15 4 4
pb = get poolb 0
a = add 276824064 pb
s = add pb by
if gt s 1073741824
fail 23
end
put poolb 0 s
addname w 0 t n 4 a
put nglob 0 get nn 0
eol
end

note s_text: text NAME "...": read-only bytes in the program image (escapes \n \t \\ \", any other is error
note 22), padded to a word, with their length; address 0x400000 + its place. om4 S_TEXT.
fn s_text to void
w = topname
tok
if ne get tk 0 4
fail 16
end
a = add get oc 0 4194304
p = get tw 0
e = add p get tl 0
n = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = get inp p
p = add p 1
if eq b 92
b = get inp p
p = add p 1
if eq b 110
b = uchar 10
else
if eq b 116
b = uchar 9
else
if and ne b 92 ne b 34
fail 22
end
end
end
end
emitb b
n = add n 1
end
m = add m 1
end
end
while ne and get oc 0 3 0
emitb 0
end
addname w 0 2 n 5 a
put nglob 0 get nn 0
eol
end

note s_if: if cond: the false branch is patched at else / end. om4 S_IF.
fn s_if to void
at = cond
pushb at 1 0 0 0
pushnh get nn 0 get held 0
eol
end

note s_else: jump over the else part (B, C6.2.35); the if's false branch lands after that jump. om4 S_ELSE.
fn s_else to void
n = get nb 0
if eq n 0
fail 15
end
i = sub n 1
if ne get bkind i 1
fail 15
end
b = get oc 0
emit 335544320
patch19 get bbr i get oc 0
put bkind i 2
put bbr i b
fz_else i
put nn 0 get bnames i
put held 0 get bheld i
put bdead i get dead 0
put dead 0 0
eol
end

note lpcnt: the hidden counter check of a loop: CMP Xc, #N (C6.2.96) or CMP Xc, Xn (C6.2.97); B.HS trap
note 4; ADD Xc, Xc, #1 (C6.2.5). om4 SW_NOB .. SW_G and the same in S_FOR.
fn lpcnt c ulong n ulong to void
if le n 4095
emit or or 4043309087 shl n 10 shl c 5
else
m = alloc
matconst m n
emit or or 3942645791 shl c 5 shl m 16
end
trapc 2 4
emit or or 2432697344 c shl c 5
end

note s_while: while cond [bound N]: hidden counter = 0; head: cond false -> exit; counter >= N -> trap 4;
note counter = counter + 1; body; B head. N is 1 .. 999999 (error 8), 1000000 with no bound. om4 S_WHILE.
fn s_while to void
sn = get nn 0
sh = get held 0
c = alloc
put held 0 get nslot 0
emit or 3531603968 c
hd = get oc 0
br = cond
n = ulong 1000000
tok
k = get tk 0
if and ne k 0 ne k 3
if ne k 1
fail 5
end
if gt get tl 0 8
fail 5
end
if ne kw get tw 0 70
fail 5
end
v = lenval 4
if ge sub v 1 999999
fail 8
end
n = v
eol
end
lpcnt c n
pushb br 3 hd c 0
pushnh sn sh
end

note sf_br: B.HS (unsigned) or B.GE (signed) to the loop exit, C6.2.34 (distance filled at end); returns
note its place. om4 SF_BR.
fn sf_br t ulong to ulong
at = get oc 0
if lt t 6
emit 1409286146
else
emit 1409286154
end
ret at
end

note sf_num: for i T K with K a number: i = 0 (MOVZ, C6.2.285); head: CMP Xi, #K or Xk; B.HS/B.GE exit.
note om4 SF_NUM .. SF_PUSH.
fn sf_num w ulong t ulong kk ulong sn ulong sh ulong to void
