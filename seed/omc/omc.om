note bo_w3: emit fx | rd | ra << 5 | (imm12 << 10, or rb << 16)
fn bo_w3 fx ulong rd ulong ra ulong rb ulong imm ulong to void
if ne imm 0
emit or or or fx rd shl ra 5 shl rb 10
else
emit or or or fx rd shl ra 5 shl rb 16
end
end

note bo_fix: after a 64-bit op on rd: u8/u16/u32 wrap (canon), i8/i16/i32 overflow check (trap 1)
fn bo_fix rd ulong ty ulong to void
if lt ty 6
canon rd ty
ret
end
if eq ty 9
ret
end
chkext rd ty 1
end

note bo_schk: a shift amount in a register must be below the width: CMP Xb, #w; B.HS trap 7
fn bo_schk ty ulong rb ulong to void
