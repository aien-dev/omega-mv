if eq w 32497639802299751
ret 113
end
if eq w 32760384594014051
ret 114
end
if eq w 1684957538
ret 115
end
if eq w 28263429381382519
ret 116
end
if eq w 499851228006
ret 117
end
if eq w 1986225522
ret 118
end
if eq w 1684956531
ret 119
end
if eq w 32491051338263667
ret 120
end
if eq w 128017462948449
ret 121
end
if eq w 28254586010038881
ret 122
end
if eq w 111546465018726
ret 100
end
if eq w 427055215462
ret 101
end
if eq w 110429739705190
ret 102
end
if eq w 461262648166
ret 103
