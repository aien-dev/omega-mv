put nb 0 i
k = get bkind i
fz_join i k
if eq k 2
put dead 0 and get dead 0 get bdead i
else
put dead 0 0
end
if eq k 4
lat = get oc 0
j = ulong 0
while lt j get ncont 0
if eq get cblk j i
patch19 get cpos j lat
put cblk j 65535
end
j = add j 1
end
put fr 0 1
put fr 1 get breg i
put fr 2 get btyp i
put fr 3 3
put fr 4 1
put fr 5 get btyp i
binop 33 get breg i 0
end
if eq k 3
j = ulong 0
while lt j get ncont 0
if eq get cblk j i
patch19 get cpos j get bhead i
put cblk j 65535
end
j = add j 1
end
end
if ge k 3
back get bhead i
ex = get oc 0
j = ulong 0
while lt j get nbrk 0
if eq get brkblk j i
patch19 get brkpos j ex
put brkblk j 65535
end
j = add j 1
end
end
if eq k 2
if or eq get xtarget 0 0 eq get bdead i 0
patch26 get bbr i get oc 0
end
else
patch19 get bbr i get oc 0
end
put nn 0 get bnames i
put held 0 get bheld i
eol
end

note ======== the end of the input: the output ========
note writeout: the output from byte st to the end, to stdout (error 2), then exit 0. om4 WRITEOUT.
fn writeout st ulong to void
