np = get fr add cb 18
i = ulong 0
while lt i np
q = add cb mul i 3
loadarg i get fr q get fr add q 1
i = add i 1
end
ca_bl f
hr = ulong 1
if eq get fn_ret sub f 1 10
hr = ulong 0
end
n = get svn 0
a = get sva 0
sl = get fr add cb 19
r = restore dst sl n a hr
put rk 0 1
put rv 0 r
put rt 0 ulong get fn_ret sub f 1
end

note vs_fd, vs_arr, vs_off, vs_end: the steps of read / write between the values it reads, with the fd
note (kind, value), the offset register and the pool slot before kept in fr[x+8..x+11] (om4's VT_SYS
note frame slots 4, 5, 7 and 14)
fn vs_fd x ulong to void
if ne get rt 0 8
fail 7
end
put fr add x 9 get rk 0
put fr add x 10 get rv 0
end

fn vs_arr c ulong e ulong to void
if eq c 53
k = get nm_kind sub e 1
if or eq k 2 eq k 5
fail 20
end
end
end

fn vs_off x ulong to void
if ne get rt 0 5
fail 7
end
put fr add x 11 matreg get rk 0 get rv 0 get rt 0
end

fn vs_end c ulong e ulong dst ulong x ulong to void
if ne get rt 0 5
fail 7
end
rn = matreg get rk 0 get rv 0 get rt 0
ro = get fr add x 11
vs_chk e ro rn
fk = get fr add x 9
fv = get fr add x 10
vs_call c fk fv e ro rn
sl = get fr add x 8
n = get svn 0
a = get sva 0
r = restore dst sl n a 1
vdone 1 r 9
end

note Native Linux ARM64 host operations. Encoding forms are those in seed/rung2/table.s2.
note Syscall numbers and layouts: Linux asm-generic/unistd.h, fcntl.h and time.h.
note No raw address or arbitrary syscall is exposed to an Omega program.
fn hargc c ulong to ulong
if or or eq c 107 eq c 109 eq c 129
ret 0
end
if or eq c 100 eq c 101
ret 1
end
if or or or eq c 102 eq c 105 eq c 106 eq c 127
ret 2
end
ret 3
end
fn hsysno c ulong to ulong
if eq c 127
ret 129
end
if eq c 129
ret 172
end
if eq c 100
ret 57
end
if eq c 101
ret 82
end
if eq c 102
ret 52
end
if eq c 103
ret 62
end
if eq c 104
ret 198
end
if eq c 105
ret 201
end
if eq c 106
ret 242
end
if eq c 107
ret 220
end
ret 24
end
fn harg x ulong i ulong ty ulong to void
rdval 0 ty 255 0
if ne get rt 0 ty
fail 7
end
q = add add x 8 mul i 2
put fr q get rk 0
put fr add q 1 get rv 0
end
fn hload x ulong i ulong reg ulong to void
q = add add x 8 mul i 2
loadarg reg get fr q get fr add q 1
end
fn hsys n ulong to void
matconst 8 n
emit 3556769793
end
fn hreturn dst ulong x ulong to void
sl = get fr add x 7
n = get svn 0
a = get sva 0
r = restore dst sl n a 1
vdone 1 r 9
end
fn hscalar c ulong dst ulong x ulong to void
np = hargc c
for i ulong np
ty = ulong 8
if and eq c 103 eq i 1
ty = ulong 9
end
harg x i ty
end
save
for i ulong np
hload x i i
end
if eq c 106
hload x 1 3
matconst 1 0
matconst 2 0
end
if eq c 107
matconst 0 17
for i ulong 5
matconst add i 1 0
end
end
hsys hsysno c
hreturn dst x
end
fn hclock c ulong dst ulong x ulong to void
save
spsub 16
stkchk
matconst 0 1
if eq c 130
matconst 0 0
