if eq get nm_kind i 5
b = alloc
mataddr b get nm_addr i
end
xload 0 ro
xb 72 193 224
emitb uchar tlog ulong get nm_type i
xload 1 b
xrr 1 0 1
xstore 0 d
ret d
end
