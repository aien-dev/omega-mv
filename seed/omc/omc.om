j = get nb 0
found = ulong 0
bi = ulong 0
while and eq found 0 gt j 0
j = sub j 1
if ge get bkind j 3
found = ulong 1
bi = j
end
end
if eq found 0
fail 9
end
n = get ncont 0
if ge n 1024
fail 14
end
put cpos n get oc 0
put cblk n bi
put ncont 0 add n 1
emit 1409286158
dead1
eol
end

