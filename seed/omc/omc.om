t = typeword
ln = ulong 0
p = get cur 0
ln0 = get line 0
tok
if eq get tk 0 2
ln = get tw 0
if ne get tbig 0 0
fail 14
end
if or eq ln 0 gt ln 64
fail 14
end
else
put cur 0 p
put line 0 ln0
end
addc = ulong 1
if ne ln 0
addc = ln
end
if gt add cells addc 64
fail 14
end
put sf_name get nsf 0 fw
put sf_type get nsf 0 uchar t
put sf_len get nsf 0 uchar ln
put sf_off get nsf 0 uchar cells
put nsf 0 add get nsf 0 1
ret add cells addc
end

