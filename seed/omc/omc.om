ir_val 65534 1
bnd = ulong 1000000
tok
if and eq get tk 0 1 eq kw get tw 0 70
tok
bnd = get tw 0
end
lim = ir_lit bnd 5
ir_op 14 get ir_rr 0 g ex 0
ir_start g
ger = ir_newreg 1
ir_op 5 6 ger cnt lim
ir_op 14 ger tb body 0
ir_start tb
ir_op 12 4 0 0 0
ir_op 13 ex 0 0 0
