if eq get progmode 0 0
pass = ulong 0
while lt pass get nf 0
f = ulong 0
while lt f get nf 0
if eq get settled f 0
ok = true
i = ulong 0
while and ok lt i n
if eq get callfrom i add f 1
if eq get settled sub get callto i 1 0
ok = false
end
end
i = add i 1
end
if ok
put settled f 1
end
end
f = add f 1
end
pass = add pass 1
end
f = ulong 0
while lt f get nf 0
if eq get settled f 0
fail 9
end
f = add f 1
end
end
end

