sh = get held 0
tok
if eq get tk 0 0
fail 4
end
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
w = get tw 0
if ne kw w 0
fail 16
end
newname w get tl 0 get ts 0
t = typeword
if or eq t 1 ge t 10
fail 7
end
tok
if eq get tk 0 0
fail 4
end
if eq get tk 0 2
range get tw 0 t get tbig 0
if ne get om2 0 0
kk = get tw 0
if eq peekw 181
s_unroll w t kk sn sh
ret
end
put tw 0 kk
end
sf_num w t get tw 0 sn sh
ret
end
rdval 1 t 255 0
if ne get rt 0 t
fail 7
end
if ne get om2 0 0
if eq peekw 181
fail 16
end
end
if eq get rk 0 3
sf_num w t get rv 0 sn sh
ret
end
kr = matreg get rk 0 get rv 0 get rt 0
sf_val w t kr sn sh
end

note ======== OM-2 section 4: unroll, inline, folding, the growth bound and trap-site records ========
note peekw: the keyword code of the next word (0 for anything else) without reading it
fn peekw to ulong
c0 = get cur 0
l0 = get line 0
a0 = get tka 0
b0 = get tkb 0
tok
r = ulong 0
if eq get tk 0 1
if le get tl 0 8
r = kw get tw 0
end
end
put cur 0 c0
put line 0 l0
put tka 0 a0
put tkb 0 b0
ret r
end

note s_unroll: for i T K unroll (K a number 1..64, error 8 outside). i is a constant name (kind 9) bound to
note 0..K-1 in turn; the body is read K times from its first line (s_unr). No branch is emitted.
fn s_unroll w ulong t ulong kk ulong sn ulong sh ulong to void
if or eq kk 0 gt kk 64
fail 8
end
fl = get line 0
fuelc fl
tok
eol
addname w 0 t 0 9 0
n = get nb 0
pushb 0 5 0 sub get nn 0 1 t
pushnh sn sh
put u_cur n get cur 0
put u_line n get line 0
put u_it n 0
put u_k n kk
put u_nn n get nn 0
put u_held n get held 0
put u_fl n fl
put fzone 0 add get fzone 0 1
end

note fuelc: charge one expansion to the function's fuel; the 65537th is error 14 on line ln (E14)
fn fuelc ln ulong to void
if ge get fuel 0 65536
put line 0 ln
fail 14
end
put fuel 0 add get fuel 0 1
end

note s_unr: the end of an unrolled body: read it again with the next value of i, or close the block
fn s_unr i ulong to void
eol
it = add get u_it i 1
if lt it get u_k i
fuelc get u_fl i
put u_it i it
put nm_addr get breg i it
put nn 0 get u_nn i
put held 0 get u_held i
put dead 0 0
put cur 0 get u_cur i
put line 0 get u_line i
ret
end
put nb 0 i
put nn 0 get bnames i
put held 0 get bheld i
put dead 0 0
put fzone 0 sub get fzone 0 1
end

note fn_tail: the end of a fn line: an optional inline (OM-2), then the line ends; records the body start
fn fn_tail f ulong to void
tok
k = get tk 0
if eq k 1
if ne get om2 0 0
if le get tl 0 8
if eq kw get tw 0 182
put fn_inl f 1
eol
put fn_body f get cur 0
put fn_bln f get line 0
ret
end
end
end
end
if and ne k 0 ne k 3
put dexp 0 6
fail 5
end
put fn_body f get cur 0
put fn_bln f get line 0
end

note inl_call: a call of an inline function fe (index + 1): the result register first (dst, or the next
note pool slot), then the arguments left to right exactly as for a call, then the body in place.
fn inl_call fe ulong dst ulong to void
s0 = get nslot 0
rres = ulong 255
ns = s0
if ne get fn_ret sub fe 1 10
if eq dst 255
rres = alloc
ns = add s0 1
else
rres = dst
end
end
cb = add mul get depth 0 32 8
np = ulong get fn_np sub fe 1
put fr add cb 18 np
put fr add cb 19 get nslot 0
i = ulong 0
while lt i np
p = add mul sub fe 1 6 i
if eq get fn_pk p 0
rdval 0 ulong get fn_pt p 255 0
ca_scal p add cb mul i 3
else
if ge get fn_pk p 6
ca_st fe i cb
else
ca_arr fe i cb
end
end
i = add i 1
end
inl_body fe cb ns rres
end

note inl_par: bind parameter i of inline function fe to its argument in frame cb. A scalar held in a
note temporary register (pool index hb or above) is taken as it is; any other scalar is copied to a new
note register. An array or struct takes its base register; a text's address is loaded into one.
fn inl_par fe ulong cb ulong i ulong hb ulong to void
p = add mul sub fe 1 6 i
q = add cb mul i 3
k = get fr q
v = get fr add q 1
r = ulong 0
if eq get fn_pk p 0
if and eq k 1 ge regidx v hb
r = v
else
r = alloc
force k v ulong get fn_pt p r
end
else
if eq k 5
r = v
else
r = alloc
matconst r v
end
end
inl_add p r
fz_inl p get fr add q 2
end

note inl_add: the name of parameter slot p on register r (a view struct is name kind 8, an edit one 7)
fn inl_add p ulong r ulong to void
pk = ulong get fn_pk p
if eq pk 0
addname get fn_pn p r ulong get fn_pt p 0 0 0
ret
end
nk = pk
if eq pk 6
nk = ulong 8
end
addname get fn_pn p r ulong get fn_pt p get fn_pl p nk 0
put nm_lay sub get nn 0 1 get fn_play p
end

note inl_edge: record the call-graph edge (expanding function -> inline function) once (16384 edges, error 14)
fn inl_edge a ulong b ulong to void
n = get nie 0
j = ulong 0
while lt j n
if and eq get ie_from j a eq get ie_to j b
ret
end
j = add j 1
end
if ge n 16384
fail 14
end
put ie_from n a
put ie_to n b
put nie 0 add n 1
end

note inl_body: at most 4 nested inline frames (error 14); an inline function reached again while it is
note being inlined, or from its own body, is error 9. The caller's local names are hidden, the parameters
note bound, and the body's lines compiled here until its end (s_inlx) closes the frame.
note Each expansion costs one unit of the function's fuel (E14).
fn inl_body fe ulong cb ulong ns ulong rres ulong to void
lv = get inl 0
fuelc get line 0
if ge lv 4
fail 14
end
if eq get curfn 0 fe
fail 9
end
j = ulong 0
while lt j lv
if eq get il_fn j fe
fail 9
end
j = add j 1
end
inl_edge get curfn 0 fe
put il_cur lv get cur 0
put il_line lv get line 0
put il_ret lv get curret 0
put il_nn lv get nn 0
put il_lo lv get nmlo 0
put il_held lv get held 0
put il_ns lv ns
put il_res lv rres
put il_fn lv fe
put il_p0 lv get nilp 0
put il_fz lv get fz_n 0
inl_bind fe cb
pushb 0 6 0 fe 0
pushnh get il_nn lv get il_held lv
put inl 0 add lv 1
put fzone 0 add get fzone 0 1
put curret 0 ulong get fn_ret sub fe 1
put dead 0 0
put cur 0 get fn_body sub fe 1
put line 0 get fn_bln sub fe 1
inl_run lv
end

note inl_bind: hide the caller's local names, bind the parameters, protect every register in use
fn inl_bind fe ulong cb ulong to void
hb = add get npar 0 get held 0
put nmlo 0 get nn 0
np = ulong get fn_np sub fe 1
i = ulong 0
while lt i np
inl_par fe cb i hb
i = add i 1
end
put held 0 get nslot 0
end

note inl_run: compile the inlined body's lines until its frame (level lv) is closed
fn inl_run lv ulong to void
go = true
while go
m = ulong 0
while and go lt m 999999
if ne stmt 0
fail 15
end
if le get inl 0 lv
go = false
end
m = add m 1
end
end
end

note inlb: the B of an inlined ret, patched to the frame's end
fn inlb to void
n = get nilp 0
if ge n 4096
fail 14
end
put ilp n get oc 0
put nilp 0 add n 1
emit 335544320
put lastb 0 get oc 0
end

note s_iret: ret inside an inlined body: the value into the frame's result register, then B to its end
fn s_iret to void
lv = sub get inl 0 1
r = get curret 0
if eq r 10
eol
inlb
dead1
ret
end
rdval 0 r get il_res lv 0
if ne get rt 0 r
fail 7
end
force get rk 0 get rv 0 get rt 0 get il_res lv
inlb
dead1
eol
end

note s_inlx: the end of an inlined body: a value function must not reach it (error 18). A last ret's B
note that is the last word, with no branch patched to the place after it, is taken back; the other rets
note branch here. The caller's line, names, registers and return type come back; the result is in rk/rv/rt.
fn s_inlx i ulong to void
eol
lv = sub get inl 0 1
fe = get il_fn lv
if eq get dead 0 0
if ne get fn_ret sub fe 1 10
fail 18
end
end
inl_pat get il_p0 lv
put nb 0 i
put cur 0 get il_cur lv
put line 0 get il_line lv
put curret 0 get il_ret lv
put nn 0 get il_nn lv
put nmlo 0 get il_lo lv
put held 0 get il_held lv
put nslot 0 get il_ns lv
put dead 0 0
put inl 0 lv
put fzone 0 sub get fzone 0 1
put fz_n 0 get il_fz lv
put rk 0 1
put rv 0 get il_res lv
put rt 0 ulong get fn_ret sub fe 1
end

note inl_pat: patch the frame's ret B words (from p0) to here, after taking back a last one that is the
note last word and that no branch was patched past
fn inl_pat p0 ulong to void
n = get nilp 0
o = get oc 0
if and ne get dead 0 0 gt n p0
if eq get lastb 0 o
if ne get tgoc 0 o
if eq get ilp sub n 1 sub o 4
put oc 0 sub o 4
n = sub n 1
end
end
end
end
j = p0
while lt j n
patch26 get ilp j get oc 0
j = add j 1
end
put nilp 0 p0
end

note ---- folding (only while fzone is above 0): an operation on two typed numbers is computed with OM-1
note arithmetic: unsigned wraps to its width, signed results are sign-extended; an operation that would
note trap (signed overflow, divide by 0, a shift or rotate amount at or above the width) is not folded.
fn fmask w ulong to ulong
if ge w 64
ret not ulong 0
end
ret sub shl ulong 1 w 1
end

fn fasr x ulong s ulong to ulong
if eq shr x 63 0
ret shr x s
end
ret not shr not x s
end

fn fsext r ulong w ulong to ulong
if ge w 64
ret r
end
ret fasr shl r sub 64 w sub 64 w
end

fn fyes v ulong t ulong to void
put fval 0 v
put fty 0 t
put fok 0 1
end

fn fb_cmp op ulong sg ulong a ulong b ulong to void
x = a
y = b
if ne sg 0
x = xor a shl ulong 1 63
y = xor b shl ulong 1 63
end
r = false
if eq op 43
r = eq x y
end
if eq op 44
r = ne x y
end
if eq op 45
r = lt x y
end
if eq op 46
r = le x y
end
if eq op 47
r = gt x y
end
if eq op 48
r = ge x y
end
v = ulong 0
if r
v = ulong 1
end
fyes v 1
end

fn fb_arith op ulong ty ulong w ulong sg ulong a ulong b ulong to void
r = ulong 0
if eq op 33
r = add a b
end
if eq op 34
r = sub a b
end
if eq op 35
if ne sg 0
if ge add a shl ulong 1 31 shl ulong 1 32
ret
end
if ge add b shl ulong 1 31 shl ulong 1 32
ret
end
end
r = mul a b
end
if eq sg 0
fyes and r fmask w ty
ret
end
if eq w 64
if eq op 33
if ne shr and xor a r xor b r 63 0
ret
end
end
if eq op 34
if ne shr and xor a b xor a r 63 0
ret
end
end
fyes r ty
ret
end
if ne fsext r w r
ret
end
fyes r ty
end

fn fb_div op ulong ty ulong w ulong sg ulong a ulong b ulong to void
if eq b 0
ret
end
if eq sg 0
if eq op 36
fyes div a b ty
else
fyes rem a b ty
end
ret
end
na = shr a 63
sb = shr b 63
ma = a
if ne na 0
ma = sub 0 a
end
mb = b
if ne sb 0
mb = sub 0 b
end
if eq op 37
rr = rem ma mb
if ne na 0
rr = sub 0 rr
end
fyes rr ty
ret
end
if eq w 64
if eq a shl ulong 1 63
if eq b not ulong 0
ret
end
end
end
q = div ma mb
if ne xor na sb 0
q = sub 0 q
end
if ne fsext q w q
ret
end
fyes q ty
end

fn fb_shift op ulong ty ulong w ulong sg ulong a ulong b ulong to void
if ge b w
ret
end
if eq op 42
if eq sg 0
fyes shr a b ty
else
fyes fasr a b ty
end
ret
end
r = shl a b
if eq sg 0
fyes and r fmask w ty
ret
end
if eq w 64
if ne fasr r b a
ret
end
fyes r ty
ret
end
if ne fsext r w r
ret
end
fyes r ty
end

fn fb_rot op ulong ty ulong w ulong a ulong b ulong to void
if ge b w
ret
end
s = b
if and eq op 60 ne s 0
s = sub w s
end
if eq s 0
fyes a ty
ret
end
fyes and or shr a s shl a sub w s fmask w ty
end

note foldbin: op on the typed numbers a, b of type ty (b's own type for a shift); fok 1 when folded
fn foldbin op ulong ty ulong a ulong b ulong to void
put fok 0 0
if or eq ty 0 ge ty 10
ret
end
sg = ulong 0
if ge ty 6
sg = ulong 1
end
if and ge op 43 le op 48
fb_cmp op sg a b
ret
end
if and ge op 38 le op 40
r = and a b
if eq op 39
r = or a b
end
if eq op 40
r = xor a b
end
fyes r ty
ret
end
if eq ty 1
ret
end
w = twid ty
if le op 35
fb_arith op ty w sg a b
ret
end
if le op 37
fb_div op ty w sg a b
ret
end
if le op 42
fb_shift op ty w sg a b
ret
end
if or eq op 59 eq op 60
if le ty 5
fb_rot op ty w a b
end
end
end

note foldun: neg (49) / not (50) of the typed number a
fn foldun c ulong ty ulong a ulong to void
put fok 0 0
if or eq ty 0 ge ty 10
ret
end
if eq c 50
if eq ty 1
fyes xor a 1 ty
ret
end
if lt ty 6
fyes and not a fmask twid ty ty
ret
end
fyes not a ty
ret
end
if eq ty 1
ret
end
r = sub 0 a
if lt ty 6
fyes and r fmask twid ty ty
ret
end
w = twid ty
if eq w 64
if eq a shl ulong 1 63
ret
end
fyes r ty
ret
end
if ne fsext r w r
ret
end
fyes r ty
end

note ---- omc-site records (om2 diag): one per runtime trap site, in emission order, after the artifact
note on stderr: omc-site 1 line=N iter=k, k the counters of the open unrolled loops outer to inner
note joined by '.', or '-'.
fn siteb b ulong to void
n = get nsite 0
if ge n 8388608
fail 14
end
put sitebuf n uchar b
put nsite 0 add n 1
end

fn sitew w ulong n ulong to void
i = ulong 0
x = w
while lt i n
siteb and x 255
x = shr x 8
i = add i 1
end
end

fn siten v ulong to void
d = new uchar 20 0
i = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0
put d i uchar add rem x 10 48
x = div x 10
i = add i 1
end
j = i
while gt j 0
j = sub j 1
siteb ulong get d j
end
end

fn siterec to void
sitew 7310584038532803951 8
sitew 4424063608026050848 8
siten add get line 0 get lbase 0
sitew 67561537693984 6
any = false
j = ulong 0
while lt j get nb 0
if eq get bkind j 5
if any
siteb 46
end
siten get u_it j
any = true
end
j = add j 1
end
if not any
siteb 45
end
siteb 10
end

fn sitesout to void
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p get nsite 0
go = false
else
n = write 2 sitebuf p sub get nsite 0 p
if le n 0
go = false
else
p = add p ulong n
end
end
m = add m 1
end
end
end

note finish: end of a function: a function that needs a value must not reach its end (error 18), a void
note one returns; then the trap stubs: shared tail, function mode MOV X0, X7; LDR X16, [X7, #16]; BR X16
note (C6.2.282, C6.2.216, C6.2.46: OscRt.trap); program mode ADD X0, X1, #100; MOVZ X8, #93; SVC #0 (exit
note 100 + code). Per trap code used: MOVZ X1, #code (C6.2.285); B tail. om4 FINISH.
fn finish to void
eol
if eq get dead 0 0
if ne get curret 0 10
fail 18
end
epi
end
nt0 = get nt 0
if ne nt0 0
tail = get oc 0
if eq get progmode 0 0
emit 2852586464
emit 4181723376
emit 3592356352
else
emit 2432798752
emit 3531606952
emit 3556769793
end
code = ulong 1
while le code 14
st = ulong 0
j = ulong 0
while lt j nt0
if eq get tcode j code
if eq st 0
st = get oc 0
emit or 3531603969 shl code 5
back tail
end
patch19 get tsite j st
end
j = add j 1
end
code = add code 1
end
end
put curret 0 0
put nn 0 get nglob 0
put curfn 0 0
put nbrk 0 0
put ncont 0 0
end

note s_end: close the innermost block (if: patch its branch; else: patch its jump; while: B head; for: i =
note add i 1, B head), or the function. om4 S_END.
fn s_end to void
n = get nb 0
if eq n 0
finish
ret
end
i = sub n 1
if eq get bkind i 5
s_unr i
ret
end
if eq get bkind i 6
s_inlx i
ret
end
put nb 0 i
k = get bkind i
fz_join i k
if eq k 2
put dead 0 and get dead 0 get bdead i
else
put dead 0 0
end
if eq k 4
lat = get oc 0
j = ulong 0
while lt j get ncont 0
if eq get cblk j i
patch19 get cpos j lat
put cblk j 65535
end
j = add j 1
end
put fr 0 1
put fr 1 get breg i
put fr 2 get btyp i
put fr 3 3
put fr 4 1
put fr 5 get btyp i
binop 33 get breg i 0
end
if eq k 3
j = ulong 0
while lt j get ncont 0
if eq get cblk j i
patch19 get cpos j get bhead i
put cblk j 65535
end
j = add j 1
end
end
if ge k 3
back get bhead i
ex = get oc 0
j = ulong 0
while lt j get nbrk 0
if eq get brkblk j i
patch19 get brkpos j ex
put brkblk j 65535
end
j = add j 1
end
end
if eq k 2
patch26 get bbr i get oc 0
else
patch19 get bbr i get oc 0
end
put nn 0 get bnames i
put held 0 get bheld i
eol
end

note ======== the end of the input: the output ========
note writeout: the output from byte st to the end, to stdout (error 2), then exit 0. om4 WRITEOUT.
fn writeout st ulong to void
if ne get fmtm 0 0
fmtout
end
p = st
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p get oc 0
go = false
else
n = write 1 out p sub get oc 0 p
if le n 0
fail 2
end
p = add p ulong n
end
m = add m 1
end
end
if eq get om2m 0 1
sitesout
end
exit int 0
end

note elfhdr: the 176-byte file header (om4 ELFHDR, 44 words): ELF64 little-endian, executable, AArch64,
note entry 0x4000b0 (the word after the header), 2 program headers: code read+execute from 0x400000, and
note the read/write pools from 0x10000000. Only the words that are not 0 (the output starts at 0).
fn elfhdr to void
wrword 0 1179403647
wrword 4 65794
wrword 16 11993090
wrword 20 1
wrword 24 4194480
wrword 32 64
wrword 52 3670080
wrword 56 2
wrword 64 1
wrword 68 5
wrword 80 4194304
wrword 88 4194304
wrword 112 4096
wrword 120 1
wrword 124 6
wrword 136 268435456
wrword 144 268435456
wrword 168 4096
end

note eof_prog: program mode: start code = MOVZ X28, #0x1000, LSL 16 (stack pool floor); MOVZ X16, #0x1080,
note LSL 16; MOV SP, X16 (ADD immediate, C6.2.5); BL main (C6.2.43); [MOVZ X0, #0 for a void main]; MOVZ X8,
note #93; SVC #0. The entry word after the header is a B to it; the header gets the file and pool sizes.
note om4 EOF_PROG.
fn eof_prog to void
f = findfn 1852399981 4 0
if eq f 0
fail 16
end
if ne get fn_np sub f 1 0
fail 9
end
wrword 176 or 335544320 and shr sub get oc 0 176 2 67108863
if ne get hostargs 0 0
note Preserve Linux's initial argument stack privately before installing Omega's bounded stack.
emit 2432697339
end
emit 3533832220
emit 3533836304
emit 2432696863
emit or 2483027968 and shr sub get fn_addr sub f 1 get oc 0 2 67108863
if eq get fn_ret sub f 1 10
emit 3531603968
end
emit 3531606952
emit 3556769793
elfhdr
wrword 96 get oc 0
wrword 104 get oc 0
wrword 160 add get poolb 0 8388608
writeout 0
end

note s_eof: end of input: no open function (error 15), some function (16); function mode: no globals or
note texts (9); one function: its bare words; more: the entry word, a B to the last function. om4 S_EOF.
note Resolve every call after all addresses are known. In function mode remove leaves of the call
note graph; any functions left after nf rounds form or reach a cycle (error 9).
fn resolve to void
n = get ncalls 0
i = ulong 0
while lt i n
s = get callsite i
f = sub get callto i 1
wrword s or 2483027968 and shr sub get fn_addr f s 2 67108863
i = add i 1
end
if eq get progmode 0 0
pass = ulong 0
while lt pass get nf 0
f = ulong 0
while lt f get nf 0
if eq get settled f 0
ok = true
i = ulong 0
while and ok lt i n
if eq get callfrom i add f 1
if eq get settled sub get callto i 1 0
ok = false
end
end
i = add i 1
end
if ok
put settled f 1
end
end
f = add f 1
end
pass = add pass 1
end
f = ulong 0
while lt f get nf 0
if eq get settled f 0
put dsev 0 3
fail 9
end
f = add f 1
end
end
end

note inlcyc (OM-2): an inline function that reaches itself through the whole call graph (the calls made,
note plus an edge from each function to every inline function expanded in it) is error 9 at the end.
fn inlcyc to void
f = ulong 1
while le f get nf 0
if ne get fn_inl sub f 1 0
if ne reachself f 0
put dsev 0 3
fail 9
end
end
f = add f 1
end
end

note reachself: 1 when function f (index + 1) reaches itself
fn reachself f ulong to ulong
i = ulong 0
while lt i get nf 0
put reach i 0
i = add i 1
end
put reach sub f 1 1
go = true
pass = ulong 0
while and go le pass get nf 0
r = rscan f 0
if eq r 2
ret 1
end
s = rscan f 1
if eq s 2
ret 1
end
go = or ne r 0 ne s 0
pass = add pass 1
end
ret 0
end

note rscan: one pass over the calls (w 0) or the inline edges (w 1): 2 when an edge from a reached
note function leads to f, 1 when a function was newly reached, else 0
fn rscan f ulong w ulong to ulong
n = get ncalls 0
if ne w 0
n = get nie 0
end
ch = ulong 0
j = ulong 0
while lt j n
a = get callfrom j
b = get callto j
if ne w 0
a = get ie_from j
b = get ie_to j
end
if ne get reach sub a 1 0
if eq b f
ret 2
end
if eq get reach sub b 1 0
put reach sub b 1 1
ch = ulong 1
end
end
j = add j 1
end
ret ch
end

fn s_eof to void
if ne get curret 0 0
fail 15
end
if eq get nf 0 0
fail 16
end
if ne get om2 0 0
inlcyc
end
resolve
if ne get progmode 0 0
eof_prog
end
if ne get nglob 0 0
fail 9
end
if eq get nf 0 1
writeout 180
end
a = get fn_addr sub get lastfn 0 1
wrword 176 or 335544320 and shr sub a 176 2 67108863
writeout 176
end

note stmt: one line. Returns 1 at the end of the input. om4 STMT.
