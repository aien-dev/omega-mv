note ps_at: the line's first byte that is not blank is at p: 1 when the line is `fn main`, 2 when the input
note ends while deciding, else 0. om4 PS_LINE .. PS_YES.
fn ps_at p ulong to ulong
e = get inlen 0
if ne get inp p 102
ret 0
end
q = add p 1
if ge q e
ret 2
end
if ne get inp q 110
ret 0
end
r = add q 1
q = skipbl r
if ge q e
ret 2
end
if eq q r
ret 0
end
if gt add q 4 e
ret 0
end
if ne get inp q 109
ret 0
end
if ne get inp add q 1 97
ret 0
end
if ne get inp add q 2 105
ret 0
end
if ne get inp add q 3 110
ret 0
end
if ge add q 4 e
ret 1
end
if gt get inp add q 4 32
ret 0
end
ret 1
end

fn prescan to void
e = get inlen 0
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
p = skipbl p
if ge p e
go = false
else
r = ps_at p
if eq r 1
put progmode 0 1
go = false
end
if eq r 2
go = false
end
if go
p = skipln p
if ge p e
go = false
end
end
end
m = add m 1
end
end
end

note First collect signatures. Only fn headers are parsed here; other lines are read in the body pass.
fn namescan to void
