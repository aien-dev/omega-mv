force get rk 0 get rv 0 get rt 0 0
emit 3531606952
emit 3556769793
dead1
eol
end

note stel: the checked store of v (type t) at ea_b / ea_i (the STOP table: register offset, scaled)
fn stel t ulong v ulong to void
b = shl get ea_b 0 5
i = shl get ea_i 0 16
emit or or or stop t v b i
end

note s_put: put A i v: index, then value, then the checked store (STOP table). om4 S_PUT.
fn s_put to void
e = arrname
k = get nm_kind sub e 1
if or eq k 2 eq k 5
fail 20
end
rdval 0 5 255 0
ik = get rk 0
iv = get rv 0
it = get rt 0
t = ulong get nm_type sub e 1
rdval 0 t 255 0
if ne get rt 0 t
fail 7
end
v = matreg get rk 0 get rv 0 get rt 0
elemaddr e ik iv it
stel t v
eol
end

note s_global: global NAME T N: a fixed pool of N elements, zero at start, in the read/write part of the
note program image after the 8 MiB stack pool (address 0x10800000 + pool bytes so far); at most 1 GiB of
note pools (error 23). om4 S_GLOBAL.
fn s_global to void
w = topname
t = typeword
elemtype t
tok
if ne get tk 0 2
fail 16
end
n = get tw 0
arrlen n
by = shl shr add shl n tlog t 15 4 4
pb = get poolb 0
a = add 276824064 pb
s = add pb by
if gt s 1073741824
fail 23
end
put poolb 0 s
addname w 0 t n 4 a
put nglob 0 get nn 0
eol
end

note s_text: text NAME "...": read-only bytes in the program image (escapes \n \t \\ \", any other is error
note 22), padded to a word, with their length; address 0x400000 + its place. om4 S_TEXT.
fn s_text to void
w = topname
tok
if ne get tk 0 4
fail 16
end
a = add get oc 0 4194304
p = get tw 0
e = add p get tl 0
n = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = get inp p
p = add p 1
if eq b 92
b = get inp p
p = add p 1
if eq b 110
b = uchar 10
else
if eq b 116
b = uchar 9
else
if and ne b 92 ne b 34
fail 22
end
end
end
end
emitb b
n = add n 1
end
m = add m 1
end
end
while ne and get oc 0 3 0
emitb 0
end
addname w 0 2 n 5 a
put nglob 0 get nn 0
eol
end

note s_if: if cond: the false branch is patched at else / end. om4 S_IF.
fn s_if to void
at = cond
pushb at 1 0 0 0
pushnh get nn 0 get held 0
eol
end

note s_else: jump over the else part (B, C6.2.35); the if's false branch lands after that jump. om4 S_ELSE.
fn s_else to void
n = get nb 0
if eq n 0
fail 15
end
i = sub n 1
if ne get bkind i 1
fail 15
end
b = get oc 0
emit 335544320
patch19 get bbr i get oc 0
put bkind i 2
put bbr i b
put nn 0 get bnames i
put held 0 get bheld i
put bdead i get dead 0
put dead 0 0
eol
end

note lpcnt: the hidden counter check of a loop: CMP Xc, #N (C6.2.96) or CMP Xc, Xn (C6.2.97); B.HS trap
note 4; ADD Xc, Xc, #1 (C6.2.5). om4 SW_NOB .. SW_G and the same in S_FOR.
fn lpcnt c ulong n ulong to void
if le n 4095
emit or or 4043309087 shl n 10 shl c 5
else
m = alloc
matconst m n
emit or or 3942645791 shl c 5 shl m 16
end
trapc 2 4
emit or or 2432697344 c shl c 5
end

note s_while: while cond [bound N]: hidden counter = 0; head: cond false -> exit; counter >= N -> trap 4;
note counter = counter + 1; body; B head. N is 1 .. 999999 (error 8), 1000000 with no bound. om4 S_WHILE.
fn s_while to void
sn = get nn 0
sh = get held 0
c = alloc
put held 0 get nslot 0
emit or 3531603968 c
hd = get oc 0
br = cond
n = ulong 1000000
tok
k = get tk 0
if and ne k 0 ne k 3
if ne k 1
fail 5
end
if gt get tl 0 8
fail 5
end
if ne kw get tw 0 70
fail 5
end
tok
if eq get tk 0 0
fail 4
end
if ne get tk 0 2
fail 16
end
if ge sub get tw 0 1 999999
fail 8
end
n = get tw 0
eol
end
lpcnt c n
pushb br 3 hd c 0
pushnh sn sh
end

note sf_br: B.HS (unsigned) or B.GE (signed) to the loop exit, C6.2.34 (distance filled at end); returns
note its place. om4 SF_BR.
fn sf_br t ulong to ulong
at = get oc 0
if lt t 6
emit 1409286146
else
emit 1409286154
end
ret at
end

note sf_num: for i T K with K a number: i = 0 (MOVZ, C6.2.285); head: CMP Xi, #K or Xk; B.HS/B.GE exit.
note om4 SF_NUM .. SF_PUSH.
fn sf_num w ulong t ulong kk ulong sn ulong sh ulong to void
eol
i = alloc
put held 0 get nslot 0
addname w i t 0 0 0
emit or 3531603968 i
hd = get oc 0
if le kk 4095
emit or or 4043309087 shl kk 10 shl i 5
else
k = alloc
matconst k kk
emit or or 3942645791 shl i 5 shl k 16
end
br = sf_br t
pushb br 4 hd i t
pushnh sn sh
end

note sf_val: for i T K with K a value of type T in register kr: i = 0; the hidden counter c = 0; head: CMP
note Xi, Xk; B.HS/B.GE exit; the counter guard of a while with no bound. om4 SF_VAL.
fn sf_val w ulong t ulong kr ulong sn ulong sh ulong to void
eol
i = alloc
put held 0 get nslot 0
addname w i t 0 0 0
emit or 3531603968 i
c = alloc
put held 0 get nslot 0
emit or 3531603968 c
hd = get oc 0
emit or or 3942645791 shl kr 16 shl i 5
br = sf_br t
m = alloc
matconst m 1000000
emit or or 3942645791 shl c 5 shl m 16
trapc 2 4
emit or or 2432697344 c shl c 5
pushb br 4 hd i t
pushnh sn sh
end

note s_for: for i T K: i = 0; head: not i < K -> exit; body; latch i = add i 1; B head. K a number, or a
note value of type T: a name is read at every pass, another value once before the loop. om4 S_FOR.
fn s_for to void
sn = get nn 0
sh = get held 0
tok
if eq get tk 0 0
fail 4
end
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
w = get tw 0
if ne kw w 0
fail 16
end
newname w get tl 0 get ts 0
t = typeword
if eq t 1
fail 7
end
tok
if eq get tk 0 0
fail 4
end
if eq get tk 0 2
range get tw 0 t get tbig 0
sf_num w t get tw 0 sn sh
ret
end
rdval 1 t 255 0
if ne get rt 0 t
fail 7
end
if eq get rk 0 3
sf_num w t get rv 0 sn sh
ret
end
kr = matreg get rk 0 get rv 0 get rt 0
sf_val w t kr sn sh
end

note finish: end of a function: a function that needs a value must not reach its end (error 18), a void
note one returns; then the trap stubs: shared tail, function mode MOV X0, X7; LDR X16, [X7, #16]; BR X16
note (C6.2.282, C6.2.216, C6.2.46: OscRt.trap); program mode ADD X0, X1, #100; MOVZ X8, #93; SVC #0 (exit
note 100 + code). Per trap code used: MOVZ X1, #code (C6.2.285); B tail. om4 FINISH.
fn finish to void
eol
if eq get dead 0 0
if ne get curret 0 10
fail 18
end
epi
end
nt0 = get nt 0
if ne nt0 0
tail = get oc 0
if eq get progmode 0 0
emit 2852586464
emit 4181723376
emit 3592356352
else
emit 2432798752
emit 3531606952
emit 3556769793
end
code = ulong 1
while le code 14
st = ulong 0
j = ulong 0
while lt j nt0
if eq get tcode j code
if eq st 0
st = get oc 0
emit or 3531603969 shl code 5
back tail
end
patch19 get tsite j st
end
j = add j 1
end
code = add code 1
end
end
put curret 0 0
put nn 0 get nglob 0
put curfn 0 0
end

note s_end: close the innermost block (if: patch its branch; else: patch its jump; while: B head; for: i =
note add i 1, B head), or the function. om4 S_END.
fn s_end to void
n = get nb 0
if eq n 0
finish
ret
end
i = sub n 1
put nb 0 i
k = get bkind i
if eq k 2
put dead 0 and get dead 0 get bdead i
else
put dead 0 0
end
if eq k 4
put fr 0 1
put fr 1 get breg i
put fr 2 get btyp i
put fr 3 3
put fr 4 1
put fr 5 get btyp i
binop 33 get breg i 0
end
if ge k 3
back get bhead i
end
if eq k 2
patch26 get bbr i get oc 0
else
patch19 get bbr i get oc 0
end
put nn 0 get bnames i
put held 0 get bheld i
eol
end

note ======== the end of the input: the output ========
note writeout: the output from byte st to the end, to stdout (error 2), then exit 0. om4 WRITEOUT.
fn writeout st ulong to void
p = st
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p get oc 0
go = false
else
n = write 1 out p sub get oc 0 p
if le n 0
fail 2
end
p = add p ulong n
end
m = add m 1
end
end
exit int 0
end

note elfhdr: the 176-byte file header (om4 ELFHDR, 44 words): ELF64 little-endian, executable, AArch64,
note entry 0x4000b0 (the word after the header), 2 program headers: code read+execute from 0x400000, and
note the read/write pools from 0x10000000. Only the words that are not 0 (the output starts at 0).
fn elfhdr to void
wrword 0 1179403647
wrword 4 65794
wrword 16 11993090
wrword 20 1
wrword 24 4194480
wrword 32 64
wrword 52 3670080
wrword 56 2
wrword 64 1
wrword 68 5
wrword 80 4194304
wrword 88 4194304
wrword 112 4096
wrword 120 1
wrword 124 6
wrword 136 268435456
wrword 144 268435456
wrword 168 4096
end

note eof_prog: program mode: start code = MOVZ X28, #0x1000, LSL 16 (stack pool floor); MOVZ X16, #0x1080,
note LSL 16; MOV SP, X16 (ADD immediate, C6.2.5); BL main (C6.2.43); [MOVZ X0, #0 for a void main]; MOVZ X8,
note #93; SVC #0. The entry word after the header is a B to it; the header gets the file and pool sizes.
note om4 EOF_PROG.
fn eof_prog to void
f = findfn 1852399981 4 0
if eq f 0
fail 16
end
if ne get fn_np sub f 1 0
fail 9
end
wrword 176 or 335544320 and shr sub get oc 0 176 2 67108863
if ne get hostargs 0 0
note Preserve Linux's initial argument stack privately before installing Omega's bounded stack.
emit 2432697339
end
emit 3533832220
emit 3533836304
emit 2432696863
emit or 2483027968 and shr sub get fn_addr sub f 1 get oc 0 2 67108863
if eq get fn_ret sub f 1 10
emit 3531603968
end
emit 3531606952
emit 3556769793
elfhdr
wrword 96 get oc 0
wrword 104 get oc 0
wrword 160 add get poolb 0 8388608
writeout 0
end

note s_eof: end of input: no open function (error 15), some function (16); function mode: no globals or
note texts (9); one function: its bare words; more: the entry word, a B to the last function. om4 S_EOF.
note Resolve every call after all addresses are known. In function mode remove leaves of the call
note graph; any functions left after nf rounds form or reach a cycle (error 9).
fn resolve to void
n = get ncalls 0
i = ulong 0
while lt i n
s = get callsite i
f = sub get callto i 1
wrword s or 2483027968 and shr sub get fn_addr f s 2 67108863
i = add i 1
end
if eq get progmode 0 0
pass = ulong 0
while lt pass get nf 0
f = ulong 0
while lt f get nf 0
if eq get settled f 0
ok = true
i = ulong 0
while and ok lt i n
if eq get callfrom i add f 1
if eq get settled sub get callto i 1 0
ok = false
end
end
i = add i 1
end
if ok
put settled f 1
end
end
f = add f 1
end
pass = add pass 1
end
f = ulong 0
while lt f get nf 0
if eq get settled f 0
fail 9
end
f = add f 1
end
end
end

fn s_eof to void

if ne get curret 0 0
fail 15
end
if eq get nf 0 0
fail 16
end
resolve
if ne get progmode 0 0
eof_prog
end
if ne get nglob 0 0
fail 9
end
if eq get nf 0 1
writeout 180
end
a = get fn_addr sub get lastfn 0 1
wrword 176 or 335544320 and shr sub a 176 2 67108863
writeout 176
end

note stmt: one line. Returns 1 at the end of the input. om4 STMT.
fn stmt to ulong
put nslot 0 get held 0
tok
k = get tk 0
if eq k 0
ret 0
end
if eq k 3
s_eof
ret 1
end
if ne k 1
fail 16
end
if gt get tl 0 8
s_long
ret 0
end
w = get tw 0
c = kw w
if eq c 83
skipnl
ret 0
end
if eq c 64
s_fn
ret 0
end
if eq get curret 0 0
if eq c 78
s_global
ret 0
end
if eq c 79
s_text
ret 0
end
fail 16
end
if eq c 66
s_end
ret 0
end
if eq c 68
s_else
ret 0
end
if ne get dead 0 0
fail 17
end
if eq c 0
s_name w
ret 0
end
if eq c 67
s_if
ret 0
end
if eq c 69
s_while
ret 0
end
if eq c 71
s_for
ret 0
end
if eq c 72
s_ret
ret 0
end
if eq c 80
s_put
ret 0
end
if eq c 82
s_exit
ret 0
end
if or or or eq c 77 eq c 78 eq c 79 eq c 81
fail 9
end
fail 16
ret 0
end

note ======== program mode: some line is `fn main` (blanks, fn, blanks, main, then a blank or the end) ========
note skipbl: the first place at or after q that is not a space or tab (or the end)
fn skipbl q ulong to ulong
e = get inlen 0
p = q
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = get inp p
if or eq b 32 eq b 9
p = add p 1
else
go = false
end
end
m = add m 1
end
end
ret p
end

note skipln: the place after the next newline at or after q (or the end)
fn skipln q ulong to ulong
e = get inlen 0
p = q
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = get inp p
p = add p 1
if eq b 10
go = false
end
end
m = add m 1
end
end
ret p
end

note ps_at: the line's first byte that is not blank is at p: 1 when the line is `fn main`, 2 when the input
note ends while deciding, else 0. om4 PS_LINE .. PS_YES.
fn ps_at p ulong to ulong
e = get inlen 0
if ne get inp p 102
ret 0
end
q = add p 1
if ge q e
ret 2
end
if ne get inp q 110
ret 0
end
r = add q 1
q = skipbl r
if ge q e
ret 2
end
if eq q r
ret 0
end
if gt add q 4 e
ret 0
end
if ne get inp q 109
ret 0
end
if ne get inp add q 1 97
ret 0
end
if ne get inp add q 2 105
ret 0
end
if ne get inp add q 3 110
ret 0
end
if ge add q 4 e
ret 1
end
if gt get inp add q 4 32
ret 0
end
ret 1
end

fn prescan to void
e = get inlen 0
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
p = skipbl p
if ge p e
go = false
else
r = ps_at p
if eq r 1
put progmode 0 1
go = false
end
if eq r 2
go = false
end
if go
p = skipln p
if ge p e
go = false
end
end
end
m = add m 1
end
end
end

note First collect signatures. Only fn headers are parsed here; other lines are read in the body pass.
fn namescan to void
put scanning 0 1
put line 0 1
go = true
while go
n = ulong 0
while and go lt n 999999
tok
if eq get tk 0 3
go = false
else
if ne get tk 0 0
if and eq get tk 0 1 eq get tw 0 28262
s_fn
else
skipnl
end
end
end
n = add n 1
end
end
put scanning 0 0
put cur 0 0
put line 0 1
put nn 0 0
put curfn 0 0
put curret 0 0
put npar 0 0
put nslot 0 0
put held 0 0
end

note main: read all of stdin
note (8 MiB at most, error 14; a read error is 1), find the mode, then one
note statement per line from output byte 180 (om4 START .. STMT)
fn main to int
off = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge off len inp
fail 14
end
n = read 0 inp off sub len inp off
if eq n 0
go = false
else
if lt n 0
fail 1
end
off = add off ulong n
end
m = add m 1
end
end
put inlen 0 off
prescan
namescan
put oc 0 180
put line 0 1
done = false
while not done
m = ulong 0
while and not done lt m 999999
if ne stmt 0
done = true
end
m = add m 1
end
end
ret 0
end
