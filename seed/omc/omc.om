e = arrname
i = sub e 1
k = ulong get nm_kind i
if ge k 6
fail 7
end
if eq k 4
fail 19
end
fz_arg e
if eq get fn_pk p 3
if eq md 57
fail 20
end
if and ne k 1 ne k 3
fail 20
end
else
if eq md 58
fail 7
end
end
if ne ulong get nm_type i ulong get fn_pt p
fail 7
end
if ne get fn_pl p 0
fail 7
end
rdval 0 5 255 0
k = get rt 0
if and ne k 5 ne k 13
fail 7
end
ro = matreg get rk 0 get rv 0 k
rdval 0 5 255 0
k = get rt 0
if and ne k 5 ne k 13
fail 7
end
rn = matreg get rk 0 get rv 0 k
d = partck i ro rn
ux = add mul get depth 0 6 pi
put ul_k ux 1
put ul_v ux rn
put rt 0 e
put rk 0 5
put rv 0 d
end

