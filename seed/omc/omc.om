if eq cc 2
ret 3
end
if eq cc 3
ret 2
end
if eq cc 6
ret 0
end
if eq cc 7
ret 1
end
if eq cc 8
ret 7
end
if eq cc 9
ret 6
end
if eq cc 10
ret 13
end
if eq cc 11
ret 12
end
if eq cc 12
ret 15
end
if eq cc 13
ret 14
end
fail 25
ret 0
end

note Every branch reserves six bytes; all targets are byte offsets, not word offsets.
fn xbranch cc ulong to ulong
