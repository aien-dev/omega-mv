put held 0 get nslot 0
addname w i t 0 0 0
emit or 3531603968 i
c = alloc
put held 0 get nslot 0
emit or 3531603968 c
hd = get oc 0
cp_head get cur 0 get line 0
emit or or 3942645791 shl kr 16 shl i 5
br = sf_br t
lpcnt c n
pushb br 4 hd i t
pushnh sn sh
cp_skip
end

note s_for: for i T K [bound N]: i = 0; head: not i < K -> exit; body; latch i = add i 1; B head. K a number,
note or a value of type T: a name is read at every pass, another value once before the loop. More than N
note passes (default 1000000 for a value K, no limit for a number K) trap 4. om4 S_FOR.
fn s_for to void
sn = get nn 0
sh = get held 0
tok
if eq get tk 0 0
fail 4
end
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
w = get tw 0
if ne kw w 0
fail 16
end
newname w get tl 0 get ts 0
t = typeword
if or eq t 1 ge t 10
fail 7
end
tok
if eq get tk 0 0
fail 4
end
if eq get tk 0 2
range get tw 0 t get tbig 0
if ne get om2 0 0
kk = get tw 0
if eq peekw 181
s_unroll w t kk sn sh
ret
end
put tw 0 kk
end
sf_num w t get tw 0 sn sh
ret
end
rdval 1 t 255 0
if ne get rt 0 t
fail 7
end
if ne get om2 0 0
if eq peekw 181
fail 16
end
end
if eq get rk 0 3
sf_num w t get rv 0 sn sh
ret
end
kr = matreg get rk 0 get rv 0 get rt 0
sf_val w t kr sn sh
end

note ======== OM-2 section 4: unroll, inline, folding, the growth bound and trap-site records ========
note peekstar: 1 when the next word is `*` (an unsized array, OM-2), without reading it
fn peekstar to ulong
c0 = get cur 0
l0 = get line 0
a0 = get tka 0
b0 = get tkb 0
tok
r = ulong 0
if and eq get tk 0 1 eq get tl 0 1
if eq get tw 0 42
r = ulong 1
end
end
put cur 0 c0
put line 0 l0
put tka 0 a0
put tkb 0 b0
ret r
end

note peekw: the keyword code of the next word (0 for anything else) without reading it
fn peekw to ulong
c0 = get cur 0
l0 = get line 0
a0 = get tka 0
b0 = get tkb 0
tok
r = ulong 0
if eq get tk 0 1
if le get tl 0 8
r = kw get tw 0
