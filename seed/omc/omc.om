trapc 8 3
d = alloc
e3 3405774848 d rl ro
emit or or 3942645791 shl d 16 shl rn 5
trapc 8 3
b = ulong get nm_reg i
if eq get nm_kind i 5
b = alloc
matconst b get nm_addr i
end
