end

note ps_at: the line's first byte that is not blank is at p: 1 when the line is `fn main`, 2 when the input
note ends while deciding, else 0. om4 PS_LINE .. PS_YES.
fn ps_at p ulong to ulong
e = get inlen 0
if ne get inp p 102
ret 0
end
q = add p 1
if ge q e
ret 2
end
if ne get inp q 110
ret 0
end
r = add q 1
q = skipbl r
if ge q e
ret 2
end
if eq q r
ret 0
end
if gt add q 4 e
ret 0
end
if ne get inp q 109
ret 0
end
if ne get inp add q 1 97
ret 0
end
if ne get inp add q 2 105
ret 0
end
if ne get inp add q 3 110
ret 0
end
if ge add q 4 e
ret 1
end
if gt get inp add q 4 32
ret 0
end
ret 1
end

fn prescan to void
e = get inlen 0
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
p = skipbl p
if ge p e
go = false
else
r = ps_at p
if eq r 1
put progmode 0 1
go = false
end
if eq r 2
go = false
end
if go
p = skipln p
if ge p e
go = false
end
end
end
m = add m 1
end
end
end

note First collect signatures. Only fn headers are parsed here; other lines are read in the body pass.
fn namescan to void
put scanning 0 1
put line 0 1
go = true
while go
n = ulong 0
while and go lt n 999999
tok
if eq get tk 0 3
go = false
else
if ne get tk 0 0
if and eq get tk 0 1 eq get tw 0 28262
s_fn
else
if and eq get tk 0 1 eq get tw 0 127970521019507
s_struct
else
if and eq get tk 0 1 eq get tw 0 500152823651
s_const
else
if eq ns_om2 0
skipnl
end
end
end
end
end
end
n = add n 1
end
end
put scanning 0 0
put cur 0 0
put line 0 1
put nn 0 0
put nglob 0 0
put curfn 0 0
put curret 0 0
put npar 0 0
put nslot 0 0
put held 0 0
end

note ======== R6 structs (omc only; om4 stays the parent that rebuilds this file) ========
note A struct is 8-byte cells, declaration order, no padding (OSC-2). new is a stack slot, given
note back at ret, like a local array. There is no free (decision 24). Field scale: cell << (3 - tlog)
note so a typed store lands on cell * 8. Pack of struct is 127970521019507 (Wolfram, little-endian).

note findstruct: packed name -> index + 1, or 0
fn findstruct w ulong to ulong
i = ulong 0
n = get nst 0
while lt i n
if eq get st_name i w
ret add i 1
end
i = add i 1
end
ret 0
end

note findfield: struct index, packed field name -> field-table index + 1, or 0
fn findfield si ulong w ulong to ulong
fo = ulong get st_foff si
nfd = ulong get st_nf si
i = ulong 0
while lt i nfd
j = add fo i
if eq get sf_name j w
ret add j 1
end
i = add i 1
end
ret 0
end

note field_dup: 1 if w is already a field of the struct being read (fields fo .. nsf)
fn field_dup fo ulong w ulong to ulong
i = fo
e = get nsf 0
while lt i e
if eq get sf_name i w
ret 1
end
i = add i 1
end
ret 0
end

note s_field: the current word is a field name of struct w. Returns the cell count after this field.
fn s_field w ulong fo ulong cells ulong to ulong
if ne kw get tw 0 0
fail 16
end
if gt get tl 0 8
fail 13
end
fw = get tw 0
if eq fw w
fail 10
end
if ne findstruct fw 0
fail 10
end
if ne field_dup fo fw 0
fail 10
end
t = typeword
ln = ulong 0
p = get cur 0
ln0 = get line 0
tok
k = get tk 0
if eq k 2
ln = get tw 0
if ne get tbig 0 0
fail 14
end
if or eq ln 0 gt ln 64
fail 14
end
else
if eq k 1
e = findname get tw 0
if ne e 0
if eq get nm_kind sub e 1 9
ct = ulong get nm_type sub e 1
if ge ct 10
fail 14
end
ln = get nm_addr sub e 1
if or eq ln 0 gt ln 64
fail 14
end
else
put cur 0 p
put line 0 ln0
end
else
put cur 0 p
put line 0 ln0
end
else
put cur 0 p
put line 0 ln0
end
end
addc = ulong 1
if ne ln 0
addc = ln
end
if gt add cells addc 64
fail 14
end
put sf_name get nsf 0 fw
put sf_type get nsf 0 uchar t
put sf_len get nsf 0 uchar ln
put sf_off get nsf 0 uchar cells
put nsf 0 add get nsf 0 1
ret add cells addc
end

note s_struct: struct Name (field type [len])* end. Before any fn (namescan). 1..16 fields, <= 64 cells.
fn s_struct to void
if ne get nf 0 0
fail 9
end
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
if ne kw get tw 0 0
fail 16
end
w = get tw 0
if ne findstruct w 0
fail 10
end
if ne findfn w get tl 0 get ts 0 0
fail 10
end
if ge get nst 0 16
fail 14
end
sid = get nst 0
fo = get nsf 0
cells = ulong 0
nfld = ulong 0
go = true
while go
tok
if eq get tk 0 0
fail 4
end
if ne get tk 0 1
fail 16
end
if eq kw get tw 0 66
go = false
else
if ge nfld 16
fail 14
end
cells = s_field w fo cells
nfld = add nfld 1
end
end
if eq nfld 0
fail 16
end
put st_name sid w
put st_nf sid uchar nfld
put st_cells sid uchar cells
put st_foff sid uchar fo
put nst 0 add sid 1
eol
end

note peek_struct: if the next word is a struct name, consume it and return index + 1; else rewind
fn peek_struct to ulong
p = get cur 0
ln = get line 0
tok
if ne get tk 0 1
put cur 0 p
put line 0 ln
ret 0
end
sid = findstruct get tw 0
if eq sid 0
put cur 0 p
put line 0 ln
ret 0
end
ret sid
end

note fn_p_st: parameter pw is view (k 2, name kind 8) or edit (k 3, name kind 7). fn_pk is 6 or 7.
fn fn_p_st f ulong np ulong pw ulong sid ulong k ulong to void
si = sub sid 1
t = add si 16
ln = ulong get st_cells si
sk = add k 4
if eq k 2
addname pw poolc np t ln 8 0
else
addname pw poolc np t ln 7 0
end
p = add mul f 6 np
put fn_pt p uchar t
put fn_pl p ln
put fn_pk p uchar sk
end

note sa_new: name = new <type or struct>. Rewind unless the next word is a struct name.
fn sa_new w ulong to void
if ne get om2 0 0
if ne get inl 0 0
fail 9
end
if ne get fn_inl sub get curfn 0 1 0
fail 9
end
end
p = get cur 0
ln = get line 0
tok
sid = ulong 0
if eq get tk 0 1
sid = findstruct get tw 0
end
if ne sid 0
sa_st w sid
ret
end
put cur 0 p
put line 0 ln
sa_arr w
end

note st_read: one value per field, saved in svk/svv/svt. An array field takes one value.
fn st_read si ulong to void
fo = ulong get st_foff si
nfd = ulong get st_nf si
i = ulong 0
while lt i nfd
ft = ulong get sf_type add fo i
rdval 0 ft 255 0
if ne get rt 0 ft
fail 7
end
put svk i get rk 0
put svv i get rv 0
put svt i get rt 0
i = add i 1
end
end

note st_store: STR of v at cell, scaled so the typed store lands on cell * 8. ADD is not used; the
note index register holds cell << (3 - tlog). STR register-offset is the STOP table (om4).
fn st_store base ulong idx ulong cell ulong t ulong v ulong to void
matconst idx shl cell sub 3 tlog t
put ea_b 0 base
put ea_i 0 idx
stel t v
end

note st_ixreg: runtime element index iv, field length fl, cell offset off. CMP + B.HS trap 3
note (elemaddr, C6.2.96 / C6.2.34), then ADD Xidx, Xiv, #off (C6.2.5, base word 2432696320) and
note LSL by 3 - tlog (bo_lsl) so the STOP store lands on (off + i) * 8.
fn st_ixreg idx ulong iv ulong off ulong fl ulong t ulong to void
emit or or 4043309087 shl fl 10 shl iv 5
trapc 2 3
emit or or or 2432696320 idx shl iv 5 shl off 10
sh = sub 3 tlog t
if ne sh 0
bo_lsl idx sh idx
end
end

note st_ld: LDR of type t from base + idx into dst (or a new register). LDOP table, as vt_get.
fn st_ld base ulong idx ulong t ulong dst ulong to void
rd = destreg dst
w = or ldop t rd
emit or or w shl base 5 shl idx 16
put rk 0 1
put rv 0 rd
put rt 0 t
end

note st_write1: store field j (value saved at sv* i) into the struct at base.
fn st_write1 base ulong tmp ulong idx ulong j ulong i ulong to void
ft = ulong get sf_type j
fl = ulong get sf_len j
off = ulong get sf_off j
force get svk i get svv i get svt i tmp
if eq fl 0
st_store base idx off ft tmp
else
k = ulong 0
while lt k fl
st_store base idx add off k ft tmp
k = add k 1
end
end
end

note st_write: store each field value. An array field is filled with its one value.
fn st_write base ulong tmp ulong idx ulong si ulong to void
fo = ulong get st_foff si
nfd = ulong get st_nf si
i = ulong 0
while lt i nfd
st_write1 base tmp idx add fo i i
i = add i 1
end
end

note sa_st: p = new S v1 .. vn. Stack slot of the cell count, 16-byte aligned, outermost block only.
fn sa_st w ulong sid ulong to void
if ne get nb 0 0
fail 9
end
si = sub sid 1
cells = ulong get st_cells si
by = shl shr add shl cells 3 15 4 4
s = add get stkbytes 0 by
if gt s 4194304
fail 23
end
put stkbytes 0 s
r = alloc
put held 0 get nslot 0
st_read si
spsub by
stkchk
emit or 2432697312 r
tmp = alloc
idx = alloc
st_write r tmp idx si
addname w r add si 16 cells 6 0
end

note ======== OM-2 section 5: fresh scratch (spec 5, erratum E8). `NAME edit T N fresh` (N <= 64): the
note incoming elements are unspecified. Each such array has a written set (bit i: element i definitely
note written on the path being compiled). A put with a number index (after unrolling and inlining) sets
note its bit; a get with a number index needs its bit, any other get all N bits (else error 27,
note obligation=init). Joins: an if without else, a while and a rolled for keep the set they opened with;
note an if/else takes the intersection of its arms (or the arm that does not end in ret); an unrolled
note body and an inlined body keep what they wrote. Passing the array to a non-inline call, read, write or
note a host operation is error 27; an inline callee works on the same set. ========
note fz_par: parameter slot f*6+np of kind k with N = ln is fresh: an edit only (else 16), N <= 64 (else 14)
fn fz_par f ulong np ulong k ulong ln ulong to void
if ne k 3
fail 16
end
if gt ln 64
put dobx 0 1
fail 14
end
put fn_pfr add mul f 6 np 1
end

note fz_bind: the parameter name just added for slot p gets a new written set in the body pass
fn fz_bind p ulong ln ulong to void
if eq get fn_pfr p 0
ret
end
if ne get scanning 0 0
ret
end
fz_new sub get nn 0 1 ln
end

note fz_new: a new, empty written set of N elements for name index n (16 per function, error 14)
fn fz_new n ulong ln ulong to void
s = get fz_n 0
if ge s 16
put dobx 0 1
fail 14
end
put fz_len s ln
put fz_cur s 0
put nm_fr n uchar add s 1
put fz_n 0 add s 1
end

note fz_inl: an inline parameter slot p bound to array name e: its own fresh set, or e's set
fn fz_inl p ulong e ulong to void
pk = ulong get fn_pk p
if or eq pk 0 ge pk 6
ret
end
n = sub get nn 0 1
if ne get fn_pfr p 0
fz_new n get fn_pl p
ret
end
put nm_fr n get nm_fr sub e 1
end

note fz_push / fz_else / fz_join: the sets when block n opens; at its else (the then sets kept, the
note opening sets back); at its end (kind k: 1 if, 2 else, 3 while, 4 for)
fn fz_push n ulong to void
j = ulong 0
while lt j get fz_n 0
put fz_ent add mul n 16 j get fz_cur j
j = add j 1
end
end

fn fz_else i ulong to void
j = ulong 0
while lt j get fz_n 0
x = add mul i 16 j
put fz_thn x get fz_cur j
put fz_cur j get fz_ent x
j = add j 1
end
end

fn fz_join i ulong k ulong to void
td = get bdead i
ed = get dead 0
j = ulong 0
while lt j get fz_n 0
x = add mul i 16 j
if eq k 2
v = and get fz_cur j get fz_thn x
if and ne td 0 eq ed 0
v = get fz_cur j
end
if and ne ed 0 eq td 0
v = get fz_thn x
end
put fz_cur j v
else
put fz_cur j get fz_ent x
end
j = add j 1
end
end

note fz_get: get e i with the index in rk/rv/rt
fn fz_get e ulong to void
s = ulong get nm_fr sub e 1
if eq s 0
ret
end
s = sub s 1
n = get fz_len s
if eq get rk 0 3
v = get rv 0
if lt v n
if eq and shr get fz_cur s v 1 0
fail 27
end
end
ret
end
if ne get fz_cur s fmask n
fail 27
end
end

note fz_put: put e i v with index (k, v): a number index sets its bit
fn fz_put e ulong k ulong v ulong to void
s = ulong get nm_fr sub e 1
if eq s 0
ret
end
s = sub s 1
if eq k 3
if lt v get fz_len s
put fz_cur s or get fz_cur s shl ulong 1 v
end
end
end

note fz_arg: array name e leaves the analysis (a non-inline call, read, write, a host operation): error 27
note when it is tracked
fn fz_arg e ulong to void
if ne get nm_fr sub e 1 0
fail 27
end
end

note ======== OM-2 section 5: external layouts (spec 5, errata E5, E8, E9). `layout NAME SIZE`, then one
note `field F T [COUNT] at OFF little|big` per line, then `end`, before the first fn. Read in the names pass;
note the body pass jumps over the block. A parameter `c view|edit NAME` is a uchar array of SIZE bytes (one
note pointer); `get c F [i]` / `put c F [i] v` load / store the field at its width and byte order:
note LDR/STR (register, unscaled offset; C6.2.216 family) at base + OFF + i * width, REV16 / REV (C6.2.333,
note C6.2.331) for big, a run-time index checked like an array's (CMP, B.HS trap 3) ========
note findlay: packed name -> layout index + 1, or 0
fn findlay w ulong to ulong
i = ulong 0
while lt i get nly 0
if eq get ly_name i w
ret add i 1
end
i = add i 1
end
ret 0
end

note findlf: layout index li, packed field name -> field-table index + 1, or 0
fn findlf li ulong w ulong to ulong
fo = get ly_fo li
i = ulong 0
while lt i get ly_nf li
if eq get lf_name add fo i w
ret add add fo i 1
end
i = add i 1
end
ret 0
end

note ns_om2: an OM-2 declaration line in the names pass (1 when it was read), else 0
fn ns_om2 to ulong
if eq get om2 0 0
ret 0
end
if ne get tk 0 1
ret 0
end
if eq get tw 0 128047730221420
s_layout
ret 1
end
ret 0
end

note ly_num: the next token must be a number (error 4 at the line end, 16 for another token, 29 when it
note was written as 2^63 or more)
fn ly_num to ulong
tok
if or eq get tk 0 0 eq get tk 0 3
fail 4
end
if ne get tk 0 2
fail 16
end
if ne get tbig 0 0
fail 29
end
ret get tw 0
end

note s_layout: SIZE 1..4096 and a layout after the first fn are error 29 on the layout line
fn s_layout to void
if ne get nf 0 0
fail 29
end
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
w = get tw 0
if ne kw w 0
fail 16
end
newname w get tl 0 get ts 0
if ge get nly 0 16
fail 14
end
sz = ly_num
if or eq sz 0 gt sz 4096
fail 29
end
eol
li = get nly 0
fo = get nlf 0
i = ulong 0
while lt i sz
put lymap i 0
i = add i 1
end
go = true
while go
tok
k = get tk 0
if eq k 3
fail 4
end
if eq k 1
c = ulong 0
if le get tl 0 8
c = kw get tw 0
end
if eq c 66
eol
go = false
else
if eq c 83
skipnl
else
if ne c 189
fail 16
end
ly_field fo sz
end
end
else
if ne k 0
fail 16
end
end
end
put ly_name li w
put ly_size li sz
put ly_fo li fo
put ly_nf li sub get nlf 0 fo
put ly_ec li get cur 0
put ly_el li get line 0
put nly 0 add li 1
end

note ly_field: F T [COUNT] at OFF little|big. A field over SIZE, a COUNT outside 1..4096, an OFF out of range
note or two fields sharing a byte are error 29 on the field line. Field types are the integer types.
fn ly_field fo ulong sz ulong to void
tok
if or eq get tk 0 0 eq get tk 0 3
fail 4
end
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
fw = get tw 0
if ne kw fw 0
fail 16
end
n = get nlf 0
i = fo
while lt i n
if eq get lf_name i fw
fail 10
end
i = add i 1
end
if ge n 256
fail 14
end
t = typeword
if or lt t 2 gt t 9
fail 7
end
cnt = ulong 0
tok
if eq get tk 0 2
if ne get tbig 0 0
fail 29
end
cnt = get tw 0
if or eq cnt 0 gt cnt 4096
fail 29
end
tok
end
if or eq get tk 0 0 eq get tk 0 3
fail 4
end
if ne get tk 0 1
fail 16
end
if ne kw get tw 0 190
fail 16
end
off = ly_num
big = ly_end
ly_mark off cnt t sz
eol
put lf_name n fw
put lf_type n uchar t
put lf_cnt n cnt
put lf_off n off
put lf_big n uchar big
put nlf 0 add n 1
end

note ly_end: little (0) or big (1)
fn ly_end to ulong
tok
if or eq get tk 0 0 eq get tk 0 3
fail 4
end
if ne get tk 0 1
fail 16
end
c = kw get tw 0
if eq c 191
ret 0
end
if eq c 192
ret 1
end
fail 16
ret 0
end

note ly_mark: the bytes OFF .. OFF + max(COUNT, 1) * width must lie inside SIZE and be free (error 29)
fn ly_mark off ulong cnt ulong t ulong sz ulong to void
n = cnt
if eq n 0
n = ulong 1
end
by = shl n tlog t
if gt off sz
fail 29
end
e = add off by
if gt e sz
fail 29
end
i = off
while lt i e
if ne get lymap i 0
fail 29
end
put lymap i 1
i = add i 1
end
end

note s_lyskip: the body pass jumps to the place after the layout's end (read in the names pass)
fn s_lyskip to void
tok
li = sub findlay get tw 0 1
put cur 0 get ly_ec li
put line 0 get ly_el li
end

note peek_lay: if the next word is a layout name, consume it and return index + 1; else rewind
fn peek_lay to ulong
p = get cur 0
ln = get line 0
tok
if eq get tk 0 1
if le get tl 0 8
lid = findlay get tw 0
if ne lid 0
ret lid
end
end
end
put cur 0 p
put line 0 ln
ret 0
end

note fn_p_ly: parameter pw is a layout (view k 2 / edit k 3): a uchar array of SIZE bytes, name kind 2 / 3
fn fn_p_ly f ulong np ulong pw ulong lid ulong k ulong to void
ln = get ly_size sub lid 1
addname pw poolc np 2 ln k 0
put nm_lay sub get nn 0 1 uchar lid
p = add mul f 6 np
put fn_pt p 2
put fn_pl p ln
put fn_pk p uchar k
put fn_play p uchar lid
end

note ly_fld: for a layout name e, when the next word is one of its fields: consume it, return the field-table
note index + 1; otherwise rewind and return 0 (the name is then an ordinary uchar array)
fn ly_fld e ulong to ulong
lid = ulong get nm_lay sub e 1
if eq lid 0
ret 0
end
p = get cur 0
ln = get line 0
tok
if eq get tk 0 1
if le get tl 0 8
j = findlf sub lid 1 get tw 0
if ne j 0
ret j
end
end
end
put cur 0 p
put line 0 ln
ret 0
end

note ldun / stun: LDRB / LDRH / LDR w / LDR x and the stores, register offset, LSL #0 (S = 0)
fn ldun t ulong to ulong
if or eq t 2 eq t 6
ret 945842176
end
if or eq t 3 eq t 7
ret 2019584000
end
if or eq t 4 eq t 8
ret 3093325824
end
ret 4167067648
end

fn stun t ulong to ulong
if or eq t 2 eq t 6
ret 941647872
end
if or eq t 3 eq t 7
ret 2015389696
end
if or eq t 4 eq t 8
ret 3089131520
end
ret 4162873344
end

note ly_rev: Rd = the bytes of Rs reversed at width t: REV16 Wd (C6.2.333), REV Wd, REV Xd (C6.2.331)
fn ly_rev t ulong s ulong d ulong to void
if or eq t 3 eq t 7
emit or or 1522533376 d shl s 5
end
if or eq t 4 eq t 8
emit or or 1522534400 d shl s 5
end
if or eq t 5 eq t 9
emit or or 3670019072 d shl s 5
end
end

note ly_ix: the byte-offset register of element (k, v, t) of array field j: a number index must be below
note COUNT (error 21); a register index: CMP Xi, #COUNT or Xc (C6.2.96 / C6.2.97), B.HS trap 3, then
note Xo = OFF; ADD Xo, Xo, Xi, LSL #log2 width (C6.2.6)
fn ly_ix j ulong k ulong v ulong t ulong to ulong
if or eq t 1 ge t 10
fail 7
end
cnt = get lf_cnt j
sh = tlog ulong get lf_type j
x = alloc
if eq k 3
if ge v cnt
fail 21
end
matconst x add get lf_off j shl v sh
ret x
end
r = matreg k v t
if le cnt 4095
emit or or 4043309087 shl cnt 10 shl r 5
else
y = alloc
matconst y cnt
emit or or 3942645791 shl y 16 shl r 5
end
trapc 2 3
matconst x get lf_off j
emit or or or or 2332033024 x shl x 5 shl r 16 shl sh 10
ret x
end

note ly_get: get c F [i] on a layout name e (1 when it was a field, the value in rk/rv/rt), else 0
fn ly_get e ulong dst ulong to ulong
j = ly_fld e
if eq j 0
ret 0
end
j = sub j 1
ft = ulong get lf_type j
x = ulong 0
if eq get lf_cnt j 0
x = alloc
matconst x get lf_off j
else
rdval 0 5 255 0
x = ly_ix j get rk 0 get rv 0 get rt 0
end
rd = destreg dst
emit or or or ldun ft rd shl ulong get nm_reg sub e 1 5 shl x 16
if ne get lf_big j 0
ly_rev ft rd rd
end
if gt ft 5
canon rd ft
end
put rk 0 1
put rv 0 rd
put rt 0 ft
ret 1
end

note ly_put: put c F [i] v on a layout name e (an edit; a view was refused 20 before): index, value, then
note the store; 1 when it was a field, else 0
fn ly_put e ulong to ulong
j = ly_fld e
if eq j 0
ret 0
end
j = sub j 1
if ne get lf_cnt j 0
rdval 0 5 255 0
put svk 0 get rk 0
put svv 0 get rv 0
put svt 0 get rt 0
end
ly_st e j
eol
ret 1
end

note ly_st: the value of field j (index saved in svk/svv/svt), then the store through layout name e
fn ly_st e ulong j ulong to void
ft = ulong get lf_type j
cnt = get lf_cnt j
rdval 0 ft 255 0
if ne get rt 0 ft
fail 7
end
v = matreg get rk 0 get rv 0 get rt 0
x = ulong 0
if eq cnt 0
x = alloc
matconst x get lf_off j
else
x = ly_ix j get svk 0 get svv 0 get svt 0
end
if and ne get lf_big j 0 ne tlog ft 0
y = alloc
ly_rev ft v y
v = y
end
emit or or or stun ft v shl ulong get nm_reg sub e 1 5 shl x 16
end

note vt_fget_go: field j of struct name e. Scalar, or an index then the element.
fn vt_fget_go e ulong dst ulong j ulong to void
fl = ulong get sf_len j
ft = ulong get sf_type j
off = ulong get sf_off j
base = ulong get nm_reg sub e 1
idx = alloc
if eq fl 0
st_store_ld base idx off ft dst
else
rdval 0 5 255 0
if eq get rt 0 1
fail 7
end
if eq get rk 0 3
if ge get rv 0 fl
fail 21
end
st_store_ld base idx add off get rv 0 ft dst
else
if ne get rk 0 1
fail 7
end
st_ixreg idx get rv 0 off fl ft
st_ld base idx ft dst
end
end
end

note vt_fget: get p f, or get p f i for an array field. Kind 6 own, 7 edit, 8 view; all may be read.
fn vt_fget e ulong dst ulong to void
i = sub e 1
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
si = sub ulong get nm_type i 16
fid = findfield si get tw 0
if eq fid 0
fail 3
end
vt_fget_go e dst sub fid 1
end

note st_store_ld: constant cell, then load. Split out so vt_fget stays under 16 registers.
fn st_store_ld base ulong idx ulong cell ulong t ulong dst ulong to void
matconst idx shl cell sub 3 tlog t
st_ld base idx t dst
end

note s_putf_go: field j of struct name e. Read the value (and the index, if an array field) and store.
fn s_putf_go e ulong j ulong to void
fl = ulong get sf_len j
ft = ulong get sf_type j
off = ulong get sf_off j
base = ulong get nm_reg sub e 1
if ne fl 0
rdval 0 5 255 0
if eq get rt 0 1
fail 7
end
put svk 0 get rk 0
put svv 0 get rv 0
put svt 0 get rt 0
end
rdval 0 ft 255 0
if ne get rt 0 ft
fail 7
end
v = matreg get rk 0 get rv 0 get rt 0
idx = alloc
if eq fl 0
st_store base idx off ft v
else
s_putf_ix base idx v off fl ft
end
eol
end

note s_putf: put p f v, or put p f i v. A view struct is error 20.
fn s_putf e ulong to void
i = sub e 1
if eq ulong get nm_kind i 8
fail 20
end
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
si = sub ulong get nm_type i 16
fid = findfield si get tw 0
if eq fid 0
fail 3
end
s_putf_go e sub fid 1
end

note s_putf_ix: the index was saved in svk/svv/svt before the value was read
fn s_putf_ix base ulong idx ulong v ulong off ulong fl ulong ft ulong to void
ik = get svk 0
iv = get svv 0
if eq get svt 0 1
fail 7
end
if eq ik 3
if ge iv fl
fail 21
end
st_store base idx add off iv ft v
else
if ne ik 1
fail 7
end
st_ixreg idx iv off fl ft
put ea_b 0 base
put ea_i 0 idx
stel ft v
end
end

note ca_st_ok: read one struct argument of parameter i of function f. Returns the name entry.
fn ca_st_ok f ulong i ulong to ulong
md = ulong 0
aa_word
w = get tw 0
c = kw w
if ne c 0
if or lt c 57 gt c 58
fail 16
end
md = c
aa_word
w = get tw 0
end
e = findname w
if eq e 0
fail 3
end
ni = sub e 1
k = ulong get nm_kind ni
if lt k 6
fail 7
end
p = add mul sub f 1 6 i
pk = ulong get fn_pk p
if eq pk 7
if eq md 57
fail 20
end
if eq k 8
fail 20
end
else
if eq md 58
fail 7
end
end
if ne ulong get nm_type ni ulong get fn_pt p
fail 7
end
ret e
end

note ca_dist: the same struct name passed twice in one call is error 19.
fn ca_dist cb ulong i ulong e ulong to void
j = ulong 0
while lt j i
if eq get fr add add cb mul j 3 2 e
fail 19
end
j = add j 1
end
end

note ca_st: a struct argument. edit (fn_pk 7) needs own or edit; view takes any. Same struct.
fn ca_st f ulong i ulong cb ulong to void
e = ca_st_ok f i
ca_dist cb i e
q = add cb mul i 3
put fr q 5
put fr add q 1 ulong get nm_reg sub e 1
put fr add q 2 e
end
note ---- R6 IR. A leading line `ir` writes OSC IR version 1. The AArch64 path is not taken.
note Worksheet ir_match.py matched omega_emit on the 10 dev programs; this is that algorithm.

global ir_rty uchar 64
global ir_nreg ulong 1
global ir_nm ulong 32
global ir_nrr uchar 32
global ir_nn ulong 1
global ir_cty uchar 32
global ir_cm ulong 32
global ir_cr uchar 32
global ir_nc ulong 1
global ir_bord ulong 32
global ir_nord ulong 1
global ir_cur ulong 1
global ir_dead ulong 1
global ir_nb ulong 1
global ir_ok uchar 256
global ir_oa ulong 256
global ir_ob ulong 256
global ir_oc ulong 256
global ir_od ulong 256
global ir_obl ulong 256
global ir_no ulong 1
global ir_bf ulong 32
global ir_bc ulong 32
global ir_fk uchar 8
global ir_fa ulong 8
global ir_fb ulong 8
global ir_fc ulong 8
global ir_fd ulong 8
global ir_nf ulong 1
global ir_ret ulong 1
global ir_npar ulong 1
global ir_rr ulong 1
global ir_vt ulong 1
global ir_bare ulong 1
global ir_isb ulong 1
global ir_ns ulong 1
global ir_nl ulong 1
global ir_have ulong 1
global irrec uchar 2620252
global irrlen ulong 1
global irnf ulong 1
global irf_nm ulong 32
global irf_ns ulong 32
global irf_nl ulong 32
global irf_np ulong 32
global irf_ret uchar 32
global irf_pt uchar 192
global irf_n ulong 1
global ir_args ulong 6
global ir_oarg ulong 1536
global ir_miss ulong 1
global ir_cl ulong 1
global ir_cs ulong 1

fn ir_lead to ulong
p = ulong 0
while and lt p get inlen 0 le get inp p 32
if eq get inp p 10
ret 0
end
p = add p 1
end
if ge add p 3 get inlen 0
ret 0
end
if ne get inp p 105
ret 0
end
if ne get inp add p 1 114
ret 0
end
if gt get inp add p 2 32
ret 0
end
q = add p 2
while and lt q get inlen 0 ne get inp q 10
q = add q 1
end
if lt q get inlen 0
q = add q 1
end
put cur 0 q
put line 0 2
ret 1
end

fn ir_w16 v ulong to void
emitb uchar and v 255
emitb uchar and shr v 8 255
end

fn ir_w32 v ulong to void
ir_w16 v
ir_w16 shr v 16
end

fn ir_w64 v ulong to void
ir_w32 v
ir_w32 shr v 32
end

fn ir_newreg ty ulong to ulong
r = get ir_nreg 0
if ge r 64
fail 14
end
put ir_rty r uchar ty
put ir_nreg 0 add r 1
ret r
end

fn ir_block to ulong
b = get ir_nb 0
if ge b 32
fail 14
end
put ir_bord b 65535
put ir_nb 0 add b 1
ret b
end

fn ir_start b ulong to void
put ir_bord b get ir_nord 0
put ir_nord 0 add get ir_nord 0 1
put ir_cur 0 b
put ir_dead 0 0
end

fn ir_op k ulong a ulong b ulong c ulong d ulong to void
if ne get ir_dead 0 0
fail 17
end
n = get ir_no 0
if ge n 256
fail 14
end
put ir_ok n uchar k
put ir_oa n a
put ir_ob n b
put ir_oc n c
put ir_od n d
put ir_obl n get ir_cur 0
put ir_no 0 add n 1
end

fn ir_lit mag ulong ty ulong to ulong
i = ulong 0
n = get ir_nc 0
while lt i n
if and eq ulong get ir_cty i ty eq get ir_cm i mag
ret ulong get ir_cr i
end
i = add i 1
end
if ge n 32
fail 14
end
r = ir_newreg ty
put ir_cty n uchar ty
put ir_cm n mag
put ir_cr n uchar r
put ir_nc 0 add n 1
ret r
end

fn ir_find w ulong to ulong
i = ulong 0
while lt i get ir_nn 0
if eq get ir_nm i w
ret add i 1
end
i = add i 1
end
ret 0
end

fn ir_bind w ulong r ulong to void
n = get ir_nn 0
put ir_nm n w
put ir_nrr n uchar r
put ir_nn 0 add n 1
end

fn ir_push k ulong a ulong b ulong c ulong d ulong to void
n = get ir_nf 0
put ir_fk n uchar k
put ir_fa n a
put ir_fb n b
put ir_fc n c
put ir_fd n d
put ir_nf 0 add n 1
end

fn ir_set dst ulong r ulong ty ulong to void
put ir_isb 0 0
if eq dst 65534
put ir_rr 0 r
put ir_vt 0 ty
ret
end
d = dst
if eq dst 65535
d = ir_newreg ty
end
ir_op 2 d r 0 0
put ir_rr 0 d
put ir_vt 0 ty
end

fn ir_ord id ulong to ulong
ret get ir_bord id
end

fn ir_count k ulong to ulong
n = ulong 0
if eq k 0
n = get ir_nc 0
end
i = ulong 0
while lt i get ir_no 0
if eq ir_ord get ir_obl i k
n = add n 1
end
i = add i 1
end
ret n
end

fn ir_layout to void
k = ulong 0
at = ulong 0
while lt k get ir_nord 0
put ir_bf k at
c = ir_count k
put ir_bc k c
at = add at c
k = add k 1
end
put ir_no 0 get ir_no 0
end

fn ir_wconst to void
i = ulong 0
while lt i get ir_nc 0
emitb 1
ir_w16 ulong get ir_cr i
ir_w64 get ir_cm i
i = add i 1
end
end

fn ir_wins k ulong to void
if eq k 0
ir_wconst
end
i = ulong 0
while lt i get ir_no 0
if eq ir_ord get ir_obl i k
op = ulong get ir_ok i
emitb uchar op
if eq op 1
ir_w16 get ir_oa i
ir_w64 get ir_ob i
end
if eq op 2
ir_w16 get ir_oa i
ir_w16 get ir_ob i
end
if eq op 3
emitb uchar get ir_oa i
ir_w16 get ir_ob i
ir_w16 get ir_oc i
ir_w16 get ir_od i
end
if eq op 4
emitb uchar get ir_oa i
ir_w16 get ir_ob i
ir_w16 get ir_oc i
end
if eq op 5
emitb uchar get ir_oa i
ir_w16 get ir_ob i
ir_w16 get ir_oc i
ir_w16 get ir_od i
end
if eq op 6
ir_w16 get ir_oa i
ir_w16 get ir_ob i
end
if eq op 11
ir_w16 get ir_oa i
ir_w16 get ir_ob i
emitb uchar get ir_oc i
j = ulong 0
while lt j get ir_oc i
ir_w16 get ir_oarg add mul i 6 j
j = add j 1
end
end
if eq op 12
emitb uchar get ir_oa i
end
if eq op 13
ir_w16 ir_ord get ir_oa i
end
if eq op 14
ir_w16 get ir_oa i
ir_w16 ir_ord get ir_ob i
ir_w16 ir_ord get ir_oc i
end
if eq op 15
ir_w16 get ir_oa i
end
end
i = add i 1
end
end

fn ir_record to void
emitb uchar get ir_nl 0
p = get ir_ns 0
e = add p get ir_nl 0
while lt p e
emitb get inp p
p = add p 1
end
emitb uchar get ir_npar 0
if eq get ir_ret 0 76
emitb 0
else
emitb uchar get ir_ret 0
end
ir_w16 get ir_nreg 0
i = ulong 0
while lt i get ir_nreg 0
emitb get ir_rty i
i = add i 1
end
ir_layout
ir_w16 get ir_nord 0
k = ulong 0
while lt k get ir_nord 0
ir_w32 get ir_bf k
ir_w32 get ir_bc k
k = add k 1
end
tot = ulong 0
k = ulong 0
while lt k get ir_nord 0
tot = add tot get ir_bc k
k = add k 1
end
ir_w32 tot
k = ulong 0
while lt k get ir_nord 0
ir_wins k
k = add k 1
end
ir_w16 0
ir_w16 0
end

note ir_emit_record: encode the current function into irrec and count it. The per-function IR state is
note reset by ir_fn, so this must run before the next fn line.
fn ir_emit_record to void
if ge get irnf 0 32
fail 14
end
put oc 0 0
ir_record
n = get oc 0
base = get irrlen 0
i = ulong 0
while lt i n
put irrec add base i get out i
i = add i 1
end
put irrlen 0 add base n
put irnf 0 add get irnf 0 1
end

note ir_encode: header (magic, version 1, nfuncs) followed by every collected function record.
fn ir_encode to void
put oc 0 0
emitb 79
emitb 83
emitb 67
emitb 49
emitb 73
emitb 82
