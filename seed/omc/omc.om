while go
tok
if eq get tk 0 0
fail 4
end
if ne get tk 0 1
fail 16
end
if eq kw get tw 0 66
go = false
else
if ge nfld 16
fail 14
end
cells = s_field w fo cells
nfld = add nfld 1
end
end
if eq nfld 0
fail 16
end
put st_name sid w
put st_nf sid uchar nfld
put st_cells sid uchar cells
put st_foff sid uchar fo
put nst 0 add sid 1
