ret alloc
end
ret d
end

note e3: emit op | d | n << 5 | m << 16
fn e3 op ulong d ulong n ulong m ulong to void
emit or or or op d shl n 5 shl m 16
end

note trapsite: note the place and code of a branch to the trap stub, then emit it. trapc: B.cond, as om4.
fn trapsite w ulong code ulong to void
n = get nt 0
if ge n 8192
fail 14
end
put tsite n get oc 0
put tcode n code
put nt 0 add n 1
emit w
if eq get om2m 0 1
siterec
end
end

fn trapc cc ulong code ulong to void
if ne get xtarget 0 0
xtrap cc code
ret
end
trapsite or 1409286144 cc code
end

fn rdword at ulong to ulong
a = ulong get out at
b = shl ulong get out add at 1 8
c = shl ulong get out add at 2 16
d = shl ulong get out add at 3 24
ret or or or a b c d
end

fn wrword at ulong w ulong to void
put out at uchar and w 255
put out add at 1 uchar and shr w 8 255
put out add at 2 uchar and shr w 16 255
put out add at 3 uchar and shr w 24 255
end

note bdisp: the checked word distance from a branch at `at` to `target` for its signed w-bit word field:
note w 19 for B.cond / CBZ / CBNZ (C6.2.34, C6.2.78, C6.2.77), w 26 for B (C6.2.35) and BL. The
note target must be word aligned and at most 2^(w-1) - 1 words forward or 2^(w-1) words back (w 19: 1048572
note bytes forward, 1048576 back; w 26: 134217724 forward, 134217728 back), else error 24 before any
note artifact is accepted. Returns the distance masked to w bits.
fn bdisp at ulong target ulong w ulong to ulong
diff = sub target at
if ne and diff 3 0
fail 24
end
span = shl ulong 1 add w 1
if and gt diff sub span 4 lt diff sub ulong 0 span
fail 24
end
ret and shr diff 2 sub shl ulong 1 w 1
end

note patch19: the word distance from a B.cond / CBZ / CBNZ at `at` to `target`, into bits 5..23
fn patch19 at ulong target ulong to void
if ne get xtarget 0 0
xpatch at target
if eq target get oc 0
put tgoc 0 target
end
ret
end
d = bdisp at target 19
wrword at or rdword at shl d 5
if eq target get oc 0
put tgoc 0 target
end
end

note patch26: the word distance from a B at `at` to `target`, into bits 0..25, checked by bdisp. The AArch64
note output stops at 8 MiB = 2^23 bytes (emit, error 14), inside the 2^27-byte reach, so no legal program
note reaches error 24 here; the check keeps a wrong B from ever being written if that ceiling changes.
fn patch26 at ulong target ulong to void
if ne get xtarget 0 0
xpatch at target
if eq target get oc 0
put tgoc 0 target
end
ret
end
d = bdisp at target 26
wrword at or rdword at d
if eq target get oc 0
put tgoc 0 target
end
end

