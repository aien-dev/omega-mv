note nfail: a bad number (diag expect=number); unkfail: an undeclared function or struct (sev=unknown)
fn nfail code ulong to void
put dexp 0 4
fail code
end

fn unkfail code ulong to void
put dsev 0 2
put dexp 0 3
fail code
end

note lineis: the n bytes at q are the packed word w and the line ends right after them
fn lineis q ulong w ulong n ulong to ulong
e = get inlen 0
if gt add q n e
ret 0
end
i = ulong 0
x = w
while lt i n
if ne ulong get inp add q i and x 255
ret 0
end
x = shr x 8
i = add i 1
end
r = add q n
if lt r e
if ne get inp r 10
ret 0
end
end
ret 1
end

note isnote: the word at p is note (the lexer ends a word at a blank, a parenthesis or the end)
fn isnote p ulong to ulong
e = get inlen 0
if gt add p 4 e
ret 0
end
i = ulong 0
x = ulong 1702129518
while lt i 4
if ne ulong get inp add p i and x 255
ret 0
end
x = shr x 8
i = add i 1
end
r = add p 4
if lt r e
b = get inp r
if and gt b 32 and ne b 40 ne b 41
ret 0
end
end
ret 1
end

fn chk_mode q ulong to ulong
if ne lineis q 461229090915 5 0
ret 1
end
if ne lineis q 1954047342 4 0
ret 2
end
ret 0
end

fn chk_lead to void
e = get inlen 0
p = ulong 0
ln = ulong 1
go = true
while go
m = ulong 0
while and go lt m 999999
q = skipbl p
if ge q e
go = false
else
if eq get inp q 10
p = add q 1
ln = add ln 1
else
if ne isnote q 0
p = skipln q
ln = add ln 1
else
k = chk_mode q
if ne k 0
put chkmode 0 k
put chkln 0 ln
put sbase 0 skipln q
end
go = false
end
end
end
m = add m 1
end
end
end

note om2lead: skip blank lines and note lines; when the next line is exactly om2 (1), om2 diag (2) or
note om2 fmt (3) the unit is OM-2: om2, om2m, om2ln, om2pos. Anything else leaves the unit OM-1.
fn om2lead to void
e = get inlen 0
p = ulong 0
ln = ulong 1
if ne get chkmode 0 0
p = get sbase 0
ln = add get chkln 0 1
end
go = true
while go
m = ulong 0
while and go lt m 999999
q = skipbl p
if ge q e
go = false
else
if eq get inp q 10
p = add q 1
ln = add ln 1
else
if ne isnote q 0
p = skipln q
ln = add ln 1
else
r = ulong 0
if eq q p
if ne lineis q 3304815 3 0
r = ulong 1
end
if ne lineis q 7449351137405332847 8 0
r = ulong 2
end
if ne lineis q 32771382692703599 7 0
r = ulong 3
end
if eq r 0
r = cp_mode q
end
end
if ne r 0
put om2 0 1
put om2m 0 sub r 1
put om2ln 0 ln
put om2pos 0 q
end
go = false
end
end
end
m = add m 1
end
end
end

note ---- om2 fmt (spec 2, errata E4, E6): only when the input's first line, at byte 0, is om2 fmt (an om2
note fmt line elsewhere is error 16). The rest (the bytes after the first LF) is compiled as a unit of
note its own (OM-1 or OM-2 by its own first line) and, when it is accepted, its canonical text is written
note instead of the artifact. A CR anywhere and blank lines at the end are error 6. Lines and spans are
note reported against the whole input.
global fst ulong 1
global fpend ulong 1
global fbo ulong 1
global fprp ulong 1
global flso ulong 1

note fmttail: blank lines at the end of the rest (n bytes) are error 6, at the first such line
fn fmttail n ulong to void
lnb = ulong 0
lnl = ulong 1
ln = ulong 1
i = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i n
go = false
else
b = get inp i
if eq b 10
ln = add ln 1
else
if and ne b 32 ne b 9
lnb = add i 1
lnl = ln
end
end
i = add i 1
end
m = add m 1
end
end
bad = false
if eq lnb 0
if gt n 0
bad = true
lnl = ulong 0
end
end
k = lnb
fl = n
go = true
while go
m = ulong 0
while and go lt m 999999
if ge k n
go = false
else
if eq get inp k 10
fl = k
go = false
end
k = add k 1
end
m = add m 1
end
end
if lt add fl 1 n
bad = true
end
if bad
put line 0 add lnl 1
put tka 0 lnb
put tkb 0 lnb
fail 6
end
end

fn fmtprep to void
if ne get om2pos 0 0
put line 0 get om2ln 0
put tka 0 get om2pos 0
put tkb 0 get om2pos 0
fail 16
end
e = get inlen 0
ln = ulong 1
i = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i e
go = false
else
b = get inp i
if eq b 13
put line 0 ln
put tka 0 i
put tkb 0 add i 1
fail 6
end
if eq b 10
ln = add ln 1
end
i = add i 1
end
m = add m 1
end
end
r = skipln get om2pos 0
put lbase 0 get om2ln 0
put sbase 0 r
n = sub e r
j = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge j n
go = false
else
put inp j get inp add r j
j = add j 1
end
m = add m 1
end
end
put inlen 0 n
fmttail n
put om2 0 0
put om2m 0 0
put om2ln 0 0
put fmtm 0 1
om2lead
if eq get om2m 0 2
put line 0 get om2ln 0
put tka 0 get om2pos 0
put tkb 0 get om2pos 0
fail 16
end
end

note fmtbyte: one input byte of the canonical text. fst: 0 line start, 1 indentation (kept, dropped
note again on a blank line), 2 note line (copied), 3 between words, 4 in a word, 5 in a text literal, 6
note after a backslash in a text literal. A run of blanks between words (fpend, starting at output byte
note fbo) is written as it comes, then becomes one space unless a parenthesis is next to it (fprp: the
note word before it was one); at the end of the line it is dropped.
fn fmtbyte p ulong to void
b = get inp p
s = get fst 0
if eq b 10
if lt s 2
put oc 0 get flso 0
else
if ne get fpend 0 0
put oc 0 get fbo 0
end
end
emitb 10
put fst 0 0
put fpend 0 0
put fprp 0 0
put flso 0 get oc 0
ret
end
if eq s 2
emitb b
ret
end
if eq s 5
emitb b
if eq b 92
put fst 0 6
end
if eq b 34
put fst 0 3
put fprp 0 0
end
ret
end
if eq s 6
emitb b
put fst 0 5
ret
end
blank = or eq b 32 eq b 9
if lt s 2
if blank
emitb b
put fst 0 1
ret
end
if ne isnote p 0
emitb b
put fst 0 2
ret
end
put fst 0 3
put fpend 0 0
end
if blank
if eq get fpend 0 0
put fbo 0 get oc 0
put fpend 0 1
end
emitb b
put fst 0 3
ret
end
paren = or eq b 40 eq b 41
if and eq get fst 0 4 not paren
emitb b
ret
end
if ne get fpend 0 0
if and eq get fprp 0 0 not paren
put oc 0 get fbo 0
emitb 32
end
end
put fpend 0 0
emitb b
if eq b 34
put fst 0 5
put fprp 0 0
ret
end
if paren
put fst 0 3
put fprp 0 1
else
put fst 0 4
put fprp 0 0
end
end

fn fmtout to void
put oc 0 0
put fst 0 0
put fpend 0 0
put fprp 0 0
put flso 0 0
e = get inlen 0
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
fmtbyte p
p = add p 1
end
m = add m 1
end
end
if ge get fst 0 2
if ne get fpend 0 0
put oc 0 get fbo 0
end
emitb 10
end
put fmtm 0 0
put om2m 0 0
writeout 0
end

note tok_hex (OM-2): 0x and 1..16 digits 0-9 a-f is the unsigned value (tk 2, tbig as tok_num). A - before
note 0x, 0X, no digits, more than 16 digits, an uppercase or any other character is error 6. 0 when the
note word is not a hex literal.
fn tok_hex to ulong
p = get ts 0
e = get cur 0
if eq get inp p 45
q = add p 1
if lt add q 1 e
if eq get inp q 48
c = get inp add q 1
if or eq c 120 eq c 88
nfail 6
end
end
end
ret 0
end
if ge add p 1 e
ret 0
end
if ne get inp p 48
ret 0
end
c = get inp add p 1
if eq c 88
nfail 6
end
if ne c 120
ret 0
end
n = sub e add p 2
if eq n 0
nfail 6
end
if gt n 16
nfail 6
end
v = ulong 0
i = add p 2
while lt i e
d = ulong get inp i
if and ge d 48 le d 57
v = or shl v 4 sub d 48
else
if and ge d 97 le d 102
v = or shl v 4 sub d 87
else
nfail 6
end
end
i = add i 1
end
put tbig 0 shr v 63
put tw 0 v
put tk 0 2
ret 1
end

note ---- float literals: a token is the decimal value fsgn * fnd * 10^fp10, fsuf 0 none / 1 f32 / 2 f64.
note fg_* hold the working state of the one literal being converted (see fparse/fbits/fnorm/fgen).
global fsgn ulong 1
global fnd ulong 1
global fp10 long 1
global fsuf ulong 1
global fg_fl ulong 1
global fg_seen ulong 1
global fg_ex long 1
global fg_esign long 1
global fg_ed ulong 1
global fg_ty ulong 1
global fg_e long 1
global fg_q ulong 1
global fg_m ulong 1
global fg_stk ulong 1
global fg_low ulong 1
global fg_ov ulong 1

note ======== float literals: decimal text to IEEE-754 binary32/binary64 ========
note The literal is fnd * 10^fp10. The converter normalizes fnd to a 64-bit significand, applies the
note decimal scale one factor of ten at a time (fmul10/fdiv10) while folding lost bits into one sticky
note flag, then rounds once (froundsh) and packs (fpack). It covers the full IEEE range, subnormals
note included, and refuses (error 8) only a value that rounds to infinity or whose digits do not fit
note in 2^63-1.

note blen: bits needed for x (0 for zero)
fn blen x ulong to ulong
n = ulong 0
while ne x 0
x = shr x 1
n = add n 1
end
ret n
end

note fparse: read the literal text inp[pos, pos+len) into fsgn, fnd, fp10, fsuf (0 none, 1 f32, 2 f64).
note Grammar: [-]digits[.digits][(e|E)[+|-]digits][f32|f64]. At most 2^63-1 significant digits
note (error 8), a dot with no digit after it is error 6, |exponent| <= 999 (error 8).
note The digit scans here and in fexp and the decimal steps in fbits run as nested 999999-pass loops: a
note literal of more than 1000000 zero digits trapped 4 in a single loop's hidden 1000000-pass guard (#965).
fn fparse pos ulong ln ulong to void
p = pos
e = add pos ln
put fsgn 0 0
put fsuf 0 0
put fnd 0 0
put fg_fl 0 0
put fg_seen 0 0
if eq get inp p 45
put fsgn 0 1
p = add p 1
end
go = true
while go
pos = ulong 0
while and go lt pos 999999
if ge p e
go = false
else
d = sub ulong get inp p 48
if le d 9
if gt get fnd 0 922337203685477580
fail 8
end
if eq get fnd 0 922337203685477580
if gt d 7
fail 8
end
end
put fnd 0 add mul get fnd 0 10 d
if ne get fg_seen 0 0
put fg_fl 0 add get fg_fl 0 1
end
p = add p 1
else
go = false
if eq get inp p 46
if eq get fg_seen 0 0
put fg_seen 0 1
p = add p 1
go = true
end
end
end
end
pos = add pos 1
end
end
if and ne get fg_seen 0 0 eq get fg_fl 0 0
fail 6
end
p = fexp p e
p = fsufx p e
if ne p e
fail 6
end
x = mul get fg_esign 0 get fg_ex 0
put fp10 0 sub x long get fg_fl 0
end

note fexp: the exponent of the literal, if present: fg_ex, fg_esign, fg_ed. Returns the new position.
fn fexp p ulong e ulong to ulong
put fg_ex 0 0
put fg_esign 0 1
if and lt p e or eq get inp p 101 eq get inp p 69
p = add p 1
if lt p e
if or eq get inp p 43 eq get inp p 45
if eq get inp p 45
put fg_esign 0 -1
end
p = add p 1
end
end
put fg_ed 0 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
d = sub ulong get inp p 48
if gt d 9
go = false
else
put fg_ex 0 mul get fg_ex 0 10
put fg_ex 0 add get fg_ex 0 long d
if gt get fg_ex 0 999
fail 8
end
put fg_ed 0 add get fg_ed 0 1
p = add p 1
end
end
m = add m 1
end
end
if eq get fg_ed 0 0
fail 6
end
end
ret p
end

note fsufx: the optional f32/f64 suffix: fsuf 1 or 2. Returns the new position.
fn fsufx p ulong e ulong to ulong
if lt p e
r = sub e p
if ne r 3
fail 6
end
if ne get inp p 102
fail 6
end
if and eq get inp add p 1 51 eq get inp add p 2 50
put fsuf 0 1
else
if and eq get inp add p 1 54 eq get inp add p 2 52
put fsuf 0 2
else
fail 6
end
end
p = add p 3
end
ret p
end

note fbits: the parsed literal as IEEE bits of type ty (10 f32, 11 f64). Zero keeps the sign (-0.0).
note fmul10 / fdiv10: one exact decimal step on the normalized significand fg_m (value = fg_m * 2^fg_e),
note keeping fg_m in [2^63, 2^64) and folding every lost bit into fg_stk. No rounding happens here.
fn fmul10 to void
m = get fg_m 0
hi = shr m 32
lo = and m 4294967295
p0 = mul lo 10
p1 = mul hi 10
hi2 = add p1 shr p0 32
put fg_low 0 or shl and hi2 4294967295 32 and p0 4294967295
put fg_ov 0 shr hi2 32
fmn10
end

fn fmn10 to void
ov = get fg_ov 0
low = get fg_low 0
s = blen ov
if ne s 0
st = or get fg_stk 0 and low sub shl 1 s 1
put fg_stk 0 st
put fg_m 0 or shl ov sub 64 s shr low s
put fg_e 0 add get fg_e 0 long s
else
put fg_m 0 low
end
end

fn fdiv10 to void
m = get fg_m 0
q = div m 10
if ne rem m 10 0
put fg_stk 0 1
end
s = ulong 0
while lt q 9223372036854775808
q = shl q 1
s = add s 1
end
put fg_m 0 q
put fg_e 0 sub get fg_e 0 long s
end

note froundsh: round fg_m right by sh bits to fg_q, nearest even; the guard and every lower bit
note (plus fg_stk) decide. sh may be 64 (then q is zero and bit 63 is the guard).
fn froundsh sh ulong to void
m = get fg_m 0
q = ulong 0
guard = ulong 0
lost = ulong 0
if eq sh 0
q = m
else
if ge sh 64
guard = shr m 63
lost = and m 9223372036854775807
else
q = shr m sh
guard = and shr m sub sh 1 1
if gt sub sh 1 0
lost = and m sub shl 1 sub sh 1 1
end
end
end
sticky = or get fg_stk 0 lost
if ne guard 0
if or ne sticky 0 eq and q 1 1
q = add q 1
end
end
put fg_q 0 q
end

note fpack: fg_m/fg_e to IEEE bits of fg_ty, including subnormals; a literal that rounds to infinity
note is refused (error 8).
fn fpack to ulong
p = ulong 53
bias = long 1023
maxe = long 2047
emin = long -1022
mb = ulong 52
w = ulong 64
if eq get fg_ty 0 10
p = ulong 24
bias = long 127
maxe = long 255
emin = long -126
mb = ulong 23
w = ulong 32
end
e = add get fg_e 0 63
if ge e emin
sh = sub 64 p
froundsh sh
q = get fg_q 0
if eq q shl 1 p
q = shr q 1
e = add e 1
end
E = add e bias
if ge E maxe
fail 8
end
q = and q sub shl 1 sub p 1 1
q = or q shl ulong E mb
q = or q shl get fsgn 0 sub w 1
ret q
end
k = ulong sub emin e
sh = add sub 64 p k
if gt sh 64
ret shl get fsgn 0 sub w 1
end
froundsh sh
q = get fg_q 0
q = or q shl get fsgn 0 sub w 1
ret q
end

fn fbits ty ulong to ulong
put fg_ty 0 ty
put fg_stk 0 0
if eq get fnd 0 0
w = ulong 64
if eq ty 10
w = ulong 32
end
b = ulong 0
if ne get fsgn 0 0
b = shl ulong 1 sub w 1
end
ret b
end
b = blen get fnd 0
sh = sub 64 b
put fg_m 0 shl get fnd 0 sh
put fg_e 0 sub 0 long sh
p = get fp10 0
if gt p 0
i = ulong 0
n = ulong p
while lt i n
fmul10
i = add i 1
end
else
if lt p 0
i = ulong 0
n = ulong sub 0 p
while lt i n
c = sub n i
if gt c 999999
c = ulong 999999
end
for k ulong c
fdiv10
end
i = add i c
end
end
end
ret fpack
end

note fsizeof: sizeof T, or sizeof S for a struct: bytes. foffset: offsetof S f: the field's byte offset
note in the struct's 8-byte-cell layout. Both are compile-time constants of type ulong.
fn fsizeof dst ulong to void
