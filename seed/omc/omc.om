packed = or ulong 115 shl ulong 111 8
packed = or packed shl ulong 99 16
packed = or packed shl ulong 107 24
packed = or packed shl ulong 111 32
packed = or packed shl ulong 112 40
packed = or packed shl ulong 116 48
