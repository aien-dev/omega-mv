note ---- float literals: a token is the decimal value fsgn * fnd * 10^fp10, fsuf 0 none / 1 f32 / 2 f64.
note fg_* hold the working state of the one literal being converted (see fparse/fbits/fnorm/fgen).
global fsgn ulong 1
global fnd ulong 1
global fp10 long 1
global fsuf ulong 1
global fg_fl ulong 1
global fg_seen ulong 1
global fg_ex long 1
global fg_esign long 1
global fg_ed ulong 1
global fg_ty ulong 1
global fg_e long 1
global fg_q ulong 1
global fg_m ulong 1
global fg_stk ulong 1
global fg_low ulong 1
global fg_ov ulong 1

note ======== float literals: decimal text to IEEE-754 binary32/binary64 ========
note The literal is fnd * 10^fp10. The converter normalizes fnd to a 64-bit significand, applies the
note decimal scale one factor of ten at a time (fmul10/fdiv10) while folding lost bits into one sticky
note flag, then rounds once (froundsh) and packs (fpack). It covers the full IEEE range, subnormals
note included, and refuses (error 8) only a value that rounds to infinity or whose digits do not fit
note in 2^63-1.

note blen: bits needed for x (0 for zero)
fn blen x ulong to ulong
n = ulong 0
while ne x 0
x = shr x 1
n = add n 1
end
ret n
end

note fparse: read the literal text inp[pos, pos+len) into fsgn, fnd, fp10, fsuf (0 none, 1 f32, 2 f64).
note Grammar: [-]digits[.digits][(e|E)[+|-]digits][f32|f64]. At most 2^63-1 significant digits
note (error 8), a dot with no digit after it is error 6, |exponent| <= 999 (error 8).
fn fparse pos ulong ln ulong to void
p = pos
e = add pos ln
put fsgn 0 0
put fsuf 0 0
put fnd 0 0
put fg_fl 0 0
put fg_seen 0 0
if eq get inp p 45
put fsgn 0 1
p = add p 1
end
go = true
while and go lt p e
b = get inp p
d = sub ulong b 48
if le d 9
if gt get fnd 0 922337203685477580
fail 8
end
if and eq get fnd 0 922337203685477580 gt d 7
fail 8
end
put fnd 0 add mul get fnd 0 10 d
if ne get fg_seen 0 0
put fg_fl 0 add get fg_fl 0 1
end
p = add p 1
else
if and eq b 46 eq get fg_seen 0 0
put fg_seen 0 1
p = add p 1
else
go = false
end
end
end
if and ne get fg_seen 0 0 eq get fg_fl 0 0
fail 6
end
p = fexp p e
p = fsufx p e
if ne p e
fail 6
end
x = mul get fg_esign 0 get fg_ex 0
put fp10 0 sub x long get fg_fl 0
end

note fexp: the exponent of the literal, if present: fg_ex, fg_esign, fg_ed. Returns the new position.
fn fexp p ulong e ulong to ulong
put fg_ex 0 0
put fg_esign 0 1
if and lt p e or eq get inp p 101 eq get inp p 69
p = add p 1
if lt p e
if or eq get inp p 43 eq get inp p 45
if eq get inp p 45
put fg_esign 0 -1
end
p = add p 1
end
end
put fg_ed 0 0
go = true
while and go lt p e
d = sub ulong get inp p 48
if gt d 9
go = false
else
put fg_ex 0 add mul get fg_ex 0 10 long d
if gt get fg_ex 0 999
fail 8
end
put fg_ed 0 add get fg_ed 0 1
p = add p 1
end
end
if eq get fg_ed 0 0
fail 6
end
end
ret p
end

note fsufx: the optional f32/f64 suffix: fsuf 1 or 2. Returns the new position.
fn fsufx p ulong e ulong to ulong
if lt p e
r = sub e p
if ne r 3
fail 6
end
if ne get inp p 102
fail 6
end
if and eq get inp add p 1 51 eq get inp add p 2 50
put fsuf 0 1
else
if and eq get inp add p 1 54 eq get inp add p 2 52
put fsuf 0 2
else
fail 6
end
end
p = add p 3
end
ret p
end

note fbits: the parsed literal as IEEE bits of type ty (10 f32, 11 f64). Zero keeps the sign (-0.0).
note fmul10 / fdiv10: one exact decimal step on the normalized significand fg_m (value = fg_m * 2^fg_e),
note keeping fg_m in [2^63, 2^64) and folding every lost bit into fg_stk. No rounding happens here.
fn fmul10 to void
m = get fg_m 0
hi = shr m 32
lo = and m 4294967295
p0 = mul lo 10
p1 = mul hi 10
hi2 = add p1 shr p0 32
put fg_low 0 or shl and hi2 4294967295 32 and p0 4294967295
put fg_ov 0 shr hi2 32
fmn10
end

fn fmn10 to void
ov = get fg_ov 0
low = get fg_low 0
s = blen ov
if ne s 0
st = or get fg_stk 0 and low sub shl 1 s 1
put fg_stk 0 st
put fg_m 0 or shl ov sub 64 s shr low s
put fg_e 0 add get fg_e 0 long s
else
put fg_m 0 low
end
end

fn fdiv10 to void
m = get fg_m 0
q = div m 10
if ne rem m 10 0
put fg_stk 0 1
end
s = ulong 0
while lt q 9223372036854775808
q = shl q 1
s = add s 1
end
put fg_m 0 q
put fg_e 0 sub get fg_e 0 long s
end

note froundsh: round fg_m right by sh bits to fg_q, nearest even; the guard and every lower bit
note (plus fg_stk) decide. sh may be 64 (then q is zero and bit 63 is the guard).
fn froundsh sh ulong to void
m = get fg_m 0
q = ulong 0
guard = ulong 0
lost = ulong 0
if eq sh 0
q = m
else
if ge sh 64
guard = shr m 63
lost = and m 9223372036854775807
else
q = shr m sh
guard = and shr m sub sh 1 1
if gt sub sh 1 0
lost = and m sub shl 1 sub sh 1 1
end
end
end
sticky = or get fg_stk 0 lost
if ne guard 0
if or ne sticky 0 eq and q 1 1
q = add q 1
end
end
put fg_q 0 q
end

note fpack: fg_m/fg_e to IEEE bits of fg_ty, including subnormals; a literal that rounds to infinity
note is refused (error 8).
fn fpack to ulong
p = ulong 53
bias = long 1023
maxe = long 2047
emin = long -1022
mb = ulong 52
w = ulong 64
if eq get fg_ty 0 10
p = ulong 24
bias = long 127
maxe = long 255
emin = long -126
mb = ulong 23
w = ulong 32
end
e = add get fg_e 0 63
if ge e emin
sh = sub 64 p
froundsh sh
q = get fg_q 0
if eq q shl 1 p
q = shr q 1
e = add e 1
end
E = add e bias
if ge E maxe
fail 8
end
q = and q sub shl 1 sub p 1 1
q = or q shl ulong E mb
q = or q shl get fsgn 0 sub w 1
ret q
end
k = ulong sub emin e
sh = add sub 64 p k
if gt sh 64
ret shl get fsgn 0 sub w 1
end
froundsh sh
q = get fg_q 0
q = or q shl get fsgn 0 sub w 1
ret q
end

fn fbits ty ulong to ulong
put fg_ty 0 ty
put fg_stk 0 0
if eq get fnd 0 0
w = ulong 64
if eq ty 10
w = ulong 32
end
b = ulong 0
if ne get fsgn 0 0
b = shl ulong 1 sub w 1
end
ret b
end
b = blen get fnd 0
sh = sub 64 b
put fg_m 0 shl get fnd 0 sh
put fg_e 0 sub 0 long sh
p = get fp10 0
if gt p 0
i = ulong 0
n = ulong p
while lt i n
fmul10
i = add i 1
end
else
if lt p 0
i = ulong 0
n = ulong sub 0 p
while lt i n
fdiv10
i = add i 1
end
end
end
ret fpack
end

note fsizeof: sizeof T, or sizeof S for a struct: bytes. foffset: offsetof S f: the field's byte offset
note in the struct's 8-byte-cell layout. Both are compile-time constants of type ulong.
fn fsizeof dst ulong to void
sid = peek_struct
if ne sid 0
si = sub sid 1
n = ulong get st_cells si
vdone 3 mul n 8 5
ret
end
t = typeword
v = shl 1 tlog t
vdone 3 v 5
end

fn foffset dst ulong to void
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
sid = findstruct get tw 0
if eq sid 0
fail 3
end
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
f = findfield sub sid 1 get tw 0
if eq f 0
fail 3
end
off = ulong get sf_off sub f 1
vdone 3 mul off 8 5
end

note fconst: the float token just read, as bits of ty. fspan: a deferred literal stored as pos*64+len.
fn fconst ty ulong to ulong
fparse get ts 0 get tl 0
ret fbits ty
end

fn fspan ty ulong packed ulong to ulong
fparse div packed 64 rem packed 64
ret fbits ty
end

fn isfloat t ulong to ulong
if ge t 10
ret 1
end
ret 0
end

note ======== om4's small tables, as functions ========
note twid: width in bits by type 0..9 (bool 1; uchar ushort uint ulong; byte short int long)
fn twid t ulong to ulong
if eq t 10
ret 32
end
if eq t 11
ret 64
end
if eq t 1
ret 1
end
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or eq t 4 eq t 8
ret 32
end
if or eq t 5 eq t 9
ret 64
end
ret 0
end

note tlog: log2 of the element size by type
fn tlog t ulong to ulong
if eq t 10
ret 2
end
if eq t 11
ret 3
end
if or eq t 3 eq t 7
ret 1
end
if or eq t 4 eq t 8
ret 2
end
if or eq t 5 eq t 9
ret 3
end
ret 0
end

note regidx: the pool index of register r (the inverse of poolc; 255 for x7 and x16)
fn regidx r ulong to ulong
if lt r 7
ret r
end
if eq r 7
ret 255
end
if lt r 16
ret sub r 1
end
if eq r 16
ret 255
end
ret 15
end

note conds: the condition for eq ne lt le gt ge (i = 2 (op - 43) + 1 when signed): EQ 0, NE 1, LO 3 / LT 11,
note LS 9 / LE 13, HI 8 / GT 12, HS 2 / GE 10 (Arm ARM Table C1-1). The opposite condition is cond xor 1.
fn conds i ulong to ulong
if lt i 2
ret 0
end
if lt i 4
ret 1
end
if eq i 4
ret 3
end
if eq i 5
ret 11
end
if eq i 6
ret 9
end
if eq i 7
ret 13
end
if eq i 8
ret 8
end
if eq i 9
ret 12
end
if eq i 10
ret 2
end
ret 10
end

note ldop / stop: register-offset load / store by element type (om4 LDOP, STOP tables)
fn ldop t ulong to ulong
note LDRB 0x38606800, LDRH 0x78607800, LDR w 0xb8607800, LDR x 0xf8607800, LDRSB 0x38a06800,
note LDRSH 0x78a07800, LDRSW 0xb8a07800
if eq t 2
ret 945842176
end
if eq t 3
ret 2019588096
end
if eq t 4
ret 3093329920
end
if or eq t 5 eq t 9
ret 4167071744
end
if eq t 10
ret 3093329920
end
if eq t 11
ret 4167071744
end
if eq t 6
ret 950036480
end
if eq t 7
ret 2023782400
end
if eq t 8
ret 3097524224
end
ret 0
end

fn stop t ulong to ulong
note STRB 0x38206800, STRH 0x78207800, STR w 0xb8207800, STR x 0xf8207800
if or eq t 2 eq t 6
ret 941647872
end
if or eq t 3 eq t 7
ret 2015393792
end
if or eq t 4 eq t 8
ret 3089135616
end
if or eq t 5 eq t 9
ret 4162877440
end
if eq t 10
ret 3089135616
end
if eq t 11
ret 4162877440
end
ret 0
end

note ---- trap list (8192 sites per function): output offset of the branch, trap code ----
global tsite ulong 8192
global tcode ulong 8192
global nt ulong 1
note ---- block stack (512): kind (1 if, 2 else, 3 while, 4 for), branch to patch, loop head, loop
note register, its type, names and held pool slots to restore at end, then-part ended (for else) ----
global bkind ulong 512
global bbr ulong 512
global bhead ulong 512
global breg ulong 512
global btyp ulong 512
global bnames ulong 512
global bheld ulong 512
global bdead ulong 512
global nb ulong 1
global curfn ulong 1
note ---- break fixups (1024): output offset of the branch, block index of the loop it leaves ----
global brkpos ulong 1024
global brkblk ulong 1024
global nbrk ulong 1
global cpos ulong 1024
global cblk ulong 1024
global ncont ulong 1
note ======== names and functions ========
note findname: packed name -> its index + 1 among the names in scope (0 none). om4 FINDNAME.
fn findname w ulong to ulong
i = ulong 0
n = get nn 0
while lt i n
if eq get nm_name i w
ret add i 1
end
i = add i 1
end
ret 0
end

note findfn: packed name w (first 8 bytes), length l (any value up to 8 for a short name), start s in the
note input (read only for a name over 8 bytes) -> function index + 1 (0 none). om4 FINDFN.
fn findfn w ulong l ulong s ulong to ulong
j = ulong 0
while lt j get nf 0
if eq get fn_name j w
fl = get fn_nmlen j
if le l 8
if le fl 8
ret add j 1
end
else
if eq fl l
o = get fn_off j
k = ulong 8
same = true
while and same lt k l
a = get inp add o k
if ne a get inp add s k
same = false
end
k = add k 1
end
if same
ret add j 1
end
end
end
end
j = add j 1
end
ret 0
end

note newname: the name must not be in use (a name in scope when 8 bytes or fewer, or a function): error 10
fn newname w ulong l ulong s ulong to void
if ne findstruct w 0
fail 10
end
if le l 8
if ne findname w 0
fail 10
end
end
if ne findfn w l s 0
fail 10
end
end

note addname: packed name, register, type, length, kind, address. om4 ADDNAME.
fn addname w ulong r ulong t ulong ln ulong k ulong a ulong to void
n = get nn 0
if ge n 1024
fail 14
end
put nm_name n w
put nm_reg n uchar r
put nm_type n uchar t
put nm_len n ln
put nm_kind n uchar k
put nm_addr n a
put nn 0 add n 1
end

note ======== registers and words ========
note alloc: the next free register of the pool (after the parameters); error 12 when none is left
fn alloc to ulong
i = add get npar 0 get nslot 0
if ge i 16
fail 12
end
put nslot 0 add get nslot 0 1
ret poolc i
end

note destreg: d, or a new temporary when d is 255
fn destreg d ulong to ulong
if eq d 255
ret alloc
end
ret d
end

note e3: emit op | d | n << 5 | m << 16
fn e3 op ulong d ulong n ulong m ulong to void
emit or or or op d shl n 5 shl m 16
end

note trapsite: note the place and code of a branch to the trap stub, then emit it. trapc: B.cond, as om4.
fn trapsite w ulong code ulong to void
n = get nt 0
if ge n 8192
fail 14
end
put tsite n get oc 0
put tcode n code
put nt 0 add n 1
emit w
end

fn trapc cc ulong code ulong to void
trapsite or 1409286144 cc code
end

fn rdword at ulong to ulong
a = ulong get out at
b = shl ulong get out add at 1 8
c = shl ulong get out add at 2 16
d = shl ulong get out add at 3 24
ret or or or a b c d
end

fn wrword at ulong w ulong to void
put out at uchar and w 255
put out add at 1 uchar and shr w 8 255
put out add at 2 uchar and shr w 16 255
put out add at 3 uchar and shr w 24 255
end

note patch19: the word distance from a B.cond / CBZ / CBNZ at `at` to `target`, into bits 5..23
fn patch19 at ulong target ulong to void
d = and shr sub target at 2 524287
wrword at or rdword at shl d 5
end

note patch26: the word distance from a B at `at` to `target`, into bits 0..25
fn patch26 at ulong target ulong to void
d = and shr sub target at 2 67108863
wrword at or rdword at d
end

note back: emit B to an earlier place (C6.2.35)
fn back addr ulong to void
emit or 335544320 and shr sub addr get oc 0 2 67108863
end

note matconst: put a 64-bit value in register r: MOVZ (C6.2.285) or, for a value with the top bit set,
note MOVN (C6.2.284) with the first halfword that differs from the fill, then MOVK (C6.2.283) for each
note other such halfword. om4 MATCONST.
fn matconst r ulong v ulong to void
fill = ulong 0
mop = ulong 3531603968
if ne shr v 63 0
fill = ulong 65535
mop = ulong 2457862144
end
started = false
hw = ulong 0
while lt hw 4
h = and shr v shl hw 4 65535
if ne h fill
if started
emit or or or 4068474880 shl h 5 shl hw 21 r
else
emit or or or mop shl xor h fill 5 shl hw 21 r
started = true
end
end
hw = add hw 1
end
if not started
emit or mop r
end
end

note canon: u8/u16/u32 UBFM Xr, Xr, #0, #w-1 (C6.2.487); i8/i16/i32 SBFM (C6.2.355); else nothing
fn canon r ulong t ulong to void
if lt t 2
ret
end
if eq t 5
ret
end
if eq t 9
ret
end
base = ulong 3544186880
if gt t 5
base = ulong 2470445056
end
emit or or or base shl sub twid t 1 10 r shl r 5
end

note chkext: CMP Xr, Wr, SXTB/SXTH/SXTW (SUBS extended, C6.2.463), then B.NE trap code
fn chkext r ulong t ulong code ulong to void
emit or or or 3944742943 shl sub t 2 13 shl r 16 shl r 5
trapc 1 code
end

note range: error 8 unless v is a value of type t; big = the number was written as 2^63 or more
fn range v ulong t ulong big ulong to void
w = twid t
if eq w 64
if eq t 9
if ne big 0
fail 8
end
ret
end
if ne big 0
ret
end
if ne shr v 63 0
fail 8
end
ret
end
if ne big 0
fail 8
end
lim = shl ulong 1 w
if lt t 6
if ge v lim
fail 8
end
ret
end
half = shr lim 1
if ge add v half lim
fail 8
end
end

note cset: CSET Xr, cond = CSINC Xr, XZR, XZR, opposite cond (C6.2.141)
fn cset r ulong cc ulong to void
emit or or 2594113504 r shl xor cc 1 12
end

note force: put a value (kind 1 register, 3 number, 4 flags) in register r; a bare number is error 11
fn force k ulong v ulong t ulong r ulong to void
if eq k 1
if ne v r
emit or or 2852127712 r shl v 16
end
ret
end
if or eq k 3 eq k 7
matconst r v
ret
end
if eq k 4
cset r v
ret
end
fail 11
end

note matreg: a register holding the value
fn matreg k ulong v ulong t ulong to ulong
if eq k 1
ret v
end
r = alloc
force k v t r
ret r
end

note spop: ADD (C6.2.5) / SUB (C6.2.457) SP, SP by a multiple of 16 below 2^24: low 12 bits, then the
note high 12 bits LSL 12; nothing for a zero part
fn spop base ulong bytes ulong to void
lo = and bytes 4095
if ne lo 0
emit or or base 1023 shl lo 10
end
hi = and shr bytes 12 4095
if ne hi 0
emit or or base 4195327 shl hi 10
end
end

fn spadd bytes ulong to void
spop 2432696320 bytes
end

fn spsub bytes ulong to void
spop 3506438144 bytes
end

note stkchk: program mode only: CMP SP, X28 (C6.2.463); B.LO trap 6
fn stkchk to void
if ne get progmode 0 0
emit 3946603519
trapc 3 6
end
end

note epi: give back the stack of the local arrays, then RET (C6.2.338)
fn epi to void
spadd get stkbytes 0
emit 3596551104
end

fn dead1 to void
put dead 0 1
end

note pushb / pushnh: open a block (om4 PUSHB, split in two because a call takes at most 6 values)
fn pushb br ulong k ulong head ulong reg ulong ty ulong to void
n = get nb 0
if ge n 512
fail 14
end
put bkind n k
put bbr n br
put bhead n head
put breg n reg
put btyp n ty
put bdead n 0
put nb 0 add n 1
end

fn pushnh names ulong hd ulong to void
n = sub get nb 0 1
put bnames n names
put bheld n hd
end

note ======== small readers ========
fn elemtype t ulong to void
if lt t 2
fail 9
end
end

note arrlen: an array length 1 .. 16777216 (error 8 below, 23 above, 23 when written as 2^63 or more)
fn arrlen v ulong to void
if ne get tbig 0 0
fail 23
end
if or eq v 0 ne shr v 63 0
fail 8
end
if gt v 16777216
fail 23
end
end

note typeword: read a type name -> 1..9
fn typeword to ulong
tok
k = get tk 0
if eq k 0
fail 4
end
if ne k 1
fail 16
end
if gt get tl 0 8
fail 16
end
c = kw get tw 0
if eq c 76
fail 9
end
if or eq c 88 eq c 89
if ne get irmode 0 0
fail 9
end
end
if eq c 88
ret 10
end
if eq c 89
ret 11
end
if gt sub c 1 8
fail 16
end
ret c
end

note eol: the line must end here
fn eol to void
tok
k = get tk 0
if and ne k 0 ne k 3
fail 5
end
end

note arrname: read an array name -> its index + 1
fn arrname to ulong
tok
k = get tk 0
if eq k 0
fail 4
end
if eq k 3
fail 4
end
if ne k 1
fail 16
end
if gt get tl 0 8
fail 13
end
e = findname get tw 0
if eq e 0
fail 3
end
if eq get nm_kind sub e 1 0
fail 7
end
ret e
end

note topname: read a new name for a global or a text -> its packed word
fn topname to ulong
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
w = get tw 0
if ne kw w 0
fail 16
end
newname w get tl 0 get ts 0
ret w
end

note ---- value results (om4 x0 kind 1 register / 2 bare number / 3 typed number / 4 flags, x1 register,
note number or condition, x2 type). fr: 32 cells per value nesting depth 0..1024: 0..5 the two operands of
note a binary op (kind, value, type each), 8..25 a call's arguments (kind, value, array name each) ----
global rk ulong 1
global rv ulong 1
global rt ulong 1
global fr ulong 32800
global depth ulong 1

note ======== BINOP (om4 BINOP and its BO_* parts): two values already read, types settled ========
note bo_w3: emit fx | rd | ra << 5 | (imm12 << 10, or rb << 16)
fn bo_w3 fx ulong rd ulong ra ulong rb ulong imm ulong to void
if ne imm 0
emit or or or fx rd shl ra 5 shl rb 10
else
emit or or or fx rd shl ra 5 shl rb 16
end
end

note bo_fix: after a 64-bit op on rd: u8/u16/u32 wrap (canon), i8/i16/i32 overflow check (trap 1)
fn bo_fix rd ulong ty ulong to void
if lt ty 6
canon rd ty
ret
end
if eq ty 9
ret
end
chkext rd ty 1
end

note bo_schk: a shift amount in a register must be below the width: CMP Xb, #w; B.HS trap 7
fn bo_schk ty ulong rb ulong to void
emit or or 4043309087 shl twid ty 10 shl rb 5
trapc 2 7
end

note add, sub: u32 the 32-bit form; i64 ADDS/SUBS + B.VS trap 1; others 64-bit then bo_fix (om4 BO_ADD)
fn bo_add op ulong ty ulong ra ulong rb ulong imm ulong rd ulong to void
fx = ulong 2332033024
if eq op 34
fx = ulong 3405774848
end
if ne imm 0
fx = ulong 2432696320
if eq op 34
fx = ulong 3506438144
end
end
if eq ty 4
bo_w3 xor fx 2147483648 rd ra rb imm
ret
end
if eq ty 9
bo_w3 or fx 536870912 rd ra rb imm
trapc 6 1
ret
end
bo_w3 fx rd ra rb imm
bo_fix rd ty
end

note mul: i64 SMULH t, MUL, CMP t, rd, ASR #63, B.NE trap 1 (om4 BO_MUL)
fn bo_mul ty ulong ra ulong rb ulong rd ulong to void
if eq ty 9
t = alloc
e3 2604694528 t ra rb
bo_w3 2600500224 rd ra rb 0
e3 3951098911 0 t rd
trapc 1 1
ret
end
if eq ty 4
bo_w3 453016576 rd ra rb 0
ret
end
bo_w3 2600500224 rd ra rb 0
bo_fix rd ty
end

note div, rem (om4 BO_DIV, BO_SDIV): CBZ Xb trap 2 unless fl bit 1 (b a number other than 0); UDIV or
note SDIV; rem: t = a / b, rd = a - t * b (MSUB); i64 div: CMN Xb, #1; B.NE +3; NEGS XZR, Xa; B.VS trap 1,
note unless fl bit 2 (b a number other than -1)
fn bo_div op ulong ty ulong ra ulong rb ulong rd ulong fl ulong to void
if eq and fl 1 0
trapsite or 3019898880 rb 2
end
if eq op 37
t = alloc
if ge ty 6
e3 2596277248 t ra rb
else
e3 2596276224 t ra rb
end
e3 or 2600501248 shl ra 10 rd t rb
ret
end
if lt ty 6
bo_w3 2596276224 rd ra rb 0
ret
end
if eq ty 9
if eq and fl 2 0
emit or 2969568287 shl rb 5
emit 1409286241
emit or 3942646783 shl ra 16
trapc 6 1
end
end
bo_w3 2596277248 rd ra rb 0
if ne ty 9
bo_fix rd ty
end
end

note and, or, xor (om4 BO_LOG)
fn bo_log op ulong ra ulong rb ulong rd ulong to void
fx = ulong 2315255808
if eq op 39
fx = ulong 2852126720
end
if eq op 40
fx = ulong 3388997632
end
bo_w3 fx rd ra rb 0
end

note bo_lsl: LSL Xd, Xn, #s as UBFM Xd, Xn, #(64-s) mod 64, #63-s
fn bo_lsl ra ulong s ulong rd ulong to void
r = shl and sub 64 s 63 16
r = or r shl sub 63 s 10
r = or r shl ra 5
emit or or 3544186880 r rd
end

note shl (om4 BO_SHL, BS_64): by a number s: UBFM Xd, Xn, #(64-s) mod 64, #63-s; by a register: the amount
note check, LSLV; i64: t = a << s, X16 = t >> s arithmetic, CMP X16, Xa, B.NE trap 1, MOV Xd, Xt
fn bo_shl ty ulong ra ulong rb ulong imm ulong rd ulong to void
if eq ty 9
t = alloc
if ne imm 0
bo_lsl ra rb t
emit or or 2470509584 shl rb 16 shl t 5
else
bo_schk ty rb
e3 2596282368 t ra rb
e3 2596284432 0 t rb
end
emit or 3942646303 shl ra 16
trapc 1 1
emit or or 2852127712 rd shl t 16
ret
end
if ne imm 0
bo_lsl ra rb rd
bo_fix rd ty
ret
end
bo_schk ty rb
if eq ty 4
bo_w3 448798720 rd ra rb 0
ret
end
bo_w3 2596282368 rd ra rb 0
bo_fix rd ty
end

note shr: unsigned LSR, signed ASR; by a number UBFM / SBFM Xd, Xn, #s, #63; by a register the amount check
note then LSRV / ASRV (om4 BO_SHR)
fn bo_shr ty ulong ra ulong rb ulong imm ulong rd ulong to void
if ne imm 0
fi = ulong 3544251392
if ge ty 6
fi = ulong 2470509568
end
emit or or or fi shl rb 16 shl ra 5 rd
ret
end
bo_schk ty rb
fx = ulong 2596283392
if ge ty 6
fx = ulong 2596284416
end
bo_w3 fx rd ra rb 0
end

note comparisons: CMP Xa, #imm or CMP Xa, Xb; the result is the flags and a condition (om4 BO_CMP)
fn bo_cmp op ulong ty ulong ra ulong rb ulong imm ulong to void
if ne imm 0
emit or or 4043309087 shl rb 10 shl ra 5
else
emit or or 3942645791 shl rb 16 shl ra 5
end
i = mul sub op 43 2
if ge ty 6
i = add i 1
end
put rk 0 4
put rv 0 conds i
put rt 0 1
end

note ---- floating point. A float value is its IEEE bit pattern in an x register; arithmetic moves it to
note v0/v1, runs one scalar FP instruction (round to nearest even, no fused op), and moves it back.
note f32 uses the S form (low 32 bits), f64 the D form.
fn f2v ty ulong xr ulong vr ulong to void
if eq ty 10
emit or or 505872384 shl xr 5 vr
else
emit or or 2657550336 shl xr 5 vr
end
end

fn fv2x ty ulong vr ulong xr ulong to void
if eq ty 10
emit or or 505806848 shl vr 5 xr
else
emit or or 2657484800 shl vr 5 xr
end
end

fn fp_binop op ulong ty ulong ra ulong rb ulong rd ulong to void
f2v ty ra 0
f2v ty rb 1
base = ulong 509609984
if eq ty 10
base = ulong 505415680
end
if eq op 33
if eq ty 10
base = ulong 505423872
else
base = ulong 509618176
end
else
if eq op 34
if eq ty 10
base = ulong 505427968
else
base = ulong 509622272
end
else
if eq op 36
if eq ty 10
base = ulong 505419776
else
base = ulong 509614080
end
end
end
end
emit or or or base shl ulong 1 16 ulong 0 2
fv2x ty 2 rd
end

fn fp_neg ty ulong ra ulong rd ulong to void
f2v ty ra 0
if eq ty 10
emit or ulong 505495552 1
else
emit or ulong 509689856 1
end
fv2x ty 1 rd
end

fn fp_sqrt ty ulong ra ulong rd ulong to void
f2v ty ra 0
if eq ty 10
emit or ulong 505528320 1
else
emit or ulong 509722624 1
end
fv2x ty 1 rd
end

fn fp_abs ty ulong ra ulong rd ulong to void
f2v ty ra 0
if eq ty 10
emit or ulong 505462784 1
else
emit or ulong 509657088 1
end
fv2x ty 1 rd
end

note fp_minmax: FMINNM/FMAXNM, the IEEE minNum/maxNum rule: one quiet NaN returns the other operand,
note and -0.0 orders below +0.0.
fn fp_minmax c ulong ty ulong ra ulong rb ulong rd ulong to void
f2v ty ra 0
f2v ty rb 1
base = ulong 509638656
if eq c 94
base = ulong 509634560
end
if eq ty 10
base = ulong 505444352
if eq c 94
base = ulong 505440256
end
end
emit or or or base shl ulong 1 16 ulong 0 2
fv2x ty 2 rd
end

note fintr: sqrt or abs of one float value; fminmax: min or max of two values of one float type.
note Both refuse a bare integer operand and an unresolved literal, as everywhere else.
fn fintr c ulong dst ulong to void
if ne get irmode 0 0
fail 9
end
rdval 0 0 255 0
if eq get rk 0 2
fail 7
end
if eq get rk 0 6
fail 11
end
t = get rt 0
if lt t 10
fail 7
end
ra = matreg get rk 0 get rv 0 t
rd = destreg dst
if eq c 91
fp_sqrt t ra rd
else
fp_abs t ra rd
end
put rk 0 1
put rv 0 rd
put rt 0 t
vdec
end

fn fminmax c ulong dst ulong to void
if ne get irmode 0 0
fail 9
end
rdval 0 0 255 0
if or eq get rk 0 2 eq get rk 0 6
fail 11
end
at = get rt 0
ak = get rk 0
av = get rv 0
rdval 0 0 255 0
if or eq get rk 0 2 eq get rk 0 6
fail 11
end
if or lt at 10 lt get rt 0 10
fail 7
end
if ne at get rt 0
fail 7
end
ra = matreg ak av at
rb = matreg get rk 0 get rv 0 at
rd = destreg dst
fp_minmax c at ra rb rd
put rk 0 1
put rv 0 rd
put rt 0 at
vdec
end

note fcond: the condition for a float compare op: EQ, NE, MI (lt), LS (le), GT, GE. MI/LS/GT/GE are
note false for NaN, so unordered comparisons come out as the IEEE rules require.
fn fcond op ulong to ulong
i = sub op 43
if eq i 0
ret 0
end
if eq i 1
ret 1
end
if eq i 2
ret 4
end
if eq i 3
ret 9
end
if eq i 4
ret 12
end
ret 10
end

fn fp_cmp op ulong ty ulong ra ulong rb ulong to void
f2v ty ra 0
f2v ty rb 1
if eq ty 10
emit or or 505487360 shl ulong 1 16 ulong 0
else
emit or or 509616128 shl ulong 1 16 ulong 0
end
put rk 0 4
