note omc: the Omega compiler written in Omega (the om4 subset). Reads Omegese on stdin, writes a runnable
note AArch64 Linux program (or bare function words) on stdout. Built first by om4; its codegen matches om4
note byte for byte on the original subset (seed chain rung 5, ledger L408). Native host operations
note extend that subset; om4 still builds this compiler, and the compiler rebuilds itself identically.
note All compiler state lives in fixed global pools (decision 24: no heap). Every working value is a ulong
note (raw 64 bits) so the language's checked conversions never fire on om4's untyped-register logic.

note ---- input, output, token ----
global inp uchar 8388608
global inlen ulong 1
global irmode ulong 1
global cur ulong 1
global line ulong 1
global tk ulong 1
global tw ulong 1
global tl ulong 1
global ts ulong 1
global tbig ulong 1
global out uchar 8388608
global oc ulong 1

note ---- OM-2 profile (spec/omegese-om2.md, OMEGESE.md 9.13). om2 is 1 in an OM-2 unit (its first line
note that is not a note or blank is exactly om2, om2 diag or om2 fmt); om2m 0 compile, 1 diag, 2 fmt;
note om2ln/om2pos the line number and offset of that line; fmtm 1 while a unit is formatted; lbase and
note sbase shift reported lines and bytes back to the original input in fmt mode; tka/tkb the byte span of
note the last token; dexp what was being read (0 word 1 value 2 type 3 name 4 number 5 end 6 newline);
note dsev 0 derived, 2 unknown (an undeclared function or struct), 3 error ----
global om2 ulong 1
global om2m ulong 1
global om2ln ulong 1
global om2pos ulong 1
global fmtm ulong 1
global lbase ulong 1
global sbase ulong 1
global tka ulong 1
global tkb ulong 1
global dexp ulong 1
global dsev ulong 1

note ---- OM-2 section 4 (unroll, inline, folding, bounds, sites). fn_inl/fn_body/fn_bln/fn_pn: a function's
note inline mark, its body offset and line, its parameter names. fstart: where the function being compiled
note starts (65536 words at most in OM-2). nmlo: names below it and at or above nglob are hidden while an
note inlined body is compiled (0 otherwise). fzone: open unrolled bodies and inline frames (folding is
note done only when it is above 0). inl and il_*: the inline frames (at most 4). ilp/nilp: the B words of
note an inlined ret, patched at its end. lastb/tgoc: the word after the last inlined ret's B and the last
note place a branch was patched to. u_*: the unrolled loop of each block. fok/fval/fty: a fold result.
note sitebuf/nsite: the omc-site records of om2 diag.
global fn_inl uchar 512
global fn_body ulong 512
global fn_bln ulong 512
global fn_pn ulong 3072
global fstart ulong 1
global nmlo ulong 1
global fzone ulong 1
global inl ulong 1
global il_cur ulong 8
global il_line ulong 8
global il_ret ulong 8
global il_nn ulong 8
global il_lo ulong 8
global il_held ulong 8
global il_ns ulong 8
global il_res ulong 8
global il_fn ulong 8
global il_p0 ulong 8
global ilp ulong 4096
global nilp ulong 1
global lastb ulong 1
global tgoc ulong 1
global u_cur ulong 512
global u_line ulong 512
global u_it ulong 512
global u_k ulong 512
global u_nn ulong 512
global u_held ulong 512
note fuel / u_fl (E14): the expansion fuel used by the function being compiled (each unrolled-body copy and
note each inline expansion costs 1, at most 65536, error 14) and the line of each unrolled loop
global fuel ulong 1
global u_fl ulong 512
global fok ulong 1
global fval ulong 1
global fty ulong 1
global sitebuf uchar 8388608
global nsite ulong 1
global ie_from ulong 16384
global ie_to ulong 16384
global nie ulong 1
global reach uchar 512

note ---- name table (1024 names in scope): packed name, register, type, length, kind, address ----
global nm_name ulong 1024
global nm_reg uchar 1024
global nm_type uchar 1024
global nm_len ulong 1024
global nm_kind uchar 1024
global nm_addr ulong 1024
global nn ulong 1

note ---- function table (512): name, address (byte offset in out), return type, parameter count,
note per-parameter type/length/kind (6 each), name length, name offset in the input ----
global fn_name ulong 512
global fn_addr ulong 512
global fn_ret uchar 512
global fn_np uchar 512
global fn_pt uchar 3072
global fn_pl ulong 3072
global fn_pk uchar 3072
global fn_nmlen ulong 512
global fn_off ulong 512
global nf ulong 1
global lastfn ulong 1
global scanning ulong 1
global ncalls ulong 1
global callsite ulong 65536
global callfrom ulong 65536
global callto ulong 65536
global settled uchar 512


note ---- compiler state ----
global npar ulong 1
global held ulong 1
global nslot ulong 1
global curret ulong 1
global progmode ulong 1
global nglob ulong 1
global hostargs ulong 1
global maptab ulong 1
global stkbytes ulong 1
global dead ulong 1
global poolb ulong 1

note ---- structs (16) and fields (256). R6. nm_type 16+index, kind 6 own, 7 edit, 8 view ----
global st_name ulong 16
global st_nf uchar 16
global st_cells uchar 16
global st_foff uchar 16
global nst ulong 1
global sf_name ulong 256
global sf_type uchar 256
global sf_len uchar 256
global sf_off uchar 256
global nsf ulong 1
global svk ulong 16
global svv ulong 16
global svt ulong 16

note ---- OM-2 section 5 external layouts (16) and their fields (256): name, SIZE, first field, field count,
note the cursor and line after the block's end (the body pass jumps there). Field: name, type, COUNT (0 a
note scalar), byte offset, 1 big-endian. lymap marks the bytes taken while a layout is read. nm_lay /
note fn_play: the layout (index + 1) of a layout parameter name / parameter slot, else 0 ----
global ly_name ulong 16
global ly_size ulong 16
global ly_fo ulong 16
global ly_nf ulong 16
global ly_ec ulong 16
global ly_el ulong 16
global nly ulong 1
global lf_name ulong 256
global lf_type uchar 256
global lf_cnt ulong 256
global lf_off ulong 256
global lf_big uchar 256
global nlf ulong 1
global lymap uchar 4096
global nm_lay uchar 1024
global fn_play uchar 3072

note ---- OM-2 section 5 fresh scratch (erratum E8). fn_pfr: 1 for a `fresh` parameter slot. nm_fr: the
note written-set slot (index + 1) a name's elements are tracked in, else 0. fz_n slots in use by the
note function being compiled (16), fz_len their N, fz_cur the elements definitely written on the path
note being compiled (bit i for element i); fz_ent / fz_thn (16 per block): the sets when the block opened
note and at its else. il_fz: fz_n when an inline frame opened. dobx 1: error 14 reports obligation=init ----
global fn_pfr uchar 3072
global nm_fr uchar 1024
global fz_n ulong 1
global fz_len ulong 16
global fz_cur ulong 16
global fz_ent ulong 8192
global fz_thn ulong 8192
global il_fz ulong 8
global dobx ulong 1

note ======== leaf helpers ========

note poolc: the i-th register of the pool x0..x6, x8..x15, x17 (x7 is the runtime, x16 scratch)
fn poolc i ulong to ulong
if lt i 7
ret i
end
if lt i 15
ret add i 1
end
ret 17
end

note ---- error reporting ----
global msg uchar 512
global mc ulong 1

fn mputb b uchar to void
m = get mc 0
put msg m b
put mc 0 add m 1
end

fn mputn v ulong to void
d = new uchar 20 0
i = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0
put d i uchar add rem x 10 48
x = div x 10
i = add i 1
end
j = i
while gt j 0
j = sub j 1
mputb get d j
end
end

note fail: write "omc: line N: error E" to stderr (fd 2) and exit with the code
fn fail code ulong to void
put mc 0 0
mputb 111
mputb 109
mputb 99
mputb 58
mputb 32
mputb 108
mputb 105
mputb 110
mputb 101
mputb 32
mputn add get line 0 get lbase 0
mputb 58
mputb 32
mputb 101
mputb 114
mputb 114
mputb 111
mputb 114
mputb 32
mputn code
mputb 10
w = write 2 msg 0 get mc 0
if ne get om2 0 0
if eq get om2m 0 1
drec code
end
end
exit int code
end

note mputw: the first n bytes (at most 8) of the little-endian packed word w
fn mputw w ulong n ulong to void
i = ulong 0
x = w
while lt i n
mputb uchar and x 255
x = shr x 8
i = add i 1
end
end

note dcol: the 1-based column of byte a in its line
fn dcol a ulong to ulong
j = a
go = true
while go
m = ulong 0
while and go lt m 999999
if eq j 0
go = false
else
if eq get inp sub j 1 10
go = false
else
j = sub j 1
end
end
m = add m 1
end
end
ret add sub a j 1
end

note dsev_w: sev= incomplete when the failure is on the end-of-input token (or inside a text literal cut by
note the end), unknown for an undeclared function or struct, else error
fn dsev_w code ulong to void
s = get dsev 0
if eq s 0
if eq get tk 0 3
s = ulong 1
end
if and eq code 22 ge get cur 0 get inlen 0
s = ulong 1
end
end
if eq s 1
mputw 7308339910638005865 8
mputw 25972 2
ret
end
if eq s 2
mputw 31093567915781749 7
ret
end
mputw 491496043109 5
end

note dexp_w: expect= the class of token being read (end for an open function at the end of the input)
fn dexp_w code ulong to void
e = get dexp 0
if eq code 15
e = ulong 5
end
if or eq code 6 eq code 8
e = ulong 4
end
if eq e 1
mputw 435761734006 5
ret
end
if eq e 2
mputw 1701869940 4
ret
end
if eq e 3
mputw 1701667182 4
ret
end
if eq e 4
mputw 125779768604014 6
ret
end
if eq e 5
mputw 6581861 3
ret
end
if eq e 6
mputw 28550371718161774 7
ret
end
mputw 1685221239 4
end

note dobl_w: obligation= from the code: 27 init, 28 ctor, 29 layout, 21 bounds, 14 growth, 12 regs, else -
fn dobl_w code ulong to void
if eq code 27
mputw 1953066601 4
ret
end
if eq code 28
mputw 1919906915 4
ret
end
if eq code 29
mputw 128047730221420 6
ret
end
if eq code 21
mputw 126875187113826 6
ret
end
if and eq code 14 ne get dobx 0 0
mputw 1953066601 4
ret
end
if eq code 14
mputw 114849429287527 6
ret
end
if eq code 12
mputw 1936156018 4
ret
end
mputb 45
end

note mputh: one byte as two lowercase hex digits
fn mputh b ulong to void
hi = shr b 4
lo = and b 15
if lt hi 10
mputb uchar add hi 48
else
mputb uchar add hi 87
end
if lt lo 10
mputb uchar add lo 48
else
mputb uchar add lo 87
end
end

note drec: the om2 diag machine record after the human line (spec 1): code, sev, line (the human line),
note col, the half-open byte span of the token being read, expect, found (at most 32 bytes, hex),
note obligation, profile
fn drec code ulong to void
put mc 0 0
mputw 7449351137626647919 8
mputw 4424052638528581920 8
mputn code
mputw 263979365152 5
dsev_w code
mputw 67505853393952 6
mputn add get line 0 get lbase 0
a = get tka 0
b = get tkb 0
if le b a
b = a
if gt get cur 0 a
b = get cur 0
end
end
if gt b get inlen 0
b = get inlen 0
end
mputw 263812244256 5
mputn dcol a
mputw 67544290456352 6
mputn add a get sbase 0
mputb 45
mputn add b get sbase 0
mputw 4428273620941825312 8
dexp_w code
mputw 17280399158765088 7
if eq a b
mputb 45
end
i = a
while and lt i b lt sub i a 32
mputh ulong get inp i
i = add i 1
end
mputw 8386097683628191520 8
mputw 1030647657 4
dobl_w code
mputw 7308332183992823840 8
mputw 11210624683837 6
w = write 2 msg 0 get mc 0
end

note emitb / emit: one byte / one 32-bit word (little-endian) to the output; error 14 when it is full
note (om4 EMIT, EMITB: the 8 MiB output area)
fn emitb b uchar to void
o = get oc 0
if ge o 8388608
fail 14
end
put out o b
put oc 0 add o 1
end

fn emit w ulong to void
if ge get oc 0 8388608
fail 14
end
if ne get om2 0 0
if ne get curret 0 0
if ge sub get oc 0 get fstart 0 262144
fail 14
end
end
end
emitb uchar and w 255
emitb uchar and shr w 8 255
emitb uchar and shr w 16 255
emitb uchar and shr w 24 255
end

note tok_num: the word at [ts,cur) is [-]decimal, at most 20 digits, from -2^63 to 2^64 - 1 (error 6
note bad number, 8 out of range). tw = its raw 64 bits (a negative one as two's complement); tbig = 1
note when it is 2^63 or more (only a ulong holds it), else 0. As om4's TK_NUM.
fn tok_num to void
if ne get om2 0 0
if ne tok_hex 0
ret
end
end
p = get ts 0
e = get cur 0
i = p
fl = false
while lt i e
b = get inp i
if or or or eq b 46 eq b 101 eq b 69 eq b 102
fl = true
end
i = add i 1
end
if fl
put tk 0 5
ret
end
minus = false
if eq get inp p 45
minus = true
p = add p 1
end
ndig = sub e p
if eq ndig 0
nfail 6
end
if gt ndig 20
nfail 6
end
v = ulong 0
lim = ulong 1844674407370955161
i = p
while lt i e
d = sub ulong get inp i 48
if gt d 9
nfail 6
end
if gt v lim
nfail 8
end
if and eq v lim gt d 5
nfail 8
end
v = add mul v 10 d
i = add i 1
end
half = shl ulong 1 63
put tbig 0 0
if minus
if gt v half
nfail 8
end
put tw 0 sub ulong 0 v
else
if ge v half
put tbig 0 1
end
put tw 0 v
end
put tk 0 2
end

note tok_text: a text literal starting at the opening quote. tw = first byte offset, tl = source length
note (escapes not yet decoded). Ends at an unescaped '"' on the same line, followed by a blank/end. Err 22.
note (Loops over the input are two loops, the inner under 1000000 passes: om4 has no pass limit.)
fn tok_text to void
put cur 0 add get cur 0 1
put tw 0 get cur 0
go = true
while go
n = ulong 0
while and go lt n 999999
if ge get cur 0 get inlen 0
fail 22
end
b = get inp get cur 0
if eq b 10
fail 22
end
if eq b 34
go = false
else
put cur 0 add get cur 0 1
if eq b 92
if ge get cur 0 get inlen 0
fail 22
end
if eq get inp get cur 0 10
fail 22
end
put cur 0 add get cur 0 1
end
end
n = add n 1
end
end
put tl 0 sub get cur 0 get tw 0
put cur 0 add get cur 0 1
put tk 0 4
if lt get cur 0 get inlen 0
if gt get inp get cur 0 32
fail 22
end
end
end

note tok2: a word at cur with first byte c; packs 8 bytes into tw, sets tl and ts. A '"' is a text; a
note first byte '-' or a digit is a number.
fn tok2 c uchar to void
if eq c 34
tok_text
ret
end
put ts 0 get cur 0
if or eq c 40 eq c 41
put tw 0 ulong c
put tl 0 1
put cur 0 add get cur 0 1
put tk 0 1
ret
end
w = ulong 0
sh = ulong 0
n = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge get cur 0 get inlen 0
go = false
else
b = get inp get cur 0
if le b 32
go = false
else
if or eq b 40 eq b 41
go = false
else
if lt n 8
w = or w shl ulong b sh
sh = add sh 8
end
n = add n 1
put cur 0 add get cur 0 1
end
end
end
m = add m 1
end
end
put tw 0 w
put tl 0 n
f = get inp get ts 0
isnum = false
if eq f 45
isnum = true
end
if and ge f 48 le f 57
isnum = true
end
if isnum
tok_num
else
put tk 0 1
end
end

note tok: next word, skipping blanks (space, tab, carriage return); newline is end of line (kind 0) and
note bumps the line number; another byte below 32 is error 16; the end of the input is kind 3. om4 TOK.
fn tok to void
go = true
while go
n = ulong 0
while and go lt n 999999
if ge get cur 0 get inlen 0
go = false
else
c = get inp get cur 0
if or or eq c 32 eq c 9 eq c 13
put cur 0 add get cur 0 1
else
if eq c 10
put tka 0 get cur 0
put tkb 0 add get cur 0 1
put cur 0 add get cur 0 1
put line 0 add get line 0 1
put tk 0 0
ret
end
put tka 0 get cur 0
put tkb 0 add get cur 0 1
if lt c 32
fail 16
end
put tka 0 get cur 0
put tkb 0 get cur 0
tok2 c
put tkb 0 get cur 0
ret
end
end
n = add n 1
end
end
put tka 0 get inlen 0
put tkb 0 get inlen 0
put tk 0 3
end

