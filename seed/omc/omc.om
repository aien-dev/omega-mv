if eq c 64
fail 15
end
ir_assign get tw 0
ret 0
end

fn ir_fn to void
tok
put ir_ns 0 get ts 0
put ir_nl 0 get tl 0
put ir_nreg 0 0
put ir_nn 0 0
put ir_nc 0 0
put ir_nb 0 0
put ir_nord 0 0
put ir_no 0 0
put ir_nf 0 0
put ir_dead 0 0
go = true
while go
tok
if eq kw get tw 0 65
go = false
else
w = get tw 0
tok
r = ir_newreg kw get tw 0
ir_bind w r
end
end
tok
put ir_ret 0 kw get tw 0
put ir_npar 0 get ir_nreg 0
b = ir_block
ir_start b
ir_push 4 0 0 0 0
put ir_have 0 0
while eq get ir_have 0 0
ignored = ir_stmt
end
end

fn ir_run to void
go = true
while go
tok
k = get tk 0
if eq k 3
go = false
else
if eq k 0
else
if ne k 1
fail 16
end
c = kw get tw 0
if eq c 64
ir_fn
else
if eq c 83
skipnl
else
if or or eq c 85 eq c 78 eq c 79
fail 9
end
fail 16
end
end
end
end
end
ir_encode
n = write 1 out 0 get oc 0
exit 0
end

note main: read all of stdin
note (8 MiB at most, error 14; a read error is 1), find the mode, then one
note statement per line from output byte 180 (om4 START .. STMT)
fn main to int
off = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge off len inp
fail 14
end
n = read 0 inp off sub len inp off
if eq n 0
go = false
else
if lt n 0
fail 1
end
off = add off ulong n
end
m = add m 1
end
end
put inlen 0 off
if ne ir_lead 0
put irmode 0 1
ir_run
end
prescan
namescan
put oc 0 180
put line 0 1
done = false
while not done
m = ulong 0
while and not done lt m 999999
if ne stmt 0
done = true
end
m = add m 1
end
end
ret 0
end
