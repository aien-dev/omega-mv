t = alloc
e3 2604694528 t ra rb
bo_w3 2600500224 rd ra rb 0
e3 3951098911 0 t rd
trapc 1 1
ret
end
if eq ty 4
bo_w3 453016576 rd ra rb 0
ret
end
bo_w3 2600500224 rd ra rb 0
bo_fix rd ty
end

note div, rem (om4 BO_DIV, BO_SDIV): CBZ Xb trap 2 unless fl bit 1 (b a number other than 0); UDIV or
note SDIV; rem: t = a / b, rd = a - t * b (MSUB); i64 div: CMN Xb, #1; B.NE +3; NEGS XZR, Xa; B.VS trap 1,
note unless fl bit 2 (b a number other than -1)
fn bo_div op ulong ty ulong ra ulong rb ulong rd ulong fl ulong to void
if eq and fl 1 0
trapsite or 3019898880 rb 2
end
if eq op 37
t = alloc
if ge ty 6
e3 2596277248 t ra rb
else
e3 2596276224 t ra rb
end
e3 or 2600501248 shl ra 10 rd t rb
ret
end
if lt ty 6
bo_w3 2596276224 rd ra rb 0
ret
end
if eq ty 9
if eq and fl 2 0
emit or 2969568287 shl rb 5
emit 1409286241
emit or 3942646783 shl ra 16
trapc 6 1
end
end
bo_w3 2596277248 rd ra rb 0
if ne ty 9
bo_fix rd ty
end
end

note and, or, xor (om4 BO_LOG)
fn bo_log op ulong ra ulong rb ulong rd ulong to void
fx = ulong 2315255808
if eq op 39
fx = ulong 2852126720
end
if eq op 40
fx = ulong 3388997632
end
bo_w3 fx rd ra rb 0
end

note bo_lsl: LSL Xd, Xn, #s as UBFM Xd, Xn, #(64-s) mod 64, #63-s
fn bo_lsl ra ulong s ulong rd ulong to void
r = shl and sub 64 s 63 16
r = or r shl sub 63 s 10
r = or r shl ra 5
emit or or 3544186880 r rd
end

note shl (om4 BO_SHL, BS_64): by a number s: UBFM Xd, Xn, #(64-s) mod 64, #63-s; by a register: the amount
note check, LSLV; i64: t = a << s, X16 = t >> s arithmetic, CMP X16, Xa, B.NE trap 1, MOV Xd, Xt
fn bo_shl ty ulong ra ulong rb ulong imm ulong rd ulong to void
if eq ty 9
t = alloc
if ne imm 0
bo_lsl ra rb t
emit or or 2470509584 shl rb 16 shl t 5
else
bo_schk ty rb
e3 2596282368 t ra rb
e3 2596284432 0 t rb
end
emit or 3942646303 shl ra 16
trapc 1 1
emit or or 2852127712 rd shl t 16
ret
end
if ne imm 0
bo_lsl ra rb rd
bo_fix rd ty
ret
end
bo_schk ty rb
if eq ty 4
bo_w3 448798720 rd ra rb 0
ret
end
bo_w3 2596282368 rd ra rb 0
bo_fix rd ty
end

note shr: unsigned LSR, signed ASR; by a number UBFM / SBFM Xd, Xn, #s, #63; by a register the amount check
note then LSRV / ASRV (om4 BO_SHR)
fn bo_shr ty ulong ra ulong rb ulong imm ulong rd ulong to void
if ne imm 0
fi = ulong 3544251392
if ge ty 6
fi = ulong 2470509568
end
emit or or or fi shl rb 16 shl ra 5 rd
ret
end
bo_schk ty rb
fx = ulong 2596283392
if ge ty 6
fx = ulong 2596284416
end
bo_w3 fx rd ra rb 0
end

note comparisons: CMP Xa, #imm or CMP Xa, Xb; the result is the flags and a condition (om4 BO_CMP)
fn bo_cmp op ulong ty ulong ra ulong rb ulong imm ulong to void
if ne imm 0
emit or or 4043309087 shl rb 10 shl ra 5
else
emit or or 3942645791 shl rb 16 shl ra 5
end
i = mul sub op 43 2
if ge ty 6
i = add i 1
end
put rk 0 4
put rv 0 conds i
put rt 0 1
end

note binop: op 33..48, destination (255 none), ix the fr slot of a (kind, number/register, type) then b.
note Result in rk/rv/rt. om4 BINOP.
fn binop op ulong dst ulong ix ulong to void
ty = get fr add ix 2
ra = matreg get fr ix get fr add ix 1 ty
imm = ulong 0
bk = get fr add ix 3
bn = get fr add ix 4
rb = ulong 0
useimm = false
if eq bk 3
if or eq op 41 eq op 42
if lt bn twid ty
useimm = true
end
else
if or lt op 35 ge op 43
if le bn 4095
useimm = true
end
end
end
end
if useimm
rb = bn
imm = ulong 1
else
rb = matreg bk bn get fr add ix 5
end
if ge op 43
bo_cmp op ty ra rb imm
ret
end
if eq ty 1
if gt sub op 38 2
fail 7
end
end
rd = destreg dst
if lt op 35
bo_add op ty ra rb imm rd
else
if eq op 35
bo_mul ty ra rb rd
else
if lt op 38
fl = ulong 0
if and eq bk 3 ne bn 0
fl = or fl 1
end
if and eq bk 3 ne bn 18446744073709551615
fl = or fl 2
end
bo_div op ty ra rb rd fl
else
if lt op 41
bo_log op ra rb rd
else
if eq op 41
bo_shl ty ra rb imm rd
else
bo_shr ty ra rb imm rd
end
end
end
end
end
put rk 0 1
put rv 0 rd
put rt 0 ty
end

note ======== calls: registers saved around a call and loaded back ========
global svn ulong 1
global sva ulong 1
note save: n = registers in use (parameters + pool slots), A = 8 (n + 1) rounded up to 16: SUB SP, SP, #A
note (C6.2.457); the stack check; STR Xr, [SP, #8j] for each (C6.2.415); STR X30, [SP, #8n]. Out: svn n,
note sva A. om4 SAVE.
fn save to void
n = add get npar 0 get nslot 0
a = shl shr add n 2 1 4
put svn 0 n
put sva 0 a
spsub a
stkchk
j = ulong 0
while lt j n
emit or or 4177527776 poolc j shl j 10
j = add j 1
end
emit or 4177527806 shl n 10
end

note loadarg: register t from an argument: kind 1 or 5 a register v, read back from its save slot (LDR Xt,
note [SP, #8 slot], C6.2.216); kind 3 or 6 the number or address v. om4 LOADARG.
fn loadarg t ulong k ulong v ulong to void
if or eq k 3 eq k 6
matconst t v
ret
end
emit or or 4181722080 t shl regidx v 10
end

note basearg: register t = the base of array name e (index + 1): its register from the save area, or its
note address. om4 BASEARG.
fn basearg t ulong e ulong to void
i = sub e 1
if ge get nm_kind i 4
matconst t get nm_addr i
ret
end
loadarg t 1 ulong get nm_reg i
end

note restore: d destination (255: a new temporary at pool slot `slot`), slot the pool slot before the
note arguments, n saved count, a save bytes, res 1 if there is a result in X0. MOV Xd, X0 (C6.2.282); LDR
note each register in use before the arguments except Xd (C6.2.216); LDR X30; ADD SP, SP, #A (C6.2.5).
note Returns Xd (255 when no result). om4 RESTORE.
fn restore d ulong slot ulong n ulong a ulong res ulong to ulong
put nslot 0 slot
rd = ulong 255
if ne res 0
rd = d
if eq d 255
rd = alloc
end
if ne rd 0
emit or 2852127712 rd
end
end
m = add get npar 0 slot
j = ulong 0
while lt j m
r = poolc j
if ne r rd
emit or or 4181722080 r shl j 10
end
j = add j 1
end
emit or 4181722110 shl n 10
spadd a
ret rd
end

note ca_bl: BL to function f (index + 1), C6.2.43
fn ca_bl f ulong to void
n = get ncalls 0
if ge n 65536
fail 14
end
put callsite n get oc 0
put callfrom n get curfn 0
put callto n f
put ncalls 0 add n 1

emit or 2483027968 and shr sub get fn_addr sub f 1 get oc 0 2 67108863
end

note ======== element addresses and array arguments ========
global ea_b ulong 1
global ea_i ulong 1
note elemaddr: array name e (index + 1), index value (kind, number or register, type). A number index must
note be inside the array (error 21) and needs no check; a register index: CMP Xi, #len (C6.2.96) or CMP Xi,
note Xt (C6.2.97), B.HS trap 3 (unsigned, so a negative signed index traps too). Out: ea_b base register
note (the array's register, or a new one holding its address), ea_i index register. om4 ELEMADDR.
fn elemaddr e ulong k ulong v ulong t ulong to void
if eq t 1
fail 7
end
i = sub e 1
ln = get nm_len i
x = v
if eq k 3
if ge v ln
fail 21
end
x = alloc
matconst x v
else
if le ln 4095
emit or or 4043309087 shl ln 10 shl v 5
else
y = alloc
matconst y ln
emit or or 3942645791 shl y 16 shl v 5
end
trapc 2 3
end
put ea_i 0 x
if ge get nm_kind i 4
b = alloc
matconst b get nm_addr i
put ea_b 0 b
else
put ea_b 0 ulong get nm_reg i
end
end

note aa_word: the next word of an array argument must be a name of at most 8 bytes
fn aa_word to void
tok
k = get tk 0
if eq k 0
fail 4
end
if ne k 1
fail 16
end
if gt get tl 0 8
fail 13
end
end

note arrarg: an array argument for parameter pi of function f (index + 1): [view | edit] NAME. Its type and
note length must equal the parameter's; an edit parameter needs a writable array (local or edit, error 20;
note a view passed to it is error 20, OMEGESE.md 9.4); a global is never passed (error 19). Out: rk 5
note (register rv) or 6 (address rv, a text), rt the name entry. om4 ARRARG.
fn arrarg f ulong pi ulong to void
md = ulong 0
aa_word
w = get tw 0
c = kw w
if ne c 0
if or lt c 57 gt c 58
fail 16
end
md = c
aa_word
w = get tw 0
end
e = findname w
if eq e 0
fail 3
end
i = sub e 1
k = ulong get nm_kind i
if eq k 0
fail 7
end
if eq k 4
fail 19
end
p = add mul sub f 1 6 pi
if eq get fn_pk p 3
if eq md 57
fail 20
end
if and ne k 1 ne k 3
fail 20
end
else
if eq md 58
fail 7
end
end
if ne get nm_type i get fn_pt p
fail 7
end
if ne get nm_len i get fn_pl p
fail 7
end
put rt 0 e
if eq k 5
put rk 0 6
put rv 0 get nm_addr i
else
put rk 0 5
put rv 0 ulong get nm_reg i
end
end

note ======== the parts of the value reader that read no further value ========
fn vdec to void
put depth 0 sub get depth 0 1
end

note vdone: a value's result, and one nesting level less (om4 VT_RET)
fn vdone k ulong v ulong t ulong to void
put rk 0 k
put rv 0 v
put rt 0 t
vdec
end

note vt_un: neg / not of the value in rk/rv/rt (a bare number already refused). neg: NEG Xd, Xm (SUB from
note XZR, C6.2.458; the 32-bit form for u32), i64 NEGS + B.VS trap 1 (C6.2.465), then the wrap or the
note sign check; not: bool EOR Xd, Xn, #1 (C6.2.155), else MVN (ORN from XZR, C6.2.300), then the wrap.
note om4 VU1 .. VU_E.
fn vt_un c ulong dst ulong to void
ty = get rt 0
ra = matreg get rk 0 get rv 0 ty
rd = destreg dst
if eq c 50
if eq ty 1
e3 3527409664 rd ra 0
else
if eq ty 4
e3 706741216 rd 0 ra
else
e3 2854224864 rd 0 ra
if lt ty 6
canon rd ty
end
end
end
else
if eq ty 1
fail 7
end
if eq ty 9
e3 3942646752 rd 0 ra
trapc 6 1
else
if eq ty 4
e3 1258292192 rd 0 ra
else
e3 3405775840 rd 0 ra
if lt ty 6
canon rd ty
else
chkext rd ty 1
end
end
end
end
put rk 0 1
put rv 0 rd
put rt 0 ty
end

note vt_conv: the value in rk/rv/rt converted to type tt (neither bool, error 9). Out of range when any bit
note at or above s is set: LSR Xt, Xa, #s (UBFM, C6.2.487); CBNZ Xt trap 5 (C6.2.77); signed to a narrower
note signed type: the sign-extension check, trap 5. om4 VTT1 .. VC_OK.
fn vt_conv tt ulong to void
ft = get rt 0
ra = matreg get rk 0 get rv 0 ft
if eq ft 1
fail 9
end
if eq tt 1
fail 9
end
wf = twid ft
wt = twid tt
s = ulong 99
if lt ft 6
if ge tt 6
if ge wf wt
s = sub wt 1
end
else
if gt wf wt
s = wt
end
end
else
if lt tt 6
s = wt
if gt s 63
s = ulong 63
end
else
if gt wf wt
chkext ra tt 5
end
end
end
if ne s 99
t = alloc
emit or or or 3544251392 t shl s 16 shl ra 5
trapsite or 3036676096 t 5
end
put rk 0 1
put rv 0 ra
put rt 0 tt
end

note vt_get: get A i with the index value in rk/rv/rt: the element address, then the load of the element
note type, register offset (LDOP table). om4 VT_GET.
fn vt_get e ulong dst ulong to void
elemaddr e get rk 0 get rv 0 get rt 0
rd = destreg dst
ty = ulong get nm_type sub e 1
w = or ldop ty rd
emit or or w shl get ea_b 0 5 shl get ea_i 0 16
put rk 0 1
put rv 0 rd
put rt 0 ty
end

note vs_chk: read / write bounds: n <= len A and off <= len A - n, else trap 3 (CMP C6.2.97, B.HI C6.2.34,
note SUB C6.2.458). om4 VT_SYS.
fn vs_chk e ulong ro ulong rn ulong to void
t = alloc
matconst t get nm_len sub e 1
emit or or 3942645791 shl rn 5 shl t 16
trapc 8 3
e3 3405774848 t t rn
emit or or 3942645791 shl ro 5 shl t 16
trapc 8 3
end

note vs_call: save the registers in use, X0 = fd, X1 = A + off (ADD through X16, C6.2.6), X2 = n, X8 = 63
note (read) or 64 (write) (MOVZ C6.2.285), SVC #0 (C6.2.466). om4 VT_SYS.
