if ne get dead 0 0
fail 17
end
if eq c 0
s_name w
ret 0
end
if eq c 67
s_if
ret 0
end
if eq c 69
s_while
ret 0
end
if eq c 71
s_for
ret 0
end
if eq c 72
s_ret
ret 0
