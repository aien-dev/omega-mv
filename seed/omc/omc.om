note ir_lead: 1 when the first line is "ir" (after blanks). Both scans run as nested 999999-pass loops,
note so more than 1000000 leading blanks or first-line bytes are read, not trapped 4 (#671).
fn ir_lead to ulong
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p get inlen 0
go = false
else
c = get inp p
if gt c 32
go = false
else
if eq c 10
ret 0
end
p = add p 1
end
end
m = add m 1
end
end
if ge add p 3 get inlen 0
ret 0
end
if ne get inp p 105
ret 0
end
if ne get inp add p 1 114
ret 0
end
if gt get inp add p 2 32
ret 0
end
q = add p 2
go = true
while go
m = ulong 0
while and go lt m 999999
if ge q get inlen 0
go = false
else
if eq get inp q 10
go = false
else
q = add q 1
end
end
m = add m 1
end
end
if lt q get inlen 0
q = add q 1
end
put cur 0 q
put line 0 2
ret 1
end

