; atlas.s2 -- the Atlas boot image (CONTRACT-QEMU-VIRT-AARCH64-M1), written in asm2's language from
; ~/workspace/atlas/atlas.s and sha256_clean.s, line for line, and built by asm2 (no GNU as, no ld):
;   cat seed/rung2/table.s2 seed/rung3/table3.s2 seed/atlas/table5.s2 seed/atlas/atlas.s2 | asm2.bin
; The output is the flat image itself: byte 0 is the first instruction (flash base 0). The layout the
; linker made is written here by hand: atlas.o's text at 0 (code, messages, digest, literal pool, padded
; to 64), sha256_clean's text from 0x180 (each function aligned as its .p2align asks, padding = NOP),
; then 4 zero bytes and the K table (.rodata, aligned to 8) at 0x4c8. Total 1480 bytes.
; ---- 0x000 _start ----
:_start
  msr.daifset 15                ; msr daifset, #0xf
  ldr.x.lit x0 L_401fc000
  add.x.i sp x0 0               ; mov sp, x0 (MOV to SP = ADD #0, C6.2.278)
  ldr.x.lit x20 L_09000000
  adr x21 msg_awaken
  bl print_string
  ldr.x.lit x22 L_401fe000
  ldr.x.lit x0 L_40000000
  str.x x0 x22 0
  ldr.x.lit x0 L_08000000
  str.x x0 x22 1
  mov.x x0 x20
  str.x x0 x22 2
  ldr.x.lit x0 L_40200000
  str.x x0 x22 3
  movz.x x0 256 0
  str.x x0 x22 4
  adr x21 msg_verify
  bl print_string
  ldr.x.lit x0 L_40200000
  ldr.x.lit x1 L_401fe100
  ldr.x.lit x2 L_401fe080
  bl sha256_256bytes
  ldr.x.lit x2 L_401fe080
  adr x3 pinned_digest
  ldp.x x4 x5 x2 0
  ldp.x x6 x7 x3 0
  cmp.x x4 x6
  b.ne refuse_handoff
  cmp.x x5 x7
  b.ne refuse_handoff
  ldp.x x4 x5 x2 2
  ldp.x x6 x7 x3 2
  cmp.x x4 x6
  b.ne refuse_handoff
  cmp.x x5 x7
  b.ne refuse_handoff
  adr x21 msg_handoff
  bl print_string
  mov.x x0 x22
  movz.x x1 256 0
  ldr.x.lit x2 L_cookie
  ldr.x.lit x19 L_40200000
  br x19
  b quiescent_halt
:refuse_handoff
  adr x21 msg_refuse
  bl print_string
:quiescent_halt
  wfe
  b quiescent_halt
; ---- 0x0c4 print_string ----
:print_string
  ldrb.post w0 x21 1
  cbz.w w0 print_ret
  str.w w0 x20 0
  b print_string
:print_ret
  ret
; ---- 0x0d8 messages ----
:msg_awaken
  .b 0x41
  .b 0x54
  .b 0x4c
  .b 0x41
  .b 0x53
  .b 0x3a
  .b 0x20
  .b 0x41
  .b 0x57
  .b 0x41
  .b 0x4b
  .b 0x45
  .b 0x4e
  .b 0x0a
  .b 0
:msg_verify
; "ATLAS: VERIFY\n"
  .b 0x41
  .b 0x54
  .b 0x4c
  .b 0x41
  .b 0x53
  .b 0x3a
  .b 0x20
  .b 0x56
  .b 0x45
  .b 0x52
  .b 0x49
  .b 0x46
  .b 0x59
  .b 0x0a
  .b 0
:msg_handoff
; "ATLAS: HANDOFF\n"
  .b 0x41
  .b 0x54
  .b 0x4c
  .b 0x41
  .b 0x53
  .b 0x3a
  .b 0x20
  .b 0x48
  .b 0x41
  .b 0x4e
  .b 0x44
  .b 0x4f
  .b 0x46
  .b 0x46
  .b 0x0a
  .b 0
:msg_refuse
; "ATLAS: REFUSE\n"
  .b 0x41
  .b 0x54
  .b 0x4c
  .b 0x41
  .b 0x53
  .b 0x3a
  .b 0x20
  .b 0x52
  .b 0x45
  .b 0x46
  .b 0x55
  .b 0x53
  .b 0x45
  .b 0x0a
  .b 0
; ---- 0x115: align 8 ----
  .b 0
  .b 0
  .b 0
; ---- 0x118 pinned digest ----
:pinned_digest
  .w 0xe1d89bb1
  .w 0xe0854eba
  .w 0xccd2be5c
  .w 0x756c8a2f
  .w 0xf8c5ecc8
  .w 0xc0f90b4a
  .w 0xbd461fb7
  .w 0xbf98374c
; ---- 0x138 literal pool (.ltorg): each value once, in order of first use ----
:L_401fc000
  .w 0x401fc000
  .w 0x00000000 ; 0x401FC000
:L_09000000
  .w 0x09000000
  .w 0x00000000 ; 0x09000000
:L_401fe000
  .w 0x401fe000
  .w 0x00000000 ; 0x401FE000
:L_40000000
  .w 0x40000000
  .w 0x00000000 ; 0x40000000
:L_08000000
  .w 0x08000000
  .w 0x00000000 ; 0x08000000
:L_40200000
  .w 0x40200000
  .w 0x00000000 ; 0x40200000
:L_401fe100
  .w 0x401fe100
  .w 0x00000000 ; 0x401FE100
:L_401fe080
  .w 0x401fe080
  .w 0x00000000 ; 0x401FE080
:L_cookie
  .w 0x49435330
  .w 0x50485953 ; 0x5048595349435330
; ---- 0x180 sha256_transform ----
:sha256_transform
  stp.x.pre x29 x30 sp -40      ; stp x29, x30, [sp, -320]!
  sub.x.i x4 x1 4
  movz.x x1 1 0
  add.x.i x29 sp 0
  add.x.i x12 sp 64
  stp.x x19 x20 sp 2
  stp.x x21 x22 sp 4
  stp.x x23 x24 sp 6
:T_L2
  add.x.lsl x3 x12 x1 2
  ldr.w.r w2 x4 x1
  add.x.i x1 x1 1
  rev.w w2 w2
  stur.w w2 x3 -4
  cmp.x.i x1 17
  b.ne T_L2
  ldr.w w5 sp 16
  add.x.i x4 sp 68
  ldp.w w13 w11 sp 25
  add.x.i x15 sp 260
  ldp.w w10 w9 sp 27
  ldp.w w8 w3 sp 29
  ldr.w w7 sp 31
:T_L3
  add.w w6 w5 w13
  ldr.w w5 x4 0
  mov.w w13 w11
  extr.w w2 w3 w3 19
  eor.w.ror w2 w2 w3 17
  mov.w w11 w10
  eor.w.lsr w2 w2 w3 10
  extr.w w1 w5 w5 18
  eor.w.ror w1 w1 w5 7
  mov.w w10 w9
  eor.w.lsr w1 w1 w5 3
  mov.w w9 w8
  add.w w1 w1 w2
  mov.w w8 w3
  add.x.i x4 x4 4
  mov.w w3 w7
  add.w w7 w1 w6
  str.w w7 x4 14
  cmp.x x4 x15
  b.ne T_L3
  ldp.w w20 w19 x0 0
  adrp x13 0 0                  ; K is at 0x4c8, in the same 4 KiB page as this word: page distance 0
  ldp.w w30 w18 x0 2
  add.x.i x13 x13 0x4c8         ; :lo12: of K = 0x4c8
  ldp.w w17 w16 x0 4
  mov.w w5 w20
  ldp.w w15 w14 x0 6
  mov.w w8 w19
  mov.w w6 w30
  mov.w w11 w18
  mov.w w4 w17
  mov.w w10 w16
  mov.w w9 w15
  mov.w w21 w14
  movz.x x7 1 0
  b T_L4
:T_L5
  mov.w w9 w10
  mov.w w6 w8
  mov.w w10 w4
  mov.w w8 w5
  mov.w w4 w3
  mov.w w5 w2
:T_L4
  ubfm.x x1 x7 62 61            ; lsl x1, x7, 2
  extr.w w22 w4 w4 6
  add.x x23 x13 x1
  add.x x1 x12 x1
  and.w w3 w4 w10
  eor.w.ror w22 w22 w4 11
  bic.w w2 w9 w4
  eor.w.ror w22 w22 w4 25
  ldur.w w24 x1 -4
  eor.w w2 w2 w3
  ldur.w w23 x23 -4
  eor.w w3 w8 w6
  add.w w2 w22 w2
  extr.w w1 w5 w5 13
  and.w w3 w3 w5
  and.w w22 w8 w6
  eor.w.ror w1 w1 w5 2
  add.w w23 w23 w24
  eor.w w3 w3 w22
  eor.w.ror w1 w1 w5 22
  add.w w2 w2 w23
  add.w w1 w1 w3
  add.w w2 w2 w21
  add.x.i x7 x7 1
  add.w w3 w2 w11
  mov.w w21 w9
  add.w w2 w2 w1
  mov.w w11 w6
  cmp.x.i x7 65
  b.ne T_L5
  add.w w20 w20 w2
  add.w w19 w19 w5
  add.w w30 w30 w8
  add.w w18 w18 w6
  add.w w17 w17 w3
  add.w w16 w16 w4
  add.w w15 w15 w10
  add.w w14 w14 w9
  stp.w w20 w19 x0 0
  stp.w w30 w18 x0 2
  stp.w w17 w16 x0 4
  stp.w w15 w14 x0 6
  ldp.x x19 x20 sp 2
  ldp.x x21 x22 sp 4
  ldp.x x23 x24 sp 6
  ldp.x.post x29 x30 sp 40
  ret
  nop                           ; .p2align 4,,11: 0x33c -> 0x340
; ---- 0x340 sha256_compute ----
:sha256_compute
  stp.x.pre x29 x30 sp -8
  movz.x x5 58983 0
  movz.x x4 62322 0
  add.x.i x29 sp 0
  stp.x x21 x22 sp 4
  mov.x x22 x3
  movz.x x3 21119 0
  str.x x23 sp 6
  mov.x x23 x1
  movz.x x1 55723 0
  movk.x x5 0x6a09 1
  movk.x x4 0x3c6e 1
  movk.x x3 0x510e 1
  movk.x x1 0x1f83 1
  movk.x x5 0xae85 2
  movk.x x4 0xf53a 2
  movk.x x3 0x688c 2
  movk.x x1 0xcd19 2
  stp.x x19 x20 sp 2
  movk.x x5 0xbb67 3
  movk.x x4 0xa54f 3
  movk.x x3 0x9b05 3
  movk.x x1 0x5be0 3
  stp.x x5 x4 x22 0
  mov.x x19 x0
  stp.x x3 x1 x22 2
  mov.x x21 x2
  cmp.x.i x23 63
  b.ls C_L21
  sub.x.i x20 x23 64
  and.x.bm x20 x20 1 58 57      ; and x20, x20, -64: N 1, 58 ones (imms 57) rotated right by 58
  add.x.i x20 x20 64
  add.x x20 x0 x20
  nop                           ; .p2align 3,,7: 0x3c4 -> 0x3c8
:C_L12
  mov.x x1 x19
  mov.x x0 x22
  add.x.i x19 x19 64
  bl sha256_transform
  cmp.x x19 x20
  b.ne C_L12
  and.x.bm x2 x23 1 0 5         ; and x2, x23, 63: N 1, 6 ones (imms 5), no rotation
:C_L11
  mov.x x0 x21
  add.x.i x4 x21 128
  nop                           ; .p2align 3,,7: 0x3ec -> 0x3f0
:C_L13
  strb.post wzr x0 1
  cmp.x x0 x4
  b.ne C_L13
  cbz.x x2 C_L14
  movz.x x0 0 0
  nop                           ; .p2align 3,,7: 0x404 -> 0x408
:C_L15
  ldrb.r w1 x20 x0
  strb.r w1 x21 x0
  add.x.i x0 x0 1
  cmp.x x0 x2
  b.ne C_L15
  movn.w w1 127 0               ; mov w1, -128
  strb.r w1 x21 x0
  movz.w w19 2 0
  movz.w w1 120 0
  cmp.x.i x0 55
  b.ls C_L17
:C_L18
  ubfm.x x23 x23 61 60          ; lsl x23, x23, 3
  add.x.uxtw x1 x21 w1
  movz.w w0 56 0
:C_L19
  lsrv.x x2 x23 x0
  sub.w.i w0 w0 8
  strb.post w2 x1 1
  cmn.w.i w0 8
  b.ne C_L19
  mov.x x0 x22
  mov.x x1 x21
  bl sha256_transform
  cmp.w.i w19 2
  b.eq C_L29
  ldp.x x19 x20 sp 2
  ldp.x x21 x22 sp 4
  ldr.x x23 sp 6
  ldp.x.post x29 x30 sp 8
  ret
:C_L14
  movn.w w0 127 0               ; mov w0, -128
  strb w0 x21 0
:C_L17
  movz.w w1 56 0
  movz.w w19 1 0
  b C_L18
:C_L29
  ldp.x x19 x20 sp 2
  add.x.i x1 x21 64
  ldp.x x21 x22 sp 4
  ldr.x x23 sp 6
  ldp.x.post x29 x30 sp 8
  b sha256_transform
:C_L21
  mov.x x20 x0
  mov.x x2 x23
  b C_L11
; ---- 0x4b4 sha256_256bytes (.p2align 4,,11 would need 12 bytes, more than 11: no padding) ----
:sha256_256bytes
  mov.x x3 x2
  mov.x x2 x1
  movz.x x1 256 0
  b sha256_compute
; ---- 0x4c4: 4 zero bytes, then .rodata (align 8) at 0x4c8: K ----
  .w 0
