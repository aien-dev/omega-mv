ret add base i
end
end
ret 16384
end

fn df_name w ulong to void
o = get gwo w
for i ulong get gwl w
ob_byte get gwb add o i
end
end

fn df_line t view uchar * w ulong to void
ob_str t
df_name w
ob_byte 10
