note Kahn order over the call graph: a fn is hashed once all its callees are
fn hs_dag to void
nf = get gfnn 0
qh = ulong 0
qt = ulong 0
for f ulong nf
if eq get gfo f 0
put gq qt f
qt = add qt 1
end
end
for a ulong 8192
if ge qh qt
break
end
g = get gq qh
qh = add qh 1
hs_one g
qt = hs_rel g qt
end
end

fn hs_rel g ulong qt ulong to ulong
o = get gfrs g
n = qt
for i ulong get gfrn g
c = get gre add o i
d = sub get gfo c 1
put gfo c d
if eq d 0
put gq n c
n = add n 1
end
end
ret n
end

note reachability from r among unhashed fns; dir 0 callees into gm1, 1 callers into gm2
fn sc_reach r ulong dir ulong to void
st = add r 1
qh = ulong 0
qt = ulong 1
put gq 0 r
sc_mark r dir st
for a ulong 8192
if ge qh qt
break
end
f = get gq qh
qh = add qh 1
qt = sc_step f dir st qt
end
end

fn sc_mark f ulong dir ulong st ulong to void
if eq dir 0
put gm1 f st
else
put gm2 f st
end
end

fn sc_seen f ulong dir ulong st ulong to bool
if eq dir 0
ret eq get gm1 f st
end
ret eq get gm2 f st
end

fn sc_step f ulong dir ulong st ulong qt ulong to ulong
n = qt
o = get gfcs f
c = get gfcn f
if eq dir 1
o = get gfrs f
c = get gfrn f
end
for i ulong c
g = sc_nb o i dir
if eq get gfk g 0
if not sc_seen g dir st
sc_mark g dir st
put gq n g
n = add n 1
end
end
end
ret n
end

fn sc_nb o ulong i ulong dir ulong to ulong
if eq dir 0
ret get gce add o i
end
ret get gre add o i
end

fn sc_all to void
nf = get gfnn 0
for r ulong nf
if and eq get gfk r 0 eq get gfc r 0
sc_one r
end
end
end

fn sc_one r ulong to void
sc_reach r 0
sc_reach r 1
st = add r 1
nf = get gfnn 0
z = ulong 0
for f ulong nf
if and eq get gm1 f st eq get gm2 f st
put gfc f st
z = add z 1
end
end
put gfz r z
end

fn sc_ready r ulong to bool
st = add r 1
nf = get gfnn 0
for f ulong nf
if eq get gfc f st
if not sc_fnok f st
ret false
end
end
end
ret true
end

fn sc_fnok f ulong st ulong to bool
o = get gfcs f
for i ulong get gfcn f
g = get gce add o i
if ne get gfc g st
if eq get gfk g 0
ret false
end
end
end
ret true
end

fn sc_hash r ulong to void
if eq get gfz r 1
