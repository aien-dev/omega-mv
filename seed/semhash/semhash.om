fn df_left a ulong to ulong
j = df_find a 1
if ne j 16384
put gwm j 1
if df_heq a j
df_line tsame a
ret 0
end
df_line tchg a
ret 1
end
for i ulong get gwc 1
j = add 8192 i
if eq get gwm j 0
if df_heq a j
if eq df_find j 0 16384
put gwm j 1
ob_str tren
df_name a
ob_str tarr
df_name j
ob_byte 10
ret 1
end
end
end
end
df_line trem a
ret 1
end

fn df_main sd ulong to bool
base = mul sd 8192
for i ulong get gwc sd
if df_ismain add base i
ret true
end
end
ret false
end

fn df_ismain w ulong to bool
s = get gsp 8
if ne get gwl w get gsl s
ret false
end
o = get gwo w
q = get gso s
for i ulong get gwl w
u = get gwb add o i
if ne u get gsb add q i
ret false
end
end
ret true
end

fn df_nexp sd ulong k ulong to ulong
base = mul sd 8192
for i ulong get gwc sd
w = add base i
if ne get gwx w 0
if eq k 0
ret w
end
k = sub k 1
end
end
ret 16384
end

fn df_exports to ulong
for k ulong 8193
a = df_nexp 0 k
b = df_nexp 1 k
if and eq a 16384 eq b 16384
ret 0
end
if or eq a 16384 eq b 16384
ob_str texp
ret 1
end
if not df_neq a b
ob_str texp
ret 1
end
end
ret 0
end

fn df_entry to ulong
if or df_main 0 df_main 1
ret 0
end
if or ne df_nexp 0 0 16384 ne df_nexp 1 0 16384
ret 0
end
na = get gwc 0
nb = get gwc 1
if or eq na 0 eq nb 0
ret 0
end
a = sub na 1
b = add 8192 sub nb 1
if df_neq a b
ret 0
end
ob_str tent
df_name a
ob_str tarr
df_name b
ob_byte 10
ret 1
end

fn md_diff to int
put gwp 0 0
for sd ulong 2
if gt sd 0
st_reset
end
in_file add sd 2
hp_run
df_save sd
end
nd = ulong 0
for i ulong get gwc 0
nd = add nd df_left i
end
for j ulong get gwc 1
w = add 8192 j
if eq get gwm w 0
df_line tadd w
nd = add nd 1
end
end
nd = add nd df_exports
nd = add nd df_entry
if eq nd 0
ob_str tdsame
ret 0
end
ob_str tdchg
ob_dec nd
ob_byte 10
ret 1
end

fn ar_eq a view uchar * n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n
if ne get a i get t i
ret false
end
end
ret true
end

fn main to int
st_reset
c = argcnt
if lt c 2
in_stdin
md_hash
ob_flush
ret 0
end
pb = new uchar 64 0
r = argread 1 pb 0 64
if le r 0
die_msg eusage 2
end
n = ulong r
if and ar_eq pb n mdiff eq c 4
x = md_diff
ob_flush
ret x
end
if ne c 2
die_msg eusage 2
end
if ar_eq pb n mhash
in_stdin
md_hash
ob_flush
ret 0
end
if ar_eq pb n mcanon
in_stdin
md_canon
ob_flush
ret 0
end
if ar_eq pb n mkw
ob_str tkw1
ob_str tkw2
ob_flush
ret 0
end
die_msg eusage 2
ret 2
end
