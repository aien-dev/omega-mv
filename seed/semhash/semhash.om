o = get gso s
for i ulong n
put gwb add p i get gsb add o i
end
put gwo w p
put gwl w n
put gwp 0 add p n
put gwm w 0
put gwx w get gfx f
x = mul w 32
y = mul f 32
for j ulong 32
put gwh add x j get gfh add y j
end
end

fn df_neq a ulong b ulong to bool
n = get gwl a
if ne n get gwl b
ret false
end
x = get gwo a
y = get gwo b
for i ulong n
if ne get gwb add x i get gwb add y i
