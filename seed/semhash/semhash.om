st = add r 1
nf = get gfnn 0
k = ulong 0
for f ulong nf
if eq get gfc f st
fn_prep f
put gsfn 0 0
em_fn f 2
sh_stream
dg_put f
put gq k f
k = add k 1
end
end
dg_sort k
put gsfn 0 0
for i ulong k
dg_emit get gq i
end
sh_stream
for j ulong 32
put ggr j get ghr j
end
for m ulong k
sc_final get gq m
end
end

fn dg_put f ulong to void
o = mul f 32
for i ulong 32
put gfg add o i get ghr i
end
end

fn dg_emit f ulong to void
