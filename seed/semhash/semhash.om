fn sc_final f ulong to void
put gsfn 0 0
sf_byte 83
dg_emit f
for i ulong 32
sf_byte get ggr i
end
sh_stream
hr_tofn f
put gfk f 1
end

note true when digest of fn a sorts before digest of fn b
fn dg_lt a ulong b ulong to bool
x = mul a 32
y = mul b 32
for i ulong 32
u = get gfg add x i
v = get gfg add y i
if ne u v
ret lt u v
end
end
ret false
end

fn dg_sort k ulong to void
for i ulong k
m = i
for j ulong k
if gt j i
if dg_lt get gq j get gq m
m = j
end
end
end
t = get gq i
put gq i get gq m
put gq m t
end
end

fn hs_all to void
