fn cg_tok f ulong t ulong t0 ulong to void
if eq t t0
ret
end
g = get gfm get gts t
if eq g 0
ret
end
g = sub g 1
if eq g f
ret
end
if eq get gcst g add f 1
ret
end
put gcst g add f 1
n = get gcen 0
if ge n 524288
rf_die ecap
end
put gce n g
put gcen 0 add n 1
put gfcn f add get gfcn f 1
put gfrn g add get gfrn g 1
end

fn cg_build to void
nf = get gfnn 0
for f ulong nf
