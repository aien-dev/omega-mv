note SPDX-License-Identifier: Apache-2.0
note seed/kflow/kpack.om: kflow's package stage. Wraps raw SASS text in a loadable CUDA cubin (ELF64,
note EM_CUDA 190), in seeded Omega (program mode, Linux AArch64). The layout is a port of CUDA++'s
note omega_cubin_pack (aien-dev/CUDApp src/omega_cubin.c at 853e814d): the same ten sections, the same
note .nv.info attributes, the same five program headers, made per architecture:
note   sm_121: e_flags 0x6007902, cuinfo note arch 121, with CUDA++'s 36-byte .nv.compat
note   sm_80:  e_flags 0x6005004, cuinfo note arch 80, no .nv.compat (ptxas 13.0 writes none for sm_80)
note
note Run:   kpack ARCH NAME BIN OUT REGS SHARED P...
note   ARCH 80 or 121; NAME the kernel symbol ([A-Za-z_][A-Za-z0-9_]*, at most 63 bytes); BIN raw SASS
note   (a nonzero multiple of 16 bytes, at most 64 KiB); OUT the cubin to write; REGS registers per thread
note   (at most 255); SHARED reserved shared bytes (multiple of 4); then one word per parameter in order:
note   p8 a pointer, or 1 2 4 8 a value of that many bytes. Parameters are laid out naturally aligned from
note   constant bank offset 0x380 (CUDA's ABI), and the constant bank ends at the end of the last one.
note Exit 0 written, 1 refused arguments or input, 2 write failed. The packer does not decode SASS: the
note register count is the caller's claim, and EIATTR_EXIT_INSTR_OFFSETS is left out as in CUDA++.
om2
text msg "kpack: usage: kpack ARCH NAME BIN OUT REGS SHARED P...\nkpack: bad argument\nkpack: bin unreadable, empty, too large or not a multiple of 16 bytes\nkpack: cannot write output\nkpack: wrote bytes=\n sections=\n cbank=\n"
text sn ".shstrtab|.strtab|.symtab|.text.|.nv.constant0.|.nv.info|.nv.compat|.nv.info.|.nv.shared.reserved.0|.note.nv.cuinfo|"
global ob uchar 196608
global tx uchar 65536
global ab uchar 256
global fnb uchar 64
global dig uchar 32
global po ulong 32
global ps ulong 32
global pp ulong 32
global so ulong 12
global sz ulong 12
global nm ulong 12
global sv ulong 16
note sv: 0 arch, 1 cursor, 2 name length, 3 parameter count, 4 text bytes, 5 cbank size, 6 regs,
note 7 shared bytes, 8 section count (with the null one)
fn say id ulong to void
k = ulong 1
s = ulong 0
for i ulong len msg
if eq get msg i 10
if eq k id
e = i
if lt id 5
e = add i 1
end
r = write 1 msg s sub e s
ret
end
k = add k 1
s = add i 1
end
end
exit 99
end
fn num v ulong to void
x = v
n = ulong 0
while ge x 10 bound 64
put dig n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
put dig n uchar add 48 x
n = add n 1
for i ulong n
r = write 1 dig sub sub n i 1 1
end
end
note ---- little-endian stores at an absolute offset, and at the cursor ----
fn b1 o ulong v ulong to void
put ob o uchar and v 255
end
fn b2 o ulong v ulong to void
b1 o v
b1 add o 1 shr v 8
end
fn b4 o ulong v ulong to void
b2 o v
b2 add o 2 shr v 16
end
fn b8 o ulong v ulong to void
b4 o v
b4 add o 4 shr v 32
end
fn cur to ulong
ret get sv 1
end
fn adv n ulong to void
put sv 1 add get sv 1 n
end
fn e1 v ulong to void
b1 cur v
adv 1
end
fn e4 v ulong to void
b4 cur v
adv 4
end
fn alignc a ulong to void
while ne rem cur a 0 bound 256
adv 1
end
end
note ---- .nv.info attributes: format 4 (id, length, payload), 3 (id, u16), 2 (id, 0) ----
fn at4 id ulong n ulong to void
e1 4
e1 id
e1 and n 255
e1 shr n 8
end
fn at3 id ulong v ulong to void
e1 3
e1 id
e1 and v 255
e1 shr v 8
end
fn ename to void
for i ulong get sv 2
e1 ulong get fnb i
end
end
note section-name number k (0..9) at the cursor: the prefix, the kernel name for 3 4 7, then 0
fn sname k ulong to void
j = ulong 0
for i ulong len sn
c = get sn i
if eq c 124
if eq j k
if or or eq k 3 eq k 4 eq k 7
ename
end
e1 0
ret
end
j = add j 1
else
if eq j k
e1 ulong c
end
end
end
end
fn hascompat to bool
ret eq get sv 0 121
end
fn shstr to void
e1 0
for k ulong 10
if or ne k 6 hascompat
put nm k sub cur get so 0
sname k
end
end
end
fn symtab to void
b = cur
for i ulong 96
e1 0
end
b1 add b 28 3
b2 add b 30 4
b4 add b 48 1
b1 add b 52 0x12
b1 add b 53 0x10
b2 add b 54 4
b8 add b 64 get sv 4
b1 add b 76 3
b2 add b 78 5
end
fn ginfo to void
at4 0x2f 8
e4 2
e4 get sv 6
at4 0x11 8
e4 2
e4 0
at4 0x12 8
e4 2
e4 0
end
fn compat to void
e4 0x00000902
e4 0x00020202
e4 0x00050502
e4 0x01010703
e4 0x00000302
e4 0x00010602
e4 0x00080b04
e4 0
e4 0
end
fn finfo to void
at4 0x37 4
e4 130
np = get sv 3
for i ulong np
at4 0x17 12
e4 0
e4 or i shl sub get po i 0x380 16
t = ulong 0x0011f000
if ne get pp i 0
t = ulong 0x0021f500
end
e4 t
end
e = sub get sv 5 0x380
at3 0x19 e
at4 0x0a 8
e4 3
e4 or 0x380 shl e 16
at3 0x50 0
at3 0x1b get sv 6
at3 0x5f 0x0101
e1 2
e1 0x4a
e1 0
e1 0
at4 0x36 4
e4 0
end
note one section body, by section-name number k
fn body k ulong to void
if eq k 0
shstr
end
if eq k 1
e1 0
ename
e1 0
end
if eq k 2
symtab
end
if eq k 3
for j ulong get sv 4
e1 ulong get tx j
end
end
if eq k 4
for j ulong get sv 5
e1 0
end
end
if eq k 5
ginfo
end
if eq k 6
compat
end
if eq k 7
finfo
end
if eq k 8
adv get sv 7
end
if eq k 9
noteb
end
end
fn noteb to void
e4 12
e4 8
e4 0x3e8
e4 0x4449564e
e4 0x43204149
e4 0x0070726f
e1 2
e1 0
e1 and get sv 0 255
e1 0
e4 130
end
note section attributes for name number k: type, flags, link, info, align, entsize
fn sty k ulong to ulong
if eq k 2
ret 2
end
if or eq k 3 eq k 4
ret 1
end
if or eq k 5 eq k 7
ret 0x70000000
end
if eq k 6
ret 0x70000086
end
if eq k 8
ret 8
end
if eq k 9
ret 7
end
ret 3
end
fn sfl k ulong to ulong
if eq k 3
ret 6
end
if eq k 4
ret 0x42
end
if eq k 7
ret 0x40
end
if eq k 8
ret 3
end
if eq k 9
ret 0x1000040
end
ret 0
end
fn sal k ulong to ulong
if eq k 2
ret 8
end
if eq k 3
ret 128
end
if eq k 4
ret 16
end
if or or eq k 5 eq k 6 or eq k 7 eq k 9
ret 4
end
ret 1
end
fn slk k ulong to ulong
if eq k 2
ret 2
end
if or or eq k 3 eq k 4 or eq k 5 eq k 7
ret 3
end
ret 0
end
fn sin k ulong to ulong
if eq k 2
ret 2
end
if eq k 3
ret 2
end
if or eq k 4 eq k 7
ret 4
end
if eq k 9
ret 2
end
ret 0
end
fn shdr p ulong k ulong to void
b4 p get nm k
b4 add p 4 sty k
b8 add p 8 sfl k
b8 add p 24 get so k
b8 add p 32 get sz k
b4 add p 40 slk k
b4 add p 44 sin k
b8 add p 48 sal k
if eq k 2
b8 add p 56 24
end
end
fn phdr p ulong t ulong f ulong o ulong fs ulong ms ulong to void
b4 p t
b4 add p 4 f
b8 add p 8 o
b8 add p 32 fs
b8 add p 40 ms
b8 add p 48 8
end
note ---- arguments ----
fn argdec i ulong to ulong
r = argread i ab 0 20
if lt r 1
ret 0xffffffffffffffff
end
v = ulong 0
for k ulong ulong r
c = get ab k
if or lt c 48 gt c 57
ret 0xffffffffffffffff
end
v = add mul v 10 ulong sub c 48
end
ret v
end
fn namearg to bool
r = argread 2 fnb 0 64
if or lt r 1 gt r 63
ret false
end
n = ulong r
for k ulong n
c = get fnb k
d = and ge c 48 le c 57
a = or and ge c 65 le c 90 and ge c 97 le c 122
if not or or a eq c 95 and d gt k 0
ret false
end
end
put sv 2 n
ret true
end
fn params to bool
np = sub ulong argcnt 7
if gt np 32
ret false
end
e = ulong 0x380
for i ulong np
r = argread add i 7 ab 0 4
p = ulong 0
s = ulong 0
if and eq r 2 eq get ab 0 112
if eq get ab 1 56
p = ulong 1
s = ulong 8
end
end
if eq r 1
s = ulong sub get ab 0 48
end
if not or or eq s 1 eq s 2 or eq s 4 eq s 8
ret false
end
while ne rem e s 0 bound 8
e = add e 1
end
put po i e
put ps i s
put pp i p
e = add e s
end
put sv 3 np
put sv 5 e
ret true
end
fn loadbin to bool
r = argread 3 ab 0 255
if lt r 1
ret false
end
fd = fopen ab 0 ulong r 524288 0
if lt fd 0
ret false
end
n = ulong 0
for k ulong 4097
x = read int fd tx n sub len tx n
if le x 0
break
end
n = add n ulong x
if eq n len tx
break
end
end
y = read int fd ab 0 1
c = fclose int fd
put sv 4 n
ret and and gt n 0 eq rem n 16 0 eq y 0
end
fn place to void
put sv 1 64
i = ulong 1
for k ulong 10
if or ne k 6 hascompat
alignc sal k
put so k cur
body k
put sz k sub cur get so k
i = add i 1
end
end
put sv 8 i
end
fn headers to ulong
alignc 8
sh = cur
n = get sv 8
i = ulong 1
for k ulong 10
if or ne k 6 hascompat
shdr add sh mul i 64 k
i = add i 1
end
end
ph = add sh mul n 64
phdr ph 6 4 ph 280 280
phdr add ph 56 1 4 ph 280 280
phdr add ph 112 1 5 get so 3 get sz 3 get sz 3
phdr add ph 168 1 6 get so 8 0 get sz 8
phdr add ph 224 1 4 get so 4 get sz 4 get sz 4
b4 0 0x464c457f
b1 4 2
b1 5 1
b1 6 1
b1 7 0x41
b1 8 8
b2 16 2
b2 18 190
b4 20 1
b8 32 ph
b8 40 sh
f = ulong 0x6005004
if hascompat
f = ulong 0x6007902
end
b4 48 f
b2 52 64
b2 54 56
b2 56 5
b2 58 64
b2 60 n
b2 62 1
ret add ph 280
end
fn main to int
if lt argcnt 7
say 1
ret 1
end
a = argdec 1
g = argdec 5
h = argdec 6
if or or and ne a 80 ne a 121 gt g 255 or gt h 0xfffff ne rem h 4 0
say 2
ret 1
end
if not namearg
say 2
ret 1
end
if not params
say 2
ret 1
end
if not loadbin
say 3
ret 1
end
put sv 0 a
put sv 6 g
put sv 7 h
place
t = headers
r = argread 4 ab 0 255
if lt r 1
say 4
ret 2
end
fd = fopen ab 0 ulong r 524865 420
if lt fd 0
say 4
ret 2
end
w = write int fd ob 0 t
c = fclose int fd
if or ne w long t ne c 0
say 4
ret 2
end
say 5
num t
say 6
num get sv 8
say 7
num get sv 5
put dig 0 10
r = write 1 dig 0 1
ret 0
end
