; tsoftmax.s2 -- softmax of each 32-value f32 row, one warp per row, on sm_121 (GB10), written by hand for
; asm2 with seed/sm121/sm121.tbl. X 0x380 (16 rows x 32 f32), Y 0x388 (same shape); 16 CTAs of 32 threads,
; row = CTA, column = lane: y = 2^((x - m) * log2 e) / sum, m = row max.
; The row max and the row sum are warp butterflies (SHFL.BFLY 16 8 4 2 1, each followed by FMNMX or FADD),
; so every lane ends with the same m and the same sum (the same additions in a lane-dependent order; the
; harness bound covers any order). log2 e is the f32 0x3fb8aa3b (1.44269502162933349609375, the same word
; nvcc 13.0 emits for expf); MUFU.EX2 and MUFU.RCP are the approximate units (PTX ISA 9.4 ex2.approx.f32:
; 2 ulp from correctly rounded; rcp.approx.f32: 1 ulp).
; Each ";=" line is the instruction text expected from nvdisasm -b SM121 for the next instruction.
; Control words are MODELED and unmeasured: S2R LDC LDCU LDG SHFL MUFU set scoreboard 0 (0x000e2200) and
; their first reader waits on it (wait mask bit 20, 0x001fcc00); fixed-latency steps stall 6. No GPU ran
; this (NOT_RUN).
;= S2R R0, SR_TID.X
  s2r.0 0
  s2r.1
  s2r.2 33
  ctl 0x000e2200
;= S2R R1, SR_CTAID.X
  s2r.0 1
  s2r.1
  s2r.2 37
  ctl 0x000e2200
;= LDCU.64 UR4, c[0x0][0x358]
  ldcu.64.0 4
  ldcu.64.1 107
  ldcu.64.2
  ctl 0x000e2200
;= LDC.64 R2, c[0x0][0x380]
  ldc.64.0 2
  ldc.64.1 224
  ldc.64.2
  ctl 0x000e2200
;= LDC.64 R4, c[0x0][0x388]
  ldc.64.0 4
  ldc.64.1 226
  ldc.64.2
  ctl 0x000e2200
; element index ctaid * 32 + tid (R6), addresses R8:R9 (X) and R10:R11 (Y)
;= IMAD R6, R1, 0x20, R0
  imad.i.0 6 1
  imad.i.1 0x00000020
  imad.i.2 0
  ctl 0x001fcc00
;= IMAD.WIDE.U32 R8, R6, 0x4, R2
  imad.wide.0 8 6
  imad.wide.1 0x00000004
  imad.wide.2 2
  ctl 0x000fcc00
;= IMAD.WIDE.U32 R10, R6, 0x4, R4
  imad.wide.0 10 6
  imad.wide.1 0x00000004
  imad.wide.2 4
  ctl 0x000fcc00
;= LDG.E R12, desc[UR4][R8.64]
  ldg.0 12 8
  ldg.w.1 4 0
  ldg.2
  ctl 0x000e2200
; m = row max (R13; R19 holds the partner value)
;= SHFL.BFLY PT, R13, R12, 0x10, 0x1f
  shfl.0 13 12
  shfl.bfly.1 16
  shfl.2
  ctl 0x001e2200
;= FMNMX R13, R12, R13, !PT
  fmnmx.0 13 12
  r.1 13
  fmnmx.max.2
  ctl 0x001fcc00
;= SHFL.BFLY PT, R19, R13, 0x8, 0x1f
  shfl.0 19 13
  shfl.bfly.1 8
  shfl.2
  ctl 0x000e2200
;= FMNMX R13, R13, R19, !PT
  fmnmx.0 13 13
  r.1 19
  fmnmx.max.2
  ctl 0x001fcc00
;= SHFL.BFLY PT, R19, R13, 0x4, 0x1f
  shfl.0 19 13
  shfl.bfly.1 4
  shfl.2
  ctl 0x000e2200
;= FMNMX R13, R13, R19, !PT
  fmnmx.0 13 13
  r.1 19
  fmnmx.max.2
  ctl 0x001fcc00
;= SHFL.BFLY PT, R19, R13, 0x2, 0x1f
  shfl.0 19 13
  shfl.bfly.1 2
  shfl.2
  ctl 0x000e2200
;= FMNMX R13, R13, R19, !PT
  fmnmx.0 13 13
  r.1 19
  fmnmx.max.2
  ctl 0x001fcc00
;= SHFL.BFLY PT, R19, R13, 0x1, 0x1f
  shfl.0 19 13
  shfl.bfly.1 1
  shfl.2
  ctl 0x000e2200
;= FMNMX R13, R13, R19, !PT
  fmnmx.0 13 13
  r.1 19
  fmnmx.max.2
  ctl 0x001fcc00
; e = 2^((x - m) * log2 e) (R14); x - m is exact for the harness inputs
;= FADD R14, R12, -R13
  fadd.0 14 12
  fsub.1 13
  f.2
  ctl 0x000fcc00
;= MOV R15, 0x3fb8aa3b
  mov.i.0 15
  mov.i.1 0x3fb8aa3b
  mov.i.2
  ctl 0x000fcc00
;= FMUL R14, R14, R15
  fmul.0 14 14
  r.1 15
  fmul.2
  ctl 0x000fcc00
;= MUFU.EX2 R14, R14
  mufu.0 14
  r.1 14
  mufu.ex2.2
  ctl 0x000e2200
; s = row sum (R16)
;= SHFL.BFLY PT, R16, R14, 0x10, 0x1f
  shfl.0 16 14
  shfl.bfly.1 16
  shfl.2
  ctl 0x001e2200
;= FADD R16, R14, R16
  fadd.0 16 14
  r.1 16
  f.2
  ctl 0x001fcc00
;= SHFL.BFLY PT, R17, R16, 0x8, 0x1f
  shfl.0 17 16
  shfl.bfly.1 8
  shfl.2
  ctl 0x000e2200
;= FADD R16, R16, R17
  fadd.0 16 16
  r.1 17
  f.2
  ctl 0x001fcc00
;= SHFL.BFLY PT, R17, R16, 0x4, 0x1f
  shfl.0 17 16
  shfl.bfly.1 4
  shfl.2
  ctl 0x000e2200
;= FADD R16, R16, R17
  fadd.0 16 16
  r.1 17
  f.2
  ctl 0x001fcc00
;= SHFL.BFLY PT, R17, R16, 0x2, 0x1f
  shfl.0 17 16
  shfl.bfly.1 2
  shfl.2
  ctl 0x000e2200
;= FADD R16, R16, R17
  fadd.0 16 16
  r.1 17
  f.2
  ctl 0x001fcc00
;= SHFL.BFLY PT, R17, R16, 0x1, 0x1f
  shfl.0 17 16
  shfl.bfly.1 1
  shfl.2
  ctl 0x000e2200
;= FADD R16, R16, R17
  fadd.0 16 16
  r.1 17
  f.2
  ctl 0x001fcc00
; y = e * (1 / s)
;= MUFU.RCP R17, R16
  mufu.0 17
  r.1 16
  mufu.rcp.2
  ctl 0x000e2200
;= FMUL R18, R14, R17
  fmul.0 18 14
  r.1 17
  fmul.2
  ctl 0x001fcc00
;= STG.E desc[UR4][R10.64], R18
  stg.0 10
  stg.1 18 0
  stg.2 4
  stg.3
;= EXIT
  exit.0
  z.1
  exit.2
  exit.3
;= BRA 0x250
  bra.0 7 63
  bra.1 -1
  bra.back.2
  bra.self.3
  nop.0
  nop.1
  nop.2
  nop.3
