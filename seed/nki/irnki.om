note SPDX-License-Identifier: Apache-2.0
note irnki: OSC IR v1 elementwise scalar functions to AWS NKI kernels at the nki.isa level.
note Wire authority spec/one-layer-format.md. NKI ISA reference (read 2026-10-26):
note https://awsdocs-neuron.readthedocs-hosted.com/en/latest/nki/api/nki.isa.html
note A liftable function is exactly: two parameters and a result of tag 4 (u32), three vregs,
note one block of two instructions, BIN sub dst=2 a,b in {0,1}, then RET 2.
note Lane dtype: uint32 (default, same meaning as the IR) or float32 with argument f32,
note an explicit retyping because IR v1 has no float tag (spec section 10.3 is not produced yet).
note Output is buffered: every refusal happens before the first stdout byte.
global input uchar 2620252
global output uchar 1048576
note state slots: 0 input cursor, 1 input size, 2 output size, 3 lane (0 uint32, 1 float32), 4 nfuncs
global state ulong 8
global names ulong 32
global namelen ulong 32
global subs ulong 32
global lhs ulong 32
global rhs ulong 32
text emagic "irnki: MAGIC\n"
text ever "irnki: VERSION\n"
text etrunc "irnki: TRUNCATED\n"
text ecap "irnki: CAPACITY\n"
text eop "irnki: UNSUPPORTED_OP\n"
text etype "irnki: UNSUPPORTED_TAG\n"
text einval "irnki: INVALID\n"
text etrail "irnki: TRAILING\n"
text eio "irnki: IO\n"
text eshape "irnki: NOT_ELEMENTWISE\n"
text eusage "irnki: USAGE irnki [f32] < unit.ir > kernels.py\n"
text th0 "# Generated by seed/nki/irnki.om (seeded Omega) from an OSC IR v1 unit. Do not edit.\n# Level: nki.isa (NISA) instructions on explicit SBUF tiles of 128 partitions x 512.\n# Lane dtype: "
text th1 "\nimport nki\nimport nki.isa as nisa\nimport nki.language as nl\n\nTILE_P = 128\nTILE_F = 512\n"
text tf0 "\n\n@nki.jit\ndef om_"
text tf1 "(a, b):\n    assert a.shape == b.shape\n    rows, cols = a.shape\n    assert rows % TILE_P == 0\n    assert cols % TILE_F == 0\n    out = nl.ndarray(a.shape, dtype=nl."
text tf2 ", buffer=nl.shared_hbm)\n    for m in nl.affine_range(rows // TILE_P):\n        for n in nl.affine_range(cols // TILE_F):\n"
text tal0 "            t"
text tal1 " = nl.ndarray((TILE_P, TILE_F), dtype=nl."
text tal2 ", buffer=nl.sbuf)\n"
text td0 "            nisa.dma_copy(dst=t"
text td1 ", src="
text tslc "[m * TILE_P:(m + 1) * TILE_P, n * TILE_F:(n + 1) * TILE_F]"
text td2 ")\n"
text tt0 "            nisa.tensor_tensor(dst=tc, data1=t"
text tt1 ", data2=t"
text tt2 ", op=nl."
text ts0 "            nisa.dma_copy(dst=out"
text ts1 ", src=tc)\n    return out\n"
text tk0 "\n\nKERNELS = {\n"
text tk1 "    \""
text tk2 "\": (om_"
text tk3 ", \""
text tk4 "\"),\n"
text tk5 "}\n"
text tdf "float32"
text tdu "uint32"
text tadd "add"
text tsub "subtract"
text tmul "multiply"
text tand "bitwise_and"
text tor "bitwise_or"
text txor "bitwise_xor"
fn refuse code int to void
k = long 0
if eq code 20
k = write 2 emagic 0 len emagic
end
if eq code 21
k = write 2 ever 0 len ever
end
if eq code 22
k = write 2 etrunc 0 len etrunc
end
if eq code 23
k = write 2 ecap 0 len ecap
end
if eq code 24
k = write 2 eop 0 len eop
end
if eq code 25
k = write 2 etype 0 len etype
end
if eq code 26
k = write 2 einval 0 len einval
end
if eq code 27
k = write 2 etrail 0 len etrail
end
if eq code 28
k = write 2 eio 0 len eio
end
if eq code 29
k = write 2 eshape 0 len eshape
end
if eq code 30
k = write 2 eusage 0 len eusage
end
exit code
end
fn need ok bool to void
if not ok
refuse 26
end
end
fn rd n ulong to ulong
p = get state 0
if gt n sub get state 1 p
refuse 22
end
v = ulong 0
for j ulong n
v = or v shl ulong get input add p j mul j 8
end
put state 0 add p n
ret v
end
fn shape ok bool to void
if not ok
refuse 29
end
end
note Every register and the result must be u32 (tag 4). Tags 0..12 other than 4 are
note unsupported; tags above 12 do not exist in any OSC version.
fn lane t ulong to void
if ne t 4
refuse 25
end
end
fn namech c ulong to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 95
end
fn same a ulong b ulong to bool
if ne get namelen a get namelen b
ret false
end
for j ulong get namelen a
x = get input add get names a j
y = get input add get names b j
if ne x y
ret false
end
end
ret true
end
note BIN subcodes 1 add, 2 sub, 3 mul, 6 and, 7 or, 8 xor are liftable for uint32 lanes;
note float32 lanes take only add, sub, mul (float bitwise BIN is invalid, spec 10.3).
note div/rem trap on zero and shl/shr trap on wide counts in Omega; NKI has no trap,
note so 4, 5, 9 and 10 are refused rather than silently changed.
fn binsub s ulong to void
need and ge s 1 le s 10
if or eq s 4 eq s 5
refuse 24
end
if or eq s 9 eq s 10
refuse 24
end
if and eq get state 3 1 gt s 3
refuse 24
end
end
fn loadfn f ulong to void
n = rd 1
need and ne n 0 le n 63
put namelen f n
put names f get state 0
for j ulong n
need namech rd 1
end
for j ulong f
need not same f j
end
shape eq rd 1 2
lane rd 1
shape eq rd 2 3
for j ulong 3
lane rd 1
end
shape eq rd 2 1
need eq rd 4 0
shape eq rd 4 2
shape eq rd 4 2
if ne rd 1 3
refuse 24
end
s = rd 1
binsub s
put subs f s
need eq rd 2 2
x = rd 2
need lt x 2
put lhs f x
x = rd 2
need lt x 2
put rhs f x
if ne rd 1 15
refuse 24
end
need eq rd 2 2
for c ulong 2
n = rd 2
need le n 255
for j ulong n
need ne rd 1 0
end
end
end
fn emit v ulong to void
p = get state 2
if ge p len output
refuse 23
end
put output p uchar v
put state 2 add p 1
end
note Fragment table: one id per text above, emitted byte for byte.
fn frag k ulong to void
if eq k 0
for j ulong len th0
emit ulong get th0 j
end
end
if eq k 1
for j ulong len th1
emit ulong get th1 j
end
end
if eq k 2
for j ulong len tf0
emit ulong get tf0 j
end
end
if eq k 3
for j ulong len tf1
emit ulong get tf1 j
end
end
if eq k 4
for j ulong len tf2
emit ulong get tf2 j
end
end
if eq k 5
for j ulong len tal0
emit ulong get tal0 j
end
end
if eq k 6
for j ulong len tal1
emit ulong get tal1 j
end
end
if eq k 7
for j ulong len tal2
emit ulong get tal2 j
end
end
if eq k 8
for j ulong len td0
emit ulong get td0 j
end
end
if eq k 9
for j ulong len td1
emit ulong get td1 j
end
end
if eq k 10
for j ulong len tslc
emit ulong get tslc j
end
end
if eq k 11
for j ulong len td2
emit ulong get td2 j
end
end
if eq k 12
for j ulong len tt0
emit ulong get tt0 j
end
end
if eq k 13
for j ulong len tt1
emit ulong get tt1 j
end
end
if eq k 14
for j ulong len tt2
emit ulong get tt2 j
end
end
if eq k 15
for j ulong len ts0
emit ulong get ts0 j
end
end
if eq k 16
for j ulong len ts1
emit ulong get ts1 j
end
end
if eq k 17
for j ulong len tk0
emit ulong get tk0 j
end
end
if eq k 18
for j ulong len tk1
emit ulong get tk1 j
end
end
if eq k 19
for j ulong len tk2
emit ulong get tk2 j
end
end
if eq k 20
for j ulong len tk3
emit ulong get tk3 j
end
end
if eq k 21
for j ulong len tk4
emit ulong get tk4 j
end
end
if eq k 22
for j ulong len tk5
emit ulong get tk5 j
end
end
end
fn dtype to void
if eq get state 3 1
for j ulong len tdf
emit ulong get tdf j
end
else
for j ulong len tdu
emit ulong get tdu j
end
end
end
fn opname s ulong to void
if eq s 1
for j ulong len tadd
emit ulong get tadd j
end
end
if eq s 2
for j ulong len tsub
emit ulong get tsub j
end
end
if eq s 3
for j ulong len tmul
emit ulong get tmul j
end
end
if eq s 6
for j ulong len tand
emit ulong get tand j
end
end
if eq s 7
for j ulong len tor
emit ulong get tor j
end
end
if eq s 8
for j ulong len txor
emit ulong get txor j
end
end
end
fn fname f ulong to void
for j ulong get namelen f
emit ulong get input add get names f j
end
end
note Parameter register 0 is a, 1 is b; their SBUF tiles are ta and tb.
fn param r ulong to void
emit add 97 r
end
fn tile c ulong to void
frag 5
emit c
frag 6
dtype
frag 7
end
fn load r ulong to void
frag 8
param r
frag 9
param r
frag 10
frag 11
end
fn kernel f ulong to void
frag 2
fname f
frag 3
dtype
frag 4
tile 97
tile 98
tile 99
load 0
load 1
frag 12
param get lhs f
frag 13
param get rhs f
frag 14
opname get subs f
frag 11
frag 15
frag 10
frag 16
end
fn module to void
frag 0
dtype
frag 1
for f ulong get state 4
kernel f
end
frag 17
for f ulong get state 4
frag 18
fname f
frag 19
fname f
frag 20
dtype
frag 21
end
frag 22
end
fn args to void
c = argcnt
if eq c 1
put state 3 0
ret
end
if ne c 2
refuse 30
end
b = new uchar 4 0
k = argread 1 b 0 4
if ne k 3
refuse 30
end
if or ne get b 0 102 or ne get b 1 51 ne get b 2 50
refuse 30
end
put state 3 1
end
fn main to int
args
n = ulong 0
for attempt ulong 2620252
if eq n len input
refuse 23
end
k = read 0 input n sub len input n
if lt k 0
refuse 28
end
if eq k 0
break
end
n = add n ulong k
end
if eq n len input
refuse 23
end
put state 1 n
magic = new uchar 7 0
put magic 0 79
put magic 1 83
put magic 2 67
put magic 3 49
put magic 4 73
put magic 5 82
for j ulong 7
v = rd 1
if ne v ulong get magic j
refuse 20
end
end
if ne rd 1 1
refuse 21
end
nf = rd 2
if gt nf 32
refuse 23
end
need ne nf 0
put state 4 nf
for f ulong nf
loadfn f
end
if ne get state 0 n
refuse 27
end
module
p = ulong 0
for attempt ulong 1048576
if eq p get state 2
break
end
k = write 1 output p sub get state 2 p
if le k 0
refuse 28
end
p = add p ulong k
end
ret 0
end
