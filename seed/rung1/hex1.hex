# hex1.hex -- rung 1 of the Omega seed chain, written in seed-0's language (8 hex digits = one word,
# '#' comment to end of line) and built by seed-0: seed0.bin < hex1.hex > hex1.bin.
# hex1 reads seed-0's language plus two marks:
#   :c   names the place of the next word "c" (c = any one printable character)
#   @c   right after a word: adds the distance in words from that word to label c into bits 5..23 of it
#        (the imm19 field of B.cond, CBZ, CBNZ, LDR literal; and ADR's immhi when the target is a
#        whole word away). This is the one relative branch form.
# It reads all its input first, counts words and labels (pass 1), then writes (pass 2), so a label may
# be used before it is named. Exit codes: 0 ok, 1 word cut short, 2 read failed, 3 write failed,
# 4 bad character, 5 label used but never named, 6 label named twice, 7 input over 4 MiB,
# 8 ':' or '@' without a printable label character, 9 mark in the middle of a word, 10 '@' before any word.
# Instruction bits: Arm DDI 0487 M.d, section on each line. Memory: one mapping at 0x400000;
# labels table 0x410000 (256 x 8 bytes), input 0x420000..0x820000, output from 0x820000 (4 MiB).
# Unconditional jumps are B.cond with condition AL (1110, "Always", Table C1-1), so that every branch
# in hex1 uses the imm19 form that hex1 itself understands.
#
# ---- ELF-64 file header, 16 words ----
464c457f  # e_ident[0..3] = 7f 'E' 'L' 'F'
00010102  # e_ident[4..7] = ELFCLASS64, ELFDATA2LSB, EV_CURRENT, ELFOSABI_NONE
00000000  # e_ident[8..11] = ABI version 0, padding
00000000  # e_ident[12..15] = padding
00b70002  # e_type = 2 ET_EXEC, e_machine = 183 EM_AARCH64
00000001  # e_version = 1
00400078  # e_entry low = 0x400078 (file offset 120)
00000000  # e_entry high
00000040  # e_phoff low = 64
00000000  # e_phoff high
00000000  # e_shoff low = 0 (no sections)
00000000  # e_shoff high
00000000  # e_flags = 0
00380040  # e_ehsize = 64, e_phentsize = 56
00000001  # e_phnum = 1, e_shentsize = 0
00000000  # e_shnum = 0, e_shstrndx = 0
# ---- program header, 14 words ----
00000001  # p_type = PT_LOAD
00000007  # p_flags = read, write, execute
00000000  # p_offset low = 0
00000000  # p_offset high
00400000  # p_vaddr low = 0x400000
00000000  # p_vaddr high
00400000  # p_paddr low = 0x400000
00000000  # p_paddr high
00000308  # p_filesz low = 776 bytes (120 header + 164 instructions * 4)
00000000  # p_filesz high
00820000  # p_memsz low = 0x820000 (tables and buffers up to 0xc20000, zero-filled)
00000000  # p_memsz high
00001000  # p_align low = 4096
00000000  # p_align high
