note Validate grep-compatible line digits: error CODE at LF or EOF.
note Expected code is canonical decimal 1..127 on fd3, no newline.
note stdin cap65536. Status0 match,1 absent,2 I/O,3 capacity,4 bad expected code.
global Buf uchar 65537
global Code uchar 4
global CLen ulong 1
text Lead "line "
text Mid ": error "
fn code to int
n = ulong 0
while lt n len Code
r = read 3 Code n sub len Code n
if lt r 0
ret 2
end
if eq r 0
if eq n 0
ret 4
end
if eq get Code 0 uchar 48
ret 4
end
v = ulong 0
for i ulong n
c = get Code i
if or lt c uchar 48 gt c uchar 57
ret 4
end
v = add mul v 10 sub ulong c 48
end
if gt v 127
ret 4
end
put CLen 0 n
ret 0
end
n = add n ulong r
end
ret 4
end
fn match pos ulong n ulong to bool
if lt sub n pos 5
ret false
end
for j ulong 5
if ne get Buf add pos j get Lead j
ret false
end
end
p = add pos 5
while lt p n
c = get Buf p
if or lt c uchar 48 gt c uchar 57
if lt sub n p add 8 get CLen 0
ret false
end
for j ulong 8
if ne get Buf add p j get Mid j
ret false
end
end
p = add p 8
for j ulong get CLen 0
if ne get Buf add p j get Code j
ret false
end
end
p = add p get CLen 0
if eq p n
ret true
end
ret eq get Buf p uchar 10
end
p = add p 1
end
ret false
end
fn check n ulong to int
for i ulong n
if match i n
ret 0
end
end
ret 1
end
fn main to int
status = code
if ne status 0
ret status
end
used = ulong 0
while lt used len Buf
r = read 0 Buf used sub len Buf used
if lt r 0
ret 2
end
if eq r 0
ret check used
end
used = add used ulong r
end
ret 3
end
