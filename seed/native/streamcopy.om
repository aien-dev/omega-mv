note Handwritten bounded stdin to stdout copier. No metadata or pathname API.
note Exit 0 copied through EOF, 2 read/write error, 3 input exceeds 8 MiB.
note Streaming output may contain a prefix on refusal; not transactional.
global Buf uchar 8192
fn main to int
total = ulong 0
while true
n = read 0 Buf 0 len Buf
if lt n 0
ret 2
end
if eq n 0
ret 0
end
if gt ulong n sub ulong 8388608 total
ret 3
end
sent = ulong 0
while lt sent ulong n
w = write 1 Buf sent sub ulong n sent
if le w 0
ret 2
end
sent = add sent ulong w
end
total = add total ulong n
end
ret 2
end
