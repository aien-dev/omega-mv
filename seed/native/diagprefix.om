note Normalize diagnostic line prefixes om4: or omc: to X: exactly.
note Up to 65536 input bytes; exit 2 I/O, 3 capacity; no output on input refusal.
global Buf uchar 65537
fn prefix pos ulong n ulong to bool
if lt sub n pos 4
ret false
end
if ne get Buf pos uchar 111
ret false
end
if ne get Buf add pos 1 uchar 109
ret false
end
c = get Buf add pos 2
if not or eq c uchar 52 eq c uchar 99
ret false
end
ret eq get Buf add pos 3 uchar 58
end
fn rewrite n ulong to ulong
src = ulong 0
dst = ulong 0
start = true
while lt src n
if and start prefix src n
put Buf dst uchar 88
put Buf add dst 1 uchar 58
dst = add dst 2
src = add src 4
start = false
else
c = get Buf src
put Buf dst c
start = eq c uchar 10
src = add src 1
dst = add dst 1
end
end
ret dst
end
fn main to int
used = ulong 0
while lt used len Buf
r = read 0 Buf used sub len Buf used
if lt r 0
ret 2
end
if eq r 0
if gt used 65536
ret 3
end
n = rewrite used
sent = ulong 0
while lt sent n
w = write 1 Buf sent sub n sent
if le w 0
ret 2
end
sent = add sent ulong w
end
ret 0
end
used = add used ulong r
end
ret 3
end
