fn subsystem s ulong to void
if eq s 0
sayS0
else
if eq s 1
sayS1
else
if eq s 2
sayS2
else
if eq s 3
sayS3
else
if eq s 4
sayS4
else
if eq s 5
sayS5
else
if eq s 6
sayS6
else
if eq s 7
sayS7
else
if eq s 8
sayS8
else
if eq s 9
sayS9
else
if eq s 10
sayS10
else
sayUnknown
end
end
end
end
end
end
end
end
end
end
end
end

fn metahex off ulong to void
for i ulong 32
hexbyte get Meta add off i
end
end

fn comphex off ulong to void
for i ulong 32
hexbyte get Comp add off i
end
end

fn refusal side ulong to void
base = mul side 4
emit 45
number ulong neg get Stat base
sayEvent
number ulong get Stat add base 1
emit 10
end

fn verdict side ulong detail bool to void
base = mul side 4
if ne get Stat base 0
sayRefuse
refusal side
ret
end
sayOk
n = ulong get Stat add base 2
number n
sayRun
metahex mul side 64
sayFinal
metahex add mul side 64 32
emit 10
if detail
for i ulong n
sayDigest
at = add mul side 4096 i
comphex mul at 32
saySub
number get Subs at
emit 10
end
end
end

fn different at ulong to bool
for j ulong 32
x = get Comp add at j
y = get Comp add add 131072 at j
if ne x y
ret true
end
end
ret false
end
fn compare to void
if ne get Stat 0 0
sayRefuse
sayExpected
refusal 0
ret
end
if ne get Stat 4 0
sayRefuse
sayActual
refusal 1
ret
end
n = ulong get Stat 2
m = ulong get Stat 6
if gt n m
n = m
end
for i ulong n
at = mul i 32
diff = different at
if diff
sayDiverge
number add i 1
sayExp
comphex at
sayAct
comphex add 131072 at
saySub
subsystem get Subs i
emit 10
ret
end
end
sayMatch
number n
emit 10
end

fn main to int
constants
for request ulong 1000000
op = input
if eq op -1
flush
ret 0
end
if or eq op 86 eq op 68
verify 0
verdict 0 eq op 68
else
if eq op 67
verify 0
verify 1
compare
else
if eq op 83
a = required
b = required
subsystem add ulong a mul ulong b 256
emit 10
else
failio
end
end
end
flush
end
if ne input -1
failio
end
ret 0
end

