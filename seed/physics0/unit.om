note Request framing rejects short and oversized lengths without indexing.
if ne rngreqok 0 2
ret 90
end
if ne rngreqok 7 2
ret 91
end
if ne rngreqok 265 2
ret 92
end
if ne rngreqok 18446744073709551615 2
