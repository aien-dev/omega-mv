if ne rnginit 0 0 0
ret 102
end
for word ulong 8
v = rngnext
for octet ulong 8
if ne get rngout add mul word 8 octet uchar and shr v mul octet 8 255
ret 103
end
end
end
for i ulong 8
put rngreq i 255
end
put rngreq 8 128
put rngreq 9 255
if ne rngreqok 10 0
ret 104
end
if ne get rngstate 0 17733546922739928351
