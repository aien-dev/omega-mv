end
note Mixed seed bytes detect reversed or permuted seed decoding.
put rngreq 0 1
put rngreq 1 35
put rngreq 2 69
put rngreq 3 103
put rngreq 4 137
put rngreq 5 171
put rngreq 6 205
put rngreq 7 239
if ne rngreqok 8 0
ret 117
end
if ne get rngstate 0 2611867254004318244
ret 118
end
if ne rngnext 7292048037619145208
ret 119
end
ret 0
end
