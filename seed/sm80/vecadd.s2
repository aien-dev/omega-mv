; vecadd.s2 -- c[i] = a[i] + b[i] for sm_80, written by hand for asm2 with seed/sm80/sm80.tbl.
; The same kernel and schedule as seed/sm121/vecadd.s2 (chip-run on the GB10), moved to sm_80 forms:
; ULDC replaces LDCU (no 64-bit uniform descriptor load), and global loads/stores take [R.64] with URZ,
; so the first load no longer waits on the descriptor's scoreboard. Two control words are NAK's
; (calc_instr_deps with SM80Latency, `nakref sched 80`) because NAK's are stricter there: STG holds its
; registers on read scoreboard 0 with stall 2, and the last EXIT waits on it. Every other stall is at
; least NAK's. Constant bank 0 keeps CUDA++'s layout:
; 0x37c stack, 0x360 block size, 0x380/0x388/0x390 a/b/c, 0x398 n. Each instruction is four lines.
; Control line: c stall yield write-sb read-sb wait-mask reuse. Not run on any sm_80 GPU (NOT_RUN).
ldc.0 7 1 255         ; LDC R1, c[0x0][0x37c]
cb.1 0x37c 0
ldc.2 4 0
c 1 1 7 7 0 0
s2r.0 7 9             ; S2R R9, SR_CTAID.X
z.1
s2r.2 0x25
c 1 1 0 7 0 0
uldc.0 7 4            ; ULDC UR4, c[0x0][0x360]
cb.1 0x360 0
uldc.2 4
c 1 1 0 7 0 0
s2r.0 7 0             ; S2R R0, SR_TID.X
z.1
s2r.2 0x21
c 1 1 0 7 0 0
uldc.0 7 5            ; ULDC UR5, c[0x0][0x398]
cb.1 0x398 0
uldc.2 4
c 1 1 1 7 0 0
imad.u.0 7 9 9        ; IMAD R9, R9, UR4, R0
u.1 4
imad.u.2 0 0
c 5 0 7 7 1 0
isetp.u.0 7 9         ; ISETP.GE.U32.AND P0, PT, R9, UR5, PT
u.1 5
isetp.u.2 7 0 0 0 6 0 7
c 13 0 7 7 2 0
exit.0 0              ; @P0 EXIT
z.1
exit.2
c 5 1 7 7 0 0
ldc.0 7 2 255         ; LDC.64 R2, c[0x0][0x380]
cb.1 0x380 0
ldc.2 5 0
c 1 1 0 7 0 0
ldc.0 7 4 255         ; LDC.64 R4, c[0x0][0x388]
cb.1 0x388 0
ldc.2 5 0
c 8 1 2 7 0 0
ldc.0 7 6 255         ; LDC.64 R6, c[0x0][0x390]
cb.1 0x390 0
ldc.2 5 0
c 1 1 3 7 0 0
imadw.i.0 7 2 9       ; IMAD.WIDE.U32 R2, R9, 0x4, R2
n.1 4
imad.2 2 0
c 6 0 7 7 1 0
ldg.0 7 2 2           ; LDG.E R2, [R2.64]
ldg.1 63 0
ldg.2 0 1 4 7 1 1
c 1 1 4 7 0 0
imadw.i.0 7 4 9       ; IMAD.WIDE.U32 R4, R9, 0x4, R4
n.1 4
imad.2 4 0
c 6 0 7 7 4 0
ldg.0 7 5 4           ; LDG.E R5, [R4.64]
ldg.1 63 0
ldg.2 0 1 4 7 1 1
c 1 1 4 7 0 0
imadw.i.0 7 6 9       ; IMAD.WIDE.U32 R6, R9, 0x4, R6
n.1 4
imad.2 6 0
c 1 1 7 7 8 0
iadd3.0 7 9 2         ; IADD3 R9, R2, R5, RZ
r.1 5
iadd3.2 255 7 7
c 5 0 7 7 16 0
stg.0 7 6             ; STG.E [R6.64], R9
stg.1 9 0
stg.2 63 1 4 7 1 1
c 2 1 7 0 0 0
exit.0 7              ; EXIT
z.1
exit.2
c 5 1 7 7 1 0
bra.0 7               ; BRA to itself: distance -1 instruction
bra.1 0x0fffffff
bra.2 -1 7
c 0 0 7 7 0 0
