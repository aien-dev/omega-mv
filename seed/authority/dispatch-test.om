note SPDX-License-Identifier: AGPL-3.0-only
note Dispatcher checks: valid performed, duplicate, in-flight, unknown, limit, revocation and stale.
global checks ulong 1
global fails ulong 1
global report uchar 64
text title "dispatch checks="
text dir "build/authority-store"
fn check got ulong want ulong to void
put checks 0 add get checks 0 1
if ne got want
put fails 0 add get fails 0 1
end
end
fn plan r edit ulong 32 to void
for i ulong 32
put r i 0
end
put r 0 1
put r 1 1
put r 3 3
put r 4 1
put r 5 9
put r 6 100
for i ulong 24
put r add i 8 add i 100
end
end
fn context c edit ulong 32 to void
for i ulong 32
put c i 0
end
put c 0 1
put c 1 1
put c 2 50
put c 4 1
put c 5 9
for i ulong 24
put c add i 8 add i 100
end
end
fn summary to int
for i ulong len title
put report i get title i
end
n = get checks 0
at = len title
put report at uchar add 48 div n 100
put report add at 1 uchar add 48 rem div n 10 10
put report add at 2 uchar add 48 rem n 10
put report add at 3 32
put report add at 4 uchar add 48 div get fails 0 100
put report add at 5 uchar add 48 rem div get fails 0 10 10
put report add at 6 uchar add 48 rem get fails 0 10
put report add at 7 10
w = write 1 report 0 add at 8
if ne w long add at 8
ret 2
end
if ne get fails 0 0
ret 1
end
ret 0
end
fn main to int
if ne makedir dir 0 len dir 448 0
put sb 0 0
end
r = new ulong 32 0
c = new ulong 32 0
plan r
context c
check writegen 1 0
check writerec r 0
check dispatch r c 48 0
check readrec r 0
check get r 1 4
check get r 2 1
check dispatch r c 48 22
plan r
check writegen 1 0
check writerec r 0
check dispatch r c 51 0
check readrec r 0
check get r 1 4
plan r
check writegen 1 0
check writerec r 0
for i ulong len strictp
put dpath i get strictp i
end
put dplen 0 len strictp
check dispatch r c 52 0
check readrec r 0
check get r 1 4
plan r
put r 1 2
put r 2 1
check writerec r 0
check dispatch r c 48 20
plan r
put r 1 3
put r 2 1
check writerec r 0
check dispatch r c 48 21
plan r
put r 3 1
put r 2 1
check writerec r 0
check dispatch r c 48 23
plan r
check writegen 1 0
check writerec r 0
check dispatch r c 49 60
check readrec r 0
check get r 1 3
check readgen 2
check writegen 2 0
plan r
check writerec r 0
check dispatch r c 48 52
plan r
put r 1 2
put r 2 1
check writerec r 0
err = actlost r
check err 0
check writerec r 0
check readrec r 0
check get r 1 3
ret summary
end
