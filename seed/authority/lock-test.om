note SPDX-License-Identifier: AGPL-3.0-only
note Lock checks: exclusive acquire, busy refusal, release, a forked waiter, and stale-pid reclaim.
text passm "lock checks=5 fails=0\n"
global checks ulong 1
global fails ulong 1
global lbuf uchar 8
global rb uchar 8
text childf "build/authority-store/lock.child"
text bd "build"
text ad "build/authority-store"
fn check got ulong want ulong to void
put checks 0 add get checks 0 1
if ne got want
put fails 0 add get fails 0 1
end
end
fn cbyte c uchar to void
r = fopen childf 0 len childf 0 0
if lt r 0
put rb 0 255
ret
end
n = read int r rb 0 1
if ne fclose int r 0
ret
end
end
fn main to int
r = makedir bd 0 len bd 448
if or eq r 0 eq r -17
else
ret 90
end
r = makedir ad 0 len ad 448
if or eq r 0 eq r -17
else
ret 91
end
u = lrel
u = ltry ulong getpid
check u 0
u = ltry ulong getpid
check u 20
u = lrel
if ne u 0
ret 92
end
u = ltry ulong getpid
check u 0
pid = fork
if lt pid 0
ret 93
end
if eq pid 0
u = lacq ulong getpid 1000
put lbuf 0 uchar u
fd = fopen childf 0 len childf 577 384
if lt fd 0
exit 94
end
n = write int fd lbuf 0 1
if ne n 1
exit 95
end
exit 0
end
if ne sleepns 50000000 0
ret 96
end
u = lrel
if ne u 0
ret 97
end
wr = waitpid int pid lbuf 0 8 0
if ne wr long pid
ret 98
end
cbyte 0
check ulong get rb 0 0
lpid 999999
fd = fopen lpath 0 len lpath 577 384
if lt fd 0
ret 99
end
n = write int fd lb 0 8
if ne n 8
ret 100
end
u = ltry ulong getpid
check u 0
u = lrel
if ne get fails 0 0
ret 1
end
nw = write 1 passm 0 len passm
if ne nw long len passm
ret 2
end
ret 0
end
