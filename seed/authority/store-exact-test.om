note SPDX-License-Identifier: AGPL-3.0-only
note Actual store parser accepts exact records and refuses one trailing byte.
text exactbuild "build"
text exactdir "build/authority-store"
text badrec "FAIL store trailing-record refusal\n"
text badgen "FAIL store trailing-generation refusal\n"
text exactpass "store exact checks=4 fails=0\n"
global exactfails ulong 1
global exacttail uchar 1
fn appendbyte to void
fd = fopen spath 0 get splen 0 1025 384
if lt fd 0
exit 90
end
put exacttail 0 165
n = write int fd exacttail 0 1
if ne fclose int fd 0
exit 91
end
if ne n 1
exit 92
end
end
fn main to int
mk = makedir exactbuild 0 len exactbuild 448
if not or eq mk 0 eq mk -17
ret 93
end
mk = makedir exactdir 0 len exactdir 448
if not or eq mk 0 eq mk -17
ret 94
end
r = new ulong 32 0
q = new ulong 32 0
put r 0 1
put r 4 1
if ne writerec r 0
ret 95
end
if ne readrec q 0
ret 96
end
setrec
appendbyte
if ne readrec q 22
put exactfails 0 add get exactfails 0 1
w = write 1 badrec 0 len badrec
if ne w long len badrec
ret 97
end
end
if ne writegen 1 0
ret 98
end
g = readgen
if or ne g 1 ne get sgerr 0 0
ret 99
end
setgen
appendbyte
g = readgen
if or ne g 0 ne get sgerr 0 32
put exactfails 0 add get exactfails 0 1
w = write 1 badgen 0 len badgen
if ne w long len badgen
ret 100
end
end
if ne get exactfails 0 0
ret 1
end
w = write 1 exactpass 0 len exactpass
if ne w long len exactpass
ret 101
end
ret 0
end
