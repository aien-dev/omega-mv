note arith: wrapping multiply-add hash h = h*31 + i and s = sum of ((i*i) xor (i >> 3)) rem 1000003,
note i = 0 .. 39999999, all ulong (unsigned wraps modulo 2^64). Prints h then s.
note OMC-EFF-2: main writes the nanoseconds between its two monons readings (the computation, without
note start-up and output) as one decimal line on stderr; stdout is unchanged.
om2
global obuf uchar 32
fn putnum fd int v ulong to void
put obuf 31 10
p = ulong 31
x = v
while gt x 9
p = sub p 1
put obuf p uchar add rem x 10 48
x = div x 10
end
p = sub p 1
put obuf p uchar add x 48
w = write fd obuf p sub 32 p
end
fn main to int
t0 = monons
h = ulong 0
s = ulong 0
for i ulong 40000000
h = add mul h 31 i
t = xor mul i i shr i 3
s = add s rem t 1000003
end
t1 = monons
putnum 2 ulong sub t1 t0
putnum 1 h
putnum 1 s
ret 0
end
