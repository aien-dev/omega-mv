note arith: wrapping multiply-add hash h = h*31 + i and s = sum of ((i*i) xor (i >> 3)) rem 1000003,
note i = 0 .. 39999999, all ulong (unsigned wraps modulo 2^64). Prints h then s.
global out uchar 32
fn putnum v ulong to void
put out 31 10
p = ulong 31
x = v
while gt x 9
p = sub p 1
put out p uchar add rem x 10 48
x = div x 10
end
p = sub p 1
put out p uchar add x 48
w = write 1 out p sub 32 p
end
fn main to int
h = ulong 0
s = ulong 0
for i ulong 40000000
h = add mul h 31 i
t = xor mul i i shr i 3
s = add s rem t 1000003
end
putnum h
putnum s
ret 0
end
