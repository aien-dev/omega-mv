note fib: doubly recursive Fibonacci of 38 (ulong); prints fib(38). Call and return heavy.
global out uchar 32
fn putnum v ulong to void
put out 31 10
p = ulong 31
x = v
while gt x 9
p = sub p 1
put out p uchar add rem x 10 48
x = div x 10
end
p = sub p 1
put out p uchar add x 48
w = write 1 out p sub 32 p
end
fn fib n ulong to ulong
if lt n 2
ret n
end
a = fib sub n 1
b = fib sub n 2
ret add a b
end
fn main to int
putnum fib 38
ret 0
end
