if eq get js q cl
put st 0 add q 1
put st 1 sub d 1
put st 2 2
ret 0
end
end
put st 0 q
put st 2 1
ret 0
end

fn jval js view uchar 4194304 n ulong wk edit ulong 65536 st edit ulong 32 to long
