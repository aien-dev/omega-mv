fn fail wk edit ulong 65536 code ulong pos ulong to long
put wk 0 code
put wk 2 pos
ret -1
end

fn failk wk edit ulong 65536 code ulong key ulong to long
put wk 0 code
put wk 1 key
ret -1
end

fn hexv c ulong to ulong
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
if and ge c 65 le c 70
ret sub c 55
end
ret 16
end

fn isws b uchar to bool
ret or or eq b 32 eq b 9 or eq b 10 eq b 13
end

fn isdig b uchar to bool
ret and ge b 48 le b 57
end

fn umin a ulong b ulong to ulong
if lt a b
ret a
end
ret b
end

note ---- string decoder (input already validated by pass 1); cursor c: 0 next byte, 1 pending count,
note ---- 2..4 pending UTF-8 bytes, 5 done. dnext gives a byte, or 256 at the closing quote.
fn dinit c edit ulong 8 so ulong to void
put c 0 so
put c 1 0
put c 5 0
if eq so 0
put c 5 1
end
end

fn hex4v js view uchar 4194304 p ulong to ulong
v = hexv ulong get js p
v = or shl v 4 hexv ulong get js add p 1
v = or shl v 4 hexv ulong get js add p 2
v = or shl v 4 hexv ulong get js add p 3
ret v
end

fn descv e uchar to ulong
if eq e 98
ret 8
end
if eq e 102
ret 12
end
if eq e 110
ret 10
end
if eq e 114
ret 13
end
if eq e 116
ret 9
end
ret ulong e
end

fn dutf c edit ulong 8 cp ulong to ulong
if lt cp 128
ret cp
end
if lt cp 2048
put c 2 or 128 and cp 63
put c 1 1
ret or 192 shr cp 6
end
if lt cp 65536
put c 2 or 128 and shr cp 6 63
put c 3 or 128 and cp 63
put c 1 2
ret or 224 shr cp 12
end
put c 2 or 128 and shr cp 12 63
put c 3 or 128 and shr cp 6 63
put c 4 or 128 and cp 63
put c 1 3
ret or 240 shr cp 18
end

fn dunic js view uchar 4194304 c edit ulong 8 to ulong
p = get c 0
cp = hex4v js p
put c 0 add p 4
if and ge cp 55296 le cp 56319
lo = hex4v js add p 6
put c 0 add p 10
cp = add 65536 add shl sub cp 55296 10 sub lo 56320
end
ret dutf c cp
end

fn dnext js view uchar 4194304 c edit ulong 8 to ulong
k = get c 1
if gt k 0
v = get c 2
put c 2 get c 3
put c 3 get c 4
put c 1 sub k 1
ret v
end
if eq get c 5 1
ret 256
end
p = get c 0
b = get js p
if eq b 34
put c 5 1
ret 256
end
if ne b 92
put c 0 add p 1
ret ulong b
end
e = get js add p 1
put c 0 add p 2
if eq e 117
ret dunic js c
end
ret descv e
end

note strcmp order: the end of a string sorts before every byte
fn dkey v ulong to ulong
if eq v 256
ret 0
end
ret add v 1
end

note strcmp of the decoded strings at content offsets x and y: -1, 0, 1
fn dcmp js view uchar 4194304 x ulong y ulong to long
ca = new ulong 8 0
cb = new ulong 8 0
dinit ca x
dinit cb y
for o ulong 16
k = ulong 0
while lt k 500000 bound 999999
u = dkey dnext js ca
v = dkey dnext js cb
if ne u v
if lt u v
ret -1
end
ret 1
end
if eq u 0
ret 0
end
k = add k 1
end
end
trap 4
end

note byte i of name-table entry whose length word is at wk b
fn nmbyte wk edit ulong 65536 b ulong i ulong to ulong
w = get wk add add b 1 shr i 3
sh = shl and i 7 3
ret and shr w sh 255
end

note decoded string at so equals name-table entry k
fn nameq js view uchar 4194304 wk edit ulong 65536 so ulong k ulong to bool
c = new ulong 8 0
dinit c so
b = add 128 mul k 5
nl = get wk b
i = ulong 0
while true bound 64
v = dnext js c
if eq v 256
ret eq i nl
end
if ge i nl
ret false
end
if ne v nmbyte wk b i
ret false
end
i = add i 1
end
ret false
end

note the raw bytes s[0..n) equal name-table entry k (tier lookup by C string)
fn rawname s view uchar 4194304 n ulong wk edit ulong 65536 k ulong to bool
b = add 128 mul k 5
if ne n get wk b
ret false
end
for i ulong n
if ne ulong get s i nmbyte wk b i
ret false
end
end
ret true
end

note statistics of one decoded string: 0 length, 1 index of the first ':', 2 non-hex bytes,
note 3 non-hex bytes after the first ':', 4 bytes outside [0-9a-f], 5 bytes that are not JSON
note whitespace, 6 first 8 bytes packed, 7 last 8 bytes lowercased, 8 holds test-only/test_only/testonly,
note 10 a ':' was seen
fn sstep a edit ulong 16 v ulong to void
i = get a 0
if eq hexv v 16
put a 2 add get a 2 1
if eq get a 10 1
put a 3 add get a 3 1
end
end
if not or and ge v 48 le v 57 and ge v 97 le v 102
put a 4 add get a 4 1
end
if not or or eq v 32 eq v 9 or eq v 10 eq v 13
put a 5 add get a 5 1
end
if lt i 8
put a 6 or get a 6 shl v shl i 3
end
if and eq v 58 eq get a 10 0
put a 10 1
put a 1 i
end
lc = v
if and ge v 65 le v 90
lc = add v 32
end
top = shr get a 7 56
w = or shl get a 7 8 lc
put a 7 w
if eq w 8387236824970325113
put a 8 1
end
if and eq top 116 or eq w 7310314358644305017 eq w 7310314573392669817
put a 8 1
end
put a 0 add i 1
end

fn sstat js view uchar 4194304 so ulong a edit ulong 16 to void
for i ulong 16
put a i 0
end
c = new ulong 8 0
dinit c so
for o ulong 16
k = ulong 0
while lt k 500000 bound 999999
v = dnext js c
if eq v 256
ret
end
sstep a v
k = add k 1
end
end
trap 4
end

note raw "" is the only JSON string that decodes empty (\u0000 is refused)
fn isempty js view uchar 4194304 so ulong to bool
if eq so 0
ret true
end
ret eq get js so 34
end

fn hex32ok js view uchar 4194304 so ulong to bool
a = new ulong 16 0
sstat js so a
ret and eq get a 0 64 eq get a 2 0
end

note ---- pass 1: the JSON syntax of the C reader (jvalue/jcontainer/jstring), iterative, same errors
note ---- and byte offsets. Codes 2..19 are its messages; nesting deeper than 6 is refused.
fn skipws js view uchar 4194304 n ulong p ulong to ulong
for o ulong 16
k = ulong 0
while lt k 500000 bound 999999
if ge p n
ret p
end
if not isws get js p
ret p
end
p = add p 1
k = add k 1
end
end
ret p
end

fn iscont js view uchar 4194304 p ulong to bool
ret eq and get js p 192 128
end

fn u3cp js view uchar 4194304 p ulong to ulong
a = shl and ulong get js p 15 12
b = shl and ulong get js add p 1 63 6
ret or or a b and ulong get js add p 2 63
end

fn u4cp js view uchar 4194304 p ulong to ulong
a = shl and ulong get js p 7 18
b = shl and ulong get js add p 1 63 12
c = shl and ulong get js add p 2 63 6
ret or or a b or c and ulong get js add p 3 63
end

note utf8_len: bytes of one valid UTF-8 sequence at p, 0 when invalid
fn utf8l js view uchar 4194304 n ulong p ulong to ulong
s = ulong get js p
if lt s 128
ret 1
end
av = sub n p
if and and ge s 194 le s 223 ge av 2
if iscont js add p 1
ret 2
end
end
if and and ge s 224 le s 239 ge av 3
if and iscont js add p 1 iscont js add p 2
cp = u3cp js p
if and ge cp 2048 not and ge cp 55296 le cp 57343
ret 3
end
end
end
if and and ge s 240 le s 244 ge av 4
if and and iscont js add p 1 iscont js add p 2 iscont js add p 3
cp = u4cp js p
if and ge cp 65536 le cp 1114111
ret 4
end
end
end
ret 0
end

note hex4 with its bounds check: the value, or 65536 when bad
fn hex4c js view uchar 4194304 n ulong p ulong to ulong
if gt add p 4 n
ret 65536
end
v = ulong 0
for k ulong 4
h = hexv ulong get js add p k
if eq h 16
ret 65536
end
v = or shl v 4 h
end
ret v
end

note \u escape, p just past the u: new offset or -1
fn junic js view uchar 4194304 n ulong wk edit ulong 65536 p ulong to long
cp = hex4c js n p
if eq cp 65536
ret fail wk 5 p
end
p = add p 4
if and ge cp 55296 le cp 56319
if gt add p 2 n
ret fail wk 6 p
end
if or ne get js p 92 ne get js add p 1 117
ret fail wk 6 p
end
p = add p 2
lo = hex4c js n p
if eq lo 65536
ret fail wk 7 p
end
if or lt lo 56320 gt lo 57343
ret fail wk 7 add p 4
end
ret long add p 4
end
if and ge cp 56320 le cp 57343
ret fail wk 6 p
end
if eq cp 0
ret fail wk 8 p
end
ret long p
end

fn simpesc e uchar to bool
x = or or eq e 34 eq e 92 or eq e 47 eq e 98
y = or or eq e 102 eq e 110 or eq e 114 eq e 116
ret or x y
end

note escape, p just past the backslash: new offset or -1
fn jesc js view uchar 4194304 n ulong wk edit ulong 65536 p ulong to long
