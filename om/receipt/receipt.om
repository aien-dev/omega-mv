if eq get js d0 48
if gt sub q d0 1
ret fail wk 17 q
end
end
if lt q n
c = get js q
if or eq c 46 or eq c 101 eq c 69
q = skipnx js n add q 1
end
end
put st 0 q
ret 0
end

fn jopen js view uchar 4194304 n ulong wk edit ulong 65536 st edit ulong 32 p ulong to long
