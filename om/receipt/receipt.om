note SPDX-License-Identifier: Apache-2.0
note receipt.om: seeded Omega port of src/omega_receipt.c (+ omega_receipt.h), the reader of the
note aien-proof EvidenceReceiptV1 wire contract: strict JSON parse (serde shape rules, deny unknown
note fields), every canonical_bytes validation, the canonical byte encoding and id = BLAKE3(canonical).
note Part of aien-dev/omega-mv#726, aien-dev/aien-architecture-mv#300 and #316.
note
note Library (everything above the parity-harness marker) uses no globals and no text, so each entry
note point can be cut into a function-mode unit for the omega-bridge native call ABI v1:
note   rcparse js n wk            0 ok, -1 refused (reason in wk 0..2)
note   rccanon js n wk out pos    after rcparse returned 0: total canonical length; canonical bytes
note                              [pos, pos + 1048576) into out 0.., id = BLAKE3(canonical) into out 1049600..
note   rcverify js n wk out       parse, recompute, require the id field to equal it (any hex case)
note   rctier s n wk              tier rank of the bytes s[0..n), -1 unknown
note   rcsat need have            the aien-proof tier_satisfies rule
note js is the receipt JSON (n bytes, at most 4 MiB, the C OMEGA_RECEIPT_MAX_BYTES).
note A refusal is a reason code (wk 0), a field-name index (wk 1, for messages that name a field) and a
note byte offset (wk 2, for JSON syntax messages). The parity harness renders the exact C message text.
note There is no DOM: pass 1 checks the JSON syntax exactly as the C reader does (same errors, same
note byte offsets); pass 2 reads fields by walking the validated text; strings are decoded on the fly.
note
note wk layout (ulong 65536): 0 code, 1 field, 2 byte offset, 3 n, 4 root offset, 5..7 sort scratch,
note 8..10 canonical emitter (bytes emitted, window start, chunk fill), 16+k value offset of top-level
note key k (0 absent), 64+k string content offset of top-level key k (0 = absent, reads as ""),
note 100 version, 101 timestamp, 102 dirty, 103 result, 104 tier rank, 105 declared mutation,
note 106 observed mutation, 107 has ledger, 108 ledger index, 109 ledger hash, 110 has lease,
note 111 lease hold_id, 112 lease resource, 113 assertion count, 114+j count of list j
note (0 input_artifacts, 1 output_artifacts, 2 dependencies, 3 external_refs, 4 required_features),
note 128.. name table (65 entries of 5 words: length, then up to 32 bytes packed little endian),
note 512..959 BLAKE3 chaining-value stack (952 depth, 953 chunks absorbed),
note 1024 + 4096 j list j string offsets, 21504 + 6 i assertion i (id expected observed pass source note),
note 46080 sort area, 50176 merge scratch.
note out layout (uchar 1049632): 0..1048575 canonical window, 1048576..1049599 BLAKE3 chunk,
note 1049600..1049631 computed id.

note Array lengths are literal numbers: function-mode units refuse `const` (error 9).

note ---- BLAKE3: copied from om/blake3/b3unit.om (no import in Omegese). Changes: the chaining-value
note ---- stack lives in wk at 512 (depth 952, count 953), the chunk is read from out at 1048576, and
note ---- the root bytes go to out at 1049600. The compression code is unchanged.
fn initw w edit ulong 128 to void
put w 83 1779033703
put w 84 3144134277
put w 85 1013904242
put w 86 2773480762
put w 87 1359893119
put w 88 2600822924
put w 89 528734635
put w 90 1541459225
put w 91 2
put w 92 6
put w 93 3
put w 94 10
put w 95 7
put w 96 0
put w 97 4
put w 98 13
put w 99 1
put w 100 11
put w 101 12
put w 102 5
put w 103 9
put w 104 14
put w 105 15
put w 106 8
end

note the G mixing function on state words a b c d with message words 2j and 2j+1
fn g w edit ulong 128 a ulong b ulong c ulong d ulong j ulong to void
x = get w add 16 mul j 2
t = add get w a get w b
put w a and add t x 4294967295
t = xor get w d get w a
put w d and or shr t 16 shl t 16 4294967295
put w c and add get w c get w d 4294967295
t = xor get w b get w c
put w b and or shr t 12 shl t 20 4294967295
x = get w add 17 mul j 2
t = add get w a get w b
put w a and add t x 4294967295
t = xor get w d get w a
put w d and or shr t 8 shl t 24 4294967295
put w c and add get w c get w d 4294967295
t = xor get w b get w c
put w b and or shr t 7 shl t 25 4294967295
end

fn round w edit ulong 128 to void
g w 0 4 8 12 0
g w 1 5 9 13 1
g w 2 6 10 14 2
g w 3 7 11 15 3
g w 0 5 10 15 4
g w 1 6 11 12 5
g w 2 7 8 13 6
g w 3 4 9 14 7
end

fn permute w edit ulong 128 to void
for i ulong 16
put w add 32 i get w add 16 get w add 91 i
end
for i ulong 16
put w add 16 i get w add 32 i
end
end

note the 16 little-endian words of blk into m
fn loadm w edit ulong 128 blk edit uchar 64 to void
for i ulong 16
o = mul i 4
v = ulong get blk add o 3
v = or shl v 8 ulong get blk add o 2
v = or shl v 8 ulong get blk add o 1
v = or shl v 8 ulong get blk o
put w add 16 i v
end
end

note compress (input chaining value, blk, block length, counter, flags) into the output words
fn compress w edit ulong 128 blk edit uchar 64 to void
loadm w blk
for i ulong 8
put w i get w add 48 i
put w add i 8 get w add 83 i
end
put w 12 and get w 73 4294967295
put w 13 and shr get w 73 32 4294967295
put w 14 get w 72
put w 15 get w 74
for r ulong 7
round w
permute w
end
for i ulong 8
put w add 56 i xor get w i get w add i 8
put w add 64 i xor get w add i 8 get w add 48 i
end
end

note compress, then the node chaining value is the first 8 output words
fn nodecv w edit ulong 128 blk edit uchar 64 to void
compress w blk
for i ulong 8
put w add 75 i get w add 56 i
end
end

note copy cnt bytes of b from offset o into blk, zero the rest
fn loadblk blk edit uchar 64 b edit uchar 1049632 o ulong cnt ulong to void
for i ulong 64
if lt i cnt
put blk i get b add 1048576 add o i
else
put blk i 0
end
end
end

fn setnb w edit ulong 128 bl ulong ctr ulong fl ulong to void
put w 72 bl
put w 73 ctr
put w 74 fl
end

note chunk ctr holding b[0..cnt): every block but the last compressed, the last left set up
fn chunk w edit ulong 128 blk edit uchar 64 b edit uchar 1049632 cnt ulong ctr ulong to void
for i ulong 8
put w add 48 i get w add 83 i
end
nblk = ulong 1
if gt cnt 0
nblk = div add cnt 63 64
end
k = ulong 0
while lt add k 1 nblk bound 16
loadblk blk b mul k 64 64
fl = ulong 0
if eq k 0
fl = 1
end
setnb w 64 ctr fl
compress w blk
for i ulong 8
put w add 48 i get w add 56 i
end
k = add k 1
end
bo = mul sub nblk 1 64
loadblk blk b bo sub cnt bo
fl = ulong 2
if eq nblk 1
fl = 3
end
setnb w sub cnt bo ctr fl
end

note parent node of stack row r (left) and the node chaining value (right), set up to compress
fn parentn w edit ulong 128 blk edit uchar 64 st edit ulong 65536 r ulong to void
for i ulong 8
put w add 48 i get w add 83 i
end
for i ulong 8
l = get st add 512 add mul r 8 i
v = get w add 75 i
for k ulong 4
sh = mul k 8
q = add mul i 4 k
put blk q uchar and shr l sh 255
put blk add 32 q uchar and shr v sh 255
end
end
setnb w 64 0 4
end

fn push w edit ulong 128 st edit ulong 65536 to void
p = get st 952
for i ulong 8
put st add 512 add mul p 8 i get w add 75 i
end
put st 952 add p 1
end

note a whole chunk that is not the last: merge completed subtrees, then push its chaining value
fn midchk w edit ulong 128 blk edit uchar 64 st edit ulong 65536 b edit uchar 1049632 to void
ctr = get st 953
chunk w blk b 1024 ctr
nodecv w blk
tot = add ctr 1
while eq and tot 1 0 bound 64
d = sub get st 952 1
put st 952 d
parentn w blk st d
nodecv w blk
tot = shr tot 1
end
push w st
put st 953 add ctr 1
end

note the last chunk: fold the stack into the root and write its 32 little-endian bytes into b at 1049600
fn lastchk w edit ulong 128 blk edit uchar 64 st edit ulong 65536 b edit uchar 1049632 n ulong to void
chunk w blk b n get st 953
while gt get st 952 0 bound 64
nodecv w blk
d = sub get st 952 1
put st 952 d
parentn w blk st d
end
put w 74 or get w 74 8
compress w blk
outle w b
end

note the first 8 output words, little endian, into o at 1049600 (the id slot)
fn outle w edit ulong 128 o edit uchar 1049632 to void
for i ulong 8
v = get w add 56 i
for k ulong 4
q = add mul i 4 k
put o add 1049600 q uchar and shr v mul k 8 255
end
end
end

