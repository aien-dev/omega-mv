if lt c 32
ret fail wk 3 p
end
if eq c 92
r = jesc js n wk add p 1
if lt r 0
ret r
end
p = ulong r
else
l = utf8l js n p
if eq l 0
ret fail wk 9 p
end
p = add p l
end
k = add k 1
end
end
trap 4
end

fn skipdig js view uchar 4194304 n ulong p ulong to ulong
