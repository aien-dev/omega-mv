note ---- canonical bytes, streamed: each byte goes to the window (when inside it) and to BLAKE3
fn b3mid wk edit ulong 65536 out edit uchar 1049632 to void
w = new ulong 128 0
blk = new uchar 64 0
initw w
midchk w blk wk out
end

fn b3fin wk edit ulong 65536 out edit uchar 1049632 to void
w = new ulong 128 0
blk = new uchar 64 0
initw w
lastchk w blk wk out get wk 10
end

fn eb wk edit ulong 65536 out edit uchar 1049632 v uchar to void
t = get wk 8
lo = get wk 9
if and ge t lo lt t add lo 1048576
put out sub t lo v
end
f = get wk 10
if eq f 1024
b3mid wk out
f = 0
end
put out add 1048576 f v
put wk 10 add f 1
put wk 8 add t 1
end

fn eu32 wk edit ulong 65536 out edit uchar 1049632 v ulong to void
eb wk out uchar and shr v 24 255
eb wk out uchar and shr v 16 255
eb wk out uchar and shr v 8 255
eb wk out uchar and v 255
end

fn eu64 wk edit ulong 65536 out edit uchar 1049632 v ulong to void
eu32 wk out shr v 32
eu32 wk out and v 4294967295
end

fn dlen js view uchar 4194304 so ulong to ulong
a = new ulong 16 0
sstat js so a
ret get a 0
end

note u64 length, then the decoded bytes
fn estr js view uchar 4194304 wk edit ulong 65536 out edit uchar 1049632 so ulong to void
eu64 wk out dlen js so
c = new ulong 8 0
dinit c so
for o ulong 16
k = ulong 0
while lt k 500000 bound 999999
v = dnext js c
if eq v 256
ret
end
eb wk out uchar v
k = add k 1
end
end
trap 4
end

note 64 hex digits (any case) as 32 raw bytes
fn ehex js view uchar 4194304 wk edit ulong 65536 out edit uchar 1049632 so ulong to void
c = new ulong 8 0
dinit c so
for i ulong 32
h = hexv dnext js c
l = hexv dnext js c
eb wk out uchar or shl h 4 l
end
end

note sort key of item it: mode wk 7 = 0 the item is a string offset, 1 an assertion index (its id)
fn skey wk edit ulong 65536 it ulong to ulong
if eq get wk 7 0
ret it
end
ret get wk add 21504 mul it 6
end

note take the left run's head next: i in the left run and (j past the right run or key i <= key j)
fn mleft js view uchar 4194304 wk edit ulong 65536 i ulong j ulong mid ulong hi ulong to bool
if ge i mid
ret false
end
if ge j hi
ret true
end
s = get wk 5
x = skey wk get wk add s i
y = skey wk get wk add s j
ret le dcmp js x y 0
end

fn mput wk edit ulong 65536 k ulong from ulong to void
put wk add get wk 6 k get wk add get wk 5 from
end

note merge wk[src+lo, src+mid) and wk[src+mid, src+hi) into dst (src wk 5, dst wk 6)
fn mrg js view uchar 4194304 wk edit ulong 65536 lo ulong mid ulong hi ulong to void
i = lo
j = mid
k = lo
while lt k hi bound 4097
if mleft js wk i j mid hi
mput wk k i
i = add i 1
else
mput wk k j
j = add j 1
end
k = add k 1
end
end

note bottom-up merge sort of wk[46080, 46080 + m) by skey, strcmp order
fn msort js view uchar 4194304 wk edit ulong 65536 m ulong to void
put wk 5 46080
put wk 6 50176
w = ulong 1
while lt w m bound 16
i = ulong 0
while lt i m bound 4097
mid = umin add i w m
hi = umin add i mul 2 w m
mrg js wk i mid hi
i = add i mul 2 w
end
s = get wk 5
put wk 5 get wk 6
put wk 6 s
w = mul w 2
end
if ne get wk 5 46080
for i ulong m
put wk add 46080 i get wk add 50176 i
end
end
end

note sorted item i differs from item i - 1 (BTreeSet: equal strings kept once)
fn isnew js view uchar 4194304 wk edit ulong 65536 i ulong to bool
if eq i 0
ret true
end
x = get wk add 46079 i
y = get wk add 46080 i
ret ne dcmp js x y 0
end

note sort list j into the sort area; the number of distinct strings
fn lsort js view uchar 4194304 wk edit ulong 65536 j ulong to ulong
m = get wk add 114 j
b = add 1024 mul j 4096
for i ulong m
put wk add 46080 i get wk add b i
end
put wk 7 0
msort js wk m
u = ulong 0
for i ulong m
if isnew js wk i
u = add u 1
end
end
ret u
end

note a sorted string set: u32 count, then each distinct string (hx 1: as 32 raw bytes)
fn eset js view uchar 4194304 wk edit ulong 65536 out edit uchar 1049632 j ulong hx bool to void
u = lsort js wk j
eu32 wk out u
for i ulong get wk add 114 j
if isnew js wk i
if hx
ehex js wk out get wk add 46080 i
else
estr js wk out get wk add 46080 i
end
end
end
end

fn eassert js view uchar 4194304 wk edit ulong 65536 out edit uchar 1049632 to void
m = get wk 113
for i ulong m
put wk add 46080 i i
end
put wk 7 1
msort js wk m
eu32 wk out m
for i ulong m
b = add 21504 mul get wk add 46080 i 6
estr js wk out get wk b
estr js wk out get wk add b 1
estr js wk out get wk add b 2
eb wk out uchar get wk add b 3
estr js wk out get wk add b 4
estr js wk out get wk add b 5
end
end

fn edomain wk edit ulong 65536 out edit uchar 1049632 to void
for i ulong 24
eb wk out uchar nmbyte wk 433 i
end
end

fn ehead js view uchar 4194304 wk edit ulong 65536 out edit uchar 1049632 to void
edomain wk out
eu32 wk out 1
estr js wk out get wk 67
estr js wk out get wk 68
eb wk out uchar get wk 103
estr js wk out get wk 71
estr js wk out get wk 72
eb wk out uchar get wk 102
estr js wk out get wk 74
estr js wk out get wk 75
estr js wk out get wk 76
estr js wk out get wk 77
end

fn etail js view uchar 4194304 wk edit ulong 65536 out edit uchar 1049632 to void
if eq get wk 107 1
eb wk out 1
eu64 wk out get wk 108
ehex js wk out get wk 109
else
eb wk out 0
end
if eq get wk 110 1
eb wk out 1
ehex js wk out get wk 111
estr js wk out get wk 112
else
eb wk out 0
end
eu64 wk out get wk 101
eset js wk out 4 false
eu32 wk out 0
end

note omega_receipt_canonical + compute_id, after rcparse returned 0 on the same js and wk
fn rccanon js view uchar 4194304 n ulong wk edit ulong 65536 out edit uchar 1049632 pos ulong to ulong
put wk 8 0
put wk 9 pos
put wk 10 0
for i ulong 448
put wk add 512 i 0
end
ehead js wk out
eset js wk out 0 false
eset js wk out 1 false
eassert js wk out
eset js wk out 2 true
eb wk out uchar get wk 105
eb wk out uchar get wk 106
estr js wk out get wk 84
ehex js wk out get wk 85
eset js wk out 3 false
etail js wk out
b3fin wk out
ret get wk 8
end

note omega_receipt_verify_bytes: parse, recompute, the id field must equal the result (any case)
fn rcverify js view uchar 4194304 n ulong wk edit ulong 65536 out edit uchar 1049632 to long
r = rcparse js n wk
if lt r 0
ret r
end
t = rccanon js n wk out 0
c = new ulong 8 0
dinit c get wk 66
same = true
for i ulong 32
h = hexv dnext js c
h = or shl h 4 hexv dnext js c
if ne h ulong get out add 1049600 i
same = false
end
end
if not same
ret fail wk 69 0
end
ret 0
end

note omega_tier_rank of the C string s[0..n)
fn rctier s view uchar 4194304 n ulong wk edit ulong 65536 to long
nminit wk
for k ulong 8
if rawname s n wk add 37 k
ret long k
end
end
ret -1
end

note omega_tier_satisfies (aien-proof chain.rs tier_satisfies)
fn rcsat need long have long to long
if or lt need 0 lt have 0
ret 0
end
if eq have 0
if eq need 0
ret 1
end
ret 0
end
if and ge need 4 lt have 4
ret 0
end
if ge have need
ret 1
end
ret 0
end

note ==== parity harness (program mode; not part of any unit: unit cutting stops at this line)
note stdin: records of a 25-byte header (op byte, then length, a, b as 8 decimal digits each) and
note length payload bytes. One output line per record, the same format as the C oracle driver:
note   R <parse rc> <message | canonical hex> <id hex | -> <verify rc> <message | id hex>
note   op R: the payload as is. op M: the payload holds the placeholder id (64 '0'): parse it, compute
note   the id, write it over the placeholder (b 257: upper case), then apply the mutation (b 1..255:
note   xor byte a with b; b 256: truncate to a bytes) and print the R line of the result; when the
note   placeholder is absent or the payload does not parse, the R line of the payload.
note   op T: T <omega_tier_rank of the payload>. op S: S then omega_tier_satisfies over -3 -1 0..8.
note Exit 65 on a short record.

text tmsgs "out of memory\nunterminated string\ncontrol character in string\nbad escape\nbad \\u escape\nlone surrogate\nbad surrogate pair\nNUL in string\ninvalid UTF-8\nnesting too deep\nexpected object key\nduplicate key\nexpected ':'\nexpected ',' or closing bracket\nunexpected end\nbad number\nleading zero\nunexpected character\ntrailing bytes after the receipt\nreceipt: empty or oversize input\nreceipt: top level must be an object\nreceipt: unknown field\nreceipt: missing field %\nreceipt: field % must be a string\nreceipt: field % must be a list\nreceipt: field % is too long\nreceipt: list % must hold strings\nreceipt: field % must be true or false\nreceipt: field % must be an unsigned integer\nreceipt: unknown mutation in %\nreceipt: version out of range\nreceipt: unknown receipt schema\nreceipt: unsupported receipt version\nreceipt: unknown required receipt feature\nreceipt: reserved field must be empty\nreceipt: kind must not be empty\nreceipt: repo must not be empty\nreceipt: commit must be 40 or 64 lowercase hex digits\nreceipt: procedure identity must not be empty\nreceipt: machine identity must not be empty\nreceipt: unknown tier\nreceipt: unknown result\nreceipt: env_class contradicts tier\nreceipt: unknown digest algorithm in %\nreceipt: bad digest hex in %\nreceipt: digest must be <algo>:<hex> or 64 hex digits in %\nreceipt: output_digest must be 64 hex digits\nreceipt: id must be 64 hex digits\nreceipt: assertions must be a list\nreceipt: an assertion must be an object\nreceipt: unknown assertion field\nreceipt: PASS receipts must carry at least one assertion\nreceipt: assertion id must not be empty\nreceipt: duplicate assertion id\nreceipt: dependency is not a 64 digit receipt hash\nreceipt: observed mutation exceeds declared mutation\nreceipt: tier cannot claim that observed mutation\nreceipt: a read-only run cannot claim that mutation\nreceipt: PRODUCTION receipts require an authority reference\nreceipt: a TEST_ONLY signer cannot produce a PRODUCTION receipt\nreceipt: ledger must be null or an object\nreceipt: unknown ledger field\nreceipt: ledger hash must be 64 hex digits\nreceipt: lease must be null or an object\nreceipt: unknown lease field\nreceipt: lease hold_id must be 64 hex digits\nreceipt: lease resource must not be empty\nreceipt: cannot compute canonical identity\nreceipt id mismatch: the file claims one id, its canonical bytes hash to another\n"
text tkeys "schema\nversion\nid\nkind\ntier\nresult\ntimestamp\nrepo\ncommit\ndirty\ntoolchain\nprocedure\nmachine\nenv_class\ninput_artifacts\noutput_artifacts\nassertions\ndependencies\ndeclared_mutation\nobserved_mutation\nauthority\noutput_digest\nexternal_refs\nledger\nlease\nrequired_features\nreserved\nid\nexpected\nobserved\npass\nsource\nnote\nindex\nhash\nhold_id\nresource\n"
text tjs "receipt JSON: "
text tat " at byte "
text ttab "\t"
text tnl "\n"
text tdash "-"
text tr "R"
text tt "T"
text ts "S"

fn wkey k ulong to void
s = ulong 0
ln = ulong 0
while lt ln k bound 64
while ne get tkeys s 10 bound 64
s = add s 1
end
s = add s 1
ln = add ln 1
end
e = s
while ne get tkeys e 10 bound 64
e = add e 1
end
r = write 1 tkeys s sub e s
end

note line k of tmsgs, '%' replaced by key name f
fn wmline k ulong f ulong to void
s = ulong 0
ln = ulong 0
while lt ln k bound 128
while ne get tmsgs s 10 bound 128
s = add s 1
end
s = add s 1
ln = add ln 1
end
b = s
while ne get tmsgs s 10 bound 128
if eq get tmsgs s 37
r = write 1 tmsgs b sub s b
wkey f
b = add s 1
end
s = add s 1
end
r = write 1 tmsgs b sub s b
end

fn wdec v ulong to void
d = new uchar 24 0
i = ulong 24
while true bound 24
i = sub i 1
put d i uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
r = write 1 d i sub 24 i
end

fn wsdec v long to void
if lt v 0
r = write 1 tdash 0 1
wdec ulong neg v
ret
end
wdec ulong v
end

fn wtab to void
r = write 1 ttab 0 1
end

fn wmsg wk edit ulong 65536 to void
c = get wk 0
if le c 19
r = write 1 tjs 0 len tjs
wmline sub c 1 0
r = write 1 tat 0 len tat
wdec get wk 2
ret
end
wmline sub c 1 get wk 1
end

fn hexc v ulong up bool to uchar
if lt v 10
ret uchar add v 48
end
if up
ret uchar add v 55
end
ret uchar add v 87
end

note out[off, off + cnt) as lower-case hex on stdout
fn ohex out edit uchar 1049632 off ulong cnt ulong hb edit uchar 65536 to void
p = off
e = add off cnt
while lt p e bound 64
m = umin sub e p 32768
for i ulong m
b = ulong get out add p i
put hb mul i 2 hexc shr b 4 false
put hb add mul i 2 1 hexc and b 15 false
end
r = write 1 hb 0 mul m 2
p = add p m
end
end

fn rline js view uchar 4194304 n ulong wk edit ulong 65536 out edit uchar 1049632 hb edit uchar 65536 to void
r = write 1 tr 0 1
wtab
pr = rcparse js n wk
wsdec pr
wtab
if lt pr 0
wmsg wk
wtab
r = write 1 tdash 0 1
else
t = rccanon js n wk out 0
ohex out 0 umin t 1048576 hb
pos = ulong 1048576
while lt pos t bound 16
t2 = rccanon js n wk out pos
ohex out 0 umin sub t pos 1048576 hb
pos = add pos 1048576
end
wtab
ohex out 1049600 32 hb
end
wtab
vr = rcverify js n wk out
wsdec vr
wtab
if lt vr 0
wmsg wk
else
ohex out 1049600 32 hb
end
r = write 1 tnl 0 1
end

note offset of the first run of 64 '0' bytes, n when none
fn findz js view uchar 4194304 n ulong to ulong
if gt n 4194304
ret n
end
run = ulong 0
i = ulong 0
for o ulong 16
k = ulong 0
while lt k 500000 bound 999999
if ge i n
ret n
end
if eq get js i 48
run = add run 1
if eq run 64
ret sub i 63
end
else
run = 0
end
i = add i 1
k = add k 1
end
end
ret n
end

note write the computed id (out 1049600) as hex over the placeholder at z
fn patchid js edit uchar 4194304 out edit uchar 1049632 z ulong up bool to void
for i ulong 32
v = ulong get out add 1049600 i
q = add z mul i 2
put js q hexc shr v 4 up
put js add q 1 hexc and v 15 up
end
end

note the mutation of record header (a, b); the new length
fn mutate js edit uchar 4194304 n ulong a ulong b ulong to ulong
if ge a n
ret n
end
if and ge b 1 le b 255
put js a xor get js a uchar b
end
if eq b 256
ret a
end
ret n
end

fn mline js edit uchar 4194304 n ulong wk edit ulong 65536 out edit uchar 1049632 hb edit uchar 65536 to void
z = findz js n
pr = long -1
if lt z n
pr = rcparse js n wk
end
if lt pr 0
rline js n wk out hb
ret
end
t = rccanon js n wk out 0
patchid js out z eq get wk 61 257
m = mutate js n get wk 60 get wk 61
rline js m wk out hb
end

fn tval i ulong to long
if eq i 0
ret -3
end
ret sub long i 2
end

fn sline to void
r = write 1 ts 0 1
for i ulong 11
for j ulong 11
wtab
wsdec rcsat tval i tval j
end
end
r = write 1 tnl 0 1
end

fn dorec js edit uchar 4194304 n ulong op uchar a ulong b ulong to void
wk = new ulong 65536 0
out = new uchar 1049632 0
hb = new uchar 65536 0
if eq op 84
r = write 1 tt 0 1
wtab
wsdec rctier js n wk
r = write 1 tnl 0 1
ret
end
if eq op 83
sline
ret
end
if eq op 77
put wk 60 a
put wk 61 b
mline js n wk out hb
ret
end
rline js n wk out hb
end

fn dec8 hd edit uchar 32 o ulong to ulong
v = ulong 0
for i ulong 8
v = add mul v 10 ulong sub get hd add o i 48
end
ret v
end

note read exactly n bytes into js; the count read
fn rdjs js edit uchar 4194304 n ulong to ulong
t = ulong 0
while lt t n bound 999999
r = read 0 js t sub n t
if le r 0
ret t
end
t = add t ulong r
end
ret t
end

fn rdhd hd edit uchar 32 to ulong
t = ulong 0
while lt t 25 bound 64
r = read 0 hd t sub 25 t
if le r 0
ret t
end
t = add t ulong r
end
ret t
end

fn drain n ulong to ulong
bf = new uchar 65536 0
t = ulong 0
while lt t n bound 999999
r = read 0 bf 0 umin sub n t 65536
if le r 0
ret t
end
t = add t ulong r
end
ret t
end

note one record: 0 done, 1 end of input, 2 short record
fn onerec js edit uchar 4194304 to ulong
hd = new uchar 32 0
h = rdhd hd
if eq h 0
ret 1
end
if ne h 25
ret 2
end
n = dec8 hd 1
if le n 4194304
if ne rdjs js n n
ret 2
end
else
if ne drain n n
ret 2
end
end
dorec js n get hd 0 dec8 hd 9 dec8 hd 17
ret 0
end

fn main to int
js = new uchar 4194304 0
while true bound 999999
s = onerec js
if eq s 1
ret 0
end
if eq s 2
ret 65
end
end
ret 0
end
