note H(0) (fixtures/sha256-iv.dec)
fn iv s edit uint 8 to void
put s 0 0x6a09e667
put s 1 0xbb67ae85
put s 2 0x3c6ef372
put s 3 0xa54ff53a
put s 4 0x510e527f
put s 5 0x9b05688c
put s 6 0x1f83d9ab
put s 7 0x5be0cd19
end

note FIPS 180-4 4.1.2: Sigma0, Sigma1, sigma0, sigma1 on 32-bit words
fn bsig0 x uint to uint
ret xor xor rotr x 2 rotr x 13 rotr x 22
end

fn bsig1 x uint to uint
ret xor xor rotr x 6 rotr x 11 rotr x 25
end

fn ssig0 x uint to uint
ret xor xor rotr x 7 rotr x 18 shr x 3
end

fn ssig1 x uint to uint
ret xor xor rotr x 17 rotr x 19 shr x 10
end

note message schedule of the block b
fn sched w edit uint 64 b view uchar 64 to void
for i ulong 16
q = mul i 4
v = uint get b q
v = or shl v 8 uint get b add q 1
v = or shl v 8 uint get b add q 2
put w i or shl v 8 uint get b add q 3
end
for i ulong 48
put w add i 16 add add add get w i get w add i 9 ssig0 get w add i 1 ssig1 get w add i 14
end
end

note the 64 rounds; Ch and Maj written as in the delivered unit
fn rounds s edit uint 8 w view uint 64 kt view uint 64 to void
a = get s 0
b = get s 1
c = get s 2
d = get s 3
e = get s 4
f = get s 5
g = get s 6
h = get s 7
t = uint 0
for i ulong 64
h = add h get kt i
h = add h get w i
h = add h bsig1 e
h = add h xor g and e xor f g
d = add d h
h = add h bsig0 a
t = and c or a b
h = add h or and a b t
t = h
h = g
g = f
f = e
e = d
d = c
c = b
b = a
a = t
end
put s 0 add get s 0 a
put s 1 add get s 1 b
put s 2 add get s 2 c
put s 3 add get s 3 d
put s 4 add get s 4 e
put s 5 add get s 5 f
put s 6 add get s 6 g
put s 7 add get s 7 h
end

fn hexd d uint to uchar
if lt d 10
ret uchar add d 48
end
ret uchar add d 87
end

note stdin -> lowercase hex digest and LF on stdout; a read error exits 2
note pad the k pending bytes of b (k < 64) and absorb the bit length of the n-byte message
fn finish s edit uint 8 w edit uint 64 kt view uint 64 b edit uchar 64 k ulong n ulong to void
put b k 0x80
for i ulong sub 63 k
put b add add k 1 i 0
end
if ge k 56
sched w b
rounds s w kt
for i ulong 56
put b i 0
end
end
bits = shl n 3
for i ulong 8
put b sub 63 i uchar and shr bits mul i 8 0xff
end
sched w b
rounds s w kt
end

note the digest of s as lowercase hex and LF on stdout
fn hexout s view uint 8 to void
o = new uchar 65 10
x = uint 0
for i ulong 32
x = get s shr i 2
x = and shr x sub 24 mul and i 3 8 0xff
put o mul i 2 hexd shr x 4
put o add mul i 2 1 hexd and x 15
end
z = write 1 o 0 65
end

fn main to int
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
b = new uchar 64 0
kinit kt
iv s
n = ulong 0
k = ulong 0
r = long 1
while gt r 0
r = read 0 b k sub 64 k
if lt r 0
exit 2
end
if gt r 0
k = add k ulong r
n = add n ulong r
if eq k 64
sched w b
rounds s w kt
k = 0
end
end
end
finish s w kt b k n
hexout s
ret 0
end
