note sha256-s3.om: REDUCED test unit for OM-2 compiler slice S3 (ledger L838). It is NOT the delivered
note unit om/sha256/sha256-om2.om and is never linked into the product. Built by gen.py.
note From the delivered unit, byte for byte: layout shactx, kinit, iv, rounds, finish, sha256_init (no
note export), sha256_final (o edit instead of out). sched (w fresh) and compress take m view uchar 128
note instead of the unsized view (S4); sha256_update takes (d view uchar 128, n) instead of len d.
note Reduced: absorb completes one pending block from at most 64 new bytes (no blocks/run, no part);
note program mode: stdin in chunks of 1, 64, 3, 55, 63, 56, 17 bytes with an empty update between,
note hex digest on stdout. Receipts in main (exit 3 on failure): a byte copy of the context taken
note after the third chunk and continued (erratum E3), and a context reused after a final (section 7).
om2

layout shactx 104
field state uint 8 at 0 little
field count ulong at 32 little
field buf uchar 64 at 40 little
end

fn kinit k edit uint 64 to void
put k 0 0x428a2f98
put k 1 0x71374491
put k 2 0xb5c0fbcf
put k 3 0xe9b5dba5
put k 4 0x3956c25b
put k 5 0x59f111f1
put k 6 0x923f82a4
put k 7 0xab1c5ed5
put k 8 0xd807aa98
put k 9 0x12835b01
put k 10 0x243185be
put k 11 0x550c7dc3
put k 12 0x72be5d74
put k 13 0x80deb1fe
put k 14 0x9bdc06a7
put k 15 0xc19bf174
put k 16 0xe49b69c1
put k 17 0xefbe4786
put k 18 0x0fc19dc6
put k 19 0x240ca1cc
put k 20 0x2de92c6f
put k 21 0x4a7484aa
put k 22 0x5cb0a9dc
put k 23 0x76f988da
put k 24 0x983e5152
put k 25 0xa831c66d
put k 26 0xb00327c8
put k 27 0xbf597fc7
put k 28 0xc6e00bf3
put k 29 0xd5a79147
put k 30 0x06ca6351
put k 31 0x14292967
put k 32 0x27b70a85
put k 33 0x2e1b2138
put k 34 0x4d2c6dfc
put k 35 0x53380d13
put k 36 0x650a7354
put k 37 0x766a0abb
put k 38 0x81c2c92e
put k 39 0x92722c85
put k 40 0xa2bfe8a1
put k 41 0xa81a664b
put k 42 0xc24b8b70
put k 43 0xc76c51a3
put k 44 0xd192e819
put k 45 0xd6990624
put k 46 0xf40e3585
put k 47 0x106aa070
put k 48 0x19a4c116
put k 49 0x1e376c08
put k 50 0x2748774c
put k 51 0x34b0bcb5
put k 52 0x391c0cb3
put k 53 0x4ed8aa4a
put k 54 0x5b9cca4f
put k 55 0x682e6ff3
put k 56 0x748f82ee
put k 57 0x78a5636f
put k 58 0x84c87814
put k 59 0x8cc70208
put k 60 0x90befffa
put k 61 0xa4506ceb
put k 62 0xbef9a3f7
put k 63 0xc67178f2
end

fn iv s edit uint 8 to void
put s 0 0x6a09e667
put s 1 0xbb67ae85
put s 2 0x3c6ef372
put s 3 0xa54ff53a
put s 4 0x510e527f
put s 5 0x9b05688c
put s 6 0x1f83d9ab
put s 7 0x5be0cd19
end

fn sched w edit uint 64 fresh m view uchar 128 o ulong to void
q = ulong 0
x = uint 0
y = uint 0
for i ulong 16 unroll
q = add o mul i 4
x = uint get m q
x = or shl x 8 uint get m add q 1
x = or shl x 8 uint get m add q 2
put w i or shl x 8 uint get m add q 3
end
for i ulong 48 unroll
x = get w add i 1
y = get w add i 14
x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
end
end

fn rounds s edit uint 8 w view uint 64 kt view uint 64 to void
a = get s 0
b = get s 1
c = get s 2
d = get s 3
e = get s 4
f = get s 5
g = get s 6
h = get s 7
t = uint 0
for i ulong 64 unroll
h = add h get kt i
h = add h get w i
t = xor rotr e 6 rotr e 11
t = xor t rotr e 25
h = add h t
h = add h xor g and e xor f g
d = add d h
t = xor rotr a 2 rotr a 13
t = xor t rotr a 22
h = add h t
t = and c or a b
h = add h or and a b t
t = h
h = g
g = f
f = e
e = d
d = c
c = b
b = a
a = t
end
put s 0 add get s 0 a
put s 1 add get s 1 b
put s 2 add get s 2 c
put s 3 add get s 3 d
put s 4 add get s 4 e
put s 5 add get s 5 f
put s 6 add get s 6 g
put s 7 add get s 7 h
end

fn compress s edit uint 8 w edit uint 64 kt view uint 64 m view uchar 128 o ulong to void
sched w m o
rounds s w kt
end

fn finish s edit uint 8 w edit uint 64 kt view uint 64 p edit uchar 128 k ulong n ulong to void
put p k 0x80
e = ulong 64
if ge k 56
e = 128
end
bits = shl n 3
for i ulong 8 unroll
put p sub e add i 1 uchar and shr bits mul i 8 0xff
end
compress s w kt view p 0
if eq e 128
compress s w kt view p 64
end
end

fn sha256_init c edit shactx to void
s = new uint 8 0
iv s
for i ulong 8 unroll
put c state i get s i
end
put c count 0
end

note REDUCED absorb: n new bytes with n >= 64 - bi and n <= 64; completes the pending block
fn absorb c edit shactx d view uchar 128 bi ulong n ulong to void
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
blk = new uchar 128 0
kinit kt
for i ulong 8 unroll
put s i get c state i
end
off = sub 64 bi
for i ulong bi
put blk i get c buf i
end
for i ulong off
put blk add bi i get d i
end
compress s w kt blk 0
for i ulong sub n off
put c buf i get d add off i
end
for i ulong 8 unroll
put c state i get s i
end
end

fn sha256_update c edit shactx d view uchar 128 n ulong to void
cnt = get c count
bi = and cnt 63
put c count add cnt n
if lt n sub 64 bi
for i ulong n
put c buf add bi i get d i
end
ret
end
absorb c d bi n
end

fn sha256_final c edit shactx o edit uchar 32 to void
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
p = new uchar 128 0
v = ulong 0
kinit kt
for i ulong 8 unroll
put s i get c state i
end
cnt = get c count
k = and cnt 63
for i ulong k
put p i get c buf i
end
finish s w kt p k cnt
for i ulong 8 unroll
v = ulong get s i
for j ulong 4 unroll
put o add mul i 4 j uchar and shr v sub 24 mul j 8 0xff
end
end
end

fn hexd d uint to uchar
if lt d 10
ret uchar add d 48
end
ret uchar add d 87
end

fn chunk j ulong to ulong
k = rem j 7
if eq k 0
ret 1
end
if eq k 1
ret 64
end
if eq k 2
ret 3
end
if eq k 3
ret 55
end
if eq k 4
ret 63
end
if eq k 5
ret 56
end
ret 17
end

fn copy a view uchar 104 b edit uchar 104 to void
for i ulong 104
put b i get a i
end
end

fn same a view uchar 32 b view uchar 32 to ulong
for i ulong 32
if ne get a i get b i
ret 0
end
end
ret 1
end

fn hexout o view uchar 32 to void
x = new uchar 65 10
for i ulong 32
put x mul i 2 hexd uint shr get o i 4
put x add mul i 2 1 hexd uint and get o i 15
end
z = write 1 x 0 65
end

fn main to int
c = new uchar 104 0
r = new uchar 104 0
k = new uchar 104 0
d = new uchar 128 0
o = new uchar 32 0
o2 = new uchar 32 0
o3 = new uchar 32 0
sha256_init r
sha256_update r d 50
sha256_update r d 50
sha256_final r o
sha256_init r
sha256_init c
j = ulong 0
got = long 1
while gt got 0
got = read 0 d 0 chunk j
if lt got 0
exit 2
end
sha256_update c d ulong got
sha256_update r d ulong got
if eq j 2
copy c k
end
if gt j 2
sha256_update k d ulong got
end
sha256_update c d 0
j = add j 1
end
if lt j 3
copy c k
end
sha256_final c o
sha256_final r o2
sha256_final k o3
if eq same o o2 0
exit 3
end
if eq same o o3 0
exit 3
end
hexout o
ret 0
end
