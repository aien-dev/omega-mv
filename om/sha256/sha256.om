fn tobuf c edit uchar 104 bi ulong b view uchar 4096 bo ulong n ulong to void
for i ulong n
put c add 40 add bi i get b add bo i
end
end

note absorb b[0..n), n <= 4096, exactly as src/sha256.c sha256_update does for that piece
fn absorb c edit uchar 104 b view uchar 4096 n ulong w edit ulong 64 to void
if gt n 4096
trap 3
end
h = new uint 8 0
cnt = getle c 32 8
bi = and cnt 63
putle c 32 8 add cnt n
off = ulong 0
if gt bi 0
lf = sub 64 bi
if lt n lf
tobuf c bi b 0 n
ret
end
tobuf c bi b 0 lf
loadh c h
schedc c w
rounds h w
storeh c h
off = lf
end
if le add off 64 n
loadh c h
while le add off 64 n bound 65
schedb b off w
rounds h w
off = add off 64
end
storeh c h
end
tobuf c 0 b off sub n off
end

fn init c edit uchar 104 to void
putle c 32 8 0
putle c 0 4 1779033703
putle c 4 4 3144134277
putle c 8 4 1013904242
putle c 12 4 2773480762
putle c 16 4 1359893119
putle c 20 4 2600822924
putle c 24 4 528734635
putle c 28 4 1541459225
end

note big-endian 64-bit bit count into p[0..8)
note the state words, big endian, into o
fn digest c edit uchar 104 o edit uchar 32 to void
for i ulong 8
v = getle c mul i 4 4
q = mul i 4
put o q uchar shr v 24
put o add q 1 uchar and shr v 16 255
put o add q 2 uchar and shr v 8 255
put o add q 3 uchar and v 255
end
end

note compress the context's own block buffer (bytes 40..103) into its hash words
fn compbuf c edit uchar 104 w edit ulong 64 to void
h = new uint 8 0
loadh c h
schedc c w
rounds h w
storeh c h
end

note zero buffer bytes s..e-1 (indices into the 64-byte block)
fn zbuf c edit uchar 104 s ulong e ulong to void
i = s
while lt i e bound 64
put c add 40 i 0
i = add i 1
end
end

note sha256_final of src/sha256.c, padding in place: 0x80, zeros to 56 mod 64 (one more block
note when the pending part is 56 bytes or more), the 64-bit big-endian bit count, then the digest.
note The count field is left as it was (src/sha256.c adds the padding to it; nothing reads it after).
fn final c edit uchar 104 o edit uchar 32 w edit ulong 64 to void
cnt = getle c 32 8
bi = and cnt 63
put c add 40 bi 128
zbuf c add bi 1 64
if ge bi 56
compbuf c w
zbuf c 0 56
end
bits = mul cnt 8
for i ulong 8
sh = mul sub 7 i 8
put c add 96 i uchar and shr bits sh 255
end
compbuf c w
digest c o
end

note IV into h
fn initiv h edit uint 8 to void
put h 0 uint 1779033703
put h 1 uint 3144134277
put h 2 uint 1013904242
put h 3 uint 2773480762
put h 4 uint 1359893119
put h 5 uint 2600822924
put h 6 uint 528734635
put h 7 uint 1541459225
end

note h, big endian, into o
fn digesth h edit uint 8 o edit uchar 32 to void
for i ulong 8
v = get h i
q = mul i 4
put o q uchar shr v 24
put o add q 1 uchar and shr v 16 255
put o add q 2 uchar and shr v 8 255
put o add q 3 uchar and v 255
end
end

note expand w[0..16) into the full 64-word schedule. Words are ulong cells whose low 32 bits are
note the value; bits above are don't-care, because add, and, xor and or give the right low 32 bits
note anyway. A rotate right by r of a 32-bit x is the low half of d >> r where d holds x in both
note halves (d = (x << 32) | low(x)); a plain shift right by n is d >> (32 + n).
fn expand w edit ulong 64 to void
for j ulong 48
i = add j 16
x = get w sub i 2
u = shl x 32
u = or u shr u 32
u = xor xor shr u 17 shr u 19 shr u 42
x = get w sub i 15
v = shl x 32
v = or v shr v 32
v = xor xor shr v 7 shr v 18 shr v 35
u = add u v
u = add u get w sub i 7
put w i add u get w sub i 16
end
end

note the padded tail b[off..n) (less than 64 bytes) written straight into schedule words:
note whole big-endian words, the word holding 0x80, zeros, the 64-bit bit count in words 14 and 15;
note a second block when the tail is 56 bytes or more
fn tail h edit uint 8 b view uchar 4096 off ulong n ulong w edit ulong 64 to void
r = sub n off
fw = shr r 2
for i ulong fw
q = add off mul i 4
v = ulong get b q
v = or shl v 8 ulong get b add q 1
v = or shl v 8 ulong get b add q 2
v = or shl v 8 ulong get b add q 3
put w i v
end
put w fw ulong partw b add off mul fw 4 and r 3
i = add fw 1
while lt i 16 bound 16
put w i 0
i = add i 1
end
if ge r 56
expand w
rounds h w
for j ulong 14
put w j 0
end
end
bits = mul n 8
put w 14 shr bits 32
put w 15 and bits 4294967295
expand w
rounds h w
end

note the big-endian word of nr (0..3) bytes of b at q, then 0x80, then zeros
fn partw b view uchar 4096 q ulong nr ulong to uint
v = uint 0
for j ulong nr
v = or shl v 8 uint get b add q j
end
v = or shl v 8 128
ret shl v mul sub 3 nr 8
end

note SHA-256 of b[0..n), n < 4096, with the state in locals only (sha256_hash's short path)
fn oneshot b view uchar 4096 n ulong o edit uchar 32 w edit ulong 64 to void
if ge n 4096
trap 3
end
h = new uint 8 0
initiv h
off = ulong 0
while le add off 64 n bound 64
schedb b off w
rounds h w
off = add off 64
end
tail h b off n w
digesth h o
end

fn omsha c edit uchar 104 b view uchar 4096 n ulong op ulong o edit uchar 32 w edit ulong 64 to void
if eq op 0
init c
ret
end
if eq op 1
absorb c b n w
ret
end
if eq op 2
final c o w
ret
end
if eq op 3
oneshot b n o w
ret
end
trap 9
end
