note H(0) (FIPS 180-4 5.3.3 SHA-256, 5.3.4 SHA-384, 5.3.5 SHA-512). Wolfram: fractional parts of
note sqrt(Prime[i]) * 2^32 (i 1..8), * 2^64 (i 1..8 for SHA-512, i 9..16 for SHA-384).
note Any other alg traps 9 (caller contract).
fn sha2_init c edit ulong * alg ulong to void
for i ulong 40
put c i 0
end
put c 9 alg
if eq alg 256
put c 0 0x6a09e667
put c 1 0xbb67ae85
put c 2 0x3c6ef372
put c 3 0xa54ff53a
put c 4 0x510e527f
put c 5 0x9b05688c
put c 6 0x1f83d9ab
put c 7 0x5be0cd19
ret
end
if eq alg 384
put c 0 0xcbbb9d5dc1059ed8
put c 1 0x629a292a367cd507
put c 2 0x9159015a3070dd17
put c 3 0x152fecd8f70e5939
put c 4 0x67332667ffc00b31
put c 5 0x8eb44a8768581511
put c 6 0xdb0c2e0d64f98fa7
put c 7 0x47b5481dbefa4fa4
ret
end
if eq alg 512
put c 0 0x6a09e667f3bcc908
put c 1 0xbb67ae8584caa73b
put c 2 0x3c6ef372fe94f82b
put c 3 0xa54ff53a5f1d36f1
put c 4 0x510e527fade682d1
put c 5 0x9b05688c2b3e6c1f
put c 6 0x1f83d9abfb41bd6b
put c 7 0x5be0cd19137e2179
ret
end
trap 9
end

note SHA-256 message schedule (FIPS 180-4 6.2.2 step 1) of the block m[o .. o+64).
fn sha2_s256 w edit uint 64 m view uchar * o ulong to void
q = ulong 0
x = uint 0
y = uint 0
for i ulong 16 unroll
q = add o mul i 4
x = uint get m q
x = or shl x 8 uint get m add q 1
x = or shl x 8 uint get m add q 2
put w i or shl x 8 uint get m add q 3
end
for i ulong 48 unroll
x = get w add i 1
y = get w add i 14
x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
end
end

note SHA-256 rounds (6.2.2 steps 2-4). Ch(e,f,g) = g xor (e and (f xor g)); Maj(a,b,c) =
note (a and b) or (c and (a or b)); Sigma1 = ROTR 6,11,25; Sigma0 = ROTR 2,13,22 (4.1.2).
fn sha2_r256 s edit uint 8 w view uint 64 kt view uint 64 to void
a = get s 0
b = get s 1
c = get s 2
d = get s 3
e = get s 4
f = get s 5
g = get s 6
h = get s 7
t = uint 0
for i ulong 64 unroll
h = add h get kt i
h = add h get w i
t = xor rotr e 6 rotr e 11
t = xor t rotr e 25
h = add h t
h = add h xor g and e xor f g
d = add d h
t = xor rotr a 2 rotr a 13
t = xor t rotr a 22
h = add h t
t = and c or a b
h = add h or and a b t
t = h
h = g
g = f
f = e
e = d
d = c
c = b
b = a
a = t
end
put s 0 add get s 0 a
put s 1 add get s 1 b
put s 2 add get s 2 c
put s 3 add get s 3 d
put s 4 add get s 4 e
put s 5 add get s 5 f
put s 6 add get s 6 g
put s 7 add get s 7 h
end

note the whole 64-byte blocks of m (len m a multiple of 64, at most 2^25) into c's chaining value
fn sha2_b256 c edit ulong * m view uchar * to void
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
sha2_k256 kt
for i ulong 8 unroll
put s i uint get c i
end
for j ulong shr len m 6
sha2_s256 w m shl j 6
sha2_r256 s w kt
end
for i ulong 8 unroll
put c i ulong get s i
put s i 0
end
for i ulong 64
put w i 0
end
end

note SHA-512 message schedule (6.4.2 step 1) of the block m[o .. o+128); sigma0 = ROTR 1,8 SHR 7,
note sigma1 = ROTR 19,61 SHR 6 (4.1.3).
fn sha2_s512 w edit ulong 80 m view uchar * o ulong to void
q = ulong 0
x = ulong 0
y = ulong 0
for i ulong 16 unroll
q = add o mul i 8
x = ulong get m q
x = or shl x 8 ulong get m add q 1
x = or shl x 8 ulong get m add q 2
x = or shl x 8 ulong get m add q 3
x = or shl x 8 ulong get m add q 4
x = or shl x 8 ulong get m add q 5
x = or shl x 8 ulong get m add q 6
put w i or shl x 8 ulong get m add q 7
end
for i ulong 64 unroll
x = get w add i 1
y = get w add i 14
x = add add get w i get w add i 9 xor xor rotr x 1 rotr x 8 shr x 7
put w add i 16 add x xor xor rotr y 19 rotr y 61 shr y 6
end
end

note SHA-512 rounds (6.4.2 steps 2-4), a rolled loop (unroll allows at most 64 copies); Sigma1 = ROTR 14,18,41; Sigma0 = ROTR 28,34,39 (4.1.3).
fn sha2_r512 s edit ulong 8 w view ulong 80 kt view ulong 80 to void
a = get s 0
b = get s 1
c = get s 2
d = get s 3
e = get s 4
f = get s 5
g = get s 6
h = get s 7
t = ulong 0
for i ulong 80
h = add h get kt i
h = add h get w i
t = xor rotr e 14 rotr e 18
t = xor t rotr e 41
h = add h t
h = add h xor g and e xor f g
d = add d h
t = xor rotr a 28 rotr a 34
t = xor t rotr a 39
h = add h t
t = and c or a b
h = add h or and a b t
t = h
h = g
g = f
f = e
e = d
d = c
c = b
b = a
a = t
end
put s 0 add get s 0 a
put s 1 add get s 1 b
put s 2 add get s 2 c
put s 3 add get s 3 d
put s 4 add get s 4 e
put s 5 add get s 5 f
put s 6 add get s 6 g
put s 7 add get s 7 h
end

note the whole 128-byte blocks of m (len m a multiple of 128, at most 2^25) into c
fn sha2_b512 c edit ulong * m view uchar * to void
s = new ulong 8 0
w = new ulong 80 0
kt = new ulong 80 0
sha2_k512 kt
for i ulong 8 unroll
put s i get c i
end
for j ulong shr len m 7
sha2_s512 w m shl j 7
sha2_r512 s w kt
end
for i ulong 8 unroll
put c i get s i
put s i 0
end
for i ulong 80
put w i 0
end
end

note whole blocks of m (len m a multiple of the block size) in runs of at most 2^25 bytes
fn sha2_run c edit ulong * m view uchar * to void
n = len m
q = ulong 0
k = ulong 0
while lt q n bound 999999
k = sub n q
if gt k 0x2000000
k = 0x2000000
end
if eq get c 9 256
sha2_b256 c part m q k
else
sha2_b512 c part m q k
end
q = add q k
end
end

note pending byte i (i < 128) of the packed buffer
fn sha2_bget c view ulong * i ulong to uchar
x = shr get c add 16 shr i 3 sub 56 shl and i 7 3
ret uchar and x 0xff
end

note set pending byte i of the packed buffer to v
fn sha2_bput c edit ulong * i ulong v uchar to void
q = add 16 shr i 3
sh = sub 56 shl and i 7 3
x = and get c q not shl ulong 0xff sh
put c q or x shl ulong v sh
end

note the bytes m[0..k) into the buffer at bi (bi + k <= block size)
fn sha2_fill c edit ulong * bi ulong m view uchar * k ulong to void
for i ulong k
sha2_bput c add bi i get m i
end
end

fn sha2_update c edit ulong * m view uchar * to void
blk = new uchar 128 0
n = len m
cnt = get c 8
bs = ulong 128
if eq get c 9 256
bs = 64
end
bi = and cnt sub bs 1
put c 8 add cnt n
off = ulong 0
if gt bi 0
off = sub bs bi
if lt n off
off = n
end
sha2_fill c bi m off
if eq add bi off bs
for i ulong bs
put blk i sha2_bget c i
end
sha2_run c part blk 0 bs
for i ulong bs
put blk i 0
end
end
end
nb = and sub n off not sub bs 1
sha2_run c part m off nb
off = add off nb
sha2_fill c 0 part m off sub n off sub n off
end

note H(N) as big-endian bytes: 32 (SHA-256, 8 words of 32 bits), 48 (SHA-384, first 6 words), 64
fn sha2_put c view ulong * o edit uchar * to ulong
alg = get c 9
sh = ulong 0
if eq alg 256
for i ulong 32
sh = sub 24 shl and i 3 3
put o i uchar and shr get c shr i 2 sh 0xff
end
ret 32
end
dl = ulong 64
if eq alg 384
dl = 48
end
for i ulong dl
sh = sub 56 shl and i 7 3
put o i uchar and shr get c shr i 3 sh 0xff
end
ret dl
end

note padding (FIPS 180-4 5.1.1 / 5.1.2): 0x80, zeros, the bit length big-endian in the last 8 (SHA-256)
note or 16 (SHA-384/512) bytes of one or two blocks; returns the digest length
fn sha2_fin c edit ulong * o edit uchar * to ulong
p = new uchar 256 0
bs = ulong 128
ls = ulong 16
if eq get c 9 256
bs = 64
ls = 8
end
cnt = get c 8
k = and cnt sub bs 1
for i ulong k
put p i sha2_bget c i
end
put p k 0x80
e = bs
if ge add k ls bs
e = shl bs 1
end
x = shl cnt 3
for i ulong 8 unroll
put p sub e add i 1 uchar and shr x mul i 8 0xff
end
put p sub e 9 uchar shr cnt 61
sha2_run c part p 0 e
for i ulong 256
put p i 0
end
ret sha2_put c o
end

fn sha256_init c edit ulong * to void
sha2_init c 256
end

fn sha384_init c edit ulong * to void
sha2_init c 384
end

fn sha512_init c edit ulong * to void
sha2_init c 512
end

fn sha256_update c edit ulong * m view uchar * to void
sha2_update c m
end

fn sha384_update c edit ulong * m view uchar * to void
sha2_update c m
end

fn sha512_update c edit ulong * m view uchar * to void
sha2_update c m
end

fn sha256_final c edit ulong * o edit uchar * to void
dl = sha2_fin c o
end

fn sha384_final c edit ulong * o edit uchar * to void
dl = sha2_fin c o
end

fn sha512_final c edit ulong * o edit uchar * to void
dl = sha2_fin c o
end

fn sha2_copy d edit ulong * s view ulong * to void
for i ulong len s
put d i get s i
end
end

fn sha2_digest alg ulong m view uchar * o edit uchar * to ulong
c = new ulong 40 0
if ne alg 256
if ne alg 384
if ne alg 512
ret 0
end
end
end
sha2_init c alg
sha2_update c m
dl = sha2_fin c o
for i ulong 40
put c i 0
end
ret dl
end
