note SPDX-License-Identifier: Apache-2.0
note bench.om: 1 MiB AEAD_CHACHA20_POLY1305 round trip, built as `om2`, chacha.om, bench.om.
note key = bytes 0..31, nonce = bytes 32..43 (kn[i] = i), aad = 12 bytes 160..171, plaintext byte i =
note (31 i + 7) mod 256. Writes the sealed buffer (1 MiB ciphertext || tag) to stdout once, then
note opens and reseals it ROUNDS times, checking every open returns 0 with the plaintext restored
note and the resealed buffer equal to the first. Exit 0 when all checks hold, 1 otherwise. run.sh
note compares the stdout bytes with an independent oracle and times the whole run:
note (1 + 2 ROUNDS) MiB pass through the AEAD.

const BROUNDS ulong 16

note fill b[0..1 MiB) with the pattern
fn bfill b edit uchar * to void
for h ulong 16
for l ulong 65536
i = add shl h 16 l
put b i uchar and add mul i 31 7 255
end
end
end

note number of bytes of b[0..1 MiB) that differ from the pattern
fn bcheck b view uchar * to ulong
d = ulong 0
for h ulong 16
for l ulong 65536
i = add shl h 16 l
if ne get b i uchar and add mul i 31 7 255
d = add d 1
end
end
end
ret d
end

note number of bytes where a and b differ (same length)
fn bdiff a view uchar * b view uchar * to ulong
d = ulong 0
for h ulong 17
for l ulong 65536
i = add shl h 16 l
if lt i len a
if ne get a i get b i
d = add d 1
end
end
end
end
ret d
end

fn main to int
b = new uchar 1048592 0
c = new uchar 1048592 0
kn = new uchar 44 0
ad = new uchar 12 0
for i ulong 44
put kn i uchar i
end
for i ulong 12
put ad i uchar add i 160
end
bfill b
bad = aead_chacha_seal kn ad b
for h ulong 17
for l ulong 65536
i = add shl h 16 l
if lt i len b
put c i get b i
end
end
end
t = ulong 0
while lt t len b bound 999999
w = write 1 b t sub len b t
if le w 0
ret 1
end
t = add t ulong w
end
for j ulong BROUNDS
bad = or bad aead_chacha_open kn ad b
bad = or bad bcheck part b 0 1048576
bad = or bad aead_chacha_seal kn ad b
bad = or bad bdiff b c
end
if ne bad 0
ret 1
end
ret 0
end
