note SPDX-License-Identifier: Apache-2.0
note driver.om: program-mode test driver for om/tls/sha2.om and om/tls/hkdf.om (run.sh writes om2,
note then sha2.om, hkdf.om, this file). Reads records from stdin (at most 8 MiB), one per line, fields
note separated by one space, byte strings in hex ("-" = empty), alg = 256 | 384 | 512:
note   H alg MSG MD              sha2_digest one-shot, and the public init/update/final with random
note                             chunk sizes 0..256 (2 checks)
note   M alg SEED MD0 .. MD99    NIST SHAVS Monte Carlo (100 checks)
note   G alg N MD                N generated bytes (byte i = (7i + 3) mod 256) streamed in random
note                             chunks of 0..999982 bytes (1 check)
note   T alg KEY MSG TAG V       HMAC with hmac_update split at the middle; the first len TAG bytes
note                             are compared; V 1 = must match, 0 = must not (1 check); for V 1 also
note                             the negative control: one MSG (or KEY) byte flipped must not match
note   P alg SALT IKM PRK        hkdf_extract (1 check)
note   X alg SALT IKM INFO L OKM V   hkdf_extract then hkdf_expand to L bytes; V 1 = returns 0 and
note                             OKM matches, then one OKM byte flipped must not match (2 checks);
note                             V 0 = hkdf_expand must refuse (nonzero, 1 check)
note Lines that are empty or start with # are skipped. Prints "MISMATCH line L" (wrong result) or
note "BAD line L" (malformed record), then "sha2 driver: C checks, F failed". Exit 0 only when F is 0
note and C > 0; 1 otherwise; 2 when the input cannot be read or exceeds 8 MiB.

global inp uchar 8388608
global st ulong 8
global ob uchar 32
global one uchar 1
text tfail "MISMATCH line "
text tbad "BAD line "
text tsum "sha2 driver: "
text tchk " checks, "
text tfld " failed\n"
text tnl "\n"
text tio "sha2 driver: cannot read input or input over 8 MiB\n"

note st: 0 input length, 1 cursor, 2 line number, 3 malformed flag, 4 line start, 5 checks, 6 failed

fn drslurp to int
t = ulong 0
while true bound 999999
room = sub len inp t
if eq room 0
r = read 0 one 0 1
if ne r 0
ret 2
end
break
end
r = read 0 inp t room
if lt r 0
ret 2
end
if eq r 0
break
end
t = add t ulong r
end
put st 0 t
ret 0
end

fn drpeek to ulong
c = get st 1
if ge c get st 0
ret 256
end
ret ulong get inp c
end

fn dradv to void
put st 1 add get st 1 1
end

fn drbad to void
put st 3 1
end

fn drhexv c ulong to ulong
if ge c 48
if le c 57
ret sub c 48
end
end
if ge c 97
if le c 102
ret sub c 87
end
end
if ge c 65
if le c 70
ret sub c 55
end
end
ret 16
end

fn drbyte to uchar
hi = drhexv drpeek
dradv
lo = drhexv drpeek
dradv
if gt hi 15
drbad
ret 0
end
if gt lo 15
drbad
ret 0
end
ret uchar or shl hi 4 lo
end

fn drsp to void
if ne drpeek 32
drbad
ret
end
dradv
end

note a decimal number (at most 9 digits) after one space
fn drnum to ulong
drsp
v = ulong 0
k = ulong 0
while true bound 10
c = drpeek
if lt c 48
break
end
if gt c 57
break
end
v = add mul v 10 sub c 48
k = add k 1
dradv
end
if eq k 0
drbad
end
if gt k 9
drbad
end
ret v
end

note one space, then hex bytes into a[0..n) (or "-"); returns n
fn drhex a edit uchar * to ulong
drsp
if eq drpeek 45
dradv
ret 0
end
n = ulong 0
while true bound 999999
if gt drhexv drpeek 15
break
end
if ge n len a
drbad
ret n
end
put a n drbyte
n = add n 1
end
if eq n 0
drbad
end
ret n
end

fn dreor to void
if eq drpeek 13
dradv
end
c = drpeek
if eq c 10
dradv
ret
end
if ne c 256
drbad
end
end

fn drskip to void
while true bound 999999
c = drpeek
if eq c 256
ret
end
dradv
if eq c 10
ret
end
end
end

fn drprn v ulong to void
x = v
k = ulong 0
while true bound 21
put ob sub 31 k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
r = write 1 ob sub 32 k k
end

fn drmsg bad ulong to void
if eq bad 1
r = write 1 tbad 0 len tbad
else
r = write 1 tfail 0 len tfail
end
drprn get st 2
r = write 1 tnl 0 1
end

note one check: ok 1 passes, anything else fails (and is reported)
fn drchk ok ulong to void
put st 5 add get st 5 1
if ne ok 1
put st 6 add get st 6 1
drmsg 0
end
end

note 1 when a[0..n) equals b[0..n) (n <= both lengths), else 0
fn dreq a view uchar * b view uchar * n ulong to ulong
if gt n len a
ret 0
end
if gt n len b
ret 0
end
d = uchar 0
for i ulong n
d = or d xor get a i get b i
end
if eq d 0
ret 1
end
ret 0
end

note digest length of alg, 0 when alg is not one of ours (the record is malformed)
fn drdl alg ulong to ulong
if eq alg 256
ret 32
end
if eq alg 384
ret 48
end
if eq alg 512
ret 64
end
drbad
ret 0
end

fn drini alg ulong c edit ulong * to void
if eq alg 256
sha256_init c
end
if eq alg 384
sha384_init c
end
if eq alg 512
sha512_init c
end
end

fn drupd alg ulong c edit ulong * m view uchar * to void
if eq alg 256
sha256_update c m
end
if eq alg 384
sha384_update c m
end
if eq alg 512
sha512_update c m
end
end

fn drfin alg ulong c edit ulong * o edit uchar * to void
if eq alg 256
sha256_final c o
end
if eq alg 384
sha384_final c o
end
if eq alg 512
sha512_final c o
end
end

note next state of the 64-bit LCG (Knuth MMIX constants)
fn drlcg x ulong to ulong
ret add mul x 6364136223846793005 1442695040888963407
end

note digest of m through the public streaming API in chunks of 0..256 bytes chosen by the LCG
fn drsplit alg ulong m view uchar * o edit uchar * sd ulong to void
c = new ulong 40 0
drini alg c
x = sd
q = ulong 0
n = len m
k = ulong 0
while lt q n bound 999999
x = drlcg x
k = rem shr x 33 257
if gt k sub n q
k = sub n q
end
drupd alg c part m q k
q = add q k
end
drfin alg c o
end

fn drrech a edit uchar * ex edit uchar * to void
dg = new uchar 64 0
alg = drnum
dl = drdl alg
n = drhex a
e = drhex ex
dreor
if eq get st 3 1
ret
end
if ne e dl
drbad
ret
end
k = sha2_digest alg part a 0 n dg
drchk dreq dg ex dl
for i ulong 64
put dg i 0
end
drsplit alg part a 0 n dg get st 2
drchk dreq dg ex dl
end

note SHAVS Monte inner loop: a[0..3 dl) holds MD(i-3) || MD(i-2) || MD(i-1); 1000 steps; MD1002 in dg
fn drmc alg ulong a edit uchar * dg edit uchar 64 to void
dl = shr alg 3
e = ulong 0
for c ulong 1000
e = sha2_digest alg part a 0 mul dl 3 dg
for i ulong shl dl 1
put a i get a add i dl
end
for i ulong dl
put a add i shl dl 1 get dg i
end
end
end

note SHAVS Monte: MD0 = MD1 = MD2 = Seed; MDi = H(MD(i-3) || MD(i-2) || MD(i-1)), i = 3..1002;
note checkpoint j is MD1002, which is the next Seed
fn drrecm a edit uchar * ex edit uchar * b edit uchar * to void
dg = new uchar 64 0
alg = drnum
dl = drdl alg
e = drhex ex
if ne e dl
drbad
end
if eq get st 3 1
ret
end
for j ulong 100
for i ulong dl
put a i get ex i
put a add i dl get ex i
put a add i shl dl 1 get ex i
end
drmc alg a dg
e = drhex b
if eq get st 3 1
ret
end
if ne e dl
drbad
ret
end
drchk dreq dg b dl
for i ulong dl
put ex i get dg i
end
end
dreor
end

note a[0..k) = bytes q .. q+k-1 of the generated message, byte i = (7 i + 3) mod 256
fn drgen a edit uchar * q ulong k ulong to void
for i ulong k
put a i uchar and add mul add q i 7 3 0xff
end
end

note generated message of n bytes, byte i = (7 i + 3) mod 256, in LCG chunks of 0..999982 bytes
fn drrecg a edit uchar * ex edit uchar * to void
c = new ulong 40 0
dg = new uchar 64 0
alg = drnum
k = drdl alg
n = drnum
q = drhex ex
dreor
if eq get st 3 1
ret
end
if ne q drdl alg
drbad
ret
end
drini alg c
x = get st 2
q = 0
k = 0
while lt q n bound 999999
x = drlcg x
k = rem shr x 33 999983
if gt k sub n q
k = sub n q
end
drgen a q k
drupd alg c part a 0 k
q = add q k
end
drfin alg c dg
drchk dreq dg ex shr alg 3
end

note HMAC with key a[0..kl) over a[kl..len a), hmac_update split at the middle, tag to dg
fn drmac alg ulong a view uchar * kl ulong dg edit uchar 64 to void
c = new ulong 96 0
n = sub len a kl
h = shr n 1
hmac_init alg c part a 0 kl
hmac_update c part a kl h
hmac_update c part a add kl h sub n h
k = hmac_final c dg
end

note code = alg + 1024 * V; a = KEY || MSG; e = expected tag (prefix compared)
fn drtev code ulong a edit uchar * kl ulong e view uchar * to void
dg = new uchar 64 0
alg = and code 1023
drmac alg a kl dg
if eq shr code 10 1
drchk dreq dg e len e
if gt len a kl
put a kl xor get a kl 1
else
put a 0 xor get a 0 1
end
drmac alg a kl dg
end
drchk xor dreq dg e len e 1
end

fn drrect a edit uchar * ex edit uchar * to void
alg = drnum
kl = drhex a
n = drhex part a kl sub len a kl
tl = drhex ex
v = drnum
dreor
if eq get st 3 1
ret
end
if gt v 1
drbad
ret
end
if gt tl drdl alg
drbad
ret
end
if eq get st 3 1
ret
end
drtev add alg shl v 10 part a 0 add kl n kl part ex 0 tl
end

fn drrecp a edit uchar * ex edit uchar * to void
dg = new uchar 64 0
alg = drnum
dl = drdl alg
sl = drhex a
il = drhex part a sl sub len a sl
pl = drhex ex
dreor
if eq get st 3 1
ret
end
if ne pl dl
drbad
ret
end
k = hkdf_extract alg part a 0 add sl il sl dg
m = dreq dg ex dl
if ne k dl
m = 0
end
drchk m
end

note p: 0 alg, 1 salt length, 2 ikm length, 3 info length, 4 okm length; a = SALT || IKM || INFO.
note hkdf_extract into pi = PRK || INFO, then hkdf_expand into o[0..p[4]); returns hkdf_expand's code
fn drxev p view ulong 8 a view uchar * o edit uchar * to ulong
pi = new uchar 65600 0
dl = shr get p 0 3
s = add get p 1 get p 2
n = hkdf_extract get p 0 part a 0 s get p 1 pi
n = add dl get p 3
for i ulong get p 3
put pi add dl i get a add s i
end
ret hkdf_expand get p 0 part pi 0 n dl part o 0 get p 4
end

fn drrecx a edit uchar * ex edit uchar * to void
o = new uchar 16384 0
p = new ulong 8 0
put p 0 drnum
k = drdl get p 0
put p 1 drhex a
k = get p 1
put p 2 drhex part a k sub len a k
k = add k get p 2
put p 3 drhex part a k sub len a k
put p 4 drnum
put p 5 drhex ex
put p 6 drnum
dreor
if eq get st 3 1
ret
end
if gt get p 4 len o
drbad
ret
end
if gt get p 6 1
drbad
ret
end
rc = drxev p a o
if eq get p 6 0
if ne rc 0
drchk 1
else
drchk 0
end
ret
end
k = get p 4
m = dreq o ex k
if ne rc 0
m = 0
end
if ne get p 5 k
m = 0
end
drchk m
if gt k 0
put o 0 xor get o 0 1
drchk xor dreq o ex k 1
end
end

fn drrec a edit uchar * b edit uchar * ex edit uchar * to void
c = drpeek
dradv
if eq c 72
drrech a ex
ret
end
if eq c 77
drrecm a ex b
ret
end
if eq c 71
drrecg a ex
ret
end
if eq c 84
drrect a ex
ret
end
if eq c 80
drrecp a ex
ret
end
if eq c 88
drrecx a ex
ret
end
drbad
end

fn main to int
a = new uchar 1048576 0
b = new uchar 65536 0
ex = new uchar 65536 0
if ne drslurp 0
r = write 2 tio 0 len tio
ret 2
end
put st 1 0
put st 2 0
put st 5 0
put st 6 0
while lt get st 1 get st 0 bound 999999
put st 2 add get st 2 1
put st 3 0
put st 4 get st 1
c = drpeek
if eq c 35
drskip
else
if eq c 10
dradv
else
drrec a b ex
if eq get st 3 1
put st 5 add get st 5 1
put st 6 add get st 6 1
drmsg 1
put st 1 get st 4
drskip
end
end
end
end
r = write 1 tsum 0 len tsum
drprn get st 5
r = write 1 tchk 0 len tchk
drprn get st 6
r = write 1 tfld 0 len tfld
if ne get st 6 0
ret 1
end
if eq get st 5 0
ret 1
end
ret 0
end
