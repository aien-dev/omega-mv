   if (afl->afl_env.afl_crash_exitcode) {
 
-    long exitcode = strtol(afl->afl_env.afl_crash_exitcode, NULL, 10);
+    char *range_end = NULL;
+    long  exitcode = strtol(afl->afl_env.afl_crash_exitcode, &range_end, 10);
+    long  exitcode_hi = exitcode;
+    /* omega-mv om/tls/test/fuzz patch: "LO-HI" makes every exit code in
+       [LO, HI] a crash (Omega program-mode traps exit 100 + code 1..14) */
+    if (range_end && *range_end == '-') {
+
+      exitcode_hi = strtol(range_end + 1, NULL, 10);
+      if (exitcode_hi < exitcode || exitcode_hi > 255) {
+
+        FATAL("Invalid crash exitcode range %s", afl->afl_env.afl_crash_exitcode);
+
+      }
+
+    }
+
     if ((!exitcode && (errno == EINVAL || errno == ERANGE)) ||
