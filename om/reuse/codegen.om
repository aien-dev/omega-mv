note SPDX-License-Identifier: Apache-2.0
note codegen.om (drive.om only, cg prefix): the methods.om source text of REUSE-1 contract 3.2 and
note 12 for the templates in CGSH[0..CGK) (AGG shape ids in admission order, then FSM = 1, K3).
note Needs sha256 (omsha) before it. Output: CGO[0..CGN); per template t the bytes of its
note functions (mtl<t> and mtr<t> for AGG, mtr<t> for FSM) in CGSB[t] and their SHA-256 in
note CGSD[4t..4t+4) (words big endian, contract 1.1), embedded again by mtsrc. Deterministic: the
note text depends only on CGK, CGSH and CGMUT. Control mutants (CGMUT bits, context decision 1, K10):
note 1 = c1 (mtfind compares AGG shape ids with the wl byte cleared), 2 = c1b (every wl-16 mtl ends
note with v = and v 255), 4 = c1c (mtl reads c_j from R1P word 5 + 2j instead of 4 + 2j).
global CGO uchar 1048576
global CGN ulong 1
global CGK ulong 1
global CGSH ulong 16
global CGMUT ulong 1
global CGSB ulong 16
global CGSD ulong 64
text CGTHDR "note SPDX-License-Identifier: Apache-2.0\nnote methods.om: generated by om/reuse/codegen.om (REUSE-1 contract 3.2 and 12). Do not edit.\n"
text CGTL1 "fn mtl"
text CGTL2 " x ulong to ulong\nv = x\n"
text CGTO1 "v = and add v get R1P "
text CGTO2 "v = and sub v get R1P "
text CGTO3 "v = and mul v get R1P "
text CGTO4 "v = and v get R1P "
text CGTO5 "v = or v get R1P "
text CGTO6 "v = xor v get R1P "
text CGTO7 "v = and shl v get R1P "
text CGTO8 "v = shr v get R1P "
text CGTB "v = and v 255\n"
text CGTRV "ret v\nend\n"
text CGTR1 "fn mtr"
text CGTA2 " to void\nf = get R1P 3\nn = get R1N 0\nacc = r1ident f\nfor i ulong n\nacc = r1fold f acc mtl"
text CGTA3 " get R1X i\nend\nput R1R 0 acc\nput R1R 1 n\nend\n"
text CGTF2 " to void\nq = get R1P 4\nn = get R1N 0\nsum = ulong 0\nfor i ulong n\nq = get R1T add mul q 16 get R1X i\nsum = add sum get R1P add 6 q\nend\nput R1R 0 q\nput R1R 1 sum\nend\n"
text CGTC "fn mtcount to ulong\nret "
text CGTNE "\nend\n"
text CGTS1 "fn mtshape t ulong to ulong\n"
text CGTIF "if eq t "
text CGTRET "ret "
text CGTE "end\n"
text CGTR0 "ret 0\nend\n"
text CGTF1 "fn mtfind to long\nif ne r1valid 0\nret -1\nend\ns = r1shape\n"
text CGTIFS "if eq s "
text CGTIFM "if eq and s 18446744073709551360 "
text CGTRM1 "ret -1\nend\n"
text CGTLN1 "fn mtlane t ulong x ulong to ulong\n"
text CGTRML "ret mtl"
text CGTLN2 " x\nend\n"
text CGTRN1 "fn mtrun t ulong to void\n"
text CGTMTR "mtr"
text CGTRN2 "\nret\nend\n"
text CGTRN3 "r1full\nend\n"
text CGTD1 "fn mtsrc t ulong D edit ulong 4 to void\n"
text CGTPD "put D "
text CGTRT "ret\nend\n"
text CGTDZ "put D 0 0\nput D 1 0\nput D 2 0\nput D 3 0\nend\n"

fn cgc c ulong to void
n = get CGN 0
put CGO n uchar c
put CGN 0 add n 1
end

fn cgnum v ulong to void
d = new uchar 24 0
n = ulong 0
x = v
while true bound 24
put d n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
break
end
end
while gt n 0 bound 24
n = sub n 1
cgc ulong get d n
end
end

note fixed text k (see the table in cgtx2 / cgtx3 for k above 16)
fn cgtx k ulong to void
if gt k 16
cgtx2 k
ret
end
if eq k 1
for i ulong len CGTHDR
cgc ulong get CGTHDR i
end
end
if eq k 2
for i ulong len CGTL1
cgc ulong get CGTL1 i
end
end
if eq k 3
for i ulong len CGTL2
cgc ulong get CGTL2 i
end
end
if eq k 4
for i ulong len CGTO1
cgc ulong get CGTO1 i
end
end
if eq k 5
for i ulong len CGTO2
cgc ulong get CGTO2 i
end
end
if eq k 6
for i ulong len CGTO3
cgc ulong get CGTO3 i
end
end
if eq k 7
for i ulong len CGTO4
cgc ulong get CGTO4 i
end
end
if eq k 8
for i ulong len CGTO5
cgc ulong get CGTO5 i
end
end
if eq k 9
for i ulong len CGTO6
cgc ulong get CGTO6 i
end
end
if eq k 10
for i ulong len CGTO7
cgc ulong get CGTO7 i
end
end
if eq k 11
for i ulong len CGTO8
cgc ulong get CGTO8 i
end
end
if eq k 12
for i ulong len CGTB
cgc ulong get CGTB i
end
end
if eq k 13
for i ulong len CGTRV
cgc ulong get CGTRV i
end
end
if eq k 14
for i ulong len CGTR1
cgc ulong get CGTR1 i
end
end
if eq k 15
for i ulong len CGTA2
cgc ulong get CGTA2 i
end
end
if eq k 16
for i ulong len CGTA3
cgc ulong get CGTA3 i
end
end
end

fn cgtx2 k ulong to void
if gt k 32
cgtx3 k
ret
end
if eq k 17
for i ulong len CGTF2
cgc ulong get CGTF2 i
end
end
if eq k 18
for i ulong len CGTC
cgc ulong get CGTC i
end
end
if eq k 19
for i ulong len CGTNE
cgc ulong get CGTNE i
end
end
if eq k 20
for i ulong len CGTS1
cgc ulong get CGTS1 i
end
end
if eq k 21
for i ulong len CGTIF
cgc ulong get CGTIF i
end
end
if eq k 22
for i ulong len CGTRET
cgc ulong get CGTRET i
end
end
if eq k 23
for i ulong len CGTE
cgc ulong get CGTE i
end
end
if eq k 24
for i ulong len CGTR0
cgc ulong get CGTR0 i
end
end
if eq k 25
for i ulong len CGTF1
cgc ulong get CGTF1 i
end
end
if eq k 26
for i ulong len CGTIFS
cgc ulong get CGTIFS i
end
end
if eq k 27
for i ulong len CGTIFM
cgc ulong get CGTIFM i
end
end
if eq k 28
for i ulong len CGTRM1
cgc ulong get CGTRM1 i
end
end
if eq k 29
for i ulong len CGTLN1
cgc ulong get CGTLN1 i
end
end
if eq k 30
for i ulong len CGTRML
cgc ulong get CGTRML i
end
end
if eq k 31
for i ulong len CGTLN2
cgc ulong get CGTLN2 i
end
end
if eq k 32
for i ulong len CGTRN1
cgc ulong get CGTRN1 i
end
end
end

fn cgtx3 k ulong to void
if eq k 33
for i ulong len CGTMTR
cgc ulong get CGTMTR i
end
end
if eq k 34
for i ulong len CGTRN2
cgc ulong get CGTRN2 i
end
end
if eq k 35
for i ulong len CGTRN3
cgc ulong get CGTRN3 i
end
end
if eq k 36
for i ulong len CGTD1
cgc ulong get CGTD1 i
end
end
if eq k 37
for i ulong len CGTPD
cgc ulong get CGTPD i
end
end
if eq k 38
for i ulong len CGTRT
cgc ulong get CGTRT i
end
end
if eq k 39
for i ulong len CGTDZ
cgc ulong get CGTDZ i
end
end
end

fn cgbswap x ulong to ulong
y = or shl and x 71777214294589695 8 and shr x 8 71777214294589695
y = or shl and y 281470681808895 16 and shr y 16 281470681808895
ret or shl y 32 shr y 32
end

note CGO[p..p+n) into buf
fn cgfill buf edit uchar 4096 p ulong n ulong to void
for i ulong n
put buf i get CGO add p i
end
end

note SHA-256 of CGO[a..b) into CGSD[4t..4t+4)
fn cghash a ulong b ulong t ulong to void
c = new uchar 104 0
buf = new uchar 4096 0
w = new ulong 64 0
b8 = new ulong 512 0
omsha c buf 0 0 w b8
p = a
while lt p b bound 999999
n = sub b p
if gt n 4096
n = 4096
end
cgfill buf p n
omsha c buf n 1 w b8
p = add p n
end
omsha c buf 0 2 w b8
for j ulong 4
put CGSD add mul t 4 j cgbswap get w j
end
end

note one AGG step: op (1..8), constant word cw, mask m
fn cgop op ulong cw ulong m ulong to void
cgtx add op 3
cgnum cw
if or le op 3 eq op 7
cgc 32
cgnum m
end
cgc 10
end

note the functions of template t (shape s)
fn cgtmpl t ulong s ulong to void
if eq s 1
cgtx 14
cgnum t
cgtx 17
ret
end
mut = get CGMUT 0
wl = and s 255
m = ulong 255
if eq wl 16
m = 65535
end
cgtx 2
cgnum t
cgtx 3
nk = and shr s 12 15
for j ulong nk
op = and shr s add 16 mul j 4 15
cw = add 6 mul j 2
if ne and mut 4 0
cw = add cw 1
end
cgop op cw m
end
if and eq wl 16 ne and mut 2 0
cgtx 12
end
cgtx 13
cgtx 14
cgnum t
cgtx 15
cgnum t
cgtx 16
end

fn cgshapes k ulong to void
cgtx 20
for t ulong k
cgtx 21
cgnum t
cgc 10
cgtx 22
cgnum get CGSH t
cgc 10
cgtx 23
end
cgtx 24
end

fn cgfind k ulong to void
mut = get CGMUT 0
cgtx 25
for t ulong k
s = get CGSH t
if or eq s 1 eq and mut 1 0
cgtx 26
cgnum s
else
cgtx 27
cgnum and s 18446744073709551360
end
cgc 10
cgtx 22
cgnum t
cgc 10
cgtx 23
end
cgtx 28
end

fn cglane k ulong to void
cgtx 29
for t ulong k
if ne get CGSH t 1
cgtx 21
cgnum t
cgc 10
cgtx 30
cgnum t
cgtx 31
end
end
cgtx 24
end

fn cgrun k ulong to void
cgtx 32
for t ulong k
cgtx 21
cgnum t
cgc 10
cgtx 33
cgnum t
cgtx 34
end
cgtx 35
end

fn cgsrc k ulong to void
cgtx 36
for t ulong k
cgtx 21
cgnum t
cgc 10
for j ulong 4
cgtx 37
cgnum j
cgc 32
cgnum get CGSD add mul t 4 j
cgc 10
end
cgtx 38
end
cgtx 39
end

note generate methods.om into CGO; 0 ok, 1 bad input (K > 16 or a shape that is neither FSM nor a
note well-formed AGG shape id)
fn cggen to int
k = get CGK 0
if gt k 16
ret 1
end
for t ulong k
if ne cgcheck get CGSH t 0
ret 1
end
end
put CGN 0 0
cgtx 1
for t ulong k
st = get CGN 0
cgtmpl t get CGSH t
put CGSB t sub get CGN 0 st
cghash st get CGN 0 t
end
for t ulong 16
if ge t k
put CGSB t 0
for j ulong 4
put CGSD add mul t 4 j 0
end
end
end
cgtx 18
cgnum k
cgtx 19
cgshapes k
cgfind k
cglane k
cgrun k
cgsrc k
ret 0
end

note 0 when s is FSM (1) or an AGG shape id wl + 256 f + 4096 k + 65536 sum op_j 16^(j-1)
note with wl 8 or 16, f 1..6, k 1..6, op_j 1..8 for j <= k and no other bits
fn cgcheck s ulong to int
if eq s 1
ret 0
end
wl = and s 255
f = and shr s 8 15
nk = and shr s 12 15
if and ne wl 8 ne wl 16
ret 1
end
if or lt f 1 gt f 6
ret 1
end
if or lt nk 1 gt nk 6
ret 1
end
ops = shr s 16
for j ulong 6
op = and shr ops mul j 4 15
if lt j nk
if or lt op 1 gt op 8
ret 1
end
end
if and ge j nk ne op 0
ret 1
end
end
if ne shr ops 24 0
ret 1
end
ret 0
end
