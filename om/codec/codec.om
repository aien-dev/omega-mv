note ---- text building in a 256-byte line (messages and format_text lines) ----

note k (<= 8) bytes of the little-endian packed word v at p; returns p + k
fn sput l edit uchar 256 p ulong v ulong k ulong to ulong
for i ulong k
put l add p i uchar and shr v mul i 8 255
end
ret add p k
end

fn sdec l edit uchar 256 p ulong v ulong to ulong
d = new uchar 20 0
n = ulong 0
while true bound 21
put d n uchar add rem v 10 48
n = add n 1
v = div v 10
if eq v 0
break
end
end
for i ulong n
put l add p i get d sub sub n 1 i
end
ret add p n
end

fn hexdig v ulong to ulong
if lt v 10
ret add v 48
end
ret add v 87
end

note %0<m>x
fn shex l edit uchar 256 p ulong v ulong m ulong to ulong
n = ulong 1
while lt n 16 bound 16
if eq shr v mul n 4 0
break
end
n = add n 1
end
if lt n m
n = m
end
for i ulong n
sh = mul sub sub n 1 i 4
put l add p i uchar hexdig and shr v sh 15
end
ret add p n
end

note 64 hex digits of the id of the object at X base b (zero when it has none)
fn sid l edit uchar 256 p ulong x view ulong 20544 b ulong to ulong
for i ulong 4
v = get x add add b 10 i
for t ulong 16
sh = mul sub 15 t 4
put l add p t uchar hexdig and shr v sh 15
end
p = add p 16
end
ret p
end

note 64 hex digits of 32 wire bytes at o
fn swhex l edit uchar 256 p ulong w view uchar 2097152 o ulong to ulong
for i ulong 32
c = ulong get w add o i
put l p uchar hexdig shr c 4
put l add p 1 uchar hexdig and c 15
p = add p 2
end
ret p
end

fn snul l edit uchar 256 p ulong to void
put l p 0
end

note ---- validate (omega_validate_object / omega_validate_graph) ----

note find_object_by_id: the first object with has_id whose id is t; -1 when none
fn findid x view ulong 20544 t0 ulong t1 ulong t2 ulong t3 ulong to long
n = get x 0
for j ulong n
b = ob j
if eq get x add b 9 1
if eq get x add b 10 t0
if eq get x add b 11 t1
if eq get x add b 12 t2
if eq get x add b 13 t3
ret long j
end
end
end
end
end
end
ret -1
end

note find by the id stored in the payload of object j at byte p (C reads it through the payload struct)
fn findp w view uchar 2097152 x view ulong 20544 j ulong p ulong to long
t0 = pw64 w x j p
t1 = pw64 w x j add p 8
t2 = pw64 w x j add p 16
t3 = pw64 w x j add p 24
ret findid x t0 t1 t2 t3
end

fn findw w view uchar 2097152 x view ulong 20544 o ulong to long
t0 = be64 w o
t1 = be64 w add o 8
t2 = be64 w add o 16
t3 = be64 w add o 24
ret findid x t0 t1 t2 t3
end

note kind of the found object; 256 when not found (and/or evaluate both sides, so callers test f < 0
note and the kind in one condition)
fn kindof x view ulong 20544 f long to ulong
if lt f 0
ret 256
end
ret get x add ob ulong f 2
end

fn vfail e edit uchar 256 p ulong to long
snul e p
ret -1
end

fn vattr w view uchar 2097152 x view ulong 20544 b ulong e edit uchar 256 to long
na = get x add b 3
for i ulong na
o = get x add add b 14 i
if eq ekl w o ulong get w sub o 1 0
p = mattr e 0
ret vfail e sdec e p i
end
end
ret 0
end

fn vrels w view uchar 2097152 x view ulong 20544 b ulong e edit uchar 256 to long
nr = get x add b 4
for i ulong nr
o = add get x add b 5 mul i 34
k = be16 w o
if or eq k 0 gt k 9
p = mrelk e 0
p = shex e p k 4
p = matidx e p
ret vfail e sdec e p i
end
if lt findw w x add o 2 0
p = mdang e 0
ret vfail e swhex e p w add o 2
end
end
ret 0
end

fn vcons w view uchar 2097152 x view ulong 20544 b ulong e edit uchar 256 to long
nc = get x add b 6
for i ulong nc
k = be16 w get x add add b 46 i
if or eq k 0 gt k 9
p = mconk e 0
p = shex e p k 4
p = matidx e p
ret vfail e sdec e p i
end
end
ret 0
end

note "<pre>%u<post>" for a width message: 0 unsigned, 1 signed, 2 bitvector, 3 fp32, 4 sequence length
fn vwmsg e edit uchar 256 t ulong v ulong to long
p = ulong 0
if eq t 0
p = muint e 0
end
if eq t 1
p = msint e 0
end
if eq t 2
p = mbitv e 0
end
if eq t 3
p = mfp32 e 0
end
if eq t 4
p = mseql e 0
end
p = sdec e p v
if eq t 1
p = mob2 e p
end
if eq t 3
p = mnot32 e p
end
if eq t 4
p = mexc e p
end
if or eq t 0 eq t 2
p = mob1 e p
end
ret vfail e p
end

fn vtype w view uchar 2097152 x view ulong 20544 j ulong e edit uchar 256 to long
b = ob j
pl = get x add b 7
if lt pl 44
p = mtshort e 0
p = sdec e p pl
ret vfail e mbytes e p
end
tag = pu32 w x b 0
if or eq tag 0 gt tag 14
p = mtag e 0
ret vfail e shex e p tag 2
end
wd = pu16 w x b 4
if and eq tag 3 or lt wd 1 gt wd 256
ret vwmsg e 0 wd
end
if and eq tag 4 or lt wd 2 gt wd 256
ret vwmsg e 1 wd
end
if and eq tag 14 ne wd 32
ret vwmsg e 3 wd
end
if and eq tag 5 or lt wd 1 gt wd 256
ret vwmsg e 2 wd
end
if eq tag 7
ln = pu32 w x b 8
if gt ln 65535
ret vwmsg e 4 ln
end
f = findp w x j 12
if or lt f 0 ne kindof x f 2
p = mseqe e 0
ret vfail e p
end
end
ret 0
end

fn vvalue w view uchar 2097152 x view ulong 20544 j ulong e edit uchar 256 to long
b = ob j
pl = get x add b 7
if lt pl 98
p = mvshort e 0
p = sdec e p pl
ret vfail e mbytes e p
end
f = findp w x j 0
if or lt f 0 ne kindof x f 2
p = mvtype e 0
ret vfail e p
end
tb = ob ulong f
tag = pu32 w x tb 0
if or or eq tag 3 eq tag 4 eq tag 5
wd = pu16 w x tb 4
ex = div add wd 7 8
bl = pu16 w x b 32
if ne bl ex
p = mvlen1 e 0
p = sdec e p bl
p = mvlen2 e p
p = sdec e p wd
p = mvlen3 e p
p = sdec e p ex
ret vfail e mbytes e p
end
end
ret 0
end

fn voper w view uchar 2097152 x view ulong 20544 j ulong e edit uchar 256 to long
b = ob j
pl = get x add b 7
if ge pl 204
opc = pu32 w x b 0
if or eq opc 0 gt opc 16
p = mopc e 0
ret vfail e shex e p opc 2
end
ov = pu32 w x b 4
if or eq ov 0 gt ov 3
p = movf e 0
ret vfail e p
end
ret 0
end
if lt pl 161
ret 0
end
f = findp w x j 0
if or lt f 0 ne kindof x f 3
p = mapop e 0
ret vfail e p
end
n = plb w x b 32
for i ulong n
f = findp w x j add 33 mul i 32
if lt f 0
p = maparg e 0
p = sdec e p i
ret vfail e maparg2 e p
end
k = kindof x f
if and ne k 1 ne k 3
p = maparg e 0
p = sdec e p i
ret vfail e maparg2 e p
end
end
ret 0
end

fn veff w view uchar 2097152 x view ulong 20544 j ulong e edit uchar 256 to long
b = ob j
r = effchk w x b
if eq r 0
ret 0
end
p = meff e 0
if eq r -2
p = mefflen e p
end
if eq r -3
p = meffv1 e p
end
if eq r -4
p = meffres e p
end
if eq r -5
p = meffprm e p
end
if eq r -6
p = meffpad e p
end
p = mparen e p
p = sdec e p get x add b 7
ret vfail e mbytes e p
end

fn vobj w view uchar 2097152 x view ulong 20544 j ulong e edit uchar 256 to long
b = ob j
k = get x add b 2
if or eq k 0 gt k 11
p = mkind e 0
ret vfail e shex e p k 2
end
r = vattr w x b e
if ne r 0
ret r
end
r = vrels w x b e
if ne r 0
ret r
end
r = vcons w x b e
if ne r 0
ret r
end
if eq k 2
ret vtype w x j e
end
if eq k 1
ret vvalue w x j e
end
if eq k 3
ret voper w x j e
end
if eq k 8
ret veff w x j e
end
ret 0
end

note target of step a of the walk from object i into fr 1280..1283: phase 0 relation a, phase 1
note apply operand a (read through the 161-byte ApplyPayload view, past the payload when a > 29).
note false when that phase has no step a.
fn dtgt w view uchar 2097152 x view ulong 20544 i ulong ph ulong a ulong fr edit ulong 1284 to bool
b = ob i
if eq ph 0
if ge a get x add b 4
ret false
end
o = add add get x add b 5 mul a 34 2
for t ulong 4
put fr add 1280 t be64 w add o mul t 8
end
ret true
end
if or ne get x add b 2 3 lt get x add b 7 161
ret false
end
if ge a plb w x b 32
ret false
end
p = add 33 mul a 32
for t ulong 4
put fr add 1280 t pw64 w x i add p mul t 8
end
ret true
end

note the first j >= j0 whose id equals the target in fr 1280..1283; -1 when none
fn dscan x view ulong 20544 fr view ulong 1284 j0 ulong to long
n = get x 0
j = j0
while lt j n bound 257
b = ob j
if eq get x add b 9 1
if eq get x add b 10 get fr 1280
if eq get x add b 11 get fr 1281
if eq get x add b 12 get fr 1282
if eq get x add b 13 get fr 1283
ret long j
end
end
end
end
end
j = add j 1
end
ret -1
end

note one step of check_cycle_dfs without recursion. fr: frames (object, phase, step, next j) at
note 4 per depth, object states at 1024 + i (0 unvisited, 1 on the stack, 2 done), the target at
note 1280. Returns the new depth, or -(1 + 2 * j + phase) for a cycle through object j. Matches
note already done (state 2) are skipped inside one step, so the caller's loop runs at most
note 512 + 256 * 321 steps.
fn dstep w view uchar 2097152 x view ulong 20544 fr edit ulong 1284 sp ulong to long
f = mul sub sp 1 4
i = get fr f
ph = get fr add f 1
a = get fr add f 2
if not dtgt w x i ph a fr
if eq ph 0
put fr add f 1 1
put fr add f 2 0
put fr add f 3 0
ret long sp
end
put fr add 1024 i 2
ret long sub sp 1
end
r = dscan x fr get fr add f 3
while ge r 0 bound 257
if ne get fr add 1024 ulong r 2
break
end
r = dscan x fr add ulong r 1
end
if lt r 0
put fr add f 2 add a 1
put fr add f 3 0
ret long sp
end
j = ulong r
put fr add f 3 add j 1
s = get fr add 1024 j
if eq s 0
put fr add 1024 j 1
g = mul sp 4
put fr g j
put fr add g 1 0
put fr add g 2 0
put fr add g 3 0
ret long add sp 1
end
ret neg long add add mul j 2 ph 1
end

fn dfs w view uchar 2097152 x view ulong 20544 root ulong fr edit ulong 1284 e edit uchar 256 to long
put fr add 1024 root 1
put fr 0 root
put fr 1 0
put fr 2 0
put fr 3 0
sp = ulong 1
while gt sp 0 bound 999999
r = dstep w x fr sp
if lt r 0
c = sub ulong neg r 1
p = mcyc e 0
if eq rem c 2 0
p = mcycr e p
else
p = mcyco e p
end
ret vfail e sdec e p div c 2
end
sp = ulong r
end
ret 0
end

note omega_validate_object for object j of the graph (the C also takes an object outside any graph;
note here the object is always X's object j)
fn cvobject w view uchar 2097152 x view ulong 20544 j ulong e edit uchar 256 to long
ret vobj w x j e
end

fn cvalid w view uchar 2097152 x view ulong 20544 e edit uchar 256 to long
n = get x 0
if eq n 0
p = mempty e 0
ret vfail e p
end
for i ulong n
r = vobj w x i e
if ne r 0
ret r
end
end
fr = new ulong 1284 0
for i ulong n
if eq get fr add 1024 i 0
r = dfs w x i fr e
if ne r 0
ret r
end
end
end
ret 0
end

note ---- format_text (omega_graph_format_text, NON-CANONICAL text) ----

fn fsuf l edit uchar 256 p ulong x view ulong 20544 b ulong to ulong
p = fidsuf l p
p = sid l p x b
ret sput l p 10 1
end

fn fopname l edit uchar 256 p ulong opc ulong to ulong
if eq opc 3
ret sput l p 4473921 3
end
if eq opc 4
ret sput l p 4347219 3
end
ret sput l p 20559 2
end

note one object line into l: its length, or -1 when the C writes nothing (an OPERATION payload
note shorter than ApplyPayload leaves w as the previous line's length)
fn fline w view uchar 2097152 x view ulong 20544 i ulong l edit uchar 256 to long
b = ob i
k = get x add b 2
p = ulong 0
if eq k 2
tag = pu32 w x b 0
if eq tag 3
wd = pu16 w x b 4
p = ftypu l 0
p = sdec l p wd
p = ftypu2 l p
p = sdec l p wd
p = fparsc l p
ret long fsuf l p x b
end
if eq tag 2
p = ftbool l 0
ret long fsuf l p x b
end
p = ftag l 0
p = sdec l p tag
ret long fsuf l p x b
end
if eq k 1
bl = pu16 w x b 32
s = ulong 0
if gt bl 8
s = sub bl 8
end
v = ulong 0
while lt s bl bound 9
v = or shl v 8 pbyte w x i add 34 s
s = add s 1
end
p = fval l 0
p = sdec l p i
p = feq l p
p = sdec l p v
ret long fsuf l p x b
end
if eq k 3
pl = get x add b 7
if ge pl 204
opc = pu32 w x b 0
p = fop l 0
p = fopname l p opc
p = feq l p
p = fopname l p opc
p = fwrap l p
ret long fsuf l p x b
end
if ge pl 161
p = fapply l 0
p = sdec l p i
ret long fsuf l p x b
end
ret -1
end
p = fobj l 0
p = sdec l p k
ret long fsuf l p x b
end

note snprintf(t + pos, cap - pos, line) then the C's check: -1 when the line did not fit
fn femit t edit uchar 65536 cap ulong pos ulong l view uchar 256 n ulong to long
room = sub cap pos
m = n
if ge n room
m = sub room 1
end
for i ulong m
put t add pos i get l i
end
put t add pos m 0
if ge n room
ret -1
end
ret 0
end

fn cformat w view uchar 2097152 x view ulong 20544 cap ulong t edit uchar 65536 to long
if or eq cap 0 gt cap 65536
ret -1
end
l = new uchar 256 0
cnt = get x 0
p = fhead1 l 0
p = sdec l p cnt
p = fnl2 l p
if lt femit t cap 0 l p 0
ret -1
end
pos = p
wv = p
for i ulong cnt
m = fline w x i l
if ge m 0
wv = ulong m
if lt femit t cap pos l wv 0
ret -1
end
else
if ge wv sub cap pos
ret -1
end
end
pos = add pos wv
end
ret 0
end

note ---- parse_text (omega_graph_parse_text) and the omega_core.c builders it calls ----
note sv: 0 u32 type, 1 val a, 2 val b, 3 op add, 4 op sub (object index + 1, 0 = NULL),
note 5 object count, 6 wire write position; ids: 4 big-endian ulongs per object

fn sch s view uchar 262144 sl ulong i ulong to ulong
if lt i sl
ret ulong get s i
end
ret 0
end

note isspace in the C locale
fn isspc c ulong to bool
ret or eq c 32 and ge c 9 le c 13
end

note the pattern bytes: 0 type, 1 val, 2 op, 3 apply, 4 UNSIGNED_INTEGER(32), 5 ADD, 6 SUB; length
fn setpat pt edit uchar 24 c ulong to ulong
l = new uchar 256 0
n = ulong 0
if eq c 0
n = sput l 0 1701869940 4
end
if eq c 1
n = sput l 0 7102838 3
end
if eq c 2
n = sput l 0 28783 2
end
if eq c 3
n = sput l 0 521510350945 5
end
if eq c 4
n = sput l 0 4919424236051975765 8
n = sput l n 5928222847595858271 8
n = sput l n 691155752 4
end
if eq c 5
n = sput l 0 4473921 3
end
if eq c 6
n = sput l 0 4347219 3
end
for i ulong n
put pt i get l i
end
ret n
end

note strncmp(s + i, pattern, n) == 0 (the string ends at sl)
fn smat s view uchar 262144 sl ulong i ulong pt view uchar 24 n ulong to bool
for t ulong n
if ne sch s sl add i t ulong get pt t
ret false
end
end
ret true
end

note strstr(s + i, pattern) != NULL
fn sfind s view uchar 262144 sl ulong i ulong pt view uchar 24 n ulong to bool
while le add i n sl bound 999999
if smat s sl i pt n
ret true
end
i = add i 1
end
ret false
end

fn seol s view uchar 262144 sl ulong i ulong to ulong
while lt i sl bound 999999
if eq get s i 10
ret i
end
i = add i 1
end
ret i
end

fn digv c ulong to ulong
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 122
ret sub c 87
end
if and ge c 65 le c 90
ret sub c 55
end
ret 99
end

note glibc 2.39 strtoul(s + i, NULL, 0) under _GNU_SOURCE is __isoc23_strtoul: 0b/0B is binary.
note spref: skip spaces, sign and prefix; returns i | base << 40 | negative << 48
fn spref s view uchar 262144 sl ulong i ulong to ulong
while isspc sch s sl i bound 999999
i = add i 1
end
ng = ulong 0
c = sch s sl i
if eq c 45
ng = 1
i = add i 1
else
if eq c 43
i = add i 1
end
end
bs = ulong 10
if eq sch s sl i 48
c = sch s sl add i 1
if or eq c 120 eq c 88
bs = 16
i = add i 2
else
if or eq c 98 eq c 66
bs = 2
i = add i 2
else
bs = 8
end
end
end
ret or i or shl bs 40 shl ng 48
end

note the digits into r: r 0 the value, r 1 = 1 on overflow (glibc then returns ULONG_MAX whatever the sign)
fn sdig s view uchar 262144 sl ulong i ulong bs ulong r edit ulong 2 to void
cut = div 18446744073709551615 bs
lim = rem 18446744073709551615 bs
v = ulong 0
while lt digv sch s sl i bs bound 999999
d = digv sch s sl i
if or gt v cut and eq v cut gt d lim
put r 1 1
else
v = add mul v bs d
end
i = add i 1
end
put r 0 v
end

fn stoul s view uchar 262144 sl ulong i ulong to ulong
q = spref s sl i
r = new ulong 2 0
sdig s sl and q 1099511627775 and shr q 40 255 r
if eq get r 1 1
ret 18446744073709551615
end
if eq shr q 48 1
ret neg get r 0
end
ret get r 0
end

fn putid w edit uchar 2097152 o ulong ids view ulong 1024 k ulong to void
for t ulong 32
q = get ids add mul k 4 div t 8
sh = mul sub 7 rem t 8 8
put w add o t uchar and shr q sh 255
end
end

note omega_graph_add_object + record header: the payload's wire offset (payload zeroed), 0 when full
fn bstart w edit uchar 2097152 sv edit ulong 8 kind ulong pl ulong to ulong
if ge get sv 5 256
ret 0
end
o = get sv 6
cl = add 16 pl
for t ulong 4
sh = mul sub 3 t 8
put w add o t uchar and shr cl sh 255
end
put w add o 4 79
put w add o 5 77
put w add o 6 71
put w add o 7 48
put w add o 8 1
put w add o 9 uchar kind
for t ulong 6
put w add add o 10 t 0
end
put w add o 16 uchar shr pl 24
put w add o 17 uchar and shr pl 16 255
put w add o 18 uchar and shr pl 8 255
put w add o 19 uchar and pl 255
for t ulong pl
put w add add o 20 t 0
end
ret add o 20
end

note omega_compute_semantic_id of the record just written: sha256 of its bytes after the length
fn bfin w edit uchar 2097152 sv edit ulong 8 ids edit ulong 1024 to ulong
o = get sv 6
cl = be32 view w o
cb = new uchar 4096 0
for t ulong cl
put cb t get w add add o 4 t
end
d = new ulong 4 0
sha4k cb cl d
n = get sv 5
for t ulong 4
put ids add mul n 4 t get d t
end
put sv 5 add n 1
put sv 6 add add o 4 cl
ret add n 1
end

fn btype w edit uchar 2097152 sv edit ulong 8 ids edit ulong 1024 to ulong
o = bstart w sv 2 44
if eq o 0
ret 0
end
put w o 3
put w add o 4 32
ret bfin w sv ids
end

fn bval w edit uchar 2097152 sv edit ulong 8 ids edit ulong 1024 v ulong to ulong
o = bstart w sv 1 98
if eq o 0
ret 0
end
putid w o ids sub get sv 0 1
put w add o 32 4
for t ulong 4
sh = mul sub 3 t 8
put w add add o 34 t uchar and shr v sh 255
end
ret bfin w sv ids
end

fn bop w edit uchar 2097152 sv edit ulong 8 ids edit ulong 1024 opc ulong to ulong
o = bstart w sv 3 204
if eq o 0
ret 0
end
k = sub get sv 0 1
put w o uchar opc
put w add o 4 1
putid w add o 8 ids k
put w add o 40 2
putid w add o 41 ids k
putid w add o 73 ids k
putid w add o 169 ids k
ret bfin w sv ids
end

fn bapply w edit uchar 2097152 sv edit ulong 8 ids edit ulong 1024 op ulong to ulong
o = bstart w sv 3 161
if eq o 0
ret 0
end
putid w o ids sub op 1
put w add o 32 2
putid w add o 33 ids sub get sv 1 1
putid w add o 65 ids sub get sv 2 1
ret bfin w sv ids
end

note one line whose first word starts at i (after the C's whitespace skip)
fn pline s view uchar 262144 sl ulong i ulong w edit uchar 2097152 sv edit ulong 8 ids edit ulong 1024 to void
pt = new uchar 24 0
n = setpat pt 0
if smat s sl i pt n
n = setpat pt 4
if sfind s sl i pt n
put sv 0 btype w sv ids
end
ret
end
n = setpat pt 1
if smat s sl i pt n
q = ulong 0
while lt add i q sl bound 999999
if eq get s add i q 61
break
end
q = add q 1
end
if and lt add i q sl ne get sv 0 0
v = stoul s sl add add i q 1
if eq get sv 1 0
put sv 1 bval w sv ids v
else
if eq get sv 2 0
put sv 2 bval w sv ids v
end
end
end
ret
end
n = setpat pt 2
if smat s sl i pt n
n = setpat pt 5
if and sfind s sl i pt n ne get sv 0 0
put sv 3 bop w sv ids 3
ret
end
n = setpat pt 6
if and sfind s sl i pt n ne get sv 0 0
put sv 4 bop w sv ids 4
end
ret
end
n = setpat pt 3
if smat s sl i pt n
ok = and ne get sv 1 0 ne get sv 2 0
if and ok ne get sv 3 0
r = bapply w sv ids get sv 3
ret
end
if and ok ne get sv 4 0
r = bapply w sv ids get sv 4
end
end
end

fn cparse s view uchar 262144 n ulong w edit uchar 2097152 x edit ulong 20544 to long
if gt n 262144
ret -2
end
sl = n
for i ulong n
if eq get s i 0
sl = i
break
end
end
sv = new ulong 8 0
ids = new ulong 1024 0
put sv 6 6
p = ulong 0
while lt p sl bound 999999
while and lt p sl isspc sch s sl p bound 999999
p = add p 1
end
if ge p sl
break
end
if and eq get s p 47 eq sch s sl add p 1 47
p = seol s sl p
continue
end
pline s sl p w sv ids
p = seol s sl p
end
put w 0 79
put w 1 77
put w 2 71
put w 3 71
c = get sv 5
put w 4 uchar shr c 8
put w 5 uchar and c 255
r = cdecode view w get sv 6 x
if ne r 0
trap 9
end
ret 0
end

note ---- ids as text (omega_canonical.c) ----

note strtol({c0, c1, 0}, &end, 16) consuming both characters: the byte value, or -1
fn hx2 c0 ulong c1 ulong to long
i = ulong 0
if isspc c0
i = 1
end
c = c0
if eq i 1
c = c1
end
ng = false
if and eq i 0 or eq c 45 eq c 43
ng = eq c 45
i = 1
c = c1
end
if eq i 1
if gt digv c 15
ret -1
end
v = long digv c
if ng
ret and neg v 255
end
ret v
end
if or gt digv c0 15 gt digv c1 15
ret -1
end
if and eq c0 48 or eq c1 120 eq c1 88
ret -1
end
ret long or shl digv c0 4 digv c1
end

fn chexparse h view uchar 65 o edit uchar 32 to long
for i ulong 64
if eq get h i 0
ret -1
end
end
if ne get h 64 0
ret -1
end
for i ulong 32
v = hx2 ulong get h mul i 2 ulong get h add mul i 2 1
if lt v 0
ret -1
end
put o i uchar v
end
ret 0
end

fn chexid a view uchar 32 o edit uchar 65 to void
for i ulong 32
c = ulong get a i
put o mul i 2 uchar hexdig shr c 4
put o add mul i 2 1 uchar hexdig and c 15
end
put o 64 0
end

fn cidcmp a view uchar 32 c view uchar 32 to long
for i ulong 32
p = get a i
q = get c i
if lt p q
ret -1
end
if gt p q
ret 1
end
end
ret 0
end

note ==== parity harness: program mode only; everything above this line is the library ====
note usage: codec decode|text|hexid < PACK, or codec header. Writes the stream files into the current
note directory in exactly the C oracle's line formats (see parity/run.sh).

text tdec "decode.out"
text tval "validate.out"
text tser "serialize.out"
text tfmt "format.out"
text tpar "parse.out"
text thex "hexid.out"
text thdr "header.out"
text tuse "usage: codec decode|text|hexid < PACK | codec header\n"
text tbad "codec: cannot open an output file\n"

global ib uchar 1048576
global ist ulong 2
global obuf uchar 4194304
global obn ulong 4
global ofd long 4
global arg uchar 64

fn inb to ulong
p = get ist 0
if ge p get ist 1
r = read 0 ib 0 1048576
if le r 0
ret 256
end
put ist 1 ulong r
p = 0
end
put ist 0 add p 1
ret ulong get ib p
end

note u32 little-endian record length; 2^32 at end of input
fn rdlen to ulong
c = inb
if eq c 256
ret 4294967296
end
v = c
for i ulong 3
v = or v shl inb mul add i 1 8
end
ret v
end

note n record bytes into a (the first 2097152; the rest is read and dropped). A `for` with a
note counted value traps 4 past 1000000 passes, so long runs go in pieces of at most 4096.
fn rdw a edit uchar 2097152 n ulong to void
i = ulong 0
while lt i n bound 999999
m = sub n i
if gt m 4096
m = 4096
end
for t ulong m
c = inb
if lt add i t 2097152
put a add i t uchar c
end
end
i = add i m
end
end

fn rds a edit uchar 262144 n ulong to void
i = ulong 0
while lt i n bound 999999
m = sub n i
if gt m 4096
m = 4096
end
for t ulong m
c = inb
if lt add i t 262144
put a add i t uchar c
end
end
i = add i m
end
end

fn ohexs f ulong o view uchar 1049606 n ulong to void
i = ulong 0
while lt i n bound 999999
m = sub n i
if gt m 4096
m = 4096
end
for t ulong m
ohexb f ulong get o add i t
end
i = add i m
end
end

fn oflush f ulong to void
n = get obn f
if gt n 0
r = write int get ofd f obuf mul f 1048576 n
end
put obn f 0
end

fn ob1 f ulong c ulong to void
n = get obn f
if ge n 1048576
oflush f
n = 0
end
put obuf add mul f 1048576 n uchar c
put obn f add n 1
end

fn odec f ulong v ulong to void
d = new uchar 20 0
n = ulong 0
while true bound 21
put d n uchar add rem v 10 48
n = add n 1
v = div v 10
if eq v 0
break
end
end
for i ulong n
ob1 f ulong get d sub sub n 1 i
end
end

fn osdec f ulong v long to void
if lt v 0
ob1 f 45
odec f ulong neg v
ret
end
odec f ulong v
end

fn ohexb f ulong c ulong to void
ob1 f hexdig shr c 4
ob1 f hexdig and c 15
end

fn ohexw f ulong v ulong to void
for t ulong 16
sh = mul sub 15 t 4
ob1 f hexdig and shr v sh 15
end
end

fn oopen f ulong name view uchar 32 n ulong to bool
fd = fopen name 0 n 577 420
if lt fd 0
ret false
end
put ofd f fd
ret true
end

fn opn f ulong c ulong to bool
nm = new uchar 32 0
if eq c 0
for i ulong len tdec
put nm i get tdec i
end
ret oopen f nm len tdec
end
if eq c 1
for i ulong len tval
put nm i get tval i
end
ret oopen f nm len tval
end
if eq c 2
for i ulong len tser
put nm i get tser i
end
ret oopen f nm len tser
end
if eq c 3
for i ulong len tfmt
put nm i get tfmt i
end
ret oopen f nm len tfmt
end
if eq c 4
for i ulong len tpar
put nm i get tpar i
end
ret oopen f nm len tpar
end
if eq c 5
for i ulong len thex
put nm i get thex i
end
ret oopen f nm len thex
end
for i ulong len thdr
put nm i get thdr i
end
ret oopen f nm len thdr
end

fn shaout b view uchar 1049606 n ulong d edit ulong 4 to void
k = new ulong 64 0
shak k
h = new ulong 8 0
shainit h
m = new uchar 64 0
nb = div n 64
for bi ulong nb
o = mul bi 64
for i ulong 64
put m i get b add o i
end
shablk h m k
end
tb = mul nb 64
r = sub n tb
for i ulong r
put m i get b add tb i
end
shafin h m k r n
shaget h d
end

note " <count> <has_id>:<id> ..." as the oracle's ids()
fn oids f ulong x view ulong 20544 to void
n = get x 0
ob1 f 32
odec f n
for j ulong n
b = ob j
ob1 f 32
odec f get x add b 9
ob1 f 58
for t ulong 4
ohexw f get x add add b 10 t
end
end
end

fn gval w view uchar 2097152 x view ulong 20544 e edit uchar 256 f ulong k ulong to void
r = cvalid w x e
odec f k
ob1 f 32
osdec f r
if ne r 0
ob1 f 32
for i ulong 256
c = get e i
if eq c 0
break
end
ob1 f ulong c
end
end
ob1 f 10
end

fn gser w view uchar 2097152 x view ulong 20544 o edit uchar 1049606 f ulong k ulong to void
d = new ulong 4 0
r = cserial w x 1049606 o
odec f k
if ge r 0
ob1 f 32
ob1 f 48
ob1 f 32
n = ulong r
odec f n
ob1 f 32
ohexs f o n
ob1 f 32
shaout o n d
for i ulong 4
ohexw f get d i
end
else
ob1 f 32
osdec f r
end
r = cserial w x 8192 o
ob1 f 32
if ge r 0
ob1 f 48
ob1 f 32
odec f ulong r
else
osdec f r
end
ob1 f 10
end

fn otxt f ulong t view uchar 65536 to void
for i ulong 65536
c = get t i
if eq c 0
ret
end
ohexb f ulong c
end
end

fn gfmt w view uchar 2097152 x view ulong 20544 t edit uchar 65536 f ulong k ulong to void
r = cformat w x 4096 t
odec f k
ob1 f 32
osdec f r
ob1 f 32
otxt f t
r = cformat w x 200 t
ob1 f 32
osdec f r
ob1 f 32
otxt f t
ob1 f 10
end

fn dodec to int
w = new uchar 2097152 0
x = new ulong 20544 0
o = new uchar 1049606 0
t = new uchar 65536 0
e = new uchar 256 0
for f ulong 4
if not opn f f
ret 2
end
end
k = ulong 0
while true bound 999999
n = rdlen
if eq n 4294967296
break
end
rdw w n
r = cdecode w n x
odec 0 k
ob1 0 32
osdec 0 r
if eq r 0
oids 0 x
gval w x e 1 k
gser w x o 2 k
gfmt w x t 3 k
end
ob1 0 10
k = add k 1
end
for f ulong 4
oflush f
end
ret 0
end

fn dotext to int
s = new uchar 262144 0
w = new uchar 2097152 0
x = new ulong 20544 0
o = new uchar 1049606 0
t = new uchar 65536 0
e = new uchar 256 0
if not opn 0 4
ret 2
end
k = ulong 0
while true bound 999999
n = rdlen
if eq n 4294967296
break
end
rds s n
r = cparse s n w x
odec 0 k
ob1 0 32
osdec 0 r
oids 0 x
ob1 0 10
gval w x e 0 k
gser w x o 0 k
gfmt w x t 0 k
k = add k 1
end
oflush 0
ret 0
end

fn dohex to int
h = new uchar 65 0
a = new uchar 32 0
c = new uchar 32 0
o = new uchar 32 0
hx = new uchar 65 0
a2 = new uchar 32 0
if not opn 0 5
ret 2
end
k = ulong 0
while true bound 999999
n = rdlen
if eq n 4294967296
break
end
if ne n 129
ret 3
end
for i ulong 65
put h i uchar inb
end
for i ulong 32
put a i uchar inb
end
for i ulong 32
put c i uchar inb
end
for i ulong 32
put a2 i get a i
end
for i ulong 32
put o i 0
end
r = chexparse h o
odec 0 k
ob1 0 32
osdec 0 r
ob1 0 32
for i ulong 32
ohexb 0 ulong get o i
end
ob1 0 32
chexid a hx
for i ulong 64
ob1 0 ulong get hx i
end
ob1 0 32
osdec 0 cidcmp a c
ob1 0 32
osdec 0 cidcmp a a2
ob1 0 10
k = add k 1
end
oflush 0
ret 0
end

fn dohdr to int
if not opn 0 6
ret 2
end
for v ulong 256
for k ulong 256
odec 0 v
ob1 0 32
odec 0 k
ob1 0 32
odec 0 cobjver k
ob1 0 32
osdec 0 cchkhdr v k
ob1 0 10
end
end
oflush 0
ret 0
end

fn main to int
if lt argcnt 2
r = write 2 tuse 0 len tuse
ret 2
end
n = argread 1 arg 0 63
if lt n 4
r = write 2 tuse 0 len tuse
ret 2
end
c0 = get arg 0
c2 = get arg 2
rc = int 9
if eq c0 100
rc = dodec
end
if eq c0 116
rc = dotext
end
if and eq c0 104 eq c2 120
rc = dohex
end
if and eq c0 104 eq c2 97
rc = dohdr
end
if eq rc 9
r = write 2 tuse 0 len tuse
ret 2
end
if eq rc 2
r = write 2 tbad 0 len tbad
end
ret rc
end
