note SPDX-License-Identifier: Apache-2.0
note codec.om: seeded Omega port of src/omega_codec.c, src/omega_canonical.c and src/omega_validate.c
note (aien-dev/omega-mv#726), with the parts of src/omega_core.c they call (effect payload decode and
note the four builders omega_graph_parse_text uses). Parity is on bytes and status codes against the C
note as the product builds it (gcc -std=gnu11 -O2, the Makefile CFLAGS, aarch64). See README.md.
note
note A graph is two arrays: W, the OMGG wire image it was decoded from (uchar, WCAP bytes), and X,
note an index of ulongs (XLEN). The C OmegaGraph (6,648,836 bytes) is never materialised: every
note OmegaObject field is a function of W and X, and sbyte below gives any byte of the C struct image
note (the C reads past an object's 1024-byte payload in format_text and in the cycle walk).
note   X 0              object count
note   X ob(j) + 0..13  cbuf offset, clen, kind, attr count, rel count, first rel offset,
note                    const count, payload_len, payload offset, has_id, id as 4 big-endian ulongs
note   X ob(j) + 14..45 offset of attribute a's key bytes (klen is the byte before)
note   X ob(j) + 46..77 offset of constraint c's record (kind, payload_len, payload)
note
note Exported functions (omega-bridge native call ABI v1: ulong scalars, fixed-length uchar/ulong
note arrays, long result):
note   cdecode w n x          omega_graph_deserialize_binary: 0, -1 as the C; -2 = needs a byte past WCAP
note   cserial w x mx o       omega_graph_serialize_binary: the length written, or -1
note   cvalid w x e           omega_validate_graph: 0 or -1, message + NUL in e as the C's snprintf
note   cvobject w x j e       omega_validate_object of object j: 0 or -1, message as cvalid
note   cformat w x cap t      omega_graph_format_text: 0 or -1, t as the C leaves it
note   cparse s n w x         omega_graph_parse_text: 0 (-2: n > SCAP); the graph is left in w, x
note   ccanon w x j cb        omega_canonical_encode of object j with max_len 4096: length or -1
note   chexparse h o          omega_parse_hex_semantic_id on the first 65 bytes of the C string
note   chexid i o             omega_hex_semantic_id: 64 hex digits and a NUL
note   cidcmp a b             omega_compare_semantic_id: -1, 0, 1 (glibc aarch64 memcmp gives the sign)
note   cobjver k              omega_canonical_object_version
note   cchkhdr v k            omega_canonical_check_header

note Fixed sizes (written as numbers: the pinned omc refuses `const` in function mode, error 9):
note   2097152 W, the wire image (WCAP)        20544 X, the index: 64 + 80 * 256 (XLEN)
note   1049606 serialize output: 6 + 256 * (4 + 4096), the most omega_graph_serialize_binary writes
note   65536 format_text buffer (TCAP)         262144 parse_text input (SCAP)
note   256 error message / text line           4294967295 the 32-bit mask in SHA-256

note ---- small helpers ----

fn ob j ulong to ulong
ret add 64 mul j 80
end

fn be16 w view uchar 2097152 i ulong to ulong
ret or shl ulong get w i 8 ulong get w add i 1
end

fn be32 w view uchar 2097152 i ulong to ulong
v = be16 w i
ret or shl v 16 be16 w add i 2
end

fn be64 w view uchar 2097152 i ulong to ulong
v = be32 w i
ret or shl v 32 be32 w add i 4
end

fn cobjver k ulong to ulong
if eq k 8
ret 2
end
ret 1
end

fn cchkhdr v ulong k ulong to long
if and eq k 8 eq v 1
ret -2
end
if ne v cobjver k
ret -1
end
ret 0
end

note ---- the C struct image (aarch64 LP64 offsets, measured with offsetof) ----
note OmegaObject 25972 bytes: id 0, has_id 32, kind 36, attr_count 40, attributes 42 (578 each:
note key 64, value 512, val_len 576), rel_count 18538, relations 18540 (34 each), const_count
note 20716, constraints 20718 (132 each), payload_len 24944, payload 24948. Host order little-endian.

note payload byte p (< 1024) of the object at X base b; 0 past payload_len (the decoder memsets)
fn plb w view uchar 2097152 x view ulong 20544 b ulong p ulong to ulong
if lt p get x add b 7
ret ulong get w add get x add b 8 p
end
ret 0
end

fn sattr w view uchar 2097152 x view ulong 20544 b ulong q ulong to ulong
a = div q 578
r = rem q 578
if ge a get x add b 3
ret 0
end
o = get x add add b 14 a
kl = ulong get w sub o 1
if lt r 64
if lt r kl
ret ulong get w add o r
end
ret 0
end
vl = be16 w add o kl
if lt r 576
v = sub r 64
if lt v vl
ret ulong get w add add o kl add 2 v
end
ret 0
end
if eq r 576
ret and vl 255
end
ret shr vl 8
end

fn srel w view uchar 2097152 x view ulong 20544 b ulong q ulong to ulong
r = div q 34
s = rem q 34
if ge r get x add b 4
ret 0
end
o = add get x add b 5 mul r 34
if eq s 0
ret ulong get w add o 1
end
if eq s 1
ret ulong get w o
end
ret ulong get w add o s
end

fn sconst w view uchar 2097152 x view ulong 20544 b ulong q ulong to ulong
c = div q 132
s = rem q 132
if ge c get x add b 6
ret 0
end
o = get x add add b 46 c
if lt s 4
if eq s 0
ret ulong get w add o 1
end
if eq s 1
ret ulong get w o
end
if eq s 2
ret ulong get w add o 3
end
ret ulong get w add o 2
end
p = sub s 4
if lt p be16 w add o 2
ret ulong get w add add o 4 p
end
ret 0
end

note byte o of OmegaObject j as the C holds it; objects at or past the count are zero (memset, and the
note oracle's graph has zero bytes after it: see README "Reads past the object")
fn sbyte w view uchar 2097152 x view ulong 20544 j ulong o ulong to ulong
if ge j get x 0
ret 0
end
b = ob j
if lt o 32
q = get x add add b 10 div o 8
ret and shr q mul sub 7 rem o 8 8 255
end
if eq o 32
ret get x add b 9
end
if eq o 36
ret get x add b 2
end
if eq o 40
ret and get x add b 3 255
end
if eq o 41
ret shr get x add b 3 8
end
if lt o 42
ret 0
end
if lt o 18538
ret sattr w x b sub o 42
end
if eq o 18538
ret and get x add b 4 255
end
if eq o 18539
ret shr get x add b 4 8
end
if lt o 20716
ret srel w x b sub o 18540
end
if eq o 20716
ret and get x add b 6 255
end
if eq o 20717
ret shr get x add b 6 8
end
if lt o 24942
ret sconst w x b sub o 20718
end
if lt o 24944
ret 0
end
if lt o 24948
ret and shr get x add b 7 mul sub o 24944 8 255
end
ret plb w x b sub o 24948
end

note payload byte p of object j, also past the 1024-byte payload (into the following objects)
fn pbyte w view uchar 2097152 x view ulong 20544 j ulong p ulong to ulong
if lt p 1024
ret plb w x ob j p
end
g = add 24948 p
ret sbyte w x add j div g 25972 rem g 25972
end

note 8 payload bytes from p, big-endian (an id word)
fn pw64 w view uchar 2097152 x view ulong 20544 j ulong p ulong to ulong
v = ulong 0
for i ulong 8
v = or shl v 8 pbyte w x j add p i
end
ret v
end

fn pu16 w view uchar 2097152 x view ulong 20544 b ulong p ulong to ulong
ret or plb w x b p shl plb w x b add p 1 8
end

fn pu32 w view uchar 2097152 x view ulong 20544 b ulong p ulong to ulong
v = pu16 w x b add p 2
ret or shl v 16 pu16 w x b p
end

note ---- SHA-256 (FIPS 180-4; from tools/zero-legacy/sha256.om, state in arrays) ----

fn shak k edit ulong 64 to void
put k 0 1116352408
put k 1 1899447441
put k 2 3049323471
put k 3 3921009573
put k 4 961987163
put k 5 1508970993
put k 6 2453635748
put k 7 2870763221
put k 8 3624381080
put k 9 310598401
put k 10 607225278
put k 11 1426881987
put k 12 1925078388
put k 13 2162078206
put k 14 2614888103
put k 15 3248222580
put k 16 3835390401
put k 17 4022224774
put k 18 264347078
put k 19 604807628
put k 20 770255983
put k 21 1249150122
put k 22 1555081692
put k 23 1996064986
put k 24 2554220882
put k 25 2821834349
put k 26 2952996808
put k 27 3210313671
put k 28 3336571891
put k 29 3584528711
put k 30 113926993
put k 31 338241895
put k 32 666307205
put k 33 773529912
put k 34 1294757372
put k 35 1396182291
put k 36 1695183700
put k 37 1986661051
put k 38 2177026350
put k 39 2456956037
put k 40 2730485921
put k 41 2820302411
put k 42 3259730800
put k 43 3345764771
put k 44 3516065817
put k 45 3600352804
put k 46 4094571909
put k 47 275423344
put k 48 430227734
put k 49 506948616
put k 50 659060556
put k 51 883997877
put k 52 958139571
put k 53 1322822218
put k 54 1537002063
put k 55 1747873779
put k 56 1955562222
put k 57 2024104815
put k 58 2227730452
put k 59 2361852424
put k 60 2428436474
put k 61 2756734187
put k 62 3204031479
put k 63 3329325298
end

fn shainit h edit ulong 8 to void
put h 0 1779033703
put h 1 3144134277
put h 2 1013904242
put h 3 2773480762
put h 4 1359893119
put h 5 2600822924
put h 6 528734635
put h 7 1541459225
end

fn rotr x ulong r ulong to ulong
ret and or shr x r shl x sub 32 r 4294967295
end

fn bsig0 x ulong to ulong
ret xor rotr x 2 xor rotr x 13 rotr x 22
end

fn bsig1 x ulong to ulong
ret xor rotr x 6 xor rotr x 11 rotr x 25
end

fn ssig0 x ulong to ulong
ret xor rotr x 7 xor rotr x 18 shr x 3
end

fn ssig1 x ulong to ulong
ret xor rotr x 17 xor rotr x 19 shr x 10
end

fn shach x ulong y ulong z ulong to ulong
ret xor and x y and and not x 4294967295 z
end

fn shamaj x ulong y ulong z ulong to ulong
ret xor and x y xor and x z and y z
end

fn shard st edit ulong 8 ki ulong wi ulong to void
a = get st 0
e = get st 4
t1 = add get st 7 bsig1 e
t1 = add t1 shach e get st 5 get st 6
t1 = and add add t1 ki wi 4294967295
t2 = and add bsig0 a shamaj a get st 1 get st 2 4294967295
put st 7 get st 6
put st 6 get st 5
put st 5 e
put st 4 and add get st 3 t1 4294967295
put st 3 get st 2
put st 2 get st 1
put st 1 a
put st 0 and add t1 t2 4294967295
end

fn shablk h edit ulong 8 m view uchar 64 k view ulong 64 to void
w = new ulong 64 0
for i ulong 16
o = mul i 4
v = ulong get m o
v = or shl v 8 ulong get m add o 1
v = or shl v 8 ulong get m add o 2
v = or shl v 8 ulong get m add o 3
put w i v
end
for j ulong 48
i = add j 16
s = add ssig1 get w sub i 2 get w sub i 7
s = add s ssig0 get w sub i 15
s = add s get w sub i 16
put w i and s 4294967295
end
st = new ulong 8 0
for i ulong 8
put st i get h i
end
for i ulong 64
shard st get k i get w i
end
for i ulong 8
put h i and add get h i get st i 4294967295
end
end

note pad block m (r message bytes already in it) and finish; shaget gives the digest as 4 big-endian ulongs
fn shafin h edit ulong 8 m edit uchar 64 k view ulong 64 r ulong n ulong to void
put m r 128
for i ulong 64
if gt i r
put m i 0
end
end
if ge r 56
shablk h m k
for i ulong 64
put m i 0
end
end
bits = mul n 8
for i ulong 8
sh = mul sub 7 i 8
put m add 56 i uchar and shr bits sh 255
end
shablk h m k
end

fn shaget h view ulong 8 d edit ulong 4 to void
for i ulong 4
put d i or shl get h mul i 2 32 get h add mul i 2 1
end
end

fn sha4k b view uchar 4096 n ulong d edit ulong 4 to void
k = new ulong 64 0
shak k
h = new ulong 8 0
shainit h
m = new uchar 64 0
nb = div n 64
for bi ulong nb
o = mul bi 64
for i ulong 64
put m i get b add o i
end
shablk h m k
end
tb = mul nb 64
r = sub n tb
for i ulong r
put m i get b add tb i
end
shafin h m k r n
shaget h d
end

note ---- decode (omega_graph_deserialize_binary) ----

note the C's check `cpos + k > clen` (-1), then the port's capacity: a byte at or past WCAP (-2)
fn cneed cp ulong k ulong cl ulong c2 ulong to long
if gt add cp k cl
ret -1
end
if gt add cp k c2
ret -2
end
ret 0
end

fn cap2 cs ulong cl ulong to ulong
r = sub 2097152 cs
if lt cl r
ret cl
end
ret r
end

fn dattrs w view uchar 2097152 x edit ulong 20544 b ulong cs ulong cl ulong to long
c2 = cap2 cs cl
cp = ulong 6
r = cneed cp 2 cl c2
if ne r 0
ret r
end
na = be16 w add cs cp
cp = add cp 2
if gt na 32
ret -1
end
put x add b 3 na
for a ulong na
r = cneed cp 1 cl c2
if ne r 0
ret r
end
kl = ulong get w add cs cp
cp = add cp 1
if ge kl 64
ret -1
end
r = cneed cp add kl 2 cl c2
if ne r 0
ret r
end
put x add add b 14 a add cs cp
cp = add cp kl
vl = be16 w add cs cp
cp = add cp 2
if gt vl 512
ret -1
end
r = cneed cp vl cl c2
if ne r 0
ret r
end
cp = add cp vl
end
ret long cp
end

fn drels w view uchar 2097152 x edit ulong 20544 b ulong cs ulong cl ulong cp ulong to long
c2 = cap2 cs cl
r = cneed cp 2 cl c2
if ne r 0
ret r
end
nr = be16 w add cs cp
cp = add cp 2
if gt nr 64
ret -1
end
put x add b 4 nr
put x add b 5 add cs cp
for i ulong nr
r = cneed cp 34 cl c2
if ne r 0
ret r
end
cp = add cp 34
end
ret long cp
end

fn dconsts w view uchar 2097152 x edit ulong 20544 b ulong cs ulong cl ulong cp ulong to long
c2 = cap2 cs cl
r = cneed cp 2 cl c2
if ne r 0
ret r
end
nc = be16 w add cs cp
cp = add cp 2
if gt nc 32
ret -1
end
put x add b 6 nc
for c ulong nc
r = cneed cp 4 cl c2
if ne r 0
ret r
end
put x add add b 46 c add cs cp
pl = be16 w add add cs cp 2
cp = add cp 4
if gt pl 128
ret -1
end
r = cneed cp pl cl c2
if ne r 0
ret r
end
cp = add cp pl
end
ret long cp
end

fn dpay w view uchar 2097152 x edit ulong 20544 b ulong cs ulong cl ulong cp ulong to long
c2 = cap2 cs cl
r = cneed cp 4 cl c2
if ne r 0
ret r
end
pl = be32 w add cs cp
cp = add cp 4
if gt pl 1024
ret -1
end
r = cneed cp pl cl c2
if ne r 0
ret r
end
put x add b 7 pl
put x add b 8 add cs cp
ret long add cp pl
end

note omega_effect_read of a KIND_EFFECT object (omega_core.c): 0 or OMEGA_EFFECT_ERR_*
fn effchk w view uchar 2097152 x view ulong 20544 b ulong to long
pl = get x add b 7
if eq pl 176
ret -3
end
if ne pl 178
ret -2
end
res = or shl plb w x b 0 8 plb w x b 1
if eq res 0
ret -4
end
prm = or shl plb w x b 48 8 plb w x b 49
if gt prm 128
ret -5
end
for i ulong 128
if ge i prm
if ne plb w x b add 50 i 0
ret -6
end
end
end
ret 0
end

note omega_compute_semantic_id: sha256 of the canonical encoding in a 4096-byte buffer; a longer
note encoding leaves has_id 0 and the id zero
fn semid w view uchar 2097152 x edit ulong 20544 j ulong to void
cb = new uchar 4096 0
n = ccanon w view x j cb
if lt n 0
ret
end
d = new ulong 4 0
sha4k cb ulong n d
b = ob j
put x add b 9 1
for i ulong 4
put x add add b 10 i get d i
end
end

fn dobj w view uchar 2097152 x edit ulong 20544 j ulong cs ulong cl ulong to long
b = ob j
put x 0 add j 1
c2 = cap2 cs cl
if lt c2 6
ret -2
end
if or ne get w cs 79 ne get w add cs 1 77
ret -1
end
if or ne get w add cs 2 71 ne get w add cs 3 48
ret -1
end
k = ulong get w add cs 5
if ne cchkhdr ulong get w add cs 4 k 0
ret -1
end
put x b cs
put x add b 1 cl
put x add b 2 k
r = dattrs w x b cs cl
if lt r 0
ret r
end
r = drels w x b cs cl ulong r
if lt r 0
ret r
end
r = dconsts w x b cs cl ulong r
if lt r 0
ret r
end
r = dpay w x b cs cl ulong r
if lt r 0
ret r
end
if eq k 8
if ne effchk w view x b 0
ret -1
end
end
semid w x j
ret 0
end

fn cdecode w view uchar 2097152 n ulong x edit ulong 20544 to long
if lt n 6
ret -1
end
if or ne get w 0 79 ne get w 1 77
ret -1
end
if or ne get w 2 71 ne get w 3 71
ret -1
end
cnt = be16 w 4
if gt cnt 256
ret -1
end
for i ulong 20544
put x i 0
end
pos = ulong 6
for i ulong cnt
if gt add pos 4 n
ret -1
end
if gt add pos 4 2097152
ret -2
end
cl = be32 w pos
pos = add pos 4
if or gt add pos cl n lt cl 6
ret -1
end
r = dobj w x i pos cl
if ne r 0
ret r
end
pos = add pos cl
end
ret 0
end

note ---- canonical encoding (omega_canonical_encode) ----

note strlen of attribute key at offset o, klen bytes stored (the C key ends at its first NUL)
fn ekl w view uchar 2097152 o ulong kl ulong to ulong
for i ulong kl
if eq get w add o i 0
ret i
end
end
ret kl
end

fn canlen w view uchar 2097152 x view ulong 20544 b ulong to ulong
n = ulong 8
na = get x add b 3
for a ulong na
o = get x add add b 14 a
kl = ulong get w sub o 1
n = add n add add 3 ekl w o kl be16 w add o kl
end
n = add n add 4 mul 34 get x add b 4
nc = get x add b 6
for c ulong nc
o = get x add add b 46 c
n = add n add 4 be16 w add o 2
end
ret add n add 4 get x add b 7
end

note strcmp sign of attribute keys i and j (unsigned bytes; a key ends at klen or its first NUL)
fn acmp w view uchar 2097152 x view ulong 20544 b ulong i ulong j ulong to long
oi = get x add add b 14 i
oj = get x add add b 14 j
ki = ulong get w sub oi 1
kj = ulong get w sub oj 1
for t ulong 65
ci = ulong 0
if lt t ki
ci = ulong get w add oi t
end
cj = ulong 0
if lt t kj
cj = ulong get w add oj t
end
if lt ci cj
ret -1
end
if gt ci cj
ret 1
end
if eq ci 0
ret 0
end
end
ret 0
end

fn memcmpw w view uchar 2097152 a ulong c ulong n ulong to long
for i ulong n
p = ulong get w add a i
q = ulong get w add c i
if lt p q
ret -1
end
if gt p q
ret 1
end
end
ret 0
end

fn rcmp w view uchar 2097152 x view ulong 20544 b ulong i ulong j ulong to long
rb = get x add b 5
oi = add rb mul i 34
oj = add rb mul j 34
ki = be16 w oi
kj = be16 w oj
if lt ki kj
ret -1
end
if gt ki kj
ret 1
end
ret memcmpw w add oi 2 add oj 2 32
end

fn ccmp w view uchar 2097152 x view ulong 20544 b ulong i ulong j ulong to long
oi = get x add add b 46 i
oj = get x add add b 46 j
ki = be16 w oi
kj = be16 w oj
if lt ki kj
ret -1
end
if gt ki kj
ret 1
end
li = be16 w add oi 2
lj = be16 w add oj 2
m = li
if lt lj li
m = lj
end
r = memcmpw w add oi 4 add oj 4 m
if ne r 0
ret r
end
if lt li lj
ret -1
end
if gt li lj
ret 1
end
ret 0
end

note the C's insertion sorts (stable): kind 0 attributes (strcmp), 1 relations, 2 constraints
fn cmpk w view uchar 2097152 x view ulong 20544 b ulong t ulong i ulong j ulong to long
if eq t 0
ret acmp w x b i j
end
if eq t 1
ret rcmp w x b i j
end
ret ccmp w x b i j
end

fn isort w view uchar 2097152 x view ulong 20544 b ulong t ulong ix edit ulong 64 n ulong to void
for i ulong n
put ix i i
end
for u ulong n
if gt u 0
key = get ix u
j = sub long u 1
while ge j 0 bound 64
if le cmpk w x b t get ix j key 0
break
end
put ix add j 1 get ix j
j = sub j 1
end
put ix add j 1 key
end
end
end

fn put16 cb edit uchar 4096 p ulong v ulong to ulong
put cb p uchar shr v 8
put cb add p 1 uchar and v 255
ret add p 2
end

note copy n wire bytes from o to cb at p; returns p + n
fn wcopy w view uchar 2097152 cb edit uchar 4096 p ulong o ulong n ulong to ulong
for t ulong n
put cb add p t get w add o t
end
ret add p n
end

fn canone w view uchar 2097152 x view ulong 20544 b ulong cb edit uchar 4096 p ulong a ulong to ulong
o = get x add add b 14 a
kl = ulong get w sub o 1
ek = ekl w o kl
put cb p uchar ek
p = wcopy w cb add p 1 o ek
vl = be16 w add o kl
p = put16 cb p vl
ret wcopy w cb p add add o kl 2 vl
end

fn canattr w view uchar 2097152 x view ulong 20544 b ulong cb edit uchar 4096 p ulong to ulong
ix = new ulong 64 0
na = get x add b 3
isort w x b 0 ix na
p = put16 cb p na
for i ulong na
p = canone w x b cb p get ix i
end
ret p
end

fn canrel w view uchar 2097152 x view ulong 20544 b ulong cb edit uchar 4096 p ulong to ulong
ix = new ulong 64 0
nr = get x add b 4
isort w x b 1 ix nr
p = put16 cb p nr
rb = get x add b 5
for i ulong nr
p = wcopy w cb p add rb mul get ix i 34 34
end
ret p
end

fn cancon w view uchar 2097152 x view ulong 20544 b ulong cb edit uchar 4096 p ulong to ulong
ix = new ulong 64 0
nc = get x add b 6
isort w x b 2 ix nc
p = put16 cb p nc
for i ulong nc
o = get x add add b 46 get ix i
p = wcopy w cb p o add 4 be16 w add o 2
end
ret p
end

fn ccanon w view uchar 2097152 x view ulong 20544 j ulong cb edit uchar 4096 to long
b = ob j
n = canlen w x b
if gt n 4096
ret -1
end
k = get x add b 2
put cb 0 79
put cb 1 77
put cb 2 71
put cb 3 48
put cb 4 uchar cobjver k
put cb 5 uchar k
p = canattr w x b cb 6
p = canrel w x b cb p
p = cancon w x b cb p
pl = get x add b 7
p = put16 cb p shr pl 16
p = put16 cb p and pl 65535
ret long wcopy w cb p get x add b 8 pl
end

note ---- serialize (omega_graph_serialize_binary) ----

note one record: u32 big-endian length, then the canonical bytes; returns the new position
fn serone o edit uchar 1049606 pos ulong cb view uchar 4096 n ulong to ulong
for t ulong 4
sh = mul sub 3 t 8
put o add pos t uchar and shr n sh 255
end
p = add pos 4
for t ulong n
put o add p t get cb t
end
ret add p n
end

fn cserial w view uchar 2097152 x view ulong 20544 mx ulong o edit uchar 1049606 to long
if gt 6 mx
ret -1
end
put o 0 79
put o 1 77
put o 2 71
put o 3 71
cnt = get x 0
put o 4 uchar shr cnt 8
put o 5 uchar and cnt 255
pos = ulong 6
cb = new uchar 4096 0
for i ulong cnt
n = ccanon w x i cb
if lt n 0
ret -1
end
L = ulong n
if gt add add pos 4 L mx
ret -1
end
pos = serone o pos cb L
end
ret long pos
end

