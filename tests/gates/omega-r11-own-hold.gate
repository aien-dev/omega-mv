# tests/gates/omega-r11-own-hold.gate
# Mirrors hosted: rx-host.yml chip-only-declared: test-r11-own-hold is declared SKIP on GitHub (spark-only: its q1-abc case starts the R11 living run, which needs both Spark core classes, X925 + A725, no GPU; omega #425)
# requires: aarch64 + bare_metal because the living systems need both Spark CPU core classes on the real machine; a hosted or virtual AArch64 runner does not qualify.
# Checks who owns the quiet flag (tests/runtime/r11_own_hold_test.sh): the non-owner cases must be refused by the flag, and the owner case must RUN the living run inside a spark-window measurement window (L345). A held-back or skipped owner fails; there is no load-independent pass.
gate: OMEGA-R11-OWN-HOLD
manifest_version: 2
owner: omega
requires:
  - aarch64
  - bare_metal
inputs:
  - Makefile
  - mk/
  - src/
  - tests/
  - tools/
  - aienos.lock
  - argus.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["spark:test-r11-own-hold"]
expects:
  exit: 0
  verdict: PASS
timeout: 60m
exactness: EXACT
cache_scope: machine
cache: never
