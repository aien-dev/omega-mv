# tests/gates/omega-om-units.gate
# The Omega implementations behind C entry points (sha256_* via src/omega_api_decl.h, omega_blake3_hash via src/omega_blake3.c): omc born from the seed,
# binding regenerated byte for byte, byte parity against the replaced C, BLAKE3 mutants killed.
# Hosted twin (independent ARM64 machine): .github/workflows/om-units-arm64.yml.
gate: OMEGA-OM-UNITS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - om/
  - seed/
  - src/omega_om_units.c
  - src/omega_om_units.ident
  - src/omega_native.h
  - src/omega_api_decl.h
  - src/sha256.h
  - src/omega_blake3.c
  - src/omega_blake3.h
  - tests/resolve/blake3_vectors.txt
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["om-units"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
