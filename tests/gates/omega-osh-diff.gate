# tests/gates/omega-osh-diff.gate
# Host-only OSH differential suite (omega #568): make test-osh-diff (plain and ASan/UBSan).
gate: OMEGA-OSH-DIFF
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - Makefile
  - mk/
  - src/
  - tests/
  - tools/
  - physics.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["osh-diff"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
