# tests/gates/omega-bw-hazard.gate
# Host-only static scoreboard hazard checker (omega-mv#554): make test-bw-hazard (decoder vs encoder, red receipt, negative controls, sweep). No device.
gate: OMEGA-BW-HAZARD
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - Makefile
  - mk/
  - src/
  - tests/
  - tools/
  - physics.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["bw-hazard"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
