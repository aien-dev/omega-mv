# tests/gates/crumb.gate
# RFC-0004 (aien-architecture docs/CRUMB_PROTOCOL_RFC_0004.md): crumbs are notes, never a merge rule.
# Only check: no committed generated crumb data or provenance. git grep only, no crumb tool, sub-second.
gate: CRUMB-LINT
manifest_version: 2
owner: omega
requires:
  - portable
inputs:
  - .crumb
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["crumb-lint"]
expects:
  exit: 0
  verdict: PASS
timeout: 2m
exactness: EXACT
cache_scope: portable
cache: never
