# tests/gates/omega-gpu-libm-free.gate
# Mirrors hosted: host-suites-3.yml gpu-libm-free (omega#471) with physics-src at physics.lock: libomega_gpu.a has no libm reference and the libm-free replacements are bit-identical (host only, no chip; ~3 s on the Spark)
gate: OMEGA-GPU-LIBM-FREE
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - Makefile
  - mk/
  - src/
  - tests/gpu_libm_free_test.c
  - physics.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["gpu-libm-free"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
