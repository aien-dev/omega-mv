# tests/gates/omega-numeric-cpu.gate
# The Spark runs this gate (aien-local-ci; the hosted host-suites.yml was removed in #564): test-numeric-cpu test-numeric-qualify test-e1-combine test-chipwait-campaign test-gpu-wait test-gpu-wait-mutants test-gpu-code-alloc test-q36-om-gate-host
gate: OMEGA-NUMERIC-CPU
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - Makefile
  - mk/
  - src/
  - tests/test_omega_numeric.c
  - tests/numeric_oracle.h
  - tests/run_numeric_gates.sh
  - tests/test_omega_q36_om_gate.c
  - tools/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["numeric-cpu"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
