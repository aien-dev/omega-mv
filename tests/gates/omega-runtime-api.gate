# tests/gates/omega-runtime-api.gate
# Mirrors hosted: no dedicated workflow; as a portable gate it runs in the AIEN Checks portable smoke set (aien-verification.yml)
# requires: portable: the tree plus gcc (-aux-info), make, perl, sed and awk; no GPU, no physics checkout, no sibling repo.
gate: OMEGA-RUNTIME-API
manifest_version: 2
owner: omega
requires:
  - portable
inputs:
  - docs/runtime/
  - mk/runtime-r1.mk
  - src/
  - tools/runtime_api_check.sh
  - tools/runtime_api_negative.sh
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["runtime-api"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
