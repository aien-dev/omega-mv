note Provenance: L776 / action L776-653-public-oracle-01 / source head cd5897e3f92f72a015892c67b17f096e433b54f7.

fn umax to ulong
ret 18446744073709551615
end

fn plus_u64 a ulong b ulong to ulong
ret add a b
end

fn minus_u64 a ulong b ulong to ulong
ret sub a b
end

fn times_u64 a ulong b ulong to ulong
ret mul a b
end

fn quotient_u64 a ulong b ulong to ulong
ret div a b
end

fn main to int
if ne plus_u64 umax 1 0
ret 1
end
if ne minus_u64 0 1 umax
ret 2
end
if ne times_u64 umax 2 18446744073709551614
ret 3
end
if ne quotient_u64 umax 3 6148914691236517205
ret 4
end
ret 0
end
