note compiler-pin=omega-bridge/0fc7d8662cb799e7c206b17c18ea4c3ec2b8fea9; compiler-sha256=191b776ef98821597c3e30655da6d680a9b66edbc9ceaca3c39c61ea6df098e9.
note Observable contract: exit 0 only when all fixed expected values match; otherwise a numbered nonzero status.
note Provenance: L776 / action L776-653-public-oracle-01 / source head cd5897e3f92f72a015892c67b17f096e433b54f7.

fn plus_u64 a ulong b ulong to ulong
ret add a b
end

fn minus_u64 a ulong b ulong to ulong
ret sub a b
end

fn times_u64 a ulong b ulong to ulong
ret mul a b
end

fn quotient_u64 a ulong b ulong to ulong
ret div a b
end

fn main to int
if ne plus_u64 19 23 42
ret 1
end
if ne minus_u64 100 58 42
ret 2
end
if ne times_u64 6 7 42
ret 3
end
if ne quotient_u64 126 3 42
ret 4
end
ret 0
end
