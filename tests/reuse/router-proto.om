x = unlink EXAPATH 0 n
x = unlink EXFPATH 0 get EXFLEN 0
ret 0
end

note a library that cannot load: route 5 on every QUERY, values still exact
fn tnolib to int
put TCK 0 10000
for a ulong 3
tpkargs add a 4 1 0 0
if not tok eq tspawn 0
ret 1
end
tagg 8 2 2 1
if not tok tbegin 9 1 256 0
ret 1
end
if not tok tsend 2 0 0
ret 1
end
if not tok trecv
ret 1
end
r1full
if not tok and eq get TR 2 5 eq get TR 0 get R1R 0
ret 1
end
if not tok tst 10 0 0
ret 1
end
if not tok eq treap 0
ret 1
end
end
ret 0
end

note exits: unknown op, op 0, p too large -> 4 then exit 4; EOF -> 3; argv errors -> 2
fn texits to int
put TCK 0 11000
tpkargs 2 0 0 0
if not tok eq tspawn 0
ret 1
end
if not tok tst 11 0 4
ret 1
end
if not tok eq treap 4
ret 1
end
tpkargs 2 0 0 0
x = tspawn
if not tok tst 0 0 4
ret 1
end
if not tok eq treap 4
ret 1
end
tpkargs 2 0 0 0
x = tspawn
if not tok tsend 3 7235 7235
ret 1
end
if not tok trecv
ret 1
end
if not tok and eq get TRS 0 4 eq treap 4
ret 1
end
tpkargs 2 0 0 0
x = tspawn
tagg 8 1 1 1
put TQ 64 0
if not tok tst 1 65 0
ret 1
end
if not tok tsend 2 0 0
ret 1
end
if not tok trecv
ret 1
end
put TQ 0 1
if not tok tsend 3 2 1
ret 1
end
if not tok eq treap 3
ret 1
end
tpkargs 8 0 0 0
x = tspawn
if not tok eq treap 2
ret 1
end
tpkargs 7 0 0 52
x = tspawn
if not tok eq treap 2
ret 1
end
tpkreset
tpkrouter
tpkarm 2
x = tspawn
if not tok eq treap 2
ret 1
end
ret 0
end

note the router: argv 4, or DRIVE base OMC DIR
fn trouter to int
if ge argcnt 5
n = argread 4 TRT 0 4096
if lt n 1
ret 1
end
put TRTL 0 ulong n
ret 0
end
if lt argcnt 4
ret 2
end
tpkreset
for k ulong 3
tpkopen
if eq k 1
for i ulong len tbaseA
tpkb ulong get tbaseA i
end
else
n = argread sub 3 shr k 1 TRT 0 4096
for i ulong ulong n
tpkb ulong get TRT i
end
end
tpkclose
end
tpkopen
tpkdir
tpkclose
pid = fork
if eq pid 0
r = execprog TPK 0 get TPKO 0
exit 90
end
r = waitpid int pid TST 0 4 0
if or ne get TST 0 0 ne get TST 1 0
ret 3
end
tpkreset
tpkfile 1
n = sub get TPKO 0 2
for i ulong n
put TRT i get TPK add i 2
end
put TRTL 0 n
ret 0
end

fn tall to int
for a ulong 7
r = tscenario add a 1
if ne r 0
ret r
end
end
r = tcache
if ne r 0
ret r
end
r = ttap
if ne r 0
ret r
end
r = tnolib
if ne r 0
ret r
end
ret texits
end

fn main to int
if ne tmkdir 0
ret 1
end
if ne trouter 0
ret 2
end
r = tall
if ne r 0
r = tfailcode
end
if eq get TDL 1 1
x = rmdir TDIR 0 get TDL 0
end
ret r
end
