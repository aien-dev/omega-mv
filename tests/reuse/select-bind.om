note units: sha256 r1 select
note SPDX-License-Identifier: Apache-2.0
note select-bind: bind rule of contract 5.2 and K4: cold start, strict threshold, no saving, fractional and zero E_q, missing cells, exact 128-bit products, cell selection by change class, family and n class, refused ids.
note argv 1 (optional): a scratch directory; default /tmp/reuse-test-CandSelect-PID, removed at the end.
note exit 0 = pass; any other value names the failed check.
global TW ulong 200
global TB uchar 2048
global TD uchar 4096
global TDN ulong 1
global TINV ulong 1
global TMIS ulong 1
text tpre "/tmp/reuse-test-CandSelect-"

note churn counter fixtures for delta.om's dlinvn and dlmissn
fn dlinvn to ulong
ret get TINV 0
end

fn dlmissn to ulong
ret get TMIS 0
end

note decimal digits of v, least significant first, into d; returns their count
fn tdigs v ulong d edit uchar 20 to ulong
x = v
nd = ulong 0
for i ulong 20
put d i uchar add rem x 10 48
nd = add nd 1
x = div x 10
if eq x 0
break
end
end
ret nd
end

note TD = argv 1, else /tmp/reuse-test-CandSelect-PID; the directory is created; 0 ok
fn tsetdir to int
d = new uchar 20 0
if gt argcnt 1
k = argread 1 TD 0 4000
if le k 0
ret 1
end
put TDN 0 ulong k
else
for i ulong len tpre
put TD i get tpre i
end
nd = tdigs ulong getpid d
for i ulong nd
put TD add len tpre i get d sub sub nd 1 i
end
put TDN 0 add len tpre nd
end
r = makedir TD 0 get TDN 0 448
if and ne r 0 ne r -17
ret 1
end
ret 0
end

note SLPATH = TD/cK, then zero bytes
fn tpath k ulong to void
d = new uchar 20 0
n = get TDN 0
for i ulong 4096
put SLPATH i 0
end
for i ulong n
put SLPATH i get TD i
end
put SLPATH n 47
put SLPATH add n 1 99
nd = tdigs k d
for i ulong nd
put SLPATH add add n 2 i get d sub sub nd 1 i
end
end

note TW as little-endian bytes in TB
fn tenc to void
for i ulong 200
x = get TW i
for j ulong 8
put TB add mul i 8 j uchar and x 255
x = shr x 8
end
end
end

note write TB[0..n) reps times to the file named by SLPATH (created or truncated); 0 ok
fn twrite n ulong reps ulong to int
tenc
pn = slpathn
fd = fopen SLPATH 0 pn 524865 384
if lt fd 0
ret 1
end
for i ulong reps
w = write int fd TB 0 n
if ne w long n
ret 1
end
end
r = fclose int fd
ret int r
end

note a valid header with E_q x 1000 = eq and every cell missing
fn thdr eqk ulong to void
for i ulong 200
put TW i 0
end
put TW 0 3544386010811150674
put TW 1 1
put TW 2 eqk
end

note calibration cell index, recomputed from integrator decision 3
fn tci fam ulong path ulong ncl ulong ccl ulong to ulong
ret add mul add mul sub fam 1 4 path 12 add mul ncl 4 ccl
end

fn tset fam ulong path ulong ncl ulong ccl ulong p50 ulong to void
c = tci fam path ncl ccl
put TW add 8 mul 2 c p50
put TW add 9 mul 2 c add p50 7
end

note write TW to TD/cK as a whole 1600-byte file and load it; slload's result
fn tload k ulong to int
tpath k
if ne twrite 1600 1 0
ret 9
end
ret slload
end

note remove TD/c0 .. TD/c(cnt-1) and TD
fn tclean cnt ulong to void
for k ulong cnt
tpath k
r = unlink SLPATH 0 slpathn
end
r = rmdir TD 0 get TDN 0
end

note bind, full, method p50 for (fam, ncl), change class 0
fn tbfm fam ulong ncl ulong b ulong f ulong m ulong to void
tset fam 3 ncl 0 b
tset fam 0 ncl 0 f
tset fam 1 ncl 0 m
end

note one exact-bind case on family 1, n class 0, written as a file and loaded; slbind 0's answer
note as 0 false, 1 true, 9 load failed
fn tcase eqk ulong f ulong m ulong b ulong to int
thdr eqk
tbfm 1 0 b f m
if ne tload 0 0
ret 9
end
put R1P 1 1
put R1N 0 64
if slbind 0
ret 1
end
ret 0
end

note slltp vectors computed outside Omega (exact 128-bit products)
fn tltp a ulong b ulong c ulong d ulong want bool to bool
ret eq slltp a b c d want
end

fn tltpall to int
if not tltp 18008728104892228252 48845 471906480543126 566950 false
ret 1
end
if not tltp 5529725096132913496 832967 878010281577620 85831 false
ret 2
end
if not tltp 2283321169336813345 492759215392 4520258665665838332 120 false
ret 3
end
if not tltp 13966785042261406932 1022854985045 723246204962761833 782 false
ret 4
end
if not tltp 3214539141964268073 62 2665306537440459905 13219449544881422511 true
ret 5
end
if not tltp 12334465609073234568 1030889058055 3099945381023167017 505 false
ret 6
end
if not tltp 4025222987624456960 5302183279635131073 4025222987624456960 5302183279635131072 false
ret 7
end
if not tltp 4567687427430638054 7211749115353145168 4567687427430638054 7211749115353145169 true
ret 8
end
if not tltp 3068916285533387239 7409028826178384386 3068916285533387239 7409028826178384387 true
ret 9
end
if not tltp 18446744073709551615 18446744073709551615 18446744073709551615 18446744073709551615 false
ret 10
end
if not tltp 18446744073709551615 18446744073709551614 18446744073709551615 18446744073709551615 true
ret 11
end
if not tltp 4294967295 4294967295 4294967296 4294967295 true
ret 12
end
note close products where the carry of the middle partial sums decides the high half
if not tltp 276714660974385318 9746914079769519568 1098524073332020107 2455216130993885227 false
ret 13
end
if not tltp 8126364788730623507 15540037672059346467 9576149656270836970 13187347680085051096 false
ret 14
end
if not tltp 5131199888064844944 18403508568128136882 18367268841590874586 5141324054175509582 false
ret 15
end
ret 0
end

fn main to int
if ne tsetdir 0
ret 1
end
slsess
note 1: cold start (no calibration): bind iff a template exists
if ne slload 1
ret 2
end
put R1P 1 1
put R1N 0 100
if not slbind 0
ret 3
end
if not slbind 15
ret 4
end
if slbind -1
ret 5
end
note 2: E_q 4, full 1000, method 400: threshold 2400 ns, strict
if ne tcase 4000 1000 400 2399 1
ret 6
end
if ne tcase 4000 1000 400 2400 0
ret 7
end
if ne tcase 4000 1000 400 2401 0
ret 8
end
note 3: no saving (full = method, full < method): never bind, however cheap the bind
if ne tcase 4000 400 400 1 0
ret 9
end
if ne tcase 4000 399 400 1 0
ret 10
end
note 4: fractional E_q 1.5 and E_q 0
if ne tcase 1500 1001 1 1499 1
ret 11
end
if ne tcase 1500 1001 1 1500 0
ret 12
end
if ne tcase 0 1000000 1 1 0
ret 13
end
note 5: a missing bind, full or method cell: the fixed rule (bind), even where the rule says no
if ne tcase 4000 1000 400 0 1
ret 14
end
if ne tcase 4000 0 400 999999 1
ret 15
end
if ne tcase 4000 1000 0 999999 1
ret 16
end
note 6: products past 2^64 are compared exactly (vectors where a wrapped compare is wrong)
if ne tcase 2500 2405875930906139466 665358916597 669676865462416550 1
ret 17
end
if ne tcase 1000 35754111440984025 654865470870 16211234868771643983 0
ret 18
end
if ne tcase 3500 5552953252052471899 917006626064 404572246572738427 1
ret 19
end
if ne tcase 2500 6020838051475013066 659419913527109606 13167599861390161472 1
ret 20
end
if ne tcase 1000 18446744073709551615 1 18446744073709551613 1
ret 21
end
if ne tcase 1000 18446744073709551615 1 18446744073709551614 0
ret 22
end
r = tltpall
if ne r 0
ret add 60 r
end
note 7: bind is read in change class 0 only; family 2 and each n class use their own cells
thdr 4000
tbfm 1 0 999999 1000 400
tset 1 3 0 1 1
tset 1 3 0 2 1
tset 1 3 0 3 1
tbfm 2 0 1 1000 400
tbfm 1 1 1 1000 400
tbfm 1 2 999999 1000 400
if ne tload 0 0
ret 23
end
put R1P 1 1
put R1N 0 0
if slbind 0
ret 24
end
put R1N 0 64
if slbind 0
ret 25
end
put R1P 1 2
if not slbind 0
ret 26
end
put R1P 1 1
put R1N 0 65
if not slbind 0
ret 27
end
put R1N 0 512
if not slbind 0
ret 28
end
put R1N 0 513
if slbind 0
ret 29
end
put R1N 0 4096
if slbind 0
ret 30
end
note 8: no template: never bind, under any calibration (here the cheapest possible bind)
put R1N 0 65
if slbind -1
ret 31
end
if ne get SLREF 0 0
ret 32
end
note 9: unsupported ids refused before any lookup, counted, never bound
put R1P 1 0
if slbind 0
ret 33
end
put R1P 1 3
if slbind 0
ret 34
end
put R1P 1 18446744073709551615
if slbind -1
ret 35
end
put R1P 1 1
put R1N 0 4097
if slbind 0
ret 36
end
put R1N 0 65
if slbind -2
ret 37
end
if slbind 16
ret 38
end
if slbind -9223372036854775808
ret 39
end
if slbind 9223372036854775807
ret 40
end
if ne get SLREF 0 8
ret 41
end
if not slbind 15
ret 42
end
if ne get SLREF 0 8
ret 43
end
tclean 1
ret 0
end
