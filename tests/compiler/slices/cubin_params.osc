// slice-run: nv_param_off bytes: 2 1 -> 8
// slice-run: nv_params bytes: 5 cells:4 -> 18446744073709551615
// ELF64 CUDA image (cubin) reader, written in Omega (L401). The image is a caller byte slice: every b[i] is
// checked against b.len, so a read past the end traps BOUNDS; hdr_ok, layout_ok and text_count also check every
// offset before they read, so no input makes them trap. Offset checks never compute off + size (fits below),
// because an image can set an offset near 2^64 so that the sum wraps to a small number.

fn u16_at(b: bytes, o: u64) -> u64 {
    return b[o] | (b[o + 1] << 8);
}

fn u32_at(b: bytes, o: u64) -> u64 {
    return u16_at(b, o) | (u16_at(b, o + 2) << 16);
}

fn u64_at(b: bytes, o: u64) -> u64 {
    return u32_at(b, o) | (u32_at(b, o + 4) << 32);
}

// 1 when z bytes from offset o lie inside n bytes, without forming o + z
fn fits(n: u64, o: u64, z: u64) -> u64 {
    if o > n {
        return 0;
    }
    if z > n - o {
        return 0;
    }
    return 1;
}

// ELF64, little endian, current version, CUDA machine (190), executable, CUDA ABI version 7 or 8,
// 64-byte header and section entries, a section table inside the image, a string table index inside it
fn hdr_ok(b: bytes) -> u64 {
    if b.len < 64 {
        return 0;
    }
    if b[0] != 127 || b[1] != 69 || b[2] != 76 || b[3] != 70 {
        return 0;
    }
    if b[4] != 2 || b[5] != 1 || b[6] != 1 {
        return 0;
    }
    if b[8] != 7 && b[8] != 8 {
        return 0;
    }
    if u16_at(b, 16) != 2 || u16_at(b, 18) != 190 || u32_at(b, 20) != 1 {
        return 0;
    }
    if u16_at(b, 52) != 64 || u16_at(b, 58) != 64 {
        return 0;
    }
    let shn: u64 = u16_at(b, 60);
    if shn == 0 {
        return 0;
    }
    if u16_at(b, 62) >= shn {
        return 0;
    }
    return fits(b.len, u64_at(b, 40), 64 * shn);
}

// the SM number: e_flags bits 8-15 under ABI version 8, bits 0-7 under version 7; all ones for a refused image
fn arch_of(b: bytes) -> u64 {
    if hdr_ok(b) == 0 {
        return 18446744073709551615;
    }
    let f: u64 = u32_at(b, 48);
    if b[8] == 8 {
        return (f >> 8) & 255;
    }
    return f & 255;
}

// the section string table is type 3, non-empty and inside the image; every section name starts inside it;
// every section with file bytes (any type but 8, NOBITS) lies inside the image and, when non-empty,
// overlaps neither the ELF header nor the section table
fn layout_ok(b: bytes) -> u64 {
    if hdr_ok(b) == 0 {
        return 0;
    }
    let n: u64 = b.len;
    let shoff: u64 = u64_at(b, 40);
    let shn: u64 = u16_at(b, 60);
    let tend: u64 = shoff + 64 * shn;
    let st: u64 = shoff + 64 * u16_at(b, 62);
    if u32_at(b, st + 4) != 3 {
        return 0;
    }
    let ss: u64 = u64_at(b, st + 32);
    if ss == 0 {
        return 0;
    }
    if fits(n, u64_at(b, st + 24), ss) == 0 {
        return 0;
    }
    let mut i: u64 = 0;
    while i < shn bound 65536 {
        let e: u64 = shoff + 64 * i;
        if u32_at(b, e) >= ss {
            return 0;
        }
        if u32_at(b, e + 4) != 8 {
            let off: u64 = u64_at(b, e + 24);
            let sz: u64 = u64_at(b, e + 32);
            if fits(n, off, sz) == 0 {
                return 0;
            }
            if sz > 0 {
                if off < 64 {
                    return 0;
                }
                if off < tend && off + sz > shoff {
                    return 0;
                }
            }
        }
        i = i + 1;
    }
    return 1;
}

// 1 when the name at string-table offset no starts with ".text." inside the table
fn is_text_name(b: bytes, so: u64, ss: u64, no: u64) -> u64 {
    if no >= ss {
        return 0;
    }
    if ss - no < 6 {
        return 0;
    }
    let p: u64 = so + no;
    if b[p] != 46 || b[p + 1] != 116 || b[p + 2] != 101 || b[p + 3] != 120 || b[p + 4] != 116 || b[p + 5] != 46 {
        return 0;
    }
    return 1;
}

// kernels in the image: PROGBITS (type 1) sections named ".text.*"; all ones for a refused image
fn text_count(b: bytes) -> u64 {
    if layout_ok(b) == 0 {
        return 18446744073709551615;
    }
    let shoff: u64 = u64_at(b, 40);
    let shn: u64 = u16_at(b, 60);
    let st: u64 = shoff + 64 * u16_at(b, 62);
    let so: u64 = u64_at(b, st + 24);
    let ss: u64 = u64_at(b, st + 32);
    let mut c: u64 = 0;
    let mut i: u64 = 1;
    while i < shn bound 65536 {
        let e: u64 = shoff + 64 * i;
        if u32_at(b, e + 4) == 1 {
            c = c + is_text_name(b, so, ss, u32_at(b, e));
        }
        i = i + 1;
    }
    return c;
}

// Kernel parameters from a CUDA image's .nv.info sections. Same image rules as the cubin reader above.
// A .nv.info section is a sequence of records, each starting with a format byte:
//   1: no value, 2 bytes.  2: one byte, 4 bytes.  3: a u16, 4 bytes.
//   4: a u16 size, then that many bytes padded up to a multiple of 4.
// Anything else, a record that does not fit, or a section that does not end on a record boundary is a
// refusal (all ones). Nothing is guessed.
// Register count is EIATTR_REGCOUNT (format 4, attribute 47, 8 bytes: symbol index, count) in the global
// .nv.info, for the symbol index in the .text section's sh_info. It is not the top byte of sh_info.
// Parameters are EIATTR_KPARAM_INFO (attribute 23, 12 bytes) in .nv.info.<kernel>: ordinal and offset as
// u16, then a packed word whose size is bits 18..31, shared-memory flag bit 17, constant-bank id bits 12..16.
// A parameter not in bank 31, or marked shared memory, is a refusal. The bank base and block size are
// EIATTR_PARAM_CBANK (attribute 10); the block size must equal EIATTR_CBANK_PARAM_SIZE (attribute 25).

fn text_sec(b: bytes, k: u64) -> u64 {
    if layout_ok(b) == 0 {
        return 18446744073709551615;
    }
    let shoff: u64 = u64_at(b, 40);
    let shn: u64 = u16_at(b, 60);
    let st: u64 = shoff + 64 * u16_at(b, 62);
    let so: u64 = u64_at(b, st + 24);
    let ss: u64 = u64_at(b, st + 32);
    let mut seen: u64 = 0;
    let mut i: u64 = 1;
    while i < shn bound 65536 {
        let e: u64 = shoff + 64 * i;
        if u32_at(b, e + 4) == 1 {
            if is_text_name(b, so, ss, u32_at(b, e)) == 1 {
                if seen == k {
                    return i;
                }
                seen = seen + 1;
            }
        }
        i = i + 1;
    }
    return 18446744073709551615;
}

fn str_at(b: bytes, so: u64, ss: u64, no: u64, j: u64) -> u64 {
    if fits(ss, no, j + 1) == 0 {
        return 256;
    }
    return b[so + no + j];
}

// 1 when the name is exactly ".nv.info"
fn is_global_info(b: bytes, so: u64, ss: u64, no: u64) -> u64 {
    if str_at(b, so, ss, no, 0) != 46 {
        return 0;
    }
    if str_at(b, so, ss, no, 1) != 110 || str_at(b, so, ss, no, 2) != 118 || str_at(b, so, ss, no, 3) != 46 {
        return 0;
    }
    if str_at(b, so, ss, no, 4) != 105 || str_at(b, so, ss, no, 5) != 110 || str_at(b, so, ss, no, 6) != 102 {
        return 0;
    }
    if str_at(b, so, ss, no, 7) != 111 || str_at(b, so, ss, no, 8) != 0 {
        return 0;
    }
    return 1;
}

// 1 when info_no names ".nv.info." plus the part of the text name after ".text.", including the NUL
fn is_kernel_info(b: bytes, so: u64, ss: u64, text_no: u64, info_no: u64) -> u64 {
    if is_text_name(b, so, ss, text_no) == 0 {
        return 0;
    }
    if str_at(b, so, ss, info_no, 0) != 46 || str_at(b, so, ss, info_no, 1) != 110 || str_at(b, so, ss, info_no, 2) != 118 {
        return 0;
    }
    if str_at(b, so, ss, info_no, 3) != 46 || str_at(b, so, ss, info_no, 4) != 105 || str_at(b, so, ss, info_no, 5) != 110 {
        return 0;
    }
    if str_at(b, so, ss, info_no, 6) != 102 || str_at(b, so, ss, info_no, 7) != 111 || str_at(b, so, ss, info_no, 8) != 46 {
        return 0;
    }
    let mut j: u64 = 0;
    while j < 4096 bound 4096 {
        let tb: u64 = str_at(b, so, ss, text_no, 6 + j);
        let ib: u64 = str_at(b, so, ss, info_no, 9 + j);
        if tb == 256 || ib == 256 {
            return 0;
        }
        if tb != ib {
            return 0;
        }
        if tb == 0 {
            return 1;
        }
        j = j + 1;
    }
    return 0;
}

// section index of the one section of type 1879048192 (0x70000000) whose name matches `which`
// (0 = global .nv.info, 1 = the kernel's .nv.info). Two matches, or none, refuse.
fn find_info(b: bytes, which: u64, text_no: u64) -> u64 {
    let shoff: u64 = u64_at(b, 40);
    let shn: u64 = u16_at(b, 60);
    let st: u64 = shoff + 64 * u16_at(b, 62);
    let so: u64 = u64_at(b, st + 24);
    let ss: u64 = u64_at(b, st + 32);
    let mut found: u64 = 18446744073709551615;
    let mut n: u64 = 0;
    let mut i: u64 = 1;
    while i < shn bound 65536 {
        let e: u64 = shoff + 64 * i;
        if u32_at(b, e + 4) == 1879048192 {
            let no: u64 = u32_at(b, e);
            let mut hit: u64 = 0;
            if which == 0 {
                hit = is_global_info(b, so, ss, no);
            }
            if which == 1 {
                hit = is_kernel_info(b, so, ss, text_no, no);
            }
            if hit == 1 {
                found = i;
                n = n + 1;
            }
        }
        i = i + 1;
    }
    if n != 1 {
        return 18446744073709551615;
    }
    return found;
}

fn bit_count(m: u64) -> u64 {
    let mut n: u64 = 0;
    let mut i: u64 = 0;
    while i < 64 bound 64 {
        if ((m >> i) & 1) == 1 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn nv_regs(b: bytes, k: u64) -> u64 {
    let sec: u64 = text_sec(b, k);
    if sec == 18446744073709551615 {
        return 18446744073709551615;
    }
    let shoff: u64 = u64_at(b, 40);
    let sym: u64 = u32_at(b, shoff + 64 * sec + 44);
    let g: u64 = find_info(b, 0, 0);
    if g == 18446744073709551615 {
        return 18446744073709551615;
    }
    let base: u64 = u64_at(b, shoff + 64 * g + 24);
    let sz: u64 = u64_at(b, shoff + 64 * g + 32);
    let mut i: u64 = 0;
    let mut got: u64 = 18446744073709551615;
    let mut hits: u64 = 0;
    while i < sz bound 65536 {
        if fits(sz, i, 2) == 0 {
            return 18446744073709551615;
        }
        let fmt: u64 = b[base + i];
        if fmt == 1 {
            i = i + 2;
        } else {
            if fits(sz, i, 4) == 0 {
                return 18446744073709551615;
            }
            if fmt == 2 || fmt == 3 {
                i = i + 4;
            } else {
                if fmt != 4 {
                    return 18446744073709551615;
                }
                let rsz: u64 = u16_at(b, base + i + 2);
                let total: u64 = 4 + ((rsz + 3) & 18446744073709551612);
                if fits(sz, i, total) == 0 {
                    return 18446744073709551615;
                }
                if b[base + i + 1] == 47 {
                    if rsz != 8 {
                        return 18446744073709551615;
                    }
                    if u32_at(b, base + i + 4) == sym {
                        got = u32_at(b, base + i + 8);
                        hits = hits + 1;
                    }
                }
                i = i + total;
            }
        }
    }
    if i != sz || hits != 1 {
        return 18446744073709551615;
    }
    return got;
}

// what: 1 base, 2 block size, 3 count, 4 offset of parameter arg, 5 length of parameter arg
fn nv_q(b: bytes, k: u64, what: u64, arg: u64) -> u64 {
    let sec: u64 = text_sec(b, k);
    if sec == 18446744073709551615 {
        return 18446744073709551615;
    }
    let shoff: u64 = u64_at(b, 40);
    let text_no: u64 = u32_at(b, shoff + 64 * sec);
    let info: u64 = find_info(b, 1, text_no);
    if info == 18446744073709551615 {
        return 18446744073709551615;
    }
    let base: u64 = u64_at(b, shoff + 64 * info + 24);
    let sz: u64 = u64_at(b, shoff + 64 * info + 32);
    let mut i: u64 = 0;
    let mut seen_base: u64 = 0;
    let mut pbase: u64 = 0;
    let mut block: u64 = 0;
    let mut seen_size: u64 = 0;
    let mut psz: u64 = 0;
    let mut mask: u64 = 0;
    let mut want_off: u64 = 0;
    let mut want_len: u64 = 0;
    let mut saw: u64 = 0;
    while i < sz bound 65536 {
        if fits(sz, i, 2) == 0 {
            return 18446744073709551615;
        }
        let fmt: u64 = b[base + i];
        let attr: u64 = b[base + i + 1];
        if fmt == 1 {
            i = i + 2;
        } else {
            if fits(sz, i, 4) == 0 {
                return 18446744073709551615;
            }
            if fmt == 2 || fmt == 3 {
                if fmt == 3 && attr == 25 {
                    if seen_size == 1 {
                        return 18446744073709551615;
                    }
                    seen_size = 1;
                    psz = u16_at(b, base + i + 2);
                }
                i = i + 4;
            } else {
                if fmt != 4 {
                    return 18446744073709551615;
                }
                let rsz: u64 = u16_at(b, base + i + 2);
                let total: u64 = 4 + ((rsz + 3) & 18446744073709551612);
                if fits(sz, i, total) == 0 {
                    return 18446744073709551615;
                }
                if attr == 10 {
                    if rsz != 8 || seen_base == 1 {
                        return 18446744073709551615;
                    }
                    seen_base = 1;
                    pbase = u16_at(b, base + i + 8);
                    block = u16_at(b, base + i + 10);
                }
                if attr == 23 {
                    if rsz != 12 {
                        return 18446744073709551615;
                    }
                    let ordinal: u64 = u16_at(b, base + i + 8);
                    let poff: u64 = u16_at(b, base + i + 10);
                    let packed: u64 = u32_at(b, base + i + 12);
                    let plen: u64 = (packed >> 18) & 16383;
                    if ((packed >> 17) & 1) == 1 || ((packed >> 12) & 31) != 31 || plen == 0 || ordinal >= 64 {
                        return 18446744073709551615;
                    }
                    let bit: u64 = 1 << ordinal;
                    if (mask & bit) != 0 {
                        return 18446744073709551615;
                    }
                    mask = mask | bit;
                    if fits(psz, poff, plen) == 0 && seen_size == 1 {
                        return 18446744073709551615;
                    }
                    if what == 4 && arg == ordinal {
                        want_off = poff;
                        saw = 1;
                    }
                    if what == 5 && arg == ordinal {
                        want_len = plen;
                        saw = 1;
                    }
                }
                i = i + total;
            }
        }
    }
    if i != sz || seen_base == 0 || seen_size == 0 || block != psz {
        return 18446744073709551615;
    }
    if ((mask + 1) & mask) != 0 {
        return 18446744073709551615;
    }
    let n: u64 = bit_count(mask);
    // a parameter record can precede the size record, so check the fit once the size is known
    if seen_size == 1 {
        let mut j: u64 = 0;
        while j < sz bound 65536 {
            let fmt2: u64 = b[base + j];
            if fmt2 == 1 {
                j = j + 2;
            } else {
                if fmt2 == 2 || fmt2 == 3 {
                    j = j + 4;
                } else {
                    let rec2: u64 = u16_at(b, base + j + 2);
                    let total2: u64 = 4 + ((rec2 + 3) & 18446744073709551612);
                    if b[base + j + 1] == 23 {
                        let poff2: u64 = u16_at(b, base + j + 10);
                        let plen2: u64 = (u32_at(b, base + j + 12) >> 18) & 16383;
                        if fits(psz, poff2, plen2) == 0 {
                            return 18446744073709551615;
                        }
                    }
                    j = j + total2;
                }
            }
        }
    }
    if what == 1 {
        return pbase;
    }
    if what == 2 {
        return psz;
    }
    if what == 3 {
        return n;
    }
    if what == 4 && saw == 1 && arg < n {
        return want_off;
    }
    if what == 5 && saw == 1 && arg < n {
        return want_len;
    }
    return 18446744073709551615;
}

fn nv_param_base(b: bytes, k: u64) -> u64 {
    return nv_q(b, k, 1, 0);
}

fn nv_param_size(b: bytes, k: u64) -> u64 {
    return nv_q(b, k, 2, 0);
}

fn nv_param_count(b: bytes, k: u64) -> u64 {
    return nv_q(b, k, 3, 0);
}

fn nv_param_off(b: bytes, k: u64, i: u64) -> u64 {
    return nv_q(b, k, 4, i);
}

fn nv_param_len(b: bytes, k: u64, i: u64) -> u64 {
    return nv_q(b, k, 5, i);
}

fn nv_params(b: bytes, k: u64, out: cells) -> u64 {
    let regs: u64 = nv_regs(b, k);
    let pbase: u64 = nv_param_base(b, k);
    let psz: u64 = nv_param_size(b, k);
    let n: u64 = nv_param_count(b, k);
    if regs == 18446744073709551615 || pbase == 18446744073709551615 {
        return 18446744073709551615;
    }
    if psz == 18446744073709551615 || n == 18446744073709551615 {
        return 18446744073709551615;
    }
    if out.len < 4 + 2 * n {
        return 18446744073709551615;
    }
    out[0] = regs;
    out[1] = pbase;
    out[2] = psz;
    out[3] = n;
    let mut i: u64 = 0;
    let mut w: u64 = 4;
    while i < n bound 64 {
        out[w] = nv_param_off(b, k, i);
        w = w + 1;
        out[w] = nv_param_len(b, k, i);
        w = w + 1;
        i = i + 1;
    }
    return w;
}
