                                            }
                                        } else {
                                            got = got + 1;
                                            j = j + 1;
                                        }
                                    }
                                }
                            }
                        }
                        len = got;
                    }
                    n = n + 1;
                    i = e;
                }
            }
        } else {
            i = line.len;
        }
    }
    if bad == 1 {
        return 18446744073709551615;
    }
    return len;
}

fn sh_word_byte(line: bytes, index: u64, at: u64) -> u64 {
    let mut i: u64 = 0;
    let mut n: u64 = 0;
    let mut bad: u64 = 0;
    let mut out: u64 = 18446744073709551615;
    while i < line.len && bad == 0 && n <= index bound 4096 {
        i = skip_ws(line, i);
        if i < line.len && line[i] != 35 {
            let e: u64 = word_end(line, i);
            if e == 18446744073709551615 {
                bad = 1;
            } else {
                if line[i] != 124 && n == index {
                    let mut j: u64 = i;
                    let mut quote: u64 = 0;
                    let mut got: u64 = 0;
                    while j < e && got <= at bound 4096 {
                        let c: u64 = line[j];
                        if quote == 39 {
                            if c == 39 {
                                quote = 0;
                            } else {
                                if got == at {
                                    out = c;
