// slice-run: sh_nwords bytes:22 -> 18446744073709551615

fn is_ws(c: u64) -> u64 {
    if c == 32 || c == 9 || c == 10 {
        return 1;
    }
    return 0;
}

fn skip_ws(line: bytes, i: u64) -> u64 {
    let mut j: u64 = i;
    while j < line.len && is_ws(line[j]) == 1 bound 4096 {
        j = j + 1;
    }
    return j;
}

fn word_end(line: bytes, i: u64) -> u64 {
    let mut j: u64 = i;
    let mut quote: u64 = 0;
    let mut open: u64 = 1;
    while j < line.len && open == 1 bound 4096 {
        let c: u64 = line[j];
        if quote == 39 {
            if c == 39 {
                quote = 0;
            }
            j = j + 1;
        } else {
            if quote == 34 {
                if c == 34 {
                    quote = 0;
                }
                j = j + 1;
            } else {
                if c == 39 || c == 34 {
                    quote = c;
                    j = j + 1;
                } else {
                    if c == 92 {
                        j = j + 1;
                        if j < line.len {
                            j = j + 1;
                        }
                    } else {
                        if is_ws(c) == 1 || c == 124 {
                            open = 0;
                        } else {
                            j = j + 1;
                        }
                    }
                }
            }
        }
    }
    if quote != 0 {
        return 18446744073709551615;
    }
    return j;
}

fn sh_nwords(line: bytes) -> u64 {
    let mut i: u64 = 0;
    let mut n: u64 = 0;
    let mut bad: u64 = 0;
    while i < line.len && bad == 0 bound 4096 {
        i = skip_ws(line, i);
        if i < line.len && line[i] != 35 {
            let e: u64 = word_end(line, i);
            if e == 18446744073709551615 {
                bad = 1;
            } else {
                if line[i] == 124 {
                    i = i + 1;
                } else {
                    n = n + 1;
                    i = e;
                }
            }
        } else {
            i = line.len;
        }
    }
    if bad == 1 {
        return 18446744073709551615;
    }
    return n;
}

fn sh_word_len(line: bytes, index: u64) -> u64 {
    let mut i: u64 = 0;
    let mut n: u64 = 0;
    let mut bad: u64 = 0;
    let mut len: u64 = 18446744073709551615;
    while i < line.len && bad == 0 && n <= index bound 4096 {
        i = skip_ws(line, i);
        if i < line.len && line[i] != 35 {
            let start: u64 = i;
            let e: u64 = word_end(line, i);
            if e == 18446744073709551615 {
                bad = 1;
            } else {
                if line[i] == 124 {
                    i = i + 1;
                } else {
                    if n == index {
                        let mut j: u64 = start;
                        let mut quote: u64 = 0;
                        let mut got: u64 = 0;
                        while j < e bound 4096 {
                            let c: u64 = line[j];
                            if quote == 39 {
                                if c == 39 {
                                    quote = 0;
                                } else {
                                    got = got + 1;
                                }
                                j = j + 1;
                            } else {
                                if quote == 34 {
                                    if c == 34 {
                                        quote = 0;
