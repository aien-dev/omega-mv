    return out;
}

fn sh_ncmds(line: bytes) -> u64 {
    let mut i: u64 = 0;
    let mut n: u64 = 0;
    let mut bad: u64 = 0;
    let mut saw: u64 = 0;
    while i < line.len && bad == 0 bound 4096 {
        i = skip_ws(line, i);
        if i < line.len && line[i] != 35 {
            if line[i] == 124 {
                if saw == 0 {
                    bad = 1;
                }
                saw = 0;
                i = i + 1;
            } else {
                let e: u64 = word_end(line, i);
                if e == 18446744073709551615 {
                    bad = 1;
                } else {
                    if saw == 0 {
                        n = n + 1;
                        saw = 1;
                    }
                    i = e;
                }
            }
        } else {
            i = line.len;
        }
    }
    if bad == 1 {
        return 18446744073709551615;
    }
    if n == 0 {
        return 0;
    }
    return n;
}
