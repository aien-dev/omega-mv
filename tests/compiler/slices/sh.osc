                                } else {
                                    if c == 92 {
                                        j = j + 1;
                                        if j < e {
                                            if got == at {
                                                out = line[j];
                                            }
                                            got = got + 1;
                                            j = j + 1;
                                        }
                                    } else {
                                        if got == at {
                                            out = c;
                                        }
                                        got = got + 1;
