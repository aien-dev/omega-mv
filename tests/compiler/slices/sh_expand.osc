// slice-entry: sh_expand_len
// Variable expansion, the next piece of the shell. $NAME is replaced in
// unquoted text and in double quotes. Single quotes keep the dollars. A name
// matches only when the next byte is not a name byte. ${NAME} is left alone.
// slice-run: sh_expand_len bytes:24484f4d452f62696e bytes:484f4d45 bytes:2f726f6f74 -> 9
// slice-run: sh_expand_len bytes:2724484f4d4527 bytes:484f4d45 bytes:2f726f6f74 -> 5
// slice-run: sh_expand_len bytes:2224484f4d4522 bytes:484f4d45 bytes:2f726f6f74 -> 5
// slice-run: sh_expand_len bytes:24484f4d452f62696e bytes:55534552 bytes:2f726f6f74 -> 9

fn name_byte(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return 1;
    }
    if c >= 97 && c <= 122 {
        return 1;
    }
    if c >= 48 && c <= 57 {
        return 1;
    }
    if c == 95 {
        return 1;
    }
    return 0;
}

fn name_here(line: bytes, j: u64, name: bytes) -> u64 {
    if j + 1 + name.len > line.len {
        return 0;
    }
    let mut k: u64 = 0;
    while k < name.len bound 64 {
        if line[j + 1 + k] != name[k] {
            return 0;
        }
        k = k + 1;
    }
    if j + 1 + name.len < line.len && name_byte(line[j + 1 + name.len]) == 1 {
        return 0;
    }
    return 1;
}

fn sh_expand_len(line: bytes, name: bytes, value: bytes) -> u64 {
    let mut i: u64 = 0;
    let mut n: u64 = 0;
    let mut quote: u64 = 0;
    let mut bad: u64 = 0;
    while i < line.len && bad == 0 bound 4096 {
        let c: u64 = line[i];
        if quote == 39 {
            if c == 39 {
                quote = 0;
            } else {
                n = n + 1;
            }
            i = i + 1;
        } else {
            if c == 39 && quote == 0 {
                quote = 39;
                i = i + 1;
            } else {
                if c == 34 {
                    if quote == 34 {
                        quote = 0;
                    } else {
                        quote = 34;
                    }
                    i = i + 1;
                } else {
                    if c == 36 && line[i] == 36 && name_here(line, i, name) == 1 {
                        n = n + value.len;
                        i = i + 1 + name.len;
                    } else {
                        n = n + 1;
                        i = i + 1;
                    }
                }
            }
        }
    }
    if quote != 0 || bad == 1 {
        return 18446744073709551615;
    }
    return n;
}
