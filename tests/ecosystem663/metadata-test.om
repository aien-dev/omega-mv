put ES 5 1073741825
check emcheck -8
fixture
put ED 4 6
check emcheck -6
fixture
put ED 4 18446744073709551615
check emcheck -6
fixture
put ED 16 18446744073709551615
check emcheck -6
fixture
put ED 8 1
put ED 3 3
put ED 16 18446744073709551615
check emcheck 0
fixture
put ED 16 0
check emcheck 0
fixture
put ED 16 1
put ED 17 2
check emcheck 0
put ES 5 5
check emcheck -6
fixture
put ED 2 0
put ED 3 1
put ED 4 5
check emcheck 0
put ED 4 6
check emcheck -6
fixture
put ED 2 8
put ED 3 1
for i ulong 8
put ED add 8 i 1
put ED add 16 i 18446744073709551615
end
check emcheck 0
fixture
put ED 2 1
put ED 8 1073741824
put ED 3 1073741824
put ED 16 0
put ES 5 1
check emcheck 0
put ED 16 1
put ES 5 1073741824
check emcheck 0
put ED 4 1
check emcheck -6
end

fn lifetime to void
fixture
check emlive 4 17 0
put ED 5 0
put ES 2 0
check emcheck 0
put ED 5 4294967295
put ES 2 4294967295
check emcheck 0
put ED 5 4294967296
put ES 2 4294967296
check emcheck -5
fixture
check emlive 5 17 -5
check emlive 4 0 -5
check emlive 4 16 -5
check emrelease 4 16 -5
check emlive 4 17 0
check emrelease 4 17 0
check int get ES 0 0
check int get ES 3 18
check emcheck -5
check emrelease 4 17 -5
put ES 0 1
check emcheck -5
put ED 6 18
check emcheck 0
check emlive 4 17 -5
fixture
put ES 1 1
check emcheck -5
fixture
put ES 0 2
check emcheck -5
fixture
put ES 1 2
check emcheck -5
fixture
put ES 3 18446744073709551615
put ED 6 18446744073709551615
check emcheck 0
check emrelease 4 18446744073709551615 0
check int get ES 0 0
check int get ES 1 1
check emlive 4 18446744073709551615 -5
put ES 0 1
check emcheck -5
if ne get ES 3 18446744073709551615
check 1 0
end
fixture
check emcheck 0
end

note Independent oracle visits every element; it never uses maximal extent.
fn oracle a ulong b ulong s ulong t ulong off ulong cap ulong to int
for i ulong a
for j ulong b
index = add off add mul i s mul j t
if ge index cap
ret -6
end
end
end
ret 0
end

fn enumerate to void
fixture
for ai ulong 3
a = add ai 1
put ED 8 a
for bi ulong 3
b = add bi 1
put ED 9 b
put ED 3 mul a b
for s ulong 5
put ED 16 s
for t ulong 5
put ED 17 t
for off ulong 4
put ED 4 off
for ci ulong 16
cap = add ci 1
put ES 5 cap
want = oracle a b s t off cap
check emcheck want
end
end
end
end
end
end
end

fn main to int
direct
lifetime
enumerate
w = write 1 Pass 0 len Pass
number get EC 0
w = write 1 NL 0 1
if ne w 1
ret 90
end
ret 0
end
