note Native checks plus independent element-by-element view bounds oracle.
global EC ulong 1
global Digits uchar 20
text Pass "M20_METADATA_V1_PASS checks="
text Fail "M20_METADATA_V1_FAIL check="
text NL "\n"

fn number n ulong to void
if eq n 0
put Digits 0 48
w = write 1 Digits 0 1
if ne w 1
exit 90
end
ret
end
pos = ulong 20
while gt n 0 bound 20
pos = sub pos 1
put Digits pos uchar add 48 rem n 10
n = div n 10
end
w = write 1 Digits pos sub 20 pos
if ne w long sub 20 pos
exit 90
end
end

fn check got int want int to void
put EC 0 add get EC 0 1
if ne got want
w = write 1 Fail 0 len Fail
number get EC 0
w = write 1 NL 0 1
if ne w 1
exit 90
end
exit 1
end
end

fn fixture to void
for i ulong 24
put ED i 0
end
for i ulong 8
put ES i 0
end
put ED 0 1
put ED 1 1
put ED 2 2
put ED 3 6
put ED 5 4
put ED 6 17
put ED 8 2
put ED 9 3
put ED 16 3
put ED 17 1
put ES 0 1
put ES 2 4
put ES 3 17
put ES 4 1
put ES 5 6
end

