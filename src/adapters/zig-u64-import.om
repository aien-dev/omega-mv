note SPDX-License-Identifier: AGPL-3.0-or-later
note Handwritten bounded Zig 0.17 u64 wrapping-expression importer, profile zig-u64-wrapping-pure-v1.
note No Zig compiler, parser library or host fallback. Spec: spec/universal/zig-u64-v1.md.
note SHA256 definitions are the unchanged, pinned source-aware vendor core prepended at build.
global Src uchar 4096
global Extra uchar 1
global Out uchar 8192
global Slen ulong 1
global Cur ulong 1
global Tk ulong 1
global Ts ulong 1
global Te ulong 1
global Tv ulong 1
global Npar ulong 1
global Fnoff ulong 1
global Fnlen ulong 1
global Poff ulong 6
global Plen ulong 6
global Pref ulong 6
global Nop ulong 1
global Beg ulong 64
global Ends ulong 64
global Nu ulong 64
text Fixed "u64 pub fn return as _"
text Keys "addrspace align allowzero and anyframe anytype asm break callconv catch comptime const continue defer else enum errdefer error export extern fn for if inline noalias noinline nosuspend opaque or orelse packed pub resume return linksection struct suspend switch test threadlocal try union unreachable var volatile while async await usingnamespace main"
text Prims "anyerror anyframe anyopaque bool c_int c_long c_longdouble c_longlong c_char c_short c_uint c_ulong c_ulonglong c_ushort comptime_float comptime_int f128 f16 f32 f64 f80 false isize noreturn null true type undefined usize void"
text Entry "calc omega_"
text ESyn "ZIG_IMPORT_SYNTAX\n"
text EType "ZIG_IMPORT_UNSUPPORTED_TYPE\n"
text ECap "ZIG_IMPORT_LIMIT\n"
text EArith "ZIG_IMPORT_UNSUPPORTED_ARITHMETIC\n"
text EForm "ZIG_IMPORT_UNSUPPORTED_CONSTRUCT\n"
text EName "ZIG_IMPORT_UNKNOWN_IDENTIFIER\n"
text ESig "ZIG_IMPORT_UNSUPPORTED_SIGNATURE\n"
text ELex "ZIG_IMPORT_UNSUPPORTED_SOURCE_FORM\n"
text EIO "ZIG_IMPORT_IO\n"

fn die code ulong to void
if eq code 65
w = write 2 ESyn 0 len ESyn
end
if eq code 66
w = write 2 EType 0 len EType
end
if eq code 67
w = write 2 ECap 0 len ECap
end
if eq code 68
w = write 2 EArith 0 len EArith
end
if eq code 69
w = write 2 EForm 0 len EForm
end
if eq code 70
w = write 2 EName 0 len EName
end
if eq code 71
w = write 2 ESig 0 len ESig
end
if eq code 72
w = write 2 ELex 0 len ELex
end
if eq code 77
w = write 2 EIO 0 len EIO
end
exit int code
end

fn alpha c uchar to bool
ret or or and ge c 65 le c 90 and ge c 97 le c 122 eq c 95
end

fn digit c uchar to bool
ret and ge c 48 le c 57
end

fn ident c uchar to bool
ret or alpha c digit c
end

fn srcdig p ulong to bool
if ge p get Slen 0
ret false
end
ret digit get Src p
end

fn srcid p ulong to bool
if ge p get Slen 0
ret false
end
ret ident get Src p
end

fn srcis p ulong c ulong to bool
if ge p get Slen 0
ret false
end
ret eq ulong get Src p c
end

note Zig std.ascii.isWhitespace restricted to the bytes the profile admits: space, tab, LF, CR.
fn wsat p ulong to bool
if ge p get Slen 0
ret false
end
c = get Src p
ret or or eq c 32 eq c 9 or eq c 10 eq c 13
end

note Strict UTF-8 (no overlong, surrogate or above U+10FFFF) over the whole source.
fn utf8 to bool
n = get Slen 0
pos = ulong 0
while lt pos n
c = ulong get Src pos
pos = add pos 1
if ge c 128
extra = ulong 0
v = ulong 0
low = ulong 0
if and ge c 194 le c 223
extra = 1
v = and c 31
low = 128
end
if and ge c 224 le c 239
extra = 2
v = and c 15
low = 2048
end
if and ge c 240 le c 244
extra = 3
v = and c 7
low = 65536
end
if eq extra 0
ret false
end
if gt extra sub n pos
ret false
end
for j ulong extra
c = ulong get Src pos
if or lt c 128 gt c 191
ret false
end
v = or shl v 6 and c 63
pos = add pos 1
end
if lt v low
ret false
end
if gt v 1114111
ret false
end
if and ge v 55296 le v 57343
ret false
end
end
end
ret true
end

note Ordinary line comment. Doc comments (/// not followed by /, and //!) refuse 72. Comment bytes are
note those the Zig 0.17 tokenizer admits: 0x20..0x7E, UTF-8 sequences, and CR only before LF.
fn linecom to void
p = get Cur 0
if srcis add p 2 33
die 72
end
if srcis add p 2 47
if not srcis add p 3 47
die 72
end
end
p = add p 2
more = ulong 1
while and eq more 1 lt p get Slen 0
c = get Src p
if eq c 10
more = 0
else
if eq c 13
if not srcis add p 1 10
die 72
end
else
if or lt c 32 eq c 127
die 72
end
end
p = add p 1
end
end
put Cur 0 p
end

fn spaces to void
more = ulong 1
while eq more 1
if ge get Cur 0 get Slen 0
ret
end
p = get Cur 0
if wsat p
put Cur 0 add p 1
else
if and srcis p 47 srcis add p 1 47
linecom
else
more = 0
end
end
end
end

fn idlex to void
p = add get Cur 0 1
while srcid p
p = add p 1
end
put Tk 0 256
put Cur 0 p
put Te 0 p
end

note Builtin @name: token 260 covering "@name"; a quoted identifier @"..." refuses 69.
fn atlex to void
p = add get Cur 0 1
if not srcid p
die 69
end
if srcdig p
die 69
end
while srcid p
p = add p 1
end
put Tk 0 260
put Cur 0 p
put Te 0 p
end

note Decimal literal: 0 or [1-9][0-9]*; no _, prefixes, exponent or fraction; value at most 2^64-1.
fn numlex to void
p = get Cur 0
if eq get Src p 48
if srcid add p 1
die 68
end
end
v = ulong 0
while srcdig p
d = sub ulong get Src p 48
if gt v 1844674407370955161
die 67
end
if and eq v 1844674407370955161 gt d 5
die 67
end
v = add mul v 10 d
p = add p 1
end
if srcid p
die 68
end
if srcis p 46
die 68
end
put Tk 0 257
put Tv 0 v
put Cur 0 p
put Te 0 p
end

note + - * followed by % are the wrapping operators 261/262/263; followed by %= they are compound
note assignment (264). Every other form keeps its single-byte code and refuses as arithmetic.
fn punct p ulong c ulong to void
k = c
n = ulong 1
if and or or eq c 43 eq c 45 eq c 42 srcis add p 1 37
n = 2
if eq c 43
k = 261
end
if eq c 45
k = 262
end
if eq c 42
k = 263
end
if srcis add p 2 61
k = 264
n = 3
end
end
put Tk 0 k
put Cur 0 add p n
put Te 0 add p n
end

fn lexnext to void
spaces
p = get Cur 0
put Ts 0 p
if ge p get Slen 0
put Tk 0 0
put Te 0 p
ret
end
c = get Src p
if alpha c
idlex
else
if digit c
numlex
else
if gt c 127
die 69
end
if eq c 64
atlex
else
punct p ulong c
end
end
end
end

fn word off ulong n ulong to bool
if or ne get Tk 0 256 ne sub get Te 0 get Ts 0 n
ret false
end
for i ulong n
if ne get Src add get Ts 0 i get Fixed add off i
ret false
end
end
ret true
end

fn keyeq off ulong n ulong to bool
if ne sub get Te 0 get Ts 0 n
ret false
end
for i ulong n
if ne get Src add get Ts 0 i get Keys add off i
ret false
end
end
ret true
end

fn primeq off ulong n ulong to bool
if ne sub get Te 0 get Ts 0 n
ret false
end
for i ulong n
if ne get Src add get Ts 0 i get Prims add off i
ret false
end
end
ret true
end

fn keychar p ulong to bool
if ge p len Keys
ret false
end
ret ne get Keys p 32
end

fn primchar p ulong to bool
if ge p len Prims
ret false
end
ret ne get Prims p 32
end

fn iskey to bool
if ne get Tk 0 256
ret false
end
p = ulong 0
while lt p len Keys
b = p
while keychar p
p = add p 1
end
if keyeq b sub p b
ret true
end
p = add p 1
end
ret false
end

note Zig primitive names: the fixed list, and every [iu][0-9]+ integer type name (std/zig/primitives.zig).
fn isprim to bool
if ne get Tk 0 256
ret false
end
s = get Ts 0
n = sub get Te 0 s
c = get Src s
if and ge n 2 or eq c 105 eq c 117
q = ulong 1
for i ulong sub n 1
if not digit get Src add add s 1 i
q = 0
end
end
if eq q 1
ret true
end
end
p = ulong 0
while lt p len Prims
b = p
while primchar p
p = add p 1
end
if primeq b sub p b
ret true
end
p = add p 1
end
ret false
end

fn entryok to bool
n = sub get Te 0 get Ts 0
if eq n 4
for i ulong 4
if ne get Src add get Ts 0 i get Entry i
ret false
end
end
ret true
end
if le n 6
ret false
end
for i ulong 6
if ne get Src add get Ts 0 i get Entry add i 5
ret false
end
end
ret true
end

fn nameok to void
if ne get Tk 0 256
die 69
end
if gt sub get Te 0 get Ts 0 32
die 71
end
c = get Src get Ts 0
if or lt c 97 gt c 122
die 71
end
if iskey
die 71
end
if isprim
die 71
end
end

fn need k ulong to void
if ne get Tk 0 k
die 65
end
lexnext
end

fn badarith to bool
k = get Tk 0
if or or eq k 43 eq k 45 eq k 42
ret true
end
if or eq k 47 eq k 37
ret true
end
if or eq k 60 eq k 62
ret true
end
if or or eq k 38 eq k 124 eq k 94
ret true
end
if or or eq k 126 eq k 33 eq k 61
ret true
end
ret eq k 264
end

note Expect token k; an operator here is unsupported arithmetic (68), a separator or end is syntax (65).
fn closer k ulong to void
t = get Tk 0
if eq t k
lexnext
ret
end
if badarith
die 68
end
if or or eq t 0 eq t 41 or eq t 44 or eq t 125 eq t 59
die 65
end
if eq t 256
if iskey
die 69
end
die 65
end
if eq t 257
die 65
end
die 69
end

fn same off ulong count ulong to bool
if ne count sub get Te 0 get Ts 0
ret false
end
for i ulong count
if ne get Src add off i get Src add get Ts 0 i
ret false
end
end
ret true
end

fn leput off ulong v ulong n ulong to void
for i ulong n
put Out add off i uchar and shr v mul i 8 255
end
end

fn emitop op ulong a ulong b ulong imm ulong lo ulong hi ulong to ulong
i = get Nop 0
if ge i 64
die 67
end
p = add 57 mul i 20
for j ulong 20
put Out add p j 0
end
put Out p 6
put Out add p 1 1
put Out add p 2 uchar op
put Out add p 3 1
if ne op 9
put Out add p 4 1
end
if ne op 1
put Out add p 7 1
end
leput add p 8 a 2
leput add p 10 b 2
leput add p 12 imm 8
put Beg i lo
put Ends i hi
put Nu i 0
put Nop 0 add i 1
ret i
end

note A bare literal (op 1, Nu = 1) is comptime_int in Zig; a typed constant is @as(u64, literal).
fn literal typed ulong to ulong
node = emitop 1 65535 65535 get Tv 0 get Ts 0 get Te 0
if eq typed 0
put Nu node 1
end
lexnext
ret node
end

fn identprim to ulong
if word 21 1
die 69
end
for j ulong get Npar 0
if gt get Plen j 0
if same get Poff j get Plen j
put Pref j add get Pref j 1
lexnext
ret j
end
end
end
if iskey
die 69
end
if isprim
die 66
end
lexnext
if or or eq get Tk 0 40 eq get Tk 0 46 eq get Tk 0 58
die 69
end
die 70
ret 0
end

note @as(u64, LITERAL): a typed constant. Its parenthesis counts toward the depth limit.
fn builtin depth ulong to ulong
s = get Ts 0
if ne sub get Te 0 s 3
die 69
end
if or ne get Src add s 1 97 ne get Src add s 2 115
die 69
end
if gt add depth 1 16
die 67
end
lexnext
if ne get Tk 0 40
die 69
end
lexnext
if not word 0 3
if eq get Tk 0 256
die 66
end
die 69
end
lexnext
need 44
if ne get Tk 0 257
if or or eq get Tk 0 41 eq get Tk 0 0 eq get Tk 0 44
die 65
end
die 69
end
node = literal 1
closer 41
ret node
end

fn primary depth ulong to ulong
if gt depth 16
die 67
end
t = get Tk 0
if eq t 257
ret literal 0
end
if eq t 256
ret identprim
end
if eq t 260
ret builtin depth
end
if eq t 40
lexnext
node = expr add depth 1
closer 41
ret node
end
if or or eq t 261 eq t 262 eq t 263
die 68
end
if badarith
die 68
end
if or or eq t 0 eq t 41 or eq t 44 or eq t 125 eq t 59
die 65
end
die 69
ret 0
end

note Zig requires whitespace on both sides of a binary operator or on neither (std/zig/Parse.zig).
fn opws to void
wb = ulong 0
if wsat sub get Ts 0 1
wb = 1
end
wa = ulong 0
if wsat get Te 0
wa = 1
end
if ne wb wa
die 65
end
end

note Both operands untyped comptime_int literals: Zig evaluates that operation exactly at compile time, not
note modulo 2^64, so it is refused (68); at least one operand must be u64.
fn binop code ulong left ulong right ulong lo ulong hi ulong to ulong
if and eq get Nu left 1 eq get Nu right 1
die 68
end
ret emitop code left right 0 lo hi
end

fn term depth ulong to ulong
left = primary depth
while eq get Tk 0 263
opws
lo = get Ts 0
hi = get Te 0
lexnext
right = primary depth
left = binop 4 left right lo hi
end
ret left
end

fn expr depth ulong to ulong
left = term depth
while or eq get Tk 0 261 eq get Tk 0 262
opws
code = sub get Tk 0 259
lo = get Ts 0
hi = get Te 0
lexnext
right = term depth
left = binop code left right lo hi
end
ret left
end

fn ptype to void
if not word 0 3
if iskey
die 69
end
t = get Tk 0
if or eq t 256 or eq t 42 or eq t 63 eq t 91
die 66
end
if eq t 33
die 69
end
die 65
end
lexnext
end

note A parameter is a name or the discard _; a named parameter must be used (Zig rejects an unused one).
fn param to void
j = get Npar 0
if ge j 6
die 67
end
if word 21 1
put Poff j get Ts 0
put Plen j 0
else
if iskey
lexnext
if eq get Tk 0 58
die 71
end
die 69
end
nameok
if same get Fnoff 0 get Fnlen 0
die 71
end
for k ulong j
if gt get Plen k 0
if same get Poff k get Plen k
die 71
end
end
end
put Poff j get Ts 0
put Plen j sub get Te 0 get Ts 0
end
put Pref j 0
x = emitop 9 65535 65535 j get Ts 0 get Te 0
put Npar 0 add j 1
lexnext
need 58
ptype
end

fn params to void
if eq get Tk 0 41
lexnext
ret
end
more = ulong 1
while eq more 1
param
if eq get Tk 0 44
lexnext
if eq get Tk 0 41
die 65
end
else
more = 0
end
end
need 41
end

fn header to void
lexnext
if not word 4 3
die 69
end
lexnext
if not word 8 2
die 69
end
lexnext
nameok
if not entryok
die 71
end
put Fnoff 0 get Ts 0
put Fnlen 0 sub get Te 0 get Ts 0
lexnext
need 40
params
ptype
need 123
end

fn parse to void
put Cur 0 0
header
if eq get Tk 0 125
die 65
end
if not word 11 6
die 69
end
lexnext
root = expr 0
closer 59
closer 125
if ne get Tk 0 0
die 69
end
for j ulong get Npar 0
if and gt get Plen j 0 eq get Pref j 0
die 71
end
end
z = emitop 1 65535 65535 0 0 0
root = emitop 2 root z 0 0 0
end

fn parent to void
put Out 25 212
put Out 26 237
put Out 27 97
put Out 28 72
put Out 29 191
put Out 30 169
put Out 31 124
put Out 32 198
put Out 33 147
put Out 34 211
put Out 35 250
put Out 36 68
put Out 37 149
put Out 38 226
put Out 39 215
put Out 40 226
put Out 41 230
put Out 42 138
put Out 43 186
put Out 44 4
put Out 45 96
put Out 46 122
put Out 47 126
put Out 48 150
put Out 49 221
put Out 50 154
put Out 51 156
put Out 52 84
put Out 53 191
put Out 54 144
put Out 55 115
put Out 56 168
end

fn envelope to ulong
n = get Nop 0
sem = add 44 mul 20 n
prov = add add 74 mul 8 n get Slen 0
put Out 0 79
put Out 1 77
put Out 2 83
put Out 3 66
put Out 4 1
leput 5 sem 4
leput 9 prov 4
put Out 13 79
put Out 14 77
put Out 15 83
put Out 16 65
put Out 17 2
put Out 18 6
put Out 19 8
put Out 20 1
put Out 21 0
put Out 22 1
leput 23 n 2
parent
s = add 13 sem
put Out s 79
put Out add s 1 77
put Out add s 2 83
put Out add s 3 80
put Out add s 4 1
put Out add s 5 1
leput add s 6 get Slen 0 4
hinit
for i ulong sem
hbyte get Out add 13 i
end
finish
for i ulong 32
put Out add add s 10 i get Hash i
end
hinit
for i ulong get Slen 0
hbyte get Src i
end
finish
for i ulong 32
put Out add add s 42 i get Hash i
end
for i ulong n
leput add add s 74 mul i 8 get Beg i 4
leput add add s 78 mul i 8 get Ends i 4
end
b = add add s 74 mul n 8
for i ulong get Slen 0
put Out add b i get Src i
end
ret add add 13 sem prov
end

fn main to int
n = ulong 0
more = ulong 1
while and eq more 1 lt n 4096
r = read 0 Src n sub 4096 n
if lt r 0
die 77
end
if eq r 0
more = 0
else
n = add n ulong r
end
end
if eq n 4096
r = read 0 Extra 0 1
if lt r 0
die 77
end
if gt r 0
die 67
end
end
put Slen 0 n
for i ulong n
if eq get Src i 0
die 65
end
end
if not utf8
die 72
end
if and srcis 0 239 and srcis 1 187 srcis 2 191
die 72
end
constants
parse
n = envelope
sent = ulong 0
while lt sent n
r = write 1 Out sent sub n sent
if le r 0
die 77
end
sent = add sent ulong r
end
ret 0
end
