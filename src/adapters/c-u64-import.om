note SPDX-License-Identifier: AGPL-3.0-or-later
note Handwritten bounded C17 uint64 expression importer. No C compiler runtime or host parser.
note SHA256 definitions are the unchanged, pinned source-aware vendor core prepended at build.
global Src uchar 4096
global Extra uchar 1
global Out uchar 8192
global Slen ulong 1
global Cur ulong 1
global Tk ulong 1
global Ts ulong 1
global Te ulong 1
global Tv ulong 1
global Npar ulong 1
global Poff ulong 6
global Plen ulong 6
global Nop ulong 1
global Beg ulong 64
global Ends ulong 64
text Header "#include <stdint.h>\n"
text Words "uint64_t return void auto break case char const continue default do double else enum extern float for goto if inline int long register restrict short signed sizeof static struct switch typedef union unsigned volatile while main"
text Entry "calc omega_"
text EType "C_IMPORT_UNSUPPORTED_TYPE\n"
text ESyn "C_IMPORT_SYNTAX\n"
text ECap "C_IMPORT_LIMIT\n"
text EArith "C_IMPORT_UNSUPPORTED_ARITHMETIC\n"
text EForm "C_IMPORT_UNSUPPORTED_CONSTRUCT\n"
text EName "C_IMPORT_UNKNOWN_IDENTIFIER\n"
text ESig "C_IMPORT_UNSUPPORTED_SIGNATURE\n"
text EHead "C_IMPORT_UNSUPPORTED_PREPROCESSOR\n"
text EIO "C_IMPORT_IO\n"

fn die code ulong to void
if eq code 65
w = write 2 ESyn 0 len ESyn
end
if eq code 66
w = write 2 EType 0 len EType
end
if eq code 67
w = write 2 ECap 0 len ECap
end
if eq code 68
w = write 2 EArith 0 len EArith
end
if eq code 69
w = write 2 EForm 0 len EForm
end
if eq code 70
w = write 2 EName 0 len EName
end
if eq code 71
w = write 2 ESig 0 len ESig
end
if eq code 72
w = write 2 EHead 0 len EHead
end
if eq code 77
w = write 2 EIO 0 len EIO
end
exit int code
end

fn alpha c uchar to bool
ret or or and ge c 65 le c 90 and ge c 97 le c 122 eq c 95
end

fn digit c uchar to bool
ret and ge c 48 le c 57
end

fn ident c uchar to bool
ret or alpha c digit c
end

fn srcdig p ulong to bool
if ge p get Slen 0
ret false
end
ret digit get Src p
end

fn srcid p ulong to bool
if ge p get Slen 0
ret false
end
ret ident get Src p
end

fn notnl p ulong to bool
if ge p get Slen 0
ret false
end
ret ne get Src p 10
end

fn wrdchar p ulong to bool
if ge p len Words
ret false
end
ret ne get Words p 32
end

fn linecom to void
p = add get Cur 0 2
while notnl p
p = add p 1
end
put Cur 0 p
end

fn blockcom to void
p = add get Cur 0 2
while lt add p 1 get Slen 0
a = get Src p
b = get Src add p 1
if and eq a 42 eq b 47
put Cur 0 add p 2
ret
end
p = add p 1
end
die 65
end

fn spaces to void
more = ulong 1
while eq more 1
if ge get Cur 0 get Slen 0
ret
end
p = get Cur 0
c = get Src p
if or or eq c 32 eq c 9 or eq c 10 eq c 13
put Cur 0 add p 1
else
if and eq c 47 lt add p 1 get Slen 0
d = get Src add p 1
if eq d 47
linecom
else
if eq d 42
blockcom
else
more = 0
end
end
else
more = 0
end
end
end
end

fn idlex to void
p = add get Cur 0 1
while srcid p
p = add p 1
end
put Tk 0 256
put Cur 0 p
put Te 0 p
end

fn numlex to void
p = get Cur 0
if eq get Src p 48
if srcdig add p 1
die 68
end
end
v = ulong 0
while srcdig p
d = sub ulong get Src p 48
if gt v 1844674407370955161
die 67
end
if and eq v 1844674407370955161 gt d 5
die 67
end
v = add mul v 10 d
p = add p 1
end
if gt add p 3 get Slen 0
die 68
end
a = get Src p
b = get Src add p 1
c = get Src add p 2
if or or ne a 85 ne b 76 ne c 76
die 68
end
p = add p 3
put Tk 0 257
put Tv 0 v
put Cur 0 p
put Te 0 p
end

fn lexnext to void
spaces
p = get Cur 0
put Ts 0 p
if ge p get Slen 0
put Tk 0 0
put Te 0 p
ret
end
c = get Src p
if alpha c
idlex
else
if digit c
numlex
else
if gt c 127
die 69
end
put Tk 0 ulong c
put Cur 0 add p 1
put Te 0 add p 1
end
end
end

fn word off ulong n ulong to bool
if or ne get Tk 0 256 ne sub get Te 0 get Ts 0 n
ret false
end
for i ulong n
if ne get Src add get Ts 0 i get Words add off i
ret false
end
end
ret true
end

fn reserved to bool
p = ulong 0
while lt p len Words
b = p
while wrdchar p
p = add p 1
end
if word b sub p b
ret true
end
p = add p 1
end
ret false
end

fn typeprefix to bool
n = sub get Te 0 get Ts 0
p = get Ts 0
if ge n 3
if eq get Src p 105
if and eq get Src add p 1 110 eq get Src add p 2 116
ret true
end
end
end
if ge n 4
if eq get Src p 117
if and eq get Src add p 1 105 eq get Src add p 2 110
ret eq get Src add p 3 116
end
end
end
ret false
end

fn entryok to bool
n = sub get Te 0 get Ts 0
if eq n 4
for i ulong 4
if ne get Src add get Ts 0 i get Entry i
ret false
end
end
ret true
end
if le n 6
ret false
end
for i ulong 6
if ne get Src add get Ts 0 i get Entry add i 5
ret false
end
end
ret true
end

fn nameok to void
if ne get Tk 0 256
die 69
end
if gt sub get Te 0 get Ts 0 32
die 71
end
c = get Src get Ts 0
if or lt c 97 gt c 122
die 71
end
if typeprefix
die 71
end
if reserved
die 71
end
end

fn need k ulong to void
if ne get Tk 0 k
die 65
end
lexnext
end

fn ctype to void
if not word 0 8
die 66
end
lexnext
end

fn same off ulong count ulong to bool
if ne count sub get Te 0 get Ts 0
ret false
end
for i ulong count
if ne get Src add off i get Src add get Ts 0 i
ret false
end
end
ret true
end

fn findpar to ulong
for j ulong get Npar 0
if same get Poff j get Plen j
ret j
end
end
die 70
ret 0
end

fn leput off ulong v ulong n ulong to void
for i ulong n
put Out add off i uchar and shr v mul i 8 255
end
end

fn emitop op ulong a ulong b ulong imm ulong lo ulong hi ulong to ulong
i = get Nop 0
if ge i 64
die 67
end
p = add 57 mul i 20
for j ulong 20
put Out add p j 0
end
put Out p 1
put Out add p 1 1
put Out add p 2 uchar op
put Out add p 3 1
if ne op 9
put Out add p 4 1
end
if ne op 1
put Out add p 7 1
end
leput add p 8 a 2
leput add p 10 b 2
leput add p 12 imm 8
put Beg i lo
put Ends i hi
put Nop 0 add i 1
ret i
end

fn primary depth ulong to ulong
if gt depth 16
die 67
end
if eq get Tk 0 257
node = emitop 1 65535 65535 get Tv 0 get Ts 0 get Te 0
lexnext
ret node
end
if eq get Tk 0 256
node = findpar
lexnext
ret node
end
if eq get Tk 0 40
lexnext
node = expr add depth 1
need 41
ret node
end
die 68
ret 0
end

fn term depth ulong to ulong
left = primary depth
while eq get Tk 0 42
lo = get Ts 0
hi = get Te 0
lexnext
right = primary depth
left = emitop 4 left right 0 lo hi
end
ret left
end

fn expr depth ulong to ulong
left = term depth
while or eq get Tk 0 43 eq get Tk 0 45
code = ulong 2
if eq get Tk 0 45
code = 3
end
lo = get Ts 0
hi = get Te 0
lexnext
right = term depth
left = emitop code left right 0 lo hi
end
ret left
end

fn badarith to bool
k = get Tk 0
if or eq k 47 eq k 37
ret true
end
if or eq k 60 eq k 62
ret true
end
if or eq k 38 eq k 124
ret true
end
if or eq k 94 eq k 63
ret true
end
ret false
end

fn parse to void
if lt get Slen 0 len Header
die 72
end
for i ulong len Header
if ne get Src i get Header i
die 72
end
end
put Cur 0 len Header
lexnext
ctype
nameok
if not entryok
die 71
end
lexnext
need 40
if word 16 4
lexnext
need 41
else
more = ulong 1
while eq more 1
ctype
nameok
j = get Npar 0
if ge j 6
die 67
end
for k ulong j
if same get Poff k get Plen k
die 71
end
end
put Poff j get Ts 0
put Plen j sub get Te 0 get Ts 0
x = emitop 9 65535 65535 j get Ts 0 get Te 0
put Npar 0 add j 1
lexnext
if eq get Tk 0 44
lexnext
else
more = 0
end
end
need 41
end
need 123
if not word 9 6
die 69
end
lexnext
root = expr 0
if badarith
die 68
end
need 59
need 125
if ne get Tk 0 0
die 69
end
z = emitop 1 65535 65535 0 0 0
root = emitop 2 root z 0 0 0
end

fn parent to void
put Out 25 212
put Out 26 237
put Out 27 97
put Out 28 72
put Out 29 191
put Out 30 169
put Out 31 124
put Out 32 198
put Out 33 147
put Out 34 211
put Out 35 250
put Out 36 68
put Out 37 149
put Out 38 226
put Out 39 215
put Out 40 226
put Out 41 230
put Out 42 138
put Out 43 186
put Out 44 4
put Out 45 96
put Out 46 122
put Out 47 126
put Out 48 150
put Out 49 221
put Out 50 154
put Out 51 156
put Out 52 84
put Out 53 191
put Out 54 144
put Out 55 115
put Out 56 168
end

fn envelope to ulong
n = get Nop 0
sem = add 44 mul 20 n
prov = add add 74 mul 8 n get Slen 0
put Out 0 79
put Out 1 77
put Out 2 83
put Out 3 66
put Out 4 1
leput 5 sem 4
leput 9 prov 4
put Out 13 79
put Out 14 77
put Out 15 83
put Out 16 65
put Out 17 1
put Out 18 1
put Out 19 1
put Out 20 1
put Out 21 0
put Out 22 1
leput 23 n 2
parent
s = add 13 sem
put Out s 79
put Out add s 1 77
put Out add s 2 83
put Out add s 3 80
put Out add s 4 1
put Out add s 5 0
leput add s 6 get Slen 0 4
hinit
for i ulong sem
hbyte get Out add 13 i
end
finish
for i ulong 32
put Out add add s 10 i get Hash i
end
hinit
for i ulong get Slen 0
hbyte get Src i
end
finish
for i ulong 32
put Out add add s 42 i get Hash i
end
for i ulong n
leput add add s 74 mul i 8 get Beg i 4
leput add add s 78 mul i 8 get Ends i 4
end
b = add add s 74 mul n 8
for i ulong get Slen 0
put Out add b i get Src i
end
ret add add 13 sem prov
end

fn triend c uchar to bool
if or eq c 61 eq c 47
ret true
end
if or eq c 40 eq c 39
ret true
end
if or eq c 41 eq c 33
ret true
end
if or eq c 60 eq c 62
ret true
end
ret eq c 45
end

fn phasecheck to void
for i ulong get Slen 0
c = get Src i
if eq c 92
die 72
end
if and eq c 63 lt add i 2 get Slen 0
if eq get Src add i 1 63
if triend get Src add i 2
die 72
end
end
end
end
end

fn main to int
n = ulong 0
more = ulong 1
while and eq more 1 lt n 4096
r = read 0 Src n sub 4096 n
if lt r 0
die 77
end
if eq r 0
more = 0
else
n = add n ulong r
end
end
if eq n 4096
r = read 0 Extra 0 1
if lt r 0
die 77
end
if gt r 0
die 67
end
end
put Slen 0 n
for i ulong n
if eq get Src i 0
die 65
end
end
phasecheck
constants
parse
n = envelope
sent = ulong 0
while lt sent n
r = write 1 Out sent sub n sent
if le r 0
die 77
end
sent = add sent ulong r
end
ret 0
end
