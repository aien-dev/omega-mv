note SPDX-License-Identifier: AGPL-3.0-or-later
note Handwritten bounded Go 1.27 uint64 expression importer, profile go-u64-pure-v1 (source-aware v2).
note No Go compiler, parser library or host fallback. Spec: spec/universal/go-u64-v1.md.
note SHA256 definitions are the unchanged, pinned source-aware vendor core prepended at build.
global Src uchar 4096
global Extra uchar 1
global Out uchar 8192
global Slen ulong 1
global Cur ulong 1
global Tk ulong 1
global Ts ulong 1
global Te ulong 1
global Tv ulong 1
global Ins ulong 1
global Nl ulong 1
global Npar ulong 1
global Poff ulong 6
global Plen ulong 6
global Nop ulong 1
global Beg ulong 64
global Ends ulong 64
global Kc ulong 64
global Kv ulong 64
text Fixed "package main func return uint64 +build"
text Keys "break case chan const continue default defer else fallthrough for func go goto if import interface map package range return select struct switch type var true false iota nil append cap clear close complex copy delete imag len make max min new panic print println real recover main init"
text Types "any bool byte comparable complex64 complex128 error float32 float64 int int8 int16 int32 int64 rune string uint uint8 uint16 uint32 uint64 uintptr"
text Entry "calc omega_"
text ESyn "GO_IMPORT_SYNTAX\n"
text EType "GO_IMPORT_UNSUPPORTED_TYPE\n"
text ECap "GO_IMPORT_LIMIT\n"
text EArith "GO_IMPORT_UNSUPPORTED_ARITHMETIC\n"
text EForm "GO_IMPORT_UNSUPPORTED_CONSTRUCT\n"
text EName "GO_IMPORT_UNKNOWN_IDENTIFIER\n"
text ESig "GO_IMPORT_UNSUPPORTED_SIGNATURE\n"
text ELex "GO_IMPORT_UNSUPPORTED_SOURCE_FORM\n"
text EIO "GO_IMPORT_IO\n"

fn die code ulong to void
if eq code 65
w = write 2 ESyn 0 len ESyn
end
if eq code 66
w = write 2 EType 0 len EType
end
if eq code 67
w = write 2 ECap 0 len ECap
end
if eq code 68
w = write 2 EArith 0 len EArith
end
if eq code 69
w = write 2 EForm 0 len EForm
end
if eq code 70
w = write 2 EName 0 len EName
end
if eq code 71
w = write 2 ESig 0 len ESig
end
if eq code 72
w = write 2 ELex 0 len ELex
end
if eq code 77
w = write 2 EIO 0 len EIO
end
exit int code
end

fn alpha c uchar to bool
ret or or and ge c 65 le c 90 and ge c 97 le c 122 eq c 95
end

fn digit c uchar to bool
ret and ge c 48 le c 57
end

fn ident c uchar to bool
ret or alpha c digit c
end

fn srcdig p ulong to bool
if ge p get Slen 0
ret false
end
ret digit get Src p
end

fn srcid p ulong to bool
if ge p get Slen 0
ret false
end
ret ident get Src p
end

fn srcis p ulong c ulong to bool
if ge p get Slen 0
ret false
end
ret eq ulong get Src p c
end

fn notnl p ulong to bool
if ge p get Slen 0
ret false
end
ret ne get Src p 10
end

note Strict UTF-8 (no overlong, surrogate or above U+10FFFF) over the whole source.
fn utf8 to bool
n = get Slen 0
pos = ulong 0
while lt pos n
c = ulong get Src pos
pos = add pos 1
if ge c 128
extra = ulong 0
v = ulong 0
low = ulong 0
if and ge c 194 le c 223
extra = 1
v = and c 31
low = 128
end
if and ge c 224 le c 239
extra = 2
v = and c 15
low = 2048
end
if and ge c 240 le c 244
extra = 3
v = and c 7
low = 65536
end
if eq extra 0
ret false
end
if gt extra sub n pos
ret false
end
for j ulong extra
c = ulong get Src pos
if or lt c 128 gt c 191
ret false
end
v = or shl v 6 and c 63
pos = add pos 1
end
if lt v low
ret false
end
if gt v 1114111
ret false
end
if and ge v 55296 le v 57343
ret false
end
end
end
ret true
end

fn blank p ulong to bool
if ge p get Slen 0
ret true
end
c = get Src p
ret or or eq c 32 eq c 9 or eq c 10 eq c 13
end

note Line comment; acts like a newline. Compiler directives (//go:..., //line, //export, // +build)
note are not ordinary comments: the byte after // must be blank, and the text may not start with +build.
fn linecom to void
p = add get Cur 0 2
if not blank p
die 72
end
q = p
while or srcis q 32 srcis q 9
q = add q 1
end
hit = ulong 1
for i ulong 6
if not srcis add q i ulong get Fixed add 32 i
hit = 0
end
end
if eq hit 1
die 72
end
while notnl p
p = add p 1
end
put Nl 0 1
put Cur 0 p
end

note General comment; Go general comments do not nest. One containing a newline acts like a newline.
note The byte after /* must be blank or *, which excludes the /*line directive.
fn blockcom to void
p = add get Cur 0 2
if not or blank p srcis p 42
die 72
end
while lt add p 1 get Slen 0
a = get Src p
b = get Src add p 1
if and eq a 42 eq b 47
put Cur 0 add p 2
ret
end
if eq a 10
put Nl 0 1
end
p = add p 1
end
die 65
end

fn spaces to void
more = ulong 1
while eq more 1
if ge get Cur 0 get Slen 0
ret
end
p = get Cur 0
c = get Src p
if or or eq c 32 eq c 9 or eq c 10 eq c 13
if eq c 10
put Nl 0 1
end
put Cur 0 add p 1
else
if and eq c 47 lt add p 1 get Slen 0
d = get Src add p 1
if eq d 47
linecom
else
if eq d 42
blockcom
else
more = 0
end
end
else
more = 0
end
end
end
end

fn word off ulong n ulong to bool
if or ne get Tk 0 256 ne sub get Te 0 get Ts 0 n
ret false
end
for i ulong n
if ne get Src add get Ts 0 i get Fixed add off i
ret false
end
end
ret true
end

note An identifier ends a line with an automatic semicolon, except the keywords of this grammar that
note do not (package, func). Every other keyword refuses wherever it appears.
fn idlex to void
p = add get Cur 0 1
while srcid p
p = add p 1
end
put Tk 0 256
put Cur 0 p
put Te 0 p
put Ins 0 1
if or word 0 7 word 13 4
put Ins 0 0
end
end

note Decimal literal 0 or [1-9][0-9]*; no 0x/0o/0b, no legacy octal 0nn, no _, no float or imaginary form.
fn numlex to void
p = get Cur 0
if eq get Src p 48
if srcdig add p 1
die 68
end
end
v = ulong 0
while srcdig p
d = sub ulong get Src p 48
if gt v 1844674407370955161
die 67
end
if and eq v 1844674407370955161 gt d 5
die 67
end
v = add mul v 10 d
p = add p 1
end
if srcid p
die 68
end
if srcis p 46
die 68
end
put Tk 0 257
put Tv 0 v
put Cur 0 p
put Te 0 p
put Ins 0 1
end

note Go automatic semicolon insertion: a newline (or the end of input) after an identifier, literal,
note ) ] or } is a ; token. Token 59 is both the explicit and the inserted semicolon.
fn lexnext to void
put Nl 0 0
spaces
p = get Cur 0
if and eq get Ins 0 1 or eq get Nl 0 1 ge p get Slen 0
put Ins 0 0
put Tk 0 59
put Ts 0 p
put Te 0 p
ret
end
put Ins 0 0
put Ts 0 p
if ge p get Slen 0
put Tk 0 0
put Te 0 p
ret
end
c = get Src p
if alpha c
idlex
else
if digit c
numlex
else
if gt c 127
die 69
end
put Tk 0 ulong c
put Cur 0 add p 1
put Te 0 add p 1
if or or eq c 41 eq c 93 eq c 125
put Ins 0 1
end
end
end
end

fn keyeq txt ulong off ulong n ulong to bool
if ne sub get Te 0 get Ts 0 n
ret false
end
for i ulong n
c = get Src add get Ts 0 i
if eq txt 0
if ne c get Keys add off i
ret false
end
else
if ne c get Types add off i
ret false
end
end
end
ret true
end

fn keychar p ulong to bool
if ge p len Keys
ret false
end
ret ne get Keys p 32
end

fn typechar p ulong to bool
if ge p len Types
ret false
end
ret ne get Types p 32
end

note Keywords, predeclared constants and functions, main and init.
fn iskey to bool
if ne get Tk 0 256
ret false
end
p = ulong 0
while lt p len Keys
b = p
while keychar p
p = add p 1
end
if keyeq 0 b sub p b
ret true
end
p = add p 1
end
ret false
end

note Predeclared type names.
fn istype to bool
if ne get Tk 0 256
ret false
end
p = ulong 0
while lt p len Types
b = p
while typechar p
p = add p 1
end
if keyeq 1 b sub p b
ret true
end
p = add p 1
end
ret false
end

fn entryok to bool
n = sub get Te 0 get Ts 0
if eq n 4
for i ulong 4
if ne get Src add get Ts 0 i get Entry i
ret false
end
end
ret true
end
if le n 6
ret false
end
for i ulong 6
if ne get Src add get Ts 0 i get Entry add i 5
ret false
end
end
ret true
end

fn nameok to void
if ne get Tk 0 256
die 69
end
if gt sub get Te 0 get Ts 0 32
die 71
end
c = get Src get Ts 0
if or lt c 97 gt c 122
die 71
end
if iskey
die 71
end
if istype
die 71
end
end

fn need k ulong to void
if ne get Tk 0 k
die 65
end
lexnext
end

fn same off ulong count ulong to bool
if ne count sub get Te 0 get Ts 0
ret false
end
for i ulong count
if ne get Src add off i get Src add get Ts 0 i
ret false
end
end
ret true
end

fn leput off ulong v ulong n ulong to void
for i ulong n
put Out add off i uchar and shr v mul i 8 255
end
end

note One OMSA v2 operation record of the Go member: dialect 7, version 1, type 1.
fn emitop op ulong a ulong b ulong imm ulong lo ulong hi ulong to ulong
i = get Nop 0
if ge i 64
die 67
end
p = add 57 mul i 20
for j ulong 20
put Out add p j 0
end
put Out p 7
put Out add p 1 1
put Out add p 2 uchar op
put Out add p 3 1
if ne op 9
put Out add p 4 1
end
if ne op 1
put Out add p 7 1
end
leput add p 8 a 2
leput add p 10 b 2
leput add p 12 imm 8
put Beg i lo
put Ends i hi
put Kc i 0
put Kv i imm
if eq op 1
put Kc i 1
end
put Nop 0 add i 1
ret i
end

note Untyped constants: a source operation whose operands are both constant-only is a Go constant
note expression, evaluated exactly. It must lie in 0..2^64-1, so that the exact value equals the
note modulo-2^64 tree and the conversion to uint64 compiles; otherwise refuse 68.
fn mkop code ulong a ulong b ulong lo ulong hi ulong to ulong
k = emitop code a b 0 lo hi
if and eq get Kc a 1 eq get Kc b 1
x = get Kv a
y = get Kv b
v = ulong 0
if eq code 2
v = add x y
if lt v x
die 68
end
end
if eq code 3
if lt x y
die 68
end
v = sub x y
end
if eq code 4
v = mul x y
if ne x 0
if ne div v x y
die 68
end
end
end
put Kc k 1
put Kv k v
end
ret k
end

fn badarith to bool
k = get Tk 0
if or or eq k 47 eq k 37 eq k 38
ret true
end
if or or eq k 124 eq k 94 eq k 60
ret true
end
if or eq k 62 eq k 33
ret true
end
if eq k 61
ret srcis get Te 0 61
end
ret false
end

fn closer to void
t = get Tk 0
if eq t 41
lexnext
ret
end
if badarith
die 68
end
if or or eq t 0 eq t 59 or eq t 125 eq t 44
die 65
end
if or eq t 256 eq t 257
die 65
end
die 69
end

fn identprim to ulong
for j ulong get Npar 0
if same get Poff j get Plen j
lexnext
ret j
end
end
if istype
die 66
end
if iskey
die 69
end
die 70
ret 0
end

fn primary depth ulong to ulong
if gt depth 16
die 67
end
t = get Tk 0
if eq t 257
node = emitop 1 65535 65535 get Tv 0 get Ts 0 get Te 0
lexnext
ret node
end
if eq t 256
ret identprim
end
if eq t 40
lexnext
node = expr add depth 1
closer
ret node
end
if or or eq t 43 eq t 45 or eq t 94 eq t 42
die 68
end
if or or eq t 38 eq t 33 or eq t 60 eq t 126
die 68
end
if or eq t 39 eq t 46
die 68
end
if or or eq t 0 eq t 41 or eq t 59 or eq t 44 eq t 125
die 65
end
die 69
ret 0
end

fn term depth ulong to ulong
left = primary depth
while eq get Tk 0 42
lo = get Ts 0
hi = get Te 0
lexnext
right = primary depth
left = mkop 4 left right lo hi
end
ret left
end

fn expr depth ulong to ulong
left = term depth
while or eq get Tk 0 43 eq get Tk 0 45
code = ulong 2
if eq get Tk 0 45
code = 3
end
lo = get Ts 0
hi = get Te 0
lexnext
right = term depth
left = mkop code left right lo hi
end
ret left
end

fn pname to void
nameok
j = get Npar 0
if ge j 6
die 67
end
for k ulong j
if same get Poff k get Plen k
die 71
end
end
put Poff j get Ts 0
put Plen j sub get Te 0 get Ts 0
x = emitop 9 65535 65535 j get Ts 0 get Te 0
put Npar 0 add j 1
lexnext
end

fn ptype to void
if word 25 6
lexnext
ret
end
t = get Tk 0
if eq t 46
die 69
end
if or or eq t 256 eq t 42 or eq t 91 eq t 40
die 66
end
die 65
end

note Named parameters, optionally grouped (a, b uint64); every group has type uint64.
fn params to void
if eq get Tk 0 41
lexnext
ret
end
more = ulong 1
while eq more 1
pname
if eq get Tk 0 44
lexnext
if eq get Tk 0 41
die 65
end
else
ptype
if eq get Tk 0 44
lexnext
if eq get Tk 0 41
die 65
end
else
more = 0
end
end
end
need 41
end

fn result to void
t = get Tk 0
if eq t 40
die 69
end
if eq t 123
die 71
end
if word 25 6
lexnext
ret
end
if or or eq t 256 eq t 42 eq t 91
die 66
end
die 65
end

fn header to void
lexnext
if not word 0 7
if eq get Tk 0 0
die 65
end
die 69
end
lexnext
if ne get Tk 0 256
die 65
end
if not word 8 4
die 71
end
lexnext
need 59
if not word 13 4
if eq get Tk 0 0
die 65
end
die 69
end
lexnext
if eq get Tk 0 40
die 69
end
nameok
if not entryok
die 71
end
lexnext
if eq get Tk 0 91
die 69
end
need 40
params
result
need 123
if not word 18 6
if eq get Tk 0 125
die 65
end
die 69
end
lexnext
end

fn bodyend to void
if badarith
die 68
end
if eq get Tk 0 59
lexnext
if ne get Tk 0 125
die 69
end
end
t = get Tk 0
if eq t 125
lexnext
ret
end
if or eq t 0 eq t 41
die 65
end
if or eq t 256 eq t 257
die 65
end
die 69
end

fn parse to void
put Cur 0 0
header
if eq get Tk 0 59
die 65
end
root = expr 0
bodyend
if eq get Tk 0 59
lexnext
end
if ne get Tk 0 0
die 69
end
z = emitop 1 65535 65535 0 0 0
root = emitop 2 root z 0 0 0
end

fn parent to void
put Out 25 212
put Out 26 237
put Out 27 97
put Out 28 72
put Out 29 191
put Out 30 169
put Out 31 124
put Out 32 198
put Out 33 147
put Out 34 211
put Out 35 250
put Out 36 68
put Out 37 149
put Out 38 226
put Out 39 215
put Out 40 226
put Out 41 230
put Out 42 138
put Out 43 186
put Out 44 4
put Out 45 96
put Out 46 122
put Out 47 126
put Out 48 150
put Out 49 221
put Out 50 154
put Out 51 156
put Out 52 84
put Out 53 191
put Out 54 144
put Out 55 115
put Out 56 168
end

note OMSB v1 envelope, OMSA semantic header version 2, language 7 (Go 1.27), profile 9, runtime 0, ABI 1.
fn envelope to ulong
n = get Nop 0
sem = add 44 mul 20 n
prov = add add 74 mul 8 n get Slen 0
put Out 0 79
put Out 1 77
put Out 2 83
put Out 3 66
put Out 4 1
leput 5 sem 4
leput 9 prov 4
put Out 13 79
put Out 14 77
put Out 15 83
put Out 16 65
put Out 17 2
put Out 18 7
put Out 19 9
put Out 20 1
put Out 21 0
put Out 22 1
leput 23 n 2
parent
s = add 13 sem
put Out s 79
put Out add s 1 77
put Out add s 2 83
put Out add s 3 80
put Out add s 4 1
put Out add s 5 1
leput add s 6 get Slen 0 4
hinit
for i ulong sem
hbyte get Out add 13 i
end
finish
for i ulong 32
put Out add add s 10 i get Hash i
end
hinit
for i ulong get Slen 0
hbyte get Src i
end
finish
for i ulong 32
put Out add add s 42 i get Hash i
end
for i ulong n
leput add add s 74 mul i 8 get Beg i 4
leput add add s 78 mul i 8 get Ends i 4
end
b = add add s 74 mul n 8
for i ulong get Slen 0
put Out add b i get Src i
end
ret add add 13 sem prov
end

fn main to int
n = ulong 0
more = ulong 1
while and eq more 1 lt n 4096
r = read 0 Src n sub 4096 n
if lt r 0
die 77
end
if eq r 0
more = 0
else
n = add n ulong r
end
end
if eq n 4096
r = read 0 Extra 0 1
if lt r 0
die 77
end
if gt r 0
die 67
end
end
put Slen 0 n
for i ulong n
if eq get Src i 0
die 65
end
end
if not utf8
die 72
end
if and srcis 0 239 and srcis 1 187 srcis 2 191
die 72
end
constants
parse
n = envelope
sent = ulong 0
while lt sent n
r = write 1 Out sent sub n sent
if le r 0
die 77
end
sent = add sent ulong r
end
ret 0
end
