#!/usr/bin/env python3
"""Transparent host dispatch; decoding, family checks and retargeting run in seeded native Omega."""
from pathlib import Path
import hashlib,json,os,sys
root=Path(__file__).resolve().parents[2]
closure={'src/source-aware/vendor/sha256.om','src/source-aware/core-v2.om','src/adapters/upper-retarget.om'}
try:
    build=root/'build/L833';m=json.loads((build/'build.json').read_text());exe=build/'retarget'
    if m['compiler_sha256']!='734f0a39319fbfa930bcc62cb30dbf06d47d78e126372b74f5baf478e6126b61':raise ValueError('compiler identity')
    if set(m['inputs'])!=closure:raise ValueError('source closure')
    for rel,digest in m['inputs'].items():
        if hashlib.sha256((root/rel).read_bytes()).hexdigest()!=digest:raise ValueError('changed source')
    if hashlib.sha256(exe.read_bytes()).hexdigest()!=m['binary_sha256']:raise ValueError('changed artifact')
except (OSError,ValueError,KeyError) as exc:
    print('RETARGET_STALE_OR_MISSING_BUILD: '+str(exc),file=sys.stderr);raise SystemExit(78)
# The member argument M is passed through; the native tool validates it (64 on refusal).
os.execv(exe,[str(exe)]+sys.argv[1:])
