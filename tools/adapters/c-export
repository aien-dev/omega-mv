#!/usr/bin/env python3
"""Transparent host dispatch; validation and C generation run in seeded native Omega.
Usage: c-export [NAME] < unit.upper > unit.c   (NAME rules are checked natively)."""
from pathlib import Path
import hashlib,json,subprocess,sys
root=Path(__file__).resolve().parents[2]
INPUTS={'src/source-aware/vendor/sha256.om','src/source-aware/core.om','src/adapters/c-u64-export.om'}
name=sys.argv[1].encode() if len(sys.argv)==2 else b''
if len(sys.argv)>2 or (len(sys.argv)==2 and not 1<=len(name)<=255):
    print('C_EXPORT_BAD_COMMAND: use c-export [NAME] with the envelope on stdin',file=sys.stderr);raise SystemExit(64)
try:
    build=root/'build/L622';m=json.loads((build/'build.json').read_text());exe=build/'c-export'
    if m['compiler_sha256']!='191b776ef98821597c3e30655da6d680a9b66edbc9ceaca3c39c61ea6df098e9':raise ValueError('compiler identity')
    if set(m['inputs'])!=INPUTS:raise ValueError('source closure')
    for rel,digest in m['inputs'].items():
        if hashlib.sha256((root/rel).read_bytes()).hexdigest()!=digest:raise ValueError('changed source')
    if hashlib.sha256(exe.read_bytes()).hexdigest()!=m['binary_sha256']:raise ValueError('changed artifact')
except (OSError,ValueError,KeyError) as exc:
    print('C_EXPORT_STALE_OR_MISSING_BUILD: '+str(exc),file=sys.stderr);raise SystemExit(78)
# Frame: one name-length byte (0 = default calc), the name bytes, then stdin to EOF.
r=subprocess.run([str(exe)],input=bytes([len(name)])+name+sys.stdin.buffer.read(),stdout=subprocess.PIPE)
if r.returncode==0:sys.stdout.buffer.write(r.stdout);sys.stdout.buffer.flush()
raise SystemExit(r.returncode)
