rw-contract v1
id: R21
name: add-to-sub
label: count-neutral
semantics: omega.v0.wrap
domain: wrap
widths: 8 16 32 64
overflow: wrap modulo 2^w (OVERFLOW_WRAP)
rounding: none (integer)
shape: scalar u_w -> u_w
aliasing: none (one register, no memory)
effects: none (pure)
params: a
ops: -
assume: -
lhs: (add x a)
rhs: (sub x (neg a))
derive:
  (add x (neg (neg a))) by neg-neg rev
  (sub x (neg a)) by sub-def rev
end
