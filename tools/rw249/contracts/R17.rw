rw-contract v1
id: R17
name: fold-after-constant
label: reducing
semantics: omega.v0.wrap
domain: wrap
widths: 8 16 32 64
overflow: wrap modulo 2^w (OVERFLOW_WRAP)
rounding: none (integer)
shape: scalar u_w -> u_w
aliasing: none (one register, no memory)
effects: none (pure)
params: c k
ops: add sub mul and or
assume: -
lhs: (OP (or (and x 0) c) k)
rhs: (or (and x 0) (OP c k))
derive:
  (OP (or 0 c) k) by and-zero
  (OP (or c 0) k) by or-comm
  (OP c k) by or-zero
  (or (OP c k) 0) by or-zero rev
  (or 0 (OP c k)) by or-comm
  (or (and x 0) (OP c k)) by and-zero rev
end
