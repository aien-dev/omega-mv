rw-contract v1
id: R25
name: or-over-and
label: count-neutral
semantics: omega.v0.wrap
domain: wrap
widths: 8 16 32 64
overflow: wrap modulo 2^w (OVERFLOW_WRAP)
rounding: none (integer)
shape: scalar u_w -> u_w
aliasing: none (one register, no memory)
effects: none (pure)
params: m c
ops: -
assume: -
lhs: (or (and x m) c)
rhs: (and (or x c) (or m c))
derive:
  (and (or x c) (or m c)) by or-distrib
end
