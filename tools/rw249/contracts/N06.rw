rw-contract v1
id: N06
name: absorb-without-assumption
label: negative; R22 with its assumption dropped
semantics: omega.v0.wrap
domain: wrap
widths: 8 16 32 64
overflow: wrap modulo 2^w
rounding: none
shape: scalar
aliasing: none
effects: none
params: m c
ops: -
assume: -
lhs: (or (and x m) c)
rhs: (or x c)
derive:
  (and (or x c) (or m c)) by or-distrib
  (and (or x c) ones) by assume
  (or x c) by and-ones
end
