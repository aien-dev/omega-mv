rw-contract v1
id: R04
name: sub-add-merge
label: reducing
semantics: omega.v0.wrap
domain: wrap
widths: 8 16 32 64
overflow: wrap modulo 2^w (OVERFLOW_WRAP)
rounding: none (integer)
shape: scalar u_w -> u_w
aliasing: none (one register, no memory)
effects: none (pure)
params: a b
ops: -
assume: -
lhs: (add (sub x a) b)
rhs: (add x (sub b a))
derive:
  (add (add x (neg a)) b) by sub-def
  (add x (add (neg a) b)) by add-assoc
  (add x (add b (neg a))) by add-comm
  (add x (sub b a)) by sub-def rev
end
