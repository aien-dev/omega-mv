// L093 round-trip program 2: two struct types in one unit, a move, and fields of both read together.
struct Pt { x: i32, y: i32 }
struct Box { lo: i64, hi: i64, tag: u8 }

fn span(a: i32, b: i32) -> i64 {
    let p: own Pt = Pt { x: a, y: b };
    let q: own Pt = p;
    let r: own Box = Box { lo: q.x as i64, hi: q.y as i64, tag: 1 };
    if r.lo > r.hi { r.tag = 2; }
    return (r.hi - r.lo) * (r.tag as i64);
}
