note Read unsigned decimal numbers separated by spaces or newlines from stdin; print their sum.
global inb uchar 65536
global outb uchar 32
fn readall to ulong
n = ulong 0
while lt n 65536 bound 65537
k = read 0 inb n sub 65536 n
if lt k 0
exit 2
end
if eq k 0
break
end
n = add n ulong k
end
ret n
end
fn printu v ulong to void
i = ulong 31
put outb i 10
x = v
while true bound 21
i = sub i 1
put outb i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
off = i
k = write 1 outb off sub 32 off
if ne k long sub 32 off
exit 3
end
end
text yes "yes\n"
text no "no\n"
fn main to int
n = readall
d = long 0
ok = true
for i ulong n
c = get inb i
if eq c 40
d = add d 1
end
if eq c 41
d = sub d 1
if lt d 0
ok = false
end
end
end
if ne d 0
ok = false
end
if ok
k = write 1 yes 0 len yes
else
k = write 1 no 0 len no
end
ret 0
end
