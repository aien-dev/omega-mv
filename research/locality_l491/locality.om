note L491 bounded legality and exact-identity checker. Host Omega, no GPU access.
note The byte ledger is analytical at a declared two-level boundary, never DRAM counters.
global inp uchar 16384
global q ulong 512
global nq ulong 1
global out uchar 32
global fast ulong 16
global slow ulong 16
global done ulong 16
global met ulong 5
global used ulong 1
global hh ulong 64
global ww ulong 64
global pp ulong 64

fn putnum v ulong to void
put out 31 10
p = ulong 31
x = v
while gt x 9
p = sub p 1
put out p uchar add rem x 10 48
x = div x 10
end
p = sub p 1
put out p uchar add x 48
w = write 1 out p sub 32 p
if ne w long sub 32 p
exit 26
end
end

fn parse to void
n = ulong 0
more = true
while more
if eq n 16384
exit 20
end
k = read 0 inp n sub 16384 n
if eq k 0
more = false
else
if or lt k 0 gt k long sub 16384 n
exit 20
end
n = add n ulong k
end
end
v = ulong 0
has = false
for i ulong n
c = ulong get inp i
if and ge c 48 le c 57
if gt v div sub 18446744073709551615 sub c 48 10
exit 20
end
v = add mul v 10 sub c 48
has = true
else
if and ne c 32 and ne c 10 and ne c 9 ne c 13
exit 20
end
if has
j = get nq 0
if ge j 512
exit 20
end
put q j v
put nq 0 add j 1
v = ulong 0
has = false
end
end
end
if has
j = get nq 0
if ge j 512
exit 20
end
put q j v
put nq 0 add j 1
end
end

fn maskok mask ulong n ulong to bool
ret eq shr mask n 0
end

fn preds mask ulong n ulong to void
for j ulong n
if ne and mask shl ulong 1 j 0
if eq get fast j 0
exit 21
end
end
end
end

fn acquire i ulong sz ulong cap ulong to void
if ne get fast i 0
exit 23
end
u = add get used 0 sz
if gt u cap
exit 22
end
put used 0 u
put fast i 1
if gt u get met 1
put met 1 u
end
end

fn event k ulong i ulong n ulong cap ulong to void
if or ge i n gt k 3
exit 20
end
b = add 5 mul i 3
sz = get q b
flags = get q add b 2
if lt k 2
if ne get fast i 0
exit 23
end
if eq k 0
if eq get slow i 0
exit 23
end
put met 0 add get met 0 sz
put met 3 add get met 3 1
else
if ne and flags 1 0
exit 23
end
preds get q add b 1 n
if and ne get done i 0 eq and flags 2 0
exit 23
end
put done i 1
put met 2 add get met 2 1
end
acquire i sz cap
else
if eq get fast i 0
exit 23
end
if eq k 2
put slow i 1
put met 0 add get met 0 sz
put met 4 add get met 4 1
else
put fast i 0
put used 0 sub get used 0 sz
end
end
end

fn init n ulong to void
for i ulong n
b = add 5 mul i 3
sz = get q b
dep = get q add b 1
flags = get q add b 2
if or eq sz 0 or gt sz 1048576 or gt flags 7 not maskok dep i
exit 20
end
if ne and flags 1 0
if ne dep 0
exit 20
end
put slow i 1
end
end
end

fn finish n ulong want ulong to void
for i ulong n
flags = get q add 7 mul i 3
if or ne and want shl ulong 1 i 0 ne and flags 4 0
if eq get slow i 0
exit 24
end
end
end

end

fn schedule to void
n = get q 1
cap = get q 2
nevt = get q 3
want = get q 4
if or eq n 0 or gt n 16 or eq cap 0 gt nevt 64
exit 20
end
base = add 5 mul n 3
if ne get nq 0 add base mul nevt 2
exit 20
end
if not maskok want n
exit 20
end
init n
for e ulong nevt
b = add base mul e 2
event get q b get q add b 1 n cap
end
finish n want
for i ulong 5
putnum get met i
end
end

fn identity to void
if ne get nq 0 27
exit 20
end
ok = ulong 1
for i ulong 13
if eq get q add i 1 0
ok = ulong 0
end
if ne get q add i 1 get q add i 14
ok = ulong 0
end
end
putnum ok
end

note Pure unsigned recurrence: h[t+1,i] = h[t,i] * (w[i]+3) + (i+1).
note Modulo 2^64 is the frozen contract. This is a synthetic scheduling block.
note Arms 0 streaming reference, 1 specialization only, 2 retained prepared p,
note 3 retain w and recompute p, 4 retain h and store/reload p.
fn recvalid to void
n = get q 1
depth = get q 2
arm = get q 3
if or eq n 0 gt n 64
exit 20
end
if or eq depth 0 gt depth 64
exit 20
end
if gt arm 4
exit 20
end
if or ne get nq 0 add 7 mul n 2 ne get q 6 1
exit 20
end
if lt get q 4 recpeak n arm
exit 22
end
end

fn recpeak n ulong arm ulong to ulong
peak = ulong 24
if or eq arm 2 eq arm 3
peak = add mul n 16 8
end
if eq arm 4
peak = add mul n 8 16
end
ret peak
end

fn recur to void
recvalid
n = get q 1
arm = get q 3
for i ulong n
put ww i get q add 7 i
put hh i get q add add 7 n i
if or eq arm 1 or eq arm 2 eq arm 4
put pp i add get ww i 3
end
end
if ge arm 2
retain n get q 2 arm
else
stream n get q 2 arm
end
recmet n get q 2 arm
for i ulong n
putnum get hh i
end
end

fn stream n ulong depth ulong arm ulong to void
for t ulong get q 2
if eq t get q 5
exit 25
end
for i ulong n
p = ulong 0
if or eq arm 0 eq arm 3
p = add get ww i 3
else
p = get pp i
end
h = get hh i
h = mul h p
h = add h add i 1
put hh i h
end
end
end

note Independent lanes permit loop interchange. h and the retained w/p are scalar
note locals throughout all depth iterations. No cross-lane data or global barrier.
fn retain n ulong depth ulong arm ulong to void
for i ulong n
h = get hh i
w = get ww i
p = ulong 0
if eq arm 2
p = get pp i
end
for t ulong depth
if eq t get q 5
exit 25
end
if eq arm 3
p = add w 3
end
if eq arm 4
p = get pp i
end
h = mul h p
h = add h add i 1
end
put hh i h
end
end

fn recmet n ulong depth ulong arm ulong to void
traffic = mul mul n depth 24
pureops = mul n depth
if ne arm 0
pureops = n
end
if eq arm 1
traffic = add traffic mul n 16
end
if or eq arm 2 eq arm 3
traffic = mul n 24
end
if eq arm 3
pureops = mul n depth
end
if eq arm 4
traffic = add mul n 32 mul mul n depth 8
end
putnum traffic
putnum pureops
putnum mul n depth
putnum recpeak n arm
end

fn main to int
parse
if lt get nq 0 1
exit 20
end
mode = get q 0
if eq mode 1
if lt get nq 0 5
exit 20
end
schedule
else
if eq mode 2
identity
else
if eq mode 3
if lt get nq 0 7
exit 20
end
recur
else
exit 20
end
end
end
ret 0
end
